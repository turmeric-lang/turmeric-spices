;; Compile-only smoke test for render-circles: the render system pulls
;; in <raylib.h> via inline-C, so a full `tur run` here would require
;; raylib to be installed in cmake-deps. We use `tur emit-c` to confirm
;; the module elaborates cleanly without trying to link.
(defmodule render-elab-test
  (export)
  (import ecs/storage :refer [dense-new dense-set! dense-get])
  (import ecs/world :refer [defworld])
  (import ecs/query :refer [for-each])
  (import ecs-raylib/components
    :refer
    [Pos2
     Radius
     Tint
     pos2-make
     pos2-x
     pos2-y
     radius-make
     radius-value
     tint-make
     tint-color])
  (import ecs-raylib/render :refer [render-circles __raylib-draw-circle])
  ;; The Component instances live in ecs-raylib/components now.  Declaring them
  ;; here made them orphan instances (TUR-E0013), and `(defcomponent Color)` is
  ;; an orphan wherever it is written: Component belongs to ecs/world and Color
  ;; to raylib/types, so no module in this spice owns either.  The colour
  ;; component is `Tint`, which ecs-raylib does own.
  (defworld Scene [Pos2 Radius Tint])
  (render-circles render Scene)
  (defn main [] : int 0)) ;; end defmodule
