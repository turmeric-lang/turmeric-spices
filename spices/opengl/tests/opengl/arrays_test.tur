;; tests/opengl/arrays_test.tur -- unit tests for opengl/arrays.
;;
;; No GL context is needed: FloatArray is plain heap memory, so unlike the
;; buffer/window suites these run everywhere, display or not.
(defmodule opengl/tests/arrays
  (import opengl/arrays
    :refer
    [FloatArray
     make-float-array
     delete-float-array
     float-array-set!
     float-array-get
     float-array-len
     float-array-bytes
     float-array-ptr
     with-float-array])
  (import test/assert :refer [assert-true])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  ;;; near? -- float compare with a tolerance wide enough for a float32 round trip.
  (defn near? [a : float b : float] : bool
    (< (if (< (- a b) 0.0) (- b a) (- a b)) 0.0001))
  (defn __all-tests [] : void
    (describe "allocation and length"
      (it "make-float-array reports the requested length"
        (let [a  (make-float-array 9)
              ok (= (float-array-len a) 9)]
          (delete-float-array a)
          (assert-true ok)))
      (it "byte size is four bytes per slot"
        (let [a  (make-float-array 9)
              ok (= (float-array-bytes a) 36)]
          (delete-float-array a)
          (assert-true ok)))
      (it "a negative length is clamped to zero"
        (let [a  (make-float-array -3)
              ok (= (float-array-len a) 0)]
          (delete-float-array a)
          (assert-true ok)))
      (it "the payload pointer is non-null"
        (let [a  (make-float-array 3)
              ok (not (= (float-array-ptr a) 0))]
          (delete-float-array a)
          (assert-true ok))))
    (describe "store and load"
      (it "round-trips a fractional value"
        (let [a (make-float-array 3)]
          (float-array-set! a 0 0.6)
          (float-array-set! a 1 -0.4)
          (float-array-set! a 2 7.1)
          (let [ok (and (near? (float-array-get a 0) 0.6)
                     (and (near? (float-array-get a 1) -0.4)
                       (near? (float-array-get a 2) 7.1)))]
            (delete-float-array a)
            (assert-true ok))))
      (it "unwritten slots read back as zero"
        (let [a  (make-float-array 4)
              ok (near? (float-array-get a 3) 0.0)]
          (delete-float-array a)
          (assert-true ok)))
      (it "an out-of-range store is a no-op and a read answers 0.0"
        (let [a (make-float-array 2)]
          (float-array-set! a 5 7.1)
          (float-array-set! a -1 7.1)
          (let [ok (and (near? (float-array-get a 5) 0.0)
                     (and (near? (float-array-get a -1) 0.0)
                       (near? (float-array-get a 0) 0.0)))]
            (delete-float-array a)
            (assert-true ok)))))
    (describe "with-float-array"
      (it "binds the array and frees it at the end of the body"
        (let [^mut seen 0.0]
          (with-float-array v
            2
            (float-array-set! v 1 3.25)
            (set! seen (float-array-get v 1)))
          (assert-true (near? seen 3.25))))))
  (defn main [] : int (__all-tests) (run-all-status)))
