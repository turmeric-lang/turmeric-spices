;; tests/opengl/buffers_test.tur -- smoke tests for opengl/buffers.
;;
;; Buffer object creation requires a live GL context. Tests open a
;; 1x1 hidden window for initialisation, and skip when no display is found.
(defmodule opengl/tests/buffers
  (import opengl/types :refer [Vao Vbo Ebo])
  (import opengl/window :refer [make-window destroy-window])
  (import opengl/buffers
    :refer
    [make-vao
     make-vbo
     make-ebo
     bind-vao
     bind-vbo
     bind-ebo
     unbind-vao
     delete-vao
     delete-vbo
     delete-ebo
     vertex-attrib])
  (import test/assert :refer [assert-true])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  ;;; Handle readers that BORROW. Vao / Vbo / Ebo are `:linear`, and a bare
  ;;; `(vao-id vao)` counts as consuming the value -- so the old
  ;;; `ok (not (= (vao-id vao) 0))` binding consumed the handle and the
  ;;; `delete-vao` on the next line was a use-after-consume (TUR-E0101).
  ;;; Reading the id behind a `^borrow` leaves ownership with the caller, so the
  ;;; handle is still there to be deleted.
  (defn vao-id [^borrow v : Vao] : int (:: v :int))
  (defn vbo-id [^borrow v : Vbo] : int (:: v :int))
  (defn ebo-id [^borrow v : Ebo] : int (:: v :int))
  (defn __has-display [] : bool
    ```c
    #include <stdlib.h>
    return (getenv("DISPLAY") != NULL || getenv("WAYLAND_DISPLAY") != NULL);
    ```)
  (defn __all-tests [] : void
    (describe "make-vao / make-vbo / make-ebo"
      (it "make-vao returns a non-zero handle"
        (if (__has-display)
          (let [w   (make-window 1 1 "test")
                vao (make-vao)
                ok  (not (= (vao-id vao) 0))]
            (delete-vao vao)
            (destroy-window w)
            (assert-true ok))
          (do (println "# SKIP: no display available") true)))
      (it "make-vbo returns a non-zero handle"
        (if (__has-display)
          (let [w   (make-window 1 1 "test")
                vbo (make-vbo)
                ok  (not (= (vbo-id vbo) 0))]
            (delete-vbo vbo)
            (destroy-window w)
            (assert-true ok))
          (do (println "# SKIP: no display available") true)))
      (it "make-ebo returns a non-zero handle"
        (if (__has-display)
          (let [w   (make-window 1 1 "test")
                ebo (make-ebo)
                ok  (not (= (ebo-id ebo) 0))]
            (delete-ebo ebo)
            (destroy-window w)
            (assert-true ok))
          (do (println "# SKIP: no display available") true))))
    (describe "bind and vertex-attrib"
      (it "bind-vao + bind-vbo + vertex-attrib do not crash"
        (if (__has-display)
          (let [w   (make-window 1 1 "test")
                vao (make-vao)
                vbo (make-vbo)]
            (bind-vao vao)
            (bind-vbo vbo)
            ;; Describe a 3-float position attribute at location 0, stride 12 bytes
            (vertex-attrib 0 3 ":float" false 12 0)
            (unbind-vao)
            (delete-vbo vbo)
            (delete-vao vao)
            (destroy-window w)
            (assert-true true))
          (do (println "# SKIP: no display available") true)))
      (it "bind-ebo does not crash"
        (if (__has-display)
          (let [w   (make-window 1 1 "test")
                vao (make-vao)
                ebo (make-ebo)]
            (bind-vao vao)
            (bind-ebo ebo)
            (unbind-vao)
            (delete-ebo ebo)
            (delete-vao vao)
            (destroy-window w)
            (assert-true true))
          (do (println "# SKIP: no display available") true)))))
  (defn main [] : int (__all-tests) (run-all-status)))
