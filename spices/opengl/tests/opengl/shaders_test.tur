;; tests/opengl/shaders_test.tur -- smoke tests for opengl/shaders.
;;
;; Shader compilation requires a live GL context so these tests open a
;; 1x1 hidden window to satisfy GLAD initialisation.  Skip gracefully
;; when no display is available.
(defmodule opengl/tests/shaders
  (import opengl/window :refer [make-window destroy-window])
  (import opengl/shaders
    :refer
    [compile-shader delete-shader shader-program unuse-program delete-program])
  (import opengl/types :refer [Shader Program])
  (import test/assert :refer [assert-true])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  (defn __has-display [] : bool
    ```c
    #include <stdlib.h>
    return (getenv("DISPLAY") != NULL || getenv("WAYLAND_DISPLAY") != NULL);
    ```)
  (def __vert-src
    "#version 330 core\nlayout(location=0) in vec3 aPos;\nvoid main() { gl_Position = vec4(aPos, 1.0); }")
  (def __frag-src
    "#version 330 core\nout vec4 FragColor;\nvoid main() { FragColor = vec4(1.0); }")
  ;;; Handle readers that BORROW -- see buffers_test: these handle types are
  ;;; `:linear`, so a bare `(:: h :int)` consumes the value and the delete/destroy
  ;;; on the following line becomes a use-after-consume (TUR-E0101). Reading the
  ;;; id behind a `^borrow` leaves ownership with the caller.
  (defn shader-id [^borrow h : Shader] : int (:: h :int))
  (defn program-id [^borrow h : Program] : int (:: h :int))
  (defn __all-tests [] : void
    (describe "compile-shader"
      (it "compiles a vertex shader and returns a non-zero handle"
        (if (__has-display)
          (let [w  (make-window 1 1 "test")
                sh (compile-shader ":vertex" __vert-src)
                ok (not (= (shader-id sh) 0))]
            (delete-shader sh)
            (destroy-window w)
            (assert-true ok))
          (do (println "# SKIP: no display available") true)))
      (it "compiles a fragment shader and returns a non-zero handle"
        (if (__has-display)
          (let [w  (make-window 1 1 "test")
                sh (compile-shader ":fragment" __frag-src)
                ok (not (= (shader-id sh) 0))]
            (delete-shader sh)
            (destroy-window w)
            (assert-true ok))
          (do (println "# SKIP: no display available") true))))
    (describe "shader-program"
      (it "links vertex + fragment shaders into a non-zero program"
        (if (__has-display)
          (let [w    (make-window 1 1 "test")
                vs   (compile-shader ":vertex" __vert-src)
                fs   (compile-shader ":fragment" __frag-src)
                prog (shader-program vs fs)
                ok   (not (= (program-id prog) 0))]
            (delete-program prog)
            (destroy-window w)
            (assert-true ok))
          (do (println "# SKIP: no display available") true)))
      (it "unuse-program does not crash"
        (if (__has-display)
          (let [w (make-window 1 1 "test")]
            (unuse-program)
            (destroy-window w)
            (assert-true true))
          (do (println "# SKIP: no display available") true)))))
  (defn main [] : int (__all-tests) (run-all-status)))
