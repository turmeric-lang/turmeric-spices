(defpackage tur-opengl
  :name "tur-opengl"
  :version "0.2.0"
  :description "OpenGL 3.3 Core + GLFW + GLAD bindings for Turmeric"
  :license "MIT"
  :repository "https://github.com/turmeric-lang/turmeric-spices"
  ;; glfw and glad both need a real CMake target before their include and
  ;; link paths are knowable -- see cmake-deps/opengl/CMakeLists.txt.  :path
  ;; is spliced in as add_subdirectory("./<path>") relative to cmake/, hence
  ;; the leading ../
  :cmake-deps #map{"opengl-deps" #map{:path "../cmake-deps/opengl"
                                      :targets ["glfw" "glad"]}}
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :exports #map{"opengl/types" ["Vao"
                                "Vbo"
                                "Ebo"
                                "Shader"
                                "Program"
                                "Window"
                                "Texture"
                                "draw-usage->gl"
                                "shader-stage->gl"
                                "draw-mode->gl"
                                "index-type->gl"
                                "wrap-mode->gl"
                                "filter-mode->gl"
                                "attrib-type->gl"
                                "gl-cap->gl"]
                "opengl/window" ["make-window"
                                 "destroy-window"
                                 "window-should-close?"
                                 "poll-events"
                                 "swap-buffers"
                                 "set-clear-color"
                                 "clear"
                                 "with-window"]
                "opengl/arrays" ["FloatArray"
                                 "make-float-array"
                                 "delete-float-array"
                                 "float-array-set!"
                                 "float-array-get"
                                 "float-array-len"
                                 "float-array-bytes"
                                 "float-array-ptr"
                                 "with-float-array"]
                "opengl/buffers" ["make-vao"
                                  "make-vbo"
                                  "make-ebo"
                                  "bind-vao"
                                  "bind-vbo"
                                  "bind-ebo"
                                  "unbind-vao"
                                  "unbind-vbo"
                                  "unbind-ebo"
                                  "delete-vao"
                                  "delete-vbo"
                                  "delete-ebo"
                                  "upload-vertices"
                                  "upload-indices"
                                  "vertex-attrib"
                                  "with-vao"]
                "opengl/shaders" ["compile-shader"
                                  "delete-shader"
                                  "shader-program"
                                  "use-program"
                                  "unuse-program"
                                  "delete-program"
                                  "with-program"
                                  "set-uniform-int"
                                  "set-uniform-float"
                                  "set-uniform-vec2"
                                  "set-uniform-vec3"
                                  "set-uniform-vec4"
                                  "set-uniform-mat4"]
                "opengl/textures" ["make-texture"
                                   "bind-texture"
                                   "unbind-texture"
                                   "delete-texture"
                                   "upload-texture-rgba"
                                   "set-texture-wrap"
                                   "set-texture-filter"
                                   "generate-mipmaps"
                                   "active-texture"]
                "opengl/draw" ["draw-arrays"
                               "draw-elements"
                               "enable"
                               "disable"
                               "depth-test"
                               "blending"]
                "opengl/input" ["key-pressed?"
                                "mouse-pos"
                                "mouse-button-pressed?"]
                "opengl/math" ["mat4-identity"
                               "mat4-perspective"
                               "mat4-look-at"
                               "mat4-translate"
                               "mat4-rotate-x"
                               "mat4-rotate-y"
                               "mat4-rotate-z"
                               "mat4-mul"
                               "mat4-ptr"
                               "normal-mat4"]})
