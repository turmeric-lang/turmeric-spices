;; tests/plutovg/state_test.tur -- PV4 tests for canvas state, transforms,
;; stroke properties, dash, fill rule, operator, and opacity.
;;
;; Three things were wrong with this file and none of them could show up,
;; because its `describe` blocks sat at defmodule top level where the
;; compiler drops them:
;;
;;   - `fill-origin-red` declared its parameter `c : int`, so passing it to
;;     canvas-set-source-color was "expected Canvas, got int";
;;   - `(assert-eq true (>i a 110))` fed a bool to an int-typed assertion;
;;   - every `it` ended on `(surface-destroy s)`, which is nil where `it`
;;     wants a bool -- the assertions were computed and discarded.
;;
;; The last two cases ("accepts :non-zero and :even-odd", "accepts the
;; documented Porter-Duff keywords") contained no assertion at all: they
;; called the setters and looked at nothing. They now render through each
;; setting and check that the setting changed the pixels.
(defmodule plutovg/tests/state
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-eq assert-true])
  (import test/runner :refer [run-all-status])
  (import plutovg/types :refer [Canvas])
  (import plutovg/surface :refer [surface-create surface-destroy])
  (import plutovg/canvas
    :refer
    [canvas-create
     canvas-destroy
     canvas-set-source-color
     canvas-rect
     canvas-fill
     canvas-stroke
     canvas-save
     canvas-restore
     canvas-translate
     canvas-scale
     canvas-rotate
     canvas-transform
     canvas-reset-transform
     canvas-set-line-width
     canvas-set-line-cap
     canvas-set-line-join
     canvas-set-miter-limit
     canvas-set-dash-offset
     canvas-set-dash-array
     dash-array-create
     dash-array-add
     dash-array-destroy
     dash-array-count
     canvas-set-fill-rule
     canvas-set-operator
     canvas-set-opacity])
  (defn surface-byte [s : int n : int] : int
    ```c
    #include <plutovg.h>
    unsigned char *p = plutovg_surface_get_data((plutovg_surface_t *)(intptr_t)s);
    return (int64_t)p[(int)n];
    ```)
  (defn >i [a : int b : int] : bool
    ```c
    return (int)a > (int)b;
    ```)
  (defn <i [a : int b : int] : bool
    ```c
    return (int)a < (int)b;
    ```)
  (defn +i [a : int b : int] : int
    ```c
    return (int64_t)((int)a + (int)b);
    ```)
  ;; Render a single 1x1 red pixel at the canvas's current origin.
  (defn fill-origin-red [c : Canvas] : void
    (canvas-set-source-color c 1.0 0.0 0.0 1.0)
    (canvas-rect c 0.0 0.0 1.0 1.0)
    (canvas-fill c))
  ;;; two-rect-alpha -- alpha of the centre pixel after filling an 8x8 surface
  ;;; with two nested rects under fill rule `rule`.
  ;;;
  ;;; Both rects are traced in the same direction, so the centre lies inside
  ;;; both: winding number 2 (non-zero fills it), crossing count 2 (even-odd
  ;;; leaves it clear).  Returns -1 if the surface or canvas could not be made.
  (defn two-rect-alpha [rule : cstr] : int
    (let [sr (surface-create 8 8)]
      (if (not (ok? sr))
        -1
        (let [s  (ok-val sr)
              cr (canvas-create s)]
          (if (not (ok? cr))
            (do (surface-destroy s) -1)
            (let [c (ok-val cr)]
              (canvas-set-fill-rule c rule)
              (canvas-set-source-color c 1.0 0.0 0.0 1.0)
              (canvas-rect c 0.0 0.0 8.0 8.0)
              (canvas-rect c 2.0 2.0 4.0 4.0)
              (canvas-fill c)
              ;; centre pixel (4,4): row stride 32, so 4*32 + 4*4 + 3 = 147
              (let [a (surface-byte s 147)]
                (canvas-destroy c)
                (surface-destroy s)
                a)))))))
  (defn __all-tests [] : void
    (describe "plutovg/canvas transforms"
      (it "translates the origin so a 1x1 fill lands at (2, 1)"
        (let [sr (surface-create 4 4)]
          (if (not (ok? sr))
            (assert-true false)
            (let [s  (ok-val sr)
                  cr (canvas-create s)]
              (if (not (ok? cr))
                (do (surface-destroy s) (assert-true false))
                (let [c (ok-val cr)]
                  (canvas-translate c 2.0 1.0)
                  (fill-origin-red c)
                  (let [ ;; Pixel (2, 1) = byte offset (1*16) + (2*4) = 24..27 (B G R A)
                        b  (assert-eq 0 (surface-byte s 24))
                        g  (assert-eq 0 (surface-byte s 25))
                        r  (assert-eq 255 (surface-byte s 26))
                        a  (assert-eq 255 (surface-byte s 27))
                        ;; Pixel (0, 0) should be untouched (transparent)
                        z0 (assert-eq 0 (surface-byte s 0))
                        z3 (assert-eq 0 (surface-byte s 3))]
                    (canvas-destroy c)
                    (surface-destroy s)
                    (and b (and g (and r (and a (and z0 z3)))))))))))))
    (describe "plutovg/canvas state stack"
      (it "save/restore isolates a translate"
        (let [sr (surface-create 4 4)]
          (if (not (ok? sr))
            (assert-true false)
            (let [s  (ok-val sr)
                  cr (canvas-create s)]
              (if (not (ok? cr))
                (do (surface-destroy s) (assert-true false))
                (let [c (ok-val cr)]
                  (canvas-save c)
                  (canvas-translate c 3.0 0.0)
                  (fill-origin-red c)
                  (canvas-restore c)
                  ;; After restore, translate is undone -- fill at (0, 0)
                  (fill-origin-red c)
                  (let [ ;; Pixel (3, 0) red, (0, 0) red
                        p3 (assert-eq 255 (surface-byte s 14)) ; (3,0) R byte
                        p0 (assert-eq 255 (surface-byte s 2)) ; (0,0) R byte
                        ;; Pixel (1, 0) untouched
                        p1 (assert-eq 0 (surface-byte s 6))]
                    (canvas-destroy c)
                    (surface-destroy s)
                    (and p3 (and p0 p1))))))))))
    (describe "plutovg/canvas reset-transform"
      (it "discards accumulated translate / scale"
        (let [sr (surface-create 4 4)]
          (if (not (ok? sr))
            (assert-true false)
            (let [s  (ok-val sr)
                  cr (canvas-create s)]
              (if (not (ok? cr))
                (do (surface-destroy s) (assert-true false))
                (let [c (ok-val cr)]
                  (canvas-translate c 2.0 2.0)
                  (canvas-scale c 2.0 2.0)
                  (canvas-reset-transform c)
                  (fill-origin-red c)
                  ;; Pixel (0, 0) red
                  (let [p0 (assert-eq 255 (surface-byte s 2))]
                    (canvas-destroy c)
                    (surface-destroy s)
                    p0))))))))
    (describe "plutovg/canvas opacity"
      (it "scales the alpha of subsequent fills"
        (let [sr (surface-create 4 4)]
          (if (not (ok? sr))
            (assert-true false)
            (let [s  (ok-val sr)
                  cr (canvas-create s)]
              (if (not (ok? cr))
                (do (surface-destroy s) (assert-true false))
                (let [c (ok-val cr)]
                  (canvas-set-opacity c 0.5)
                  (canvas-set-source-color c 1.0 0.0 0.0 1.0)
                  (canvas-rect c 0.0 0.0 1.0 1.0)
                  (canvas-fill c)
                  ;; Output alpha at pixel (0,0) should be ~127 (premultiplied);
                  ;; 110..145 covers any rounding mode.
                  (let [a  (surface-byte s 3)
                        lo (assert-true (>i a 110))
                        hi (assert-true (<i a 145))]
                    (canvas-destroy c)
                    (surface-destroy s)
                    (and lo hi)))))))))
    (describe "plutovg/canvas dash array"
      (it "accepts a dash buffer and applies it to a stroke (smoke check)"
        (let [sr (surface-create 8 1)
              dr (dash-array-create)]
          (if (not (and (ok? sr) (ok? dr)))
            (assert-true false)
            (let [s  (ok-val sr)
                  cr (canvas-create s)]
              (if (not (ok? cr))
                (do (surface-destroy s) (assert-true false))
                (let [c      (ok-val cr)
                      dashes (ok-val dr)]
                  (dash-array-add dashes 2.0) ; 2 on
                  (dash-array-add dashes 2.0) ; 2 off
                  (canvas-set-source-color c 0.0 1.0 0.0 1.0)
                  (canvas-set-line-width c 1.0)
                  (canvas-set-line-cap c ":butt")
                  (canvas-set-line-join c ":miter")
                  (canvas-set-miter-limit c 4.0)
                  (canvas-set-dash-array c dashes)
                  (canvas-set-dash-offset c 0.0)
                  (canvas-rect c 0.0 0.0 8.0 1.0)
                  (canvas-stroke c)
                  (let [n    (assert-eq 2 (dash-array-count dashes))
                        ;; Smoke: at least one pixel along the stroked rect
                        ;; should be non-zero on the green channel.
                        any  (+i (surface-byte s 1)
                               (+i (surface-byte s 5) (surface-byte s 9)))
                        drew (assert-true (>i any 0))]
                    (dash-array-destroy dashes)
                    (canvas-destroy c)
                    (surface-destroy s)
                    (and n drew)))))))))
    (describe "plutovg/canvas fill rule"
      ;; The two rules have to disagree, or the setter is doing nothing.  Both
      ;; rects are wound the same way, so the centre is inside two subpaths:
      ;; non-zero fills it (winding 2), even-odd does not (crossings even).
      (it ":non-zero fills a doubly-enclosed centre and :even-odd leaves it clear"
        (let [nz (two-rect-alpha ":non-zero")
              eo (two-rect-alpha ":even-odd")
              a  (assert-eq 255 nz)
              b  (assert-eq 0 eo)]
          (and a b))))
    (describe "plutovg/canvas operator"
      ;; ":dst-out" keeps the destination only where the source is transparent,
      ;; so painting an opaque rect through it erases what is underneath.  If
      ;; the keyword were ignored the default ":src-over" would leave the pixel
      ;; opaque and the second assertion would fail.
      (it ":dst-out erases what :src-over painted"
        (let [sr (surface-create 4 4)]
          (if (not (ok? sr))
            (assert-true false)
            (let [s  (ok-val sr)
                  cr (canvas-create s)]
              (if (not (ok? cr))
                (do (surface-destroy s) (assert-true false))
                (let [c (ok-val cr)]
                  (canvas-set-operator c ":src-over")
                  (canvas-set-source-color c 1.0 0.0 0.0 1.0)
                  (canvas-rect c 0.0 0.0 4.0 4.0)
                  (canvas-fill c)
                  (let [painted (assert-eq 255 (surface-byte s 3))]
                    (canvas-set-operator c ":dst-out")
                    (canvas-set-source-color c 0.0 0.0 0.0 1.0)
                    (canvas-rect c 0.0 0.0 4.0 4.0)
                    (canvas-fill c)
                    (let [erased (assert-eq 0 (surface-byte s 3))]
                      (canvas-destroy c)
                      (surface-destroy s)
                      (and painted erased)))))))))))
  (defn main [] : int (__all-tests) (run-all-status)))
