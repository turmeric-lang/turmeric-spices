;; tests/plutovg/surface_test.tur -- PV0 tests for plutovg/surface.
;;
;; Every `it` body binds its assertion results and returns their conjunction
;; AFTER the cleanup call.  The obvious-looking shape
;;
;;   (it "..." (let [s ...] (assert-eq 64 (surface-width s)) (surface-destroy s)))
;;
;; does not work: `it` takes a bool, the body's value is its last expression,
;; and `surface-destroy` returns void -- so the assertions were computed and
;; thrown away, and the whole file failed to compile with
;; "function 'it' arg 2: expected bool, got nil".  Binding first keeps the
;; destroy-before-return ordering while still handing `it` the real result.
(defmodule plutovg/tests/surface
  ;; ok? / ok-val are auto-loaded stdlib globals; no explicit import needed.
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-eq assert-true])
  (import test/runner :refer [run-all-status])
  (import plutovg/surface
    :refer
    [surface-create surface-destroy surface-width surface-height surface-stride])
  (defn __all-tests [] : void
    (describe "plutovg/surface"
      (it "creates a surface with the requested dimensions"
        (let [r (surface-create 64 32)
              k (assert-true (ok? r))]
          (if k
            (let [s (ok-val r)
                  w (assert-eq 64 (surface-width s))
                  h (assert-eq 32 (surface-height s))
                  ;; plutovg surfaces are 32-bit ARGB; stride = width * 4
                  d (assert-eq 256 (surface-stride s))]
              (surface-destroy s)
              (and w (and h d)))
            false)))))
  (defn main [] : int (__all-tests) (run-all-status)))
