;; tools/render-all-kinds.tur -- the pixel gate for changes to plot's draw
;; path. Renders every renderer kind, alone and mixed (34 scenes), through
;; the public API to png/<scene>.png under the current directory.
;;
;; It puts no type annotation on a renderer value, so the same source builds
;; against plot before and after a change to how renderers are represented
;; (it builds against plot from the typed data records on). Build it on both
;; checkouts, run each in its own directory, and diff the PNGs byte for byte:
;;
;;   tur build spices/plot/tools/render-all-kinds.tur -o /tmp/before/render
;;   (cd /tmp/before && mkdir -p png && ./render)
;;   ... switch checkouts, build and run into /tmp/after the same way ...
;;   diff <(cd /tmp/before/png && md5sum *) <(cd /tmp/after/png && md5sum *)
;;
;; Text is drawn with whichever system font plot finds, so compare two runs
;; on one machine, never against PNGs from another.
(defmodule plot/tools/render-all-kinds
  (import plot/core :refer [plot-write-png])
  (import plot/line :refer [function lines parametric polar inverse density])
  (import plot/point :refer [points error-bars vector-field arrows])
  (import plot/interval
    :refer
    [function-interval lines-interval parametric-interval polar-interval])
  (import plot/area
    :refer
    [rectangles area-histogram discrete-histogram stacked-histogram])
  (import plot/contour :refer [isoline contours contour-intervals color-field])
  (import plot/decor
    :refer
    [x-axis
     y-axis
     axes
     x-tick-lines
     y-tick-lines
     tick-grid
     hrule
     hrule-styled
     vrule
     vrule-styled
     point-label
     point-label-styled])
  (import plot/data :refer [Point Rect ErrorBar Arrow Bar Group])
  (import plot/style
    :refer
    [FillStyle
     LineStyle
     PlotOpts
     line-style
     point-style
     fill-style
     plot-opts
     default-line-style
     default-point-style
     default-fill-style
     default-plot-opts])
  (defn nan [] : float ```c return 0.0 / 0.0; ```)
  ;; callbacks
  (defn sq [x : float] : float (* x x))
  (defn sq-hi [x : float] : float (+ (* x x) 0.5))
  (defn half [t : float] : Point (Point t (* 0.5 t)))
  (defn half-hi [t : float] : Point (Point t (+ (* 0.5 t) 0.3)))
  (defn radius [t : float] : float (+ 0.4 (* 0.1 (* t t))))
  (defn r-lo [t : float] : float 0.4)
  (defn r-hi [t : float] : float 0.8)
  (defn recip [x : float] : float (/ 1.0 x))
  (defn vf [x : float y : float] : Point (Point (* -1.0 y) x))
  (defn saddle [x : float y : float] : float (- (* x x) (* y y)))
  (defn colorize [x : float y : float] : int (if (> (+ x y) 0.0) 1 0))
  (defn pts [] : (Vec Point)
    (vec-of (Point -2.0 -1.0)
      (Point -1.0 0.5)
      (Point (nan) 0.0)
      (Point 1.0 1.5)))
  (defn styled [] : LineStyle (line-style 2 2.5 1 0.8))
  (defn fancy-opts [] : PlotOpts
    (plot-opts 640 480 "Title" "x label" "y label" (nan) (nan) (nan) (nan) 2))
  (defn main [] : int
    (let [ls    (default-line-style)
          ps    (default-point-style)
          fs    (default-fill-style)
          fills (vec-of fs (fill-style 3 0.7 1 2.0) fs)]
      (plot-write-png (vec-of (x-axis) (y-axis))
        (default-plot-opts)
        "png/xy-axis.png")
      (plot-write-png (vec-of (axes)) (default-plot-opts) "png/axes.png")
      (plot-write-png (vec-of (x-tick-lines) (y-tick-lines))
        (default-plot-opts)
        "png/xy-ticks.png")
      (plot-write-png (vec-of (tick-grid) (axes))
        (default-plot-opts)
        "png/grid.png")
      (plot-write-png (vec-of (axes)
                        (hrule 0.5)
                        (hrule-styled -0.25 (styled))
                        (vrule 0.75)
                        (vrule-styled -1.0 (styled)))
        (default-plot-opts)
        "png/rules.png")
      (plot-write-png (vec-of (axes)
                        (point-label 1.0 1.0 "one" 0)
                        (point-label-styled -1.0 0.5 "styled" 1 (styled)))
        (default-plot-opts)
        "png/labels.png")
      (plot-write-png (vec-of (axes) (lines (pts) ls "lines"))
        (default-plot-opts)
        "png/lines.png")
      (plot-write-png (vec-of (axes) (function sq -2.0 2.0 96 ls "f"))
        (default-plot-opts)
        "png/function.png")
      (plot-write-png (vec-of (axes)
                        (function recip -2.0 2.0 64 (styled) "1/x")
                        (lines (pts) ls ""))
        (default-plot-opts)
        "png/function-asymptote.png")
      (plot-write-png (vec-of (axes) (parametric half -1.0 1.0 96 ls "p"))
        (default-plot-opts)
        "png/parametric.png")
      (plot-write-png (vec-of (axes) (polar radius -3.0 3.0 96 ls "r"))
        (default-plot-opts)
        "png/polar.png")
      (plot-write-png (vec-of (axes) (inverse sq -1.0 1.0 96 ls "i"))
        (default-plot-opts)
        "png/inverse.png")
      (plot-write-png (vec-of (axes)
                        (density (vec-of 0.0 1.0 1.1 1.2 2.0) 0.0 64 ls "d")
                        (density (vec-of 0.5 1.5) 0.3 64 (styled) "d2"))
        (default-plot-opts)
        "png/density.png")
      (plot-write-png (vec-of (axes)
                        (points (pts) ps "pts")
                        (points (pts) (point-style 1 2 1 9.0 0.6) "sq")
                        (points (pts) (point-style 3 -1 3 7.0 0.0) "x")
                        (points (pts) (point-style 4 -1 4 7.0 0.0) "+")
                        (points (pts) (point-style 5 6 5 8.0 0.0) "d")
                        (points (pts) (point-style 6 7 2 8.0 0.0) "t"))
        (default-plot-opts)
        "png/points.png")
      (plot-write-png (vec-of (axes)
                        (error-bars (vec-of (ErrorBar 0.5 0.5 0.25)
                                      (ErrorBar 1.2 1.0 0.2))
                          ls
                          false
                          "v")
                        (error-bars (vec-of (ErrorBar 0.5 0.5 0.25)
                                      (ErrorBar 1.2 1.0 0.2))
                          ls
                          true
                          "h"))
        (default-plot-opts)
        "png/error-bars.png")
      (plot-write-png (vec-of (axes)
                        (vector-field vf -1.0 1.0 -1.0 1.0 8 0 ls "vf0"))
        (default-plot-opts)
        "png/vector-field0.png")
      (plot-write-png (vec-of (axes)
                        (vector-field vf -1.0 1.0 -1.0 1.0 8 1 ls "vf1")
                        (vector-field vf -0.5 0.5 -0.5 0.5 5 2 (styled) "vf2"))
        (default-plot-opts)
        "png/vector-field12.png")
      (plot-write-png (vec-of (axes)
                        (arrows (vec-of (Arrow -0.5 -0.5 0.5 0.5)
                                  (Arrow 0.0 1.0 1.0 0.2))
                          ls
                          "arr"))
        (default-plot-opts)
        "png/arrows.png")
      (plot-write-png (vec-of (axes)
                        (function-interval sq sq-hi -1.5 1.5 96 fs ls "fi"))
        (default-plot-opts)
        "png/function-interval.png")
      (plot-write-png (vec-of (axes)
                        (lines-interval (vec-of (Point -1.0 -0.5)
                                          (Point 0.0 0.0)
                                          (Point 1.0 0.5))
                          (vec-of (Point -1.0 0.2)
                            (Point 0.0 0.7)
                            (Point 1.0 1.1))
                          (fill-style 4 0.3 2 1.5)
                          (styled)
                          "li"))
        (default-plot-opts)
        "png/lines-interval.png")
      (plot-write-png (vec-of (axes)
                        (parametric-interval half
                          half-hi
                          -1.0
                          1.0
                          72
                          fs
                          ls
                          "pi"))
        (default-plot-opts)
        "png/parametric-interval.png")
      (plot-write-png (vec-of (axes)
                        (polar-interval r-lo r-hi -1.0 1.0 72 fs ls "po"))
        (default-plot-opts)
        "png/polar-interval.png")
      (plot-write-png (vec-of (rectangles (vec-of (Rect -1.0 -0.5 0.0 1.0)
                                            (Rect 0.2 0.9 0.0 0.6))
                                fs
                                "rects"))
        (default-plot-opts)
        "png/rectangles.png")
      (plot-write-png (vec-of (area-histogram (vec-of (Rect 0.0 0.5 0.0 1.0)
                                                (Rect 0.6 1.1 0.0 1.4))
                                fills
                                "ah"))
        (default-plot-opts)
        "png/area-histogram.png")
      (plot-write-png (vec-of (discrete-histogram (vec-of (Bar "A" 1.0)
                                                    (Bar "B" 1.4)
                                                    (Bar "C" 0.7))
                                fs
                                false
                                "dh"))
        (default-plot-opts)
        "png/discrete-histogram.png")
      (plot-write-png (vec-of (discrete-histogram (vec-of (Bar "A" 1.0)
                                                    (Bar "B" 1.4)
                                                    (Bar "C" 0.7))
                                fs
                                true
                                "dhi"))
        (default-plot-opts)
        "png/discrete-histogram-inv.png")
      (plot-write-png (vec-of (stacked-histogram (vec-of (Group "Q1"
                                                           (vec-of 1.0 0.8))
                                                   (Group "Q2" (vec-of 1.2 0.5)))
                                fills
                                (vec-of "one" "two")
                                false))
        (default-plot-opts)
        "png/stacked-histogram.png")
      (plot-write-png (vec-of (stacked-histogram (vec-of (Group "Q1"
                                                           (vec-of 1.0 0.8))
                                                   (Group "Q2" (vec-of 1.2 0.5)))
                                (:: (vec-new) (Vec FillStyle))
                                (vec-of "one" "two")
                                true))
        (default-plot-opts)
        "png/stacked-histogram-inv.png")
      (plot-write-png (vec-of (isoline saddle -2.0 2.0 -2.0 2.0 32 0.5 ls "iso"))
        (default-plot-opts)
        "png/isoline.png")
      (plot-write-png (vec-of (contours saddle
                                -2.0
                                2.0
                                -2.0
                                2.0
                                32
                                4
                                (styled)
                                "contours"))
        (default-plot-opts)
        "png/contours.png")
      (plot-write-png (vec-of (contour-intervals saddle
                                -2.0
                                2.0
                                -2.0
                                2.0
                                32
                                3
                                fills
                                "bands"))
        (default-plot-opts)
        "png/contour-intervals.png")
      (plot-write-png (vec-of (color-field colorize -2.0 2.0 -2.0 2.0 32 0.35))
        (default-plot-opts)
        "png/color-field.png")
      ;; everything at once, with title / axis labels / legend placement
      (plot-write-png (vec-of (tick-grid)
                        (axes)
                        (function sq -2.0 2.0 96 ls "f")
                        (lines (pts) ls "lines")
                        (points (pts) ps "pts")
                        (hrule 0.5)
                        (vrule 0.75)
                        (point-label 1.0 1.0 "one" 0)
                        (function-interval sq sq-hi -1.5 1.5 96 fs ls "fi")
                        (isoline saddle -2.0 2.0 -2.0 2.0 32 0.5 ls "iso")
                        (vector-field vf -1.0 1.0 -1.0 1.0 8 1 ls "vf1"))
        (fancy-opts)
        "png/mixed.png")
      (plot-write-png (vec-of (axes)
                        (discrete-histogram (vec-of (Bar "A" 1.0)
                                              (Bar "B" 1.4)
                                              (Bar "C" 0.7))
                          fs
                          false
                          "dh")
                        (hrule 1.2))
        (fancy-opts)
        "png/categorical-mixed.png")
      0)))
