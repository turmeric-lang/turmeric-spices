;; tests/plot/renderer_test.tur -- the Renderer typeclass, per kind.
;;
;; Every renderer kind is its own type (LinesR, FunctionR, Decoration, ...)
;; with a `Renderer` instance. These tests call the methods on each kind's
;; value directly -- static dispatch on the struct type, no AnyRenderer box:
;; `bounds` (the data extent the plot is laid out over) for every kind, and
;; what the frame asks of them -- `frame-marks`, `categories` and
;; `legend-label`. `draw` is covered by the suites that render each kind.

(defmodule plot/tests/renderer
  (import plot/core     :refer [bbox-empty? BBox FrameMarks])
  (import plot/line     :refer [LinesR FunctionR ParametricR PolarR InverseR DensityR])
  (import plot/point    :refer [PointsR ErrorBarsR VectorFieldR ArrowsR])
  (import plot/interval :refer [FunctionIntervalR LinesIntervalR ParametricIntervalR PolarIntervalR])
  (import plot/area     :refer [RectanglesR AreaHistogramR DiscreteHistogramR StackedHistogramR])
  (import plot/contour  :refer [IsolineR ContoursR ContourIntervalsR ColorFieldR])
  (import plot/decor    :refer [Decoration XAxis YAxis Axes XTickLines YTickLines TickGrid
                                HRuleR VRuleR LabelR])
  (import plot/style    :refer [FillStyle default-line-style default-fill-style])
  (import plot/data     :refer [Point Rect ErrorBar Arrow Bar Group])
  (import test/assert   :refer [assert-true])
  (import test/suite    :refer [describe it])
  (import test/runner   :refer [run-all-status])

  (defn nan [] : float ```c return 0.0 / 0.0; ```)

  (defn no-fills [] : (Vec FillStyle) (:: (vec-new) (Vec FillStyle)))
  (defn no-labels [] : (Vec cstr) (:: (vec-new) (Vec cstr)))

  (defn same-text? [a : cstr  b : cstr] : bool
    ```c
    #include <string.h>
    return a && b && strcmp(a, b) == 0;
    ```)

  (defn close? [a : float b : float] : bool
    ```c
    double d = (double)a - (double)b;
    if (d < 0) d = -d;
    return d < 1e-9;
    ```)

  (defn sq [x : float] : float (* x x))
  (defn half [t : float] : Point (Point t (* 0.5 t)))
  (defn saddle [x : float y : float] : float (- (* x x) (* y y)))
  (defn spin [x : float y : float] : Point (Point (* -1.0 y) x))
  (defn quadrant [x : float y : float] : int (if (> x 0.0) 1 0))

  ;; Points (-2,-1), (-1,0.5), (NaN,0), (1,1.5) -> box x:[-2,1] y:[-1,1.5];
  ;; the NaN point is a gap and contributes nothing.
  (defn sample-points [] : (Vec Point)
    (vec-of (Point -2.0 -1.0) (Point -1.0 0.5) (Point (nan) 0.0) (Point 1.0 1.5)))

  (defn bbox-eq? [bb : BBox  x0 : float x1 : float y0 : float y1 : float] : bool
    (and (assert-true (not (bbox-empty? bb)))
         (assert-true (close? x0 (.x-min bb)))
         (assert-true (close? x1 (.x-max bb)))
         (assert-true (close? y0 (.y-min bb)))
         (assert-true (close? y1 (.y-max bb)))))

  (defn empty? [bb : BBox] : bool (assert-true (bbox-empty? bb)))

  ;; --- point-list kinds ------------------------------------------------------

  (defn lines-bounds [] : bool
    (bbox-eq? (bounds (make-struct LinesR (sample-points) (default-line-style) ""))
              -2.0 1.0 -1.0 1.5))

  ;; PointsR is a distinct type from LinesR but shares the point-list rule.
  (defn points-bounds [] : bool
    (bbox-eq? (bounds (make-struct PointsR (sample-points) (default-line-style) ""))
              -2.0 1.0 -1.0 1.5))

  ;; The band spans both edges: lower y in [-1, 0], upper y in [0.5, 2].
  (defn lines-interval-bounds [] : bool
    (bbox-eq? (bounds (make-struct LinesIntervalR
                                   (vec-of (Point -1.0 -1.0) (Point 1.0 0.0))
                                   (vec-of (Point -1.0 0.5) (Point 1.0 2.0))
                                   (default-fill-style) (default-line-style) ""))
              -1.0 1.0 -1.0 2.0))

  ;; --- payload-shape kinds ---------------------------------------------------

  ;; A vertical bar spans y +/- err, a horizontal one x +/- err.
  (defn error-bars-bounds [] : bool
    (let [bars (vec-of (ErrorBar 0.5 0.5 0.25) (ErrorBar 1.0 2.0 0.5))]
      (and (bbox-eq? (bounds (make-struct ErrorBarsR bars (default-line-style) false ""))
                     0.5 1.0 0.25 2.5)
           (bbox-eq? (bounds (make-struct ErrorBarsR bars (default-line-style) true ""))
                     0.25 1.5 0.5 2.0))))

  ;; Both endpoints of every arrow -- not the arrow's second cons cell read as
  ;; a coordinate, as the old slot-bag bounds pass did.
  (defn arrows-bounds [] : bool
    (bbox-eq? (bounds (make-struct ArrowsR
                                   (vec-of (Arrow -0.5 -0.5 0.5 0.5) (Arrow 0.0 1.0 1.0 0.2))
                                   (default-line-style) ""))
              -0.5 1.0 -0.5 1.0))

  (defn rects-bounds [] : bool
    (let [rects (vec-of (Rect -1.0 -0.5 0.0 1.0) (Rect 0.2 0.9 0.0 0.6))]
      (and (bbox-eq? (bounds (make-struct RectanglesR rects (default-fill-style) ""))
                     -1.0 0.9 0.0 1.0)
           (bbox-eq? (bounds (make-struct AreaHistogramR rects (no-fills) ""))
                     -1.0 0.9 0.0 1.0))))

  ;; Three bars at slots 0, 1, 2 (each 0.8 wide), tallest 1.4.
  (defn discrete-hist-bounds [] : bool
    (let [bars (vec-of (Bar "A" 1.0) (Bar "B" 1.4) (Bar "C" 0.7))]
      (and (bbox-eq? (bounds (make-struct DiscreteHistogramR bars (default-fill-style) false ""))
                     0.0 2.8 0.0 1.4)
           (bbox-eq? (bounds (make-struct DiscreteHistogramR bars (default-fill-style) true ""))
                     0.0 1.4 0.0 2.8))))

  ;; Two stacks, 1.0 + 0.8 and 1.2 + 0.5: the taller sums to 1.8.
  (defn stacked-hist-bounds [] : bool
    (let [groups (vec-of (Group "Q1" (vec-of 1.0 0.8)) (Group "Q2" (vec-of 1.2 0.5)))]
      (and (bbox-eq? (bounds (make-struct StackedHistogramR groups (no-fills) (no-labels) false))
                     0.0 1.8 0.0 1.8)
           (bbox-eq? (bounds (make-struct StackedHistogramR groups (no-fills) (no-labels) true))
                     0.0 1.8 0.0 1.8))))

  ;; --- domain kinds: the declared domain is the extent ------------------------

  (defn grid-kinds-bounds [] : bool
    (and (bbox-eq? (bounds (make-struct IsolineR saddle -2.0 1.0 -3.0 4.0 16 0.5 (default-line-style) ""))
                   -2.0 1.0 -3.0 4.0)
         (bbox-eq? (bounds (make-struct ContoursR saddle -2.0 1.0 -3.0 4.0 16 3 (default-line-style) ""))
                   -2.0 1.0 -3.0 4.0)
         (bbox-eq? (bounds (make-struct ContourIntervalsR saddle -2.0 1.0 -3.0 4.0 16 3 (no-fills) ""))
                   -2.0 1.0 -3.0 4.0)
         (bbox-eq? (bounds (make-struct ColorFieldR quadrant -2.0 1.0 -3.0 4.0 16 0.5))
                   -2.0 1.0 -3.0 4.0)
         ;; a reversed domain still yields an ordered box
         (bbox-eq? (bounds (make-struct VectorFieldR spin 1.0 -2.0 4.0 -3.0 8 0 (default-line-style) ""))
                   -2.0 1.0 -3.0 4.0)))

  ;; A domain with a NaN edge constrains nothing.
  (defn nan-domain-is-empty [] : bool
    (empty? (bounds (make-struct IsolineR saddle (nan) 1.0 -3.0 4.0 16 0.5 (default-line-style) ""))))

  ;; --- kinds that constrain nothing -------------------------------------------

  ;; A sampled curve's extent is unknown until it is drawn, a decoration is
  ;; drawn at whatever extent the rest establish.
  (defn unconstrained-kinds [] : bool
    (and (empty? (bounds (make-struct FunctionR sq -2.0 2.0 64 (default-line-style) "")))
         (empty? (bounds (make-struct ParametricR half -1.0 1.0 64 (default-line-style) "")))
         (empty? (bounds (make-struct PolarR sq 0.0 3.0 64 (default-line-style) "")))
         (empty? (bounds (make-struct InverseR sq -1.0 1.0 64 (default-line-style) "")))
         (empty? (bounds (make-struct DensityR (vec-of 1.0) 0.0 64 (default-line-style) "")))
         (empty? (bounds (make-struct FunctionIntervalR sq sq -1.0 1.0 64
                                      (default-fill-style) (default-line-style) "")))
         (empty? (bounds (make-struct ParametricIntervalR half half -1.0 1.0 64
                                      (default-fill-style) (default-line-style) "")))
         (empty? (bounds (make-struct PolarIntervalR sq sq 0.0 1.0 64
                                      (default-fill-style) (default-line-style) "")))
         (empty? (bounds (XAxis)))
         (empty? (bounds (TickGrid)))))

  ;; --- point kinds --------------------------------------------------------------

  ;; A rule pins its coordinate and 0 on the other axis; a label its anchor.
  (defn point-kinds [] : bool
    (and (bbox-eq? (bounds (make-struct HRuleR 2.5 (default-line-style))) 0.0 0.0 2.5 2.5)
         (bbox-eq? (bounds (make-struct VRuleR -1.5 (default-line-style))) -1.5 -1.5 0.0 0.0)
         (bbox-eq? (bounds (make-struct LabelR 3.0 4.0 "hi" (default-line-style))) 3.0 3.0 4.0 4.0)
         (empty? (bounds (make-struct LabelR 3.0 (nan) "nan" (default-line-style))))))

  ;; --- what the frame asks of a renderer -------------------------------------

  (defn marks-eq? [m : FrameMarks  xa : bool  ya : bool  xg : bool  yg : bool] : bool
    (and (assert-true (= (.x-axis m) xa)) (assert-true (= (.y-axis m) ya))
         (assert-true (= (.x-grid m) xg)) (assert-true (= (.y-grid m) yg))))

  ;; Each decoration asks for its own axis line or grid; nothing else asks.
  (defn decoration-marks [] : bool
    (and (marks-eq? (frame-marks (XAxis))      true  false false false)
         (marks-eq? (frame-marks (YAxis))      false true  false false)
         (marks-eq? (frame-marks (Axes))       true  true  false false)
         (marks-eq? (frame-marks (XTickLines)) false false true  false)
         (marks-eq? (frame-marks (YTickLines)) false false false true)
         (marks-eq? (frame-marks (TickGrid))   false false true  true)
         (marks-eq? (frame-marks (make-struct LinesR (sample-points) (default-line-style) "l"))
                    false false false false)))

  ;; The categorical kinds lay the x axis out as categories, labelled by
  ;; their bars' (or groups') labels; others are not categorical.
  (defn histogram-categories [] : bool
    (let [disc    (make-struct DiscreteHistogramR (vec-of (Bar "A" 1.0) (Bar "B" 2.0))
                               (default-fill-style) false "")
          stacked (make-struct StackedHistogramR (vec-of (Group "Q1" (vec-of 1.0)))
                               (no-fills) (no-labels) false)
          dl      (category-labels disc)
          sl      (category-labels stacked)]
      (and (assert-true (categorical? disc))
           (assert-true (categorical? stacked))
           (assert-true (= (vec-len dl) 2))
           (assert-true (same-text? (vec-get dl 0) "A"))
           (assert-true (same-text? (vec-get dl 1) "B"))
           (assert-true (= (vec-len sl) 1))
           (assert-true (same-text? (vec-get sl 0) "Q1"))
           (assert-true (not (categorical? (make-struct RectanglesR (vec-of (Rect 0.0 1.0 0.0 1.0))
                                                        (default-fill-style) "r"))))
           (assert-true (not (categorical? (XAxis)))))))

  ;; A labelled kind lists its label; a label renderer's text is not a legend
  ;; entry, and an axis has none.
  (defn legend-labels [] : bool
    (and (assert-true (same-text? (legend-label (make-struct LinesR (sample-points) (default-line-style) "data"))
                                "data"))
         (assert-true (same-text? (legend-label (make-struct FunctionR sq -1.0 1.0 32 (default-line-style) "f"))
                                "f"))
         (assert-true (same-text? (legend-label (make-struct LabelR 1.0 1.0 "note" (default-line-style))) ""))
         (assert-true (same-text? (legend-label (Axes)) ""))))

  (defn main [] : int
    (describe "plot Renderer typeclass -- bounds per kind"
      (it "LinesR spans its points, skipping NaN gaps" (lines-bounds))
      (it "PointsR (distinct type, same rule)"         (points-bounds))
      (it "LinesIntervalR spans both edges"            (lines-interval-bounds))
      (it "ErrorBarsR spans each bar, either way"      (error-bars-bounds))
      (it "ArrowsR spans both endpoints of each arrow" (arrows-bounds))
      (it "RectanglesR / AreaHistogramR span their quads" (rects-bounds))
      (it "DiscreteHistogramR spans its slots"         (discrete-hist-bounds))
      (it "StackedHistogramR spans its stack sums"     (stacked-hist-bounds))
      (it "grid kinds report their declared domain"    (grid-kinds-bounds))
      (it "a NaN domain edge constrains nothing"       (nan-domain-is-empty))
      (it "curves, bands and decorations constrain nothing" (unconstrained-kinds))
      (it "rules and labels pin one point"             (point-kinds))
      (it "decorations ask the frame for their axes / grids" (decoration-marks))
      (it "histograms name the frame's categories"     (histogram-categories))
      (it "legend-label: labelled kinds only"          (legend-labels)))
    (run-all-status)))
