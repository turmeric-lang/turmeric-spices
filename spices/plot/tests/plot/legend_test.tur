;; tests/plot/legend_test.tur -- a legend row's swatch is what its renderer
;; drew with: the color its style resolved to (an auto color included), as a
;; stroke for a line, a box for a fill (edged in the line style for a band),
;; or the point marker.
;;
;; The swatches are read back from the surface. With legend-pos 1 in a
;; 400 x 300 plot, row 0's swatch spans x 256..268 at y 60 (the frame leaves
;; room for a title whenever one is given, "" included), so pixel (262, 60)
;; is its middle. The legend is only drawn when the frame
;; finds a font; without one each check passes with a note instead.

(defmodule plot/tests/legend
  (import plot/core     :refer [plot __ok? __ok-val __surface-destroy
                                __surface-pixel-byte __count-non-background])
  (import plot/line     :refer [lines])
  (import plot/point    :refer [points])
  (import plot/area     :refer [rectangles stacked-histogram])
  (import plot/interval :refer [function-interval])
  (import plot/style    :refer [PlotOpts plot-opts line-style point-style fill-style])
  (import plot/data     :refer [Point Rect Group])
  (import test/assert   :refer [assert-true])
  (import test/suite    :refer [describe it])
  (import test/runner   :refer [run-all-status])

  ;; A fixed frame with the legend at `pos` (1 top right, 3 bottom right).
  (defn opts-at [pos : int] : PlotOpts
    (plot-opts 400 300 "" "" "" -2.0 2.0 -1.0 4.0 pos))

  (defn opts [] : PlotOpts (opts-at 1))

  (defn near? [a : int b : int] : bool
    ```c
    int64_t d = a - b;
    return d >= -8 && d <= 8;
    ```)

  ;; Does this machine draw legends at all? Only when the frame finds a font:
  ;; a one-line plot labelled "probe" then has text beside row 0's swatch.
  (defn legend-drawn? [] : bool
    (let [rr (plot (vec-of (lines (vec-of (Point -1.0 -0.5) (Point 1.0 -0.5))
                                  (line-style -1 1.0 0 1.0) "probe"))
                   (opts))]
      (if (__ok? rr)
        (let [s     (__ok-val rr)
              text? (> (__count-non-background s 274 50 330 68) 0)]
          (__surface-destroy s)
          text?)
        false)))

  ;; Is pixel (x, y) of rs's picture, plotted with `o`, the color (r, g, b)?
  ;; With no legend on this machine (no font), say so and answer true.
  (defn pixel-is-with? [rs : (Vec AnyRenderer)  o : PlotOpts  x : int  y : int
                        r : int  g : int  b : int] : bool
    (if (not (legend-drawn?))
      (do (println "# no font found: the legend is not drawn") true)
      (let [rr (plot rs o)]
        (if (__ok? rr)
          (let [s  (__ok-val rr)
                ok (and (near? (__surface-pixel-byte s x y 2) r)
                        (near? (__surface-pixel-byte s x y 1) g)
                        (near? (__surface-pixel-byte s x y 0) b))]
            (__surface-destroy s)
            ok)
          false))))

  (defn pixel-is? [rs : (Vec AnyRenderer)  x : int  y : int  r : int  g : int  b : int] : bool
    (pixel-is-with? rs (opts) x y r g b))

  ;; Data well below the legend, so only the swatch is at its pixels.
  (defn low-line [y : float] : (Vec Point)
    (vec-of (Point -1.0 y) (Point 1.0 y)))

  ;; The labelled line follows an unlabelled one that took auto color 0, so
  ;; it drew in palette 1 (red) -- and its swatch, row 0, is red too.
  (defn auto-color-swatch [] : bool
    (let [ls (line-style -1 4.0 0 1.0)]
      (assert-true
        (pixel-is? (vec-of (lines (low-line -0.5) ls "")
                           (lines (low-line -0.8) ls "b"))
                   262 60 214 39 40))))

  ;; A fill swatch is a box of the fill's color (palette 3, orange).
  (defn fill-swatch [] : bool
    (assert-true
      (pixel-is? (vec-of (rectangles (vec-of (Rect -1.0 0.0 -1.0 -0.5))
                                     (fill-style 3 1.0 -1 0.0) "r"))
                 262 60 255 127 14)))

  ;; A point swatch is the marker: an 8-pixel square filled with palette 4.
  (defn point-swatch [] : bool
    (assert-true
      (pixel-is? (vec-of (points (vec-of (Point 0.0 -0.5)) (point-style 4 4 1 8.0 1.0) "p"))
                 262 60 148 103 189)))

  ;; A band's swatch is its fill (palette 0, blue) edged top and bottom, at
  ;; y 56 and 64, in its outline's line style (palette 1, red).
  (defn band-swatch [] : bool
    (let [rs (vec-of (function-interval (fn [x : float] : float -0.9)
                                        (fn [x : float] : float -0.6)
                                        -1.0 1.0 16
                                        (fill-style 0 1.0 -1 0.0)
                                        (line-style 1 2.0 0 1.0) "i"))]
      (and (assert-true (pixel-is? rs 262 60 31 119 180))
           (assert-true (pixel-is? rs 262 56 214 39 40)))))

  ;; A stacked histogram lists each layer, row k (16 pixels down per row)
  ;; swatched in layer k's fill: palette 0 (blue), then palette 3 (orange).
  (defn layer-rows [] : bool
    (let [rs (vec-of (stacked-histogram (vec-of (Group "Q1" (vec-of 0.5 0.25))
                                                (Group "Q2" (vec-of 0.25 0.5)))
                                        (vec-of (fill-style 0 1.0 -1 0.0) (fill-style 3 1.0 -1 0.0))
                                        (vec-of "base" "top") false))]
      (and (assert-true (pixel-is? rs 262 60 31 119 180))
           (assert-true (pixel-is? rs 262 76 255 127 14)))))

  ;; The rows sit on a translucent white box: over an opaque blue fill
  ;; (palette 0) covering the plot, a pixel inside the box beside the swatch
  ;; is 85% white over that blue.
  (defn legend-has-a-box [] : bool
    (assert-true
      (pixel-is? (vec-of (rectangles (vec-of (Rect -2.0 2.0 -1.0 4.0))
                                     (fill-style 0 1.0 -1 0.0) "r"))
                 252 60 221 235 244)))

  ;; A bottom legend stacks upward: with two rows, the last ends 16 pixels
  ;; above the plot's bottom edge (y 242), so row 0 is at y 210 and row 1 at
  ;; y 226 -- not below the plot.
  (defn bottom-legend-stacks-up [] : bool
    (let [ls (line-style -1 4.0 0 1.0)
          rs (vec-of (lines (low-line -0.5) ls "a")
                     (lines (low-line -0.8) ls "b"))]
      (and (assert-true (pixel-is-with? rs (opts-at 3) 262 210 31 119 180))
           (assert-true (pixel-is-with? rs (opts-at 3) 262 226 214 39 40)))))

  (defn main [] : int
    (describe "plot legend swatches"
      (it "a swatch takes the auto color its renderer drew with" (auto-color-swatch))
      (it "a fill's swatch is a box of its color"                (fill-swatch))
      (it "a point renderer's swatch is its marker"              (point-swatch))
      (it "a band's swatch is its fill edged in its outline"     (band-swatch))
      (it "a stacked histogram has a row per layer"              (layer-rows))
      (it "the rows sit on a translucent box"                     (legend-has-a-box))
      (it "a bottom legend stacks upward from the bottom edge"   (bottom-legend-stacks-up)))
    (run-all-status)))
