;; tests/plot/point_test.tur -- point renderer smoke tests.
(defmodule plot/tests/point
  (import plot/core
    :refer
    [plot
     plot-write-png
     __ok?
     __ok-val
     __surface-destroy
     __pixel-is-background?
     __count-non-background])
  (import plot/point :refer [points error-bars vector-field arrows])
  (import plot/line :refer [function])
  (import plot/decor :refer [axes])
  (import plot/style
    :refer
    [default-line-style default-point-style default-plot-opts])
  (import plot/data :refer [Point ErrorBar Arrow])
  (import test/assert :refer [assert-ok assert-true])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  (defn file-size [path : cstr] : int
    ```c
    #include <sys/stat.h>
    struct stat st;
    if (stat((const char *)(intptr_t)path, &st) != 0) return -1;
    return (int64_t)st.st_size;
    ```)
  (defn >i [a : int b : int] : bool ```c return (int)a > (int)b; ```)
  ;; Curve / vector-field callbacks: any value of the callback's fn type.
  (defn pt-diag [x : float] : float ```c return (double)x; ```)
  (defn pt-vf [x : float y : float] : Point (Point (* -1.0 y) x))
  (defn point-renderers [] : (Vec AnyRenderer)
    (vec-of (axes)
      (function pt-diag -1.0 2.0 64 (default-line-style) "diag")
      (points (vec-of (Point 0.0 0.0) (Point 1.0 1.0) (Point 1.5 0.5))
        (default-point-style)
        "pts")
      (error-bars (vec-of (ErrorBar 0.5 0.5 0.25) (ErrorBar 1.2 1.0 0.2))
        (default-line-style)
        false
        "err")
      (vector-field pt-vf -1.0 1.0 -1.0 1.0 8 1 (default-line-style) "vf")
      (arrows (vec-of (Arrow -0.5 -0.5 0.5 0.5) (Arrow 0.0 1.0 1.0 0.2))
        (default-line-style)
        "arr")))
  (defn write-point-png-ok [] : bool
    (let [rs (point-renderers)]
      (and (assert-ok (plot-write-png rs
                        (default-plot-opts)
                        "/tmp/tur-plot-point.png"))
        (assert-true (>i (file-size "/tmp/tur-plot-point.png") 100)))))
  (defn pixel-sanity-point [] : bool
    (let [rs (point-renderers)
          rr (plot rs (default-plot-opts))]
      (if (__ok? rr)
        (let [s       (__ok-val rr)
              corner? (__pixel-is-background? s 4 4)
              ink     (__count-non-background s 100 100 500 350)]
          (__surface-destroy s)
          (and (assert-true corner?) (assert-true (>i ink 100))))
        (assert-true false))))
  (defn main [] : int
    (describe "plot/point"
      (it "renders point and arrow-based plots" (write-point-png-ok))
      (it "draws non-background marks in the interior" (pixel-sanity-point)))
    (run-all-status)))
