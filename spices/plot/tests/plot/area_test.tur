;; tests/plot/area_test.tur -- area renderer smoke tests.

(defmodule plot/tests/area
  (import plot/core  :refer [plot plot-write-png
                             __ok? __ok-val __surface-destroy __surfaces-equal?
                             __pixel-is-background? __count-non-background])
  (import plot/area  :refer [rectangles area-histogram discrete-histogram stacked-histogram])
  (import plot/style :refer [FillStyle PlotOpts plot-opts fill-style default-fill-style
                             default-plot-opts])
  (import plot/data  :refer [Rect Bar Group])
  (import test/assert :refer [assert-ok assert-true])
  (import test/suite  :refer [describe it])
  (import test/runner :refer [run-all-status])

  (defn file-size [path : cstr] : int
    ```c
    #include <sys/stat.h>
    struct stat st;
    if (stat((const char *)(intptr_t)path, &st) != 0) return -1;
    return (int64_t)st.st_size;
    ```)

  (defn rect-data [] : (Vec Rect)
    (vec-of (Rect -1.0 -0.5 0.0 1.0) (Rect 0.2 0.9 0.0 0.6)))

  (defn area-bars [] : (Vec Rect)
    (vec-of (Rect 0.0 0.5 0.0 1.0) (Rect 0.6 1.1 0.0 1.4)))

  (defn cat-bars [] : (Vec Bar)
    (vec-of (Bar "A" 1.0) (Bar "B" 1.4) (Bar "C" 0.7)))

  (defn stack-groups [] : (Vec Group)
    (vec-of (Group "Q1" (vec-of 1.0 0.8)) (Group "Q2" (vec-of 1.2 0.5))))

  (defn stack-labels [] : (Vec cstr)
    (vec-of "one" "two"))

  (defn area-renderers [fill : FillStyle  fills : (Vec FillStyle)] : (Vec AnyRenderer)
    (vec-of (rectangles (rect-data) fill "rects")
            (area-histogram (area-bars) fills "ah")
            (discrete-histogram (cat-bars) fill false "dh")
            (stacked-histogram (stack-groups)
                               fills
                               (stack-labels)
                               false)))

  (defn write-area-png-ok [] : bool
    (let [fill (default-fill-style)
          fills (vec-of fill fill fill)
          rs   (area-renderers fill fills)]
      (and (assert-ok (plot-write-png rs (default-plot-opts) "/tmp/tur-plot-area.png"))
           (assert-true (>i (file-size "/tmp/tur-plot-area.png") 100)))))

  (defn pixel-sanity-area [] : bool
    (let [fill  (default-fill-style)
          fills (vec-of fill fill fill)
          rs    (area-renderers fill fills)
          rr    (plot rs (default-plot-opts))]
      (if (__ok? rr)
        (let [s       (__ok-val rr)
              corner? (__pixel-is-background? s 4 4)
              ink     (__count-non-background s 100 100 500 350)]
          (__surface-destroy s)
          (and (assert-true corner?)
               (assert-true (>i ink 100))))
        (assert-true false))))

  (defn >i [a : int b : int] : bool ```c return (int)a > (int)b; ```)

  ;; A fixed frame, so the pictures compared below share one.
  (defn fixed-opts [] : PlotOpts
    (plot-opts 400 300 "" "" "" -1.0 3.0 -1.0 3.0 0))

  (defn same-pixels? [a : (Vec AnyRenderer)  b : (Vec AnyRenderer)] : bool
    (let [r1 (plot a (fixed-opts))
          r2 (plot b (fixed-opts))]
      (if (and (__ok? r1) (__ok? r2))
        (let [s1 (__ok-val r1)
              s2 (__ok-val r2)
              eq (__surfaces-equal? s1 s2)]
          (__surface-destroy s1)
          (__surface-destroy s2)
          eq)
        false)))

  ;; An auto-colored fill (the default style) resolves once per series: a
  ;; discrete histogram's bars and a stack layer are one color everywhere, the
  ;; color the same plot draws when the palette entry is named outright.
  ;; (Default fills are drawn at alpha 0.5.)
  (defn auto-fill-is-one-color [] : bool
    (let [no-names (:: (vec-new) (Vec cstr))]
      (and (assert-true
             (same-pixels? (vec-of (discrete-histogram (cat-bars) (default-fill-style) false ""))
                           (vec-of (discrete-histogram (cat-bars) (fill-style 0 0.5 -1 0.0) false ""))))
           (assert-true
             (same-pixels? (vec-of (rectangles (rect-data) (default-fill-style) ""))
                           (vec-of (rectangles (rect-data) (fill-style 0 0.5 -1 0.0) ""))))
           (assert-true
             (same-pixels? (vec-of (stacked-histogram (stack-groups)
                                                      (vec-of (default-fill-style) (default-fill-style))
                                                      no-names false))
                           (vec-of (stacked-histogram (stack-groups)
                                                      (vec-of (fill-style 0 0.5 -1 0.0) (fill-style 1 0.5 -1 0.0))
                                                      no-names false)))))))

  (defn main [] : int
    (describe "plot/area"
      (it "renders rectangles and histograms"
        (write-area-png-ok))
      (it "fills the plot interior with non-background pixels"
        (pixel-sanity-area))
      (it "an auto-colored fill is one color per bar series or stack layer"
        (auto-fill-is-one-color)))
    (run-all-status)))
