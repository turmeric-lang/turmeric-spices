;; tests/plot/contour_test.tur -- contour renderer smoke tests.
(defmodule plot/tests/contour
  (import plot/core
    :refer
    [plot
     plot-write-png
     __ok?
     __ok-val
     __surface-destroy
     __surfaces-equal?
     __pixel-is-background?
     __count-non-background])
  (import plot/contour :refer [isoline contours contour-intervals color-field])
  (import plot/decor :refer [axes])
  (import plot/style
    :refer
    [PlotOpts plot-opts default-line-style default-fill-style default-plot-opts])
  (import test/assert :refer [assert-ok assert-true])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  (defn saddle [x : float y : float] : float (- (* x x) (* y y)))
  (defn nowhere [x : float y : float] : float
    ```c
    return 0.0 / 0.0;
    ```)
  (defn colorize [x : float y : float] : int (if (> (+ x y) 0.0) 1 0))
  (defn file-size [path : cstr] : int
    ```c
    #include <sys/stat.h>
    struct stat st;
    if (stat((const char *)(intptr_t)path, &st) != 0) return -1;
    return (int64_t)st.st_size;
    ```)
  (defn contour-renderers [] : (Vec AnyRenderer)
    (let [fills (vec-of (default-fill-style)
                  (default-fill-style)
                  (default-fill-style))]
      (vec-of (color-field colorize -2.0 2.0 -2.0 2.0 32 0.35)
        (contour-intervals saddle -2.0 2.0 -2.0 2.0 32 3 fills "bands")
        (contours saddle -2.0 2.0 -2.0 2.0 32 4 (default-line-style) "contours")
        (isoline saddle -2.0 2.0 -2.0 2.0 32 0.0 (default-line-style) "zero"))))
  (defn write-contour-png-ok [] : bool
    (let [rs (contour-renderers)]
      (and (assert-ok (plot-write-png rs
                        (default-plot-opts)
                        "/tmp/tur-plot-contour.png"))
        (assert-true (>i (file-size "/tmp/tur-plot-contour.png") 100)))))
  ;; Contour / color-field renderers should fill or stroke a large portion of
  ;; the plot interior. A blank image would have a much lower count.
  (defn pixel-sanity-contour [] : bool
    (let [rs (contour-renderers)
          rr (plot rs (default-plot-opts))]
      (if (__ok? rr)
        (let [s       (__ok-val rr)
              corner? (__pixel-is-background? s 4 4)
              ink     (__count-non-background s 100 100 500 350)]
          (__surface-destroy s)
          (and (assert-true corner?) (assert-true (>i ink 500))))
        (assert-true false))))
  (defn >i [a : int b : int] : bool ```c return (int)a > (int)b; ```)
  ;; A fixed extent, so the pictures compared below share one frame.
  (defn opts [] : PlotOpts (plot-opts 400 300 "" "" "" -2.0 2.0 -2.0 2.0 0))
  ;; Render a and b and compare their pixels.
  (defn same-pixels? [a : (Vec AnyRenderer) b : (Vec AnyRenderer)] : bool
    (let [r1 (plot a (opts))
          r2 (plot b (opts))]
      (if (and (__ok? r1) (__ok? r2))
        (let [s1 (__ok-val r1)
              s2 (__ok-val r2)
              eq (__surfaces-equal? s1 s2)]
          (__surface-destroy s1)
          (__surface-destroy s2)
          eq)
        false)))
  ;; The saddle takes values symmetric about 0 on this grid, so the middle
  ;; of its range -- where `contours`' one level goes -- is exactly 0.
  (defn one-level-is-mid-range [] : bool
    (let [ls (default-line-style)]
      (assert-true (same-pixels? (vec-of (contours saddle
                                           -2.0
                                           2.0
                                           -2.0
                                           2.0
                                           32
                                           1
                                           ls
                                           ""))
                     (vec-of (isoline saddle -2.0 2.0 -2.0 2.0 32 0.0 ls ""))))))
  ;; The non-background pixels of rs, rendered in the fixed frame.
  (defn ink [rs : (Vec AnyRenderer)] : int
    (let [rr (plot rs (opts))]
      (if (__ok? rr)
        (let [s (__ok-val rr)
              n (__count-non-background s 0 0 400 300)]
          (__surface-destroy s)
          n)
        -1)))
  ;; n levels are n different contours, not n copies of one: four levels
  ;; ink well over the 0 contour's pixels (coincident strokes would ink the
  ;; same pixels, only darker).
  (defn levels-are-distinct [] : bool
    (let [ls    (default-line-style)
          frame (ink (:: (vec-new) (Vec AnyRenderer)))
          one   (ink (vec-of (isoline saddle -2.0 2.0 -2.0 2.0 32 0.0 ls "")))
          four  (ink (vec-of (contours saddle -2.0 2.0 -2.0 2.0 32 4 ls "")))]
      (and (assert-true (>i one frame))
        (assert-true (>i (* 2 (- four frame)) (* 3 (- one frame)))))))
  ;; A field with no finite value has no range, and no contours.
  (defn no-finite-value-no-contours [] : bool
    (assert-true (same-pixels? (vec-of (axes))
                   (vec-of (axes)
                     (contours nowhere
                       -2.0
                       2.0
                       -2.0
                       2.0
                       32
                       4
                       (default-line-style)
                       "")))))
  (defn main [] : int
    (describe "plot/contour"
      (it "renders contour-like plots" (write-contour-png-ok))
      (it "covers the interior with non-background ink" (pixel-sanity-contour))
      (it "contours' single level is the middle of the field's range"
        (one-level-is-mid-range))
      (it "contours' levels are distinct" (levels-are-distinct))
      (it "contours of a field with no finite value draw nothing"
        (no-finite-value-no-contours)))
    (run-all-status)))
