;; errors/not-a-renderer.tur -- only a type with a Renderer instance can be
;; boxed as an AnyRenderer, so a stray value cannot reach the draw pass.

(defmodule plot/errors/not-a-renderer
  (import plot/core :refer [any-renderer])

  (defstruct ^copy NotR [x : int])

  (defn main [] : int
    (let [r (any-renderer (make-struct NotR 1))]
      0)))
