;; errors/wrong-callback-type.tur -- a curve callback has a real function
;; type: `function` wants (fn [float] float), so an int -> int defn is
;; rejected where the untyped parameter it replaced took anything.

(defmodule plot/errors/wrong-callback-type
  (import plot/line  :refer [function])
  (import plot/style :refer [default-line-style])

  (defn twice [n : int] : int (* 2 n))

  (defn main [] : int
    (let [r (function twice -1.0 1.0 32 (default-line-style) "")]
      0)))
