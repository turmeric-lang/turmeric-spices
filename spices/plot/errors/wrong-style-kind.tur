;; errors/wrong-style-kind.tur -- the style handles are distinct types: a
;; FillStyle where a LineStyle is due is a type error. As `:int` handles the
;; draw pass read the fill style's fields as a line style's.

(defmodule plot/errors/wrong-style-kind
  (import plot/line  :refer [lines])
  (import plot/style :refer [default-fill-style])

  (defn main [] : int
    (let [r (lines 0 (default-fill-style) "")]
      0)))
