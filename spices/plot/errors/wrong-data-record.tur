;; errors/wrong-data-record.tur -- renderer data is typed records: a
;; polyline's points are a (Vec Point), so rectangles handed to `lines` are a
;; type error. As cons lists of double bits, a quad list passed to `lines`
;; drew whatever its cells happened to hold.

(defmodule plot/errors/wrong-data-record
  (import plot/line  :refer [lines])
  (import plot/style :refer [default-line-style])
  (import plot/data  :refer [Rect])

  (defn main [] : int
    (let [r (lines (vec-of (Rect 0.0 1.0 0.0 1.0)) (default-line-style) "")]
      0)))
