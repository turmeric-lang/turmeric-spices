;; errors/int-handle-vec.tur -- `plot` takes a (Vec AnyRenderer); a Vec of
;; integers (the slot-bag handles it took through 0.4.0) is a type error, not
;; a mis-render.
(defmodule plot/errors/int-handle-vec
  (import plot/core :refer [plot])
  (import plot/style :refer [default-plot-opts])
  (defn main [] : int (do (plot (vec-of 1 2 3) (default-plot-opts)) 0)))
