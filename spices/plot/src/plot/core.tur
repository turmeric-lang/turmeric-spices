;; plot/core.tur -- renderer representation and plot entrypoints.

(defmodule plot/core
  (export plot plot-write-png plot-into-canvas render
          ;; `render` is generic over `^Backend B`, so a caller cannot build
          ;; an argument for it without the backend structs -- exporting the
          ;; entry point but not its sinks left it unusable, and is what made
          ;; tests/plot/backend_test.tur fail on "symbol 'SurfaceBackend' is
          ;; private to module 'plot/core'".
          CanvasBackend SurfaceBackend PngBackend
          ;; AnyRenderer: the boxed form every public constructor returns.
          ;; (The `Renderer` class and its `bounds` / `to-legacy` methods are
          ;; global, as every class is; they are not exported by name.)
          any-renderer
          ;; slot-bag helpers that each kind's `to-legacy` lowers through
          __make-renderer __renderer-floats __renderer-ints __renderer-bounds
          __surface-create __surface-destroy __surface-write-png
          __canvas-create __canvas-destroy
          __plot-sample-adaptive
          BBox renderer-bbox renderers-bbox bbox-empty? bbox-from-raw
          bbox-union bbox-empty-box point-bbox hint-bbox
          __point-list-bbox __error-bars-bbox __arrows-bbox __rects-bbox
          __discrete-hist-bbox __stacked-hist-bbox
          anyrenderers->legacy plot-anyrenderers __surfaces-equal?
          __ok? __ok-val __err-val
          __surface-width __surface-height __surface-pixel-byte
          __pixel-is-background? __count-non-background)

  (import plot/style :refer [plot-opts-width plot-opts-height])

  ;; Result helpers: route through the typed preamble builders /
  ;; inspectors (tur_ok_int / tur_err_int / tur_is_ok / tur_ok_value /
  ;; tur_err_value) so the canonical layout lives in one place
  ;; (tur_runtime.h). The :ptr<void> carrier surface is preserved
  ;; because the in-tree plot modules and test suite both call these
  ;; through their existing types; tightening to (Result int int) is a
  ;; downstream sweep beyond this migration's scope.

  ;;; __ok -- create an ok result wrapping integer value v.
  (defn __ok [v : int] : ptr<void>
    ```c
    return (void *)(intptr_t)tur_ok_int(v);
    ```)

  ;;; __err -- create an err result wrapping integer error value e.
  (defn __err [e : int] : ptr<void>
    ```c
    return (void *)(intptr_t)tur_err_int(e);
    ```)

  ;;; __ok? -- predicate for the local :ptr<void> result envelope.
  (defn __ok? [r : ptr<void>] : bool
    ```c
    return r != 0 && tur_is_ok((int64_t)(intptr_t)r);
    ```)

  ;;; __ok-val -- extract the ok payload from the local :ptr<void> result envelope.
  (defn __ok-val [r : ptr<void>] : int
    ```c
    return r != 0 ? tur_ok_value((int64_t)(intptr_t)r) : 0;
    ```)

  ;;; __err-val -- extract the err payload from the local :ptr<void> result envelope.
  (defn __err-val [r : ptr<void>] : int
    ```c
    return r != 0 ? tur_err_value((int64_t)(intptr_t)r) : 0;
    ```)

  ;;; __make-renderer -- allocate the generic opaque renderer handle used by all plot modules.
  (defn __make-renderer [kind : int
                         style1 : int style2 : int
                         data1 : int data2 : int data3 : int data4 : int data5 : int
                         label : cstr text : cstr] : int
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    #include <string.h>
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;
    PlotRenderer *r = (PlotRenderer *)malloc(sizeof(*r));
    const char *src_label = (const char *)(intptr_t)label;
    const char *src_text = (const char *)(intptr_t)text;
    if (!r) return 0;
    r->kind = kind;
    r->style1 = style1; r->style2 = style2;
    r->data1 = data1; r->data2 = data2; r->data3 = data3; r->data4 = data4; r->data5 = data5;
    r->f1 = 0.0; r->f2 = 0.0; r->f3 = 0.0; r->f4 = 0.0; r->f5 = 0.0; r->f6 = 0.0;
    r->i1 = 0; r->i2 = 0; r->i3 = 0; r->i4 = 0;
    if (src_label) {
      size_t len = strlen(src_label);
      r->label = (char *)malloc(len + 1);
      if (r->label) memcpy(r->label, src_label, len + 1);
    } else {
      r->label = NULL;
    }
    if (src_text) {
      size_t len = strlen(src_text);
      r->text = (char *)malloc(len + 1);
      if (r->text) memcpy(r->text, src_text, len + 1);
    } else {
      r->text = NULL;
    }
    r->x_min = 0.0 / 0.0; r->x_max = 0.0 / 0.0; r->y_min = 0.0 / 0.0; r->y_max = 0.0 / 0.0;
    return (int64_t)(intptr_t)r;
    ```)

  ;;; __renderer-floats -- attach the six generic float payload slots to a renderer.
  (defn __renderer-floats [renderer : int
                           f1 : float f2 : float f3 : float f4 : float f5 : float f6 : float] : int
    ```c
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;
    PlotRenderer *r = (PlotRenderer *)(intptr_t)renderer;
    if (!r) return 0;
    r->f1 = f1; r->f2 = f2; r->f3 = f3; r->f4 = f4; r->f5 = f5; r->f6 = f6;
    return renderer;
    ```)

  ;;; __renderer-ints -- attach the four generic integer payload slots to a renderer.
  (defn __renderer-ints [renderer : int i1 : int i2 : int i3 : int i4 : int] : int
    ```c
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;
    PlotRenderer *r = (PlotRenderer *)(intptr_t)renderer;
    if (!r) return 0;
    r->i1 = i1; r->i2 = i2; r->i3 = i3; r->i4 = i4;
    return renderer;
    ```)

  ;;; __renderer-bounds -- attach explicit bounds hints to a renderer.
  (defn __renderer-bounds [renderer : int x-min : float x-max : float y-min : float y-max : float] : int
    ```c
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;
    PlotRenderer *r = (PlotRenderer *)(intptr_t)renderer;
    if (!r) return 0;
    r->x_min = x_min; r->x_max = x_max; r->y_min = y_min; r->y_max = y_max;
    return renderer;
    ```)

  ;;; __surface-create -- allocate a new plutovg surface.
  (defn __surface-create [width : int height : int] : ptr<void>
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void* plutovg_surface_create(int width, int height);
    #endif
    void *s = plutovg_surface_create((int)width, (int)height);
    return (void *)(intptr_t)(s ? tur_ok_ptr(s) : tur_err_int(1));
    ```)

  ;;; __surface-destroy -- destroy a plutovg surface.
  (defn __surface-destroy [surface : int] : void
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void plutovg_surface_destroy(void* surface);
    #endif
    if (surface) plutovg_surface_destroy((void *)(intptr_t)surface);
    ```)

  ;;; __surface-write-png -- write a plutovg surface to a PNG file.
  (defn __surface-write-png [surface : int path : cstr] : ptr<void>
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern bool plutovg_surface_write_to_png(const void* surface, const char* filename);
    #endif
    bool ok = plutovg_surface_write_to_png((void *)(intptr_t)surface,
                                           (const char *)(intptr_t)path);
    return (void *)(intptr_t)(ok ? tur_ok_int(0) : tur_err_int(1));
    ```)

  ;;; __canvas-create -- allocate a canvas for an existing surface.
  (defn __canvas-create [surface : int] : ptr<void>
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void* plutovg_canvas_create(void* surface);
    #endif
    void *c = plutovg_canvas_create((void *)(intptr_t)surface);
    return (void *)(intptr_t)(c ? tur_ok_ptr(c) : tur_err_int(1));
    ```)

  ;;; __canvas-destroy -- destroy a plutovg canvas.
  (defn __canvas-destroy [canvas : int] : void
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void plutovg_canvas_destroy(void* canvas);
    #endif
    if (canvas) plutovg_canvas_destroy((void *)(intptr_t)canvas);
    ```)

  ;;; __surface-width -- width of a plutovg surface in pixels.
  (defn __surface-width [surface : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern int plutovg_surface_get_width(const void* surface);
    #endif
    if (!surface) return 0;
    return (int64_t)plutovg_surface_get_width((const void *)(intptr_t)surface);
    ```)

  ;;; __surface-height -- height of a plutovg surface in pixels.
  (defn __surface-height [surface : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern int plutovg_surface_get_height(const void* surface);
    #endif
    if (!surface) return 0;
    return (int64_t)plutovg_surface_get_height((const void *)(intptr_t)surface);
    ```)

  ;;; __surface-pixel-byte -- read a single byte from the surface's raw pixel buffer.
  ;;;
  ;;; plutovg stores pixels in 32-bpp BGRA order (premultiplied alpha) on
  ;;; little-endian platforms. `channel` selects the byte within the pixel:
  ;;;   0 -- B, 1 -- G, 2 -- R, 3 -- A.
  ;;; Returns -1 if (x, y) is out of bounds.
  (defn __surface-pixel-byte [surface : int x : int y : int channel : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void* surface);
    extern int plutovg_surface_get_width(const void* surface);
    extern int plutovg_surface_get_height(const void* surface);
    extern int plutovg_surface_get_stride(const void* surface);
    #endif
    if (!surface) return -1;
    int w = plutovg_surface_get_width((const void *)(intptr_t)surface);
    int h = plutovg_surface_get_height((const void *)(intptr_t)surface);
    if ((int)x < 0 || (int)x >= w || (int)y < 0 || (int)y >= h) return -1;
    if ((int)channel < 0 || (int)channel > 3) return -1;
    int stride = plutovg_surface_get_stride((const void *)(intptr_t)surface);
    unsigned char *data = plutovg_surface_get_data((const void *)(intptr_t)surface);
    if (!data) return -1;
    return (int64_t)data[(int)y * stride + (int)x * 4 + (int)channel];
    ```)

  ;;; __count-non-background -- count pixels in [x0, x1) x [y0, y1) that are not background.
  ;;;
  ;;; Useful for "this renderer produced *some* ink in this region" assertions
  ;;; without pinning a specific pixel.
  (defn __count-non-background [surface : int
                                x0 : int y0 : int
                                x1 : int y1 : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void* surface);
    extern int plutovg_surface_get_width(const void* surface);
    extern int plutovg_surface_get_height(const void* surface);
    extern int plutovg_surface_get_stride(const void* surface);
    #endif
    if (!surface) return 0;
    int w = plutovg_surface_get_width((const void *)(intptr_t)surface);
    int h = plutovg_surface_get_height((const void *)(intptr_t)surface);
    int stride = plutovg_surface_get_stride((const void *)(intptr_t)surface);
    unsigned char *data = plutovg_surface_get_data((const void *)(intptr_t)surface);
    if (!data) return 0;
    int xa = (int)x0 < 0 ? 0 : (int)x0;
    int ya = (int)y0 < 0 ? 0 : (int)y0;
    int xb = (int)x1 > w ? w : (int)x1;
    int yb = (int)y1 > h ? h : (int)y1;
    int64_t cnt = 0;
    for (int yy = ya; yy < yb; yy++) {
      for (int xx = xa; xx < xb; xx++) {
        unsigned char b = data[yy * stride + xx * 4 + 0];
        unsigned char g = data[yy * stride + xx * 4 + 1];
        unsigned char r = data[yy * stride + xx * 4 + 2];
        unsigned char a = data[yy * stride + xx * 4 + 3];
        if (!(r >= 250 && g >= 250 && b >= 250 && a >= 250)) cnt++;
      }
    }
    return cnt;
    ```)

  ;;; __pixel-is-background? -- true when a pixel is near pure white (>=250 in all RGB channels and full alpha).
  ;;;
  ;;; Useful for "this region was not drawn over" assertions. The plot
  ;;; background is `fill_rect` with rgba(1,1,1,1).
  (defn __pixel-is-background? [surface : int x : int y : int] : bool
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void* surface);
    extern int plutovg_surface_get_width(const void* surface);
    extern int plutovg_surface_get_height(const void* surface);
    extern int plutovg_surface_get_stride(const void* surface);
    #endif
    if (!surface) return false;
    int w = plutovg_surface_get_width((const void *)(intptr_t)surface);
    int h = plutovg_surface_get_height((const void *)(intptr_t)surface);
    if ((int)x < 0 || (int)x >= w || (int)y < 0 || (int)y >= h) return false;
    int stride = plutovg_surface_get_stride((const void *)(intptr_t)surface);
    unsigned char *data = plutovg_surface_get_data((const void *)(intptr_t)surface);
    if (!data) return false;
    unsigned char b = data[(int)y * stride + (int)x * 4 + 0];
    unsigned char g = data[(int)y * stride + (int)x * 4 + 1];
    unsigned char r = data[(int)y * stride + (int)x * 4 + 2];
    unsigned char a = data[(int)y * stride + (int)x * 4 + 3];
    return r >= 250 && g >= 250 && b >= 250 && a >= 250;
    ```)

  ;;; __plot-sample-adaptive -- adaptive subdivision sampler for sampled-line renderers.
  ;;;
  ;;; Walks the parameter interval `[r->f1, r->f2]` in `initial-samples`
  ;;; uniform pieces and bisects each piece when the angle between adjacent
  ;;; screen-space segments exceeds the subdivision threshold, up to a fixed
  ;;; recursion cap. NaN evaluations break the active sub-path so curves with
  ;;; vertical asymptotes (e.g. tan, 1/x) render as separate strokes.
  ;;;
  ;;; Strokes the resulting polyline onto canvas. The caller is responsible for
  ;;; installing the line style (color / width / dash / alpha) before invoking.
  ;;; Supports renderer kinds RK_FUNCTION (21), RK_PARAMETRIC (22),
  ;;; RK_POLAR (23), and RK_INVERSE (24); other kinds are a no-op.
  ;;;
  ;;; Parameters:
  ;;;   renderer        -- PlotRenderer* (treat as opaque int64_t handle)
  ;;;   canvas          -- plutovg canvas handle
  ;;;   bx-min/bx-max   -- data-space x bounds
  ;;;   by-min/by-max   -- data-space y bounds
  ;;;   left/top        -- viewport top-left in canvas pixels
  ;;;   plot-w/plot-h   -- viewport size in pixels
  ;;;   initial-samples -- baseline uniform sample count (clamped to >= 2)
  ;;;
  ;;; Since: plot-v0.1.0
  ;;;
  ;;; Pinned to the stable C symbol `plot_sample_adaptive` via `export-as` so
  ;;; the inline-C call site in `plot-into-canvas` below can name it directly.
  ;;; Without the pin, turmeric's injective identifier mangler encodes this
  ;;; `__`-prefixed, kebab-cased name as `..._un_unplot_hysample_hyadaptive`,
  ;;; which the hand-written C call could not track across mangling changes.
  (defn (export-as "plot_sample_adaptive")
        __plot-sample-adaptive [renderer : int canvas : int
                                bx-min : float bx-max : float
                                by-min : float by-max : float
                                left : int top : int
                                plot-w : int plot-h : int
                                initial-samples : int] : void
    ```c
    extern double cos(double);
    extern double sin(double);
    extern double sqrt(double);
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_stroke(void* canvas);
    #endif

    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;

    #define ADAPTIVE_BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ADAPTIVE_ISNAN(v) ((v) != (v))

    enum { RK_FUNCTION_K = 21, RK_PARAMETRIC_K = 22, RK_POLAR_K = 23, RK_INVERSE_K = 24 };

    PlotRenderer *r = (PlotRenderer *)(intptr_t)renderer;
    void *cv = (void *)(intptr_t)canvas;
    if (!r || !cv) return;
    if (r->kind != RK_FUNCTION_K && r->kind != RK_INVERSE_K
        && r->kind != RK_PARAMETRIC_K && r->kind != RK_POLAR_K) return;

    int n = (int)initial_samples; if (n < 2) n = 2;
    double t_min = r->f1, t_max = r->f2;
    if (!(t_max > t_min)) return;
    double inv_w = (bx_max > bx_min) ? 1.0 / (bx_max - bx_min) : 1.0;
    double inv_h = (by_max > by_min) ? 1.0 / (by_max - by_min) : 1.0;
    double pw_d = (double)plot_w, ph_d = (double)plot_h;
    double left_d = (double)left, top_d = (double)top;

    enum { MAX_DEPTH = 6 };
    const double cos_thresh = 0.9961947;  /* cos(5 deg) */
    const double min_seg_px2 = 0.25;      /* (0.5 px)^2 floor */

    typedef struct { double t; double vx, vy; int valid; } Sample;

    #define EVAL_AT(T, OUT) do { \
      double __t = (T); \
      double __x = 0.0, __y = 0.0; \
      if (r->kind == RK_FUNCTION_K) { __x = __t; __y = TUR_APPLY1_T(double, double, r->data1, __t); } \
      else if (r->kind == RK_INVERSE_K) { __y = __t; __x = TUR_APPLY1_T(double, double, r->data1, __t); } \
      else if (r->kind == RK_PARAMETRIC_K) { \
        Cons *__pair = (Cons *)(intptr_t)TUR_APPLY1_T(int64_t, double, r->data1, __t); \
        if (__pair) { __x = ADAPTIVE_BITS_DBL(__pair->head); __y = ADAPTIVE_BITS_DBL(__pair->tail); } \
        else { __x = __y = 0.0/0.0; } \
      } else { \
        double __radius = TUR_APPLY1_T(double, double, r->data1, __t); \
        __x = __radius * cos(__t); __y = __radius * sin(__t); \
      } \
      (OUT).t = __t; \
      if (ADAPTIVE_ISNAN(__x) || ADAPTIVE_ISNAN(__y)) { (OUT).valid = 0; (OUT).vx = 0.0; (OUT).vy = 0.0; } \
      else { \
        double __tx = (__x - bx_min) * inv_w; \
        double __ty = (__y - by_min) * inv_h; \
        (OUT).vx = left_d + __tx * pw_d; \
        (OUT).vy = top_d + ph_d - __ty * ph_d; \
        (OUT).valid = 1; \
      } \
    } while (0)

    int started = 0;
    #define EMIT(S) do { \
      if ((S).valid) { \
        if (!started) { plutovg_canvas_move_to(cv, (float)(S).vx, (float)(S).vy); started = 1; } \
        else { plutovg_canvas_line_to(cv, (float)(S).vx, (float)(S).vy); } \
      } else { \
        started = 0; \
      } \
    } while (0)

    typedef struct { Sample A, B; int depth; } Frame;
    Frame stack[MAX_DEPTH * 2 + 4];

    Sample prev; EVAL_AT(t_min, prev);
    EMIT(prev);

    for (int i = 0; i < n - 1; i++) {
      double tB = t_min + (t_max - t_min) * ((double)(i + 1) / (double)(n - 1));
      Sample A = prev;
      Sample B; EVAL_AT(tB, B);

      int sp = 0;
      stack[sp].A = A; stack[sp].B = B; stack[sp].depth = 0; sp++;

      while (sp > 0) {
        Frame f = stack[--sp];
        int subdivide = 0;
        Sample M; M.valid = 0; M.t = 0.0; M.vx = 0.0; M.vy = 0.0;
        double dx_ab = f.B.vx - f.A.vx;
        double dy_ab = f.B.vy - f.A.vy;
        double seg_len2 = dx_ab * dx_ab + dy_ab * dy_ab;
        int both_valid = f.A.valid && f.B.valid;

        if (f.depth < MAX_DEPTH && (!both_valid || seg_len2 > min_seg_px2)) {
          double tM = 0.5 * (f.A.t + f.B.t);
          EVAL_AT(tM, M);
          if (M.valid != f.A.valid || M.valid != f.B.valid) {
            /* Validity transition inside segment -> bisect to localize the gap. */
            subdivide = 1;
          } else if (both_valid && M.valid) {
            double v1x = M.vx - f.A.vx, v1y = M.vy - f.A.vy;
            double v2x = f.B.vx - M.vx, v2y = f.B.vy - M.vy;
            double l1 = v1x * v1x + v1y * v1y;
            double l2 = v2x * v2x + v2y * v2y;
            if (l1 > min_seg_px2 && l2 > min_seg_px2) {
              double dot = v1x * v2x + v1y * v2y;
              double denom = sqrt(l1 * l2);
              double cos_a = (denom > 0.0) ? (dot / denom) : 1.0;
              if (cos_a < cos_thresh) subdivide = 1;
            }
          }
        }

        if (subdivide) {
          /* Right then left so left pops first => emission is left-to-right. */
          stack[sp].A = M;   stack[sp].B = f.B; stack[sp].depth = f.depth + 1; sp++;
          stack[sp].A = f.A; stack[sp].B = M;   stack[sp].depth = f.depth + 1; sp++;
        } else {
          EMIT(f.B);
        }
      }

      prev = B;
    }

    if (started) plutovg_canvas_stroke(cv);

    #undef EVAL_AT
    #undef EMIT
    #undef ADAPTIVE_BITS_DBL
    #undef ADAPTIVE_ISNAN
    ```)

  ;;; data->viewport -- map data coordinates to viewport coordinates.
  (defn data->viewport [x : float y : float bx-min : float bx-max : float
                        by-min : float by-max : float
                        px : int py : int pw : int ph : int] : int
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { double x; double y; } Pt;
    Pt *p = (Pt *)malloc(sizeof(*p));
    double tx = (x - bx_min) / (bx_max - bx_min);
    double ty = (y - by_min) / (by_max - by_min);
    p->x = (double)px + tx * (double)pw;
    p->y = (double)py + (1.0 - ty) * (double)ph;
    return (int64_t)(intptr_t)p;
    ```)

  ;;; viewport->data -- map viewport coordinates back to data coordinates.
  (defn viewport->data [vx : float vy : float bx-min : float bx-max : float
                        by-min : float by-max : float
                        px : int py : int pw : int ph : int] : int
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { double x; double y; } Pt;
    Pt *p = (Pt *)malloc(sizeof(*p));
    double tx = (vx - (double)px) / (double)pw;
    double ty = 1.0 - ((vy - (double)py) / (double)ph);
    p->x = bx_min + tx * (bx_max - bx_min);
    p->y = by_min + ty * (by_max - by_min);
    return (int64_t)(intptr_t)p;
    ```)

  ;;; BBox -- an axis-aligned data-space bounding box: what a renderer's
  ;;; `bounds` method returns and what the plot's data extent is folded from.
  ;;; An empty box -- a renderer that contributed no finite point -- is
  ;;; represented with `x-min` = NaN; use `bbox-empty?` to test for it.
  (defstruct BBox :copy [x-min : float  x-max : float  y-min : float  y-max : float])

  ;; Raw-carrier accessors over the { x0,x1,y0,y1; valid } buffer the C bounds
  ;; helpers below return.
  (defn __rbb-valid? [b : ptr<void>] : bool
    ```c return ((struct { double x0,x1,y0,y1; int valid; } *)b)->valid != 0; ```)
  (defn __rbb-get [b : ptr<void> which : int] : float
    ```c
    struct RBB { double x0,x1,y0,y1; int valid; } *p = (struct RBB *)b;
    switch ((int)which) { case 0: return p->x0; case 1: return p->x1;
                          case 2: return p->y0; default: return p->y1; }
    ```)
  (defn __rbb-free [b : ptr<void>] : void ```c free(b); ```)
  (defn __rbb-nan [] : float ```c return 0.0 / 0.0; ```)

  ;;; bbox-empty? -- true when a BBox carries no finite extent (x-min is NaN).
  (defn bbox-empty? [bb : BBox] : bool
    (let [lo (.x-min bb)] (not (= lo lo))))

  ;;; bbox-from-raw -- pack the raw { x0,x1,y0,y1; valid } carrier (as produced
  ;;; by the `__*-bbox` helpers) into a typed BBox with make-struct (so no
  ;;; struct-by-value crosses the inline-C boundary), freeing the carrier. An
  ;;; invalid carrier becomes an empty box (x-min = NaN).
  ;;;
  ;;; Defined ahead of its callers on purpose: a `defn` whose return type is an
  ;;; aggregate must be elaborated before the call site, or the caller sees the
  ;;; int64 carrier instead of `BBox` and trips TUR-E0709.
  (defn bbox-from-raw [b : ptr<void>] : BBox
    (if (__rbb-valid? b)
      (let [box (make-struct BBox (__rbb-get b 0) (__rbb-get b 1)
                                  (__rbb-get b 2) (__rbb-get b 3))]
        (do (__rbb-free b) box))
      (let [n   (__rbb-nan)
            box (make-struct BBox n n n n)]
        (do (__rbb-free b) box))))

  ;;; bbox-empty-box -- the identity element for `bbox-union`: an empty BBox
  ;;; (x-min = NaN), matching `bbox-empty?`.
  (defn bbox-empty-box [] : BBox
    (let [n (__rbb-nan)] (make-struct BBox n n n n)))

  ;;; bbox-union -- the smallest box covering both inputs; an empty box is the
  ;;; identity (so folding from `bbox-empty-box` recovers the first non-empty).
  ;;
  ;; On a tie the left box's coordinate is kept, as the draw pass's own union
  ;; once kept the first point it saw.
  (defn bbox-union [a : BBox  b : BBox] : BBox
    (if (bbox-empty? a) b
      (if (bbox-empty? b) a
        (make-struct BBox
          (if (< (.x-min b) (.x-min a)) (.x-min b) (.x-min a))
          (if (> (.x-max b) (.x-max a)) (.x-max b) (.x-max a))
          (if (< (.y-min b) (.y-min a)) (.y-min b) (.y-min a))
          (if (> (.y-max b) (.y-max a)) (.y-max b) (.y-max a))))))

  ;;; point-bbox -- the degenerate box of one data point; empty when either
  ;;; coordinate is NaN (a NaN point contributes nothing to the extent).
  (defn point-bbox [x : float  y : float] : BBox
    (if (or (not (= x x)) (not (= y y)))
      (bbox-empty-box)
      (make-struct BBox x x y y)))

  ;;; hint-bbox -- the box spanned by the corners (x0, y0) and (x1, y1) of an
  ;;; explicit domain, as the sampled-grid kinds (contours, vector fields)
  ;;; declare. Empty unless all four are finite numbers.
  (defn hint-bbox [x0 : float  x1 : float  y0 : float  y1 : float] : BBox
    (if (or (not (= x0 x0)) (not (= x1 x1)) (not (= y0 y0)) (not (= y1 y1)))
      (bbox-empty-box)
      (make-struct BBox (if (< x1 x0) x1 x0) (if (> x1 x0) x1 x0)
                        (if (< y1 y0) y1 y0) (if (> y1 y0) y1 y0))))

  ;; ---------------------------------------------------------------------------
  ;; Bounds of the cons-shaped payloads. Each helper walks one payload shape
  ;; and returns the raw { x0,x1,y0,y1; valid } carrier (`bbox-from-raw` packs
  ;; it); NaN points are skipped. These were the arms of the draw pass's old
  ;; per-kind bounds `switch`, moved verbatim -- a kind's `bounds` method now
  ;; picks its helper by type instead of by a `kind` tag.
  ;; ---------------------------------------------------------------------------

  ;;; __point-list-bbox -- bounding box of a cons-list of (cons x y) points: the
  ;;; rule shared by the lines / points / lines-interval kinds.
  (defn (export-as "plot_point_list_bbox") __point-list-bbox [points : int] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    for (Cons *p = (Cons *)(intptr_t)points; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *pt = (Cons *)(intptr_t)p->head;
      if (!pt) continue;
      double x = BITS_DBL(pt->head), y = BITS_DBL(pt->tail);
      if (ISNAN(x) || ISNAN(y)) continue;
      if (!lvalid) { lx0 = lx1 = x; ly0 = ly1 = y; lvalid = 1; }
      else { if (x < lx0) lx0 = x; if (x > lx1) lx1 = x;
             if (y < ly0) ly0 = y; if (y > ly1) ly1 = y; }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __error-bars-bbox -- bounding box of a cons-list of (x . (y . h)) error
  ;;; bars: each bar spans y +/- h, or x +/- h when `horizontal`.
  (defn __error-bars-bbox [bars : int  horizontal : bool] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    for (Cons *p = (Cons *)(intptr_t)bars; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *a = (Cons *)(intptr_t)p->head;
      if (!a) continue;
      double x = BITS_DBL(a->head);
      Cons *b = (Cons *)(intptr_t)a->tail;
      if (!b) continue;
      double y = BITS_DBL(b->head);
      double h = BITS_DBL(b->tail);
      if (horizontal) { UNION_POINT(x - h, y); UNION_POINT(x + h, y); }
      else { UNION_POINT(x, y - h); UNION_POINT(x, y + h); }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __arrows-bbox -- bounding box of a cons-list of (x1 . (y1 . (x2 . y2)))
  ;;; arrow segments: both endpoints of every arrow.
  ;;
  ;; The draw pass used to bound arrows with the point-list rule, reading each
  ;; arrow's second cell -- a pointer -- as its y coordinate, so the plot's
  ;; y range came out of the heap layout and changed from run to run.
  (defn __arrows-bbox [arrows : int] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    for (Cons *p = (Cons *)(intptr_t)arrows; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *a = (Cons *)(intptr_t)p->head;
      if (!a) continue;
      Cons *b = (Cons *)(intptr_t)a->tail;
      if (!b) continue;
      Cons *c = (Cons *)(intptr_t)b->tail;
      if (!c) continue;
      UNION_POINT(BITS_DBL(a->head), BITS_DBL(b->head));
      UNION_POINT(BITS_DBL(c->head), BITS_DBL(c->tail));
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __rects-bbox -- bounding box of a cons-list of (x0 . (x1 . (y0 . y1)))
  ;;; rectangles: the rectangles / area-histogram rule.
  (defn __rects-bbox [rects : int] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    for (Cons *p = (Cons *)(intptr_t)rects; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *a = (Cons *)(intptr_t)p->head;
      if (!a) continue;
      double x0 = BITS_DBL(a->head);
      Cons *b = (Cons *)(intptr_t)a->tail;
      double x1 = BITS_DBL(b->head);
      Cons *c = (Cons *)(intptr_t)b->tail;
      double y0 = BITS_DBL(c->head);
      double y1 = BITS_DBL(c->tail);
      UNION_POINT(x0, y0);
      UNION_POINT(x1, y1);
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __discrete-hist-bbox -- bounding box of a cons-list of (label . height)
  ;;; bars laid out at category slots 0, 1, 2, ... (each 0.8 wide), rotated
  ;;; onto the y axis when `horizontal`.
  (defn __discrete-hist-bbox [bars : int  horizontal : bool] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    int idx = 0;
    for (Cons *p = (Cons *)(intptr_t)bars; p; p = (Cons *)(intptr_t)p->tail, idx++) {
      Cons *bar = (Cons *)(intptr_t)p->head;
      if (!bar) continue;
      double h = BITS_DBL(bar->tail);
      if (horizontal) { UNION_POINT(0.0, idx); UNION_POINT(h, idx + 0.8); }
      else { UNION_POINT(idx, 0.0); UNION_POINT(idx + 0.8, h); }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __stacked-hist-bbox -- bounding box of a cons-list of (label . values)
  ;;; groups: each slot is as tall as the sum of its stacked values.
  (defn __stacked-hist-bbox [groups : int  horizontal : bool] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    int idx = 0;
    for (Cons *p = (Cons *)(intptr_t)groups; p; p = (Cons *)(intptr_t)p->tail, idx++) {
      Cons *grp = (Cons *)(intptr_t)p->head;
      double sum = 0.0;
      for (Cons *vals = (Cons *)(intptr_t)grp->tail; vals; vals = (Cons *)(intptr_t)vals->tail)
        sum += BITS_DBL(vals->head);
      if (horizontal) { UNION_POINT(0.0, idx); UNION_POINT(sum, idx + 0.8); }
      else { UNION_POINT(idx, 0.0); UNION_POINT(idx + 0.8, sum); }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;; ===========================================================================
  ;; Renderer typeclass -- U2 renderer-kind collapse.
  ;;
  ;; Each renderer kind is its own type carrying its real fields (the structs
  ;; live beside their constructors: LinesR and FunctionR in plot/line,
  ;; PointsR in plot/point, the Decoration sum type in plot/decor, ...), with
  ;; one `Renderer` instance per kind. The public constructors box their struct
  ;; as an `AnyRenderer`, so a heterogeneous `(vec-of (axes) (lines ...))`
  ;; type-checks and every element still dispatches through its own instance.
  ;;
  ;; `bounds` replaced the draw pass's per-kind bounds `switch`. `to-legacy`
  ;; still lowers each struct to the slot-bag handle the C draw pass consumes;
  ;; it goes away when the draw pass is split per kind (plot Renderer plan P4).
  ;; ===========================================================================

  ;;; Renderer -- the class every plot renderer kind implements.
  ;;;
  ;;; Parameters:
  ;;;   a -- a renderer kind (LinesR, FunctionR, Decoration, ...)
  ;;;
  ;;; Methods:
  ;;;   bounds    -- the data-space extent the renderer needs on screen; empty
  ;;;                (see `bbox-empty?`) when it constrains nothing, as a
  ;;;                sampled curve or an axis does
  ;;;   to-legacy -- lower the renderer to the slot-bag handle the C draw pass
  ;;;                reads; a fresh handle the caller frees
  ;;;
  ;;; Example:
  ;;;   (bounds (make-struct LinesR pts (default-line-style) "l"))
  ;;;
  ;;; Since: plot-v0.4.0
  (defclass Renderer [a]
    (bounds [r] : BBox)
    (to-legacy [r] : int))

  ;;; AnyRenderer -- a value of any `Renderer` kind, boxed with its instance.
  ;;; Every public constructor (`lines`, `function`, `axes`, ...) returns one,
  ;;; and `plot` / `plot-write-png` / `render` take a `(Vec AnyRenderer)`.
  (defalias AnyRenderer (exists [a] [(Renderer a)] a))

  ;;; any-renderer -- box a value whose type has a `Renderer` instance as an
  ;;; `AnyRenderer`. The `(exists ...)` form must appear literally at the pack
  ;;; site, so this is a macro (same reason as stdlib `showable`).
  ;;;
  ;;; Parameters:
  ;;;   x -- a renderer struct (LinesR, FunctionR, ...)
  ;;;
  ;;; Returns:
  ;;;   The value boxed with its `Renderer` instance, as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (any-renderer (make-struct LinesR pts (default-line-style) ""))
  (defmacro any-renderer [x] (list pack x (list exists [a] [(list Renderer a)] a)))

  ;;; renderer-bbox -- the data-space bounding box of one renderer.
  ;;;
  ;;; Parameters:
  ;;;   r -- any renderer, as a constructor returns it
  ;;;
  ;;; Returns:
  ;;;   Its `bounds`; an empty box (`bbox-empty?`) when it constrains nothing.
  ;;;
  ;;; Example:
  ;;;   (renderer-bbox (lines pts (default-line-style) ""))
  (defn renderer-bbox [r : AnyRenderer] : BBox
    (open r [a v] (bounds v)))

  ;; The folds below are top-level recursive defns rather than local `letrec`
  ;; closures: the compiler mallocs a letrec closure's env and, for a struct
  ;; argument, a box per call, and frees neither -- a leak on every `plot`.
  ;; A top-level defn passes `acc` by value and allocates nothing.

  ;;; __bbox-fold -- union the `bounds` of rs[i..n) into acc.
  (defn __bbox-fold [rs : (Vec AnyRenderer)  i : int  n : int  acc : BBox] : BBox
    (if (>= i n) acc
      (__bbox-fold rs (+ i 1) n
                   (bbox-union acc (open (vec-get rs i) [a v] (bounds v))))))

  ;;; renderers-bbox -- the data-space bounding box of a renderer Vec: the
  ;;; union of every element's `bounds`, each dispatched through the instance
  ;;; its `AnyRenderer` carries. This is the extent the plot is laid out over
  ;;; before padding and before `plot-opts` overrides.
  ;;;
  ;;; Parameters:
  ;;;   rs -- the renderers
  ;;;
  ;;; Returns:
  ;;;   The union of their bounds; empty when none constrains the extent.
  ;;;
  ;;; Example:
  ;;;   (renderers-bbox (vec-of (axes) (lines pts (default-line-style) "")))
  (defn renderers-bbox [rs : (Vec AnyRenderer)] : BBox
    (__bbox-fold rs 0 (vec-len rs) (bbox-empty-box)))

  ;;; __lower-into -- push the `to-legacy` handle of each of rs[i..n) onto out.
  (defn __lower-into [rs : (Vec AnyRenderer)  i : int  n : int  out : (Vec int)] : (Vec int)
    (if (>= i n) out
      (do (vec-push! out (open (vec-get rs i) [a v] (to-legacy v)))
          (__lower-into rs (+ i 1) n out))))

  ;;; anyrenderers->legacy -- lower a (Vec AnyRenderer) to the (Vec int) of
  ;;; slot-bag handles the C draw pass consumes, one `to-legacy` per element.
  ;;; The handles are fresh: release them with `__free-renderers`.
  (defn anyrenderers->legacy [rs : (Vec AnyRenderer)] : (Vec int)
    (__lower-into rs 0 (vec-len rs) (:: (vec-new) (Vec int))))

  ;;; __free-renderers -- free each slot-bag handle in a lowered renderer Vec
  ;;; (the handle and its copied label / text; the payload it points at belongs
  ;;; to the typed renderer). The Vec itself is left to the caller.
  (defn __free-renderers [handles : int] : void
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;
    typedef struct { int64_t *data; size_t len; size_t cap; } RendVec;
    RendVec *v = (RendVec *)(intptr_t)handles;
    if (!v) return;
    for (size_t i = 0; i < v->len; i++) {
      PlotRenderer *r = (PlotRenderer *)(intptr_t)v->data[i];
      if (!r) continue;
      free(r->label);
      free(r->text);
      free(r);
    }
    ```)

  ;;; plot-anyrenderers -- deprecated: `plot` takes a (Vec AnyRenderer) itself
  ;;; now. Kept for one release; call `plot`.
  (defn plot-anyrenderers [rs : (Vec AnyRenderer) opts : int] : ptr<void>
    (plot rs opts))

  ;;; __surfaces-equal? -- true when two plutovg surfaces have identical
  ;;; dimensions and pixel bytes. Used to assert that the typed `AnyRenderer`
  ;;; draw path is pixel-identical to the legacy constructor path.
  (defn __surfaces-equal? [s1 : int s2 : int] : bool
    ```c
    #include <string.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void*);
    extern int plutovg_surface_get_width(const void*);
    extern int plutovg_surface_get_height(const void*);
    extern int plutovg_surface_get_stride(const void*);
    #endif
    if (!s1 || !s2) return false;
    const void *a = (const void *)(intptr_t)s1, *b = (const void *)(intptr_t)s2;
    int w = plutovg_surface_get_width(a), h = plutovg_surface_get_height(a);
    if (w != plutovg_surface_get_width(b) || h != plutovg_surface_get_height(b)) return false;
    int sa = plutovg_surface_get_stride(a), sb = plutovg_surface_get_stride(b);
    unsigned char *da = plutovg_surface_get_data((void *)a);
    unsigned char *db = plutovg_surface_get_data((void *)b);
    if (!da || !db) return false;
    for (int y = 0; y < h; y++) {
      if (memcmp(da + (size_t)y * sa, db + (size_t)y * sb, (size_t)w * 4) != 0) return false;
    }
    return true;
    ```)

  ;;; __draw-renderers -- draw the renderer Vec into `canvas` at the already-
  ;;; resolved data bounds and viewport rect. P0 de-monolith of the plot
  ;;; Renderer plan: the former per-kind draw `switch`, its clip bracket, and the
  ;;; style / auto-color / MAP_POINT machinery are lifted verbatim out of the
  ;;; ~900-line plot-into-canvas body into this standalone, independently-callable
  ;;; function. The frame worker (`__plot-into-canvas-legacy`) lays out the
  ;;; axes and labels and delegates the data rendering here. Pure code
  ;;; movement -- pixel output is byte-identical. `renderers` is the lowered
  ;;; slot-bag Vec; each callback slot holds a closure handle, called through
  ;;; `TUR_APPLY1_T` / `TUR_APPLY2_T`.
  ;;;
  ;;; Pinned to the stable C symbol `plot_draw_renderers` via `export-as` so
  ;;; the frame worker's inline-C can name it across mangling (same idiom as
  ;;; `plot_sample_adaptive`).
  (defn (export-as "plot_draw_renderers")
        __draw-renderers [canvas : int  renderers : int
                          bx-min : float  bx-max : float  by-min : float  by-max : float
                          left : int  right : int  top : int  bottom : int
                          plot-w : int  plot-h : int  font-ok : int] : void
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    #include <stdbool.h>
    #include <string.h>
    #include <stdio.h>
    #include <float.h>
    #include <unistd.h>
    extern double floor(double);
    extern double ceil(double);
    extern double log10(double);
    extern double pow(double, double);
    extern double sqrt(double);
    extern double cos(double);
    extern double sin(double);
    extern double atan2(double, double);
    extern double exp(double);
    extern double fabs(double);
    extern double fmin(double, double);
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_surface_t;
    typedef void plutovg_canvas_t;
    typedef void plutovg_font_face_t;
    typedef int plutovg_text_encoding_t;
    #define PLUTOVG_TEXT_ENCODING_UTF8 1
    extern void plutovg_surface_destroy(void* surface);
    extern void* plutovg_font_face_load_from_file(const char* filename, int ttcindex);
    extern void plutovg_font_face_destroy(void* face);
    extern void plutovg_canvas_save(void* canvas);
    extern void plutovg_canvas_restore(void* canvas);
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    extern void plutovg_canvas_set_font_face(void* canvas, void* face);
    extern void plutovg_canvas_set_font_size(void* canvas, float size);
    extern void plutovg_canvas_set_line_width(void* canvas, float line_width);
    extern void plutovg_canvas_set_dash_array(void* canvas, const float* dashes, int ndashes);
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_rect(void* canvas, float x, float y, float w, float h);
    extern void plutovg_canvas_circle(void* canvas, float cx, float cy, float r);
    extern void plutovg_canvas_close_path(void* canvas);
    extern void plutovg_canvas_fill(void* canvas);
    extern void plutovg_canvas_stroke(void* canvas);
    extern void plutovg_canvas_clip(void* canvas);
    extern void plutovg_canvas_fill_rect(void* canvas, float x, float y, float w, float h);
    extern float plutovg_canvas_fill_text(void* canvas, const void* text, int length,
                                          int encoding, float x, float y);
    #endif

    typedef struct { int64_t head; int64_t tail; } Cons;
    #define RETURN_ERR(CODE) do { \
      return (void *)(intptr_t)tur_err_int((CODE)); \
    } while (0)
    #define RETURN_OK(VALUE) do { \
      return (void *)(intptr_t)tur_ok_int((VALUE)); \
    } while (0)
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;
    typedef struct { int64_t color; double width; int64_t dash; double alpha; } LineStyle;
    typedef struct { int64_t color; int64_t fill_color; int64_t sym; double size; double alpha; } PointStyle;
    typedef struct { int64_t color; double alpha; int64_t line_color; double line_width; } FillStyle;
    typedef struct {
      int64_t width; int64_t height;
      char *title; char *x_label; char *y_label;
      double x_min, x_max, y_min, y_max;
      int64_t legend_pos;
    } PlotOpts;

    enum {
      RK_X_AXIS = 1, RK_Y_AXIS = 2, RK_AXES = 3,
      RK_X_TICKS = 4, RK_Y_TICKS = 5, RK_GRID = 6,
      RK_HRULE = 7, RK_VRULE = 8, RK_LABEL = 9,
      RK_LINES = 20, RK_FUNCTION = 21, RK_PARAMETRIC = 22, RK_POLAR = 23, RK_INVERSE = 24, RK_DENSITY = 25,
      RK_POINTS = 30, RK_ERROR_BARS = 31, RK_VECTOR_FIELD = 32, RK_ARROWS = 33,
      RK_FUNCTION_INTERVAL = 40, RK_LINES_INTERVAL = 41, RK_PARAM_INTERVAL = 42, RK_POLAR_INTERVAL = 43,
      RK_RECTANGLES = 50, RK_AREA_HIST = 51, RK_DISCRETE_HIST = 52, RK_STACKED_HIST = 53,
      RK_ISOLINE = 60, RK_CONTOURS = 61, RK_CONTOUR_INTERVALS = 62, RK_COLOR_FIELD = 63
    };

    static const double palette[8][3] = {
      {31.0/255.0, 119.0/255.0, 180.0/255.0},
      {214.0/255.0, 39.0/255.0, 40.0/255.0},
      {44.0/255.0, 160.0/255.0, 44.0/255.0},
      {255.0/255.0, 127.0/255.0, 14.0/255.0},
      {148.0/255.0, 103.0/255.0, 189.0/255.0},
      {140.0/255.0, 86.0/255.0, 75.0/255.0},
      {227.0/255.0, 119.0/255.0, 194.0/255.0},
      {127.0/255.0, 127.0/255.0, 127.0/255.0}
    };

    #define DBL_BITS(v) (((union { double d; int64_t i; }){.d=(v)}).i)
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    typedef struct { int64_t *data; size_t len; size_t cap; } RendVec;
    int auto_color = 0;
    #define NEXT_AUTO() ((auto_color++) % 8)
    #define SET_LINE_STYLE(HANDLE, RESOLVED_COLOR) do { \
      LineStyle *__ls = (LineStyle *)(intptr_t)(HANDLE); \
      int *__resolved_color = (RESOLVED_COLOR); \
      int __color = __ls ? (int)__ls->color : -1; \
      if (__color < 0) __color = NEXT_AUTO(); \
      __color %= 8; if (__color < 0) __color += 8; \
      double __alpha = (__ls && __ls->alpha > 0.0) ? __ls->alpha : 1.0; \
      double __width = (__ls && __ls->width > 0.0) ? __ls->width : 1.5; \
      plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, \
                              (float)palette[__color][0], (float)palette[__color][1], \
                              (float)palette[__color][2], (float)__alpha); \
      plutovg_canvas_set_line_width((plutovg_canvas_t *)(intptr_t)canvas, (float)__width); \
      if (__resolved_color) *__resolved_color = __color; \
      plutovg_canvas_set_dash_array((plutovg_canvas_t *)(intptr_t)canvas, NULL, 0); \
    } while (0)
    #define SET_FILL_STYLE(HANDLE, RESOLVED_FILL, RESOLVED_LINE) do { \
      FillStyle *__fs = (FillStyle *)(intptr_t)(HANDLE); \
      int *__resolved_fill = (RESOLVED_FILL); \
      int *__resolved_line = (RESOLVED_LINE); \
      int __color = __fs ? (int)__fs->color : -1; \
      if (__color < 0) __color = NEXT_AUTO(); \
      __color %= 8; if (__color < 0) __color += 8; \
      int __lcolor = (__fs && __fs->line_color >= 0) ? (int)__fs->line_color : __color; \
      double __alpha = (__fs && __fs->alpha > 0.0) ? __fs->alpha : 0.5; \
      if (__resolved_fill) *__resolved_fill = __color; \
      if (__resolved_line) *__resolved_line = __lcolor; \
      plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, \
                              (float)palette[__color][0], (float)palette[__color][1], \
                              (float)palette[__color][2], (float)__alpha); \
    } while (0)
    #define SET_POINT_STYLE(HANDLE, RESOLVED_STROKE, RESOLVED_FILL) do { \
      PointStyle *__ps = (PointStyle *)(intptr_t)(HANDLE); \
      int *__resolved_stroke = (RESOLVED_STROKE); \
      int *__resolved_fill = (RESOLVED_FILL); \
      int __stroke = __ps ? (int)__ps->color : -1; \
      if (__stroke < 0) __stroke = NEXT_AUTO(); \
      __stroke %= 8; if (__stroke < 0) __stroke += 8; \
      int __fill = (__ps && __ps->fill_color >= 0) ? (int)__ps->fill_color : __stroke; \
      if (__resolved_stroke) *__resolved_stroke = __stroke; \
      if (__resolved_fill) *__resolved_fill = __fill; \
    } while (0)
    #define MAP_POINT(X, Y, VX, VY) do { \
      double __tx = ((X) - bx_min) / (bx_max - bx_min); \
      double __ty = ((Y) - by_min) / (by_max - by_min); \
      *(VX) = (double)left + __tx * (double)plot_w; \
      *(VY) = (double)bottom - __ty * (double)plot_h; \
    } while (0)

    plutovg_canvas_save((plutovg_canvas_t *)(intptr_t)canvas);
    plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)top, (float)plot_w, (float)plot_h);
    plutovg_canvas_clip((plutovg_canvas_t *)(intptr_t)canvas);

    {
      RendVec *__rvec2 = (RendVec *)(intptr_t)renderers;
      size_t __rlen2 = __rvec2 ? __rvec2->len : 0;
      for (size_t __ri2 = 0; __ri2 < __rlen2; __ri2++) {
      PlotRenderer *r = (PlotRenderer *)(intptr_t)__rvec2->data[__ri2];
      if (!r) continue;
      switch ((int)r->kind) {
        case RK_HRULE:
        case RK_VRULE: {
          SET_LINE_STYLE(r->style1, ((int *)0));
          if (r->kind == RK_HRULE) {
            double __tmpx = 0.0, vy = 0.0; MAP_POINT(bx_min, r->f1, &__tmpx, &vy);
            plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)vy);
            plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)right, (float)vy);
          } else {
            double vx = 0.0, __tmpy = 0.0; MAP_POINT(r->f1, by_min, &vx, &__tmpy);
            plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)top);
            plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)bottom);
          }
          plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
        } break;
        case RK_LABEL: {
          if (font_ok && r->text) {
            int stroke = 0;
            SET_LINE_STYLE(r->style1, &stroke);
            double vx, vy; MAP_POINT(r->f1, r->f2, &vx, &vy);
            plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas, r->text, (int)strlen(r->text),
                                     PLUTOVG_TEXT_ENCODING_UTF8, (float)(vx + 4.0), (float)(vy - 4.0));
          }
        } break;
        case RK_LINES: {
          SET_LINE_STYLE(r->style1, ((int *)0));
          bool have = false; double px0 = 0.0, py0 = 0.0;
          for (Cons *p = (Cons *)(intptr_t)r->data1; p; p = (Cons *)(intptr_t)p->tail) {
            Cons *pt = (Cons *)(intptr_t)p->head;
            if (!pt) continue;
            double x = BITS_DBL(pt->head), y = BITS_DBL(pt->tail);
            if (ISNAN(x) || ISNAN(y)) { have = false; continue; }
            double vx, vy; MAP_POINT(x, y, &vx, &vy);
            if (!have) plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
            else plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
            px0 = vx; py0 = vy; have = true;
          }
          if (have) plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
        } break;
        case RK_FUNCTION:
        case RK_INVERSE:
        case RK_DENSITY:
        case RK_PARAMETRIC:
        case RK_POLAR: {
          SET_LINE_STYLE(r->style1, ((int *)0));
          int n = (int)r->i1; if (n < 32) n = 32;
          if (r->kind == RK_DENSITY) {
            bool started = false;
            double xs[2048]; int m = 0;
            double mean = 0.0, sd = 0.0;
            for (Cons *p = (Cons *)(intptr_t)r->data1; p && m < 2048; p = (Cons *)(intptr_t)p->tail) {
              xs[m++] = BITS_DBL(p->head);
              mean += xs[m - 1];
            }
            if (m == 0) break;
            mean /= (double)m;
            for (int i = 0; i < m; i++) { double d = xs[i] - mean; sd += d * d; }
            sd = sqrt(sd / (double)(m > 1 ? m - 1 : 1));
            double bw = r->f1 > 0.0 ? r->f1 : (1.06 * sd * pow((double)m, -0.2));
            if (!(bw > 0.0)) bw = 1.0;
            for (int i = 0; i < n; i++) {
              double x = bx_min + (bx_max - bx_min) * ((double)i / (double)(n - 1));
              double sum = 0.0;
              for (int j = 0; j < m; j++) {
                double u = (x - xs[j]) / bw;
                sum += exp(-0.5 * u * u);
              }
              double y = sum / ((double)m * bw * sqrt(2.0 * 3.14159265358979323846));
              double vx, vy; MAP_POINT(x, y, &vx, &vy);
              if (!started) { plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy); started = true; }
              else plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
            }
            if (started) plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
          } else {
            extern void plot_sample_adaptive(
              int64_t renderer, int64_t canvas,
              double bx_min, double bx_max, double by_min, double by_max,
              int64_t left, int64_t top, int64_t plot_w, int64_t plot_h,
              int64_t initial_samples);
            plot_sample_adaptive(
              (int64_t)(intptr_t)r, canvas,
              bx_min, bx_max, by_min, by_max,
              left, top, plot_w, plot_h, n);
          }
        } break;
        case RK_POINTS: {
          PointStyle *ps = (PointStyle *)(intptr_t)r->style1;
          int stroke, fill;
          SET_POINT_STYLE(r->style1, &stroke, &fill);
          double size = (ps && ps->size > 0.0) ? ps->size : 6.0;
          double alpha = (ps && ps->alpha > 0.0) ? ps->alpha : 1.0;
          for (Cons *p = (Cons *)(intptr_t)r->data1; p; p = (Cons *)(intptr_t)p->tail) {
            Cons *pt = (Cons *)(intptr_t)p->head;
            if (!pt) continue;
            double x = BITS_DBL(pt->head), y = BITS_DBL(pt->tail);
            double vx, vy; MAP_POINT(x, y, &vx, &vy);
            plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas,
                                    (float)palette[fill][0], (float)palette[fill][1],
                                    (float)palette[fill][2], (float)alpha);
            switch (ps ? (int)ps->sym : 0) {
              case 1: plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy - size / 2), (float)size, (float)size); break;
              case 2:
                plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
                plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy + size / 2));
                plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy + size / 2));
                plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
                break;
              case 5:
                plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
                plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)vy);
                plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy + size / 2));
                plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)vy);
                plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
                break;
              default: plutovg_canvas_circle((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy, (float)(size / 2)); break;
            }
            plutovg_canvas_fill((plutovg_canvas_t *)(intptr_t)canvas);
            plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas,
                                    (float)palette[stroke][0], (float)palette[stroke][1],
                                    (float)palette[stroke][2], (float)alpha);
            plutovg_canvas_set_line_width((plutovg_canvas_t *)(intptr_t)canvas, 1.0f);
            if (ps && ps->sym == 3) {
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy - size / 2));
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy + size / 2));
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy + size / 2));
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy - size / 2));
              plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
            } else if (ps && ps->sym == 4) {
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)vy);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)vy);
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy + size / 2));
              plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
            } else {
              switch (ps ? (int)ps->sym : 0) {
                case 1: plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy - size / 2), (float)size, (float)size); break;
                case 2:
                  plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
                  plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy + size / 2));
                  plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy + size / 2));
                  plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
                  break;
                case 5:
                  plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
                  plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)vy);
                  plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy + size / 2));
                  plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)vy);
                  plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
                  break;
                default: plutovg_canvas_circle((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy, (float)(size / 2)); break;
              }
              plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
            }
          }
        } break;
        case RK_ERROR_BARS: {
          SET_LINE_STYLE(r->style1, ((int *)0));
          for (Cons *p = (Cons *)(intptr_t)r->data1; p; p = (Cons *)(intptr_t)p->tail) {
            Cons *a = (Cons *)(intptr_t)p->head;
            if (!a) continue;
            double x = BITS_DBL(a->head);
            Cons *b = (Cons *)(intptr_t)a->tail;
            double y = BITS_DBL(b->head);
            double h = BITS_DBL(b->tail);
            if (r->i1) {
              double vxa, vya, vxb, vyb; MAP_POINT(x - h, y, &vxa, &vya); MAP_POINT(x + h, y, &vxb, &vyb);
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vxa, (float)vya);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vxb, (float)vyb);
            } else {
              double vxa, vya, vxb, vyb; MAP_POINT(x, y - h, &vxa, &vya); MAP_POINT(x, y + h, &vxb, &vyb);
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vxa, (float)vya);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vxb, (float)vyb);
            }
          }
          plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
        } break;
        case RK_ARROWS:
        case RK_VECTOR_FIELD: {
          SET_LINE_STYLE(r->style1, ((int *)0));
          if (r->kind == RK_ARROWS) {
            for (Cons *p = (Cons *)(intptr_t)r->data1; p; p = (Cons *)(intptr_t)p->tail) {
              Cons *a = (Cons *)(intptr_t)p->head;
              double x1 = BITS_DBL(a->head);
              Cons *b = (Cons *)(intptr_t)a->tail;
              double y1 = BITS_DBL(b->head);
              Cons *c = (Cons *)(intptr_t)b->tail;
              double x2 = BITS_DBL(c->head);
              double y2 = BITS_DBL(c->tail);
              double vx1, vy1, vx2, vy2; MAP_POINT(x1, y1, &vx1, &vy1); MAP_POINT(x2, y2, &vx2, &vy2);
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx1, (float)vy1);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx2, (float)vy2);
              double ang = atan2(vy2 - vy1, vx2 - vx1);
              double ah = 6.0;
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx2, (float)vy2);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx2 - ah * cos(ang - 0.45)), (float)(vy2 - ah * sin(ang - 0.45)));
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx2, (float)vy2);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx2 - ah * cos(ang + 0.45)), (float)(vy2 - ah * sin(ang + 0.45)));
            }
          } else {
            int samples = (int)r->i1; if (samples < 2) samples = 2;
            for (int iy = 0; iy < samples; iy++) for (int ix = 0; ix < samples; ix++) {
              double x = r->f1 + (r->f2 - r->f1) * ((double)ix / (double)(samples - 1));
              double y = r->f3 + (r->f4 - r->f3) * ((double)iy / (double)(samples - 1));
              Cons *pair = (Cons *)(intptr_t)TUR_APPLY2_T(int64_t, double, double, r->data1, x, y);
              double dx = BITS_DBL(pair->head), dy = BITS_DBL(pair->tail);
              if (r->i2 == 1) {
                double len = sqrt(dx * dx + dy * dy);
                if (len > 1e-12) { dx /= len; dy /= len; }
              }
              double scale = (r->i2 == 2) ? 0.15 : 0.10;
              double x2 = x + dx * (r->f2 - r->f1) * scale;
              double y2 = y + dy * (r->f4 - r->f3) * scale;
              double vx1, vy1, vx2, vy2; MAP_POINT(x, y, &vx1, &vy1); MAP_POINT(x2, y2, &vx2, &vy2);
              plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx1, (float)vy1);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx2, (float)vy2);
            }
          }
          plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
        } break;
        case RK_FUNCTION_INTERVAL:
        case RK_PARAM_INTERVAL:
        case RK_POLAR_INTERVAL:
        case RK_LINES_INTERVAL: {
          SET_FILL_STYLE(r->style1, ((int *)0), ((int *)0));
          int n = (int)r->i1; if (n < 32) n = 32;
          bool started = false;
          if (r->kind == RK_LINES_INTERVAL) {
            int count = 0;
            for (Cons *p = (Cons *)(intptr_t)r->data1; p; p = (Cons *)(intptr_t)p->tail) count++;
            double *xs = (double *)malloc(sizeof(double) * count);
            double *ya = (double *)malloc(sizeof(double) * count);
            double *yb = (double *)malloc(sizeof(double) * count);
            int idx = 0;
            for (Cons *p = (Cons *)(intptr_t)r->data1, *q = (Cons *)(intptr_t)r->data2; p && q && idx < count; p = (Cons *)(intptr_t)p->tail, q = (Cons *)(intptr_t)q->tail, idx++) {
              Cons *pa = (Cons *)(intptr_t)p->head; Cons *pb = (Cons *)(intptr_t)q->head;
              xs[idx] = BITS_DBL(pa->head); ya[idx] = BITS_DBL(pa->tail); yb[idx] = BITS_DBL(pb->tail);
            }
            for (int i = 0; i < idx; i++) {
              double vx, vy; MAP_POINT(xs[i], ya[i], &vx, &vy);
              if (!started) { plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy); started = true; }
              else plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
            }
            for (int i = idx - 1; i >= 0; i--) {
              double vx, vy; MAP_POINT(xs[i], yb[i], &vx, &vy);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
            }
            free(xs); free(ya); free(yb);
          } else {
            double *xs = (double *)malloc(sizeof(double) * n);
            double *ya = (double *)malloc(sizeof(double) * n);
            double *yb = (double *)malloc(sizeof(double) * n);
            for (int i = 0; i < n; i++) {
              double t = r->f1 + (r->f2 - r->f1) * ((double)i / (double)(n - 1));
              if (r->kind == RK_FUNCTION_INTERVAL) {
                xs[i] = t;
                ya[i] = TUR_APPLY1_T(double, double, r->data1, t);
                yb[i] = TUR_APPLY1_T(double, double, r->data2, t);
              } else if (r->kind == RK_PARAM_INTERVAL) {
                Cons *pa = (Cons *)(intptr_t)TUR_APPLY1_T(int64_t, double, r->data1, t);
                Cons *pb = (Cons *)(intptr_t)TUR_APPLY1_T(int64_t, double, r->data2, t);
                xs[i] = BITS_DBL(pa->head); ya[i] = BITS_DBL(pa->tail); yb[i] = BITS_DBL(pb->tail);
              } else {
                double ra = TUR_APPLY1_T(double, double, r->data1, t);
                double rb = TUR_APPLY1_T(double, double, r->data2, t);
                xs[i] = ra * cos(t); ya[i] = ra * sin(t); yb[i] = rb * sin(t);
              }
            }
            for (int i = 0; i < n; i++) {
              double vx, vy; MAP_POINT(xs[i], ya[i], &vx, &vy);
              if (!started) { plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy); started = true; }
              else plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
            }
            for (int i = n - 1; i >= 0; i--) {
              double vx, vy;
              if (r->kind == RK_POLAR_INTERVAL) {
                double x2 = TUR_APPLY1_T(double, double, r->data2, r->f1 + (r->f2 - r->f1) * ((double)i / (double)(n - 1))) * cos(r->f1 + (r->f2 - r->f1) * ((double)i / (double)(n - 1)));
                MAP_POINT(x2, yb[i], &vx, &vy);
              } else MAP_POINT(xs[i], yb[i], &vx, &vy);
              plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
            }
            free(xs); free(ya); free(yb);
          }
          plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
          plutovg_canvas_fill((plutovg_canvas_t *)(intptr_t)canvas);
          SET_LINE_STYLE(r->style2, ((int *)0));
          plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
        } break;
        case RK_RECTANGLES:
        case RK_AREA_HIST:
        case RK_DISCRETE_HIST:
        case RK_STACKED_HIST: {
          if (r->kind == RK_DISCRETE_HIST || r->kind == RK_STACKED_HIST) {
            int idx = 0, fill_idx = 0;
            for (Cons *p = (Cons *)(intptr_t)r->data1; p; p = (Cons *)(intptr_t)p->tail, idx++) {
              double x0 = idx, x1 = idx + 0.8;
              if (r->kind == RK_DISCRETE_HIST) {
                Cons *bar = (Cons *)(intptr_t)p->head;
                double h = BITS_DBL(bar->tail);
                SET_FILL_STYLE(r->style1, ((int *)0), ((int *)0));
                double vx0, vy0, vx1, vy1;
                if (r->i1) { MAP_POINT(0.0, x0, &vx0, &vy0); MAP_POINT(h, x1, &vx1, &vy1); }
                else { MAP_POINT(x0, 0.0, &vx0, &vy0); MAP_POINT(x1, h, &vx1, &vy1); }
                plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)vx0, (float)fmin(vy0, vy1), (float)(vx1 - vx0), (float)fabs(vy1 - vy0));
                plutovg_canvas_fill((plutovg_canvas_t *)(intptr_t)canvas);
              } else {
                Cons *grp = (Cons *)(intptr_t)p->head;
                double acc = 0.0;
                Cons *vals = (Cons *)(intptr_t)grp->tail;
                Cons *fills = (Cons *)(intptr_t)r->data3;
                while (vals) {
                  int64_t fill = fills ? fills->head : r->style1;
                  SET_FILL_STYLE(fill, ((int *)0), ((int *)0));
                  double h = BITS_DBL(vals->head);
                  double vx0, vy0, vx1, vy1;
                  if (r->i1) { MAP_POINT(acc, x0, &vx0, &vy0); MAP_POINT(acc + h, x1, &vx1, &vy1); }
                  else { MAP_POINT(x0, acc, &vx0, &vy0); MAP_POINT(x1, acc + h, &vx1, &vy1); }
                  plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)vx0, (float)fmin(vy0, vy1), (float)(vx1 - vx0), (float)fabs(vy1 - vy0));
                  plutovg_canvas_fill((plutovg_canvas_t *)(intptr_t)canvas);
                  acc += h;
                  vals = (Cons *)(intptr_t)vals->tail;
                  fills = fills ? (Cons *)(intptr_t)fills->tail : NULL;
                }
              }
            }
          } else {
            Cons *fills = (Cons *)(intptr_t)r->data2;
            for (Cons *p = (Cons *)(intptr_t)r->data1; p; p = (Cons *)(intptr_t)p->tail) {
              int64_t fill = (r->kind == RK_AREA_HIST) ? (fills ? fills->head : r->style1) : r->style1;
              SET_FILL_STYLE(fill, ((int *)0), ((int *)0));
              Cons *a = (Cons *)(intptr_t)p->head;
              double x0 = BITS_DBL(a->head);
              Cons *b = (Cons *)(intptr_t)a->tail;
              double x1 = BITS_DBL(b->head);
              Cons *c = (Cons *)(intptr_t)b->tail;
              double y0 = BITS_DBL(c->head);
              double y1 = BITS_DBL(c->tail);
              double vx0, vy0, vx1, vy1; MAP_POINT(x0, y0, &vx0, &vy0); MAP_POINT(x1, y1, &vx1, &vy1);
              plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)fmin(vx0, vx1), (float)fmin(vy0, vy1), (float)fabs(vx1 - vx0), (float)fabs(vy1 - vy0));
              plutovg_canvas_fill((plutovg_canvas_t *)(intptr_t)canvas);
              fills = fills ? (Cons *)(intptr_t)fills->tail : NULL;
            }
          }
        } break;
        case RK_COLOR_FIELD:
        case RK_CONTOUR_INTERVALS: {
          int samples = (int)r->i1; if (samples < 8) samples = 8;
          Cons *fills = (Cons *)(intptr_t)r->style1;
          for (int iy = 0; iy < samples - 1; iy++) for (int ix = 0; ix < samples - 1; ix++) {
            double x0 = r->f1 + (r->f2 - r->f1) * ((double)ix / (double)(samples - 1));
            double x1 = r->f1 + (r->f2 - r->f1) * ((double)(ix + 1) / (double)(samples - 1));
            double y0 = r->f3 + (r->f4 - r->f3) * ((double)iy / (double)(samples - 1));
            double y1 = r->f3 + (r->f4 - r->f3) * ((double)(iy + 1) / (double)(samples - 1));
            /* color-field's callback returns a palette index, not a level: only
               contour-intervals reads v. */
            double v = (r->kind == RK_COLOR_FIELD) ? 0.0
                       : TUR_APPLY2_T(double, double, double, r->data1, (x0 + x1) * 0.5, (y0 + y1) * 0.5);
            int color = 0;
            double alpha = (r->kind == RK_COLOR_FIELD) ? r->f5 : 0.55;
            if (r->kind == RK_COLOR_FIELD) {
              color = (int)TUR_APPLY2_T(int64_t, double, double, r->data1, (x0 + x1) * 0.5, (y0 + y1) * 0.5);
              color %= 8; if (color < 0) color += 8;
            } else {
              int bands = (int)r->i2 + 1;
              double t = (v - r->f5) / (r->f6 - r->f5);
              if (!(t == t)) t = 0.0;
              if (t < 0.0) t = 0.0; if (t > 0.999) t = 0.999;
              int band = (int)floor(t * bands);
              Cons *fs = (Cons *)(intptr_t)r->style1;
              for (int bi = 0; bi < band && fs; bi++) fs = (Cons *)(intptr_t)fs->tail;
              FillStyle *fill = (FillStyle *)(intptr_t)(fs ? fs->head : 0);
              color = fill ? (int)fill->color : band % 8;
              if (color < 0) color = band % 8;
            }
            double vx0, vy0, vx1, vy1; MAP_POINT(x0, y0, &vx0, &vy0); MAP_POINT(x1, y1, &vx1, &vy1);
            plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, (float)palette[color][0], (float)palette[color][1], (float)palette[color][2], (float)alpha);
            plutovg_canvas_fill_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)fmin(vx0, vx1), (float)fmin(vy0, vy1), (float)fabs(vx1 - vx0), (float)fabs(vy1 - vy0));
          }
        } break;
        case RK_ISOLINE:
        case RK_CONTOURS: {
          SET_LINE_STYLE(r->style1, ((int *)0));
          int samples = (int)r->i1; if (samples < 8) samples = 8;
          int nlevels = (r->kind == RK_CONTOURS) ? (int)r->i2 : 1;
          for (int li = 0; li < nlevels; li++) {
            double level = (r->kind == RK_ISOLINE) ? r->f5 : (r->f5 + (r->f6 - r->f5) * ((double)(li + 1) / (double)(nlevels + 1)));
            for (int iy = 0; iy < samples - 1; iy++) for (int ix = 0; ix < samples - 1; ix++) {
              double x0 = r->f1 + (r->f2 - r->f1) * ((double)ix / (double)(samples - 1));
              double x1 = r->f1 + (r->f2 - r->f1) * ((double)(ix + 1) / (double)(samples - 1));
              double y0 = r->f3 + (r->f4 - r->f3) * ((double)iy / (double)(samples - 1));
              double y1 = r->f3 + (r->f4 - r->f3) * ((double)(iy + 1) / (double)(samples - 1));
              double v00 = TUR_APPLY2_T(double, double, double, r->data1, x0, y0) - level;
              double v10 = TUR_APPLY2_T(double, double, double, r->data1, x1, y0) - level;
              double v01 = TUR_APPLY2_T(double, double, double, r->data1, x0, y1) - level;
              double v11 = TUR_APPLY2_T(double, double, double, r->data1, x1, y1) - level;
              double ptsx[4], ptsy[4]; int pc = 0;
              if ((v00 <= 0 && v10 > 0) || (v00 > 0 && v10 <= 0)) { double t = v00 / (v00 - v10); ptsx[pc] = x0 + (x1 - x0) * t; ptsy[pc++] = y0; }
              if ((v10 <= 0 && v11 > 0) || (v10 > 0 && v11 <= 0)) { double t = v10 / (v10 - v11); ptsx[pc] = x1; ptsy[pc++] = y0 + (y1 - y0) * t; }
              if ((v11 <= 0 && v01 > 0) || (v11 > 0 && v01 <= 0)) { double t = v11 / (v11 - v01); ptsx[pc] = x1 + (x0 - x1) * t; ptsy[pc++] = y1; }
              if ((v01 <= 0 && v00 > 0) || (v01 > 0 && v00 <= 0)) { double t = v01 / (v01 - v00); ptsx[pc] = x0; ptsy[pc++] = y1 + (y0 - y1) * t; }
              if (pc >= 2) {
                double vx0, vy0, vx1, vy1; MAP_POINT(ptsx[0], ptsy[0], &vx0, &vy0); MAP_POINT(ptsx[1], ptsy[1], &vx1, &vy1);
                plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx0, (float)vy0);
                plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx1, (float)vy1);
              }
            }
          }
          plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
        } break;
        default: break;
      }
      }
    }

    plutovg_canvas_restore((plutovg_canvas_t *)(intptr_t)canvas);
    ```)

  ;;; __plot-into-canvas-legacy -- the drawing worker: lay out the frame, axes,
  ;;; ticks and labels over the data extent the caller resolved (`data-valid`
  ;;; false when no renderer constrains it), draw the lowered slot-bag
  ;;; `renderers` Vec into it, then the legend. `plot-into-canvas` is the typed
  ;;; entry point; this is what it lowers to.
  (defn __plot-into-canvas-legacy [canvas : int renderers : int opts : int
                                   px : int py : int pw : int ph : int
                                   data-valid : bool
                                   data-x-min : float  data-x-max : float
                                   data-y-min : float  data-y-max : float] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    #include <stdbool.h>
    #include <string.h>
    #include <stdio.h>
    #include <float.h>
    #include <unistd.h>
    extern double floor(double);
    extern double ceil(double);
    extern double log10(double);
    extern double pow(double, double);
    extern double sqrt(double);
    extern double cos(double);
    extern double sin(double);
    extern double atan2(double, double);
    extern double exp(double);
    extern double fabs(double);
    extern double fmin(double, double);
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_surface_t;
    typedef void plutovg_canvas_t;
    typedef void plutovg_font_face_t;
    typedef int plutovg_text_encoding_t;
    #define PLUTOVG_TEXT_ENCODING_UTF8 1
    extern void plutovg_surface_destroy(void* surface);
    extern void* plutovg_font_face_load_from_file(const char* filename, int ttcindex);
    extern void plutovg_font_face_destroy(void* face);
    extern void plutovg_canvas_save(void* canvas);
    extern void plutovg_canvas_restore(void* canvas);
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    extern void plutovg_canvas_set_font_face(void* canvas, void* face);
    extern void plutovg_canvas_set_font_size(void* canvas, float size);
    extern void plutovg_canvas_set_line_width(void* canvas, float line_width);
    extern void plutovg_canvas_set_dash_array(void* canvas, const float* dashes, int ndashes);
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_rect(void* canvas, float x, float y, float w, float h);
    extern void plutovg_canvas_circle(void* canvas, float cx, float cy, float r);
    extern void plutovg_canvas_close_path(void* canvas);
    extern void plutovg_canvas_fill(void* canvas);
    extern void plutovg_canvas_stroke(void* canvas);
    extern void plutovg_canvas_clip(void* canvas);
    extern void plutovg_canvas_fill_rect(void* canvas, float x, float y, float w, float h);
    extern float plutovg_canvas_fill_text(void* canvas, const void* text, int length,
                                          int encoding, float x, float y);
    #endif

    typedef struct { int64_t head; int64_t tail; } Cons;
    #define RETURN_ERR(CODE) do { \
      return (void *)(intptr_t)tur_err_int((CODE)); \
    } while (0)
    #define RETURN_OK(VALUE) do { \
      return (void *)(intptr_t)tur_ok_int((VALUE)); \
    } while (0)
    typedef struct __plot_renderer {
      int64_t kind;
      int64_t style1, style2;
      int64_t data1, data2, data3, data4, data5;
      double f1, f2, f3, f4, f5, f6;
      int64_t i1, i2, i3, i4;
      char *label;
      char *text;
      double x_min, x_max, y_min, y_max;
    } PlotRenderer;
    typedef struct { int64_t color; double width; int64_t dash; double alpha; } LineStyle;
    typedef struct { int64_t color; int64_t fill_color; int64_t sym; double size; double alpha; } PointStyle;
    typedef struct { int64_t color; double alpha; int64_t line_color; double line_width; } FillStyle;
    typedef struct {
      int64_t width; int64_t height;
      char *title; char *x_label; char *y_label;
      double x_min, x_max, y_min, y_max;
      int64_t legend_pos;
    } PlotOpts;

    enum {
      RK_X_AXIS = 1, RK_Y_AXIS = 2, RK_AXES = 3,
      RK_X_TICKS = 4, RK_Y_TICKS = 5, RK_GRID = 6,
      RK_HRULE = 7, RK_VRULE = 8, RK_LABEL = 9,
      RK_LINES = 20, RK_FUNCTION = 21, RK_PARAMETRIC = 22, RK_POLAR = 23, RK_INVERSE = 24, RK_DENSITY = 25,
      RK_POINTS = 30, RK_ERROR_BARS = 31, RK_VECTOR_FIELD = 32, RK_ARROWS = 33,
      RK_FUNCTION_INTERVAL = 40, RK_LINES_INTERVAL = 41, RK_PARAM_INTERVAL = 42, RK_POLAR_INTERVAL = 43,
      RK_RECTANGLES = 50, RK_AREA_HIST = 51, RK_DISCRETE_HIST = 52, RK_STACKED_HIST = 53,
      RK_ISOLINE = 60, RK_CONTOURS = 61, RK_CONTOUR_INTERVALS = 62, RK_COLOR_FIELD = 63
    };

    static const double palette[8][3] = {
      {31.0/255.0, 119.0/255.0, 180.0/255.0},
      {214.0/255.0, 39.0/255.0, 40.0/255.0},
      {44.0/255.0, 160.0/255.0, 44.0/255.0},
      {255.0/255.0, 127.0/255.0, 14.0/255.0},
      {148.0/255.0, 103.0/255.0, 189.0/255.0},
      {140.0/255.0, 86.0/255.0, 75.0/255.0},
      {227.0/255.0, 119.0/255.0, 194.0/255.0},
      {127.0/255.0, 127.0/255.0, 127.0/255.0}
    };

    #define DBL_BITS(v) (((union { double d; int64_t i; }){.d=(v)}).i)
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))

    double bx_min = 0.0, bx_max = 1.0, by_min = 0.0, by_max = 1.0;
    bool have_bounds = false;
    bool want_x_axis = false, want_y_axis = false, want_grid_x = false, want_grid_y = false;
    int64_t categorical = 0;
    int64_t categories = 0;
    PlotOpts *po = (PlotOpts *)(intptr_t)opts;
    int legend_pos = po && po->legend_pos ? (int)po->legend_pos : 1;
    int font_ok = 0;
    plutovg_font_face_t *font = NULL;
    const char *font_candidates[] = {
      "/System/Library/Fonts/Supplemental/Arial.ttf",
      "/System/Library/Fonts/Supplemental/Helvetica.ttf",
      "/System/Library/Fonts/Helvetica.ttc",
      "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
      "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
      "/usr/share/fonts/dejavu/DejaVuSans.ttf",
      NULL
    };
    for (int fi = 0; font_candidates[fi]; fi++) {
      if (access(font_candidates[fi], R_OK) == 0) {
        font = plutovg_font_face_load_from_file(font_candidates[fi], 0);
        if (font) { font_ok = 1; break; }
      }
    }

    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!have_bounds) { \
          bx_min = bx_max = __ux; \
          by_min = by_max = __uy; \
          have_bounds = true; \
        } else { \
          if (__ux < bx_min) bx_min = __ux; \
          if (__ux > bx_max) bx_max = __ux; \
          if (__uy < by_min) by_min = __uy; \
          if (__uy > by_max) by_max = __uy; \
        } \
      } \
    } while (0)

    typedef struct { int64_t *data; size_t len; size_t cap; } RendVec;
    RendVec *__rvec = (RendVec *)(intptr_t)renderers;
    size_t __rlen = __rvec ? __rvec->len : 0;
    for (size_t __ri = 0; __ri < __rlen; __ri++) {
      PlotRenderer *r = (PlotRenderer *)(intptr_t)__rvec->data[__ri];
      if (!r) continue;
      if (r->kind == RK_X_AXIS || r->kind == RK_AXES) want_x_axis = true;
      if (r->kind == RK_Y_AXIS || r->kind == RK_AXES) want_y_axis = true;
      if (r->kind == RK_X_TICKS || r->kind == RK_GRID) want_grid_x = true;
      if (r->kind == RK_Y_TICKS || r->kind == RK_GRID) want_grid_y = true;
      if ((r->kind == RK_DISCRETE_HIST || r->kind == RK_STACKED_HIST) && !categorical) {
        categorical = 1;
        categories = r->data2;
      }
    }
    /* The data extent: the union of every renderer's `bounds`, folded by the
       caller through the Renderer typeclass. */
    if (data_valid) {
      UNION_POINT(data_x_min, data_y_min);
      UNION_POINT(data_x_max, data_y_max);
    }

    if (!have_bounds) { bx_min = 0.0; bx_max = 1.0; by_min = 0.0; by_max = 1.0; }
    if (po) {
      if (!ISNAN(po->x_min)) bx_min = po->x_min;
      if (!ISNAN(po->x_max)) bx_max = po->x_max;
      if (!ISNAN(po->y_min)) by_min = po->y_min;
      if (!ISNAN(po->y_max)) by_max = po->y_max;
    }
    if (!(bx_max > bx_min)) { bx_min -= 1.0; bx_max += 1.0; }
    if (!(by_max > by_min)) { by_min -= 1.0; by_max += 1.0; }
    double padx = (bx_max - bx_min) * 0.05;
    double pady = (by_max - by_min) * 0.05;
    if (padx == 0.0) padx = 1.0;
    if (pady == 0.0) pady = 1.0;
    bx_min -= padx; bx_max += padx;
    by_min -= pady; by_max += pady;

    int left = px + 64;
    int right = px + pw - 24;
    int top = py + ((po && po->title) ? 44 : 24);
    int bottom = py + ph - ((po && (po->x_label || categorical)) ? 58 : 44);
    int plot_w = right - left;
    int plot_h = bottom - top;
    if (plot_w < 32 || plot_h < 32) RETURN_ERR(1);

    plutovg_canvas_save((plutovg_canvas_t *)(intptr_t)canvas);
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 1.0f, 1.0f, 1.0f, 1.0f);
    plutovg_canvas_fill_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)px, (float)py, (float)pw, (float)ph);
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.98f, 0.98f, 0.98f, 1.0f);
    plutovg_canvas_fill_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)top, (float)plot_w, (float)plot_h);
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.7f, 0.7f, 0.7f, 1.0f);
    plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)top, (float)plot_w, (float)plot_h);
    plutovg_canvas_set_line_width((plutovg_canvas_t *)(intptr_t)canvas, 1.0f);
    plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);

    if (font_ok) {
      plutovg_canvas_set_font_face((plutovg_canvas_t *)(intptr_t)canvas, font);
      plutovg_canvas_set_font_size((plutovg_canvas_t *)(intptr_t)canvas, 12.0f);
    }

    int tick_n = 6;
    double x_ticks[32], y_ticks[32];
    const char *x_labels[32], *y_labels[32];
    /* The label text the two arrays point into.  Declared here, not in the
       blocks that fill them: x_labels outlives its block, and a buffer local
       to it was reused by the y block's, so every x tick was labelled with a
       y value. */
    char xbuf[32][64], ybuf[32][64];
    int x_count = 0, y_count = 0;

    if (categorical) {
      int idx = 0;
      for (Cons *p = (Cons *)(intptr_t)categories; p && idx < 32; p = (Cons *)(intptr_t)p->tail, idx++) {
        /* Each cell holds a bar (label . height) or a group (label . values),
           as the draw loop reads them; the label is that pair's head, not the
           pair -- printing the pair's address as text drew garbage. */
        Cons *bar = (Cons *)(intptr_t)p->head;
        x_ticks[idx] = (double)idx + 0.4;
        x_labels[idx] = bar ? (const char *)(intptr_t)bar->head : "";
      }
      x_count = idx;
    } else {
      double span = bx_max - bx_min;
      double raw = span / (double)(tick_n - 1);
      double mag = pow(10.0, floor(log10(raw)));
      double norm = raw / mag;
      double step = (norm < 1.5 ? 1.0 : (norm < 3.0 ? 2.0 : (norm < 7.0 ? 5.0 : 10.0))) * mag;
      double start = ceil(bx_min / step) * step;
      int prec = step >= 1.0 ? 2 : (int)ceil(-log10(step)) + 1;
      if (prec < 0) prec = 0; if (prec > 8) prec = 8;
      for (double v = start; v <= bx_max + step * 0.25 && x_count < 32; v += step) {
        x_ticks[x_count] = v;
        snprintf(xbuf[x_count], sizeof(xbuf[x_count]), "%.*f", prec, v);
        x_labels[x_count] = xbuf[x_count];
        x_count++;
      }
    }
    {
      double span = by_max - by_min;
      double raw = span / (double)(tick_n - 1);
      double mag = pow(10.0, floor(log10(raw)));
      double norm = raw / mag;
      double step = (norm < 1.5 ? 1.0 : (norm < 3.0 ? 2.0 : (norm < 7.0 ? 5.0 : 10.0))) * mag;
      double start = ceil(by_min / step) * step;
      int prec = step >= 1.0 ? 2 : (int)ceil(-log10(step)) + 1;
      if (prec < 0) prec = 0; if (prec > 8) prec = 8;
      for (double v = start; v <= by_max + step * 0.25 && y_count < 32; v += step) {
        y_ticks[y_count] = v;
        snprintf(ybuf[y_count], sizeof(ybuf[y_count]), "%.*f", prec, v);
        y_labels[y_count] = ybuf[y_count];
        y_count++;
      }
    }

    if (!want_x_axis && by_min <= 0.0 && by_max >= 0.0) want_x_axis = true;
    if (!want_y_axis && bx_min <= 0.0 && bx_max >= 0.0) want_y_axis = true;

    if (want_grid_x || want_grid_y) {
      plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.90f, 0.90f, 0.90f, 1.0f);
      plutovg_canvas_set_line_width((plutovg_canvas_t *)(intptr_t)canvas, 1.0f);
      if (want_grid_x) for (int i = 0; i < x_count; i++) {
        double tx = (x_ticks[i] - bx_min) / (bx_max - bx_min);
        double vx = left + tx * plot_w;
        plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)top);
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)bottom);
      }
      if (want_grid_y) for (int i = 0; i < y_count; i++) {
        double ty = (y_ticks[i] - by_min) / (by_max - by_min);
        double vy = bottom - ty * plot_h;
        plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)vy);
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)right, (float)vy);
      }
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    }

    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.2f, 0.2f, 0.2f, 1.0f);
    if (want_x_axis) {
      double vy = bottom - ((0.0 - by_min) / (by_max - by_min)) * plot_h;
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)vy);
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)right, (float)vy);
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    }
    if (want_y_axis) {
      double vx = left + ((0.0 - bx_min) / (bx_max - bx_min)) * plot_w;
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)top);
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)bottom);
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    }

    if (font_ok) {
      plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.15f, 0.15f, 0.15f, 1.0f);
      for (int i = 0; i < x_count; i++) {
        double tx = (x_ticks[i] - bx_min) / (bx_max - bx_min);
        double vx = left + tx * plot_w;
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 x_labels[i], (int)strlen(x_labels[i]),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(vx - 10.0), (float)(bottom + 18.0));
      }
      for (int i = 0; i < y_count; i++) {
        double ty = (y_ticks[i] - by_min) / (by_max - by_min);
        double vy = bottom - ty * plot_h;
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 y_labels[i], (int)strlen(y_labels[i]),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(left - 48.0), (float)(vy + 4.0));
      }
      if (po && po->title) {
        plutovg_canvas_set_font_size((plutovg_canvas_t *)(intptr_t)canvas, 16.0f);
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 po->title, (int)strlen(po->title),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)left, (float)(py + 24));
        plutovg_canvas_set_font_size((plutovg_canvas_t *)(intptr_t)canvas, 12.0f);
      }
      if (po && po->x_label) {
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 po->x_label, (int)strlen(po->x_label),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(left + plot_w / 2 - 20), (float)(py + ph - 16));
      }
      if (po && po->y_label) {
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 po->y_label, (int)strlen(po->y_label),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(px + 8), (float)(top - 8));
      }
    }

    /* P0: the per-kind draw switch + clip bracket now live in __draw-renderers
       (pinned C symbol plot_draw_renderers). Delegate the data rendering. */
    {
      extern void plot_draw_renderers(int64_t, int64_t, double, double, double, double,
                                      int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t);
      plot_draw_renderers(canvas, renderers, bx_min, bx_max, by_min, by_max,
                          left, right, top, bottom, plot_w, plot_h, font_ok);
    }

    if (font_ok && legend_pos != 0) {
      double lx = (legend_pos == 2 || legend_pos == 4) ? left + 12.0 : right - 120.0;
      double ly = (legend_pos == 3 || legend_pos == 4) ? bottom - 16.0 : top + 16.0;
      plutovg_canvas_set_font_face((plutovg_canvas_t *)(intptr_t)canvas, font);
      plutovg_canvas_set_font_size((plutovg_canvas_t *)(intptr_t)canvas, 12.0f);
      int row = 0;
      RendVec *__rvec3 = (RendVec *)(intptr_t)renderers;
      size_t __rlen3 = __rvec3 ? __rvec3->len : 0;
      for (size_t __ri3 = 0; __ri3 < __rlen3; __ri3++) {
        PlotRenderer *r = (PlotRenderer *)(intptr_t)__rvec3->data[__ri3];
        if (!r || !r->label || !r->label[0]) continue;
        double y = ly + row * 16.0;
        int color = row % 8;
        plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas,
                                (float)palette[color][0], (float)palette[color][1],
                                (float)palette[color][2], 1.0f);
        plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)lx, (float)y);
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(lx + 12.0), (float)y);
        plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
        plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.15f, 0.15f, 0.15f, 1.0f);
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas, r->label, (int)strlen(r->label),
                                 PLUTOVG_TEXT_ENCODING_UTF8, (float)(lx + 18.0), (float)(y + 4.0));
        row++;
      }
    }
    if (font) plutovg_font_face_destroy(font);
    RETURN_OK(0);
    ```)

  ;;; plot-into-canvas -- render renderers into an existing canvas and viewport.
  ;;;
  ;;; The data extent is the union of the renderers' `bounds` (padded 5%, and
  ;;; overridden per side by `opts`); each renderer is then lowered with
  ;;; `to-legacy` for the C draw pass and the lowered handles freed after.
  ;;;
  ;;; Parameters:
  ;;;   canvas    -- the plutovg canvas to draw into
  ;;;   renderers -- the renderers, as the constructors return them
  ;;;   opts      -- a plot-opts handle
  ;;;   px py     -- the viewport's top-left corner, in canvas pixels
  ;;;   pw ph     -- the viewport's size, in canvas pixels
  ;;;
  ;;; Returns:
  ;;;   ok 0, or err 1 when the viewport is too small to hold a plot.
  ;;;
  ;;; Example:
  ;;;   (plot-into-canvas canvas (vec-of (axes) (lines pts ls "")) opts 0 0 600 450)
  (defn plot-into-canvas [canvas : int  renderers : (Vec AnyRenderer)  opts : int
                          px : int  py : int  pw : int  ph : int] : ptr<void>
    (let [bb     (renderers-bbox renderers)
          legacy (anyrenderers->legacy renderers)
          rr     (__plot-into-canvas-legacy canvas (:: legacy :int) opts px py pw ph
                                            (not (bbox-empty? bb))
                                            (.x-min bb) (.x-max bb) (.y-min bb) (.y-max bb))]
      (__free-renderers (:: legacy :int))
      (vec-free legacy)
      rr))

  ;; ---------------------------------------------------------------------------
  ;; Backend -- the output target a plot renders to (U2 typeclass collapse).
  ;;
  ;; The three legacy entrypoints (`plot-into-canvas`, `plot`, `plot-write-png`)
  ;; differed only in *where* the same renderer Vec lands: an existing canvas, a
  ;; fresh surface, or a PNG file. They are now one method, `render-to`, with
  ;; one instance per target, so plot-building code can be written generic over
  ;; the destination and a new sink (e.g. a notebook-inline backend) becomes a
  ;; new instance rather than a new top-level function.
  ;;
  ;; Named `Backend`, not the uplift plan's "Renderer": in this spice a
  ;; "renderer" is a drawable element (the `renderers` Vec), and `Renderer` is
  ;; the class those elements implement. The concept the plan means here is
  ;; the output backend.
  ;;
  ;; `render-to` returns the same :ptr<void> result envelope the legacy
  ;; entrypoints did: ok-val carries the new surface handle for SurfaceBackend,
  ;; 0 for the canvas/PNG sinks; err-val carries the failure code.
  ;; ---------------------------------------------------------------------------
  (defclass Backend [b]
    (render-to [self : b  renderers : (Vec AnyRenderer)  opts : int] : ptr<void>))

  ;; CanvasBackend -- draw into an existing canvas at the given viewport.
  (defstruct CanvasBackend [canvas : int  px : int  py : int  pw : int  ph : int])

  ;; SurfaceBackend -- allocate a fresh surface and return it (caller owns).
  ;; A width/height of 0 falls back to the opts dimensions (or 600x450).
  (defstruct SurfaceBackend [width : int  height : int])

  ;; PngBackend -- render to a fresh surface and write it to `path` as PNG.
  (defstruct PngBackend [path : cstr])

  ;; CanvasBackend delegates straight to the inline-C drawing worker.
  (definstance Backend [CanvasBackend]
    (render-to [self renderers opts]
      (plot-into-canvas (.canvas self) renderers opts
                        (.px self) (.py self) (.pw self) (.ph self))))

  ;; SurfaceBackend allocates the surface + canvas, then dispatches the draw
  ;; through CanvasBackend and hands the surface back on success.
  (definstance Backend [SurfaceBackend]
    (render-to [self renderers opts]
      (let [w  (if (> (.width self) 0) (.width self)
                 (if (> (plot-opts-width opts) 0) (plot-opts-width opts) 600))
            h  (if (> (.height self) 0) (.height self)
                 (if (> (plot-opts-height opts) 0) (plot-opts-height opts) 450))
            sr (__surface-create w h)]
        (if (__ok? sr)
          (let [surface (__ok-val sr)
                cr      (__canvas-create surface)]
            (if (__ok? cr)
              (let [canvas (__ok-val cr)
                    rr (render-to (make-struct CanvasBackend canvas 0 0 w h)
                                  renderers opts)]
                (__canvas-destroy canvas)
                (if (__ok? rr)
                  (__ok surface)
                  (do
                    (__surface-destroy surface)
                    (__err (__err-val rr)))))
              (__err (__err-val cr))))
          (__err (__err-val sr))))))

  ;; PngBackend renders through SurfaceBackend, then writes + frees the surface.
  (definstance Backend [PngBackend]
    (render-to [self renderers opts]
      (let [r (render-to (make-struct SurfaceBackend 0 0) renderers opts)]
        (if (__ok? r)
          (let [s  (__ok-val r)
                wr (__surface-write-png s (.path self))]
            (__surface-destroy s)
            wr)
          (__err (__err-val r))))))

  ;;; render -- draw `renderers` to any Backend, generic over the sink.
  ;;;
  ;;; This is the plan's "the plot DSL becomes generic in Backend": one entry
  ;;; point polymorphic over the output target, so a caller can hold a backend
  ;;; value and dispatch to the right instance regardless of concrete type.
  ;;; `plot`, `plot-write-png`, and `plot-into-canvas` are the convenience
  ;;; monomorphic wrappers; `render` is the generic form.
  ;;;
  ;;; Example:
  ;;;   (render (make-struct PngBackend "out.png") rs opts)
  ;;;   (render (make-struct SurfaceBackend 0 0)   rs opts)
  (defn render [^Backend B b : B  renderers : (Vec AnyRenderer)  opts : int] : ptr<void>
    (render-to b renderers opts))

  ;;; plot -- render renderers to a new surface and return it.
  ;;;
  ;;; renderers is a (Vec AnyRenderer): build it with vec-of over the
  ;;; constructors, or vec-new + vec-push!. (It was a (Vec int) of slot-bag
  ;;; handles through 0.4.0, and a cons list before 0.2.0.)
  ;;;
  ;;; Thin wrapper over the `Backend` dispatch (the `SurfaceBackend` instance);
  ;;; equivalent to `(render-to (make-struct SurfaceBackend 0 0) renderers opts)`.
  (defn plot [renderers : (Vec AnyRenderer) opts : int] : ptr<void>
    (render-to (make-struct SurfaceBackend 0 0) renderers opts))

  ;;; plot-write-png -- render renderers and write them to a PNG file.
  ;;;
  ;;; renderers is a (Vec AnyRenderer), as for `plot`.
  ;;;
  ;;; Thin wrapper over the `Backend` dispatch (the `PngBackend` instance);
  ;;; equivalent to `(render-to (make-struct PngBackend path) renderers opts)`.
  (defn plot-write-png [renderers : (Vec AnyRenderer) opts : int path : cstr] : ptr<void>
    (render-to (make-struct PngBackend path) renderers opts))

) ;; end defmodule plot/core
