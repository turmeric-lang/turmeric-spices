;; plot/core.tur -- renderer representation and plot entrypoints.

(defmodule plot/core
  (export plot plot-write-png plot-into-canvas render
          ;; `render` is generic over `^Backend B`, so a caller cannot build
          ;; an argument for it without the backend structs -- exporting the
          ;; entry point but not its sinks left it unusable, and is what made
          ;; tests/plot/backend_test.tur fail on "symbol 'SurfaceBackend' is
          ;; private to module 'plot/core'".
          CanvasBackend SurfaceBackend PngBackend
          ;; any-renderer boxes a value as the AnyRenderer every public
          ;; constructor returns. (The `Renderer` class, its methods and the
          ;; `AnyRenderer` alias are global, as every class and alias is;
          ;; they are not exported by name.)
          any-renderer
          ;; what a kind's `draw` method draws through
          DrawCtx FrameMarks no-frame-marks frame-marks-union
          ;; `legend-labels`' default body, compiled in each instance's module
          __one-label
          __surface-create __surface-destroy __surface-write-png
          __canvas-create __canvas-destroy
          __plot-sample-adaptive
          BBox renderer-bbox renderers-bbox bbox-empty? bbox-from-raw
          __bbox-of-points __bbox-of-error-bars __bbox-of-arrows __bbox-of-rects
          __bbox-of-bars __bbox-of-groups
          bbox-union bbox-empty-box point-bbox hint-bbox
          __point-list-bbox __error-bars-bbox __arrows-bbox __rects-bbox
          __discrete-hist-bbox __stacked-hist-bbox
          plot-anyrenderers __surfaces-equal?
          __ok? __ok-val __err-val
          __surface-width __surface-height __surface-pixel-byte
          __pixel-is-background? __count-non-background)

  (import plot/style :refer [PlotOpts plot-opts-width plot-opts-height])
  (import plot/data  :refer [Point ErrorBar Arrow Rect Bar Group Cells
                             __points->cells __error-bars->cells __arrows->cells __rects->cells
                             __bars->cells __groups->cells __labels->cells
                             __free-cells __free-groups])

  ;; Result helpers: route through the typed preamble builders /
  ;; inspectors (tur_ok_int / tur_err_int / tur_is_ok / tur_ok_value /
  ;; tur_err_value) so the canonical layout lives in one place
  ;; (tur_runtime.h). The :ptr<void> carrier surface is preserved
  ;; because the in-tree plot modules and test suite both call these
  ;; through their existing types; tightening to (Result int int) is a
  ;; downstream sweep beyond this migration's scope.

  ;;; __ok -- create an ok result wrapping integer value v.
  (defn __ok [v : int] : ptr<void>
    ```c
    return (void *)(intptr_t)tur_ok_int(v);
    ```)

  ;;; __err -- create an err result wrapping integer error value e.
  (defn __err [e : int] : ptr<void>
    ```c
    return (void *)(intptr_t)tur_err_int(e);
    ```)

  ;;; __ok? -- predicate for the local :ptr<void> result envelope.
  (defn __ok? [r : ptr<void>] : bool
    ```c
    return r != 0 && tur_is_ok((int64_t)(intptr_t)r);
    ```)

  ;;; __ok-val -- extract the ok payload from the local :ptr<void> result envelope.
  (defn __ok-val [r : ptr<void>] : int
    ```c
    return r != 0 ? tur_ok_value((int64_t)(intptr_t)r) : 0;
    ```)

  ;;; __err-val -- extract the err payload from the local :ptr<void> result envelope.
  (defn __err-val [r : ptr<void>] : int
    ```c
    return r != 0 ? tur_err_value((int64_t)(intptr_t)r) : 0;
    ```)

  ;;; __surface-create -- allocate a new plutovg surface.
  (defn __surface-create [width : int height : int] : ptr<void>
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void* plutovg_surface_create(int width, int height);
    #endif
    void *s = plutovg_surface_create((int)width, (int)height);
    return (void *)(intptr_t)(s ? tur_ok_ptr(s) : tur_err_int(1));
    ```)

  ;;; __surface-destroy -- destroy a plutovg surface.
  (defn __surface-destroy [surface : int] : void
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void plutovg_surface_destroy(void* surface);
    #endif
    if (surface) plutovg_surface_destroy((void *)(intptr_t)surface);
    ```)

  ;;; __surface-write-png -- write a plutovg surface to a PNG file.
  (defn __surface-write-png [surface : int path : cstr] : ptr<void>
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern bool plutovg_surface_write_to_png(const void* surface, const char* filename);
    #endif
    bool ok = plutovg_surface_write_to_png((void *)(intptr_t)surface,
                                           (const char *)(intptr_t)path);
    return (void *)(intptr_t)(ok ? tur_ok_int(0) : tur_err_int(1));
    ```)

  ;;; __canvas-create -- allocate a canvas for an existing surface.
  (defn __canvas-create [surface : int] : ptr<void>
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void* plutovg_canvas_create(void* surface);
    #endif
    void *c = plutovg_canvas_create((void *)(intptr_t)surface);
    return (void *)(intptr_t)(c ? tur_ok_ptr(c) : tur_err_int(1));
    ```)

  ;;; __canvas-destroy -- destroy a plutovg canvas.
  (defn __canvas-destroy [canvas : int] : void
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void plutovg_canvas_destroy(void* canvas);
    #endif
    if (canvas) plutovg_canvas_destroy((void *)(intptr_t)canvas);
    ```)

  ;;; __surface-width -- width of a plutovg surface in pixels.
  (defn __surface-width [surface : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern int plutovg_surface_get_width(const void* surface);
    #endif
    if (!surface) return 0;
    return (int64_t)plutovg_surface_get_width((const void *)(intptr_t)surface);
    ```)

  ;;; __surface-height -- height of a plutovg surface in pixels.
  (defn __surface-height [surface : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern int plutovg_surface_get_height(const void* surface);
    #endif
    if (!surface) return 0;
    return (int64_t)plutovg_surface_get_height((const void *)(intptr_t)surface);
    ```)

  ;;; __surface-pixel-byte -- read a single byte from the surface's raw pixel buffer.
  ;;;
  ;;; plutovg stores pixels in 32-bpp BGRA order (premultiplied alpha) on
  ;;; little-endian platforms. `channel` selects the byte within the pixel:
  ;;;   0 -- B, 1 -- G, 2 -- R, 3 -- A.
  ;;; Returns -1 if (x, y) is out of bounds.
  (defn __surface-pixel-byte [surface : int x : int y : int channel : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void* surface);
    extern int plutovg_surface_get_width(const void* surface);
    extern int plutovg_surface_get_height(const void* surface);
    extern int plutovg_surface_get_stride(const void* surface);
    #endif
    if (!surface) return -1;
    int w = plutovg_surface_get_width((const void *)(intptr_t)surface);
    int h = plutovg_surface_get_height((const void *)(intptr_t)surface);
    if ((int)x < 0 || (int)x >= w || (int)y < 0 || (int)y >= h) return -1;
    if ((int)channel < 0 || (int)channel > 3) return -1;
    int stride = plutovg_surface_get_stride((const void *)(intptr_t)surface);
    unsigned char *data = plutovg_surface_get_data((const void *)(intptr_t)surface);
    if (!data) return -1;
    return (int64_t)data[(int)y * stride + (int)x * 4 + (int)channel];
    ```)

  ;;; __count-non-background -- count pixels in [x0, x1) x [y0, y1) that are not background.
  ;;;
  ;;; Useful for "this renderer produced *some* ink in this region" assertions
  ;;; without pinning a specific pixel.
  (defn __count-non-background [surface : int
                                x0 : int y0 : int
                                x1 : int y1 : int] : int
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void* surface);
    extern int plutovg_surface_get_width(const void* surface);
    extern int plutovg_surface_get_height(const void* surface);
    extern int plutovg_surface_get_stride(const void* surface);
    #endif
    if (!surface) return 0;
    int w = plutovg_surface_get_width((const void *)(intptr_t)surface);
    int h = plutovg_surface_get_height((const void *)(intptr_t)surface);
    int stride = plutovg_surface_get_stride((const void *)(intptr_t)surface);
    unsigned char *data = plutovg_surface_get_data((const void *)(intptr_t)surface);
    if (!data) return 0;
    int xa = (int)x0 < 0 ? 0 : (int)x0;
    int ya = (int)y0 < 0 ? 0 : (int)y0;
    int xb = (int)x1 > w ? w : (int)x1;
    int yb = (int)y1 > h ? h : (int)y1;
    int64_t cnt = 0;
    for (int yy = ya; yy < yb; yy++) {
      for (int xx = xa; xx < xb; xx++) {
        unsigned char b = data[yy * stride + xx * 4 + 0];
        unsigned char g = data[yy * stride + xx * 4 + 1];
        unsigned char r = data[yy * stride + xx * 4 + 2];
        unsigned char a = data[yy * stride + xx * 4 + 3];
        if (!(r >= 250 && g >= 250 && b >= 250 && a >= 250)) cnt++;
      }
    }
    return cnt;
    ```)

  ;;; __pixel-is-background? -- true when a pixel is near pure white (>=250 in all RGB channels and full alpha).
  ;;;
  ;;; Useful for "this region was not drawn over" assertions. The plot
  ;;; background is `fill_rect` with rgba(1,1,1,1).
  (defn __pixel-is-background? [surface : int x : int y : int] : bool
    ```c
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void* surface);
    extern int plutovg_surface_get_width(const void* surface);
    extern int plutovg_surface_get_height(const void* surface);
    extern int plutovg_surface_get_stride(const void* surface);
    #endif
    if (!surface) return false;
    int w = plutovg_surface_get_width((const void *)(intptr_t)surface);
    int h = plutovg_surface_get_height((const void *)(intptr_t)surface);
    if ((int)x < 0 || (int)x >= w || (int)y < 0 || (int)y >= h) return false;
    int stride = plutovg_surface_get_stride((const void *)(intptr_t)surface);
    unsigned char *data = plutovg_surface_get_data((const void *)(intptr_t)surface);
    if (!data) return false;
    unsigned char b = data[(int)y * stride + (int)x * 4 + 0];
    unsigned char g = data[(int)y * stride + (int)x * 4 + 1];
    unsigned char r = data[(int)y * stride + (int)x * 4 + 2];
    unsigned char a = data[(int)y * stride + (int)x * 4 + 3];
    return r >= 250 && g >= 250 && b >= 250 && a >= 250;
    ```)

  ;;; __plot-sample-adaptive -- adaptive subdivision sampler for sampled-line renderers.
  ;;;
  ;;; Walks the parameter interval `[t-lo, t-hi]` in `initial-samples`
  ;;; uniform pieces and bisects each piece when the angle between adjacent
  ;;; screen-space segments exceeds the subdivision threshold, up to a fixed
  ;;; recursion cap. NaN evaluations break the active sub-path so curves with
  ;;; vertical asymptotes (e.g. tan, 1/x) render as separate strokes.
  ;;;
  ;;; Strokes the resulting polyline onto the context's canvas, mapped through
  ;;; its data bounds and viewport. The caller is responsible for installing
  ;;; the line style (color / width / dash / alpha) before invoking. `mode`
  ;;; says how to evaluate the curve: 21 y = f(x), 22 the Point f(t) (through
  ;;; `plot_eval_point`), 23 radius = f(theta), 24 x = f(y); any other mode is
  ;;; a no-op.
  ;;;
  ;;; Parameters:
  ;;;   ctx             -- the plot's draw context (a DrawCtx, as a pointer)
  ;;;   mode            -- the curve's evaluation, as above
  ;;;   curve           -- the curve: a closure handle of the mode's fn type
  ;;;   t-lo / t-hi     -- the parameter interval
  ;;;   initial-samples -- baseline uniform sample count (clamped to >= 2)
  ;;;
  ;;; Since: plot-v0.1.0
  ;;;
  ;;; Pinned to the stable C symbol `plot_sample_adaptive` via `export-as` so
  ;;; the inline-C curve draws in plot/line can name it directly.
  ;;; Without the pin, turmeric's injective identifier mangler encodes this
  ;;; `__`-prefixed, kebab-cased name as `..._un_unplot_hysample_hyadaptive`,
  ;;; which the hand-written C call could not track across mangling changes.
  (defn (export-as "plot_sample_adaptive")
        __plot-sample-adaptive [ctx : ptr<void>  mode : int  curve : int
                                t-lo : float  t-hi : float
                                initial-samples : int] : void
    ```c
    extern double cos(double);
    extern double sin(double);
    extern double sqrt(double);
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_stroke(void* canvas);
    #endif

    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;

    #define ADAPTIVE_ISNAN(v) ((v) != (v))

    enum { RK_FUNCTION_K = 21, RK_PARAMETRIC_K = 22, RK_POLAR_K = 23, RK_INVERSE_K = 24 };

    extern void plot_eval_point(int64_t, double, void *, void *);
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    if (!dc || !dc->canvas) return;
    void *cv = dc->canvas;
    if (mode != RK_FUNCTION_K && mode != RK_INVERSE_K
        && mode != RK_PARAMETRIC_K && mode != RK_POLAR_K) return;
    double bx_min = dc->bx_min, bx_max = dc->bx_max, by_min = dc->by_min, by_max = dc->by_max;
    int64_t left = dc->left, top = dc->top, plot_w = dc->plot_w, plot_h = dc->plot_h;

    int n = (int)initial_samples; if (n < 2) n = 2;
    double t_min = t_lo, t_max = t_hi;
    if (!(t_max > t_min)) return;
    double inv_w = (bx_max > bx_min) ? 1.0 / (bx_max - bx_min) : 1.0;
    double inv_h = (by_max > by_min) ? 1.0 / (by_max - by_min) : 1.0;
    double pw_d = (double)plot_w, ph_d = (double)plot_h;
    double left_d = (double)left, top_d = (double)top;

    enum { MAX_DEPTH = 6 };
    const double cos_thresh = 0.9961947;  /* cos(5 deg) */
    const double min_seg_px2 = 0.25;      /* (0.5 px)^2 floor */

    typedef struct { double t; double vx, vy; int valid; } Sample;

    #define EVAL_AT(T, OUT) do { \
      double __t = (T); \
      double __x = 0.0, __y = 0.0; \
      if (mode == RK_FUNCTION_K) { __x = __t; __y = TUR_APPLY1_T(double, double, curve, __t); } \
      else if (mode == RK_INVERSE_K) { __y = __t; __x = TUR_APPLY1_T(double, double, curve, __t); } \
      else if (mode == RK_PARAMETRIC_K) { \
        plot_eval_point(curve, __t, &__x, &__y); \
      } else { \
        double __radius = TUR_APPLY1_T(double, double, curve, __t); \
        __x = __radius * cos(__t); __y = __radius * sin(__t); \
      } \
      (OUT).t = __t; \
      if (ADAPTIVE_ISNAN(__x) || ADAPTIVE_ISNAN(__y)) { (OUT).valid = 0; (OUT).vx = 0.0; (OUT).vy = 0.0; } \
      else { \
        double __tx = (__x - bx_min) * inv_w; \
        double __ty = (__y - by_min) * inv_h; \
        (OUT).vx = left_d + __tx * pw_d; \
        (OUT).vy = top_d + ph_d - __ty * ph_d; \
        (OUT).valid = 1; \
      } \
    } while (0)

    int started = 0;
    #define EMIT(S) do { \
      if ((S).valid) { \
        if (!started) { plutovg_canvas_move_to(cv, (float)(S).vx, (float)(S).vy); started = 1; } \
        else { plutovg_canvas_line_to(cv, (float)(S).vx, (float)(S).vy); } \
      } else { \
        started = 0; \
      } \
    } while (0)

    typedef struct { Sample A, B; int depth; } Frame;
    Frame stack[MAX_DEPTH * 2 + 4];

    Sample prev; EVAL_AT(t_min, prev);
    EMIT(prev);

    for (int i = 0; i < n - 1; i++) {
      double tB = t_min + (t_max - t_min) * ((double)(i + 1) / (double)(n - 1));
      Sample A = prev;
      Sample B; EVAL_AT(tB, B);

      int sp = 0;
      stack[sp].A = A; stack[sp].B = B; stack[sp].depth = 0; sp++;

      while (sp > 0) {
        Frame f = stack[--sp];
        int subdivide = 0;
        Sample M; M.valid = 0; M.t = 0.0; M.vx = 0.0; M.vy = 0.0;
        double dx_ab = f.B.vx - f.A.vx;
        double dy_ab = f.B.vy - f.A.vy;
        double seg_len2 = dx_ab * dx_ab + dy_ab * dy_ab;
        int both_valid = f.A.valid && f.B.valid;

        if (f.depth < MAX_DEPTH && (!both_valid || seg_len2 > min_seg_px2)) {
          double tM = 0.5 * (f.A.t + f.B.t);
          EVAL_AT(tM, M);
          if (M.valid != f.A.valid || M.valid != f.B.valid) {
            /* Validity transition inside segment -> bisect to localize the gap. */
            subdivide = 1;
          } else if (both_valid && M.valid) {
            double v1x = M.vx - f.A.vx, v1y = M.vy - f.A.vy;
            double v2x = f.B.vx - M.vx, v2y = f.B.vy - M.vy;
            double l1 = v1x * v1x + v1y * v1y;
            double l2 = v2x * v2x + v2y * v2y;
            if (l1 > min_seg_px2 && l2 > min_seg_px2) {
              double dot = v1x * v2x + v1y * v2y;
              double denom = sqrt(l1 * l2);
              double cos_a = (denom > 0.0) ? (dot / denom) : 1.0;
              if (cos_a < cos_thresh) subdivide = 1;
            }
          }
        }

        if (subdivide) {
          /* Right then left so left pops first => emission is left-to-right. */
          stack[sp].A = M;   stack[sp].B = f.B; stack[sp].depth = f.depth + 1; sp++;
          stack[sp].A = f.A; stack[sp].B = M;   stack[sp].depth = f.depth + 1; sp++;
        } else {
          EMIT(f.B);
        }
      }

      prev = B;
    }

    if (started) plutovg_canvas_stroke(cv);

    #undef EVAL_AT
    #undef EMIT
    #undef ADAPTIVE_ISNAN
    ```)

  ;;; __store-f64 -- internal: write a double through a C out-pointer.
  (defn __store-f64 [p : ptr<void>  v : float] : void
    ```c *(double *)p = v; ```)

  ;;; __eval-point -- evaluate a curve callback for C: write f(t)'s x and y
  ;;; through `x-out` / `y-out` (double *). Pinned as `plot_eval_point` so the
  ;;; sampler and the parametric bands can call a Point-returning closure
  ;;; without naming the struct's C type.
  (defn (export-as "plot_eval_point")
        __eval-point [^fat f : (fn [float] Point)  t : float  x-out : ptr<void>  y-out : ptr<void>] : void
    (let [p (f t)]
      (__store-f64 x-out (.x p))
      (__store-f64 y-out (.y p))))

  ;;; __eval-vector -- evaluate a vector-field callback for C: write f(x, y)'s
  ;;; components through `dx-out` / `dy-out` (double *). Pinned as
  ;;; `plot_eval_vector`.
  (defn (export-as "plot_eval_vector")
        __eval-vector [^fat f : (fn [float float] Point)  x : float  y : float
                       dx-out : ptr<void>  dy-out : ptr<void>] : void
    (let [p (f x y)]
      (__store-f64 dx-out (.x p))
      (__store-f64 dy-out (.y p))))

  ;;; data->viewport -- map data coordinates to viewport coordinates.
  (defn data->viewport [x : float y : float bx-min : float bx-max : float
                        by-min : float by-max : float
                        px : int py : int pw : int ph : int] : int
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { double x; double y; } Pt;
    Pt *p = (Pt *)malloc(sizeof(*p));
    double tx = (x - bx_min) / (bx_max - bx_min);
    double ty = (y - by_min) / (by_max - by_min);
    p->x = (double)px + tx * (double)pw;
    p->y = (double)py + (1.0 - ty) * (double)ph;
    return (int64_t)(intptr_t)p;
    ```)

  ;;; viewport->data -- map viewport coordinates back to data coordinates.
  (defn viewport->data [vx : float vy : float bx-min : float bx-max : float
                        by-min : float by-max : float
                        px : int py : int pw : int ph : int] : int
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { double x; double y; } Pt;
    Pt *p = (Pt *)malloc(sizeof(*p));
    double tx = (vx - (double)px) / (double)pw;
    double ty = 1.0 - ((vy - (double)py) / (double)ph);
    p->x = bx_min + tx * (bx_max - bx_min);
    p->y = by_min + ty * (by_max - by_min);
    return (int64_t)(intptr_t)p;
    ```)

  ;;; BBox -- an axis-aligned data-space bounding box: what a renderer's
  ;;; `bounds` method returns and what the plot's data extent is folded from.
  ;;; An empty box -- a renderer that contributed no finite point -- is
  ;;; represented with `x-min` = NaN; use `bbox-empty?` to test for it.
  (defstruct BBox :copy [x-min : float  x-max : float  y-min : float  y-max : float])

  ;; Raw-carrier accessors over the { x0,x1,y0,y1; valid } buffer the C bounds
  ;; helpers below return.
  (defn __rbb-valid? [b : ptr<void>] : bool
    ```c return ((struct { double x0,x1,y0,y1; int valid; } *)b)->valid != 0; ```)
  (defn __rbb-get [b : ptr<void> which : int] : float
    ```c
    struct RBB { double x0,x1,y0,y1; int valid; } *p = (struct RBB *)b;
    switch ((int)which) { case 0: return p->x0; case 1: return p->x1;
                          case 2: return p->y0; default: return p->y1; }
    ```)
  (defn __rbb-free [b : ptr<void>] : void ```c free(b); ```)
  (defn __rbb-nan [] : float ```c return 0.0 / 0.0; ```)

  ;;; bbox-empty? -- true when a BBox carries no finite extent (x-min is NaN).
  (defn bbox-empty? [bb : BBox] : bool
    (let [lo (.x-min bb)] (not (= lo lo))))

  ;;; bbox-from-raw -- pack the raw { x0,x1,y0,y1; valid } carrier (as produced
  ;;; by the `__*-bbox` helpers) into a typed BBox with make-struct (so no
  ;;; struct-by-value crosses the inline-C boundary), freeing the carrier. An
  ;;; invalid carrier becomes an empty box (x-min = NaN).
  ;;;
  ;;; Defined ahead of its callers on purpose: a `defn` whose return type is an
  ;;; aggregate must be elaborated before the call site, or the caller sees the
  ;;; int64 carrier instead of `BBox` and trips TUR-E0709.
  (defn bbox-from-raw [b : ptr<void>] : BBox
    (if (__rbb-valid? b)
      (let [box (make-struct BBox (__rbb-get b 0) (__rbb-get b 1)
                                  (__rbb-get b 2) (__rbb-get b 3))]
        (do (__rbb-free b) box))
      (let [n   (__rbb-nan)
            box (make-struct BBox n n n n)]
        (do (__rbb-free b) box))))

  ;;; bbox-empty-box -- the identity element for `bbox-union`: an empty BBox
  ;;; (x-min = NaN), matching `bbox-empty?`.
  (defn bbox-empty-box [] : BBox
    (let [n (__rbb-nan)] (make-struct BBox n n n n)))

  ;;; bbox-union -- the smallest box covering both inputs; an empty box is the
  ;;; identity (so folding from `bbox-empty-box` recovers the first non-empty).
  ;;
  ;; On a tie the left box's coordinate is kept, as the draw pass's own union
  ;; once kept the first point it saw.
  (defn bbox-union [a : BBox  b : BBox] : BBox
    (if (bbox-empty? a) b
      (if (bbox-empty? b) a
        (make-struct BBox
          (if (< (.x-min b) (.x-min a)) (.x-min b) (.x-min a))
          (if (> (.x-max b) (.x-max a)) (.x-max b) (.x-max a))
          (if (< (.y-min b) (.y-min a)) (.y-min b) (.y-min a))
          (if (> (.y-max b) (.y-max a)) (.y-max b) (.y-max a))))))

  ;;; point-bbox -- the degenerate box of one data point; empty when either
  ;;; coordinate is NaN (a NaN point contributes nothing to the extent).
  (defn point-bbox [x : float  y : float] : BBox
    (if (or (not (= x x)) (not (= y y)))
      (bbox-empty-box)
      (make-struct BBox x x y y)))

  ;;; hint-bbox -- the box spanned by the corners (x0, y0) and (x1, y1) of an
  ;;; explicit domain, as the sampled-grid kinds (contours, vector fields)
  ;;; declare. Empty unless all four are finite numbers.
  (defn hint-bbox [x0 : float  x1 : float  y0 : float  y1 : float] : BBox
    (if (or (not (= x0 x0)) (not (= x1 x1)) (not (= y0 y0)) (not (= y1 y1)))
      (bbox-empty-box)
      (make-struct BBox (if (< x1 x0) x1 x0) (if (> x1 x0) x1 x0)
                        (if (< y1 y0) y1 y0) (if (> y1 y0) y1 y0))))

  ;; ---------------------------------------------------------------------------
  ;; Bounds of the lowered payloads. Each helper walks one payload shape's
  ;; Cells (see plot/data) and returns the raw { x0,x1,y0,y1; valid } carrier
  ;; (`bbox-from-raw` packs it); NaN points are skipped. These were the arms of the draw pass's old
  ;; per-kind bounds `switch`, moved verbatim -- a kind's `bounds` method now
  ;; picks its helper by type instead of by a `kind` tag.
  ;; ---------------------------------------------------------------------------

  ;;; __point-list-bbox -- bounding box of a cons-list of (cons x y) points: the
  ;;; rule shared by the lines / points / lines-interval kinds.
  (defn (export-as "plot_point_list_bbox") __point-list-bbox [points : Cells] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    for (Cons *p = (Cons *)(intptr_t)points; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *pt = (Cons *)(intptr_t)p->head;
      if (!pt) continue;
      double x = BITS_DBL(pt->head), y = BITS_DBL(pt->tail);
      if (ISNAN(x) || ISNAN(y)) continue;
      if (!lvalid) { lx0 = lx1 = x; ly0 = ly1 = y; lvalid = 1; }
      else { if (x < lx0) lx0 = x; if (x > lx1) lx1 = x;
             if (y < ly0) ly0 = y; if (y > ly1) ly1 = y; }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __error-bars-bbox -- bounding box of a cons-list of (x . (y . h)) error
  ;;; bars: each bar spans y +/- h, or x +/- h when `horizontal`.
  (defn __error-bars-bbox [bars : Cells  horizontal : bool] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    for (Cons *p = (Cons *)(intptr_t)bars; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *a = (Cons *)(intptr_t)p->head;
      if (!a) continue;
      double x = BITS_DBL(a->head);
      Cons *b = (Cons *)(intptr_t)a->tail;
      if (!b) continue;
      double y = BITS_DBL(b->head);
      double h = BITS_DBL(b->tail);
      if (horizontal) { UNION_POINT(x - h, y); UNION_POINT(x + h, y); }
      else { UNION_POINT(x, y - h); UNION_POINT(x, y + h); }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __arrows-bbox -- bounding box of a cons-list of (x1 . (y1 . (x2 . y2)))
  ;;; arrow segments: both endpoints of every arrow.
  ;;
  ;; The draw pass used to bound arrows with the point-list rule, reading each
  ;; arrow's second cell -- a pointer -- as its y coordinate, so the plot's
  ;; y range came out of the heap layout and changed from run to run.
  (defn __arrows-bbox [arrows : Cells] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    for (Cons *p = (Cons *)(intptr_t)arrows; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *a = (Cons *)(intptr_t)p->head;
      if (!a) continue;
      Cons *b = (Cons *)(intptr_t)a->tail;
      if (!b) continue;
      Cons *c = (Cons *)(intptr_t)b->tail;
      if (!c) continue;
      UNION_POINT(BITS_DBL(a->head), BITS_DBL(b->head));
      UNION_POINT(BITS_DBL(c->head), BITS_DBL(c->tail));
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __rects-bbox -- bounding box of a cons-list of (x0 . (x1 . (y0 . y1)))
  ;;; rectangles: the rectangles / area-histogram rule.
  (defn __rects-bbox [rects : Cells] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    for (Cons *p = (Cons *)(intptr_t)rects; p; p = (Cons *)(intptr_t)p->tail) {
      Cons *a = (Cons *)(intptr_t)p->head;
      if (!a) continue;
      double x0 = BITS_DBL(a->head);
      Cons *b = (Cons *)(intptr_t)a->tail;
      double x1 = BITS_DBL(b->head);
      Cons *c = (Cons *)(intptr_t)b->tail;
      double y0 = BITS_DBL(c->head);
      double y1 = BITS_DBL(c->tail);
      UNION_POINT(x0, y0);
      UNION_POINT(x1, y1);
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __discrete-hist-bbox -- bounding box of a cons-list of (label . height)
  ;;; bars laid out at category slots 0, 1, 2, ... (each 0.8 wide), rotated
  ;;; onto the y axis when `horizontal`.
  (defn __discrete-hist-bbox [bars : Cells  horizontal : bool] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    int idx = 0;
    for (Cons *p = (Cons *)(intptr_t)bars; p; p = (Cons *)(intptr_t)p->tail, idx++) {
      Cons *bar = (Cons *)(intptr_t)p->head;
      if (!bar) continue;
      double h = BITS_DBL(bar->tail);
      if (horizontal) { UNION_POINT(0.0, idx); UNION_POINT(h, idx + 0.8); }
      else { UNION_POINT(idx, 0.0); UNION_POINT(idx + 0.8, h); }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __stacked-hist-bbox -- bounding box of a cons-list of (label . values)
  ;;; groups: each slot is as tall as the sum of its stacked values.
  (defn __stacked-hist-bbox [groups : Cells  horizontal : bool] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { double x0, x1, y0, y1; int valid; } RBBox;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    RBBox *out = (RBBox *)malloc(sizeof(*out));
    double lx0 = 0.0, lx1 = 0.0, ly0 = 0.0, ly1 = 0.0;
    int lvalid = 0;
    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!lvalid) { lx0 = lx1 = __ux; ly0 = ly1 = __uy; lvalid = 1; } \
        else { \
          if (__ux < lx0) lx0 = __ux; \
          if (__ux > lx1) lx1 = __ux; \
          if (__uy < ly0) ly0 = __uy; \
          if (__uy > ly1) ly1 = __uy; \
        } \
      } \
    } while (0)
    int idx = 0;
    for (Cons *p = (Cons *)(intptr_t)groups; p; p = (Cons *)(intptr_t)p->tail, idx++) {
      Cons *grp = (Cons *)(intptr_t)p->head;
      double sum = 0.0;
      for (Cons *vals = (Cons *)(intptr_t)grp->tail; vals; vals = (Cons *)(intptr_t)vals->tail)
        sum += BITS_DBL(vals->head);
      if (horizontal) { UNION_POINT(0.0, idx); UNION_POINT(sum, idx + 0.8); }
      else { UNION_POINT(idx, 0.0); UNION_POINT(idx + 0.8, sum); }
    }
    out->x0 = lx0; out->x1 = lx1; out->y0 = ly0; out->y1 = ly1; out->valid = lvalid;
    return (void *)(intptr_t)out;
    #undef UNION_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;; The typed payloads' bounds: lower the Vec to Cells, run the shape's
  ;; helper above, free the Cells.

  ;;; __bbox-of-points -- the box of a (Vec Point), NaN points skipped.
  (defn __bbox-of-points [v : (Vec Point)] : BBox
    (let [cells (__points->cells v)
          bb    (bbox-from-raw (__point-list-bbox cells))]
      (__free-cells cells 1)
      bb))

  ;;; __bbox-of-error-bars -- the box spanning every bar's y +/- err (x +/- err
  ;;; when `horizontal`).
  (defn __bbox-of-error-bars [v : (Vec ErrorBar)  horizontal : bool] : BBox
    (let [cells (__error-bars->cells v)
          bb    (bbox-from-raw (__error-bars-bbox cells horizontal))]
      (__free-cells cells 2)
      bb))

  ;;; __bbox-of-arrows -- the box spanning both ends of every arrow.
  (defn __bbox-of-arrows [v : (Vec Arrow)] : BBox
    (let [cells (__arrows->cells v)
          bb    (bbox-from-raw (__arrows-bbox cells))]
      (__free-cells cells 3)
      bb))

  ;;; __bbox-of-rects -- the box spanning every rectangle.
  (defn __bbox-of-rects [v : (Vec Rect)] : BBox
    (let [cells (__rects->cells v)
          bb    (bbox-from-raw (__rects-bbox cells))]
      (__free-cells cells 3)
      bb))

  ;;; __bbox-of-bars -- the box of a discrete histogram's category slots.
  (defn __bbox-of-bars [v : (Vec Bar)  horizontal : bool] : BBox
    (let [cells (__bars->cells v)
          bb    (bbox-from-raw (__discrete-hist-bbox cells horizontal))]
      (__free-cells cells 1)
      bb))

  ;;; __bbox-of-groups -- the box of a stacked histogram's category slots.
  (defn __bbox-of-groups [v : (Vec Group)  horizontal : bool] : BBox
    (let [cells (__groups->cells v)
          bb    (bbox-from-raw (__stacked-hist-bbox cells horizontal))]
      (__free-groups cells)
      bb))

  ;; ===========================================================================
  ;; Renderer typeclass -- U2 renderer-kind collapse.
  ;;
  ;; Each renderer kind is its own type carrying its real fields (the types
  ;; live beside their constructors: LinesR and FunctionR in plot/line,
  ;; PointsR in plot/point, the Decoration sum type in plot/decor, ...), with
  ;; one `Renderer` instance per kind. The public constructors box their value
  ;; as an `AnyRenderer`, so a heterogeneous `(vec-of (axes) (lines ...))`
  ;; type-checks and every element still dispatches through its own instance.
  ;;
  ;; A plot is laid out over the union of the renderers' `bounds`, with the
  ;; axes and grids their `frame-marks` ask for and the category ticks of the
  ;; first `categorical?` renderer; then each renderer's `draw` paints it,
  ;; in order, and the legend lists every non-empty `legend-label`.
  ;; ===========================================================================

  ;;; DrawCtx -- one plot's draw context: the canvas, the resolved data bounds,
  ;;; the viewport rectangle, the loaded font, and the auto-color cursor the
  ;;; renderers advance as they take default colors. Created by the frame
  ;;; pass, threaded through every `draw`, released after the legend.
  (defopaque DrawCtx :ptr<void>)

  ;;; FrameMarks -- the axis lines and tick grids a renderer asks the frame for.
  (defstruct FrameMarks :copy [x-axis : bool  y-axis : bool  x-grid : bool  y-grid : bool])

  ;;; no-frame-marks -- FrameMarks asking for nothing; what most renderers want.
  (defn no-frame-marks [] : FrameMarks
    (make-struct FrameMarks false false false false))

  ;;; frame-marks-union -- the marks either side asks for.
  (defn frame-marks-union [a : FrameMarks  b : FrameMarks] : FrameMarks
    (make-struct FrameMarks (or (.x-axis a) (.x-axis b)) (or (.y-axis a) (.y-axis b))
                            (or (.x-grid a) (.x-grid b)) (or (.y-grid a) (.y-grid b))))

  ;;; __nonempty? -- is `s` a non-empty string?
  (defn __nonempty? [s : cstr] : bool
    ```c
    return s && s[0];
    ```)

  ;;; __one-label -- a fresh Vec holding `label`, or empty for "".
  (defn __one-label [label : cstr] : (Vec cstr)
    (let [v (:: (vec-new) (Vec cstr))]
      (when (__nonempty? label) (vec-push! v label))
      v))

  ;;; Renderer -- the class every plot renderer kind implements.
  ;;;
  ;;; Parameters:
  ;;;   a -- a renderer kind (LinesR, FunctionR, Decoration, ...)
  ;;;
  ;;; Methods:
  ;;;   bounds       -- the data-space extent the renderer needs on screen;
  ;;;                   empty (see `bbox-empty?`) when it constrains nothing,
  ;;;                   as a sampled curve or an axis does
  ;;;   draw         -- paint the renderer through the plot's DrawCtx
  ;;;   legend-label -- its legend entry; "" (the default) for none
  ;;;   legend-labels -- its legend entries, one row each, fresh (the caller
  ;;;                   frees the Vec); by default `legend-label`, or none
  ;;;                   when that is "". Row k's swatch is the style the
  ;;;                   renderer drew its series k with (`__ctx-series`)
  ;;;   frame-marks  -- the axes / grids it asks the frame for; none by default
  ;;;   categorical? -- whether it lays an axis out as categories; false
  ;;;                   by default
  ;;;   categories-on-y? -- whether a categorical renderer's categories run
  ;;;                   along the y axis (a horizontal histogram) rather
  ;;;                   than x; false by default
  ;;;   category-labels -- a categorical renderer's tick labels, fresh (the
  ;;;                   caller frees the Vec); empty by default
  ;;;
  ;;; Example:
  ;;;   (bounds (make-struct LinesR pts (default-line-style) "l"))
  ;;;
  ;;; Since: plot-v0.4.0
  (defclass Renderer [a]
    (bounds [r : a] : BBox)
    (draw [r : a  ctx : DrawCtx] : void)
    (legend-label [r : a] : cstr "")
    (legend-labels [r : a] : (Vec cstr) (__one-label (legend-label r)))
    (frame-marks [r : a] : FrameMarks (no-frame-marks))
    (categorical? [r : a] : bool false)
    (categories-on-y? [r : a] : bool false)
    (category-labels [r : a] : (Vec cstr) (:: (vec-new) (Vec cstr))))

  ;;; AnyRenderer -- a value of any `Renderer` kind, boxed with its instance.
  ;;; Every public constructor (`lines`, `function`, `axes`, ...) returns one,
  ;;; and `plot` / `plot-write-png` / `render` take a `(Vec AnyRenderer)`.
  (defalias AnyRenderer (exists [a] [(Renderer a)] a))

  ;;; any-renderer -- box a value whose type has a `Renderer` instance as an
  ;;; `AnyRenderer`. The `(exists ...)` form must appear literally at the pack
  ;;; site, so this is a macro (same reason as stdlib `showable`).
  ;;;
  ;;; Parameters:
  ;;;   x -- a renderer struct (LinesR, FunctionR, ...)
  ;;;
  ;;; Returns:
  ;;;   The value boxed with its `Renderer` instance, as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (any-renderer (make-struct LinesR pts (default-line-style) ""))
  (defmacro any-renderer [x] (list pack x (list exists [a] [(list Renderer a)] a)))

  ;;; renderer-bbox -- the data-space bounding box of one renderer.
  ;;;
  ;;; Parameters:
  ;;;   r -- any renderer, as a constructor returns it
  ;;;
  ;;; Returns:
  ;;;   Its `bounds`; an empty box (`bbox-empty?`) when it constrains nothing.
  ;;;
  ;;; Example:
  ;;;   (renderer-bbox (lines pts (default-line-style) ""))
  (defn renderer-bbox [r : AnyRenderer] : BBox
    (open r [a v] (bounds v)))

  ;; The folds below are top-level recursive defns rather than local `letrec`
  ;; closures: the compiler mallocs a letrec closure's env and, for a struct
  ;; argument, a box per call, and frees neither -- a leak on every `plot`.
  ;; A top-level defn passes `acc` by value and allocates nothing.

  ;;; __bbox-fold -- union the `bounds` of rs[i..n) into acc.
  (defn __bbox-fold [rs : (Vec AnyRenderer)  i : int  n : int  acc : BBox] : BBox
    (if (>= i n) acc
      (__bbox-fold rs (+ i 1) n
                   (bbox-union acc (open (vec-get rs i) [a v] (bounds v))))))

  ;;; renderers-bbox -- the data-space bounding box of a renderer Vec: the
  ;;; union of every element's `bounds`, each dispatched through the instance
  ;;; its `AnyRenderer` carries. This is the extent the plot is laid out over
  ;;; before padding and before `plot-opts` overrides.
  ;;;
  ;;; Parameters:
  ;;;   rs -- the renderers
  ;;;
  ;;; Returns:
  ;;;   The union of their bounds; empty when none constrains the extent.
  ;;;
  ;;; Example:
  ;;;   (renderers-bbox (vec-of (axes) (lines pts (default-line-style) "")))
  (defn renderers-bbox [rs : (Vec AnyRenderer)] : BBox
    (__bbox-fold rs 0 (vec-len rs) (bbox-empty-box)))

  ;; ---------------------------------------------------------------------------
  ;; Shared drawing helpers. Every kind's `draw` is inline C over a DrawCtx;
  ;; these are the pieces they share -- resolving a style handle onto the
  ;; canvas (taking the next auto color when the style says -1) and mapping a
  ;; data point into the viewport. Pinned to stable C symbols via `export-as`
  ;; so the per-kind inline C (in this module and the others) can call them.
  ;; ---------------------------------------------------------------------------

  ;;; __ctx-line-style -- install a line-style handle's color, alpha and width.
  (defn (export-as "plot_ctx_line_style") __ctx-line-style [ctx : ptr<void>  style : int] : void
    ```c
    #include <stddef.h>
    #include <stdint.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    extern void plutovg_canvas_set_line_width(void* canvas, float line_width);
    extern void plutovg_canvas_set_dash_array(void* canvas, const float* dashes, int ndashes);
    #endif
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void *plot_ctx_swatch(void *);
    typedef struct { int64_t color; double width; int64_t dash; double alpha; } LineStyle;
    static const double palette[8][3] = {
      {31.0/255.0, 119.0/255.0, 180.0/255.0},
      {214.0/255.0, 39.0/255.0, 40.0/255.0},
      {44.0/255.0, 160.0/255.0, 44.0/255.0},
      {255.0/255.0, 127.0/255.0, 14.0/255.0},
      {148.0/255.0, 103.0/255.0, 189.0/255.0},
      {140.0/255.0, 86.0/255.0, 75.0/255.0},
      {227.0/255.0, 119.0/255.0, 194.0/255.0},
      {127.0/255.0, 127.0/255.0, 127.0/255.0}
    };
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    void *canvas = dc->canvas;
    LineStyle *__ls = (LineStyle *)(intptr_t)(style);
    int __color = __ls ? (int)__ls->color : -1;
    if (__color < 0) __color = (int)((dc->auto_color++) % 8);
    __color %= 8; if (__color < 0) __color += 8;
    double __alpha = (__ls && __ls->alpha > 0.0) ? __ls->alpha : 1.0;
    double __width = (__ls && __ls->width > 0.0) ? __ls->width : 1.5;
    plutovg_canvas_set_rgba((plutovg_canvas_t *)canvas,
                            (float)palette[__color][0], (float)palette[__color][1],
                            (float)palette[__color][2], (float)__alpha);
    plutovg_canvas_set_line_width((plutovg_canvas_t *)canvas, (float)__width);
    plutovg_canvas_set_dash_array((plutovg_canvas_t *)canvas, NULL, 0);
    /* The first line style a series draws with is its legend swatch's. */
    PlotSwatch *sw = (PlotSwatch *)plot_ctx_swatch(dc);
    if (sw && !sw->has_line) {
      sw->has_line = 1; sw->line_color = __color;
      sw->line_alpha = __alpha; sw->line_width = __width;
    }
    ```)

  ;;; __ctx-fill-style -- install a fill-style handle's color and alpha.
  (defn (export-as "plot_ctx_fill_style") __ctx-fill-style [ctx : ptr<void>  style : int] : void
    ```c
    #include <stdint.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    #endif
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void *plot_ctx_swatch(void *);
    typedef struct { int64_t color; double alpha; int64_t line_color; double line_width; } FillStyle;
    static const double palette[8][3] = {
      {31.0/255.0, 119.0/255.0, 180.0/255.0},
      {214.0/255.0, 39.0/255.0, 40.0/255.0},
      {44.0/255.0, 160.0/255.0, 44.0/255.0},
      {255.0/255.0, 127.0/255.0, 14.0/255.0},
      {148.0/255.0, 103.0/255.0, 189.0/255.0},
      {140.0/255.0, 86.0/255.0, 75.0/255.0},
      {227.0/255.0, 119.0/255.0, 194.0/255.0},
      {127.0/255.0, 127.0/255.0, 127.0/255.0}
    };
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    FillStyle *__fs = (FillStyle *)(intptr_t)(style);
    int __color = __fs ? (int)__fs->color : -1;
    if (__color < 0) __color = (int)((dc->auto_color++) % 8);
    __color %= 8; if (__color < 0) __color += 8;
    double __alpha = (__fs && __fs->alpha > 0.0) ? __fs->alpha : 0.5;
    plutovg_canvas_set_rgba((plutovg_canvas_t *)dc->canvas,
                            (float)palette[__color][0], (float)palette[__color][1],
                            (float)palette[__color][2], (float)__alpha);
    /* The first fill a series draws with is its legend swatch's. */
    PlotSwatch *sw = (PlotSwatch *)plot_ctx_swatch(dc);
    if (sw && !sw->has_fill) {
      sw->has_fill = 1; sw->fill_color = __color; sw->fill_alpha = __alpha;
    }
    ```)

  ;;; __ctx-point-style -- resolve a point-style handle's stroke and fill palette
  ;;; indices into `stroke-out` / `fill-out` (int *).
  ;;;
  ;;; Each of the three style helpers also records the first style of its kind
  ;;; the renderer now drawing (`__ctx-drawing`) resolves -- auto colors
  ;;; included -- as that renderer's legend swatch.
  (defn (export-as "plot_ctx_point_style")
        __ctx-point-style [ctx : ptr<void>  style : int  stroke-out : ptr<void>  fill-out : ptr<void>] : void
    ```c
    #include <stdint.h>
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void *plot_ctx_swatch(void *);
    typedef struct { int64_t color; int64_t fill_color; int64_t sym; double size; double alpha; } PointStyle;
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    PointStyle *__ps = (PointStyle *)(intptr_t)(style);
    int __stroke = __ps ? (int)__ps->color : -1;
    if (__stroke < 0) __stroke = (int)((dc->auto_color++) % 8);
    __stroke %= 8; if (__stroke < 0) __stroke += 8;
    int __fill = (__ps && __ps->fill_color >= 0) ? (int)(__ps->fill_color % 8) : __stroke;
    if (stroke_out) *(int *)stroke_out = __stroke;
    if (fill_out) *(int *)fill_out = __fill;
    /* The first point style a series draws with is its legend swatch's. */
    PlotSwatch *sw = (PlotSwatch *)plot_ctx_swatch(dc);
    if (sw && !sw->has_point) {
      sw->has_point = 1; sw->point_stroke = __stroke; sw->point_fill = __fill;
      sw->point_sym = __ps ? __ps->sym : 0;
      sw->point_size = (__ps && __ps->size > 0.0) ? __ps->size : 6.0;
      sw->point_alpha = (__ps && __ps->alpha > 0.0) ? __ps->alpha : 1.0;
    }
    ```)

  ;;; __ctx-note-fill -- record palette color `color` at `alpha` as the
  ;;; drawing renderer's fill swatch, for a draw that fills without a
  ;;; FillStyle (the contour bands). Draws nothing.
  (defn (export-as "plot_ctx_note_fill")
        __ctx-note-fill [ctx : ptr<void>  color : int  alpha : float] : void
    ```c
    #include <stdint.h>
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void *plot_ctx_swatch(void *);
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    PlotSwatch *sw = (PlotSwatch *)plot_ctx_swatch(dc);
    if (sw && !sw->has_fill) {
      int c = (int)(color % 8); if (c < 0) c += 8;
      sw->has_fill = 1; sw->fill_color = c; sw->fill_alpha = alpha;
    }
    ```)

  ;;; __ctx-marker -- draw one point marker centered on viewport pixel
  ;;; (vx, vy): symbol `sym` (0 circle, 1 square, 2 triangle, 3 cross,
  ;;; 4 plus, 5 diamond) of width `size`, filled with palette color `fill` and
  ;;; outlined with `stroke`, both at `alpha`. `points` draws each point with
  ;;; it, and the legend its swatch.
  (defn (export-as "plot_ctx_marker")
        __ctx-marker [ctx : ptr<void>  vx : float  vy : float  stroke : int  fill : int
                      sym : int  size : float  alpha : float] : void
    ```c
    #include <stdint.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    extern void plutovg_canvas_set_line_width(void* canvas, float line_width);
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_rect(void* canvas, float x, float y, float w, float h);
    extern void plutovg_canvas_circle(void* canvas, float cx, float cy, float r);
    extern void plutovg_canvas_close_path(void* canvas);
    extern void plutovg_canvas_fill(void* canvas);
    extern void plutovg_canvas_stroke(void* canvas);
    #endif
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    static const double palette[8][3] = {
      {31.0/255.0, 119.0/255.0, 180.0/255.0},
      {214.0/255.0, 39.0/255.0, 40.0/255.0},
      {44.0/255.0, 160.0/255.0, 44.0/255.0},
      {255.0/255.0, 127.0/255.0, 14.0/255.0},
      {148.0/255.0, 103.0/255.0, 189.0/255.0},
      {140.0/255.0, 86.0/255.0, 75.0/255.0},
      {227.0/255.0, 119.0/255.0, 194.0/255.0},
      {127.0/255.0, 127.0/255.0, 127.0/255.0}
    };
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    int s8 = (int)(stroke % 8); if (s8 < 0) s8 += 8;
    int f8 = (int)(fill % 8); if (f8 < 0) f8 += 8;
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas,
                            (float)palette[f8][0], (float)palette[f8][1],
                            (float)palette[f8][2], (float)alpha);
    switch ((int)sym) {
      case 1: plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy - size / 2), (float)size, (float)size); break;
      case 2:
        plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy + size / 2));
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy + size / 2));
        plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
        break;
      case 5:
        plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)vy);
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy + size / 2));
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)vy);
        plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
        break;
      default: plutovg_canvas_circle((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy, (float)(size / 2)); break;
    }
    plutovg_canvas_fill((plutovg_canvas_t *)(intptr_t)canvas);
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas,
                            (float)palette[s8][0], (float)palette[s8][1],
                            (float)palette[s8][2], (float)alpha);
    plutovg_canvas_set_line_width((plutovg_canvas_t *)(intptr_t)canvas, 1.0f);
    if (sym == 3) {
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy - size / 2));
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy + size / 2));
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy + size / 2));
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy - size / 2));
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    } else if (sym == 4) {
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)vy);
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)vy);
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy + size / 2));
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    } else {
      switch ((int)sym) {
        case 1: plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy - size / 2), (float)size, (float)size); break;
        case 2:
          plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
          plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)(vy + size / 2));
          plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)(vy + size / 2));
          plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
          break;
        case 5:
          plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy - size / 2));
          plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx + size / 2), (float)vy);
          plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)(vy + size / 2));
          plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)(vx - size / 2), (float)vy);
          plutovg_canvas_close_path((plutovg_canvas_t *)(intptr_t)canvas);
          break;
        default: plutovg_canvas_circle((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy, (float)(size / 2)); break;
      }
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    }
    ```)

  ;;; __ctx-map -- map the data point (x, y) into viewport pixels, written to
  ;;; `vx-out` / `vy-out` (double *).
  (defn (export-as "plot_ctx_map")
        __ctx-map [ctx : ptr<void>  x : float  y : float  vx-out : ptr<void>  vy-out : ptr<void>] : void
    ```c
    #include <stdint.h>
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    double __tx = ((x) - dc->bx_min) / (dc->bx_max - dc->bx_min);
    double __ty = ((y) - dc->by_min) / (dc->by_max - dc->by_min);
    *(double *)vx_out = (double)dc->left + __tx * (double)dc->plot_w;
    *(double *)vy_out = (double)dc->bottom - __ty * (double)dc->plot_h;
    ```)

  ;; ---------------------------------------------------------------------------
  ;; The folds a plot makes over its renderers, each a top-level recursive
  ;; defn (a `letrec` closure leaked its env and a struct box per call). Every
  ;; element is opened and the method dispatched through its own instance.
  ;; ---------------------------------------------------------------------------

  ;;; __marks-fold -- union the `frame-marks` of rs[i..n) into acc.
  (defn __marks-fold [rs : (Vec AnyRenderer)  i : int  n : int  acc : FrameMarks] : FrameMarks
    (if (>= i n) acc
      (__marks-fold rs (+ i 1) n
                    (frame-marks-union acc (open (vec-get rs i) [a v] (frame-marks v))))))

  ;;; __first-categorical -- the index of the first `categorical?` renderer of
  ;;; rs[i..n), or -1.
  (defn __first-categorical [rs : (Vec AnyRenderer)  i : int  n : int] : int
    (if (>= i n) -1
      (if (open (vec-get rs i) [a v] (categorical? v))
        i
        (__first-categorical rs (+ i 1) n))))

  ;;; __draw-fold -- `draw` each of rs[i..n), in order, telling the DrawCtx
  ;;; which one is drawing so its legend swatch is recorded.
  (defn __draw-fold [rs : (Vec AnyRenderer)  ctx : DrawCtx  i : int  n : int] : int
    (if (>= i n)
      (do (__ctx-drawing ctx -1) n)
      (do (__ctx-drawing ctx i)
          (open (vec-get rs i) [a v] (draw v ctx))
          (__draw-fold rs ctx (+ i 1) n))))

  ;;; __legend-rows -- renderer i's legend rows for labels[k..m); `row` is
  ;;; the next row's index, and the result the one after the last drawn.
  (defn __legend-rows [ctx : DrawCtx  i : int  labels : (Vec cstr)  k : int  m : int  row : int] : int
    (if (>= k m) row
      (__legend-rows ctx i labels (+ k 1) m
                     (if (__legend-row ctx row i k (vec-get labels k))
                       (+ row 1)
                       row))))

  ;;; __legend-fold -- the legend rows of rs[i..n), each renderer's
  ;;; `legend-labels` in order; `row` is the next row's index.
  (defn __legend-fold [rs : (Vec AnyRenderer)  ctx : DrawCtx  i : int  n : int  row : int] : int
    (if (>= i n) row
      (let [labels (open (vec-get rs i) [a v] (legend-labels v))
            next   (__legend-rows ctx i labels 0 (vec-len labels) row)]
        (vec-free labels)
        (__legend-fold rs ctx (+ i 1) n next))))

  ;;; __null-ptr? -- is this a null pointer?
  (defn __null-ptr? [p : ptr<void>] : bool
    ```c return p == NULL; ```)

  ;;; plot-anyrenderers -- deprecated: `plot` takes a (Vec AnyRenderer) itself
  ;;; now. Kept for one release; call `plot`.
  (defn plot-anyrenderers [rs : (Vec AnyRenderer) opts : PlotOpts] : ptr<void>
    (plot rs opts))

  ;;; __surfaces-equal? -- true when two plutovg surfaces have identical
  ;;; dimensions and pixel bytes. Used to assert that the typed `AnyRenderer`
  ;;; draw path is pixel-identical to the legacy constructor path.
  (defn __surfaces-equal? [s1 : int s2 : int] : bool
    ```c
    #include <string.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern unsigned char* plutovg_surface_get_data(const void*);
    extern int plutovg_surface_get_width(const void*);
    extern int plutovg_surface_get_height(const void*);
    extern int plutovg_surface_get_stride(const void*);
    #endif
    if (!s1 || !s2) return false;
    const void *a = (const void *)(intptr_t)s1, *b = (const void *)(intptr_t)s2;
    int w = plutovg_surface_get_width(a), h = plutovg_surface_get_height(a);
    if (w != plutovg_surface_get_width(b) || h != plutovg_surface_get_height(b)) return false;
    int sa = plutovg_surface_get_stride(a), sb = plutovg_surface_get_stride(b);
    unsigned char *da = plutovg_surface_get_data((void *)a);
    unsigned char *db = plutovg_surface_get_data((void *)b);
    if (!da || !db) return false;
    for (int y = 0; y < h; y++) {
      if (memcmp(da + (size_t)y * sa, db + (size_t)y * sb, (size_t)w * 4) != 0) return false;
    }
    return true;
    ```)

  ;;; __plot-frame -- lay out and paint one plot's frame: background, border,
  ;;; ticks, grid, axes, title and axis labels, over the data extent the caller
  ;;; folded from the renderers' `bounds` (all NaN when nothing constrains it),
  ;;; the marks they asked for, and the category labels as ((label . 0) ...)
  ;;; Cells. Returns the DrawCtx (as a
  ;;; pointer) the renderers then draw through, or NULL when the viewport is
  ;;; too small to hold a plot.
  (defn __plot-frame [canvas : int  opts : PlotOpts  px : int  py : int  pw : int  ph : int
                      data-x-min : float  data-x-max : float  data-y-min : float  data-y-max : float
                      mark-x-axis : bool  mark-y-axis : bool  mark-x-grid : bool  mark-y-grid : bool
                      has-categories : bool  categories-on-y : bool  category-cells : Cells] : ptr<void>
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    #include <stdbool.h>
    #include <string.h>
    #include <stdio.h>
    #include <float.h>
    #include <unistd.h>
    extern double floor(double);
    extern double ceil(double);
    extern double log10(double);
    extern double pow(double, double);
    extern double sqrt(double);
    extern double cos(double);
    extern double sin(double);
    extern double atan2(double, double);
    extern double exp(double);
    extern double fabs(double);
    extern double fmin(double, double);
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_surface_t;
    typedef void plutovg_canvas_t;
    typedef void plutovg_font_face_t;
    typedef int plutovg_text_encoding_t;
    #define PLUTOVG_TEXT_ENCODING_UTF8 1
    extern void plutovg_surface_destroy(void* surface);
    extern void* plutovg_font_face_load_from_file(const char* filename, int ttcindex);
    extern void plutovg_font_face_destroy(void* face);
    extern void plutovg_canvas_save(void* canvas);
    extern void plutovg_canvas_restore(void* canvas);
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    extern void plutovg_canvas_set_font_face(void* canvas, void* face);
    extern void plutovg_canvas_set_font_size(void* canvas, float size);
    extern void plutovg_canvas_set_line_width(void* canvas, float line_width);
    extern void plutovg_canvas_set_dash_array(void* canvas, const float* dashes, int ndashes);
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_rect(void* canvas, float x, float y, float w, float h);
    extern void plutovg_canvas_circle(void* canvas, float cx, float cy, float r);
    extern void plutovg_canvas_close_path(void* canvas);
    extern void plutovg_canvas_fill(void* canvas);
    extern void plutovg_canvas_stroke(void* canvas);
    extern void plutovg_canvas_clip(void* canvas);
    extern void plutovg_canvas_fill_rect(void* canvas, float x, float y, float w, float h);
    extern float plutovg_canvas_fill_text(void* canvas, const void* text, int length,
                                          int encoding, float x, float y);
    #endif

    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    typedef struct {
      int64_t width; int64_t height;
      char *title; char *x_label; char *y_label;
      double x_min, x_max, y_min, y_max;
      int64_t legend_pos;
    } PlotOpts;


    #define ISNAN(v) ((v) != (v))

    double bx_min = 0.0, bx_max = 1.0, by_min = 0.0, by_max = 1.0;
    bool have_bounds = false;
    /* What the renderers ask of the frame, folded by the caller through the
       Renderer typeclass (`frame-marks`, `categorical?`, `categories-on-y?`,
       `category-labels`). Categories label the x axis, or the y axis for a
       horizontal histogram; the other axis keeps numeric ticks. */
    bool want_x_axis = mark_x_axis, want_y_axis = mark_y_axis;
    bool want_grid_x = mark_x_grid, want_grid_y = mark_y_grid;
    bool cat_x = has_categories && !categories_on_y;
    bool cat_y = has_categories && categories_on_y;
    int64_t categories = (int64_t)(intptr_t)category_cells;
    PlotOpts *po = (PlotOpts *)(intptr_t)opts;
    /* `legend-pos` 0 is no legend, as plot-opts documents; only a missing
       PlotOpts falls back to the top right. */
    int legend_pos = po ? (int)po->legend_pos : 1;
    int font_ok = 0;
    plutovg_font_face_t *font = NULL;
    const char *font_candidates[] = {
      "/System/Library/Fonts/Supplemental/Arial.ttf",
      "/System/Library/Fonts/Supplemental/Helvetica.ttf",
      "/System/Library/Fonts/Helvetica.ttc",
      "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
      "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
      "/usr/share/fonts/dejavu/DejaVuSans.ttf",
      NULL
    };
    for (int fi = 0; font_candidates[fi]; fi++) {
      if (access(font_candidates[fi], R_OK) == 0) {
        font = plutovg_font_face_load_from_file(font_candidates[fi], 0);
        if (font) { font_ok = 1; break; }
      }
    }

    #define UNION_POINT(X, Y) do { \
      double __ux = (X), __uy = (Y); \
      if (!ISNAN(__ux) && !ISNAN(__uy)) { \
        if (!have_bounds) { \
          bx_min = bx_max = __ux; \
          by_min = by_max = __uy; \
          have_bounds = true; \
        } else { \
          if (__ux < bx_min) bx_min = __ux; \
          if (__ux > bx_max) bx_max = __ux; \
          if (__uy < by_min) by_min = __uy; \
          if (__uy > by_max) by_max = __uy; \
        } \
      } \
    } while (0)

    /* The data extent: the union of every renderer's `bounds`, folded by the
       caller through the Renderer typeclass. An empty box is all NaN, which
       UNION_POINT skips. */
    UNION_POINT(data_x_min, data_y_min);
    UNION_POINT(data_x_max, data_y_max);

    if (!have_bounds) { bx_min = 0.0; bx_max = 1.0; by_min = 0.0; by_max = 1.0; }
    if (po) {
      if (!ISNAN(po->x_min)) bx_min = po->x_min;
      if (!ISNAN(po->x_max)) bx_max = po->x_max;
      if (!ISNAN(po->y_min)) by_min = po->y_min;
      if (!ISNAN(po->y_max)) by_max = po->y_max;
    }
    if (!(bx_max > bx_min)) { bx_min -= 1.0; bx_max += 1.0; }
    if (!(by_max > by_min)) { by_min -= 1.0; by_max += 1.0; }
    double padx = (bx_max - bx_min) * 0.05;
    double pady = (by_max - by_min) * 0.05;
    if (padx == 0.0) padx = 1.0;
    if (pady == 0.0) pady = 1.0;
    bx_min -= padx; bx_max += padx;
    by_min -= pady; by_max += pady;

    int left = px + 64;
    int right = px + pw - 24;
    int top = py + ((po && po->title) ? 44 : 24);
    int bottom = py + ph - ((po && (po->x_label || cat_x)) ? 58 : 44);
    int plot_w = right - left;
    int plot_h = bottom - top;
    if (plot_w < 32 || plot_h < 32) {
      if (font) plutovg_font_face_destroy(font);
      return NULL;
    }

    plutovg_canvas_save((plutovg_canvas_t *)(intptr_t)canvas);
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 1.0f, 1.0f, 1.0f, 1.0f);
    plutovg_canvas_fill_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)px, (float)py, (float)pw, (float)ph);
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.98f, 0.98f, 0.98f, 1.0f);
    plutovg_canvas_fill_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)top, (float)plot_w, (float)plot_h);
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.7f, 0.7f, 0.7f, 1.0f);
    plutovg_canvas_rect((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)top, (float)plot_w, (float)plot_h);
    plutovg_canvas_set_line_width((plutovg_canvas_t *)(intptr_t)canvas, 1.0f);
    plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);

    if (font_ok) {
      plutovg_canvas_set_font_face((plutovg_canvas_t *)(intptr_t)canvas, font);
      plutovg_canvas_set_font_size((plutovg_canvas_t *)(intptr_t)canvas, 12.0f);
    }

    int tick_n = 6;
    double x_ticks[32], y_ticks[32];
    const char *x_labels[32], *y_labels[32];
    /* The label text the two arrays point into.  Declared here, not in the
       blocks that fill them: x_labels outlives its block, and a buffer local
       to it was reused by the y block's, so every x tick was labelled with a
       y value. */
    char xbuf[32][64], ybuf[32][64];
    int x_count = 0, y_count = 0;

    /* Category ticks sit at slot centers, idx + 0.4. Each cell holds a
       bar (label . height) or a group (label . values), as the draw loop
       reads them; the label is that pair's head, not the pair -- printing
       the pair's address as text drew garbage. */
    if (cat_x) {
      int idx = 0;
      for (Cons *p = (Cons *)(intptr_t)categories; p && idx < 32; p = (Cons *)(intptr_t)p->tail, idx++) {
        Cons *bar = (Cons *)(intptr_t)p->head;
        x_ticks[idx] = (double)idx + 0.4;
        x_labels[idx] = bar ? (const char *)(intptr_t)bar->head : "";
      }
      x_count = idx;
    } else {
      double span = bx_max - bx_min;
      double raw = span / (double)(tick_n - 1);
      double mag = pow(10.0, floor(log10(raw)));
      double norm = raw / mag;
      double step = (norm < 1.5 ? 1.0 : (norm < 3.0 ? 2.0 : (norm < 7.0 ? 5.0 : 10.0))) * mag;
      double start = ceil(bx_min / step) * step;
      int prec = step >= 1.0 ? 2 : (int)ceil(-log10(step)) + 1;
      if (prec < 0) prec = 0; if (prec > 8) prec = 8;
      for (double v = start; v <= bx_max + step * 0.25 && x_count < 32; v += step) {
        x_ticks[x_count] = v;
        snprintf(xbuf[x_count], sizeof(xbuf[x_count]), "%.*f", prec, v);
        x_labels[x_count] = xbuf[x_count];
        x_count++;
      }
    }
    if (cat_y) {
      int idx = 0;
      for (Cons *p = (Cons *)(intptr_t)categories; p && idx < 32; p = (Cons *)(intptr_t)p->tail, idx++) {
        Cons *bar = (Cons *)(intptr_t)p->head;
        y_ticks[idx] = (double)idx + 0.4;
        y_labels[idx] = bar ? (const char *)(intptr_t)bar->head : "";
      }
      y_count = idx;
    } else {
      double span = by_max - by_min;
      double raw = span / (double)(tick_n - 1);
      double mag = pow(10.0, floor(log10(raw)));
      double norm = raw / mag;
      double step = (norm < 1.5 ? 1.0 : (norm < 3.0 ? 2.0 : (norm < 7.0 ? 5.0 : 10.0))) * mag;
      double start = ceil(by_min / step) * step;
      int prec = step >= 1.0 ? 2 : (int)ceil(-log10(step)) + 1;
      if (prec < 0) prec = 0; if (prec > 8) prec = 8;
      for (double v = start; v <= by_max + step * 0.25 && y_count < 32; v += step) {
        y_ticks[y_count] = v;
        snprintf(ybuf[y_count], sizeof(ybuf[y_count]), "%.*f", prec, v);
        y_labels[y_count] = ybuf[y_count];
        y_count++;
      }
    }

    if (!want_x_axis && by_min <= 0.0 && by_max >= 0.0) want_x_axis = true;
    if (!want_y_axis && bx_min <= 0.0 && bx_max >= 0.0) want_y_axis = true;

    if (want_grid_x || want_grid_y) {
      plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.90f, 0.90f, 0.90f, 1.0f);
      plutovg_canvas_set_line_width((plutovg_canvas_t *)(intptr_t)canvas, 1.0f);
      if (want_grid_x) for (int i = 0; i < x_count; i++) {
        double tx = (x_ticks[i] - bx_min) / (bx_max - bx_min);
        double vx = left + tx * plot_w;
        plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)top);
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)bottom);
      }
      if (want_grid_y) for (int i = 0; i < y_count; i++) {
        double ty = (y_ticks[i] - by_min) / (by_max - by_min);
        double vy = bottom - ty * plot_h;
        plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)vy);
        plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)right, (float)vy);
      }
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    }

    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.2f, 0.2f, 0.2f, 1.0f);
    if (want_x_axis) {
      double vy = bottom - ((0.0 - by_min) / (by_max - by_min)) * plot_h;
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)left, (float)vy);
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)right, (float)vy);
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    }
    if (want_y_axis) {
      double vx = left + ((0.0 - bx_min) / (bx_max - bx_min)) * plot_w;
      plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)top);
      plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)bottom);
      plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    }

    if (font_ok) {
      plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.15f, 0.15f, 0.15f, 1.0f);
      for (int i = 0; i < x_count; i++) {
        double tx = (x_ticks[i] - bx_min) / (bx_max - bx_min);
        double vx = left + tx * plot_w;
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 x_labels[i], (int)strlen(x_labels[i]),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(vx - 10.0), (float)(bottom + 18.0));
      }
      for (int i = 0; i < y_count; i++) {
        double ty = (y_ticks[i] - by_min) / (by_max - by_min);
        double vy = bottom - ty * plot_h;
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 y_labels[i], (int)strlen(y_labels[i]),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(left - 48.0), (float)(vy + 4.0));
      }
      if (po && po->title) {
        plutovg_canvas_set_font_size((plutovg_canvas_t *)(intptr_t)canvas, 16.0f);
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 po->title, (int)strlen(po->title),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)left, (float)(py + 24));
        plutovg_canvas_set_font_size((plutovg_canvas_t *)(intptr_t)canvas, 12.0f);
      }
      if (po && po->x_label) {
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 po->x_label, (int)strlen(po->x_label),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(left + plot_w / 2 - 20), (float)(py + ph - 16));
      }
      if (po && po->y_label) {
        plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas,
                                 po->y_label, (int)strlen(po->y_label),
                                 PLUTOVG_TEXT_ENCODING_UTF8,
                                 (float)(px + 8), (float)(top - 8));
      }
    }

    /* The frame is drawn. Hand the layout to the renderers' `draw` methods
       and the legend; `__ctx-finish` restores the canvas state saved above
       and releases the layout and the font. */
    PlotDrawCtx *dc = (PlotDrawCtx *)malloc(sizeof(*dc));
    if (!dc) {
      plutovg_canvas_restore((plutovg_canvas_t *)(intptr_t)canvas);
      if (font) plutovg_font_face_destroy(font);
      return NULL;
    }
    dc->canvas = (void *)(intptr_t)canvas;
    dc->bx_min = bx_min; dc->bx_max = bx_max; dc->by_min = by_min; dc->by_max = by_max;
    dc->left = left; dc->right = right; dc->top = top; dc->bottom = bottom;
    dc->plot_w = plot_w; dc->plot_h = plot_h;
    dc->font_ok = font_ok;
    dc->font = (void *)font;
    dc->legend_pos = legend_pos;
    dc->auto_color = 0;
    dc->swatches = NULL;
    dc->n_swatches = 0;
    dc->cur_swatch = -1;
    dc->cur_series = 0;
    dc->legend_x = 0.0;
    dc->legend_y = 0.0;
    return dc;
    #undef UNION_POINT
    #undef ISNAN
    ```)

  ;;; __ctx-track-renderers -- give the DrawCtx legend swatches for each of
  ;;; `n` renderers, one per series each draws, filled in as they draw (see
  ;;; `__ctx-drawing` and `__ctx-series`).
  (defn __ctx-track-renderers [ctx : DrawCtx  n : int] : void
    ```c
    #include <stdint.h>
    #include <stdlib.h>
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    if (n <= 0 || dc->swatches) return;
    dc->swatches = (PlotSeries *)calloc((size_t)n, sizeof(PlotSeries));
    dc->n_swatches = dc->swatches ? n : 0;
    ```)

  ;;; __ctx-drawing -- say which renderer (its index in the plot's Vec) is about
  ;;; to draw, so the style helpers record its swatch; -1 for none. It starts
  ;;; on series 0.
  (defn __ctx-drawing [ctx : DrawCtx  i : int] : void
    ```c
    #include <stdint.h>
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    dc->cur_swatch = i;
    dc->cur_series = 0;
    ```)

  ;;; __ctx-series -- say the drawing renderer now draws its series `k` (a
  ;;; stacked histogram's layer k): the style helpers record into that
  ;;; series' swatch, which is its k-th legend row's.
  (defn (export-as "plot_ctx_series") __ctx-series [ctx : ptr<void>  k : int] : void
    ```c
    #include <stdint.h>
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    dc->cur_series = k < 0 ? 0 : k;
    ```)

  ;;; __ctx-swatch -- the swatch of the drawing renderer's current series,
  ;;; added (empty) on first use; NULL when no renderer is drawing.
  (defn (export-as "plot_ctx_swatch") __ctx-swatch [ctx : ptr<void>] : ptr<void>
    ```c
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    if (!dc->swatches || dc->cur_swatch < 0 || dc->cur_swatch >= dc->n_swatches) return NULL;
    PlotSeries *se = &dc->swatches[dc->cur_swatch];
    int64_t k = dc->cur_series;
    if (k >= se->n) {
      PlotSwatch *items = (PlotSwatch *)realloc(se->items, (size_t)(k + 1) * sizeof(PlotSwatch));
      if (!items) return NULL;
      memset(items + se->n, 0, (size_t)(k + 1 - se->n) * sizeof(PlotSwatch));
      se->items = items;
      se->n = k + 1;
    }
    return &se->items[k];
    ```)

  ;;; __ctx-swatch-at -- renderer `i`'s series `k` swatch, or NULL when it
  ;;; recorded none.
  (defn (export-as "plot_ctx_swatch_at") __ctx-swatch-at [ctx : ptr<void>  i : int  k : int] : ptr<void>
    ```c
    #include <stdint.h>
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)ctx;
    if (!dc->swatches || i < 0 || i >= dc->n_swatches) return NULL;
    PlotSeries *se = &dc->swatches[i];
    if (k < 0 || k >= se->n) return NULL;
    return &se->items[k];
    ```)

  ;;; __ctx-clip-begin -- clip drawing to the viewport, as the renderers draw.
  (defn __ctx-clip-begin [ctx : DrawCtx] : void
    ```c
    #include <stdint.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_save(void* canvas);
    extern void plutovg_canvas_rect(void* canvas, float x, float y, float w, float h);
    extern void plutovg_canvas_clip(void* canvas);
    #endif
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    plutovg_canvas_save((plutovg_canvas_t *)dc->canvas);
    plutovg_canvas_rect((plutovg_canvas_t *)dc->canvas, (float)dc->left, (float)dc->top,
                        (float)dc->plot_w, (float)dc->plot_h);
    plutovg_canvas_clip((plutovg_canvas_t *)dc->canvas);
    ```)

  ;;; __ctx-clip-end -- lift the viewport clip.
  (defn __ctx-clip-end [ctx : DrawCtx] : void
    ```c
    #include <stdint.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_restore(void* canvas);
    #endif
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    plutovg_canvas_restore((plutovg_canvas_t *)dc->canvas);
    ```)

  ;;; __legend-begin -- select the legend font, when there is a legend to draw.
  (defn __legend-begin [ctx : DrawCtx] : void
    ```c
    #include <stdint.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_set_font_face(void* canvas, void* face);
    extern void plutovg_canvas_set_font_size(void* canvas, float size);
    #endif
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    if (!(dc->font_ok && dc->legend_pos != 0)) return;
    plutovg_canvas_set_font_face((plutovg_canvas_t *)dc->canvas, dc->font);
    plutovg_canvas_set_font_size((plutovg_canvas_t *)dc->canvas, 12.0f);
    ```)

  ;;; __ctx-text-width -- the advance width of `text` in the legend's font, in
  ;;; pixels; 0 with no font. Call after `__legend-begin` has set the font.
  (defn __ctx-text-width [ctx : DrawCtx  text : cstr] : float
    ```c
    #include <stdint.h>
    #include <string.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    typedef struct { float x, y, w, h; } plutovg_rect_t;
    #define PLUTOVG_TEXT_ENCODING_UTF8 1
    extern float plutovg_canvas_text_extents(void* canvas, const void* text, int length,
                                             int encoding, plutovg_rect_t* extents);
    #endif
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    if (!dc->font_ok || !text || !text[0]) return 0.0;
    plutovg_rect_t r;
    return (double)plutovg_canvas_text_extents((plutovg_canvas_t *)dc->canvas, text, (int)strlen(text),
                                               PLUTOVG_TEXT_ENCODING_UTF8, &r);
    ```)

  ;;; LegendSize -- how many legend rows a plot has, and its widest label.
  (defstruct LegendSize :copy [rows : int  width : float])

  ;;; __legend-size-rows -- `acc` grown by the non-empty labels[k..m).
  (defn __legend-size-rows [ctx : DrawCtx  labels : (Vec cstr)  k : int  m : int
                            acc : LegendSize] : LegendSize
    (if (>= k m) acc
      (let [label (vec-get labels k)
            w     (__ctx-text-width ctx label)]
        (__legend-size-rows ctx labels (+ k 1) m
                            (if (__nonempty? label)
                              (LegendSize (+ (.rows acc) 1) (if (> w (.width acc)) w (.width acc)))
                              acc)))))

  ;;; __legend-size -- the legend rows of rs[i..n) and their widest label,
  ;;; folded into `acc`; the same rows `__legend-fold` draws.
  (defn __legend-size [rs : (Vec AnyRenderer)  ctx : DrawCtx  i : int  n : int
                       acc : LegendSize] : LegendSize
    (if (>= i n) acc
      (let [labels (open (vec-get rs i) [a v] (legend-labels v))
            next   (__legend-size-rows ctx labels 0 (vec-len labels) acc)]
        (vec-free labels)
        (__legend-size rs ctx (+ i 1) n next))))

  ;;; __legend-box -- lay the legend out for `rows` rows whose widest label is
  ;;; `width` pixels, and draw its backing: a translucent white box with a
  ;;; light border, so the rows read over whatever the plot drew there. A
  ;;; right-hand legend moves left to keep a long label inside the plot, and
  ;;; a bottom one stacks upward from the bottom edge.
  (defn __legend-box [ctx : DrawCtx  rows : int  width : float] : void
    ```c
    #include <stdint.h>
    #include <stdbool.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    extern void plutovg_canvas_set_line_width(void* canvas, float line_width);
    extern void plutovg_canvas_round_rect(void* canvas, float x, float y, float w, float h, float rx, float ry);
    extern void plutovg_canvas_fill_preserve(void* canvas);
    extern void plutovg_canvas_stroke(void* canvas);
    #endif
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int pos = (int)dc->legend_pos;
    bool left_side = (pos == 2 || pos == 4);
    double w = 18.0 + width;              /* swatch, gap, label */
    double lx = left_side ? dc->left + 12.0 : dc->right - 120.0;
    if (!left_side && lx + w > dc->right - 12.0) lx = dc->right - 12.0 - w;
    if (lx < dc->left + 12.0) lx = dc->left + 12.0;
    double y0 = (pos == 3 || pos == 4) ? dc->bottom - 16.0 - (rows > 0 ? rows - 1 : 0) * 16.0
                                       : dc->top + 16.0;
    dc->legend_x = lx;
    dc->legend_y = y0;
    if (!(dc->font_ok && pos != 0) || rows <= 0) return;
    plutovg_canvas_t *cv = (plutovg_canvas_t *)dc->canvas;
    plutovg_canvas_round_rect(cv, (float)(lx - 6.0), (float)(y0 - 10.0),
                              (float)(w + 12.0), (float)((rows - 1) * 16.0 + 20.0), 3.0f, 3.0f);
    plutovg_canvas_set_rgba(cv, 1.0f, 1.0f, 1.0f, 0.85f);
    plutovg_canvas_fill_preserve(cv);
    plutovg_canvas_set_rgba(cv, 0.75f, 0.75f, 0.75f, 1.0f);
    plutovg_canvas_set_line_width(cv, 1.0f);
    plutovg_canvas_stroke(cv);
    ```)

  ;;; __legend-row -- draw legend row `row`: the swatch of renderer `index`'s
  ;;; series `series`, and `label`. The swatch is what that series drew with -- its point marker,
  ;;; else its fill as a box (edged top and bottom in its line style, as an
  ;;; interval band is), else a stroke of its line style; a renderer that
  ;;; recorded no style gets none. Returns false, drawing nothing, for an
  ;;; empty label or when there is no legend (no font, or `legend-pos` 0).
  (defn __legend-row [ctx : DrawCtx  row : int  index : int  series : int  label : cstr] : bool
    ```c
    #include <stdint.h>
    #include <string.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    #define PLUTOVG_TEXT_ENCODING_UTF8 1
    extern void plutovg_canvas_set_rgba(void* canvas, float r, float g, float b, float a);
    extern void plutovg_canvas_set_line_width(void* canvas, float line_width);
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_rect(void* canvas, float x, float y, float w, float h);
    extern void plutovg_canvas_fill(void* canvas);
    extern void plutovg_canvas_stroke(void* canvas);
    extern float plutovg_canvas_fill_text(void* canvas, const void* text, int length,
                                          int encoding, float x, float y);
    #endif
    extern void plot_ctx_marker(void *, double, double, int64_t, int64_t, int64_t, double, double);
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    extern void *plot_ctx_swatch_at(void *, int64_t, int64_t);
    static const double palette[8][3] = {
      {31.0/255.0, 119.0/255.0, 180.0/255.0},
      {214.0/255.0, 39.0/255.0, 40.0/255.0},
      {44.0/255.0, 160.0/255.0, 44.0/255.0},
      {255.0/255.0, 127.0/255.0, 14.0/255.0},
      {148.0/255.0, 103.0/255.0, 189.0/255.0},
      {140.0/255.0, 86.0/255.0, 75.0/255.0},
      {227.0/255.0, 119.0/255.0, 194.0/255.0},
      {127.0/255.0, 127.0/255.0, 127.0/255.0}
    };
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    int legend_pos = (int)dc->legend_pos;
    if (!(dc->font_ok && legend_pos != 0)) return false;
    if (!label || !label[0]) return false;
    /* Where `__legend-box` laid the legend out: row 0 at legend_y. */
    double lx = dc->legend_x;
    double y = dc->legend_y + row * 16.0;
    PlotSwatch *sw = (PlotSwatch *)plot_ctx_swatch_at(dc, index, series);
    plutovg_canvas_t *cv = (plutovg_canvas_t *)(intptr_t)canvas;
    if (sw && sw->has_point) {
      double size = sw->point_size > 10.0 ? 10.0 : sw->point_size;
      plot_ctx_marker(dc, lx + 6.0, y, sw->point_stroke, sw->point_fill,
                      sw->point_sym, size, sw->point_alpha);
    } else if (sw && sw->has_fill) {
      int c = (int)sw->fill_color;
      plutovg_canvas_set_rgba(cv, (float)palette[c][0], (float)palette[c][1],
                              (float)palette[c][2], (float)sw->fill_alpha);
      plutovg_canvas_rect(cv, (float)lx, (float)(y - 4.0), 12.0f, 8.0f);
      plutovg_canvas_fill(cv);
      if (sw->has_line) {
        int lc = (int)sw->line_color;
        double w = sw->line_width > 3.0 ? 3.0 : sw->line_width;
        plutovg_canvas_set_rgba(cv, (float)palette[lc][0], (float)palette[lc][1],
                                (float)palette[lc][2], (float)sw->line_alpha);
        plutovg_canvas_set_line_width(cv, (float)w);
        plutovg_canvas_move_to(cv, (float)lx, (float)(y - 4.0));
        plutovg_canvas_line_to(cv, (float)(lx + 12.0), (float)(y - 4.0));
        plutovg_canvas_move_to(cv, (float)lx, (float)(y + 4.0));
        plutovg_canvas_line_to(cv, (float)(lx + 12.0), (float)(y + 4.0));
        plutovg_canvas_stroke(cv);
      }
    } else if (sw && sw->has_line) {
      int lc = (int)sw->line_color;
      double w = sw->line_width > 4.0 ? 4.0 : sw->line_width;
      plutovg_canvas_set_rgba(cv, (float)palette[lc][0], (float)palette[lc][1],
                              (float)palette[lc][2], (float)sw->line_alpha);
      plutovg_canvas_set_line_width(cv, (float)w);
      plutovg_canvas_move_to(cv, (float)lx, (float)y);
      plutovg_canvas_line_to(cv, (float)(lx + 12.0), (float)y);
      plutovg_canvas_stroke(cv);
    }
    plutovg_canvas_set_rgba((plutovg_canvas_t *)(intptr_t)canvas, 0.15f, 0.15f, 0.15f, 1.0f);
    plutovg_canvas_fill_text((plutovg_canvas_t *)(intptr_t)canvas, label, (int)strlen(label),
                             PLUTOVG_TEXT_ENCODING_UTF8, (float)(lx + 18.0), (float)(y + 4.0));
    return true;
    ```)

  ;;; __ctx-finish -- hand the canvas back in the state the frame found it
  ;;; (undoing its save), then release a DrawCtx, its swatches and its font.
  (defn __ctx-finish [ctx : DrawCtx] : void
    ```c
    #include <stdint.h>
    #include <stdlib.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    extern void plutovg_font_face_destroy(void* face);
    extern void plutovg_canvas_restore(void* canvas);
    #endif
    typedef struct PlotSwatch {
      int64_t has_line, line_color;
      double line_alpha, line_width;
      int64_t has_fill, fill_color;
      double fill_alpha;
      int64_t has_point, point_stroke, point_fill, point_sym;
      double point_size, point_alpha;
    } PlotSwatch;
    typedef struct PlotSeries { PlotSwatch *items; int64_t n; } PlotSeries;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
      PlotSeries *swatches;
      int64_t n_swatches;
      int64_t cur_swatch;
      int64_t cur_series;
      double legend_x, legend_y;
    } PlotDrawCtx;
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    if (!dc) return;
    plutovg_canvas_restore(dc->canvas);
    if (dc->font) plutovg_font_face_destroy(dc->font);
    for (int64_t i = 0; i < dc->n_swatches; i++) free(dc->swatches[i].items);
    free(dc->swatches);
    free(dc);
    ```)

  ;;; plot-into-canvas -- render renderers into an existing canvas and viewport.
  ;;;
  ;;; The data extent is the union of the renderers' `bounds` (padded 5%, and
  ;;; overridden per side by `opts`); the frame draws the axes and grids their
  ;;; `frame-marks` ask for, with category ticks from the first
  ;;; `categorical?` renderer's `category-labels`; then each renderer's `draw`
  ;;; paints it, in order, clipped to the viewport, and the legend lists their
  ;;; `legend-label`s.
  ;;;
  ;;; Parameters:
  ;;;   canvas    -- the plutovg canvas to draw into
  ;;;   renderers -- the renderers, as the constructors return them
  ;;;   opts      -- the plot's PlotOpts
  ;;;   px py     -- the viewport's top-left corner, in canvas pixels
  ;;;   pw ph     -- the viewport's size, in canvas pixels
  ;;;
  ;;; Returns:
  ;;;   ok 0, or err 1 when the viewport is too small to hold a plot.
  ;;;
  ;;; Example:
  ;;;   (plot-into-canvas canvas (vec-of (axes) (lines pts ls "")) opts 0 0 600 450)
  (defn plot-into-canvas [canvas : int  renderers : (Vec AnyRenderer)  opts : PlotOpts
                          px : int  py : int  pw : int  ph : int] : ptr<void>
    (let [n      (vec-len renderers)
          bb     (renderers-bbox renderers)
          marks  (__marks-fold renderers 0 n (no-frame-marks))
          ci     (__first-categorical renderers 0 n)
          on-y   (if (>= ci 0)
                   (open (vec-get renderers ci) [a v] (categories-on-y? v))
                   false)
          labels (if (>= ci 0)
                   (open (vec-get renderers ci) [a v] (category-labels v))
                   (:: (vec-new) (Vec cstr)))
          cells  (__labels->cells labels)
          raw    (__plot-frame canvas opts px py pw ph
                               (.x-min bb) (.x-max bb) (.y-min bb) (.y-max bb)
                               (.x-axis marks) (.y-axis marks) (.x-grid marks) (.y-grid marks)
                               (>= ci 0) on-y cells)]
      ;; The frame has drawn the category ticks; their cells and labels go.
      (__free-cells cells 1)
      (vec-free labels)
      (if (__null-ptr? raw)
        (__err 1)
        (let [ctx (:: raw DrawCtx)]
          (__ctx-track-renderers ctx n)
          (__ctx-clip-begin ctx)
          (__draw-fold renderers ctx 0 n)
          (__ctx-clip-end ctx)
          (__legend-begin ctx)
          (let [size (__legend-size renderers ctx 0 n (LegendSize 0 0.0))]
            (__legend-box ctx (.rows size) (.width size)))
          (__legend-fold renderers ctx 0 n 0)
          (__ctx-finish ctx)
          (__ok 0)))))

  ;; ---------------------------------------------------------------------------
  ;; Backend -- the output target a plot renders to (U2 typeclass collapse).
  ;;
  ;; The three legacy entrypoints (`plot-into-canvas`, `plot`, `plot-write-png`)
  ;; differed only in *where* the same renderer Vec lands: an existing canvas, a
  ;; fresh surface, or a PNG file. They are now one method, `render-to`, with
  ;; one instance per target, so plot-building code can be written generic over
  ;; the destination and a new sink (e.g. a notebook-inline backend) becomes a
  ;; new instance rather than a new top-level function.
  ;;
  ;; Named `Backend`, not the uplift plan's "Renderer": in this spice a
  ;; "renderer" is a drawable element (the `renderers` Vec), and `Renderer` is
  ;; the class those elements implement. The concept the plan means here is
  ;; the output backend.
  ;;
  ;; `render-to` returns the same :ptr<void> result envelope the legacy
  ;; entrypoints did: ok-val carries the new surface handle for SurfaceBackend,
  ;; 0 for the canvas/PNG sinks; err-val carries the failure code.
  ;; ---------------------------------------------------------------------------
  (defclass Backend [b]
    (render-to [self : b  renderers : (Vec AnyRenderer)  opts : PlotOpts] : ptr<void>))

  ;; CanvasBackend -- draw into an existing canvas at the given viewport.
  (defstruct CanvasBackend [canvas : int  px : int  py : int  pw : int  ph : int])

  ;; SurfaceBackend -- allocate a fresh surface and return it (caller owns).
  ;; A width/height of 0 falls back to the opts dimensions (or 600x450).
  (defstruct SurfaceBackend [width : int  height : int])

  ;; PngBackend -- render to a fresh surface and write it to `path` as PNG.
  (defstruct PngBackend [path : cstr])

  ;; CanvasBackend delegates straight to the inline-C drawing worker.
  (definstance Backend [CanvasBackend]
    (render-to [self renderers opts]
      (plot-into-canvas (.canvas self) renderers opts
                        (.px self) (.py self) (.pw self) (.ph self))))

  ;; SurfaceBackend allocates the surface + canvas, then dispatches the draw
  ;; through CanvasBackend and hands the surface back on success.
  (definstance Backend [SurfaceBackend]
    (render-to [self renderers opts]
      (let [w  (if (> (.width self) 0) (.width self)
                 (if (> (plot-opts-width opts) 0) (plot-opts-width opts) 600))
            h  (if (> (.height self) 0) (.height self)
                 (if (> (plot-opts-height opts) 0) (plot-opts-height opts) 450))
            sr (__surface-create w h)]
        (if (__ok? sr)
          (let [surface (__ok-val sr)
                cr      (__canvas-create surface)]
            (if (__ok? cr)
              (let [canvas (__ok-val cr)
                    rr (render-to (make-struct CanvasBackend canvas 0 0 w h)
                                  renderers opts)]
                (__canvas-destroy canvas)
                (if (__ok? rr)
                  (__ok surface)
                  (do
                    (__surface-destroy surface)
                    (__err (__err-val rr)))))
              (__err (__err-val cr))))
          (__err (__err-val sr))))))

  ;; PngBackend renders through SurfaceBackend, then writes + frees the surface.
  (definstance Backend [PngBackend]
    (render-to [self renderers opts]
      (let [r (render-to (make-struct SurfaceBackend 0 0) renderers opts)]
        (if (__ok? r)
          (let [s  (__ok-val r)
                wr (__surface-write-png s (.path self))]
            (__surface-destroy s)
            wr)
          (__err (__err-val r))))))

  ;;; render -- draw `renderers` to any Backend, generic over the sink.
  ;;;
  ;;; This is the plan's "the plot DSL becomes generic in Backend": one entry
  ;;; point polymorphic over the output target, so a caller can hold a backend
  ;;; value and dispatch to the right instance regardless of concrete type.
  ;;; `plot`, `plot-write-png`, and `plot-into-canvas` are the convenience
  ;;; monomorphic wrappers; `render` is the generic form.
  ;;;
  ;;; Example:
  ;;;   (render (make-struct PngBackend "out.png") rs opts)
  ;;;   (render (make-struct SurfaceBackend 0 0)   rs opts)
  (defn render [^Backend B b : B  renderers : (Vec AnyRenderer)  opts : PlotOpts] : ptr<void>
    (render-to b renderers opts))

  ;;; plot -- render renderers to a new surface and return it.
  ;;;
  ;;; renderers is a (Vec AnyRenderer): build it with vec-of over the
  ;;; constructors, or vec-new + vec-push!. (It was a (Vec int) of slot-bag
  ;;; handles through 0.4.0, and a cons list before 0.2.0.)
  ;;;
  ;;; Thin wrapper over the `Backend` dispatch (the `SurfaceBackend` instance);
  ;;; equivalent to `(render-to (make-struct SurfaceBackend 0 0) renderers opts)`.
  (defn plot [renderers : (Vec AnyRenderer) opts : PlotOpts] : ptr<void>
    (render-to (make-struct SurfaceBackend 0 0) renderers opts))

  ;;; plot-write-png -- render renderers and write them to a PNG file.
  ;;;
  ;;; renderers is a (Vec AnyRenderer), as for `plot`.
  ;;;
  ;;; Thin wrapper over the `Backend` dispatch (the `PngBackend` instance);
  ;;; equivalent to `(render-to (make-struct PngBackend path) renderers opts)`.
  (defn plot-write-png [renderers : (Vec AnyRenderer) opts : PlotOpts path : cstr] : ptr<void>
    (render-to (make-struct PngBackend path) renderers opts))

) ;; end defmodule plot/core
