;; plot/line.tur -- line-like renderers.
;;
;; The sampled-curve renderers (function, parametric, polar, inverse) use the
;; adaptive subdivision sampler from plot/core: `samples` sets the uniform
;; baseline, and segments are bisected (up to depth 6) when adjacent
;; screen-space sub-segments turn sharply or cross a NaN/non-NaN boundary.
;; `lines` draws the caller's polyline as-is and retains NaN-as-gap behavior.
;;
;; Each kind is a struct with a `Renderer` instance; the constructors box it as
;; an `AnyRenderer`. A curve callback is any function value of the declared
;; type -- a named `defn` or a `fn` literal, capturing or not.

(defmodule plot/line
  (export function lines parametric polar inverse density
          LinesR FunctionR ParametricR PolarR InverseR DensityR)

  (import plot/core  :refer [BBox bbox-empty-box __bbox-of-points any-renderer DrawCtx])
  (import plot/style :refer [LineStyle])
  (import plot/data  :refer [Point Cells __points->cells __values->cells __free-cells])

  ;;; LinesR -- a polyline through its points, in order.
  (defstruct LinesR :copy [points : (Vec Point)  style : LineStyle  label : cstr])

  ;;; FunctionR -- y = f(x), sampled over [x-min, x-max].
  (defstruct FunctionR :copy [f : (fn [float] float)  x-min : float  x-max : float
                              samples : int  style : LineStyle  label : cstr])

  ;;; ParametricR -- the point f(t), sampled over [t-min, t-max].
  (defstruct ParametricR :copy [f : (fn [float] Point)  t-min : float  t-max : float
                                samples : int  style : LineStyle  label : cstr])

  ;;; PolarR -- radius = f(theta), sampled over [theta-min, theta-max].
  (defstruct PolarR :copy [f : (fn [float] float)  theta-min : float  theta-max : float
                           samples : int  style : LineStyle  label : cstr])

  ;;; InverseR -- x = f(y), sampled over [y-min, y-max].
  (defstruct InverseR :copy [f : (fn [float] float)  y-min : float  y-max : float
                             samples : int  style : LineStyle  label : cstr])

  ;;; DensityR -- a Gaussian kernel density estimate of its sample values; a
  ;;; `bandwidth` of 0 picks Silverman's rule.
  (defstruct DensityR :copy [values : (Vec float)  bandwidth : float  samples : int
                             style : LineStyle  label : cstr])

  ;; Drawing: a polyline is stroked as given (broken at NaN); the sampled
  ;; curves go through plot/core's adaptive sampler; a density is its kernel
  ;; estimate evaluated across the plot's x extent.

  ;;; __draw-lines -- stroke a polyline through lowered points, breaking at NaN.
  (defn __draw-lines [ctx : DrawCtx  points : Cells  style : LineStyle] : void
    ```c
    #include <stddef.h>
    #include <stdint.h>
    #include <stdbool.h>
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_stroke(void* canvas);
    #endif
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    #define ISNAN(v) ((v) != (v))
    extern void plot_ctx_line_style(void *, int64_t);
    #define SET_LINE_STYLE(H, R) plot_ctx_line_style(dc, (int64_t)(intptr_t)(H))
    extern void plot_ctx_map(void *, double, double, void *, void *);
    #define MAP_POINT(X, Y, VX, VY) plot_ctx_map(dc, (X), (Y), (VX), (VY))
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    do {
      SET_LINE_STYLE(style, ((int *)0));
      bool have = false; double px0 = 0.0, py0 = 0.0; (void)px0; (void)py0;
      for (Cons *p = (Cons *)(intptr_t)points; p; p = (Cons *)(intptr_t)p->tail) {
        Cons *pt = (Cons *)(intptr_t)p->head;
        if (!pt) continue;
        double x = BITS_DBL(pt->head), y = BITS_DBL(pt->tail);
        if (ISNAN(x) || ISNAN(y)) { have = false; continue; }
        double vx, vy; MAP_POINT(x, y, &vx, &vy);
        if (!have) plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
        else plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
        px0 = vx; py0 = vy; have = true;
      }
      if (have) plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    } while (0);
    #undef SET_LINE_STYLE
    #undef MAP_POINT
    #undef BITS_DBL
    #undef ISNAN
    ```)

  ;;; __draw-function -- stroke y = f(x) through the adaptive sampler.
  (defn __draw-function [ctx : DrawCtx  ^fat f : (fn [float] float)  x-min : float  x-max : float
                  samples : int  style : LineStyle] : void
    ```c
    #include <stddef.h>
    #include <stdint.h>
    #include <stdbool.h>
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void plot_ctx_line_style(void *, int64_t);
    #define SET_LINE_STYLE(H, R) plot_ctx_line_style(dc, (int64_t)(intptr_t)(H))
    extern void plot_sample_adaptive(void *, int64_t, int64_t, double, double, int64_t);
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    do {
      SET_LINE_STYLE(style, ((int *)0));
      int n = (int)samples; if (n < 32) n = 32;
      plot_sample_adaptive(dc, 21, f, x_min, x_max, n);
    } while (0);
    #undef SET_LINE_STYLE
    ```)

  ;;; __draw-parametric -- stroke the Point f(t) through the adaptive sampler.
  (defn __draw-parametric [ctx : DrawCtx  ^fat f : (fn [float] Point)  t-min : float  t-max : float
                  samples : int  style : LineStyle] : void
    ```c
    #include <stddef.h>
    #include <stdint.h>
    #include <stdbool.h>
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void plot_ctx_line_style(void *, int64_t);
    #define SET_LINE_STYLE(H, R) plot_ctx_line_style(dc, (int64_t)(intptr_t)(H))
    extern void plot_sample_adaptive(void *, int64_t, int64_t, double, double, int64_t);
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    do {
      SET_LINE_STYLE(style, ((int *)0));
      int n = (int)samples; if (n < 32) n = 32;
      plot_sample_adaptive(dc, 22, f, t_min, t_max, n);
    } while (0);
    #undef SET_LINE_STYLE
    ```)

  ;;; __draw-polar -- stroke radius = f(theta) through the adaptive sampler.
  (defn __draw-polar [ctx : DrawCtx  ^fat f : (fn [float] float)  theta-min : float  theta-max : float
                  samples : int  style : LineStyle] : void
    ```c
    #include <stddef.h>
    #include <stdint.h>
    #include <stdbool.h>
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void plot_ctx_line_style(void *, int64_t);
    #define SET_LINE_STYLE(H, R) plot_ctx_line_style(dc, (int64_t)(intptr_t)(H))
    extern void plot_sample_adaptive(void *, int64_t, int64_t, double, double, int64_t);
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    do {
      SET_LINE_STYLE(style, ((int *)0));
      int n = (int)samples; if (n < 32) n = 32;
      plot_sample_adaptive(dc, 23, f, theta_min, theta_max, n);
    } while (0);
    #undef SET_LINE_STYLE
    ```)

  ;;; __draw-inverse -- stroke x = f(y) through the adaptive sampler.
  (defn __draw-inverse [ctx : DrawCtx  ^fat f : (fn [float] float)  y-min : float  y-max : float
                  samples : int  style : LineStyle] : void
    ```c
    #include <stddef.h>
    #include <stdint.h>
    #include <stdbool.h>
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    extern void plot_ctx_line_style(void *, int64_t);
    #define SET_LINE_STYLE(H, R) plot_ctx_line_style(dc, (int64_t)(intptr_t)(H))
    extern void plot_sample_adaptive(void *, int64_t, int64_t, double, double, int64_t);
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    do {
      SET_LINE_STYLE(style, ((int *)0));
      int n = (int)samples; if (n < 32) n = 32;
      plot_sample_adaptive(dc, 24, f, y_min, y_max, n);
    } while (0);
    #undef SET_LINE_STYLE
    ```)

  ;;; __draw-density -- stroke a Gaussian KDE of `values` across the x extent.
  (defn __draw-density [ctx : DrawCtx  values : Cells  bandwidth : float
                      samples : int  style : LineStyle] : void
    ```c
    #include <stddef.h>
    #include <stdint.h>
    #include <stdbool.h>
    extern double sqrt(double);
    extern double pow(double, double);
    extern double exp(double);
    /* Stand-ins for <plutovg.h>, for a build without it on the include
       path; with it (a project build hoists it) these would conflict. */
    #ifndef PLUTOVG_H
    typedef void plutovg_canvas_t;
    extern void plutovg_canvas_move_to(void* canvas, float x, float y);
    extern void plutovg_canvas_line_to(void* canvas, float x, float y);
    extern void plutovg_canvas_stroke(void* canvas);
    #endif
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct PlotDrawCtx {
      void *canvas;
      double bx_min, bx_max, by_min, by_max;
      int64_t left, right, top, bottom, plot_w, plot_h;
      int64_t font_ok;
      void *font;
      int64_t legend_pos;
      int64_t auto_color;
    } PlotDrawCtx;
    #define BITS_DBL(v) (((union { double d; int64_t i; }){.i=(v)}).d)
    extern void plot_ctx_line_style(void *, int64_t);
    #define SET_LINE_STYLE(H, R) plot_ctx_line_style(dc, (int64_t)(intptr_t)(H))
    extern void plot_ctx_map(void *, double, double, void *, void *);
    #define MAP_POINT(X, Y, VX, VY) plot_ctx_map(dc, (X), (Y), (VX), (VY))
    PlotDrawCtx *dc = (PlotDrawCtx *)(intptr_t)ctx;
    int64_t canvas = (int64_t)(intptr_t)dc->canvas;
    double bx_min = dc->bx_min;
    double bx_max = dc->bx_max;
    do {
      SET_LINE_STYLE(style, ((int *)0));
      int n = (int)samples; if (n < 32) n = 32;
      bool started = false;
      double xs[2048]; int m = 0;
      double mean = 0.0, sd = 0.0;
      for (Cons *p = (Cons *)(intptr_t)values; p && m < 2048; p = (Cons *)(intptr_t)p->tail) {
        xs[m++] = BITS_DBL(p->head);
        mean += xs[m - 1];
      }
      if (m == 0) break;
      mean /= (double)m;
      for (int i = 0; i < m; i++) { double d = xs[i] - mean; sd += d * d; }
      sd = sqrt(sd / (double)(m > 1 ? m - 1 : 1));
      double bw = bandwidth > 0.0 ? bandwidth : (1.06 * sd * pow((double)m, -0.2));
      if (!(bw > 0.0)) bw = 1.0;
      for (int i = 0; i < n; i++) {
        double x = bx_min + (bx_max - bx_min) * ((double)i / (double)(n - 1));
        double sum = 0.0;
        for (int j = 0; j < m; j++) {
          double u = (x - xs[j]) / bw;
          sum += exp(-0.5 * u * u);
        }
        double y = sum / ((double)m * bw * sqrt(2.0 * 3.14159265358979323846));
        double vx, vy; MAP_POINT(x, y, &vx, &vy);
        if (!started) { plutovg_canvas_move_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy); started = true; }
        else plutovg_canvas_line_to((plutovg_canvas_t *)(intptr_t)canvas, (float)vx, (float)vy);
      }
      if (started) plutovg_canvas_stroke((plutovg_canvas_t *)(intptr_t)canvas);
    } while (0);
    #undef SET_LINE_STYLE
    #undef MAP_POINT
    #undef BITS_DBL
    ```)

  ;; Bounds: a polyline spans its points. A sampled curve's y extent is not
  ;; known until it is sampled, and a density's x range is the plot's own, so
  ;; those constrain nothing -- they are drawn over the extent the other
  ;; renderers (or `plot-opts`) establish.
  (definstance Renderer [LinesR]
    (bounds [r] (__bbox-of-points (.points r)))
    (draw [r ctx]
      (let [cells (__points->cells (.points r))]
        (__draw-lines ctx cells (.style r))
        (__free-cells cells 1)))
    (legend-label [r] (.label r)))

  (definstance Renderer [FunctionR]
    (bounds [r] (bbox-empty-box))
    (draw [r ctx] (__draw-function ctx (.f r) (.x-min r) (.x-max r) (.samples r) (.style r)))
    (legend-label [r] (.label r)))

  (definstance Renderer [ParametricR]
    (bounds [r] (bbox-empty-box))
    (draw [r ctx] (__draw-parametric ctx (.f r) (.t-min r) (.t-max r) (.samples r) (.style r)))
    (legend-label [r] (.label r)))

  (definstance Renderer [PolarR]
    (bounds [r] (bbox-empty-box))
    (draw [r ctx] (__draw-polar ctx (.f r) (.theta-min r) (.theta-max r) (.samples r) (.style r)))
    (legend-label [r] (.label r)))

  (definstance Renderer [InverseR]
    (bounds [r] (bbox-empty-box))
    (draw [r ctx] (__draw-inverse ctx (.f r) (.y-min r) (.y-max r) (.samples r) (.style r)))
    (legend-label [r] (.label r)))

  (definstance Renderer [DensityR]
    (bounds [r] (bbox-empty-box))
    (draw [r ctx]
      (let [cells (__values->cells (.values r))]
        (__draw-density ctx cells (.bandwidth r) (.samples r) (.style r))
        (__free-cells cells 0)))
    (legend-label [r] (.label r)))

  ;;; function -- sample y=f(x) over [x-min, x-max].
  ;;;
  ;;; `samples` is the uniform baseline count; the renderer subdivides further
  ;;; in high-curvature regions and around NaN boundaries via plot/core's
  ;;; adaptive sampler. The curve contributes no bounds of its own.
  ;;;
  ;;; Parameters:
  ;;;   f       -- the curve, a (fn [float] float): a defn or a fn literal
  ;;;   x-min   -- start of the sampled domain
  ;;;   x-max   -- end of the sampled domain
  ;;;   samples -- uniform baseline sample count
  ;;;   style   -- the LineStyle to stroke with
  ;;;   label   -- legend text ("" for none)
  ;;;
  ;;; Returns:
  ;;;   A FunctionR boxed as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (function (fn [x : float] : float (* x x)) -2.0 2.0 96 (default-line-style) "x^2")
  (defn function [^fat f : (fn [float] float)  x-min : float  x-max : float
                  samples : int  style : LineStyle  label : cstr] : AnyRenderer
    (any-renderer (make-struct FunctionR f x-min x-max samples style label)))

  ;;; lines -- draw a polyline through `vs`, in order.
  ;;;
  ;;; Pre-sampled input; the renderer plots the points as given and breaks the
  ;;; polyline at a point with a NaN coordinate so callers can encode gaps.
  ;;;
  ;;; Parameters:
  ;;;   vs    -- the points
  ;;;   style -- the LineStyle to stroke with
  ;;;   label -- legend text ("" for none)
  ;;;
  ;;; Returns:
  ;;;   A LinesR boxed as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (lines (vec-of (Point 0.0 0.0) (Point 1.0 2.0)) (default-line-style) "data")
  (defn lines [vs : (Vec Point)  style : LineStyle  label : cstr] : AnyRenderer
    (any-renderer (make-struct LinesR vs style label)))

  ;;; parametric -- sample the Point f(t).
  ;;;
  ;;; `samples` is the uniform baseline; segments are adaptively subdivided
  ;;; when they turn sharply or cross NaN boundaries.
  ;;;
  ;;; Parameters:
  ;;;   f       -- the curve, a (fn [float] Point)
  ;;;   t-min   -- start of the parameter range
  ;;;   t-max   -- end of the parameter range
  ;;;   samples -- uniform baseline sample count
  ;;;   style   -- the LineStyle to stroke with
  ;;;   label   -- legend text ("" for none)
  ;;;
  ;;; Returns:
  ;;;   A ParametricR boxed as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (parametric (fn [t : float] : Point (Point (cos t) (sin t))) 0.0 6.283 128
  ;;;               (default-line-style) "circle")
  (defn parametric [^fat f : (fn [float] Point)  t-min : float  t-max : float
                    samples : int  style : LineStyle  label : cstr] : AnyRenderer
    (any-renderer (make-struct ParametricR f t-min t-max samples style label)))

  ;;; polar -- sample radius=f(theta).
  ;;;
  ;;; `samples` is the uniform baseline; segments are adaptively subdivided in
  ;;; high-curvature regions.
  ;;;
  ;;; Parameters:
  ;;;   f         -- the radius, a (fn [float] float) of theta
  ;;;   theta-min -- start of the angle range, in radians
  ;;;   theta-max -- end of the angle range, in radians
  ;;;   samples   -- uniform baseline sample count
  ;;;   style     -- the LineStyle to stroke with
  ;;;   label     -- legend text ("" for none)
  ;;;
  ;;; Returns:
  ;;;   A PolarR boxed as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (polar (fn [t : float] : float 1.0) 0.0 6.283 96 (default-line-style) "r=1")
  (defn polar [^fat f : (fn [float] float)  theta-min : float  theta-max : float
               samples : int  style : LineStyle  label : cstr] : AnyRenderer
    (any-renderer (make-struct PolarR f theta-min theta-max samples style label)))

  ;;; inverse -- sample x=f(y) over [y-min, y-max].
  ;;;
  ;;; `samples` is the uniform baseline; segments are adaptively subdivided
  ;;; when they turn sharply or cross NaN boundaries (e.g. log-domain edges).
  ;;;
  ;;; Parameters:
  ;;;   f       -- the curve, a (fn [float] float) of y
  ;;;   y-min   -- start of the sampled range
  ;;;   y-max   -- end of the sampled range
  ;;;   samples -- uniform baseline sample count
  ;;;   style   -- the LineStyle to stroke with
  ;;;   label   -- legend text ("" for none)
  ;;;
  ;;; Returns:
  ;;;   An InverseR boxed as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (inverse (fn [y : float] : float (* y y)) -1.0 1.0 96 (default-line-style) "x=y^2")
  (defn inverse [^fat f : (fn [float] float)  y-min : float  y-max : float
                 samples : int  style : LineStyle  label : cstr] : AnyRenderer
    (any-renderer (make-struct InverseR f y-min y-max samples style label)))

  ;;; density -- kernel density estimate of a sample.
  ;;;
  ;;; Parameters:
  ;;;   vs        -- the sample values
  ;;;   bandwidth -- kernel bandwidth; 0.0 picks Silverman's rule
  ;;;   samples   -- number of points the estimate is drawn through
  ;;;   style     -- the LineStyle to stroke with
  ;;;   label     -- legend text ("" for none)
  ;;;
  ;;; Returns:
  ;;;   A DensityR boxed as an AnyRenderer.
  ;;;
  ;;; Example:
  ;;;   (density (vec-of 0.5 1.25 1.5 2.75) 0.0 128 (default-line-style) "kde")
  (defn density [vs : (Vec float)  bandwidth : float  samples : int  style : LineStyle  label : cstr] : AnyRenderer
    (any-renderer (make-struct DensityR vs bandwidth samples style label)))

) ;; end defmodule plot/line
