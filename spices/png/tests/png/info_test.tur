;; tests/png/info_test.tur -- tests for png/info.
(defmodule png/tests/info
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-eq assert-ok])
  (import test/runner :refer [run-all-status])
  (defn __all-tests [] : void
    (describe "png/info" (it "module loads without error" (assert-eq 1 1))))
  (defn main [] : int (__all-tests) (run-all-status)))
