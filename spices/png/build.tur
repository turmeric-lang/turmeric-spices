(defpackage tur-png
  :name "tur-png"
  :version "0.2.0"
  :description "PNG image read/write for Turmeric via libpng"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :cmake-deps #map{
                   ;; :cmake-name pins the -l name. The dep is keyed "png_static" after
                   ;; libpng's CMake target, but the archive that target produces is
                   ;; libpng16.a -- so the guessed -lpng_static found nothing.
                   "png_static" #map{:url "https://github.com/glennrp/libpng"
                                     :ref "v1.6.43"
                                     :cmake-name "png16"
                                     :options #map{:PNG_SHARED "OFF"
                                                   :PNG_STATIC "ON"
                                                   :PNG_TESTS "OFF"
                                                   :PNG_TOOLS "OFF"}}}
  :exports #map{"png/reader" ["png-read" "img-free"]
                "png/info" ["Img"
                            "img-width"
                            "img-height"
                            "img-channels"
                            "img-bit-depth"
                            "img-pixels"
                            "pixel-r"
                            "pixel-g"
                            "pixel-b"
                            "pixel-a"
                            "pixel-set!"]
                "png/writer" ["png-write" "png-write-raw"]})
