(defpackage tur-httpd
  :name "tur-httpd"
  :version "0.3.0"
  :description "Typed HTTP/1.1 server layer over stdlib httpd"
  ;; Needs stdlib httpd's connection upgrade + per-server limits
  ;; (tourist-on-stdlib-httpd-plan H1), first shipped in turmeric v0.64.1.
  ;; Under v0.64.0, src/httpd/server.tur fails on httpd-server-set-max-body!.
  :tur-version ">=0.64.1"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}
               "http" #map{:path "../http"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "http-v0.1.0"
                           :subdir "spices/http"
                           :optional true}
               "json" #map{:path "../json"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "v0.1.0"
                           :subdir "spices/json"}
               ;; tls backs the optional httpd/tls listener (HTTPS / wss upgrades). It is
               ;; optional: consumers that never import httpd/tls build and link without
               ;; mbedTLS. tls's mbedtls :cmake-deps is what httpd/tls's inline-C and
               ;; tls/conn compile against; plaintext httpd never references it.
               "tls" #map{:path "../tls"
                          :url "https://github.com/turmeric-lang/turmeric-spices"
                          :ref "v0.1.0"
                          :subdir "spices/tls"
                          :optional true}}
  ;; httpd declares no :cmake-deps of its own. The native libs it needs are
  ;; inherited transitively from its declared :spices: yyjson (the json codec
  ;; helpers' inline-C #includes <yyjson.h>) comes from the json dep, and
  ;; mbedTLS (httpd/tls's inline-C + the tls/conn module it reuses) comes from
  ;; the optional tls dep -- so mbedTLS is only fetched/linked when a consumer
  ;; actually pulls tls in. The compiler now walks declared :spices (and
  ;; workspace siblings) when collecting :cmake-deps, so re-declaring them here
  ;; (the old ecs-raylib/raylib pattern) is no longer needed.
  :exports #map{"httpd/types" ["Request" "Response" "Wbuf" "Conn"]
                "httpd/conn" ["conn-new"
                              "conn-new-tls"
                              "conn-fd"
                              "conn-tls"
                              "conn-mark-upgraded!"
                              "conn-upgraded?"
                              "conn-free"]
                "httpd/server" ["ServerOpts"
                                "default-server-opts"
                                "server-start"
                                "server-start-pool"
                                "server-start-spawn"
                                "server-start-opts"
                                "server-start-conn"
                                "server-start-pool-conn"
                                "server-start-conn-opts"
                                "ServerWrap"
                                "server-wrap"
                                "server-start-wrapped"
                                "server-start-conn-wrapped"
                                "server-port"
                                "server-stop"
                                "take-conn-response"]
                "httpd/tls" ["server-start-tls-conn" "server-stop-tls"]
                "httpd/request" ["req-method"
                                 "req-path"
                                 "req-header"
                                 "req-body"
                                 "req-query"
                                 "req-body-len"
                                 "req-remote-addr"
                                 "request-conn"]
                "httpd/response" ["response"
                                  "resp-ok"
                                  "not-found"
                                  "bad-request"
                                  "with-header"
                                  "with-header-set"
                                  "resp-header"
                                  "with-body"
                                  "with-body-bytes"
                                  "with-status"
                                  "free-response"]
                "httpd/handler" ["serve"
                                 "serve-pool"
                                 "serve-spawn"
                                 "serve-conn"
                                 "serve-pool-conn"
                                 "req-decode"
                                 "json-ok"
                                 "json-resp"
                                 "with-json-body"]
                "httpd/typed" ["TRequest"
                               "TResponse"
                               "treq-of"
                               "treq-handle"
                               "treq-method"
                               "treq-path"
                               "treq-query"
                               "treq-body"
                               "treq-header"
                               "tresp-of"
                               "tresp-handle"
                               "tresp-with-header"
                               "tresp-with-body"
                               "tresp-with-status"
                               "tfree-response"]})
