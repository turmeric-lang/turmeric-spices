;;; httpd/types -- opaque handle types for the httpd spice.
;;;
;;; Centralises the defopaque newtypes so request/response/write/server can
;;; all import them without duplicating definitions. Each handle is stored
;;; as int64_t under the hood; coerce to/from :int with (:: x :int) and
;;; (:: x :Request) etc. inside inline-C blocks where the C-ABI int64_t
;;; shape matters.
;;;
;;; Since: H8
(defmodule httpd/types
  (export Request Response Wbuf Conn)
  ;;; Request -- opaque handle to a parsed HTTP request.
  ;;;
  ;;; A view of the request stdlib httpd parsed, built by the server before the
  ;;; handler runs and freed after the response is written (see
  ;;; httpd/request). Underlying layout is `struct __httpd_req`; handlers borrow
  ;;; the pointer and must not free it or keep it past their return.
  (defopaque Request :int)
  ;;; Response -- opaque handle to an HTTP response.
  ;;;
  ;;; Built by httpd/response constructors (`response` / `resp-ok` /
  ;;; `not-found` / `bad-request`). Mutated in place by `with-header` /
  ;;; `with-body` / `with-status`. Ownership transfers to the framework
  ;;; when returned from a handler; otherwise call `free-response`.
  (defopaque Response :int)
  ;;; Wbuf -- opaque handle to a serialized response byte buffer.
  ;;;
  ;;; Retired: the spice no longer serializes responses itself (stdlib httpd
  ;;; writes them), so nothing produces a Wbuf.  The type is kept so code that
  ;;; names it still compiles.
  (defopaque Wbuf :int)
  ;;; Conn -- opaque handle to a live client connection inside a handler.
  ;;;
  ;;; Passed (alongside the `Request`) to handlers registered via
  ;;; `server-start-conn` / `serve-conn`. Wraps the client fd, the TLS state
  ;;; (on a TLS listener), an "upgraded" flag and the stdlib httpd conn. A
  ;;; protocol-upgrade helper (e.g. ws-server's `ws-upgrade`) reads the fd via
  ;;; `conn-fd`, writes its own switch-protocols response, and calls
  ;;; `conn-mark-upgraded!` so the server does not write a second response or
  ;;; close the socket.
  ;;;
  ;;; Underlying layout is `struct __httpd_conn { int fd; int upgraded;
  ;;; void *tls; void *hconn; }`. The handle is owned by the framework;
  ;;; handlers must not free it. Accessors live in httpd/conn.
  ;;;
  ;;; Since: WS0
  (defopaque Conn :int)) ;; end defmodule httpd/types
