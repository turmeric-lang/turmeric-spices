;;; httpd/conn -- live-connection handle for upgrade-aware handlers.
;;;
;;; The server normally owns the client socket for the whole request/response
;;; lifetime: it reads the request, calls the handler, writes the Response, and
;;; keeps the connection for the next keep-alive request or closes it.
;;; Protocol upgrades (WebSocket, SSE, ...) need to break out of that -- the
;;; handler must take over the raw transport and the server must NOT write a
;;; second response or close the socket.
;;;
;;; A `Conn` is the handle that makes that possible. Handlers registered via
;;; `server-start-conn` / `serve-conn` receive a `Conn` alongside the
;;; `Request`; an upgrade helper reads the fd with `conn-fd` (and the TLS state
;;; with `conn-tls`), writes its own "101 Switching Protocols" response, then
;;; calls `conn-mark-upgraded!`. That hands the connection over at once -- it is
;;; stdlib httpd's `httpd-conn-detach!` -- so when the handler returns the
;;; server writes nothing and closes nothing: the upgrade handler owns the fd
;;; and the TLS state and must release them.
;;;
;;; The `tls` slot carries the per-connection TLS state for the `wss://` path:
;;; NULL on a plaintext listener; on a TLS listener (`server-start-tls-conn` in
;;; httpd/tls) the `tls_conn_t*` tur-tls's `tls-wrap-fd` produced, so the
;;; WebSocket handshake + frame I/O run over the encrypted stream.
;;;
;;; Internal layout (duplicated verbatim in every inline-C block):
;;;
;;;   struct __httpd_conn { int fd; int upgraded; void *tls; void *hconn; };
;;;
;;; `hconn` is the stdlib httpd conn of the request (NULL for a Conn made with
;;; conn-new / conn-new-tls outside the server).
;;;
;;; Since: WS0 (tls slot wired in WS4; over stdlib httpd since
;;; tourist-on-stdlib-httpd H2)

(load "stdlib/httpd.tur")

(defmodule httpd/conn
  (import httpd/types :refer [Conn])
  (import tls/conn    :refer [TlsConn])
  (export conn-new conn-new-tls conn-fd conn-tls
          conn-mark-upgraded! conn-upgraded? conn-free
          conn-of-httpd)

;; file-scope-c-block: keep the struct layout and headers out of function
;; bodies (system headers carry static inline defs illegal inside functions
;; on macOS 14+ / Xcode 15+).
```c
#include <stdlib.h>

struct __httpd_conn { int fd; int upgraded; void *tls; void *hconn; };
```

;;; conn-new -- allocate a Conn wrapping a client fd.
;;;
;;; The connection starts un-upgraded with a NULL TLS slot and no stdlib conn,
;;; so conn-mark-upgraded! only sets the flag. The server builds its Conns with
;;; conn-of-httpd; this is for code driving a socket of its own.
;;;
;;; Parameters:
;;;   fd -- connected client socket.
;;;
;;; Returns:
;;;   :Conn -- a fresh handle (free with conn-free), or 0 on allocation failure.
;;;
;;; Since: WS0
(defn conn-new [fd : int] : Conn
  ```c
  struct __httpd_conn *c = (struct __httpd_conn *)malloc(sizeof(*c));
  if (!c) return 0;
  c->fd       = (int)fd;
  c->upgraded = 0;
  c->tls      = NULL;
  c->hconn    = NULL;
  return (int64_t)(intptr_t)c;
  ```)

;;; conn-new-tls -- allocate a Conn wrapping a worker's client fd plus its
;;; per-connection TLS state.
;;;
;;; `tls` is a `tls_conn_t*` handle from tur-tls's `tls-wrap-fd`
;;; (post-handshake). `conn-tls` hands it to ws-upgrade so the WebSocket
;;; handshake + frames run over TLS. Like conn-new, this Conn has no stdlib
;;; conn behind it.
;;;
;;; Parameters:
;;;   fd  -- connected client socket.
;;;   tls -- tls_conn_t* handle as :int (0 is equivalent to conn-new).
;;;
;;; Returns:
;;;   :Conn -- a fresh handle (free with conn-free), or 0 on allocation failure.
;;;
;;; Since: WS4
(defn conn-new-tls [fd : int ^borrow tls : TlsConn] : Conn
  ```c
  struct __httpd_conn *c = (struct __httpd_conn *)malloc(sizeof(*c));
  if (!c) return 0;
  c->fd       = (int)fd;
  c->upgraded = 0;
  c->tls      = (void *)(intptr_t)tls;
  c->hconn    = NULL;
  return (int64_t)(intptr_t)c;
  ```)

;;; conn-of-httpd -- internal: the Conn for the stdlib conn of a request.
;;;
;;; httpd/server builds one per request for a two-arg handler; the fd and TLS
;;; state are the stdlib conn's. Free with conn-free.
;;;
;;; Parameters:
;;;   hconn -- the stdlib httpd conn of the current request
;;;
;;; Returns:
;;;   :Conn -- a fresh handle, or 0 on allocation failure.
;;;
;;; Since: tourist-on-stdlib-httpd H2
(defn conn-of-httpd [hconn : ptr<void>] : Conn
  ```c
  struct __httpd_conn *c = (struct __httpd_conn *)malloc(sizeof(*c));
  if (!c) return 0;
  c->fd       = (int)httpd_hyconn_hyfd(hconn);
  c->upgraded = 0;
  c->tls      = httpd_hyconn_hytls(hconn);
  c->hconn    = hconn;
  return (int64_t)(intptr_t)c;
  ```)

;;; conn-fd -- the raw client socket fd behind a Conn.
;;;
;;; An upgrade helper writes its switch-protocols response directly to this
;;; fd and then takes ownership of it (see conn-mark-upgraded!).
;;;
;;; Parameters:
;;;   conn -- Conn handle.
;;;
;;; Returns:
;;;   :int -- the file descriptor, or -1 for a null handle.
;;;
;;; Since: WS0
(defn conn-fd [conn : Conn] : int
  ```c
  if (conn == 0) return -1;
  return (int64_t)((struct __httpd_conn *)(intptr_t)conn)->fd;
  ```)

;;; conn-tls -- the per-connection TLS state handle behind a Conn, or 0.
;;;
;;; Returns the `tls_conn_t*` (as :int) for a connection accepted on a TLS
;;; listener, or 0 for a plaintext connection. An upgrade helper checks this to
;;; decide whether to drive the handshake + frames over TLS (`tls-read` /
;;; `tls-write`) or over the raw fd (`send` / `recv`).
;;;
;;; Parameters:
;;;   conn -- Conn handle.
;;;
;;; Returns:
;;;   :int -- the tls_conn_t* handle, or 0 (plaintext / null handle).
;;;
;;; Since: WS4
(defn conn-tls [conn : Conn] : int
  ```c
  if (conn == 0) return 0;
  return (int64_t)(intptr_t)((struct __httpd_conn *)(intptr_t)conn)->tls;
  ```)

;;; conn-mark-upgraded! -- hand the connection to the upgrade handler.
;;;
;;; Effective at once: the server will write no response (the handler's
;;; returned Response is discarded) and will not close the fd or release the
;;; TLS state -- the upgrade handler now owns both and must close them.
;;; Call it once the switch-protocols response is on the wire.
;;;
;;; Parameters:
;;;   conn -- Conn handle.
;;;
;;; Since: WS0
(defn conn-mark-upgraded! [conn : Conn] : void
  ```c
  if (conn == 0) return;
  struct __httpd_conn *c = (struct __httpd_conn *)(intptr_t)conn;
  if (c->upgraded) return;
  c->upgraded = 1;
  /* Hand the connection over now (it also drops the server's read timeout,
   * which an upgraded session must not inherit). */
  if (c->hconn) (void)__TUR_CNAME_httpd-conn-detach!__(c->hconn);
  ```)

;;; conn-upgraded? -- true once conn-mark-upgraded! has been called.
;;;
;;; The server consults this after the handler returns.
;;;
;;; Parameters:
;;;   conn -- Conn handle.
;;;
;;; Returns:
;;;   :bool
;;;
;;; Since: WS0
(defn conn-upgraded? [conn : Conn] : bool
  ```c
  return conn != 0 && ((struct __httpd_conn *)(intptr_t)conn)->upgraded != 0;
  ```)

;;; conn-free -- release the Conn handle.
;;;
;;; Frees only the wrapper struct; the underlying fd is NOT closed (whoever
;;; owns the fd -- the worker loop in the normal path, or the upgrade handler
;;; in the upgraded path -- closes it). Safe on a null handle.
;;;
;;; Parameters:
;;;   conn -- Conn handle, or 0 (no-op).
;;;
;;; Since: WS0
(defn conn-free [conn : Conn] : void
  ```c
  if (conn == 0) return;
  free((void *)(intptr_t)conn);
  ```)

) ;; end defmodule httpd/conn
