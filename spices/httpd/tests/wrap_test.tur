;; tests/wrap_test.tur -- stdlib middleware around a typed server
;; (tourist-on-stdlib-httpd-plan H4).
;;
;; server-start-wrapped / server-start-conn-wrapped run the typed handler
;; inside a stdlib middleware stack built by a server-wrap function:
;;
;;   * mw-secure-headers adds its headers to the typed handler's response,
;;     and keeps the one the handler set itself;
;;   * mw-request-id's id is echoed;
;;   * mw-etag answers a matching If-None-Match with 304 and no body;
;;   * the two-arg (Conn, Request) server takes a wrap the same way.
(defmodule httpd/tests/wrap
  (import httpd/types :refer [Request Response])
  (import httpd/server
    :refer
    [default-server-opts
     server-wrap
     server-start-wrapped
     server-start-conn-wrapped
     server-port
     server-stop])
  (import httpd/request :refer [req-path])
  (import httpd/response :refer [resp-ok with-header])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  ```c
  #include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <unistd.h>
#include <sys/socket.h>
#include <sys/time.h>
#include <netinet/in.h>
#include <arpa/inet.h>

/* GET path with the extra header lines; the raw response (caller frees). */
static char *wrp__get(int port, const char *path, const char *extra) {
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) return NULL;
  struct sockaddr_in a; memset(&a, 0, sizeof(a));
  a.sin_family = AF_INET; a.sin_port = htons((uint16_t)port);
  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  if (connect(fd, (struct sockaddr *)&a, sizeof(a)) != 0) { close(fd); return NULL; }
  struct timeval tv = { 5, 0 };
  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
  char req[512];
  int n = snprintf(req, sizeof req, "GET %s HTTP/1.1\r\nHost: x\r\n%sConnection: close\r\n\r\n",
                   path, extra);
  send(fd, req, (size_t)n, MSG_NOSIGNAL);
  size_t cap = 4096, len = 0;
  char *buf = (char *)malloc(cap);
  for (;;) {
    if (len + 1 >= cap) { cap *= 2; buf = (char *)realloc(buf, cap); }
    ssize_t r = recv(fd, buf + len, cap - len - 1, 0);
    if (r <= 0) break;
    len += (size_t)r;
  }
  buf[len] = '\0';
  close(fd);
  return buf;
}

static char wrp__etag[128];
```
  (defn has? [port : int path : cstr extra : cstr needle : cstr] : bool
    ```c
    char *r = wrp__get((int)port, path, extra);
    int ok = r && strstr(r, needle) != NULL;
    free(r);
    return ok;
    ```)
  (defn status-of [port : int path : cstr extra : cstr] : int
    ```c
    char *r = wrp__get((int)port, path, extra);
    int st = 0;
    if (r) sscanf(r, "HTTP/1.1 %d", &st);
    free(r);
    return st;
    ```)
  ;; Fetch path and remember its ETag; true when there was one.
  (defn grab-etag! [port : int path : cstr] : bool
    ```c
    char *r = wrp__get((int)port, path, "");
    wrp__etag[0] = '\0';
    const char *e = r ? strstr(r, "\r\nETag: ") : NULL;
    if (e) {
      e += 8;
      const char *eol = strstr(e, "\r\n");
      snprintf(wrp__etag, sizeof wrp__etag, "%.*s", (int)(eol ? eol - e : 0), e);
    }
    free(r);
    return wrp__etag[0] != '\0';
    ```)
  ;; The If-None-Match line for the remembered ETag.
  (defn inm-line [] : cstr
    ```c
    static char h[200];
    snprintf(h, sizeof h, "If-None-Match: %s\r\n", wrp__etag);
    return h;
    ```)
  ;; The status and body length of a conditional GET with the remembered ETag.
  (defn conditional-empty? [port : int path : cstr] : bool
    ```c
    char *r = wrp__get((int)port, path, httpd__tests__wrap__inm_hyline());
    const char *b = r ? strstr(r, "\r\n\r\n") : NULL;
    int ok = r && strncmp(r, "HTTP/1.1 304", 12) == 0 && b && b[4] == '\0';
    free(r);
    return ok;
    ```)
  (defn path-is? [a : cstr b : cstr] : bool ```c return strcmp(a, b) == 0; ```)
  (defn page-handler [req : int] : int
    (let [r (:: req :Request)]
      (:: (if (path-is? (req-path r) "/framed")
            (with-header (resp-ok "text/plain" "framed page")
              "X-Frame-Options"
              "SAMEORIGIN")
            (resp-ok "text/plain" "page body"))
        :int)))
  (defn conn-handler [conn : int req : int] : int
    (:: (resp-ok "text/plain" "conn page") :int))
  (defn stack [inner : ptr<void>] : ptr<void>
    (compose-middleware inner mw-request-id mw-secure-headers mw-etag))
  (defn __all-tests [] : void
    (let [srv   (server-start-wrapped 0
                  page-handler
                  (default-server-opts)
                  (server-wrap (fn [inner : ptr<void>] : ptr<void>
                                 (stack inner))))
          port  (server-port srv)
          csrv  (server-start-conn-wrapped 0
                  conn-handler
                  (default-server-opts)
                  (server-wrap (fn [inner : ptr<void>] : ptr<void>
                                 (mw-secure-headers inner))))
          cport (server-port csrv)]
      (describe "server-start-wrapped -- stdlib middleware around a typed handler"
        (it "the typed handler's response comes through"
          (assert-eq 200 (status-of port "/" "")))
        (it "mw-secure-headers decorates it"
          (assert-true (has? port "/" "" "X-Content-Type-Options: nosniff")))
        (it "a header the handler set is kept"
          (assert-true (has? port "/framed" "" "X-Frame-Options: SAMEORIGIN")))
        (it "mw-request-id echoes a well-formed id"
          (assert-true (has? port
                         "/"
                         "X-Request-Id: abc-123\r\n"
                         "X-Request-Id: abc-123")))
        (it "mw-etag tags the response" (assert-true (grab-etag! port "/")))
        (it "a matching If-None-Match is answered 304 with no body"
          (assert-true (conditional-empty? port "/")))
        (it "the two-arg server takes a wrap too"
          (assert-true (has? cport "/" "" "X-Frame-Options: DENY"))))
      (server-stop srv)
      (server-stop csrv)))
  (defn main [] : int (__all-tests) (run-all-status)))
