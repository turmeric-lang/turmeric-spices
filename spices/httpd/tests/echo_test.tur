;; tests/httpd/echo_test.tur -- H8 echo fixture.
;;
;; The server echoes "<METHOD> <PATH>" as the response body with status 200
;; and Content-Type: text/plain.  The test uses the default dispatcher
;; (`server-start` -> pool mode) so the round-trip also exercises the H7
;; thread pool happy path: every assertion in this file goes through the
;; bounded pool.
(defmodule httpd/tests/echo
  (import httpd/server :refer [server-start server-stop])
  (import httpd/request :refer [req-method req-path])
  (import httpd/response :refer [resp-ok])
  (import httpd/types :refer [Request])
  (import http/client :refer [http-get http-result-free])
  (import http/response :refer [response-status response-body response-header])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-eq assert-true])
  (import test/runner :refer [run-all-status])
  ;; ---------------------------------------------------------------------
  ;; Helpers: unwrap http/client's result<:int> and compare cstr equality.
  ;; ---------------------------------------------------------------------
  (defn __cr-ok? [r : ptr<void>] : bool
    ```c
    return tur_is_ok((int64_t)(intptr_t)r);
    ```)
  (defn __cr-val [r : ptr<void>] : int
    ```c
    return tur_ok_value((int64_t)(intptr_t)r);
    ```)
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
    return strcmp((const char *)a, (const char *)b) == 0;
    ```)
  ;; Local "<method> <path>" join -- stdlib/str-concat is generic and trips
  ;; over the elaborator when reached transitively through several spices,
  ;; so we inline a tiny purpose-built helper here.
  (defn echo-join [method : cstr path : cstr] : cstr
    ```c
    #include <stdlib.h>
    #include <string.h>
    const char *m = (const char *)method;
    const char *p = (const char *)path;
    size_t ml = strlen(m), pl = strlen(p);
    char *out = (char *)malloc(ml + 1 + pl + 1);
    memcpy(out, m, ml);
    out[ml] = ' ';
    memcpy(out + ml + 1, p, pl);
    out[ml + 1 + pl] = '\0';
    return out;
    ```)
  ;; ---------------------------------------------------------------------
  ;; Handler: echo "<METHOD> <PATH>" with status 200, text/plain.
  ;; ---------------------------------------------------------------------
  (defn cstr-free [s : cstr] : void ```c free((void *)s); ```)
  (defn echo-handler [req : int] : int
    (let [r    (:: req :Request)
          body (echo-join (req-method r) (req-path r))
          resp (resp-ok "text/plain" body)]
      (cstr-free body)
      (:: resp :int)))
  ;; ---------------------------------------------------------------------
  ;; Client helpers: fetch, read one thing, free the result.
  ;; ---------------------------------------------------------------------
  (defn get-status [url : cstr] : int
    (let [r (http-get url)
          s (if (__cr-ok? r) (response-status (__cr-val r)) -1)]
      (http-result-free r)
      s))
  (defn get-body-is? [url : cstr want : cstr] : bool
    (let [r  (http-get url)
          ok (if (__cr-ok? r)
               (cstr-eq? want (response-body (__cr-val r)))
               false)]
      (http-result-free r)
      ok))
  (defn get-header-is? [url : cstr name : cstr want : cstr] : bool
    (let [r  (http-get url)
          ok (if (__cr-ok? r)
               (cstr-eq? want (response-header (__cr-val r) name))
               false)]
      (http-result-free r)
      ok))
  (defn sleep-ms [ms : int]
    #fx{Unsafe}
    : void
    ```c
    #include <unistd.h>
    if (ms > 0) usleep((useconds_t)ms * 1000u);
    ```)
  ;; ---------------------------------------------------------------------
  ;; Test driver
  ;; ---------------------------------------------------------------------
  (defn main [] : int
    (let [srv (server-start 18081 echo-handler)]
      (do
        (unsafe (sleep-ms 50))
        (describe "httpd echo -- default (pool) dispatch"
          (it "GET / returns 200"
            (assert-eq 200 (get-status "http://127.0.0.1:18081/")))
          (it "GET / echoes 'GET /'"
            (assert-true (get-body-is? "http://127.0.0.1:18081/" "GET /")))
          (it "GET /hello echoes 'GET /hello'"
            (assert-true (get-body-is? "http://127.0.0.1:18081/hello"
                           "GET /hello")))
          (it "Content-Type is text/plain"
            (assert-true (get-header-is? "http://127.0.0.1:18081/x"
                           "Content-Type"
                           "text/plain"))))
        (server-stop srv)))
    (run-all-status)))
