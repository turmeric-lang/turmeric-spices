;; tests/httpd/post_body_test.tur -- H8 body-read fixture.
;;
;; The handler echoes the request body verbatim back to the client.
;; Exercises:
;;   - POST method dispatch
;;   - Content-Length parsing in httpd/parse
;;   - body buffer round-trip across socket boundary

(defmodule httpd/tests/post-body
  (import httpd/server   :refer [server-start server-stop])
  (import httpd/request  :refer [req-method req-body])
  (import httpd/response :refer [resp-ok])
  (import httpd/types    :refer [Request])
  (import http/client    :refer [http-post http-get http-result-free])
  (import http/response  :refer [response-status response-body])
  (import test/suite     :refer [describe it])
  (import test/assert    :refer [assert-eq assert-true])
  (import test/runner    :refer [run-all-status])

  ;; ---------------------------------------------------------------------
  ;; Helpers
  ;; ---------------------------------------------------------------------

  (defn __cr-ok? [r : ptr<void>] : bool
    ```c
    return tur_is_ok((int64_t)(intptr_t)r);
    ```)

  (defn __cr-val [r : ptr<void>] : int
    ```c
    return tur_ok_value((int64_t)(intptr_t)r);
    ```)

  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
    return strcmp((const char *)a, (const char *)b) == 0;
    ```)

  ;; ---------------------------------------------------------------------
  ;; Client result readers: read one thing, then free the result (the http
  ;; spice's http-result-free also frees the strings read from it).
  ;; ---------------------------------------------------------------------

  (defn status-of [r : ptr<void>] : int
    (let [s (if (__cr-ok? r) (response-status (__cr-val r)) -1)]
      (http-result-free r)
      s))

  (defn body-is? [r : ptr<void> want : cstr] : bool
    (let [ok (if (__cr-ok? r) (cstr-eq? want (response-body (__cr-val r))) false)]
      (http-result-free r)
      ok))

  (defn header-is? [r : ptr<void> name : cstr want : cstr] : bool
    (let [ok (if (__cr-ok? r) (cstr-eq? want (response-header (__cr-val r) name)) false)]
      (http-result-free r)
      ok))

  ;; ---------------------------------------------------------------------
  ;; Handler: 200 OK; body = request body (or "<empty>" if there was none).
  ;; ---------------------------------------------------------------------

  (defn empty-or [s : cstr fallback : cstr] : cstr
    ```c
    #include <string.h>
    const char *p = (const char *)s;
    if (!p || p[0] == '\0') return (const char *)fallback;
    return p;
    ```)

  (defn sleep-ms [ms : int] #fx{Unsafe} : void
    ```c
    #include <unistd.h>
    if (ms > 0) usleep((useconds_t)ms * 1000u);
    ```)

  (defn body-echo-handler [req : int] : int
    (:: (resp-ok "text/plain" (empty-or (req-body (:: req :Request)) "<empty>"))
        :int))

  ;; ---------------------------------------------------------------------
  ;; Test driver
  ;; ---------------------------------------------------------------------

  (defn main [] : int
    (let [srv (server-start 18083 body-echo-handler)]
      (do
        (unsafe (sleep-ms 50))

        (describe "httpd post-body -- request body round-trip"

          (it "POST short body echoes verbatim"
            (assert-true (body-is? (http-post "http://127.0.0.1:18083/echo" "hello, world") "hello, world")))

          (it "POST short body returns 200"
            (assert-eq 200 (status-of (http-post "http://127.0.0.1:18083/echo" "x"))))

          (it "POST JSON-shaped body echoes verbatim"
            (assert-true (body-is? (http-post "http://127.0.0.1:18083/echo"
                               "{\"key\":\"value\",\"n\":42}") "{\"key\":\"value\",\"n\":42}")))

          (it "GET with no body returns '<empty>'"
            (assert-true (body-is? (http-get "http://127.0.0.1:18083/no-body") "<empty>"))))

        (server-stop srv)
        ))
    (run-all-status)))
