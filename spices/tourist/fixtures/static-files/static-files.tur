;; Fixture: static-files -- serve-static!; mime detection; path-traversal rejection
;;
;; Creates test files in /tmp/tourist-static-test/ so the test is independent
;; of the working directory.  serve-static! serves through stdlib httpd's
;; httpd-static-serve! (tourist-on-stdlib-httpd H5), whose text types carry a
;; charset (`text/css; charset=utf-8`), so the media type is matched up to
;; its parameters.

(defmodule tourist/tests/static-files
  (import tourist/app    :refer [tourist])
  (import tourist/static :refer [serve-static!])
  (import httpd/server   :refer [server-port server-stop])
  (import http/client    :refer [http-get http-result-free])
  (import http/response  :refer [response-status response-body response-header])
  (import test/suite     :refer [describe it])
  (import test/assert    :refer [assert-eq assert-true])
  (import test/runner    :refer [run-all-status])

  (defn __cr-ok? [r : ptr<void>] : bool
    ```c
    return tur_is_ok((int64_t)(intptr_t)r);
    ```)

  (defn __cr-val [r : ptr<void>] : int
    ```c
    return tur_ok_value((int64_t)(intptr_t)r);
    ```)

  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
    return a && strcmp((const char *)a, (const char *)b) == 0;
    ```)

  ;; media-type-is? -- true if a Content-Type's media type (before any ';'
  ;; parameters) is `want`.
  (defn media-type-is? [ct : cstr want : cstr] : bool
    ```c
    #include <string.h>
    #include <strings.h>
    if (!ct) return false;
    size_t wl = strlen(want);
    return strncasecmp(ct, want, wl) == 0 && (ct[wl] == '\0' || ct[wl] == ';');
    ```)

  (defn url-for [port : int path : cstr] : cstr
    ```c
    #include <stdio.h>
    static char u[256];
    snprintf(u, sizeof u, "http://127.0.0.1:%d%s", (int)port, path);
    return u;
    ```)

  ;; __setup-test-dir -- create /tmp/tourist-static-test/ and write test files.
  ;; Returns the directory path.
  (defn __setup-test-dir [] : cstr
    ```c
    #include <stdlib.h>
    #include <stdio.h>
    #include <sys/stat.h>
    const char *dir = "/tmp/tourist-static-test";
    mkdir(dir, 0755);
    FILE *f;
    f = fopen("/tmp/tourist-static-test/hello.txt", "w");
    if (f) { fputs("hello from static", f); fclose(f); }
    f = fopen("/tmp/tourist-static-test/style.css", "w");
    if (f) { fputs("body { color: red; }", f); fclose(f); }
    return dir;
    ```)

  ;; -- Probes: each frees its client result. -----------------------------
  (defn status-of [port : int path : cstr] : int
    (let [r  (http-get (url-for port path))
          st (if (__cr-ok? r) (response-status (__cr-val r)) 0)]
      (http-result-free r)
      st))

  (defn body-is? [port : int path : cstr want : cstr] : bool
    (let [r  (http-get (url-for port path))
          ok (if (__cr-ok? r) (cstr-eq? want (response-body (__cr-val r))) false)]
      (http-result-free r)
      ok))

  (defn type-is? [port : int path : cstr want : cstr] : bool
    (let [r  (http-get (url-for port path))
          ok (if (__cr-ok? r)
               (media-type-is? (response-header (__cr-val r) "Content-Type") want)
               false)]
      (http-result-free r)
      ok))

  (defn __all-tests [] : void
    (let [pub-dir (__setup-test-dir)
          srv     (tourist 0 (serve-static! "/assets" pub-dir))
          port    (server-port srv)]
      (describe "tourist static-files"
        (it "GET /assets/hello.txt status is 200"
          (assert-eq 200 (status-of port "/assets/hello.txt")))
        (it "GET /assets/hello.txt body is hello from static"
          (assert-true (body-is? port "/assets/hello.txt" "hello from static")))
        (it "GET /assets/style.css Content-Type is text/css"
          (assert-true (type-is? port "/assets/style.css" "text/css")))
        (it "GET /assets/hello.txt Content-Type is text/plain"
          (assert-true (type-is? port "/assets/hello.txt" "text/plain")))
        (it "GET /assets/../../../etc/passwd falls through to 404"
          (assert-eq 404 (status-of port "/assets/../../../etc/passwd")))
        (it "GET /assets/missing.txt falls through to 404"
          (assert-eq 404 (status-of port "/assets/missing.txt"))))
      (server-stop srv)))

  (defn main [] : int
    (__all-tests)
    (run-all-status)))
