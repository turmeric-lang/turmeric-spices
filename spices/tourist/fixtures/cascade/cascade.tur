;; Fixture: cascade -- cascade! tries apps in order, passes through on 404.

(defmodule tourist/tests/cascade
  (import tourist/app     :refer [tourist])
  (import tourist/dsl     :refer [get!])
  (import tourist/helpers :refer [text])
  (import tourist/routing :refer [cascade! cascade-with! passes!])
  (import httpd/server    :refer [server-port server-stop])
  (import http/client     :refer [http-get http-result-free])
  (import http/response   :refer [response-status response-body])
  (import test/suite      :refer [describe it])
  (import test/assert     :refer [assert-eq assert-true])
  (import test/runner     :refer [run-all-status])

  ;; url-for -- the test server's URL for `path` (the port is kernel-assigned).
  (defn url-for [port : int path : cstr] : cstr
    ```c
    #include <stdio.h>
    static __thread char u[256];
    snprintf(u, sizeof u, "http://127.0.0.1:%d%s", (int)port, path);
    return u;
    ```)

  (defn __cr-ok? [r : ptr<void>] : bool
    ```c
    return tur_is_ok((int64_t)(intptr_t)r);
    ```)

  (defn __cr-val [r : ptr<void>] : int
    ```c
    return tur_ok_value((int64_t)(intptr_t)r);
    ```)

  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
    return strcmp((const char *)a, (const char *)b) == 0;
    ```)

  (defn main [] : int
    (let [srv (tourist 0
                (cascade! (get! "/primary" (fn [_] (text "primary")))
                          (get! "/fallback" (fn [_] (text "fallback")))
                          (get! "/" (fn [_] (text "root")))))
          port (server-port srv)]
      (do
        (describe "tourist cascade!"
          (it "GET /primary returns from first app"
            (let [r    (http-get (url-for port "/primary"))
                  __ok (if (__cr-ok? r)
                         (do
                           (assert-eq 200 (response-status (__cr-val r)))
                           (assert-true
                             (cstr-eq? "primary" (response-body (__cr-val r)))))
                         (assert-true false))]
              (http-result-free r)
              __ok))
          (it "GET /fallback falls through first app, hits second"
            (let [r    (http-get (url-for port "/fallback"))
                  __ok (if (__cr-ok? r)
                         (do
                           (assert-eq 200 (response-status (__cr-val r)))
                           (assert-true
                             (cstr-eq? "fallback" (response-body (__cr-val r)))))
                         (assert-true false))]
              (http-result-free r)
              __ok))
          (it "GET / falls through to root handler"
            (let [r    (http-get (url-for port "/"))
                  __ok (if (__cr-ok? r)
                         (assert-true
                           (cstr-eq? "root" (response-body (__cr-val r))))
                         (assert-true false))]
              (http-result-free r)
              __ok))
          (it "GET /none returns 404 when no cascade entry matches"
            (let [r    (http-get (url-for port "/none"))
                  __ok (if (__cr-ok? r)
                         (assert-eq 404 (response-status (__cr-val r)))
                         (assert-true false))]
              (http-result-free r)
              __ok)))
        (server-stop srv)
        (run-all-status)))))
