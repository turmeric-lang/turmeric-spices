;;; tourist/template -- render templates for routes (requires tur-template dep).
;;;
;;; render-html renders a template file against an Env into a 200 text/html
;;; Response (500 with the error when the file cannot be read).
;;; render-template returns the rendered text itself, for a route that wants
;;; to build its own Response.
;;;
;;; Only available when tur-template is declared as a :spices dep in the
;;; consumer's build.tur.
;;;
;;; Since: v0.1.0
;; (module docstring ends)

(defmodule tourist/template
  (import template/render :refer [render-file])
  (import tourist/helpers :refer [html])
  (import httpd/types     :refer [Response])
  (import httpd/response  :refer [response])
  (export render-template render-html)

;;; __rt-empty -- internal: a heap-allocated "".
(defn __rt-empty [] : cstr
  ```c
  #include <stdlib.h>
  return (const char *)calloc(1, 1);
  ```)

;;; __rt-free -- internal: free a heap cstr.
(defn __rt-free [s : cstr] : void
  ```c
  #include <stdlib.h>
  free((void *)s);
  ```)

;;; render-template -- render a template file against an Env.
;;;
;;; Reads the template at path (relative to the working directory) and
;;; renders it against env.  The result is always heap-allocated -- an empty
;;; string when the file cannot be read -- and the caller frees it; a route
;;; that just answers with the page wants render-html, which frees it for you.
;;;
;;; Parameters:
;;;   path -- path to the template file, e.g. "views/greet.html.tur"
;;;   env  -- Env handle from env-new or make-env
;;;
;;; Returns:
;;;   :cstr -- rendered output, owned by the caller ("" on failure)
;;;
;;; Example:
;;;   (render-template "views/index.html.tur" e)  ; => "<p>Hello, alice!</p>"
;;;
;;; Since: v0.1.0 (always heap-allocated since tourist-on-stdlib-httpd H5)
(defn render-template [path : cstr env : int] : cstr
  ;; render-file's Result is a concrete (Result cstr cstr), passed by value:
  ;; read it with ok? / ok-val (this used to free() it as if it were a heap
  ;; box, which is a stack address).
  (let [r (render-file path env)]
    (if (ok? r) (ok-val r) (__rt-empty))))

;;; render-html -- answer with a rendered template.
;;;
;;; Renders the template at path against env into a 200 text/html Response;
;;; when the file cannot be read, a 500 text/plain naming the error.  The
;;; rendered text is freed once it is copied into the Response.  env stays
;;; the caller's.
;;;
;;; Parameters:
;;;   path -- path to the template file
;;;   env  -- Env handle
;;;
;;; Returns:
;;;   Response -- for the route to return
;;;
;;; Example:
;;;   (get! "/" (fn [ctx] (render-html "views/index.html.tur" site-env)))
;;;
;;; Since: tourist-on-stdlib-httpd H5
(defn render-html [path : cstr env : int] : Response
  (let [r (render-file path env)]
    (if (ok? r)
      (let [page (ok-val r)
            resp (html page)]
        (__rt-free page)
        resp)
      (response 500 "text/plain" (err-val r)))))

) ;; end defmodule tourist/template
