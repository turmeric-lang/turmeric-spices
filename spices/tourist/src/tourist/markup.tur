;;; tourist/markup -- answer with markup built in the source (requires
;;; tur-dom-core, and tur-html for its literals).
;;;
;;; html-response answers with anything that has a `RenderHtml` instance: an
;;; `#html{...}` Fragment, a hiccup `Html` tree or a `#html-live{...}`
;;; evaluation. Their values were escaped when they were built, so the page
;;; is safe to send whatever the request held. `render-html` (tourist/template)
;;; stays for views kept in template files.
;;;
;;; Only available when tur-dom-core is declared as a :spices dep in the
;;; consumer's build.tur (and tur-html, to write the literals).
;;;
;;; Since: 0.3.0
;; (module docstring ends)
(defmodule tourist/markup
  (import dom/holes :refer [Fragment])
  (import tourist/helpers :refer [html])
  (import httpd/types :refer [Response])
  (export html-response)
  ;;; __mk-free -- internal: free a heap cstr.
  (defn __mk-free [s : cstr] : nil
    ```c
    #include <stdlib.h>
  free((void *)s);
  ```)
  ;;; html-response -- answer 200 text/html with a page built in the source.
  ;;;
  ;;; The markup is copied into the Response; the value stays the caller's
  ;;; (free a Fragment with `fragment-free` when it is done with).
  ;;;
  ;;; Parameters:
  ;;;   page -- an `#html{...}` Fragment, a hiccup `Html`, a `LiveHtml`, or
  ;;;           any other type with a `RenderHtml` instance
  ;;;
  ;;; Returns:
  ;;;   Response -- for the route to return
  ;;;
  ;;; Example:
  ;;;   (get! "/hi/:name" (fn [ctx] (html-response #html{<p>Hi, ${(name-of ctx)}!</p>})))
  ;;;
  ;;; Since: 0.3.0
  (defn html-response [^RenderHtml T] [page : T] : Response
    (let [m    (to-html-markup page)
          resp (html m)]
      (__mk-free m)
      resp))) ;; end defmodule tourist/markup
