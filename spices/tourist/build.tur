(defpackage tur-tourist
  :name        "tur-tourist"
  :version     "0.3.0"
  :description "Sinatra/scotty-style HTTP micro-framework"
  :license     "MIT"
  :spices #map{
    "httpd"    #map{:path   "../httpd"
                :url    "https://github.com/turmeric-lang/turmeric-spices"
                :ref    "v0.1.0"
                :subdir "spices/httpd"}
    "template" #map{:path   "../template"
                :url    "https://github.com/turmeric-lang/turmeric-spices"
                :ref    "v0.1.0"
                :subdir "spices/template"
                :optional true}
    "test"     #map{:path   "../test"
                    :url "https://github.com/turmeric-lang/turmeric-spices"
                    :ref "test-v0.1.0"
                    :subdir "spices/test"
                    :optional true}
    "http"     #map{:path "../http"
                    :url "https://github.com/turmeric-lang/turmeric-spices"
                    :ref "http-v0.1.0"
                    :subdir "spices/http"
                    :optional true}
  }
  :exports #map{
    "tourist/app"        ["tourist" "tourist-conn" "tourist-request-conn"
                          "TouristOpts" "default-tourist-opts" "tourist-opts"
                          "tourist-with" "tourist-conn-with"]
    "tourist/dsl"        ["get!" "post!" "put!" "delete!" "any!"]
    "tourist/param"      ["param" "capture" "req-full-path"
                          "ctx-attr-get" "ctx-attr-set!" "ctx-add-header!"
                          "tourist-ctx-req"]
    "tourist/helpers"    ["text" "html" "json-body" "redirect" "status"]
    "tourist/middleware" ["use!" "use-around!" "use-after!"]
    "tourist/static"     ["serve-static!"]
    "tourist/request"    ["req-cookie" "set-cookie!" "form-param"
                          "Part" "req-file" "part-name" "part-filename"
                          "part-content-type" "part-data" "part-data-len"
                          "req-ip" "req-proto" "req-id"
                          "basic-auth" "auth-user" "body-limit" "guarded"]
    "tourist/routing"    ["url-map!" "cascade!" "cascade-with!" "mount!"]
    "tourist/template"   ["render-template"]
    "tourist/types"      ["Ctx" "Item" "Mount"]
  })
