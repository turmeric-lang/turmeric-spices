(defpackage tur-sqlite
  :name "tur-sqlite"
  :version "0.3.0"
  :description "SQLite3 bindings for Turmeric"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :cmake-deps #map{"sqlite3" #map{:url "https://github.com/sqlite/sqlite"
                                  :ref "version-3.47.2"
                                  :options #map{:BUILD_SHARED_LIBS "OFF"}}}
  :exports #map{"sqlite/db" ["Db"
                             "Stmt"
                             "db-open"
                             "db-close"
                             "db-exec"
                             "db-query"
                             "db-prepare"]
                "sqlite/stmt" ["stmt-step"
                               "stmt-bind-int"
                               "stmt-bind-real"
                               "stmt-bind-text"
                               "stmt-bind-null"
                               "stmt-reset"
                               "stmt-finalize"]
                "sqlite/row" ["row-get"
                              "row-keys"
                              "col-count"
                              "col-name"
                              "col-int"
                              "col-real"
                              "col-text"
                              "col-type"]
                "sqlite/typed" ["TStmt"
                                "tstmt-of"
                                "tstmt-handle"
                                "tstmt-bind-int"
                                "tstmt-bind-real"
                                "tstmt-bind-text"
                                "tstmt-bind-null"
                                "tstmt-step"
                                "tstmt-reset"
                                "tstmt-finalize"
                                "tcol-count"
                                "tcol-name"
                                "tcol-int"
                                "tcol-real"
                                "tcol-text"
                                "tcol-type"]})
