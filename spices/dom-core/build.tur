(defpackage tur-dom-core
  :name        "tur-dom-core"
  :version     "0.1.0"
  :description "Shared Document/Node tree and SAX event vocabulary for tur-xml and tur-html"
  :license     "MIT"
  :spices #map{
    "test" #map{:path   "../test"
                :url    "https://github.com/turmeric-lang/turmeric-spices"
                :ref    "test-v0.1.0"
                :subdir "spices/test"
                :optional true}
  }
  ;; No :cmake-deps: the tree is ~700 lines of plain C vendored under c/.
  ;; :c-sources propagate across the :spices closure, so tur-xml and tur-html
  ;; (which depend on this spice) link turdom.c into their binaries too.
  :build-opts #map{
    :c-includes ["c"]
    :c-sources  ["c/dom/turdom.c"]
  }
  :exports #map{
    "dom/ownstr" ["String" "from-cstr" "adopt-cstr" "to-cstr" "retain"
                  "release" "str-len" "string=?" "ownstr-autolink"]
    "dom/core"   ["Document" "Node" "NodeKind" "SourcePos" "ParseError"
                  "ParseErrorKind" "dom-live-bytes"
                  "DocumentNode" "ElementNode" "TextNode" "CommentNode"
                  "CdataNode" "PiNode" "DoctypeNode"
                  "Syntax" "Limit" "Refused" "Io"
                  "syntax-kind" "limit-kind" "refused-kind" "io-kind"
                  "dom-root" "dom-node" "dom-free" "dom-serialize" "dom-equal?"
                  "dom-node-count"
                  "node-kind" "node-element?" "node-name" "node-local-name"
                  "node-ns-uri" "node-value" "node-text" "node-attr"
                  "node-attr-count" "node-attr-name-at" "node-attr-value-at"
                  "node-children" "node-child-count" "node-first-child"
                  "node-last-child" "node-next-sibling" "node-prev-sibling"
                  "node-parent" "node-document" "node-pos" "node-depth"
                  "node-matches?" "find-all" "find-first"
                  "parse-error-message" "parse-error-release"
                  "parse-error-pos"]
    "dom/event"  ["SaxEvent" "SaxControl" "Attr" "sax-event-release"
                  "sax-dispatch"
                  "attrs-get"
                  "StartElement" "EndElement" "Chars" "Comment" "Pi"
                  "StartCdata" "EndCdata" "Doctype" "Continue" "Stop"]
  })
