(defpackage tur-dom-core
  :name "tur-dom-core"
  :version "0.3.0"
  :description "Shared Document/Node tree and SAX event vocabulary for tur-xml and tur-html"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  ;; No :cmake-deps: the tree is plain C vendored under c/.
  ;; :c-sources propagate across the :spices closure, so tur-xml and tur-html
  ;; (which depend on this spice) link turdom.c into their binaries too.
  :build-opts #map{:c-includes ["c"]
                   :c-sources ["c/dom/turdom.c" "c/dom/turmarkup.c"]}
  :exports #map{"dom/ownstr" ["String"
                              "from-cstr"
                              "adopt-cstr"
                              "to-cstr"
                              "retain"
                              "release"
                              "str-len"
                              "string=?"
                              "ownstr-autolink"]
                "dom/core" ["Document"
                            "Node"
                            "NodeKind"
                            "SourcePos"
                            "ParseError"
                            "ParseErrorKind"
                            "dom-live-bytes"
                            "DocumentNode"
                            "ElementNode"
                            "TextNode"
                            "CommentNode"
                            "CdataNode"
                            "PiNode"
                            "DoctypeNode"
                            "Syntax"
                            "Limit"
                            "Refused"
                            "Io"
                            "syntax-kind"
                            "limit-kind"
                            "refused-kind"
                            "io-kind"
                            "dom-root"
                            "dom-node"
                            "dom-free"
                            "dom-serialize"
                            "dom-equal?"
                            "dom-node-count"
                            "node-kind"
                            "node-element?"
                            "node-name"
                            "node-local-name"
                            "node-ns-uri"
                            "node-value"
                            "node-text"
                            "node-attr"
                            "node-attr-count"
                            "node-attr-name-at"
                            "node-attr-value-at"
                            "node-children"
                            "node-child-count"
                            "node-first-child"
                            "node-last-child"
                            "node-next-sibling"
                            "node-prev-sibling"
                            "node-parent"
                            "node-document"
                            "node-pos"
                            "node-depth"
                            "node-matches?"
                            "find-all"
                            "find-first"
                            "parse-error-message"
                            "parse-error-release"
                            "parse-error-pos"]
                "dom/edit" ["DomFlavor"
                            "XmlFlavor"
                            "HtmlFlavor"
                            "EditError"
                            "WrongDocument"
                            "WouldCycle"
                            "NotAContainer"
                            "BadPlacement"
                            "Detached"
                            "WrongKind"
                            "BadName"
                            "BadContent"
                            "OutOfMemory"
                            "edit-error-message"
                            "dom-new"
                            "dom-flavor"
                            "create-element"
                            "create-element-ns"
                            "create-text"
                            "create-comment"
                            "create-cdata"
                            "create-pi"
                            "node-import"
                            "node-clone"
                            "node-append!"
                            "node-prepend!"
                            "node-insert-before!"
                            "node-insert-after!"
                            "node-replace!"
                            "node-remove!"
                            "node-unwrap!"
                            "set-attr!"
                            "set-attr-ns!"
                            "remove-attr!"
                            "set-text!"
                            "set-value!"
                            "rename!"
                            "rename-ns!"
                            "node-normalize!"
                            "dom-garbage-bytes"
                            "dom-compact"
                            "node-attached?"]
                "dom/event" ["SaxEvent"
                             "SaxControl"
                             "Attr"
                             "sax-event-release"
                             "sax-event-retain"
                             "sax-dispatch"
                             "attrs-get"
                             "StartElement"
                             "EndElement"
                             "Chars"
                             "Comment"
                             "Pi"
                             "StartCdata"
                             "EndCdata"
                             "Doctype"
                             "Continue"
                             "Stop"]
                "dom/holes" ["Fragment"
                             "XmlFragment"
                             "RawHtml"
                             "TrustedUrl"
                             "Child"
                             "ChildText"
                             "ChildHtml"
                             "ChildXml"
                             "ChildRaw"
                             "ChildList"
                             "ChildEmpty"
                             "AttrVal"
                             "AttrText"
                             "AttrTrusted"
                             "AttrOn"
                             "AttrOff"
                             "Hole"
                             "HoleChild"
                             "HoleAttr"
                             "raw-html"
                             "raw-html-markup"
                             "trusted-url"
                             "url-safe"
                             "srcset-check"
                             "html->string"
                             "xml->string"
                             "fragment-free"
                             "xml-fragment-free"
                             "hole-child"
                             "hole-attr"
                             "render-template"
                             "template-checked?"
                             "template-check-markup"
                             "template-verify"
                             "template-parent"]
                "dom/markupc" ["markup-expand"]
                "dom/writer" ["SaxWriter"
                              "WriteError"
                              "Rejected"
                              "IoFailed"
                              "write-error-message"
                              "TransformError"
                              "InputError"
                              "OutputError"
                              "transform-error-message"
                              "transform-error-release"
                              "sax-writer-new"
                              "sax-writer-to-file"
                              "sax-write!"
                              "sax-write-all!"
                              "sax-writer-finish!"
                              "sax-writer-free"
                              "sax-transform-handler"
                              "sax-keep"]})
