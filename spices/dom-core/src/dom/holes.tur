;;; dom/holes -- what a markup literal's holes accept, and how they render.
;;;
;;; The shared half of tur-html's `#html{...}` and tur-xml's `#xml{...}`
;;; (xml-html-followups-plan follow-up A). A hole's POSITION picks a class --
;;; content takes `ToChild`, an attribute value `ToAttr`, a URL-bearing
;;; attribute (`href`, `src`, `action`, `formaction`, `xlink:href`, `poster`,
;;; `cite`, `srcset`) `ToUrlAttr` -- and the value's TYPE picks the instance:
;;;
;;;   ToChild    cstr, String, int -- text, escaped; Fragment / XmlFragment --
;;;              a nested literal, spliced as markup; Node -- serialized in;
;;;              RawHtml -- unescaped, see `raw-html`; (Option T) -- None
;;;              renders nothing; (Cons T) -- each element in order
;;;   ToAttr     cstr, String, int -- escaped; bool -- present or absent (an
;;;              HTML boolean attribute); (Option T) -- None drops the attribute
;;;   ToUrlAttr  cstr, String -- scheme-checked, then escaped; TrustedUrl --
;;;              escaped, not checked, see `trusted-url`; (Option T)
;;;
;;; Holes in code (plan A6; HTML only): in an `on*` attribute or a `<script>`
;;; body the macro reads the JavaScript around the hole --
;;;
;;;   ToJs       expression position: int, bool, cstr, String, (Option T)
;;;              (None is `null`) as a JavaScript literal; TrustedJs as code
;;;   ToCodeText inside a quoted JavaScript string: cstr, String, int, each
;;;              character JS-escaped (< too, so no </script)
;;;
;;; -- and in a `style` attribute or a `<style>` body, the CSS:
;;;
;;;   ToCss      a property value: int; cstr / String kept only when every
;;;              character is a letter, a digit or one of `# . - _ % ,` and
;;;              space (else `tur-unsafe`, which the browser drops);
;;;              TrustedCss as written
;;;   ToCodeText inside a quoted CSS string: escaped to \HEX
;;;   ToUrlAttr  inside url(...): scheme-checked, then percent-encoded
;;;
;;; and `srcdoc="${x}"` takes ToSrcdoc: a Fragment's markup, a cstr / String
;;; as text, or a RawHtml's markup live in the iframe. Every other position
;;; in code (a template literal, a comment, a regex, after an ambiguous `/`, a
;;; selector, a property name) is a compile error.
;;;
;;; A Node or a Fragment in attribute position has no instance, so it is a
;;; type error at the hole. Escaping is by construction: the only ways to put
;;; unescaped markup in are `raw-html` and nested literals, and the only way
;;; around the URL check is `trusted-url` -- both greppable, as are
;;; `trusted-js` and `trusted-css` for code.
;;;
;;; Memory: a Fragment owns its markup (malloc'd). Splicing it into another
;;; literal copies it; `fragment-free` releases one that is done with.
;;;
;;; Since: 0.3.0
;; Runtime support for markup literals over c/dom/turmarkup.c.
(defmodule dom/holes
  (export Fragment
    XmlFragment
    RawHtml
    TrustedUrl
    Child
    ChildText
    ChildHtml
    ChildXml
    ChildRaw
    ChildList
    ChildEmpty
    AttrVal
    AttrText
    AttrTrusted
    AttrOn
    AttrOff
    Hole
    HoleChild
    HoleAttr
    HoleCode
    TrustedJs
    TrustedCss
    trusted-js
    trusted-css
    hole-code
    js-string-escape
    js-pad
    css-string-escape
    css-url-escape
    template-code-ok?
    raw-html
    raw-html-markup
    trusted-url
    url-safe
    srcset-check
    html->string
    xml->string
    fragment-free
    xml-fragment-free
    hole-child
    hole-attr
    render-template
    template-checked?
    template-check-markup
    template-verify
    template-parent
    child-markup
    attr-state
    attr-raw)
  (import dom/ownstr :refer [String to-cstr adopt-cstr release])
  (import dom/core :refer [Node dom-serialize node-document])
  (import dom/edit :refer [DomFlavor XmlFlavor HtmlFlavor dom-flavor])
  ;;; Fragment -- the rendered markup of an `#html{...}` literal: safe to put
  ;;; anywhere HTML content goes, by construction.
  (defopaque Fragment :ptr<void>)
  ;;; XmlFragment -- the rendered markup of an `#xml{...}` literal.
  (defopaque XmlFragment :ptr<void>)
  ;;; RawHtml -- markup a caller vouches for; see `raw-html`.
  (defopaque RawHtml :ptr<void>)
  ;;; TrustedUrl -- a URL a caller vouches for; see `trusted-url`.
  (defopaque TrustedUrl :ptr<void>)
  ;;; TrustedJs -- JavaScript a caller vouches for; see `trusted-js`.
  (defopaque TrustedJs :ptr<void>)
  ;;; TrustedCss -- CSS a caller vouches for; see `trusted-css`.
  (defopaque TrustedCss :ptr<void>)
  ;;; Child -- what a content hole renders: text to escape, markup of either
  ;;; flavour, raw markup to parse in the hole's context, several of those in
  ;;; order, or nothing.
  (defdata ^copy Child
    (ChildText cstr)
    (ChildHtml cstr)
    (ChildXml cstr)
    (ChildRaw cstr)
    (ChildList (Cons Child))
    (ChildEmpty))
  ;;; AttrVal -- what an attribute hole renders: a value to escape (checked or
  ;;; trusted), or a boolean attribute present (`AttrOn`) or absent
  ;;; (`AttrOff`). Absent drops the whole attribute when the hole is its whole
  ;;; value; inside a larger value, on renders `true` and off nothing.
  (defdata ^copy AttrVal (AttrText cstr) (AttrTrusted cstr) (AttrOn) (AttrOff))
  ;;; Hole -- one hole's value, as the renderer receives it. `HoleCode` is a
  ;;; code hole's value, already escaped for JavaScript or CSS (plan A6).
  (defdata ^copy Hole (HoleChild Child) (HoleAttr AttrVal) (HoleCode cstr))
  ;;; hole-child -- internal: a content hole (what the macro emits).
  (defn hole-child [c : Child] : Hole (HoleChild c))
  ;;; hole-attr -- internal: an attribute hole (what the macro emits).
  (defn hole-attr [a : AttrVal] : Hole (HoleAttr a))
  ;;; hole-code -- internal: a code hole, its value escaped for its language.
  (defn hole-code [s : cstr] : Hole (HoleCode s))
  ;; ---------------------------------------------------------------------------
  ;; Raw helpers
  ;; ---------------------------------------------------------------------------
  ;;; __as-cstr -- internal: an opaque's pointer as a cstr.
  (defn __as-cstr [p : ptr<void>] : cstr
    ```c
    return (const char *)p;
  ```)
  ;;; __as-ptr -- internal: a cstr as a pointer.
  (defn __as-ptr [s : cstr] : ptr<void>
    ```c
    return (void *)s;
  ```)
  ;;; __dup -- internal: a malloc'd copy.
  (defn __dup [s : cstr] : cstr
    ```c
    size_t n = strlen((const char *)s);
  char *d = (char *)malloc(n + 1);
  if (!d) abort();
  memcpy(d, s, n + 1);
  return d;
  ```)
  ;;; __itoa -- internal: decimal text, malloc'd.
  (defn __itoa [v : int] : cstr
    ```c
    char *b = (char *)malloc(24);
  if (!b) abort();
  snprintf(b, 24, "%lld", (long long)v);
  return b;
  ```)
  ;;; __mb-new -- internal: a markup buffer.
  (defn __mb-new [] : ptr<void>
    ```c
    extern void *turdom_mbuf_new(void);
  return turdom_mbuf_new();
  ```)
  ;;; __mb-put -- internal: append verbatim.
  (defn __mb-put [b : ptr<void> s : cstr] : nil
    ```c
    extern void turdom_mbuf_put(void *, const char *);
  turdom_mbuf_put(b, (const char *)s);
  ```)
  ;;; __mb-put-esc -- internal: append escaped text or attribute value.
  (defn __mb-put-esc [b : ptr<void> s : cstr attr : bool html : bool] : nil
    ```c
    extern void turdom_mbuf_put_escaped(void *, const char *, int, int);
  turdom_mbuf_put_escaped(b, (const char *)s, attr ? 1 : 0, html ? 1 : 0);
  ```)
  ;;; __mb-finish -- internal: the buffer's text, malloc'd.
  (defn __mb-finish [b : ptr<void>] : cstr
    ```c
    extern char *turdom_mbuf_finish(void *);
  return turdom_mbuf_finish(b);
  ```)
  ;; ---------------------------------------------------------------------------
  ;; The opt-outs and the URL check
  ;; ---------------------------------------------------------------------------
  ;;; raw-html -- mark markup as trusted, for a content hole. UNSAFE.
  ;;;
  ;;; In a content hole the markup is PARSED in the hole's own context
  ;;; (its parent element) and the parsed nodes are written back, so it can
  ;;; never unbalance the surrounding literal -- an extra `</div>` cannot close
  ;;; anything outside it. It is NOT sanitized: a `<script>`, an `onerror`
  ;;; handler or a `javascript:` URL in it survives and runs. Never pass it
  ;;; markup an untrusted party wrote. In an `#xml{...}` literal the markup
  ;;; must be well-formed XML content.
  ;;;
  ;;; Parameters:
  ;;;   s -- the markup; copied
  ;;;
  ;;; Returns:
  ;;;   RawHtml
  ;;;
  ;;; Example:
  ;;;   #html{<div class="post">${(raw-html rendered-markdown)}</div>}
  ;;;
  ;;; Since: 0.3.0
  (defn raw-html [s : cstr] : RawHtml (:: (__as-ptr (__dup s)) RawHtml))
  ;;; raw-html-markup -- the markup a RawHtml holds.
  ;;;
  ;;; Parameters:
  ;;;   r -- the value
  ;;;
  ;;; Returns:
  ;;;   cstr -- borrowed from r
  ;;;
  ;;; Example:
  ;;;   (raw-html-markup (raw-html "<b>x</b>"))   ; => "<b>x</b>"
  ;;;
  ;;; Since: 0.3.0
  (defn raw-html-markup [r : RawHtml] : cstr (__as-cstr (:: r ptr<void>)))
  ;;; trusted-url -- mark a URL as trusted, skipping the scheme check. UNSAFE.
  ;;;
  ;;; The value is still escaped for its attribute; only the scheme allowlist
  ;;; (`url-safe`) is skipped, so a `javascript:` URL passes. For URLs the
  ;;; program made itself.
  ;;;
  ;;; Parameters:
  ;;;   s -- the URL; copied
  ;;;
  ;;; Returns:
  ;;;   TrustedUrl
  ;;;
  ;;; Example:
  ;;;   #html{<a href=${(trusted-url "javascript:history.back()")}>back</a>}
  ;;;
  ;;; Since: 0.3.0
  (defn trusted-url [s : cstr] : TrustedUrl
    (:: (__as-ptr (__dup s)) TrustedUrl))
  ;;; __url-safe-raw -- internal.
  (defn __url-safe-raw [s : cstr] : cstr
    ```c
    extern const char *turdom_url_safe(const char *);
  return turdom_url_safe((const char *)s);
  ```)
  ;;; url-safe -- a URL, or `about:invalid#tur-unsafe` when its scheme is not
  ;;; allowed.
  ;;;
  ;;; Leading spaces and C0 controls are stripped and ASCII tab, LF and CR
  ;;; dropped anywhere, as a browser's URL parser does; then a relative URL
  ;;; (no scheme) or one with scheme `http`, `https`, `mailto` or `tel` (any
  ;;; case) passes. Everything else -- `javascript:`, `data:`, `vbscript:`,
  ;;; the next one -- becomes the dead URL. A scheme check is not
  ;;; sanitization: an `https:` URL to a hostile site passes, as it should.
  ;;;
  ;;; Parameters:
  ;;;   s -- the URL
  ;;;
  ;;; Returns:
  ;;;   cstr -- `s` itself or the dead URL (both borrowed)
  ;;;
  ;;; Example:
  ;;;   (url-safe "JavaScript:alert(1)")   ; => "about:invalid#tur-unsafe"
  ;;;
  ;;; Since: 0.3.0
  (defn url-safe [s : cstr] : cstr (__url-safe-raw s))
  ;;; __srcset-raw -- internal: a malloc'd checked srcset.
  (defn __srcset-raw [s : cstr] : cstr
    ```c
    extern char *turdom_srcset_safe(const char *);
  return turdom_srcset_safe((const char *)s);
  ```)
  ;;; srcset-check -- check every candidate URL of a `srcset` value.
  ;;;
  ;;; What the macro wraps around a `srcset` hole: an unchecked value has
  ;;; each comma-separated candidate's URL passed through `url-safe`.
  ;;;
  ;;; Parameters:
  ;;;   a -- the hole's value
  ;;;
  ;;; Returns:
  ;;;   AttrVal -- trusted values and booleans unchanged.
  ;;;
  ;;; Example:
  ;;;   (srcset-check (AttrText "a.png 1x, javascript:x 2x"))
  ;;;
  ;;; Since: 0.3.0
  (defn srcset-check [a : AttrVal] : AttrVal
    (match a
      (AttrText s)
      (AttrText (__srcset-raw s))
      (AttrTrusted s)
      (AttrTrusted s)
      (AttrOn)
      (AttrOn)
      (AttrOff)
      (AttrOff)))
  ;; ---------------------------------------------------------------------------
  ;; Fragments
  ;; ---------------------------------------------------------------------------
  ;;; html->string -- the markup of an `#html{...}` literal.
  ;;;
  ;;; Parameters:
  ;;;   f -- the fragment
  ;;;
  ;;; Returns:
  ;;;   cstr -- borrowed from f (valid until `fragment-free`)
  ;;;
  ;;; Example:
  ;;;   (println (html->string #html{<p>${name}</p>}))
  ;;;
  ;;; Since: 0.3.0
  (defn html->string [f : Fragment] : cstr (__as-cstr (:: f ptr<void>)))
  ;;; xml->string -- the markup of an `#xml{...}` literal.
  ;;;
  ;;; Parameters:
  ;;;   f -- the fragment
  ;;;
  ;;; Returns:
  ;;;   cstr -- borrowed from f (valid until `xml-fragment-free`)
  ;;;
  ;;; Example:
  ;;;   (println (xml->string #xml{<item>${name}</item>}))
  ;;;
  ;;; Since: 0.3.0
  (defn xml->string [f : XmlFragment] : cstr (__as-cstr (:: f ptr<void>)))
  ;;; __free -- internal.
  (defn __free [p : ptr<void>] : nil
    ```c
    free(p);
  ```)
  ;;; fragment-free -- release a Fragment's markup.
  ;;;
  ;;; Optional: a Fragment that lives as long as the program need not be
  ;;; freed. A long-running server freeing each page's Fragment once it is
  ;;; written keeps its memory flat.
  ;;;
  ;;; Parameters:
  ;;;   f -- the fragment, not used afterwards
  ;;;
  ;;; Example:
  ;;;   (fragment-free page)
  ;;;
  ;;; Since: 0.3.0
  (defn fragment-free [f : Fragment] : nil (__free (:: f ptr<void>)))
  ;;; xml-fragment-free -- release an XmlFragment's markup.
  ;;;
  ;;; Parameters:
  ;;;   f -- the fragment, not used afterwards
  ;;;
  ;;; Example:
  ;;;   (xml-fragment-free feed)
  ;;;
  ;;; Since: 0.3.0
  (defn xml-fragment-free [f : XmlFragment] : nil (__free (:: f ptr<void>)))
  ;; ---------------------------------------------------------------------------
  ;; The classes
  ;; ---------------------------------------------------------------------------
  ;;; ToChild -- a value that can fill a content hole.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-child -- the value as a Child
  ;;;
  ;;; Example:
  ;;;   (to-child "a < b")   ; => (ChildText "a < b"), escaped when rendered
  ;;;
  ;;; Since: 0.3.0
  (defclass ToChild [T] (to-child [x : T] : Child))
  ;;; ToAttr -- a value that can fill an attribute-value hole.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-attr -- the value as an AttrVal
  ;;;
  ;;; Example:
  ;;;   (to-attr true)   ; => (AttrOn)
  ;;;
  ;;; Since: 0.3.0
  (defclass ToAttr [T] (to-attr [x : T] : AttrVal))
  ;;; ToUrlAttr -- a value that can fill a URL-bearing attribute's hole.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-url-attr -- the value as an AttrVal, scheme-checked unless trusted
  ;;;
  ;;; Example:
  ;;;   (to-url-attr "javascript:x")   ; => (AttrText "about:invalid#tur-unsafe")
  ;;;
  ;;; Since: 0.3.0
  (defclass ToUrlAttr [T] (to-url-attr [x : T] : AttrVal))
  ;;; ToChild [cstr] -- text, escaped.
  (definstance ToChild [cstr] (to-child [x] (ChildText x)))
  ;;; ToChild [String] -- text, escaped.
  (definstance ToChild [String] (to-child [x] (ChildText (to-cstr x))))
  ;;; ToChild [int] -- decimal text.
  (definstance ToChild [int] (to-child [x] (ChildText (__itoa x))))
  ;;; ToChild [Fragment] -- a nested #html{} literal, spliced in.
  (definstance ToChild [Fragment] (to-child [x] (ChildHtml (html->string x))))
  ;;; ToChild [XmlFragment] -- a nested #xml{} literal, spliced in.
  (definstance ToChild [XmlFragment] (to-child [x] (ChildXml (xml->string x))))
  ;;; ToChild [RawHtml] -- raw markup, parsed in the hole's context.
  (definstance ToChild [RawHtml] (to-child [x] (ChildRaw (raw-html-markup x))))
  ;;; ToChild [(Option A)] -- None renders nothing.
  (definstance ToChild [(Option A)]
    [(ToChild A)]
    (to-child [x] (match x (Some v) (to-child v) (None) (ChildEmpty))))
  ;;; __children -- internal: each element of a list as a Child.
  ;;; (The parameter is E, not A: a parameter named like `tnil`'s own
  ;;; specializes the `(tnil)` below at `(Cons A)` -- reported in turmeric as
  ;;; generic-tyvar-captured-by-callee-signature.)
  (defn __children [^ToChild E] [xs : (Cons E)] : (Cons Child)
    (if (tnil? xs)
      (tnil)
      (tcons-of (to-child (thead xs)) (__children (ttail xs)))))
  ;;; ToChild [(Cons A)] -- the elements in order.
  (definstance ToChild [(Cons A)]
    [(ToChild A)]
    (to-child [x] (ChildList (__children x))))
  ;;; ToChild [Node] -- a node of a parsed or built tree, serialized in.
  (definstance ToChild [Node]
    (to-child [x]
      (let [s (dom-serialize x)
            m (__dup (to-cstr s))]
        (release s)
        (match (dom-flavor (node-document x))
          (HtmlFlavor)
          (ChildHtml m)
          (XmlFlavor)
          (ChildXml m)))))
  ;;; ToAttr [cstr] -- escaped.
  (definstance ToAttr [cstr] (to-attr [x] (AttrText x)))
  ;;; ToAttr [String] -- escaped.
  (definstance ToAttr [String] (to-attr [x] (AttrText (to-cstr x))))
  ;;; ToAttr [int] -- decimal.
  (definstance ToAttr [int] (to-attr [x] (AttrText (__itoa x))))
  ;;; ToAttr [bool] -- an HTML boolean attribute: present or absent.
  (definstance ToAttr [bool] (to-attr [x] (if x (AttrOn) (AttrOff))))
  ;;; ToAttr [(Option A)] -- None drops the attribute.
  (definstance ToAttr [(Option A)]
    [(ToAttr A)]
    (to-attr [x] (match x (Some v) (to-attr v) (None) (AttrOff))))
  ;;; ToUrlAttr [cstr] -- scheme-checked, then escaped.
  (definstance ToUrlAttr [cstr] (to-url-attr [x] (AttrText (url-safe x))))
  ;;; ToUrlAttr [String] -- scheme-checked, then escaped.
  (definstance ToUrlAttr [String]
    (to-url-attr [x] (AttrText (url-safe (to-cstr x)))))
  ;;; ToUrlAttr [TrustedUrl] -- escaped, not checked.
  (definstance ToUrlAttr [TrustedUrl]
    (to-url-attr [x] (AttrTrusted (__as-cstr (:: x ptr<void>)))))
  ;;; ToUrlAttr [(Option A)] -- None drops the attribute.
  (definstance ToUrlAttr [(Option A)]
    [(ToUrlAttr A)]
    (to-url-attr [x] (match x (Some v) (to-url-attr v) (None) (AttrOff))))
  ;; ---------------------------------------------------------------------------
  ;; Code holes (plan A6)
  ;; ---------------------------------------------------------------------------
  ;;; trusted-js -- JavaScript code the caller vouches for.
  ;;;
  ;;; UNSAFE for anything built from untrusted input: in a code hole it is
  ;;; written as code, after only the attribute escaping (and, in a `<script>`
  ;;; body, a check that it cannot end the element).
  ;;;
  ;;; Parameters:
  ;;;   s -- the code (copied)
  ;;;
  ;;; Returns:
  ;;;   TrustedJs
  ;;;
  ;;; Example:
  ;;;   #html{<button onclick="${(trusted-js "history.back()")}">back</button>}
  ;;;
  ;;; Since: 0.3.0
  (defn trusted-js [s : cstr] : TrustedJs (:: (__as-ptr (__dup s)) TrustedJs))
  ;;; trusted-css -- CSS the caller vouches for.
  ;;;
  ;;; UNSAFE for anything built from untrusted input: in a CSS value hole it is
  ;;; written as it is, after only the attribute escaping (and, in a `<style>`
  ;;; body, a check that it cannot end the element).
  ;;;
  ;;; Parameters:
  ;;;   s -- the CSS (copied)
  ;;;
  ;;; Returns:
  ;;;   TrustedCss
  ;;;
  ;;; Example:
  ;;;   #html{<p style="background: ${(trusted-css "linear-gradient(red, blue)")}">x</p>}
  ;;;
  ;;; Since: 0.3.0
  (defn trusted-css [s : cstr] : TrustedCss
    (:: (__as-ptr (__dup s)) TrustedCss))
  ;;; js-string-escape -- text for the inside of a JavaScript string literal.
  ;;;
  ;;; Backslash, both quotes, backtick, `< > & =`, C0 controls, DEL and U+2028
  ;;; / U+2029 become `\uXXXX`.
  ;;;
  ;;; Parameters:
  ;;;   s -- the text
  ;;;
  ;;; Returns:
  ;;;   cstr -- malloc'd
  ;;;
  ;;; Example:
  ;;;   (js-string-escape "a'b")   ; => "a\u0027b"
  ;;;
  ;;; Since: 0.3.0
  (defn js-string-escape [s : cstr] : cstr
    ```c
    extern char *turdom_js_string_escape(const char *);
  return turdom_js_string_escape((const char *)s);
  ```)
  ;;; __js-quote -- internal: a double-quoted JavaScript string literal.
  (defn __js-quote [s : cstr] : cstr
    ```c
    extern char *turdom_js_quote(const char *);
  return turdom_js_quote((const char *)s);
  ```)
  ;;; js-pad -- internal: a JavaScript value with a space on each side.
  (defn js-pad [s : cstr] : cstr
    ```c
    extern char *turdom_js_pad(const char *);
  return turdom_js_pad((const char *)s);
  ```)
  ;;; __css-value -- internal: text as a CSS value, or tur-unsafe.
  (defn __css-value [s : cstr] : cstr
    ```c
    extern const char *turdom_css_value(const char *);
  return turdom_css_value((const char *)s);
  ```)
  ;;; css-string-escape -- text for the inside of a quoted CSS string.
  ;;;
  ;;; Every character but an ASCII letter or digit becomes `\HEX ` .
  ;;;
  ;;; Parameters:
  ;;;   s -- the text
  ;;;
  ;;; Returns:
  ;;;   cstr -- malloc'd
  ;;;
  ;;; Example:
  ;;;   (css-string-escape "a<b")   ; => "a\3c b"
  ;;;
  ;;; Since: 0.3.0
  (defn css-string-escape [s : cstr] : cstr
    ```c
    extern char *turdom_css_string_escape(const char *);
  return turdom_css_string_escape((const char *)s);
  ```)
  ;;; __css-url-raw -- internal.
  (defn __css-url-raw [s : cstr] : cstr
    ```c
    extern char *turdom_css_url_escape(const char *);
  return turdom_css_url_escape((const char *)s);
  ```)
  ;;; css-url-escape -- a checked URL for the inside of CSS `url(...)`.
  ;;;
  ;;; Takes what `to-url-attr` gives (so the scheme is checked unless the URL
  ;;; is a TrustedUrl) and percent-encodes parens, quotes, whitespace, `\`
  ;;; and `< >`.
  ;;;
  ;;; Parameters:
  ;;;   a -- the URL, through `to-url-attr`
  ;;;
  ;;; Returns:
  ;;;   cstr -- malloc'd
  ;;;
  ;;; Example:
  ;;;   (css-url-escape (to-url-attr "/a b.png"))   ; => "/a%20b.png"
  ;;;
  ;;; Since: 0.3.0
  (defn css-url-escape [a : AttrVal] : cstr
    (match a
      (AttrText s)
      (__css-url-raw s)
      (AttrTrusted s)
      (__css-url-raw s)
      (AttrOn)
      ""
      (AttrOff)
      ""))
  ;;; __html-text -- internal: text escaped as HTML content, malloc'd.
  (defn __html-text [s : cstr] : cstr
    (let [b (__mb-new)] (__mb-put-esc b s false true) (__mb-finish b)))
  ;;; ToJs -- a value that can fill a JavaScript hole in expression position.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-js -- the value as a JavaScript literal (TrustedJs: as code)
  ;;;
  ;;; Example:
  ;;;   #html{<button onclick="pick(${id}, ${name})">x</button>}
  ;;;
  ;;; Since: 0.3.0
  (defclass ToJs [T] (to-js [x : T] : cstr))
  ;;; ToJs [int] -- a decimal number.
  (definstance ToJs [int] (to-js [x] (__itoa x)))
  ;;; ToJs [bool] -- true or false.
  (definstance ToJs [bool] (to-js [x] (if x "true" "false")))
  ;;; ToJs [cstr] -- a double-quoted string, every risky character escaped.
  (definstance ToJs [cstr] (to-js [x] (__js-quote x)))
  ;;; ToJs [String] -- a double-quoted string.
  (definstance ToJs [String] (to-js [x] (__js-quote (to-cstr x))))
  ;;; ToJs [TrustedJs] -- the code itself.
  (definstance ToJs [TrustedJs] (to-js [x] (__as-cstr (:: x ptr<void>))))
  ;;; ToJs [(Option A)] -- null, or the value.
  (definstance ToJs [(Option A)]
    [(ToJs A)]
    (to-js [x] (match x (Some v) (to-js v) (None) "null")))
  ;;; ToCodeText -- a value that can fill a hole inside a quoted JavaScript or
  ;;; CSS string.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-code-text -- the value as text (escaped by the hole's language)
  ;;;
  ;;; Example:
  ;;;   #html{<button onclick="say('hi, ${name}')">x</button>}
  ;;;
  ;;; Since: 0.3.0
  (defclass ToCodeText [T] (to-code-text [x : T] : cstr))
  ;;; ToCodeText [cstr] -- as it is.
  (definstance ToCodeText [cstr] (to-code-text [x] x))
  ;;; ToCodeText [String] -- its text.
  (definstance ToCodeText [String] (to-code-text [x] (to-cstr x)))
  ;;; ToCodeText [int] -- decimal text.
  (definstance ToCodeText [int] (to-code-text [x] (__itoa x)))
  ;;; ToCss -- a value that can fill a CSS property-value hole.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-css -- the value as CSS (text filtered; TrustedCss as written)
  ;;;
  ;;; Example:
  ;;;   #html{<p style="color: ${c}; width: ${w}px">x</p>}
  ;;;
  ;;; Since: 0.3.0
  (defclass ToCss [T] (to-css [x : T] : cstr))
  ;;; ToCss [int] -- a decimal number.
  (definstance ToCss [int] (to-css [x] (__itoa x)))
  ;;; ToCss [cstr] -- kept when it is only letters, digits and `# . - _ % ,`
  ;;; and space; otherwise `tur-unsafe`.
  (definstance ToCss [cstr] (to-css [x] (__css-value x)))
  ;;; ToCss [String] -- as cstr.
  (definstance ToCss [String] (to-css [x] (__css-value (to-cstr x))))
  ;;; ToCss [TrustedCss] -- as written.
  (definstance ToCss [TrustedCss] (to-css [x] (__as-cstr (:: x ptr<void>))))
  ;;; ToSrcdoc -- a value that can be an iframe's whole `srcdoc`.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-srcdoc -- the document's markup (attribute-escaped when written)
  ;;;
  ;;; Example:
  ;;;   #html{<iframe srcdoc="${#html{<p>${x}</p>}}"></iframe>}
  ;;;
  ;;; Since: 0.3.0
  (defclass ToSrcdoc [T] (to-srcdoc [x : T] : AttrVal))
  ;;; ToSrcdoc [Fragment] -- the fragment's markup.
  (definstance ToSrcdoc [Fragment]
    (to-srcdoc [x] (AttrTrusted (html->string x))))
  ;;; ToSrcdoc [cstr] -- text in the iframe, never markup.
  (definstance ToSrcdoc [cstr] (to-srcdoc [x] (AttrTrusted (__html-text x))))
  ;;; ToSrcdoc [String] -- text in the iframe.
  (definstance ToSrcdoc [String]
    (to-srcdoc [x] (AttrTrusted (__html-text (to-cstr x)))))
  ;;; ToSrcdoc [RawHtml] -- markup live in the iframe, as raw-html asks.
  (definstance ToSrcdoc [RawHtml]
    (to-srcdoc [x] (AttrTrusted (raw-html-markup x))))
  ;;; RenderHtml -- a value that is a whole HTML response body.
  ;;;
  ;;; What a web framework takes to answer with HTML (tourist's
  ;;; `html-response`): an `#html{...}` Fragment here, and in tur-html a
  ;;; hiccup `Html` tree and a `#html-live{...}` evaluation.
  ;;;
  ;;; Parameters:
  ;;;   T -- the value's type
  ;;;
  ;;; Methods:
  ;;;   to-html-markup -- the markup, malloc'd; the caller frees it
  ;;;
  ;;; Example:
  ;;;   (let [m (to-html-markup #html{<p>${x}</p>})] (send m) (free m))
  ;;;
  ;;; Since: 0.3.0
  (defclass RenderHtml [T] (to-html-markup [x : T] : cstr))
  ;;; RenderHtml [Fragment] -- the literal's markup, copied.
  (definstance RenderHtml [Fragment]
    (to-html-markup [x] (__dup (html->string x))))
  ;; ---------------------------------------------------------------------------
  ;; Rendering a template (what tur-html's and tur-xml's literals call)
  ;; ---------------------------------------------------------------------------
  ;;; __tpl-static -- internal: append static text; the next marker or -1.
  (defn __tpl-static [b : ptr<void> tpl : cstr pos : int] : int
    ```c
    extern int64_t turdom_tpl_static(void *, const char *, int64_t);
  return turdom_tpl_static(b, (const char *)tpl, pos);
  ```)
  ;;; __tpl-kind -- internal: the marker's kind byte.
  (defn __tpl-kind [tpl : cstr pos : int] : int
    ```c
    extern int turdom_tpl_kind(const char *, int64_t);
  return turdom_tpl_kind((const char *)tpl, pos);
  ```)
  ;;; __tpl-after -- internal: the offset just past a marker.
  (defn __tpl-after [tpl : cstr pos : int] : int
    ```c
    extern int64_t turdom_tpl_after(const char *, int64_t);
  return turdom_tpl_after((const char *)tpl, pos);
  ```)
  ;;; __tpl-whole -- internal: write a whole-value attribute hole.
  (defn __tpl-whole [b : ptr<void>
                     tpl : cstr
                     pos : int
                     state : int
                     v : cstr
                     html : bool] : nil
    ```c
    extern void turdom_tpl_whole_attr(void *, const char *, int64_t, int, const char *, int);
  turdom_tpl_whole_attr(b, (const char *)tpl, pos, (int)state, (const char *)v, html ? 1 : 0);
  ```)
  ;;; template-parent -- the element child hole i of a checked literal sits in
  ;;; ("template" at the top level).
  ;;;
  ;;; Parameters:
  ;;;   tpl -- the template
  ;;;   i   -- the hole's index
  ;;;
  ;;; Returns:
  ;;;   cstr -- borrowed
  ;;;
  ;;; Example:
  ;;;   (template-parent tpl 0)   ; => "li"
  ;;;
  ;;; Since: 0.3.0
  (defn template-parent [tpl : cstr i : int] : cstr
    ```c
    extern const char *turdom_tpl_parent(const char *, int64_t);
  return turdom_tpl_parent((const char *)tpl, i);
  ```)
  ;;; __render-child -- internal.
  (defn __render-child [b : ptr<void>
                        tpl : cstr
                        i : int
                        c : Child
                        html : bool
                        raw-fix : (fn [cstr cstr] cstr)] : nil
    (match c
      (ChildText s)
      (__mb-put-esc b s false html)
      (ChildHtml s)
      (if html
        (__mb-put b s)
        (panic "an #html{} fragment (or HTML node) cannot go in an #xml{} literal"))
      (ChildXml s)
      (if html
        (panic "an #xml{} fragment (or XML node) cannot go in an #html{} literal")
        (__mb-put b s))
      (ChildRaw s)
      (__mb-put b (raw-fix s (template-parent tpl i)))
      (ChildList xs)
      (__render-children b tpl i xs html raw-fix)
      (ChildEmpty)
      nil))
  ;;; __render-children -- internal: a ChildList, in order.
  (defn __render-children [b : ptr<void>
                           tpl : cstr
                           i : int
                           xs : (Cons Child)
                           html : bool
                           raw-fix : (fn [cstr cstr] cstr)] : nil
    (if (tnil? xs)
      nil
      (do
        (__render-child b tpl i (thead xs) html raw-fix)
        (__render-children b tpl i (ttail xs) html raw-fix))))
  ;;; __render-attr -- internal.
  (defn __render-attr [b : ptr<void>
                       tpl : cstr
                       pos : int
                       a : AttrVal
                       html : bool] : nil
    (if (= (__tpl-kind tpl pos) 119)
      (match a
        (AttrText s)
        (__tpl-whole b tpl pos 2 s html)
        (AttrTrusted s)
        (__tpl-whole b tpl pos 2 s html)
        (AttrOn)
        (__tpl-whole b tpl pos 1 "" html)
        (AttrOff)
        (__tpl-whole b tpl pos 0 "" html))
      (match a
        (AttrText s)
        (__mb-put-esc b s true html)
        (AttrTrusted s)
        (__mb-put-esc b s true html)
        (AttrOn)
        (__mb-put b "true")
        (AttrOff)
        nil)))
  ;;; template-code-ok? -- may s fill code hole i of tpl as it is?
  ;;;
  ;;; Internal to the markup literals: a hole in a `<script>` or `<style>`
  ;;; body must not hold that element's end tag (nor, in a script, `<!--`).
  ;;; The escapers never produce one; a TrustedJs / TrustedCss value can.
  ;;;
  ;;; Parameters:
  ;;;   tpl -- the template
  ;;;   i   -- the hole's index
  ;;;   s   -- the hole's escaped value
  ;;;
  ;;; Returns:
  ;;;   bool
  ;;;
  ;;; Example:
  ;;;   (template-code-ok? tpl 0 "</script>")   ; => false
  ;;;
  ;;; Since: 0.3.0
  (defn template-code-ok? [tpl : cstr i : int s : cstr] : bool
    ```c
    extern int turdom_code_ok(const char *, int64_t, const char *);
  return turdom_code_ok((const char *)tpl, i, (const char *)s) != 0;
  ```)
  ;;; __render-code -- internal: a code hole's value, in its marker's layer.
  (defn __render-code [b : ptr<void>
                       tpl : cstr
                       pos : int
                       i : int
                       s : cstr
                       html : bool] : nil
    (let [k (__tpl-kind tpl pos)]
      (cond (= k 107) (__mb-put-esc b s true html)
            (= k 114) (if (template-code-ok? tpl i s)
                        (__mb-put b s)
                        (panic "a TrustedJs or TrustedCss value holds its element's end tag (or, in a <script>, <!--); it would end the element early"))
            :else     (panic "markup literal: a code value in a hole that is not a code hole"))))
  ;;; __render-loop -- internal: static text and holes, in order.
  (defn __render-loop [b : ptr<void>
                       tpl : cstr
                       pos : int
                       i : int
                       holes : (Cons Hole)
                       html : bool
                       raw-fix : (fn [cstr cstr] cstr)] : nil
    (let [m (__tpl-static b tpl pos)]
      (if (< m 0)
        nil
        (if (tnil? holes)
          (panic "markup literal: fewer hole values than holes")
          (do
            (match (thead holes)
              (HoleChild c)
              (__render-child b tpl i c html raw-fix)
              (HoleAttr a)
              (__render-attr b tpl m a html)
              (HoleCode s)
              (__render-code b tpl m i s html))
            (__render-loop b
              tpl
              (__tpl-after tpl m)
              (+ i 1)
              (ttail holes)
              html
              raw-fix))))))
  ;;; render-template -- render a literal's template with its hole values.
  ;;;
  ;;; Internal to the markup literals: tur-html's and tur-xml's renderers call
  ;;; it after checking the literal. `raw-fix` turns a RawHtml value into
  ;;; balanced markup for the hole's parent element.
  ;;;
  ;;; Parameters:
  ;;;   tpl     -- the template the macro produced
  ;;;   holes   -- the hole values, in order
  ;;;   html    -- HTML (true) or XML escaping and boolean attributes
  ;;;   raw-fix -- (raw markup, context element) -> markup
  ;;;
  ;;; Returns:
  ;;;   cstr -- the markup, malloc'd
  ;;;
  ;;; Example:
  ;;;   (render-template tpl holes true fix)
  ;;;
  ;;; Since: 0.3.0
  (defn render-template [tpl : cstr
                         holes : (Cons Hole)
                         html : bool
                         raw-fix : (fn [cstr cstr] cstr)] : cstr
    (let [b (__mb-new)]
      (__render-loop b tpl 0 0 holes html raw-fix)
      (__mb-finish b)))
  ;;; template-checked? -- has this literal been checked against the parser?
  ;;;
  ;;; Parameters:
  ;;;   tpl -- the template
  ;;;
  ;;; Returns:
  ;;;   bool
  ;;;
  ;;; Example:
  ;;;   (template-checked? tpl)   ; => true after its first render
  ;;;
  ;;; Since: 0.3.0
  (defn template-checked? [tpl : cstr] : bool
    ```c
    extern int turdom_tpl_checked(const char *);
  return turdom_tpl_checked((const char *)tpl) != 0;
  ```)
  ;;; template-check-markup -- the template as parseable markup, its holes
  ;;; marked (malloc'd).
  ;;;
  ;;; Parameters:
  ;;;   tpl -- the template
  ;;;
  ;;; Returns:
  ;;;   cstr -- markup with `__tur_hole_N__` markers
  ;;;
  ;;; Example:
  ;;;   (template-check-markup tpl)
  ;;;
  ;;; Since: 0.3.0
  (defn template-check-markup [tpl : cstr] : cstr
    ```c
    extern char *turdom_tpl_check_markup(const char *);
  return turdom_tpl_check_markup((const char *)tpl);
  ```)
  ;;; __verify-raw -- internal: NULL, or the malloc'd failure message.
  (defn __verify-raw [tpl : cstr top : Node] : cstr
    ```c
    extern char *turdom_tpl_verify(const char *, const void *);
  return turdom_tpl_verify((const char *)tpl, (const void *)(intptr_t)top);
  ```)
  ;;; __null-cstr? -- internal.
  (defn __null-cstr? [s : cstr] : bool
    ```c
    return s == NULL;
  ```)
  ;;; template-verify -- check the parsed check-markup against the template.
  ;;;
  ;;; Every hole marker must turn up exactly once, in the kind of slot the
  ;;; macro predicted. A disagreement means the macro's context tokenizer and
  ;;; the real parser read the literal differently, so it panics with the
  ;;; literal. On success the literal is recorded as checked.
  ;;;
  ;;; Parameters:
  ;;;   tpl -- the template
  ;;;   top -- the parsed `template-check-markup` (its document node)
  ;;;
  ;;; Example:
  ;;;   (template-verify tpl (dom-node d))
  ;;;
  ;;; Since: 0.3.0
  (defn template-verify [tpl : cstr top : Node] : nil
    (let [err (__verify-raw tpl top)] (if (__null-cstr? err) nil (panic err))))
  ;;; __put-child -- internal: append one Child's markup.
  (defn __put-child [b : ptr<void>
                     c : Child
                     html : bool
                     raw-fix : (fn [cstr cstr] cstr)
                     ctx : cstr] : nil
    (match c
      (ChildText s)
      (__mb-put-esc b s false html)
      (ChildHtml s)
      (if html
        (__mb-put b s)
        (panic "an #html{} fragment (or HTML node) cannot go in an #xml{} literal"))
      (ChildXml s)
      (if html
        (panic "an #xml{} fragment (or XML node) cannot go in an #html{} literal")
        (__mb-put b s))
      (ChildRaw s)
      (__mb-put b (raw-fix s ctx))
      (ChildList xs)
      (__put-children b xs html raw-fix ctx)
      (ChildEmpty)
      nil))
  ;;; __put-children -- internal.
  (defn __put-children [b : ptr<void>
                        xs : (Cons Child)
                        html : bool
                        raw-fix : (fn [cstr cstr] cstr)
                        ctx : cstr] : nil
    (if (tnil? xs)
      nil
      (do
        (__put-child b (thead xs) html raw-fix ctx)
        (__put-children b (ttail xs) html raw-fix ctx))))
  ;;; child-markup -- one content hole's value as markup, as a literal
  ;;; renders it (malloc'd).
  ;;;
  ;;; Internal to the live literals, which keep each hole's rendered markup to
  ;;; tell a changed hole from an unchanged one.
  ;;;
  ;;; Parameters:
  ;;;   c       -- the hole's value
  ;;;   html    -- HTML (true) or XML escaping
  ;;;   raw-fix -- what to do with a raw-html value
  ;;;   ctx     -- the element the hole sits in
  ;;;
  ;;; Returns:
  ;;;   cstr -- malloc'd markup
  ;;;
  ;;; Example:
  ;;;   (child-markup (to-child "a<b") true fix "p")   ; => "a&lt;b"
  ;;;
  ;;; Since: 0.3.0
  (defn child-markup [c : Child
                      html : bool
                      raw-fix : (fn [cstr cstr] cstr)
                      ctx : cstr] : cstr
    (let [b (__mb-new)] (__put-child b c html raw-fix ctx) (__mb-finish b)))
  ;;; attr-state -- an attribute value's state: 0 absent, 1 present (a
  ;;; boolean attribute), 2 a value.
  ;;;
  ;;; Parameters:
  ;;;   a -- the value
  ;;;
  ;;; Returns:
  ;;;   int
  ;;;
  ;;; Example:
  ;;;   (attr-state (AttrOff))   ; => 0
  ;;;
  ;;; Since: 0.3.0
  (defn attr-state [a : AttrVal] : int
    (match a (AttrText _) 2 (AttrTrusted _) 2 (AttrOn) 1 (AttrOff) 0))
  ;;; attr-raw -- an attribute value's text, unescaped ("" for a boolean).
  ;;;
  ;;; Parameters:
  ;;;   a -- the value
  ;;;
  ;;; Returns:
  ;;;   cstr -- borrowed
  ;;;
  ;;; Example:
  ;;;   (attr-raw (AttrText "a&b"))   ; => "a&b"
  ;;;
  ;;; Since: 0.3.0
  (defn attr-raw [a : AttrVal] : cstr
    (match a (AttrText s) s (AttrTrusted s) s (AttrOn) "" (AttrOff) ""))) ;; end defmodule dom/holes
