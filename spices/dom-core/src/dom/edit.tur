;;; dom/edit -- edit a Document in place, validated so edits cannot inject
;;; structure.
;;;
;;; The tree under a `Document` is an arena: nothing in it is freed before
;;; `dom-free`. So editing keeps every borrow valid. A `Node` taken out with
;;; `node-remove!` is detached, not dangling -- it can be read, re-inserted
;;; or ignored -- and a `cstr` read before `set-attr!` still reads the old
;;; value. The price is garbage: `dom-garbage-bytes` counts what edits
;;; abandoned, and `dom-compact` copies the live tree into a fresh Document.
;;;
;;; Every edit is checked first, and on an error nothing changes. The
;;; serializer escapes text and attribute values but writes names, comment
;;; bodies, PI data and HTML raw text (`<script>`, `<style>`) verbatim, so
;;; those are what the checks cover: an element name cannot carry
;;; `onload=...`, a comment cannot close itself early, a `<script>` cannot
;;; hold `</script>`. See c/dom/turdom.h for the exact rules. Checks are
;;; about STRUCTURE, not safety of meaning: an `onclick` attribute with any
;;; value, or a `<script>` with any code, is a valid edit. Editing is not
;;; sanitizing.
;;;
;;; In an XML Document, a node created with a namespace gets its `xmlns`
;;; declaration when serialized wherever its prefix is not already bound.
;;;
;;; Since: 0.2.0
;; Edits over c/dom/turdom.c's turdom_edit_* entry points.

(defmodule dom/edit
  (export DomFlavor XmlFlavor HtmlFlavor
          EditError WrongDocument WouldCycle NotAContainer BadPlacement
          Detached WrongKind BadName BadContent OutOfMemory
          edit-error-message
          dom-new dom-flavor
          create-element create-element-ns create-text create-comment
          create-cdata create-pi node-import node-clone
          node-append! node-prepend! node-insert-before! node-insert-after!
          node-replace! node-remove! node-unwrap!
          set-attr! set-attr-ns! remove-attr! set-text! set-value!
          rename! rename-ns! node-normalize!
          dom-garbage-bytes dom-compact node-attached?)

(import dom/core :refer [Document Node])

;;; DomFlavor -- which serialization and validation rules a Document follows.
(defdata DomFlavor :copy (XmlFlavor) (HtmlFlavor))

;;; EditError -- why an edit was refused. Nothing changed.
;;;   WrongDocument -- the node belongs to another Document: `node-import` it
;;;   WouldCycle    -- inserting a node under itself or its own descendant
;;;   NotAContainer -- children under a text, comment, CDATA, PI or doctype
;;;   BadPlacement  -- not allowed there: a second root element or doctype,
;;;                    text at the top level, a doctype inside an element or
;;;                    after the root, an element inside an HTML raw-text
;;;                    element, a child of an HTML void element, or a CDATA
;;;                    section or PI in an HTML Document
;;;   Detached      -- the reference node has no parent
;;;   WrongKind     -- the edit does not apply to this kind of node
;;;   BadName       -- not a valid element, attribute or PI-target name here
;;;   BadContent    -- text the serializer could not write back faithfully
;;;   OutOfMemory   -- an allocation failed
(defdata EditError :copy
  (WrongDocument)
  (WouldCycle)
  (NotAContainer)
  (BadPlacement)
  (Detached)
  (WrongKind)
  (BadName)
  (BadContent)
  (OutOfMemory))

;;; edit-error-message -- a one-line description of an EditError.
;;;
;;; Parameters:
;;;   e -- the error
;;;
;;; Returns:
;;;   cstr -- static text.
;;;
;;; Example:
;;;   (edit-error-message (BadName))   ; => "not a valid name here"
;;;
;;; Since: 0.2.0
(defn edit-error-message [e : EditError] : cstr
  (match e
    (WrongDocument) "the node belongs to another document"
    (WouldCycle)    "a node cannot go under itself or its descendant"
    (NotAContainer) "this kind of node cannot have children"
    (BadPlacement)  "this node is not allowed there"
    (Detached)      "the reference node has no parent"
    (WrongKind)     "the edit does not apply to this kind of node"
    (BadName)       "not a valid name here"
    (BadContent)    "content the serializer could not write back faithfully"
    (OutOfMemory)   "out of memory"))

;;; __ed-error -- internal: a turdom error code as an EditError.
(defn __ed-error [rc : int] : EditError
  (cond
    (= rc 1) (WrongDocument)
    (= rc 2) (WouldCycle)
    (= rc 3) (NotAContainer)
    (= rc 4) (BadPlacement)
    (= rc 5) (Detached)
    (= rc 6) (WrongKind)
    (= rc 8) (BadName)
    (= rc 9) (BadContent)
    :else    (OutOfMemory)))

;;; __ed-done -- internal: a turdom error code as a Result.
(defn __ed-done [rc : int] : (Result nil EditError)
  (if (= rc 0) (Ok nil) (Err (__ed-error rc))))

;;; __ed-nullp -- internal: is this a null pointer?
(defn __ed-nullp [p : ptr<void>] : bool
  ```c
  return p == NULL;
  ```)

;;; __ed-node -- internal: a checked-then-created node pointer as a Result.
(defn __ed-node [rc : int p : ptr<void>] : (Result Node EditError)
  (if (= rc 0)
    (if (__ed-nullp p) (Err (OutOfMemory)) (Ok (:: p Node)))
    (Err (__ed-error rc))))

;; ---------------------------------------------------------------------------
;; Documents
;; ---------------------------------------------------------------------------

;;; __ed-new-raw -- internal.
(defn __ed-new-raw [html : bool] : ptr<void>
  ```c
  extern void *turdom_doc_new(int);
  return turdom_doc_new(html ? 1 : 0);
  ```)

;;; dom-new -- an empty Document to build into.
;;;
;;; Its document node has no children yet; add a root element with
;;; `create-element` and `node-append!` onto `(dom-node d)`.
;;;
;;; Parameters:
;;;   flavor -- `(XmlFlavor)` or `(HtmlFlavor)`
;;;
;;; Returns:
;;;   Document -- owned; release with `dom-free`.
;;;
;;; Example:
;;;   (let [d (dom-new (XmlFlavor))] ... (dom-free d))
;;;
;;; Since: 0.2.0
(defn dom-new [flavor : DomFlavor] : Document
  (:: (__ed-new-raw (match flavor (XmlFlavor) false (HtmlFlavor) true)) Document))

;;; __ed-flavor-raw -- internal.
(defn __ed-flavor-raw [d : Document] : int
  ```c
  extern int turdom_doc_flavor(void *);
  return (int64_t)turdom_doc_flavor((void *)(intptr_t)d);
  ```)

;;; dom-flavor -- which rules a Document follows.
;;;
;;; Parameters:
;;;   d -- the document
;;;
;;; Returns:
;;;   DomFlavor -- `(HtmlFlavor)` for a tur-html tree, `(XmlFlavor)` for a
;;;   tur-xml one.
;;;
;;; Example:
;;;   (dom-flavor (html-parse "<p>"))   ; => (HtmlFlavor)
;;;
;;; Since: 0.2.0
(defn dom-flavor [d : Document] : DomFlavor
  (if (= (__ed-flavor-raw d) 1) (HtmlFlavor) (XmlFlavor)))

;;; __ed-garbage-raw -- internal.
(defn __ed-garbage-raw [d : Document] : int
  ```c
  extern int64_t turdom_garbage_bytes(void *);
  return turdom_garbage_bytes((void *)(intptr_t)d);
  ```)

;;; dom-garbage-bytes -- arena bytes that edits have abandoned.
;;;
;;; Replaced attribute values and text, removed attributes, old names, and
;;; text merged by a parser or `node-normalize!`. Detached nodes are not
;;; counted, since a caller may still hold and re-insert them. A long-running
;;; editor calls `dom-compact` when this grows.
;;;
;;; Parameters:
;;;   d -- the document
;;;
;;; Returns:
;;;   int -- bytes.
;;;
;;; Example:
;;;   (dom-garbage-bytes d)   ; => 0 for a fresh dom-new
;;;
;;; Since: 0.2.0
(defn dom-garbage-bytes [d : Document] : int
  (__ed-garbage-raw d))

;;; __ed-compact-raw -- internal.
(defn __ed-compact-raw [d : Document] : ptr<void>
  ```c
  extern void *turdom_compact(void *);
  return turdom_compact((void *)(intptr_t)d);
  ```)

;;; dom-compact -- a fresh Document holding a copy of the live tree.
;;;
;;; The one operation that does not edit in place: Nodes of `d` do not belong
;;; to the copy. Garbage and detached nodes stay behind in `d`.
;;;
;;; Parameters:
;;;   d -- the document; still yours to `dom-free`
;;;
;;; Returns:
;;;   (Option Document) -- the copy, owned (release with `dom-free`); none on
;;;   allocation failure.
;;;
;;; Example:
;;;   (match (dom-compact d) (Some c) (do (dom-free d) c) (None) d)
;;;
;;; Since: 0.2.0
(defn dom-compact [d : Document] : (Option Document)
  (let [p (__ed-compact-raw d)]
    (if (__ed-nullp p) (None) (Some (:: p Document)))))

;; ---------------------------------------------------------------------------
;; Creating detached nodes
;; ---------------------------------------------------------------------------

;;; __ed-check-element -- internal.
(defn __ed-check-element [d : Document qname : cstr uri : cstr] : int
  ```c
  extern int turdom_check_element_name(void *, const char *, const char *);
  return (int64_t)turdom_check_element_name((void *)(intptr_t)d, (const char *)qname,
                                            (const char *)uri);
  ```)

;;; __ed-element-raw -- internal.
(defn __ed-element-raw [d : Document qname : cstr uri : cstr] : ptr<void>
  ```c
  #include <string.h>
  extern void *turdom_create_element(void *, const char *, const char *, const char *);
  const char *q = (const char *)qname;
  const char *c = strchr(q, ':');
  return turdom_create_element((void *)(intptr_t)d, q, (const char *)uri, c ? c + 1 : NULL);
  ```)

;;; create-element -- a new, detached element with no namespace.
;;;
;;; In an HTML Document the element is in the HTML namespace and its name is
;;; lower-cased, as `document.createElement` does. Insert it with
;;; `node-append!` and friends.
;;;
;;; Parameters:
;;;   d    -- the document that will own it
;;;   name -- the element name
;;;
;;; Returns:
;;;   (Result Node EditError) -- `BadName` for a name the serializer could not
;;;   write back as this one element (`"x onload=y"`, `"1a"`).
;;;
;;; Example:
;;;   (create-element d "li")   ; => (Ok <li>)
;;;
;;; Since: 0.2.0
(defn create-element [d : Document name : cstr] : (Result Node EditError)
  (create-element-ns d "" name))

;;; create-element-ns -- a new, detached element in a namespace.
;;;
;;; Parameters:
;;;   d     -- the document that will own it
;;;   uri   -- the namespace URI ("" for none)
;;;   qname -- the qualified name, e.g. `"atom:entry"` or `"svg"`
;;;
;;; Returns:
;;;   (Result Node EditError) -- `BadName` for an invalid name, or in XML a
;;;   prefix without a namespace.
;;;
;;; Example:
;;;   (create-element-ns d "http://www.w3.org/2005/Atom" "entry")
;;;
;;; Since: 0.2.0
(defn create-element-ns [d : Document uri : cstr qname : cstr]
  : (Result Node EditError)
  (let [rc (__ed-check-element d qname uri)]
    (if (= rc 0)
      (__ed-node 0 (__ed-element-raw d qname uri))
      (Err (__ed-error rc)))))

;;; __ed-check-chars -- internal.
(defn __ed-check-chars [d : Document kind : int s : cstr] : int
  ```c
  #include <string.h>
  extern int turdom_check_chars(void *, int, const char *, size_t);
  return (int64_t)turdom_check_chars((void *)(intptr_t)d, (int)kind, (const char *)s,
                                     strlen((const char *)s));
  ```)

;;; __ed-chars-raw -- internal.
(defn __ed-chars-raw [d : Document kind : int s : cstr] : ptr<void>
  ```c
  #include <string.h>
  extern void *turdom_create_chars(void *, int, const char *, size_t);
  return turdom_create_chars((void *)(intptr_t)d, (int)kind, (const char *)s,
                             strlen((const char *)s));
  ```)

;;; __ed-create-chars -- internal.
(defn __ed-create-chars [d : Document kind : int s : cstr] : (Result Node EditError)
  (let [rc (__ed-check-chars d kind s)]
    (if (= rc 0) (__ed-node 0 (__ed-chars-raw d kind s)) (Err (__ed-error rc)))))

;;; create-text -- a new, detached text node.
;;;
;;; Parameters:
;;;   d -- the document that will own it
;;;   s -- the text (escaped when serialized)
;;;
;;; Returns:
;;;   (Result Node EditError) -- `BadContent` in XML for text that is not
;;;   well-formed UTF-8 or holds a character XML forbids (most C0 controls).
;;;
;;; Example:
;;;   (create-text d "1 < 2")
;;;
;;; Since: 0.2.0
(defn create-text [d : Document s : cstr] : (Result Node EditError)
  (__ed-create-chars d 2 s))

;;; create-comment -- a new, detached comment.
;;;
;;; Parameters:
;;;   d -- the document that will own it
;;;   s -- the comment body
;;;
;;; Returns:
;;;   (Result Node EditError) -- `BadContent` for a body that would end the
;;;   comment early or not parse back (`--` in XML; `-->`, or a leading `>`,
;;;   in HTML).
;;;
;;; Example:
;;;   (create-comment d " generated ")
;;;
;;; Since: 0.2.0
(defn create-comment [d : Document s : cstr] : (Result Node EditError)
  (__ed-create-chars d 3 s))

;;; create-cdata -- a new, detached CDATA section (XML only).
;;;
;;; HTML has no CDATA nodes -- its parser reads `<![CDATA[` inside SVG as
;;; text -- so in an HTML Document this is `BadPlacement`.
;;;
;;; Parameters:
;;;   d -- the document that will own it
;;;   s -- the content (a `]]>` inside is split on output)
;;;
;;; Returns:
;;;   (Result Node EditError) -- `BadContent` for content holding `]]>` or
;;;   `\r`, which could not come back as one section, as written.
;;;
;;; Example:
;;;   (create-cdata d "a < b")
;;;
;;; Since: 0.2.0
(defn create-cdata [d : Document s : cstr] : (Result Node EditError)
  (__ed-create-chars d 4 s))

;;; __ed-check-pi -- internal.
(defn __ed-check-pi [d : Document target : cstr data : cstr] : int
  ```c
  extern int turdom_check_pi(void *, const char *, const char *);
  return (int64_t)turdom_check_pi((void *)(intptr_t)d, (const char *)target, (const char *)data);
  ```)

;;; __ed-pi-raw -- internal.
(defn __ed-pi-raw [d : Document target : cstr data : cstr] : ptr<void>
  ```c
  extern void *turdom_create_pi(void *, const char *, const char *);
  return turdom_create_pi((void *)(intptr_t)d, (const char *)target, (const char *)data);
  ```)

;;; create-pi -- a new, detached processing instruction (XML only).
;;;
;;; Parameters:
;;;   d      -- the document that will own it
;;;   target -- the PI target, e.g. `"xml-stylesheet"`
;;;   data   -- the data after the target
;;;
;;; Returns:
;;;   (Result Node EditError) -- `BadPlacement` in an HTML Document (HTML has
;;;   no PIs); `BadName` for target `xml` or a non-NCName; `BadContent` for
;;;   data holding `?>` or starting with whitespace.
;;;
;;; Example:
;;;   (create-pi d "xml-stylesheet" "href=\"a.xsl\" type=\"text/xsl\"")
;;;
;;; Since: 0.2.0
(defn create-pi [d : Document target : cstr data : cstr] : (Result Node EditError)
  (let [rc (__ed-check-pi d target data)]
    (if (= rc 0) (__ed-node 0 (__ed-pi-raw d target data)) (Err (__ed-error rc)))))

;;; __ed-import-check -- internal: a cross-flavour import must validate.
(defn __ed-import-check [d : Document n : Node] : int
  ```c
  extern int turdom_doc_flavor(void *);
  extern void *turdom_node_doc(void *);
  extern int turdom_check_subtree(void *, void *);
  extern int turdom_kind(void *);
  void *dd = (void *)(intptr_t)d, *nn = (void *)(intptr_t)n;
  if (turdom_kind(nn) == 0) return 6;            /* the document node */
  if (turdom_doc_flavor(turdom_node_doc(nn)) == turdom_doc_flavor(dd)) return 0;
  return (int64_t)turdom_check_subtree(dd, nn);
  ```)

;;; __ed-import-raw -- internal.
(defn __ed-import-raw [d : Document n : Node] : ptr<void>
  ```c
  extern void *turdom_import(void *, void *);
  return turdom_import((void *)(intptr_t)d, (void *)(intptr_t)n);
  ```)

;;; node-import -- a detached deep copy of a node, owned by another Document.
;;;
;;; Use it to move content between documents (or from a parsed fragment into
;;; a page). Between documents of different flavours every name and string in
;;; the copy is validated for `d`.
;;;
;;; Parameters:
;;;   d -- the document that will own the copy
;;;   n -- any node but a document node
;;;
;;; Returns:
;;;   (Result Node EditError) -- `WrongKind` for a document node; `BadName` /
;;;   `BadContent` / `BadPlacement` for content `d`'s flavour cannot hold.
;;;
;;; Example:
;;;   (node-import page (unwrap (dom-root fragment-doc)))
;;;
;;; Since: 0.2.0
(defn node-import [d : Document n : Node] : (Result Node EditError)
  (let [rc (__ed-import-check d n)]
    (if (= rc 0) (__ed-node 0 (__ed-import-raw d n)) (Err (__ed-error rc)))))

;;; __ed-clone-raw -- internal.
(defn __ed-clone-raw [n : Node] : ptr<void>
  ```c
  extern void *turdom_clone(void *);
  return turdom_clone((void *)(intptr_t)n);
  ```)

;;; node-clone -- a detached deep copy of a node in its own Document.
;;;
;;; Parameters:
;;;   n -- any node but a document node
;;;
;;; Returns:
;;;   (Result Node EditError) -- `WrongKind` for a document node.
;;;
;;; Example:
;;;   (node-clone row)   ; a copy to append elsewhere
;;;
;;; Since: 0.2.0
(defn node-clone [n : Node] : (Result Node EditError)
  (let [p (__ed-clone-raw n)]
    (if (__ed-nullp p) (Err (WrongKind)) (Ok (:: p Node)))))

;; ---------------------------------------------------------------------------
;; Tree surgery
;; ---------------------------------------------------------------------------

;;; __ed-insert -- internal: turdom_edit_insert.
(defn __ed-insert [where : int at : Node child : Node] : int
  ```c
  extern int turdom_edit_insert(int, void *, void *);
  return (int64_t)turdom_edit_insert((int)where, (void *)(intptr_t)at,
                                     (void *)(intptr_t)child);
  ```)

;;; node-append! -- make `child` the last child of `parent`.
;;;
;;; A child that is already in the tree is moved, not copied.
;;;
;;; Parameters:
;;;   parent -- an element or the document node
;;;   child  -- a node of the same Document
;;;
;;; Returns:
;;;   (Result nil EditError)
;;;
;;; Example:
;;;   (node-append! ul li)
;;;
;;; Since: 0.2.0
(defn node-append! [parent : Node child : Node] : (Result nil EditError)
  (__ed-done (__ed-insert 0 parent child)))

;;; node-prepend! -- make `child` the first child of `parent`.
;;;
;;; Parameters:
;;;   parent -- an element or the document node
;;;   child  -- a node of the same Document
;;;
;;; Returns:
;;;   (Result nil EditError)
;;;
;;; Example:
;;;   (node-prepend! ul li)
;;;
;;; Since: 0.2.0
(defn node-prepend! [parent : Node child : Node] : (Result nil EditError)
  (__ed-done (__ed-insert 1 parent child)))

;;; node-insert-before! -- put `child` immediately before `ref`.
;;;
;;; Parameters:
;;;   ref   -- an attached node
;;;   child -- a node of the same Document
;;;
;;; Returns:
;;;   (Result nil EditError) -- `Detached` when `ref` has no parent.
;;;
;;; Example:
;;;   (node-insert-before! second first)
;;;
;;; Since: 0.2.0
(defn node-insert-before! [ref : Node child : Node] : (Result nil EditError)
  (__ed-done (__ed-insert 2 ref child)))

;;; node-insert-after! -- put `child` immediately after `ref`.
;;;
;;; Parameters:
;;;   ref   -- an attached node
;;;   child -- a node of the same Document
;;;
;;; Returns:
;;;   (Result nil EditError) -- `Detached` when `ref` has no parent.
;;;
;;; Example:
;;;   (node-insert-after! first second)
;;;
;;; Since: 0.2.0
(defn node-insert-after! [ref : Node child : Node] : (Result nil EditError)
  (__ed-done (__ed-insert 3 ref child)))

;;; node-replace! -- put `new` where `old` is; `old` becomes detached.
;;;
;;; Parameters:
;;;   old -- an attached node
;;;   new -- a node of the same Document (it may be a descendant of `old`)
;;;
;;; Returns:
;;;   (Result nil EditError) -- on an error `old` stays where it was.
;;;
;;; Example:
;;;   (node-replace! placeholder widget)
;;;
;;; Since: 0.2.0
(defn node-replace! [old : Node new : Node] : (Result nil EditError)
  (__ed-done (__ed-insert 4 old new)))

;;; node-remove! -- detach a node from its parent.
;;;
;;; The node and its subtree stay valid, readable and re-insertable until the
;;; Document is freed. A no-op on a node that is already detached.
;;;
;;; Parameters:
;;;   n -- the node
;;;
;;; Example:
;;;   (for n (query root ".ad") (node-remove! n))
;;;
;;; Since: 0.2.0
(defn node-remove! [n : Node] : nil
  ```c
  extern void turdom_remove(void *);
  turdom_remove((void *)(intptr_t)n);
  ```)

;;; __ed-unwrap-raw -- internal.
(defn __ed-unwrap-raw [n : Node] : int
  ```c
  extern int turdom_edit_unwrap(void *);
  return (int64_t)turdom_edit_unwrap((void *)(intptr_t)n);
  ```)

;;; node-unwrap! -- replace a node by its children.
;;;
;;; `<p>a<b>bold</b>c</p>` with the `<b>` unwrapped is `<p>aboldc</p>`
;;; (three text nodes; `node-normalize!` merges them). The emptied node is
;;; detached.
;;;
;;; Parameters:
;;;   n -- an attached element
;;;
;;; Returns:
;;;   (Result nil EditError)
;;;
;;; Example:
;;;   (node-unwrap! span)
;;;
;;; Since: 0.2.0
(defn node-unwrap! [n : Node] : (Result nil EditError)
  (__ed-done (__ed-unwrap-raw n)))

;; ---------------------------------------------------------------------------
;; Content
;; ---------------------------------------------------------------------------

;;; __ed-set-attr-raw -- internal.
(defn __ed-set-attr-raw [el : Node qname : cstr uri : cstr value : cstr] : int
  ```c
  #include <string.h>
  extern int turdom_edit_set_attr(void *, const char *, const char *, const char *, size_t);
  return (int64_t)turdom_edit_set_attr((void *)(intptr_t)el, (const char *)qname,
                                       (const char *)uri, (const char *)value,
                                       strlen((const char *)value));
  ```)

;;; set-attr! -- set an attribute, replacing its value if it exists.
;;;
;;; In an HTML Document the name matches ignoring ASCII case, and a new name
;;; is lower-cased on an HTML element, as `setAttribute` does. The old value's
;;; bytes stay in the arena, so a `cstr` borrowed from it stays valid.
;;;
;;; Parameters:
;;;   el    -- an element
;;;   name  -- the attribute name (in XML, `xmlns` / `xmlns:p` declare
;;;            namespaces)
;;;   value -- the value (escaped when serialized)
;;;
;;; Returns:
;;;   (Result nil EditError) -- `BadName` for a name containing whitespace,
;;;   `/`, `>` or `=` (`"a onload"`); in XML, `BadContent` for a value with a
;;;   forbidden character.
;;;
;;; Example:
;;;   (set-attr! a "href" "/next")
;;;
;;; Since: 0.2.0
(defn set-attr! [el : Node name : cstr value : cstr] : (Result nil EditError)
  (__ed-done (__ed-set-attr-raw el name "" value)))

;;; set-attr-ns! -- set a namespaced attribute.
;;;
;;; An existing attribute with the same namespace and local name is replaced.
;;;
;;; Parameters:
;;;   el    -- an element
;;;   uri   -- the namespace URI
;;;   qname -- the qualified name; in XML it needs a prefix
;;;   value -- the value
;;;
;;; Returns:
;;;   (Result nil EditError) -- `BadName` for an unprefixed namespaced name in
;;;   XML, or a prefix already bound to another URI on this element.
;;;
;;; Example:
;;;   (set-attr-ns! use "http://www.w3.org/1999/xlink" "xlink:href" "#icon")
;;;
;;; Since: 0.2.0
(defn set-attr-ns! [el : Node uri : cstr qname : cstr value : cstr]
  : (Result nil EditError)
  (__ed-done (__ed-set-attr-raw el qname uri value)))

;;; remove-attr! -- remove an attribute.
;;;
;;; Matches as `node-attr` does: the qualified name, or the Clark form
;;; `{uri}local`, ignoring ASCII case in an HTML Document.
;;;
;;; Parameters:
;;;   el   -- an element
;;;   name -- the attribute name
;;;
;;; Returns:
;;;   bool -- true when an attribute was removed.
;;;
;;; Example:
;;;   (remove-attr! img "style")   ; => true
;;;
;;; Since: 0.2.0
(defn remove-attr! [el : Node name : cstr] : bool
  ```c
  extern int turdom_remove_attr(void *, const char *);
  return turdom_remove_attr((void *)(intptr_t)el, (const char *)name) != 0;
  ```)

;;; __ed-set-text-raw -- internal.
(defn __ed-set-text-raw [n : Node s : cstr mode : int] : int
  ```c
  #include <string.h>
  extern int turdom_edit_set_text(void *, const char *, size_t);
  extern int turdom_edit_set_value(void *, const char *, size_t);
  size_t len = strlen((const char *)s);
  return (int64_t)(mode ? turdom_edit_set_value((void *)(intptr_t)n, (const char *)s, len)
                           : turdom_edit_set_text((void *)(intptr_t)n, (const char *)s, len));
  ```)

;;; set-text! -- replace an element's children with one text node.
;;;
;;; DOM `textContent =`: every child is detached, then a text node holding
;;; `s` is appended (none for ""). On a text, comment, CDATA or PI node it
;;; sets the node's data, as `set-value!` does.
;;;
;;; Parameters:
;;;   n -- an element or a character-data node
;;;   s -- the text
;;;
;;; Returns:
;;;   (Result nil EditError) -- `BadContent` for text that would end a
;;;   `<script>` or `<style>` early; `BadPlacement` on an HTML void element.
;;;
;;; Example:
;;;   (set-text! title "Hello")
;;;
;;; Since: 0.2.0
(defn set-text! [n : Node s : cstr] : (Result nil EditError)
  (__ed-done (__ed-set-text-raw n s 0)))

;;; set-value! -- set the data of a text, comment, CDATA or PI node.
;;;
;;; Parameters:
;;;   n -- the node
;;;   s -- the new data
;;;
;;; Returns:
;;;   (Result nil EditError) -- `WrongKind` on an element or doctype;
;;;   `BadContent` as for the matching `create-*`.
;;;
;;; Example:
;;;   (set-value! comment " updated ")
;;;
;;; Since: 0.2.0
(defn set-value! [n : Node s : cstr] : (Result nil EditError)
  (__ed-done (__ed-set-text-raw n s 1)))

;;; __ed-rename-raw -- internal.
(defn __ed-rename-raw [el : Node qname : cstr uri : cstr] : int
  ```c
  extern int turdom_edit_rename(void *, const char *, const char *);
  return (int64_t)turdom_edit_rename((void *)(intptr_t)el, (const char *)qname,
                                     (const char *)uri);
  ```)

;;; __ed-ns-raw -- internal: the element's namespace URI, "" for none.
(defn __ed-ns-raw [el : Node] : cstr
  ```c
  extern const char *turdom_ns_uri(void *);
  const char *u = turdom_ns_uri((void *)(intptr_t)el);
  return u ? u : "";
  ```)

;;; rename! -- give an element a new name, keeping its namespace.
;;;
;;; Attributes and children are kept. Renaming into `<script>` or `<style>`
;;; checks the existing children against the raw-text rule.
;;;
;;; Parameters:
;;;   el   -- an element
;;;   name -- the new qualified name
;;;
;;; Returns:
;;;   (Result nil EditError)
;;;
;;; Example:
;;;   (rename! b "strong")
;;;
;;; Since: 0.2.0
(defn rename! [el : Node name : cstr] : (Result nil EditError)
  (__ed-done (__ed-rename-raw el name (__ed-ns-raw el))))

;;; rename-ns! -- give an element a new name and namespace.
;;;
;;; Parameters:
;;;   el    -- an element
;;;   uri   -- the new namespace URI ("" for none)
;;;   qname -- the new qualified name
;;;
;;; Returns:
;;;   (Result nil EditError)
;;;
;;; Example:
;;;   (rename-ns! el "urn:new" "n:item")
;;;
;;; Since: 0.2.0
(defn rename-ns! [el : Node uri : cstr qname : cstr] : (Result nil EditError)
  (__ed-done (__ed-rename-raw el qname uri)))

;;; node-normalize! -- merge adjacent text nodes and drop empty ones.
;;;
;;; DOM `normalize()`, over `n`'s subtree. A parser only ever produces
;;; normalized trees; edits can make adjacent or empty text nodes, which
;;; serialize the same but compare differently with `dom-equal?`.
;;;
;;; Parameters:
;;;   n -- the subtree root
;;;
;;; Example:
;;;   (node-normalize! (dom-node d))
;;;
;;; Since: 0.2.0
(defn node-normalize! [n : Node] : nil
  ```c
  extern void turdom_normalize(void *);
  turdom_normalize((void *)(intptr_t)n);
  ```)

;;; node-attached? -- is the node in its Document's tree?
;;;
;;; False for a created node not yet inserted and for anything `node-remove!`
;;; or `node-replace!` took out (and their descendants).
;;;
;;; Parameters:
;;;   n -- the node
;;;
;;; Returns:
;;;   bool
;;;
;;; Example:
;;;   (node-attached? (unwrap (create-element d "p")))   ; => false
;;;
;;; Since: 0.2.0
(defn node-attached? [n : Node] : bool
  ```c
  extern int turdom_attached(void *);
  return turdom_attached((void *)(intptr_t)n) != 0;
  ```)

) ;; end defmodule dom/edit
