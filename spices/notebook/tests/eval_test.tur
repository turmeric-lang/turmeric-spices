;; tests/eval_test.tur -- NB4 tests for notebook/eval.
(defmodule notebook/tests/eval
  (import notebook/cell :refer [parse-attrs cell-make cells-free])
  (import notebook/cache :refer [cache-open cache-close cache-clear])
  (import notebook/eval :refer [eval-cell eval-all eval-from outputs-free])
  (import notebook/session
    :refer
    [session-open
     session-close
     session-reset
     session-eval
     output-status-ok
     output-status-error
     output-status-skipped
     cell-output-status
     cell-output-value-repr
     cell-output-free])
  ;;; free-cstr -- release a strdup'd string.
  (defn free-cstr [s : cstr]
    #fx{Unsafe}
    : void
    ```c
    free((char *)(intptr_t)s);
    ```)
  (defn test-cons [value : int next : int]
    #fx{Unsafe}
    : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = malloc(sizeof(*cell));
    cell->head = value;
    cell->tail = next;
    return (int64_t)(intptr_t)cell;
    ```)
  (defn test-head [lst : int]
    #fx{Unsafe}
    : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    return cell ? cell->head : 0;
    ```)
  (defn test-tail [lst : int]
    #fx{Unsafe}
    : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    return cell ? cell->tail : 0;
    ```)
  (defn cstr-eq? [a : cstr b : cstr]
    #fx{Unsafe}
    : bool
    ```c
    return strcmp((const char *)a, (const char *)b) == 0;
    ```)
  (defn tap-line [idx : int name : cstr ok : bool]
    #fx{Unsafe}
    : void
    ```c
    printf("%s %lld - %s\n", ok ? "ok" : "not ok", (long long)idx, (const char *)name);
    ```)
  (defn tap-plan [count : int fails : int]
    #fx{Unsafe}
    : void
    ```c
    printf("1..%lld\n", (long long)count);
    if (fails == 0) {
      fprintf(stderr, "# All %lld notebook eval tests passed.\n", (long long)count);
    } else {
      fprintf(stderr, "# %lld notebook eval tests failed.\n", (long long)fails);
    }
    ```)
  (defn bool->fail [ok : bool] : int (if ok 0 1))
  (defn run-case [idx : int name : cstr ok : bool]
    #fx{Unsafe}
    : int
    (do (tap-line idx name ok) (bool->fail ok)))
  (defn temp-cache-dir [label : cstr]
    #fx{Unsafe}
    : cstr
    ```c
    char buf[256];
    snprintf(buf, sizeof(buf), "/tmp/%s-%lld-%d", (const char *)label, (long long)time(NULL), (int)getpid());
    return strdup(buf);
    ```)
  ;; Each case releases what it made: the cells (cells-free walks the list and
  ;; frees each Cell with the attrs it owns), the outputs (outputs-free for a
  ;; list, cell-output-free for a single one), and the strdup'd cache dirs.
  ;; Verdicts are computed before the frees -- cell-output-value-repr hands back
  ;; a pointer into the struct.
  (defn test-eval-false []
    #fx{Unsafe}
    : bool
    (let [s    (session-open)
          cell (cell-make "skip"
                 0
                 "(+ 1 2)"
                 (parse-attrs "turmeric {eval=false}")
                 1
                 3)
          out  (eval-cell s cell 0)
          ok   (= (cell-output-status out) (output-status-skipped))]
      (do
        (cell-output-free out)
        (cells-free (test-cons cell 0))
        (session-close s)
        ok)))
  (defn test-eval-all-halt []
    #fx{Unsafe}
    : bool
    (let [s     (session-open)
          c1    (cell-make "a"
                  0
                  "(def n 2)"
                  (parse-attrs "turmeric {id=a}")
                  1
                  3)
          c2    (cell-make "b"
                  0
                  "(+ missing 1)"
                  (parse-attrs "turmeric {id=b}")
                  5
                  7)
          c3    (cell-make "c" 0 "(+ n 4)" (parse-attrs "turmeric {id=c}") 9 11)
          cells (test-cons c1 (test-cons c2 (test-cons c3 0)))
          outs  (eval-all s cells 0 0)
          o1    (test-head outs)
          o2    (test-head (test-tail outs))
          ok    (and (= (cell-output-status o1) (output-status-ok))
                  (and (= (cell-output-status o2) (output-status-error))
                    (= (test-tail (test-tail outs)) 0)))]
      (do (outputs-free outs) (cells-free cells) (session-close s) ok)))
  (defn test-eval-all-continue []
    #fx{Unsafe}
    : bool
    (let [s     (session-open)
          c1    (cell-make "a"
                  0
                  "(def n 2)"
                  (parse-attrs "turmeric {id=a}")
                  1
                  3)
          c2    (cell-make "b"
                  0
                  "(+ missing 1)"
                  (parse-attrs "turmeric {id=b error=continue}")
                  5
                  7)
          c3    (cell-make "c" 0 "(+ n 4)" (parse-attrs "turmeric {id=c}") 9 11)
          cells (test-cons c1 (test-cons c2 (test-cons c3 0)))
          outs  (eval-all s cells 0 0)
          o3    (test-head (test-tail (test-tail outs)))
          ok    (and (= (cell-output-status o3) (output-status-ok))
                  (cstr-eq? (cell-output-value-repr o3) "6"))]
      (do (outputs-free outs) (cells-free cells) (session-close s) ok)))
  (defn test-eval-from []
    #fx{Unsafe}
    : bool
    (let [s     (session-open)
          c1    (cell-make "a"
                  0
                  "(def n 2)"
                  (parse-attrs "turmeric {id=a}")
                  1
                  3)
          c2    (cell-make "b" 0 "(+ n 5)" (parse-attrs "turmeric {id=b}") 5 7)
          c3    (cell-make "c" 0 "(+ n 7)" (parse-attrs "turmeric {id=c}") 9 11)
          warm  (eval-cell s c1 0)
          cells (test-cons c1 (test-cons c2 (test-cons c3 0)))
          outs  (eval-from s cells "b" 0 0)
          o1    (test-head outs)
          o2    (test-head (test-tail outs))
          ok    (and (cstr-eq? (cell-output-value-repr o1) "7")
                  (cstr-eq? (cell-output-value-repr o2) "9"))]
      (do
        (cell-output-free warm)
        (outputs-free outs)
        (cells-free cells)
        (session-close s)
        ok)))
  (defn test-cache-hit-across-reset []
    #fx{Unsafe}
    : bool
    (let [dir   (temp-cache-dir "turnb-eval-cache-hit")
          cache (cache-open dir)
          s     (session-open)
          c1    (cell-make "cached"
                  0
                  "secret"
                  (parse-attrs "turmeric {id=cached cache=true}")
                  1
                  3)]
      (do
        (cache-clear cache)
        (let [seed (session-eval s "(def secret 7)" 0)
              o1   (eval-cell s c1 cache)]
          (session-reset s)
          (let [o2 (eval-cell s c1 cache)
                ok (and (cstr-eq? (cell-output-value-repr o1) "7")
                     (and (= (cell-output-status o2) (output-status-ok))
                       (cstr-eq? (cell-output-value-repr o2) "7")))]
            (cell-output-free seed)
            (cell-output-free o1)
            (cell-output-free o2)
            (cells-free (test-cons c1 0))
            (session-close s)
            (cache-close cache)
            (free-cstr dir)
            ok)))))
  (defn test-depends-busts-downstream-cache []
    #fx{Unsafe}
    : bool
    (let [dir   (temp-cache-dir "turnb-eval-deps")
          cache (cache-open dir)
          s     (session-open)
          a1    (cell-make "a"
                  0
                  "(def n 2)"
                  (parse-attrs "turmeric {id=a cache=true}")
                  1
                  3)
          b1    (cell-make "b"
                  0
                  "(+ n 1)"
                  (parse-attrs "turmeric {id=b cache=true depends=a}")
                  5
                  7)]
      (do
        (cache-clear cache)
        (let [cells1 (test-cons a1 (test-cons b1 0))
              outs1  (eval-all s cells1 cache 0)
              b1-out (test-head (test-tail outs1))
              ok1    (cstr-eq? (cell-output-value-repr b1-out) "3")]
          (session-reset s)
          (let [a2     (cell-make "a"
                         0
                         "(def n 5)"
                         (parse-attrs "turmeric {id=a cache=true}")
                         1
                         3)
                b2     (cell-make "b"
                         0
                         "(+ n 1)"
                         (parse-attrs "turmeric {id=b cache=true depends=a}")
                         5
                         7)
                cells2 (test-cons a2 (test-cons b2 0))
                outs2  (eval-all s cells2 cache 0)
                b2-out (test-head (test-tail outs2))
                ok2    (cstr-eq? (cell-output-value-repr b2-out) "6")]
            (outputs-free outs1)
            (outputs-free outs2)
            (cells-free cells1)
            (cells-free cells2)
            (session-close s)
            (cache-close cache)
            (free-cstr dir)
            (and ok1 ok2))))))
  (defn main []
    #fx{Unsafe}
    : int
    (let [f1 (run-case 1 "skips eval=false cells" (test-eval-false))
          f2 (run-case 2
               "halts eval-all on error by default"
               (test-eval-all-halt))
          f3 (run-case 3
               "continues eval-all when error=continue"
               (test-eval-all-continue))
          f4 (run-case 4
               "evaluates from a named starting cell"
               (test-eval-from))
          f5 (run-case 5
               "reuses cache across session resets"
               (test-cache-hit-across-reset))
          f6 (run-case 6
               "invalidates downstream caches when dependencies change"
               (test-depends-busts-downstream-cache))]
      (tap-plan 6 (+ f1 (+ f2 (+ f3 (+ f4 (+ f5 f6))))))
      (if (= (+ f1 (+ f2 (+ f3 (+ f4 (+ f5 f6))))) 0) 0 1)))) ;; end defmodule notebook/tests/eval
