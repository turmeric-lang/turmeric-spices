;;; tests/tui_test.tur -- NB8 tests for notebook/keys and notebook/tui.
;; tests/tui_test.tur -- keybinding loading, dispatch, and scripted TUI smoke tests.
(defmodule notebook/tests/tui
  (import notebook/format :refer [parse-string])
  (import notebook/keys
    :refer
    [default-keybindings load-keybindings action-dispatch])
  (import notebook/tui
    :refer
    [tui-opts-make tui-run tui-run-nodes tui-opts-free])
  (import notebook/keys :refer [keybindings-free])
  ;; Each case releases what it made.  tui-run / tui-run-nodes take ownership of
  ;; the node list (the TUI state frees it), so the tests free the Result box,
  ;; the opts and the temp paths, but not the nodes.
  ;;; free-cstr -- release an owned string.
  (defn free-cstr [s : cstr]
    #fx{Unsafe}
    : void
    ```c
    free((char *)(intptr_t)s);
    ```)
  ;;; box-free -- release a Result box after taking its payload out.
  (defn box-free [r : int]
    #fx{Unsafe}
    : void
    ```c
    if (r) free((void *)(intptr_t)r);
    ```)
  (defn test-ok? [r : int]
    #fx{Unsafe}
    : bool
    ```c
    return tur_is_ok(r);
    ```)
  (defn test-ok-val [r : int]
    #fx{Unsafe}
    : int
    ```c
    return r ? tur_ok_value(r) : 0;
    ```)
  (defn binding-action [bindings : int key : cstr]
    #fx{Unsafe}
    : cstr
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { char *key; char *action; } NotebookKeyBinding;
    const char *want = key ? (const char *)(intptr_t)key : "";
    for (Cons *cur = (Cons *)(intptr_t)bindings; cur; cur = (Cons *)(intptr_t)cur->tail) {
      NotebookKeyBinding *binding = (NotebookKeyBinding *)(intptr_t)cur->head;
      if (binding && binding->key && strcmp(binding->key, want) == 0) {
        return binding->action ? binding->action : "";
      }
    }
    return "";
    ```)
  (defn cstr-eq? [a : cstr b : cstr]
    #fx{Unsafe}
    : bool
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    return strcmp(sa, sb) == 0;
    ```)
  (defn cstr-contains? [haystack : cstr needle : cstr]
    #fx{Unsafe}
    : bool
    ```c
    const char *hay = haystack ? (const char *)(intptr_t)haystack : "";
    const char *need = needle ? (const char *)(intptr_t)needle : "";
    return need[0] != '\0' && strstr(hay, need) != NULL;
    ```)
  (defn tap-line [idx : int name : cstr ok : bool]
    #fx{Unsafe}
    : void
    ```c
    printf("%s %lld - %s\n", ok ? "ok" : "not ok", (long long)idx, (const char *)name);
    ```)
  (defn tap-plan [count : int fails : int]
    #fx{Unsafe}
    : void
    ```c
    printf("1..%lld\n", (long long)count);
    if (fails == 0) fprintf(stderr, "# All %lld notebook tui tests passed.\n", (long long)count);
    else fprintf(stderr, "# %lld notebook tui tests failed.\n", (long long)fails);
    ```)
  (defn bool->fail [ok : bool] : int (if ok 0 1))
  (defn run-case [idx : int name : cstr ok : bool]
    #fx{Unsafe}
    : int
    (do (tap-line idx name ok) (bool->fail ok)))
  (defn temp-dir [label : cstr]
    #fx{Unsafe}
    : cstr
    ```c
    char buf[256];
    snprintf(buf, sizeof(buf), "/tmp/%s-%lld-%d", (const char *)label, (long long)time(NULL), (int)getpid());
    mkdir(buf, 0755);
    return strdup(buf);
    ```)
  (defn path-join [a : cstr b : cstr]
    #fx{Unsafe}
    : cstr
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    size_t need = strlen(sa) + strlen(sb) + 2;
    char *out = malloc(need);
    snprintf(out, need, "%s/%s", sa, sb);
    return out;
    ```)
  (defn write-file [path : cstr s : cstr]
    #fx{Unsafe}
    : bool
    ```c
    const char *dst = path ? (const char *)(intptr_t)path : "";
    const char *src = s ? (const char *)(intptr_t)s : "";
    FILE *fp = fopen(dst, "wb");
    if (!fp) return false;
    size_t want = strlen(src);
    size_t wrote = fwrite(src, 1, want, fp);
    fclose(fp);
    return wrote == want;
    ```)
  (defn slurp [path : cstr]
    #fx{Unsafe}
    : cstr
    ```c
    const char *p = path ? (const char *)(intptr_t)path : "";
    FILE *fp = fopen(p, "rb");
    if (!fp) return strdup("");
    fseek(fp, 0, SEEK_END);
    long sz = ftell(fp);
    rewind(fp);
    char *buf = malloc((size_t)sz + 1);
    size_t got = fread(buf, 1, (size_t)sz, fp);
    fclose(fp);
    buf[got] = '\0';
    return buf;
    ```)
  (defn set-test-keys [keys : cstr]
    #fx{Unsafe}
    : void
    ```c
    /* tur-ansi reads $TUR_ANSI_TEST_KEYS; keep $TURNB_TEST_KEYS in sync for
       any notebook-internal code still reaching for the old name. */
    setenv("TUR_ANSI_TEST_KEYS", (const char *)(intptr_t)keys, 1);
    setenv("TURNB_TEST_KEYS",   (const char *)(intptr_t)keys, 1);
    ```)
  (defn clear-test-keys []
    #fx{Unsafe}
    : void
    ```c
    unsetenv("TUR_ANSI_TEST_KEYS");
    unsetenv("TURNB_TEST_KEYS");
    ```)
  (defn set-test-editor-text [s : cstr]
    #fx{Unsafe}
    : void
    ```c
    setenv("TURNB_TEST_EDITOR_TEXT", (const char *)(intptr_t)s, 1);
    ```)
  (defn clear-test-editor-text []
    #fx{Unsafe}
    : void
    ```c
    unsetenv("TURNB_TEST_EDITOR_TEXT");
    ```)
  (defn set-test-search-query [s : cstr]
    #fx{Unsafe}
    : void
    ```c
    setenv("TURNB_TEST_SEARCH_QUERY", (const char *)(intptr_t)s, 1);
    ```)
  (defn clear-test-search-query []
    #fx{Unsafe}
    : void
    ```c
    unsetenv("TURNB_TEST_SEARCH_QUERY");
    ```)
  (defn set-test-trace [path : cstr]
    #fx{Unsafe}
    : void
    ```c
    setenv("TURNB_TEST_TRACE", (const char *)(intptr_t)path, 1);
    ```)
  (defn clear-test-trace []
    #fx{Unsafe}
    : void
    ```c
    unsetenv("TURNB_TEST_TRACE");
    ```)
  (defn fake-state-make [cell_count : int focus : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
      int64_t outputs;
      int64_t cell_count;
      int64_t focus;
      int64_t session;
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      int64_t keybindings;
      char *status;
      int64_t pending_effect;
      int64_t quit_requested;
      int64_t exit_code;
      int64_t clipboard;
      int64_t dirty;
      int64_t quit_confirm;
      int64_t output_hidden;
      char *search_query;
      int64_t help_visible;
    } NotebookTuiState;
    NotebookTuiState *st = calloc(1, sizeof(*st));
    st->path = strdup("");
    st->cell_count = cell_count;
    st->focus = focus;
    st->status = strdup("");
    return (int64_t)(intptr_t)st;
    ```)
  ;;; fake-state-free -- release a state built by fake-state-make.  action-dispatch
  ;;; only writes scalar fields, so the two strdup'd strings and the struct are
  ;;; everything the test owns.
  (defn fake-state-free [state : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
      int64_t outputs;
      int64_t cell_count;
      int64_t focus;
      int64_t session;
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      int64_t keybindings;
      char *status;
      int64_t pending_effect;
      int64_t quit_requested;
      int64_t exit_code;
      int64_t clipboard;
      int64_t dirty;
      int64_t quit_confirm;
      int64_t output_hidden;
      char *search_query;
      int64_t help_visible;
    } NotebookTuiState;
    NotebookTuiState *st = (NotebookTuiState *)(intptr_t)state;
    if (!st) return;
    free(st->path);
    free(st->status);
    free(st->search_query);
    free(st);
    ```)
  (defn fake-state-focus [state : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
      int64_t outputs;
      int64_t cell_count;
      int64_t focus;
      int64_t session;
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      int64_t keybindings;
      char *status;
      int64_t pending_effect;
      int64_t quit_requested;
      int64_t exit_code;
      int64_t clipboard;
      int64_t dirty;
      int64_t quit_confirm;
    } NotebookTuiState;
    NotebookTuiState *st = (NotebookTuiState *)(intptr_t)state;
    return st ? st->focus : -1;
    ```)
  (defn fake-state-effect [state : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
      int64_t outputs;
      int64_t cell_count;
      int64_t focus;
      int64_t session;
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      int64_t keybindings;
      char *status;
      int64_t pending_effect;
      int64_t quit_requested;
      int64_t exit_code;
      int64_t clipboard;
      int64_t dirty;
      int64_t quit_confirm;
    } NotebookTuiState;
    NotebookTuiState *st = (NotebookTuiState *)(intptr_t)state;
    return st ? st->pending_effect : -1;
    ```)
  (defn fake-state-quit? [state : int]
    #fx{Unsafe}
    : bool
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
      int64_t outputs;
      int64_t cell_count;
      int64_t focus;
      int64_t session;
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      int64_t keybindings;
      char *status;
      int64_t pending_effect;
      int64_t quit_requested;
      int64_t exit_code;
      int64_t clipboard;
      int64_t dirty;
      int64_t quit_confirm;
    } NotebookTuiState;
    NotebookTuiState *st = (NotebookTuiState *)(intptr_t)state;
    return st ? st->quit_requested != 0 : false;
    ```)
  (defn fake-state-quit-confirm [state : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
      int64_t outputs;
      int64_t cell_count;
      int64_t focus;
      int64_t session;
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      int64_t keybindings;
      char *status;
      int64_t pending_effect;
      int64_t quit_requested;
      int64_t exit_code;
      int64_t clipboard;
      int64_t dirty;
      int64_t quit_confirm;
    } NotebookTuiState;
    NotebookTuiState *st = (NotebookTuiState *)(intptr_t)state;
    return st ? st->quit_confirm : 0;
    ```)
  (defn test-default-keybindings []
    #fx{Unsafe}
    : bool
    (let [bindings (default-keybindings)
          ok       (and (cstr-eq? (binding-action bindings "j") "cell-next")
                     (and (cstr-eq? (binding-action bindings "gg") "cell-top")
                       (and (cstr-eq? (binding-action bindings "e") "cell-edit")
                         (and (cstr-eq? (binding-action bindings "dd")
                                "cell-delete")
                           (and (cstr-eq? (binding-action bindings "/")
                                  "search-prompt")
                             (and (cstr-eq? (binding-action bindings "?")
                                    "help-toggle")
                               (cstr-eq? (binding-action bindings "o")
                                 "output-toggle")))))))]
      (do (keybindings-free bindings) ok)))
  (defn test-load-keybindings []
    #fx{Unsafe}
    : bool
    (let [dir    (temp-dir "turnb-keybindings")
          path   (path-join dir "keys.txt")
          _      (write-file path "# comment\nx quit\n<Enter> cell-run\n")
          loaded (load-keybindings path)
          ok     (and (test-ok? loaded)
                   (cstr-eq? (binding-action (test-ok-val loaded) "x") "quit"))]
      (do
        (if (test-ok? loaded)
          (keybindings-free (test-ok-val loaded))
          (__tui-test-noop))
        (box-free loaded)
        (free-cstr path)
        (free-cstr dir)
        ok)))
  ;;; __tui-test-noop -- void no-op for a cleanup-only `if`.
  (defn __tui-test-noop []
    #fx{Unsafe}
    : void
    ```c
    return;
    ```)
  (defn test-action-dispatch []
    #fx{Unsafe}
    : bool
    (let [state (fake-state-make 3 1)]
      (do
        (action-dispatch state "cell-prev")
        (action-dispatch state "search-prev")
        (let [ok (and (= (fake-state-focus state) 0)
                   (and (= (fake-state-effect state) 13)
                     (and (not (fake-state-quit? state))
                       (= (fake-state-quit-confirm state) 0))))]
          (fake-state-free state)
          ok))))
  (defn test-tui-run-nodes-scripted []
    #fx{Unsafe}
    : bool
    (let [parsed (parse-string "```turmeric {id=one}\n(+ 1 2)\n```\n\n```turmeric {id=two}\n(+ 3 4)\n```")
          nodes  (test-ok-val parsed)
          opts   (tui-opts-make 0 0 1000 "")]
      (do
        (set-test-keys "j\n<Enter>\nq\n")
        (let [run (tui-run-nodes nodes opts)
              ok  (and (test-ok? run) (= (test-ok-val run) 0))]
          (do
            (clear-test-keys)
            (box-free run)
            (tui-opts-free opts)
            (box-free parsed)
            ok)))))
  (defn test-tui-edit-save-and-quit []
    #fx{Unsafe}
    : bool
    (let [dir  (temp-dir "turnb-edit-save")
          path (path-join dir "demo.tur.md")
          _    (write-file path "```turmeric {id=one}\n(+ 1 2)\n```")
          opts (tui-opts-make 0 0 1000 "")]
      (do
        (set-test-editor-text "(+ 5 8)")
        (set-test-keys "e\ns\nq\n")
        (let [run  (tui-run path opts)
              text (slurp path)
              ok   (and (test-ok? run)
                     (and (= (test-ok-val run) 0)
                       (cstr-eq? text "```turmeric {id=one}\n(+ 5 8)\n```")))]
          (do
            (clear-test-editor-text)
            (clear-test-keys)
            (free-cstr text)
            (box-free run)
            (tui-opts-free opts)
            (free-cstr path)
            (free-cstr dir)
            ok)))))
  (defn test-tui-dirty-quit-warning []
    #fx{Unsafe}
    : bool
    (let [parsed (parse-string "```turmeric {id=one}\n(+ 1 2)\n```")
          nodes  (test-ok-val parsed)
          opts   (tui-opts-make 0 0 1000 "")]
      (do
        (set-test-keys "a\nq\nq\n")
        (let [run (tui-run-nodes nodes opts)
              ok  (and (test-ok? run) (= (test-ok-val run) 1))]
          (do
            (clear-test-keys)
            (box-free run)
            (tui-opts-free opts)
            (box-free parsed)
            ok)))))
  (defn test-tui-search-and-output-toggle []
    #fx{Unsafe}
    : bool
    (let [dir    (temp-dir "turnb-search")
          trace  (path-join dir "trace.txt")
          _      (write-file trace "")
          parsed (parse-string "```turmeric {id=one}\n(+ 1 2)\n```\n\n```turmeric {id=two}\nneedle value\n```")
          nodes  (test-ok-val parsed)
          opts   (tui-opts-make 0 0 1000 "")]
      (do
        (set-test-trace trace)
        (set-test-search-query "needle")
        (set-test-keys "/\no\nq\n")
        (let [run    (tui-run-nodes nodes opts)
              logged (slurp trace)
              ok     (and (test-ok? run)
                       (and (= (test-ok-val run) 0)
                         (and (cstr-contains? logged "focus:1")
                           (and (cstr-contains? logged "status:search: needle")
                             (cstr-contains? logged "status:hid output")))))]
          (do
            (clear-test-trace)
            (clear-test-search-query)
            (clear-test-keys)
            (free-cstr logged)
            (box-free run)
            (tui-opts-free opts)
            (box-free parsed)
            (free-cstr trace)
            (free-cstr dir)
            ok)))))
