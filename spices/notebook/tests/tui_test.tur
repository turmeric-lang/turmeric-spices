  (defn test-tui-keybinding-overrides []
    #fx{Unsafe}
    : bool
    (let [dir     (temp-dir "turnb-override")
          trace   (path-join dir "trace.txt")
          keyfile (path-join dir "keys.txt")
          _       (write-file trace "")
          _       (write-file keyfile "x quit\n")
          parsed  (parse-string "```turmeric {id=one}\n(+ 1 2)\n```\n\n```turmeric {id=two}\nneedle two\n```")
          nodes   (test-ok-val parsed)
          opts    (tui-opts-make 0 0 1000 keyfile)]
      (do
        (set-test-trace trace)
        (set-test-search-query "needle")
        (set-test-keys "/\nx\n")
        (let [run    (tui-run-nodes nodes opts)
              logged (slurp trace)
              ok     (and (test-ok? run)
                       (and (= (test-ok-val run) 0)
                         (cstr-contains? logged "status:search: needle")))]
          (do
            (clear-test-trace)
            (clear-test-search-query)
            (clear-test-keys)
            (free-cstr logged)
            (box-free run)
            (tui-opts-free opts)
            (box-free parsed)
            (free-cstr keyfile)
            (free-cstr trace)
            (free-cstr dir)
            ok)))))
  ;;; The two cases below drive the node-list editors -- add-below, dd, p -- and
  ;;; then save, so the assertion is on the serialized notebook rather than on a
  ;;; status line.  They are what pins down where a spliced node actually lands.
  ;;; A pasted cell keeps the attribute block it was copied from, so its `{id=...}`
  ;;; still names the original; the cell's own id is regenerated but never
  ;;; serialized.
  (defn test-tui-add-cell-below-order []
    #fx{Unsafe}
    : bool
    (let [dir  (temp-dir "turnb-add-below")
          path (path-join dir "demo.tur.md")
          _    (write-file path
                 "```turmeric {id=one}\n(+ 1 2)\n```\n\n```turmeric {id=two}\n(+ 3 4)\n```")
          opts (tui-opts-make 0 0 1000 "")]
      (do
        (set-test-keys "b\ns\nq\n")
        (let [run  (tui-run path opts)
              text (slurp path)
              ok   (and (test-ok? run)
                     (and (= (test-ok-val run) 0)
                       (cstr-eq? text
                         "```turmeric {id=one}\n(+ 1 2)\n```\n\n```turmeric\n\n```\n\n```turmeric {id=two}\n(+ 3 4)\n```")))]
          (do
            (clear-test-keys)
            (free-cstr text)
            (box-free run)
            (tui-opts-free opts)
            (free-cstr path)
            (free-cstr dir)
            ok)))))
  (defn test-tui-delete-and-paste []
    #fx{Unsafe}
    : bool
    (let [dir  (temp-dir "turnb-cut-paste")
          path (path-join dir "demo.tur.md")
          _    (write-file path
                 "```turmeric {id=one}\n(+ 1 2)\n```\n\n```turmeric {id=two}\n(+ 3 4)\n```")
          opts (tui-opts-make 0 0 1000 "")]
      (do
        (set-test-keys "d\nd\np\ns\nq\n")
        (let [run  (tui-run path opts)
              text (slurp path)
              ok   (and (test-ok? run)
                     (and (= (test-ok-val run) 0)
                       (cstr-eq? text
                         "```turmeric {id=two}\n(+ 3 4)\n```\n\n```turmeric {id=one}\n(+ 1 2)\n```")))]
          (do
            (clear-test-keys)
            (free-cstr text)
            (box-free run)
            (tui-opts-free opts)
            (free-cstr path)
            (free-cstr dir)
            ok)))))
  (defn main []
    #fx{Unsafe}
    : int
    (let [f1    (run-case 1
                  "returns the built-in NB10 keybindings"
                  (test-default-keybindings))
          f2    (run-case 2
                  "loads custom keybindings files"
                  (test-load-keybindings))
          f3    (run-case 3
                  "dispatches navigation and NB10 search actions"
                  (test-action-dispatch))
          f4    (run-case 4
                  "runs the TUI loop with scripted keys"
                  (test-tui-run-nodes-scripted))
          f5    (run-case 5
                  "edits, saves, and cleanly quits a file-backed notebook"
                  (test-tui-edit-save-and-quit))
          f6    (run-case 6
                  "warns before quitting with unsaved changes"
                  (test-tui-dirty-quit-warning))
          f7    (run-case 7
                  "searches and toggles focused output"
                  (test-tui-search-and-output-toggle))
          f8    (run-case 8
                  "opens and dismisses the help overlay"
                  (test-tui-help-overlay))
          f9    (run-case 9
                  "merges keybinding overrides onto defaults"
                  (test-tui-keybinding-overrides))
          f10   (run-case 10
                  "splices an added cell in below the focused one"
                  (test-tui-add-cell-below-order))
          f11   (run-case 11
                  "cuts a cell and pastes it after the focused one"
                  (test-tui-delete-and-paste))
          fails (+ f1
                  (+ f2
                    (+ f3 (+ f4 (+ f5 (+ f6 (+ f7 (+ f8 (+ f9 (+ f10 f11))))))))))]
      (tap-plan 11 fails)
      (if (= fails 0) 0 1)))) ;; end defmodule notebook/tests/tui
