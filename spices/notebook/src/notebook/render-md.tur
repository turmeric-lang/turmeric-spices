;;; notebook/render-md -- render notebook documents to markdown with output blocks.
;; notebook/render-md -- evaluate .tur.md files and emit markdown output.

(defmodule notebook/render-md
  (import notebook/cmark :refer [md-emit])
  (import notebook/format :refer [parse-file node-tag node-prose node-cell nodes-free])
  (import notebook/cell :refer [attr-get-bool cell-id cell-lang cell-source cell-attrs cells-assign-ids])
  (import notebook/session :refer [session-open-for session-close
                                   output-status-ok output-status-error output-status-skipped
                                   cell-output-cell-id cell-output-status cell-output-stdout
                                   cell-output-value-repr cell-output-error-msg
                                   cell-output-elapsed-ms])
  (import notebook/eval :refer [eval-all outputs-free])
  (import notebook/cache :refer [cache-open cache-close])
  (export render-opts-make
          render-opts-output-dir render-opts-use-cache
          render-opts-include-source render-opts-include-output
          render-opts-fail-fast render-opts-set-math-mode render-opts-set-assets-mode
          default-render-opts
          render-md-string render-md
          render-opts-free)

  (defn __rmd-build-hint [] : int
    ```c
    /* __tur_include__: #include <sys/stat.h> */
    return 0;
    ```)

  (defn __rmd-nil-value [] #fx{Unsafe} : int
    ```c
    return 0;
    ```)

  (defn __rmd-list-nil? [lst : int] #fx{Unsafe} : bool
    ```c
    return lst == 0;
    ```)

  (defn __rmd-cons [value : int next : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = malloc(sizeof(*cell));
    cell->head = value;
    cell->tail = next;
    return (int64_t)(intptr_t)cell;
    ```)

  (defn __rmd-head [lst : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    if (!cell) { fprintf(stderr, "head: empty list\n"); exit(1); }
    return cell->head;
    ```)

  (defn __rmd-tail [lst : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    if (!cell) { fprintf(stderr, "tail: empty list\n"); exit(1); }
    return cell->tail;
    ```)

  (defn __rmd-ok [value : int] #fx{Unsafe} : int
    ```c
    return tur_box_ok(value);
    ```)

  (defn __rmd-err [value : cstr] #fx{Unsafe} : int
    ```c
    return tur_err_ptr(value ? strdup((const char *)(intptr_t)value) : strdup(""));
    ```)

  (defn __rmd-result-ok? [result : int] #fx{Unsafe} : bool
    ```c
    return tur_is_ok(result);
    ```)

  (defn __rmd-result-ok-val [result : int] #fx{Unsafe} : int
    ```c
    return result ? tur_ok_value(result) : 0;
    ```)

  (defn __rmd-cstr-eq? [a : cstr b : cstr] #fx{Unsafe} : bool
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    return strcmp(sa, sb) == 0;
    ```)

  (defn __rmd-cstr-empty? [s : cstr] #fx{Unsafe} : bool
    ```c
    const char *src = s ? (const char *)(intptr_t)s : "";
    return src[0] == '\0';
    ```)

  (defn __rmd-cstr-as-int [s : cstr] #fx{Unsafe} : int
    ```c
    return (int64_t)(intptr_t)s;
    ```)

  (defn __rmd-int-as-cstr [value : int] #fx{Unsafe} : cstr
    ```c
    return (const char *)(intptr_t)value;
    ```)

  (defn __rmd-cstr-free [s : cstr] #fx{Unsafe} : void
    ```c
    void *p = (void *)(intptr_t)s;
    if (p) free(p);
    ```)

  (defn __rmd-str-concat [a : cstr b : cstr] #fx{Unsafe} : cstr
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    size_t la = strlen(sa), lb = strlen(sb);
    char *out = malloc(la + lb + 1);
    memcpy(out, sa, la);
    memcpy(out + la, sb, lb);
    out[la + lb] = '\0';
    return out;
    ```)

;; ---------------------------------------------------------------------
;; String ownership
;;
;; This module used to mix borrowed literals and malloc'd strings in the same
;; return type -- __rmd-render-attrs returned either "" or a fresh string,
;; __rmd-join-blocks sometimes returned one of its arguments and sometimes a
;; new string -- so no call site could know whether to free what it got, and
;; none did.  Every helper below returns a string the CALLER OWNS; the
;; literals are strdup'd to keep that uniform.
;; ---------------------------------------------------------------------

;;; __rmd-strdup -- an owned copy of a borrowed string.
  (defn __rmd-strdup [s : cstr] #fx{Unsafe} : cstr
    ```c
    const char *p = s ? (const char *)(intptr_t)s : "";
    return strdup(p);
    ```)

;;; __rmd-join-owned -- join two OWNED blocks with a blank line, releasing
;;; both.  Returns a new owned string.
  (defn __rmd-join-owned [a : cstr b : cstr] #fx{Unsafe} : cstr
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    size_t la = strlen(sa), lb = strlen(sb);
    char *out;
    if (la == 0)      out = strdup(sb);
    else if (lb == 0) out = strdup(sa);
    else {
      out = malloc(la + 2 + lb + 1);
      memcpy(out, sa, la);
      memcpy(out + la, "\n\n", 2);
      memcpy(out + la + 2, sb, lb);
      out[la + 2 + lb] = '\0';
    }
    if (a) free((void *)(intptr_t)a);
    if (b) free((void *)(intptr_t)b);
    return out;
    ```)

  (defn __rmd-join-blocks [a : cstr b : cstr] #fx{Unsafe} : cstr
    (if (__rmd-cstr-empty? a)
      b
      (if (__rmd-cstr-empty? b)
        a
        (__rmd-str-concat a (__rmd-str-concat "\n\n" b)))))

  (defn __rmd-int->cstr [value : int] #fx{Unsafe} : cstr
    ```c
    char buf[32];
    snprintf(buf, sizeof(buf), "%lld", (long long)value);
    return strdup(buf);
    ```)

  (defn render-opts-make [output_dir : cstr use_cache : int include_source : int
                          include_output : int fail_fast : int] #fx{Unsafe} : int
    ```c
    typedef struct {
      char *output_dir;
      int64_t use_cache;
      int64_t include_source;
      int64_t include_output;
      int64_t fail_fast;
      int64_t math_mode;    /* 0=auto 1=always 2=never */
      int64_t assets_mode;  /* 0=inline 1=sibling */
    } RenderOpts;
    RenderOpts *opts = malloc(sizeof(*opts));
    opts->output_dir = output_dir ? strdup((const char *)(intptr_t)output_dir) : strdup("");
    opts->use_cache = use_cache;
    opts->include_source = include_source;
    opts->include_output = include_output;
    opts->fail_fast = fail_fast;
    opts->math_mode = 0;
    opts->assets_mode = 0;
    return (int64_t)(intptr_t)opts;
    ```)

  (defn render-opts-output-dir [opts : int] #fx{Unsafe} : cstr
    ```c
    typedef struct {
      char *output_dir;
      int64_t use_cache;
      int64_t include_source;
      int64_t include_output;
      int64_t fail_fast;
    } RenderOpts;
    RenderOpts *o = (RenderOpts *)(intptr_t)opts;
    return o && o->output_dir ? o->output_dir : "";
    ```)

