  (defn default-render-opts [] #fx{Unsafe} : int
    (render-opts-make "" 0 1 1 1))

  (defn __rmd-output-path [src_path : cstr output_dir : cstr] #fx{Unsafe} : cstr
    ```c
    const char *src = src_path ? (const char *)(intptr_t)src_path : "";
    const char *out_dir = output_dir ? (const char *)(intptr_t)output_dir : "";
    const char *base = strrchr(src, '/');
    base = base ? base + 1 : src;

    size_t base_len = strlen(base);
    size_t stem_len = base_len;
    if (base_len >= 7 && strcmp(base + base_len - 7, ".tur.md") == 0) {
      stem_len = base_len - 7;
    } else {
      const char *dot = strrchr(base, '.');
      if (dot) stem_len = (size_t)(dot - base);
    }

    char *stem = malloc(stem_len + 1);
    memcpy(stem, base, stem_len);
    stem[stem_len] = '\0';

    char *dir = NULL;
    if (out_dir[0] != '\0') {
      dir = strdup(out_dir);
    } else {
      const char *slash = strrchr(src, '/');
      if (!slash) {
        dir = strdup("");
      } else {
        size_t dir_len = (size_t)(slash - src);
        dir = malloc(dir_len + 1);
        memcpy(dir, src, dir_len);
        dir[dir_len] = '\0';
      }
    }

    size_t need = strlen(dir) + (dir[0] ? 1 : 0) + strlen(stem) + 3 + 1;
    char *out = malloc(need);
    if (dir[0]) snprintf(out, need, "%s/%s.md", dir, stem);
    else snprintf(out, need, "%s.md", stem);

    free(stem);
    free(dir);
    return out;
    ```)

  (defn __rmd-ensure-parent-dir [path : cstr] #fx{Unsafe} : int
    ```c
    #include <sys/stat.h>
    const char *src = path ? (const char *)(intptr_t)path : "";
    const char *slash = strrchr(src, '/');
    if (!slash) return 0;
    size_t len = (size_t)(slash - src);
    char *dir = malloc(len + 1);
    memcpy(dir, src, len);
    dir[len] = '\0';
    if (dir[0] == '\0') { free(dir); return 0; }

    int ret = 0;
    for (char *p = dir + 1; *p; p++) {
      if (*p == '/') {
        struct stat st;
        *p = '\0';
        if (stat(dir, &st) != 0) {
          if (mkdir(dir, 0755) != 0) { ret = -1; break; }
        } else if (!S_ISDIR(st.st_mode)) {
          ret = -1;
          break;
        }
        *p = '/';
      }
    }
    if (ret == 0) {
      struct stat st;
      if (stat(dir, &st) != 0) {
        if (mkdir(dir, 0755) != 0) ret = -1;
      } else if (!S_ISDIR(st.st_mode)) {
        ret = -1;
      }
    }
    free(dir);
    return ret;
    ```)

  (defn __rmd-write-file [path : cstr s : cstr] #fx{Unsafe} : int
    ```c
    const char *p = path ? (const char *)(intptr_t)path : "";
    const char *text = s ? (const char *)(intptr_t)s : "";
    FILE *fp = fopen(p, "wb");
    if (!fp) return 0;
    size_t len = strlen(text);
    size_t wrote = fwrite(text, 1, len, fp);
    fclose(fp);
    return wrote == len ? 1 : 0;
    ```)

  (defn __rmd-close-cache [cache : int] #fx{Unsafe} : int
    (if (not (= cache 0))
      (do
        (cache-close cache)
        0)
      0))

  (defn __rmd-lang-label [lang : int] #fx{Unsafe} : cstr
    (__rmd-strdup (if (= lang 0) "turmeric" "sweet-exp")))

  (defn __rmd-render-attr-list [attrs : int] #fx{Unsafe} : cstr
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { char *name; char *value; } Attr;
    Cons *lst = (Cons *)(intptr_t)attrs;
    if (!lst) return strdup("");
    size_t cap = 64;
    size_t len = 0;
    char *out = malloc(cap);
    out[0] = '\0';
    int first = 1;
    while (lst) {
      Attr *attr = (Attr *)(intptr_t)lst->head;
      const char *name = (attr && attr->name) ? attr->name : "";
      const char *value = (attr && attr->value) ? attr->value : "";
      size_t need = len + strlen(name) + strlen(value) + 4;
      while (need > cap) { cap *= 2; out = realloc(out, cap); }
      if (!first) out[len++] = ' ';
      memcpy(out + len, name, strlen(name));
      len += strlen(name);
      out[len++] = '=';
      memcpy(out + len, value, strlen(value));
      len += strlen(value);
      out[len] = '\0';
      first = 0;
      lst = (Cons *)(intptr_t)lst->tail;
    }
    return out;
    ```)

  (defn __rmd-render-attrs [attrs : int] #fx{Unsafe} : cstr
    (if (__rmd-list-nil? attrs)
      (__rmd-strdup "")
      (let [inner (__rmd-render-attr-list attrs)
            out   (__rmd-attrs-wrap inner)]
        (do
          (__rmd-cstr-free inner)
          out))))

;;; __rmd-attrs-wrap -- " {" + inner + "}" in one allocation.
;;; The nested __rmd-str-concat chain this replaces dropped its intermediates.
  (defn __rmd-attrs-wrap [inner : cstr] #fx{Unsafe} : cstr
    ```c
    const char *p = inner ? (const char *)(intptr_t)inner : "";
    size_t n = strlen(p);
    char *out = malloc(n + 4);
    out[0] = ' '; out[1] = '{';
    memcpy(out + 2, p, n);
    out[n + 2] = '}';
    out[n + 3] = '\0';
    return out;
    ```)

  ;;; __rmd-render-source-block -- the ```lang {attrs}\n<source>\n``` fence.
  ;;;
  ;;; Built in one allocation.  The five nested __rmd-str-concat calls this
  ;;; replaces dropped four intermediate strings per cell.
  (defn __rmd-render-source-block [cell : int] #fx{Unsafe} : cstr
    (let [label (__rmd-lang-label (cell-lang cell))
          attrs (__rmd-render-attrs (cell-attrs cell))
          out   (__rmd-source-fence label attrs (cell-source cell))]
      (do
        (__rmd-cstr-free label)
        (__rmd-cstr-free attrs)
        out)))

  (defn __rmd-source-fence [label : cstr attrs : cstr source : cstr] #fx{Unsafe} : cstr
    ```c
    const char *l = label  ? (const char *)(intptr_t)label  : "";
    const char *a = attrs  ? (const char *)(intptr_t)attrs  : "";
    const char *b = source ? (const char *)(intptr_t)source : "";
    size_t n = strlen(l) + strlen(a) + strlen(b) + 12;
    char *out = malloc(n);
    /* \x60 is a backtick: a literal triple-backtick here would close the
       inline-C block. */
    snprintf(out, n, "\x60\x60\x60%s%s\n%s\n\x60\x60\x60", l, a, b);
    return out;
    ```)

  (defn __rmd-output-fence [output : int] #fx{Unsafe} : cstr
    ```c
    typedef struct {
      char *cell_id;
      int64_t status;
      char *stdout_text;
      char *value_repr;
      char *error_msg;
      int64_t elapsed_ms;
      int64_t image_paths;
      char *type_tag;
    } NotebookCellOutput;
    NotebookCellOutput *out = (NotebookCellOutput *)(intptr_t)output;
    if (!out || out->status == 2) return strdup("");

    const char *status = out->status == 0 ? "ok" : "error";
    const char *cell_id = out->cell_id ? out->cell_id : "";
    const char *stdout_text = out->stdout_text ? out->stdout_text : "";
    const char *value_repr = out->value_repr ? out->value_repr : "";
    const char *error_msg = out->error_msg ? out->error_msg : "";

    size_t cap = strlen(stdout_text) + strlen(value_repr) + strlen(error_msg) + 256;
    char *buf = malloc(cap);
    size_t len = 0;
    len += (size_t)snprintf(buf + len, cap - len, "%c%c%coutput\n;; cell-id=%s status=%s elapsed=%lldms\n",
                            '`', '`', '`', cell_id, status, (long long)out->elapsed_ms);

    if (out->status == 0) {
      if (stdout_text[0]) {
        size_t slen = strlen(stdout_text);
        memcpy(buf + len, stdout_text, slen);
        len += slen;
        if (len == 0 || buf[len - 1] != '\n') buf[len++] = '\n';
      }
      if (value_repr[0]) {
        len += (size_t)snprintf(buf + len, cap - len, ";; => %s\n", value_repr);
      }
    } else if (error_msg[0]) {
      size_t elen = strlen(error_msg);
      memcpy(buf + len, error_msg, elen);
      len += elen;
      if (len == 0 || buf[len - 1] != '\n') buf[len++] = '\n';
    }

    len += (size_t)snprintf(buf + len, cap - len, "%c%c%c", '`', '`', '`');
    buf[len] = '\0';
    return buf;
    ```)

  ;;; __rmd-render-cell-block -- source fence and/or output fence for one cell.
  ;;; Both halves are owned strings; __rmd-join-owned consumes them.
  (defn __rmd-render-cell-block [cell : int output : int opts : int] #fx{Unsafe} : cstr
    (let [source-part (if (and (= (render-opts-include-source opts) 1)
                               (= (attr-get-bool (cell-attrs cell) "echo" 1) 1))
                        (__rmd-render-source-block cell)
                        (__rmd-strdup ""))
          output-part (if (and (not (= output 0))
                               (= (render-opts-include-output opts) 1)
                               (= (attr-get-bool (cell-attrs cell) "output" 1) 1))
                        (__rmd-output-fence output)
                        (__rmd-strdup ""))]
      (__rmd-join-owned source-part output-part)))

  (defn __rmd-render-state-make [text : cstr outputs : int] #fx{Unsafe} : int
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *state = malloc(sizeof(*state));
    state->text = text ? strdup((const char *)(intptr_t)text) : strdup("");
    state->outputs = outputs;
    return (int64_t)(intptr_t)state;
    ```)

  (defn __rmd-render-state-text [state : int] #fx{Unsafe} : cstr
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    return s && s->text ? s->text : "";
    ```)

  (defn __rmd-render-state-outputs [state : int] #fx{Unsafe} : int
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    return s ? s->outputs : 0;
    ```)

;;; __rmd-render-state-adopt -- build a state that TAKES OWNERSHIP of `text`.
;;; (__rmd-render-state-make strdups instead, which is right for a literal
;;; and wrong for a string the caller just built.)
  (defn __rmd-render-state-adopt [text : cstr outputs : int] #fx{Unsafe} : int
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *state = malloc(sizeof(*state));
    state->text = text ? (char *)(intptr_t)text : strdup("");
    state->outputs = outputs;
    return (int64_t)(intptr_t)state;
    ```)

;;; __rmd-state-take-text -- hand the text out and clear the field, so the
;;; state can be freed without taking the string with it.
  (defn __rmd-state-take-text [state : int] #fx{Unsafe} : cstr
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    if (!s) return strdup("");
    char *t = s->text ? s->text : strdup("");
    s->text = NULL;
    return t;
    ```)

;;; __rmd-render-state-free -- release a state and its text.  Safe on 0.
  (defn __rmd-render-state-free [state : int] #fx{Unsafe} : void
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    if (!s) return;
    free(s->text);
    free(s);
    ```)

;;; render-opts-free -- release a RenderOpts.  Safe on 0.
  (defn render-opts-free [opts : int] #fx{Unsafe} : void
    ```c
    typedef struct {
      char *output_dir;
      int64_t use_cache;
      int64_t include_source;
      int64_t include_output;
      int64_t fail_fast;
      int64_t math_mode;
      int64_t assets_mode;
    } RenderOpts;
    RenderOpts *o = (RenderOpts *)(intptr_t)opts;
    if (!o) return;
    free(o->output_dir);
    free(o);
    ```)

  ;;; __rmd-render-nodes -- fold the node list into one rendered block.
  ;;;
  ;;; Each level used to build a state from the text of the level below it
  ;;; and then drop that state -- one RenderState plus one string per node --
  ;;; and md-emit's freshly allocated block went the same way.  Now the text
  ;;; is TAKEN from the inner state (which is then freed) and joined with an
  ;;; owned block, so exactly one string survives each level.
  (defn __rmd-render-nodes [nodes : int outputs : int opts : int] #fx{Unsafe} : int
    (if (__rmd-list-nil? nodes)
      (__rmd-render-state-make "" outputs)
      (let [node (__rmd-head nodes)]
        (if (= (node-tag node) 0)
          (let [rest      (__rmd-render-nodes (__rmd-tail nodes) outputs opts)
                rest-outs (__rmd-render-state-outputs rest)
                joined    (__rmd-join-owned (md-emit (node-prose node))
                                            (__rmd-state-take-text rest))]
            (do
              (__rmd-render-state-free rest)
              (__rmd-render-state-adopt joined rest-outs)))
          (let [cell (node-cell node)
                cur-output (if (__rmd-list-nil? outputs) 0 (__rmd-head outputs))
                rest-outputs (if (__rmd-list-nil? outputs) (__rmd-nil-value) (__rmd-tail outputs))
                rest      (__rmd-render-nodes (__rmd-tail nodes) rest-outputs opts)
                rest-outs (__rmd-render-state-outputs rest)
                joined    (__rmd-join-owned (__rmd-render-cell-block cell cur-output opts)
                                            (__rmd-state-take-text rest))]
            (do
              (__rmd-render-state-free rest)
              (__rmd-render-state-adopt joined rest-outs)))))))

  (defn __rmd-cells-from-nodes-rev [nodes : int acc : int] #fx{Unsafe} : int
    (if (__rmd-list-nil? nodes)
      acc
      (let [node (__rmd-head nodes)]
        (__rmd-cells-from-nodes-rev
          (__rmd-tail nodes)
          (if (= (node-tag node) 1)
            (__rmd-cons (node-cell node) acc)
            acc)))))

  ;;; __rmd-reverse -- reverse a list, consuming its cons cells.
  (defn __rmd-reverse [lst : int acc : int] #fx{Unsafe} : int
    (if (__rmd-list-nil? lst)
      acc
      (let [next (__rmd-tail lst)
            out  (__rmd-cons (__rmd-head lst) acc)]
        (do
          (__rmd-cons-free lst)
          (__rmd-reverse next out)))))

;;; __rmd-cons-free -- free one cons cell, leaving its head alone.
  (defn __rmd-cons-free [node : int] #fx{Unsafe} : void
    ```c
    free((void *)(intptr_t)node);
    ```)

;;; __rmd-spine-free -- free a cons spine, leaving the heads alone.  Used for
;;; the cell list __rmd-cells-from-nodes builds: those Cells belong to the
;;; nodes, only the spine is ours.
  (defn __rmd-spine-free [lst : int] #fx{Unsafe} : void
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *node = (Cons *)(intptr_t)lst;
    while (node) {
      Cons *next = (Cons *)(intptr_t)node->tail;
      free(node);
      node = next;
    }
    ```)

  (defn __rmd-cells-from-nodes [nodes : int] #fx{Unsafe} : int
    (__rmd-reverse (__rmd-cells-from-nodes-rev nodes (__rmd-nil-value))
                   (__rmd-nil-value)))

  (defn __rmd-list-length [lst : int] #fx{Unsafe} : int
    (if (__rmd-list-nil? lst)
      0
      (+ 1 (__rmd-list-length (__rmd-tail lst)))))

  ;;; render-md-string -- render a parsed notebook and its outputs to markdown.
  ;;;
  ;;; Returns a string the caller owns.  It used to return the interior text
  ;;; pointer of a RenderState it immediately dropped -- so the result was a
  ;;; live pointer into leaked memory, which happened to work only because
  ;;; nothing freed the state.
  (defn render-md-string [nodes : int outputs : int opts : int] #fx{Unsafe} : cstr
    (let [st   (__rmd-render-nodes nodes outputs opts)
          text (__rmd-state-take-text st)]
      (do
        (__rmd-render-state-free st)
        text)))

  ;;; render-md -- evaluate a notebook file and write rendered markdown beside it.
  ;;; render-md -- evaluate a notebook file and write rendered markdown beside it.
  ;;;
  ;;; Owns everything it builds and releases it on every exit path: the parsed
  ;;; node list, the cell spine (the Cells belong to the nodes -- only the
  ;;; spine is ours), the outputs, and the rendered text.  On success the
  ;;; output path is handed to the caller inside the ok result; on failure it
  ;;; is released here.  None of this used to be freed.
  (defn render-md [path : cstr opts : int] #fx{Unsafe} : int
    (let [parsed (parse-file path)]
      (if (not (__rmd-result-ok? parsed))
        (__rmd-err "failed to parse notebook file")
        (let [nodes (__rmd-result-ok-val parsed)
              ;; the Result box itself is ours once the nodes are out of it
              _box (__rmd-result-box-free parsed)
              cells (cells-assign-ids (__rmd-cells-from-nodes nodes))
              session (session-open-for path)
              cache (if (= (render-opts-use-cache opts) 1)
                      (cache-open "")
                      0)
              outputs (eval-all session cells cache 0)
              halted? (and (= (render-opts-fail-fast opts) 1)
                           (< (__rmd-list-length outputs) (__rmd-list-length cells)))]
          (if halted?
            (do
              (session-close session)
              (__rmd-close-cache cache)
              (outputs-free outputs)
              (__rmd-spine-free cells)
              (nodes-free nodes)
              (__rmd-err "render halted after a cell error"))
            (let [rendered (render-md-string nodes outputs opts)
                  out-path (__rmd-output-path path (render-opts-output-dir opts))]
              (do
                (session-close session)
                (__rmd-close-cache cache)
                (outputs-free outputs)
                (__rmd-spine-free cells)
                (nodes-free nodes)
                (let [result (if (= (__rmd-ensure-parent-dir out-path) -1)
                               (__rmd-err "failed to create output directory")
                               (if (= (__rmd-write-file out-path rendered) 1)
                                 (__rmd-ok (__rmd-cstr-as-int out-path))
                                 (__rmd-err "failed to write rendered markdown")))]
                  (do
                    (__rmd-cstr-free rendered)
                    ;; out-path travels out inside the ok result; on either
                    ;; error path it is ours to release.
                    (if (__rmd-result-ok? result)
                      (__rmd-noop)
                      (__rmd-cstr-free out-path))
                    result)))))))))

;;; __rmd-result-box-free -- release a Result box after taking its payload.
;;; Returns 0 so it can sit in a `let` binding.
  (defn __rmd-result-box-free [r : int] #fx{Unsafe} : int
    ```c
    if (r) free((void *)(intptr_t)r);
    return 0;
    ```)

;;; __rmd-noop -- void no-op, so a cleanup-only `if` has void on both arms.
  (defn __rmd-noop [] #fx{Unsafe} : void
    ```c
    return;
    ```)

) ;; end defmodule notebook/render-md
