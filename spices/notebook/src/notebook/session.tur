;;; cell-output-type-tag -- return the type tag string from turi_eval_typed.
;;; May be empty if the cell produced an error or the tag was not captured.
;;; Since: notebook-v0.3.0
  (defn cell-output-type-tag [output : int] #fx{Unsafe} : cstr
    ```c
    typedef struct {
      char *cell_id;
      int64_t status;
      char *stdout_text;
      char *value_repr;
      char *error_msg;
      int64_t elapsed_ms;
      int64_t image_paths;
      char *type_tag;
    } NotebookCellOutput;
    NotebookCellOutput *out = (NotebookCellOutput *)(intptr_t)output;
    return out && out->type_tag ? out->type_tag : "";
    ```)

  ;;; session-open-for -- create a session whose imports resolve for a notebook.
  ;;;
  ;;; The session starts from the stdlib `tur repl` preloads (collections,
  ;;; core macros, Show), cells may `(import ...)` at the top level the way a
  ;;; REPL turn may, and the module search is the one `tur run <path>` would
  ;;; use for a program at `path`: the notebook's own directory, then the
  ;;; enclosing spice's src/, its `:spices` deps and its workspace siblings.
  ;;; An empty `path` (a notebook rendered from a string) searches the cwd and
  ;;; the stdlib only.  Against a libturi that predates
  ;;; turi_env_set_search_path_for, none of that: only the notebook's
  ;;; directory is searched, and only a defmodule may import.
  ;;;
  ;;; Parameters:
  ;;;   path -- the .tur.md file the cells come from, or ""
  ;;;
  ;;; Returns:
  ;;;   A session handle (0 on allocation failure); free with session-close.
  ;;;
  ;;; Example:
  ;;;   (session-open-for "examples/plot-walkthrough.tur.md")
  ;;;
  ;;; Since: notebook-v0.3.1
  (defn session-open-for [path : cstr] #fx{Unsafe} : int
    ```c
    typedef struct {
      TuriEnv *env;
      char *source_path;
    } NotebookSession;
    static bool inited = false;
    if (!inited) {
      turi_init(false);
      inited = true;
    }
    NotebookSession *session = malloc(sizeof(*session));
    if (!session) return 0;
    const char *p = path ? (const char *)(intptr_t)path : "";
    session->source_path = *p ? strdup(p) : NULL;
    session->env = turi_env_new();
    /* The same configuration session-reset applies to its fresh env. */
#ifdef TURI_HAS_SEARCH_PATH_FOR
#ifndef TUR_NB_STDLIB
#define TUR_NB_STDLIB ""   /* the stdlib the building tur used; "" = $TUR_STDLIB_DIR */
#endif
    turi_env_preload_stdlib(session->env, TUR_NB_STDLIB);
    turi_env_set_toplevel_imports(session->env, true);
    if (session->source_path)
      turi_env_set_search_path_for(session->env, session->source_path);
#else
    if (session->source_path) {
      char *dir = strdup(session->source_path);
      char *slash = dir ? strrchr(dir, '/') : NULL;
      if (slash) { *slash = '\0'; turi_env_set_module_base_dir(session->env, dir); }
      free(dir);
    }
#endif
    return (int64_t)(intptr_t)session;
    ```)

  ;;; session-open -- create a fresh libturi-backed notebook session.
  ;;; A session for no particular file: see session-open-for.
  (defn session-open [] #fx{Unsafe} : int
    (session-open-for ""))

  ;;; session-close -- free a notebook session and its embedded environment.
  (defn session-close [session : int] #fx{Unsafe} : void
    ```c
    typedef struct {
      TuriEnv *env;
      char *source_path;
    } NotebookSession;
    NotebookSession *s = (NotebookSession *)(intptr_t)session;
    if (!s) return;
    if (s->env) turi_env_free(s->env);
    free(s->source_path);
    free(s);
    ```)

  ;;; session-reset -- replace the current environment with a fresh one.
  (defn session-reset [session : int] #fx{Unsafe} : void
    ```c
    typedef struct {
      TuriEnv *env;
      char *source_path;
    } NotebookSession;
    NotebookSession *s = (NotebookSession *)(intptr_t)session;
    if (!s) return;
    if (s->env) turi_env_free(s->env);
    s->env = turi_env_new();
    /* The configuration session-open-for gave the env it replaces. */
#ifdef TURI_HAS_SEARCH_PATH_FOR
#ifndef TUR_NB_STDLIB
#define TUR_NB_STDLIB ""   /* the stdlib the building tur used; "" = $TUR_STDLIB_DIR */
#endif
    turi_env_preload_stdlib(s->env, TUR_NB_STDLIB);
    turi_env_set_toplevel_imports(s->env, true);
    if (s->source_path) turi_env_set_search_path_for(s->env, s->source_path);
#else
    if (s->source_path) {
      char *dir = strdup(s->source_path);
      char *slash = dir ? strrchr(dir, '/') : NULL;
      if (slash) { *slash = '\0'; turi_env_set_module_base_dir(s->env, dir); }
      free(dir);
    }
#endif
    ```)

  ;;; session-eval -- evaluate one cell source string in the current session.
  (defn session-eval [session : int source : cstr lang : int] #fx{Unsafe} : int
    ```c
    typedef struct {
      TuriEnv *env;
      char *source_path;
    } NotebookSession;
    typedef struct {
      char *cell_id;
      int64_t status;
      char *stdout_text;
      char *value_repr;
      char *error_msg;
      int64_t elapsed_ms;
      int64_t image_paths;
      char *type_tag;
    } NotebookCellOutput;

    NotebookSession *s = (NotebookSession *)(intptr_t)session;
    if (!s || !s->env) {
      NotebookCellOutput *out = malloc(sizeof(*out));
      out->cell_id = strdup("");
      out->status = 1;
      out->stdout_text = strdup("");
      out->value_repr = strdup("");
      out->error_msg = strdup("session is not open");
      out->elapsed_ms = 0;
      out->image_paths = 0;
      out->type_tag = strdup("");
      return (int64_t)(intptr_t)out;
    }

    const char *src = source ? (const char *)(intptr_t)source : "";
    char *wrapped = NULL;
    if (lang == 1) {
      const char *prefix = "#lang turmeric/sweet\n";
      size_t plen = strlen(prefix);
      size_t slen = strlen(src);
      wrapped = malloc(plen + slen + 1);
      memcpy(wrapped, prefix, plen);
      memcpy(wrapped + plen, src, slen + 1);
      src = wrapped;
    }

    struct timeval tv0, tv1;
    gettimeofday(&tv0, NULL);

    fflush(stdout);
    fflush(stderr);
    int saved_stdout = dup(STDOUT_FILENO);
    int saved_stderr = dup(STDERR_FILENO);
    char tmpl[] = "/tmp/turnb-capture-XXXXXX";
    int capture_fd = mkstemp(tmpl);
    if (capture_fd >= 0) unlink(tmpl);
    if (capture_fd >= 0) {
      dup2(capture_fd, STDOUT_FILENO);
      dup2(capture_fd, STDERR_FILENO);
    }

#ifdef TURI_HAS_ATTACH_SPICE
    /* A spice whose functions are inline C runs compiled: before the cell
     * evaluates, attach the compiled image of each spice it imports (built
     * once by `tur build --shared`, cached under that spice's
     * .tur-repl-cache/; $TUR_BIN names the tur, else the one on PATH).  The
     * build's output, if it fails, is the cell's.  notebook/ modules are this
     * process's own code already. */
    for (const char *ip = src; (ip = strstr(ip, "import")) != NULL; ip += 6) {
      int at_form = ip > src && ip[-1] == '(';
      int at_line = 0;
      if (!at_form) {
        const char *b = ip;
        while (b > src && (b[-1] == ' ' || b[-1] == '\t')) b--;
        at_line = b == src || b[-1] == '\n';
      }
      if (!at_form && !at_line) continue;
      const char *mp = ip + 6;
      if (*mp != ' ' && *mp != '\t' && *mp != '\n') continue;
      while (*mp == ' ' || *mp == '\t' || *mp == '\n') mp++;
      char mod[256];
      size_t mk = 0;
      while (mp[mk] && !isspace((unsigned char)mp[mk]) && mp[mk] != ')'
             && mp[mk] != '(' && mk + 1 < sizeof mod) {
        mod[mk] = mp[mk];
        mk++;
      }
      mod[mk] = '\0';
      if (mk == 0 || strncmp(mod, "notebook/", 9) == 0) continue;
      turi_env_attach_spice_for_module(s->env, mod, NULL);
    }
#endif

    char type_tag[128] = {0};
    TuriValue result = turi_eval_typed(s->env, src, type_tag, sizeof(type_tag));

    fflush(stdout);
    fflush(stderr);
    if (saved_stdout >= 0) { dup2(saved_stdout, STDOUT_FILENO); close(saved_stdout); }
    if (saved_stderr >= 0) { dup2(saved_stderr, STDERR_FILENO); close(saved_stderr); }

    char *captured = NULL;
    if (capture_fd < 0 || lseek(capture_fd, 0, SEEK_SET) < 0) {
      captured = strdup("");
    } else {
      size_t cap = 256;
      size_t len = 0;
      captured = malloc(cap);
      captured[0] = '\0';
      for (;;) {
        if (len + 129 > cap) {
          while (len + 129 > cap) cap *= 2;
          captured = realloc(captured, cap);
        }
        ssize_t n = read(capture_fd, captured + len, cap - len - 1);
        if (n <= 0) break;
        len += (size_t)n;
      }
      captured[len] = '\0';
    }
    if (capture_fd >= 0) close(capture_fd);

    gettimeofday(&tv1, NULL);
    int64_t elapsed = (int64_t)(tv1.tv_sec - tv0.tv_sec) * 1000LL +
                      (int64_t)(tv1.tv_usec - tv0.tv_usec) / 1000LL;

    char *value_repr = strdup("");
    char *error_msg = strdup("");
    int64_t status = 0;

    if (turi_is_error(result)) {
      status = 1;
      free(error_msg);
      error_msg = strdup(turi_error_message(result) ? turi_error_message(result) : "");
    } else {
      const char *show_str = turi_try_show(s->env, result);
      if (!show_str) show_str = turi_show_result(s->env, result, type_tag);
      if (show_str) {
        free(value_repr);
        value_repr = strdup(show_str ? show_str : "");
        free((char *)show_str);
      } else {
        char repr[2048];
        turi_value_repr(repr, sizeof(repr), result);
        free(value_repr);
        value_repr = strdup(repr);
      }
    }

    if (wrapped) free(wrapped);

    /* Parse __NB_IMG__: markers out of captured stdout.
       Lines of the form "__NB_IMG__: <path>" are stripped from the
       visible output and their paths are collected into image_paths. */
    typedef struct { int64_t head; int64_t tail; } NbCons;
    static const char img_marker[] = "__NB_IMG__: ";
    static const size_t img_marker_len = sizeof(img_marker) - 1;
    char *clean = malloc(strlen(captured) + 1);
    size_t clean_len = 0;
    int64_t image_paths = 0; /* nil list */
    /* Build image list in reverse; will be reversed below. */
    int64_t img_rev = 0;
    const char *p = captured;
    while (*p) {
      const char *line_end = strchr(p, '\n');
      size_t line_len = line_end ? (size_t)(line_end - p) : strlen(p);
      if (strncmp(p, img_marker, img_marker_len) == 0) {
        /* Extract path (strip trailing whitespace). */
        const char *path_start = p + img_marker_len;
        size_t path_len = line_len > img_marker_len ? line_len - img_marker_len : 0;
        while (path_len > 0 && (path_start[path_len - 1] == '\r' ||
                                 path_start[path_len - 1] == ' ')) path_len--;
        if (path_len > 0) {
          char *img_path = malloc(path_len + 1);
          memcpy(img_path, path_start, path_len);
          img_path[path_len] = '\0';
          NbCons *node = malloc(sizeof(NbCons));
          node->head = (int64_t)(intptr_t)img_path;
          node->tail = img_rev;
          img_rev = (int64_t)(intptr_t)node;
        }
      } else {
        /* Keep this line in clean output. */
        memcpy(clean + clean_len, p, line_len);
        clean_len += line_len;
        if (line_end) { clean[clean_len++] = '\n'; }
      }
      if (!line_end) break;
      p = line_end + 1;
    }
    clean[clean_len] = '\0';

    /* Reverse img_rev to get document order. */
    image_paths = 0;
    for (NbCons *cur = (NbCons *)(intptr_t)img_rev; cur; ) {
      NbCons *next = (NbCons *)(intptr_t)cur->tail;
      cur->tail = image_paths;
      image_paths = (int64_t)(intptr_t)cur;
      cur = next;
    }

    free(captured);

    NotebookCellOutput *out = malloc(sizeof(*out));
    out->cell_id = strdup("");
    out->status = status;
    out->stdout_text = clean;
    out->value_repr = value_repr;
    out->error_msg = error_msg;
    out->elapsed_ms = elapsed;
    out->type_tag = strdup(type_tag);
    out->image_paths = image_paths;
    return (int64_t)(intptr_t)out;
    ```)

) ;; end defmodule notebook/session
