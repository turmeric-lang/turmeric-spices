;;; notebook/cli -- command-line entrypoint for tur-notebook.
;; notebook/cli -- argv dispatch for render/export/exec/new workflows.

(defmodule notebook/cli
  (import notebook/render-md :refer [render-opts-make render-opts-set-math-mode render-opts-set-assets-mode render-md])
  (import notebook/render-html :refer [render-html])
  (import notebook/tui :refer [tui-opts-make tui-run])
  (import notebook/format :refer [parse-file node-tag node-cell nodes-free])
  (import notebook/session :refer [session-open-for session-close
                                   cell-output-cell-id cell-output-status
                                   cell-output-stdout cell-output-value-repr
                                   cell-output-error-msg cell-output-elapsed-ms
                                   output-status-ok output-status-error output-status-skipped])
  (import notebook/eval :refer [eval-all eval-from outputs-free])
  (import notebook/cell :refer [cell-id cells-assign-ids])
  (import watch/watch :refer [watch-open-one watch-close watch-next])
  (import watch/event :refer [watch-event-free])
  (export cli-main)

  ;; (The former __cli-build-hint, which hoisted sys/event.h + sys/inotify.h
  ;; to file scope for the inline-C watcher, has been removed.  Watching is
  ;; now provided by the tur-watch spice and the headers travel with it.)

  (defn __cli-nil-value [] #fx{Unsafe} : int
    ```c
    return 0;
    ```)

  (defn __cli-null-cstr [] #fx{Unsafe} : cstr
    ```c
    return (const char *)(intptr_t)0;
    ```)

  (defn __cli-list-nil? [lst : int] #fx{Unsafe} : bool
    ```c
    return lst == 0;
    ```)

  (defn __cli-head [lst : int] #fx{Unsafe} : cstr
    ```c
    int64_t *cell = (int64_t *)(intptr_t)lst;
    return cell ? (const char *)(intptr_t)cell[0] : 0;
    ```)

  (defn __cli-tail [lst : int] #fx{Unsafe} : int
    ```c
    int64_t *cell = (int64_t *)(intptr_t)lst;
    return cell ? cell[1] : 0;
    ```)

  (defn __cli-cstr-eq? [a : cstr b : cstr] #fx{Unsafe} : bool
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    return strcmp(sa, sb) == 0;
    ```)

  (defn __cli-cstr-null? [s : cstr] #fx{Unsafe} : bool
    ```c
    return ((const void *)(intptr_t)s) == NULL;
    ```)

  (defn __cli-cstr-empty? [s : cstr] #fx{Unsafe} : bool
    ```c
    const char *src = s ? (const char *)(intptr_t)s : "";
    return src[0] == '\0';
    ```)

  (defn __cli-puts [s : cstr] #fx{Unsafe} : int
    ```c
    const char *text = s ? (const char *)(intptr_t)s : "";
    printf("%s\n", text);
    return 0;
    ```)

  (defn __cli-eputs [s : cstr] #fx{Unsafe} : int
    ```c
    const char *text = s ? (const char *)(intptr_t)s : "";
    fprintf(stderr, "%s\n", text);
    return 0;
    ```)

  (defn __cli-result-ok? [result : int] #fx{Unsafe} : bool
    ```c
    return tur_is_ok(result);
    ```)

  (defn __cli-result-ok-cstr [result : int] #fx{Unsafe} : cstr
    ```c
    return tur_is_ok(result) ? (const char *)(intptr_t)tur_ok_value(result) : "";
    ```)

  (defn __cli-result-ok-int [result : int] #fx{Unsafe} : int
    ```c
    return tur_is_ok(result) ? tur_ok_value(result) : 0;
    ```)

  (defn __cli-result-err-cstr [result : int] #fx{Unsafe} : cstr
    ```c
    return (result && !tur_is_ok(result)) ? (const char *)(intptr_t)tur_err_value(result) : "";
    ```)

  (defn __cli-pos-count [lst : int] #fx{Unsafe} : int
    (if (__cli-list-nil? lst)
      0
      (+ 1 (__cli-pos-count (__cli-tail lst)))))

  (defn __cli-pos-first [lst : int] #fx{Unsafe} : cstr
    (if (__cli-list-nil? lst) (__cli-null-cstr) (__cli-head lst)))

  (defn __cli-pos-second [lst : int] #fx{Unsafe} : cstr
    (if (__cli-list-nil? lst)
      (__cli-null-cstr)
      (__cli-pos-first (__cli-tail lst))))

  (defn __cli-parse-state-make [] #fx{Unsafe} : int
    ```c
    typedef struct {
      char *command;
      char *target;
      char *path;
      char *out;
      char *error_msg;
      int64_t use_cache;
      int64_t watch;
      int64_t no_output;
      int64_t no_source;
      int64_t help;
      char *keybindings_file;
      int64_t no_color;
      char *cell_id;
      int64_t exec_all;
      int64_t math_mode;
      int64_t assets_mode;
    } CliParseState;
    CliParseState *st = calloc(1, sizeof(*st));
    st->command = strdup("");
    st->target = strdup("");
    st->path = strdup("");
    st->out = strdup("");
    st->error_msg = strdup("");
    st->keybindings_file = strdup("");
    st->cell_id = strdup("");
    st->no_color = 0;
    st->exec_all = 0;
    st->math_mode = 0;
    st->assets_mode = 0;
    return (int64_t)(intptr_t)st;
    ```)

  (defn __cli-state-command [state : int] #fx{Unsafe} : cstr
    ```c
    typedef struct {
      char *command;
      char *target;
      char *path;
      char *out;
      char *error_msg;
      int64_t use_cache;
      int64_t watch;
      int64_t no_output;
      int64_t no_source;
      int64_t help;
    } CliParseState;
    CliParseState *st = (CliParseState *)(intptr_t)state;
    return st && st->command ? st->command : "";
    ```)

