;;; __cli-parse-state-free -- release the parse state and its eight strings.
;;; The state is mutated in place by the setters, so exactly one exists per
;;; run; nothing used to free it.  Safe on 0.
  (defn __cli-parse-state-free [state : int] #fx{Unsafe} : void
    ```c
    typedef struct {
      char *command;
      char *target;
      char *path;
      char *out;
      char *error_msg;
      int64_t use_cache;
      int64_t watch;
      int64_t no_output;
      int64_t no_source;
      int64_t help;
      char *keybindings_file;
      int64_t no_color;
      char *cell_id;
      int64_t exec_all;
      int64_t math_mode;
      int64_t assets_mode;
    } CliParseState;
    CliParseState *st = (CliParseState *)(intptr_t)state;
    if (!st) return;
    free(st->command);
    free(st->target);
    free(st->path);
    free(st->out);
    free(st->error_msg);
    free(st->keybindings_file);
    free(st->cell_id);
    free(st);
    ```)

;;; __cli-spine-free -- free a cons spine, leaving the heads alone.
  (defn __cli-spine-free [lst : int] #fx{Unsafe} : void
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *node = (Cons *)(intptr_t)lst;
    while (node) {
      Cons *next = (Cons *)(intptr_t)node->tail;
      free(node);
      node = next;
    }
    ```)

;;; __cli-box-free -- release a Result box after taking its payload out.
;;; Returns 0 so it can sit in a `let` binding.
  (defn __cli-box-free [r : int] #fx{Unsafe} : int
    ```c
    if (r) free((void *)(intptr_t)r);
    return 0;
    ```)

