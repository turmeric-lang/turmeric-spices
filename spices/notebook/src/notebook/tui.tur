;;; notebook/tui -- command-mode terminal UI for .tur.md notebooks.
;; notebook/tui -- focus navigation, per-cell execution, and notebook redraws.

(defmodule notebook/tui
  (import notebook/format :refer [parse-file node-tag node-cell nodes->str nodes-update-cell nodes-free])
  (import notebook/cell :refer [cell-make cells-assign-ids cell-id cell-lang cell-source
                                cell-attrs cell-start-line cell-end-line cell-free attrs-copy])
  (import notebook/session :refer [session-open-for session-close session-reset
                                   cell-output-status cell-output-elapsed-ms cell-output-stdout
                                   cell-output-value-repr cell-output-error-msg cell-output-free])
  (import notebook/eval :refer [eval-cell eval-all outputs-free])
  (import ansi/term  :refer [term-enable-raw term-disable-raw term-read-key])
  (import ansi/style :refer [style-reset])
  (import notebook/keys :refer [default-keybindings load-keybindings action-dispatch keybindings-free])
  (export tui-opts-free tui-opts-make default-tui-opts tui-run tui-run-nodes)

  (defn __tui-nil-value [] #fx{Unsafe} : int
    ```c
    return 0;
    ```)

  (defn __tui-cons [value : int next : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = malloc(sizeof(*cell));
    cell->head = value;
    cell->tail = next;
    return (int64_t)(intptr_t)cell;
    ```)

  (defn __tui-list-nil? [lst : int] #fx{Unsafe} : bool
    ```c
    return lst == 0;
    ```)

  (defn __tui-head [lst : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void *)(intptr_t)lst;
    return cell ? cell->head : 0;
    ```)

  (defn __tui-tail [lst : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void *)(intptr_t)lst;
    return cell ? cell->tail : 0;
    ```)

  (defn __tui-ok [value : int] #fx{Unsafe} : int
    ```c
    return tur_box_ok(value);
    ```)

  (defn __tui-err [value : cstr] #fx{Unsafe} : int
    ```c
    return tur_err_ptr(value ? strdup((const char *)(intptr_t)value) : strdup("error"));
    ```)

  (defn __tui-result-ok? [result : int] #fx{Unsafe} : bool
    ```c
    return tur_is_ok(result);
    ```)

  (defn __tui-result-ok-val [result : int] #fx{Unsafe} : int
    ```c
    return result ? tur_ok_value(result) : 0;
    ```)

  (defn __tui-result-err-val [result : int] #fx{Unsafe} : cstr
    ```c
    return (result && !tur_is_ok(result)) ? (const char *)(intptr_t)tur_err_value(result) : "";
    ```)

  (defn __tui-cstr-empty? [s : cstr] #fx{Unsafe} : bool
    ```c
    const char *src = s ? (const char *)(intptr_t)s : "";
    return src[0] == '\0';
    ```)

  (defn __tui-cstr-eq? [a : cstr b : cstr] #fx{Unsafe} : bool
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    return strcmp(sa, sb) == 0;
    ```)

  (defn __tui-str-concat [a : cstr b : cstr] #fx{Unsafe} : cstr
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    size_t la = strlen(sa), lb = strlen(sb);
    char *out = malloc(la + lb + 1);
    memcpy(out, sa, la);
    memcpy(out + la, sb, lb);
    out[la + lb] = '\0';
    return out;
    ```)

;;; __tui-cstr-free -- release an owned string.  Safe on 0.
  (defn __tui-cstr-free [s : cstr] #fx{Unsafe} : void
    ```c
    free((char *)(intptr_t)s);
    ```)

;;; __tui-own -- copy a borrowed string so a concat can consume it.  Status
;;; messages are built out of a mix of literals, borrowed cell fields and
;;; freshly malloc'd pieces; making every operand owned is what lets
;;; __tui-concat-owned free as it goes.
  (defn __tui-own [s : cstr] #fx{Unsafe} : cstr
    ```c
    return strdup(s ? (const char *)(intptr_t)s : "");
    ```)

;;; __tui-concat-owned -- concatenate two owned strings, releasing both.
  (defn __tui-concat-owned [a : cstr b : cstr] #fx{Unsafe} : cstr
    (let [out (__tui-str-concat a b)]
      (do
        (__tui-cstr-free a)
        (__tui-cstr-free b)
        out)))

  (defn __tui-cstr-drop-last [s : cstr] #fx{Unsafe} : cstr
    ```c
    const char *src = s ? (const char *)(intptr_t)s : "";
    size_t len = strlen(src);
    if (len == 0) return strdup("");
    char *out = malloc(len);
    memcpy(out, src, len - 1);
    out[len - 1] = '\0';
    return out;
    ```)

  (defn __tui-cstr-contains-ci? [haystack : cstr needle : cstr] #fx{Unsafe} : bool
    ```c
    /* __tur_include__: #include <ctype.h> */
    const char *hay = haystack ? (const char *)(intptr_t)haystack : "";
    const char *need = needle ? (const char *)(intptr_t)needle : "";
    if (!need[0]) return false;
    size_t hn = strlen(hay);
    size_t nn = strlen(need);
    if (nn > hn) return false;
    for (size_t i = 0; i + nn <= hn; i++) {
      size_t j = 0;
      while (j < nn && tolower((unsigned char)hay[i + j]) == tolower((unsigned char)need[j])) j++;
      if (j == nn) return true;
    }
    return false;
    ```)

  (defn __tui-int->cstr [value : int] #fx{Unsafe} : cstr
    ```c
    char buf[64];
    snprintf(buf, sizeof(buf), "%lld", (long long)value);
    return strdup(buf);
    ```)

  ;;; tui-opts-make -- build notebook/tui options.
  (defn tui-opts-make [color : int cell_width : int scrollback : int keybindings_file : cstr] #fx{Unsafe} : int
    ```c
    typedef struct {
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      char *keybindings_file;
    } NotebookTuiOpts;
    NotebookTuiOpts *opts = malloc(sizeof(*opts));
    opts->color = color;
    opts->cell_width = cell_width;
    opts->scrollback = scrollback;
    opts->keybindings_file = keybindings_file ? strdup((const char *)(intptr_t)keybindings_file) : strdup("");
    return (int64_t)(intptr_t)opts;
    ```)

  (defn __tui-opts-color [opts : int] #fx{Unsafe} : int
    ```c
    typedef struct {
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      char *keybindings_file;
    } NotebookTuiOpts;
    NotebookTuiOpts *o = (NotebookTuiOpts *)(intptr_t)opts;
    return o ? o->color : 1;
    ```)

  (defn __tui-opts-cell-width [opts : int] #fx{Unsafe} : int
    ```c
    typedef struct {
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      char *keybindings_file;
    } NotebookTuiOpts;
    NotebookTuiOpts *o = (NotebookTuiOpts *)(intptr_t)opts;
    return o ? o->cell_width : 0;
    ```)

  (defn __tui-opts-scrollback [opts : int] #fx{Unsafe} : int
    ```c
    typedef struct {
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      char *keybindings_file;
    } NotebookTuiOpts;
    NotebookTuiOpts *o = (NotebookTuiOpts *)(intptr_t)opts;
    return o ? o->scrollback : 1000;
    ```)

  (defn __tui-opts-keybindings-file [opts : int] #fx{Unsafe} : cstr
    ```c
    typedef struct {
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      char *keybindings_file;
    } NotebookTuiOpts;
    NotebookTuiOpts *o = (NotebookTuiOpts *)(intptr_t)opts;
    return (o && o->keybindings_file) ? o->keybindings_file : "";
    ```)

  ;;; default-tui-opts -- default options for the command-mode notebook TUI.
  (defn default-tui-opts [] #fx{Unsafe} : int
    (tui-opts-make 1 0 1000 ""))

  (defn __tui-node-cell-make [cell : int] #fx{Unsafe} : int
    ```c
    typedef struct { int64_t tag; int64_t prose; int64_t cell; } NotebookNode;
    NotebookNode *node = malloc(sizeof(*node));
    node->tag = 1;
    node->prose = 0;
    node->cell = cell;
    return (int64_t)(intptr_t)node;
    ```)

;;; __tui-copy-cell -- a duplicate of `cell` under a new id and source.
;;; cell-make stores the attrs list it is handed instead of copying it, so this
;;; has to hand it a copy: sharing the original's list would leave the clipboard
;;; cell and the pasted cell both owning it, and cell-free would run over it
;;; twice.
  (defn __tui-copy-cell [cell : int next_id : cstr next_source : cstr] #fx{Unsafe} : int
    (cell-make next_id
               (cell-lang cell)
               next_source
               (attrs-copy (cell-attrs cell))
               (cell-start-line cell)
               (cell-end-line cell)))

  (defn __tui-current-cell [state : int] #fx{Unsafe} : int
    (__tui-list-nth (__tui-state-cells state) (__tui-state-focus state)))

  (defn __tui-cells-have-id? [cells : int want : cstr] #fx{Unsafe} : bool
    (if (__tui-list-nil? cells)
      false
      (if (__tui-cstr-eq? (cell-id (__tui-head cells)) want)
        true
        (__tui-cells-have-id? (__tui-tail cells) want))))

  (defn __tui-fresh-cell-id [cells : int] #fx{Unsafe} : cstr
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct {
      char *id;
      int64_t lang;
      char *source;
      int64_t attrs;
      int64_t start_line;
      int64_t end_line;
    } Cell;
    for (int idx = 1;; idx++) {
      char buf[64];
      snprintf(buf, sizeof(buf), "cell-%d", idx);
      int found = 0;
      for (Cons *cur = (Cons *)(intptr_t)cells; cur; cur = (Cons *)(intptr_t)cur->tail) {
        Cell *cell = (Cell *)(intptr_t)cur->head;
        if (cell && cell->id && strcmp(cell->id, buf) == 0) {
          found = 1;
          break;
        }
      }
      if (!found) return strdup(buf);
    }
    ```)

;;; The four node-list editors below splice the existing spine rather than
;;; rebuilding it.  The rebuilding versions they replace shared their tail with
;;; the list they were derived from, which left the old spine unreachable but
;;; not freeable -- half its cells were still live in the new one.  Editing in
;;; place means there is only ever one spine, and __tui-state-free owns it.

;;; __tui-append-node -- put new_node at the end, returning the (possibly new) head.
  (defn __tui-append-node [nodes : int new_node : int] #fx{Unsafe} : int
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *fresh = malloc(sizeof(*fresh));
    fresh->head = new_node;
    fresh->tail = 0;
    if (!nodes) return (int64_t)(intptr_t)fresh;
    Cons *cur = (Cons *)(intptr_t)nodes;
    while (cur->tail) cur = (Cons *)(intptr_t)cur->tail;
    cur->tail = (int64_t)(intptr_t)fresh;
    return nodes;
    ```)

;;; __tui-insert-node-before -- splice new_node in ahead of the cell node with
;;; target_id, or append it when there is no such cell.
  (defn __tui-insert-node-before [nodes : int target_id : cstr new_node : int] #fx{Unsafe} : int
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { int64_t tag; int64_t prose; int64_t cell; } NotebookNode;
    typedef struct {
      char *id;
      int64_t lang;
      char *source;
      int64_t attrs;
      int64_t start_line;
      int64_t end_line;
    } Cell;
    const char *want = target_id ? (const char *)(intptr_t)target_id : "";
    Cons *fresh = malloc(sizeof(*fresh));
    fresh->head = new_node;
    fresh->tail = 0;
    if (!nodes) return (int64_t)(intptr_t)fresh;
    Cons *prev = NULL;
    for (Cons *cur = (Cons *)(intptr_t)nodes; cur; prev = cur, cur = (Cons *)(intptr_t)cur->tail) {
      NotebookNode *n = (NotebookNode *)(intptr_t)cur->head;
      if (!n || n->tag != 1) continue;
      Cell *c = (Cell *)(intptr_t)n->cell;
      if (!c || !c->id || strcmp(c->id, want) != 0) continue;
      fresh->tail = (int64_t)(intptr_t)cur;
      if (!prev) return (int64_t)(intptr_t)fresh;
      prev->tail = (int64_t)(intptr_t)fresh;
      return nodes;
    }
    prev->tail = (int64_t)(intptr_t)fresh;
    return nodes;
    ```)

;;; __tui-insert-node-after -- splice new_node in behind the cell node with
;;; target_id, or append it when there is no such cell.
  (defn __tui-insert-node-after [nodes : int target_id : cstr new_node : int] #fx{Unsafe} : int
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { int64_t tag; int64_t prose; int64_t cell; } NotebookNode;
    typedef struct {
      char *id;
      int64_t lang;
      char *source;
      int64_t attrs;
      int64_t start_line;
      int64_t end_line;
    } Cell;
    const char *want = target_id ? (const char *)(intptr_t)target_id : "";
    Cons *fresh = malloc(sizeof(*fresh));
    fresh->head = new_node;
    fresh->tail = 0;
    if (!nodes) return (int64_t)(intptr_t)fresh;
    Cons *last = NULL;
    for (Cons *cur = (Cons *)(intptr_t)nodes; cur; last = cur, cur = (Cons *)(intptr_t)cur->tail) {
      NotebookNode *n = (NotebookNode *)(intptr_t)cur->head;
      if (!n || n->tag != 1) continue;
      Cell *c = (Cell *)(intptr_t)n->cell;
      if (!c || !c->id || strcmp(c->id, want) != 0) continue;
      fresh->tail = cur->tail;
      cur->tail = (int64_t)(intptr_t)fresh;
      return nodes;
    }
    last->tail = (int64_t)(intptr_t)fresh;
    return nodes;
    ```)

;;; __tui-delete-node-pair -- unlink the cell node with target_id.  Returns a
;;; cons of (remaining nodes . removed cell); the caller frees that cons with
;;; __tui-cons-free.  The removed cell is handed on to the clipboard, so only
;;; its node wrapper and cons cell are released here.  A missing target yields
;;; a 0 cell and leaves the list alone.
  (defn __tui-delete-node-pair [nodes : int target_id : cstr] #fx{Unsafe} : int
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct { int64_t tag; int64_t prose; int64_t cell; } NotebookNode;
    typedef struct {
      char *id;
      int64_t lang;
      char *source;
      int64_t attrs;
      int64_t start_line;
      int64_t end_line;
    } Cell;
    const char *want = target_id ? (const char *)(intptr_t)target_id : "";
    Cons *pair = malloc(sizeof(*pair));
    pair->head = nodes;
    pair->tail = 0;
    Cons *prev = NULL;
    for (Cons *cur = (Cons *)(intptr_t)nodes; cur; prev = cur, cur = (Cons *)(intptr_t)cur->tail) {
      NotebookNode *n = (NotebookNode *)(intptr_t)cur->head;
      if (!n || n->tag != 1) continue;
      Cell *c = (Cell *)(intptr_t)n->cell;
      if (!c || !c->id || strcmp(c->id, want) != 0) continue;
      if (prev) prev->tail = cur->tail;
      else pair->head = cur->tail;
      pair->tail = n->cell;
      free(n);
      free(cur);
      return (int64_t)(intptr_t)pair;
    }
    return (int64_t)(intptr_t)pair;
    ```)

;;; __tui-blank-cell -- a new empty cell with the next free id.  cell-make
;;; copies the id, so the one __tui-fresh-cell-id malloc'd is released here.
  (defn __tui-blank-cell [state : int current : int] #fx{Unsafe} : int
    (let [lang (if (= current 0) 0 (cell-lang current))
          fresh_id (__tui-fresh-cell-id (__tui-state-cells state))
          made (cell-make fresh_id lang "" (__tui-nil-value) 0 0)]
      (do
        (__tui-cstr-free fresh_id)
        made)))

  (defn __tui-cells-from-nodes-rev [nodes : int acc : int] #fx{Unsafe} : int
    (if (__tui-list-nil? nodes)
      acc
      (let [node (__tui-head nodes)]
        (if (= (node-tag node) 1)
          (__tui-cells-from-nodes-rev (__tui-tail nodes) (__tui-cons (node-cell node) acc))
          (__tui-cells-from-nodes-rev (__tui-tail nodes) acc)))))

;;; __tui-reverse -- reverse a list, consuming its cons cells.
  (defn __tui-reverse [lst : int acc : int] #fx{Unsafe} : int
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *cur = (Cons *)(intptr_t)lst;
    int64_t out = acc;
    while (cur) {
      Cons *next = (Cons *)(intptr_t)cur->tail;
      cur->tail = out;
      out = (int64_t)(intptr_t)cur;
      cur = next;
    }
    return out;
    ```)

  (defn __tui-list-length [lst : int] #fx{Unsafe} : int
    (if (__tui-list-nil? lst)
      0
      (+ 1 (__tui-list-length (__tui-tail lst)))))

  (defn __tui-zero-list [count : int] #fx{Unsafe} : int
    (if (<= count 0)
      (__tui-nil-value)
      (__tui-cons 0 (__tui-zero-list (- count 1)))))

  (defn __tui-list-nth [lst : int idx : int] #fx{Unsafe} : int
    (if (__tui-list-nil? lst)
      0
      (if (<= idx 0)
        (__tui-head lst)
        (__tui-list-nth (__tui-tail lst) (- idx 1)))))

;;; __tui-list-set -- set the idx-th element, extending with zeros if short.
;;;
;;; Mutates and returns the same list.  It used to rebuild the entire spine
;;; on every call and the callers replaced the state's list without freeing
;;; the old one -- so a whole spine leaked per keystroke that touched an
;;; output.  That was most of the 890 allocations tui_test was leaking.
  (defn __tui-list-set [lst : int idx : int value : int] #fx{Unsafe} : int
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *head = (Cons *)(intptr_t)lst;
    if (!head) head = calloc(1, sizeof(*head));
    Cons *cur = head;
    for (int64_t i = 0; i < idx; i++) {
      if (!cur->tail) cur->tail = (int64_t)(intptr_t)calloc(1, sizeof(Cons));
      cur = (Cons *)(intptr_t)cur->tail;
    }
    cur->head = value;
    return (int64_t)(intptr_t)head;
    ```)

  (defn __tui-concat-lists [left : int right : int] #fx{Unsafe} : int
    (if (__tui-list-nil? left)
      right
      (__tui-cons (__tui-head left) (__tui-concat-lists (__tui-tail left) right))))

  (defn __tui-write-file [path : cstr text : cstr] #fx{Unsafe} : bool
    ```c
    const char *dst = path ? (const char *)(intptr_t)path : "";
    const char *src = text ? (const char *)(intptr_t)text : "";
    FILE *fp = fopen(dst, "wb");
    if (!fp) return false;
    size_t want = strlen(src);
    size_t wrote = fwrite(src, 1, want, fp);
    fclose(fp);
    return wrote == want;
    ```)

  (defn __tui-state-make [path : cstr nodes : int cells : int bindings : int session : int opts : int] #fx{Unsafe} : int
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
      int64_t outputs;
      int64_t cell_count;
      int64_t focus;
      int64_t session;
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      int64_t keybindings;
      char *status;
      int64_t pending_effect;
      int64_t quit_requested;
      int64_t exit_code;
      int64_t clipboard;
      int64_t dirty;
      int64_t quit_confirm;
      int64_t output_hidden;
      char *search_query;
      int64_t help_visible;
    } NotebookTuiState;
    typedef struct {
      int64_t color;
      int64_t cell_width;
      int64_t scrollback;
      char *keybindings_file;
    } NotebookTuiOpts;
    NotebookTuiOpts *o = (NotebookTuiOpts *)(intptr_t)opts;
    NotebookTuiState *st = malloc(sizeof(*st));
    st->path = path ? strdup((const char *)(intptr_t)path) : strdup("");
    st->nodes = nodes;
    st->cells = cells;
    st->outputs = 0;
    st->cell_count = 0;
    for (struct { int64_t head; int64_t tail; } *cur = (void *)(intptr_t)cells; cur; cur = (void *)(intptr_t)cur->tail) st->cell_count++;
    st->focus = 0;
    st->session = session;
    st->color = o ? o->color : 1;
    st->cell_width = o ? o->cell_width : 0;
    st->scrollback = o ? o->scrollback : 1000;
    st->keybindings = bindings;
    st->status = strdup("command mode");
    st->pending_effect = 0;
    st->quit_requested = 0;
    st->exit_code = 0;
    st->clipboard = 0;
    st->dirty = 0;
    st->quit_confirm = 0;
    st->output_hidden = 0;
    st->search_query = strdup("");
    st->help_visible = 0;
    return (int64_t)(intptr_t)st;
    ```)

;;; __tui-cons-free -- free one cons cell, leaving its head and tail alone.
;;; Returns 0 so it can sit in a `let` binding.
  (defn __tui-cons-free [cell : int] #fx{Unsafe} : int
    ```c
    if (cell) free((void *)(intptr_t)cell);
    return 0;
    ```)

;;; __tui-spine-free -- free a cons spine, leaving the heads alone.
  (defn __tui-spine-free [lst : int] #fx{Unsafe} : void
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *node = (Cons *)(intptr_t)lst;
    while (node) {
      Cons *next = (Cons *)(intptr_t)node->tail;
      free(node);
      node = next;
    }
    ```)

;;; __tui-state-free -- release the TUI state and everything it owns: its two
;;; strings, the node list, the cell spine (the Cells belong to the nodes),
;;; the outputs, the output-hidden flags, the keybindings and the clipboard.
;;; The session is closed by the caller.  Safe on 0.
  (defn __tui-state-free [state : int] #fx{Unsafe} : void
    (if (= state 0)
      (__tui-void)
      (do
        (outputs-free (__tui-state-outputs state))
        (__tui-spine-free (__tui-state-output-hidden state))
        (__tui-spine-free (__tui-state-cells state))
        (keybindings-free (__tui-state-bindings state))
        (cell-free (__tui-state-clipboard state))
        (nodes-free (__tui-state-nodes state))
        (__tui-state-free-shell state))))

;;; __tui-state-free-shell -- free the state's own strings and struct.
  (defn __tui-state-free-shell [state : int] #fx{Unsafe} : void
    ```c
    typedef struct {
      char *path;
      int64_t nodes;
      int64_t cells;
