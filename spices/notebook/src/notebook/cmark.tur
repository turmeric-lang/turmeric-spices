;;; notebook/cmark -- the notebook's Markdown API, over the stdlib's tur/markdown.
;;;
;;; md-parse reads a notebook's Markdown with tur/markdown -- CommonMark, the
;;; GFM extensions and $ / $$ math -- and hands back the tree the rest of the
;;; spice walks: node handles, a tag per node, md-node-children, md-node-text
;;; and the rest.  The parser this module used to carry (2,084 lines, most of
;;; it inline C) is gone; markdown-library-plan M5.
;;;
;;; The tree is copied out of tur/markdown's document, which md-parse then
;;; releases, so a node owns everything it hands out.  Each block also keeps
;;; its Markdown source (the lines it spans, as written) for md-emit and its
;;; HTML (as tur/markdown renders it in place) for md-emit-html.  Lines
;;; between top-level blocks that are not blank -- link reference
;;; definitions, which are no block of their own -- become a paragraph node
;;; whose HTML is empty, so writing a notebook back keeps them.
;;;
;;; Since: NB0
;; Nodes are C records behind int handles, the API the spice has always had.
(load "stdlib/markdown.tur")

(defmodule notebook/cmark
  (export md-tag-document
    md-tag-heading
    md-tag-paragraph
    md-tag-blockquote
    md-tag-list
    md-tag-list-item
    md-tag-code-block
    md-tag-thematic-break
    md-tag-table
    md-tag-table-row
    md-tag-table-cell
    md-tag-text
    md-tag-emph
    md-tag-strong
    md-tag-code-span
    md-tag-link
    md-tag-image
    md-tag-strikethrough
    md-tag-autolink
    md-tag-hard-break
    md-tag-soft-break
    md-tag-math-block
    md-tag-math-inline
    md-tag-html-block
    md-tag-html-inline
    md-parse
    md-node-tag
    md-node-children
    md-node-text
    md-node-info
    md-node-meta
    md-source-span
    md-emit
    md-emit-html
    md-node-free
    md-node-free-shell
    md-children-free
    md-span-free
    __md-drop-kids-cache)
  ;; AST tags.  md-tag-autolink is no longer produced: an autolink is a link.
  (defn md-tag-document [] : int 0)
  (defn md-tag-heading [] : int 1)
  (defn md-tag-paragraph [] : int 2)
  (defn md-tag-blockquote [] : int 3)
  (defn md-tag-list [] : int 4)
  (defn md-tag-list-item [] : int 5)
  (defn md-tag-code-block [] : int 6)
  (defn md-tag-thematic-break [] : int 7)
  (defn md-tag-table [] : int 8)
  (defn md-tag-table-row [] : int 9)
  (defn md-tag-table-cell [] : int 10)
  (defn md-tag-text [] : int 11)
  (defn md-tag-emph [] : int 12)
  (defn md-tag-strong [] : int 13)
  (defn md-tag-code-span [] : int 14)
  (defn md-tag-link [] : int 15)
  (defn md-tag-image [] : int 16)
  (defn md-tag-strikethrough [] : int 17)
  (defn md-tag-autolink [] : int 18)
  (defn md-tag-hard-break [] : int 19)
  (defn md-tag-soft-break [] : int 20)
  (defn md-tag-math-block [] : int 22)
  (defn md-tag-math-inline [] : int 23)
  (defn md-tag-html-block [] : int 24)
  (defn md-tag-html-inline [] : int 25)
  ;; ---------------------------------------------------------------------
  ;; Node records
  ;;
  ;; md-parse returns a document node that owns its whole subtree.  Every
  ;; function below names the record with the same typedef; md and html are
  ;; the block's Markdown source and HTML ("" for an inline node).
  ;; ---------------------------------------------------------------------
  ;;; __md-node-new -- a fresh node record holding copies of text and info.
  (defn __md-node-new [kind : int
                       text : cstr
                       info : cstr
                       meta : int
                       start : int
                       end : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *n = calloc(1, sizeof(*n));
    n->kind = (int)kind;
    n->text = strdup(text ? (const char *)(intptr_t)text : "");
    n->info = strdup(info ? (const char *)(intptr_t)info : "");
    n->meta = (int)meta;
    n->start_line = (int)start;
    n->end_line = (int)end;
    n->md = strdup("");
    n->html = strdup("");
    return (int64_t)(intptr_t)n;
    ```)
  ;;; __md-add-child! -- append child to parent's children.
  (defn __md-add-child! [parent : int child : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *p = (MdNode *)(intptr_t)parent;
    if (p->child_count == p->child_cap) {
      p->child_cap = p->child_cap ? p->child_cap * 2 : 4;
      p->children = realloc(p->children, (size_t)p->child_cap * sizeof(int64_t));
    }
    p->children[p->child_count++] = child;
    ```)
  ;;; __md-set-md! -- give node a copy of s as its Markdown source.
  (defn __md-set-md! [node : int s : cstr]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *n = (MdNode *)(intptr_t)node;
    free(n->md);
    n->md = strdup(s ? (const char *)(intptr_t)s : "");
    ```)
  ;;; __md-set-html! -- give node a copy of s as its HTML.
  (defn __md-set-html! [node : int s : cstr]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *n = (MdNode *)(intptr_t)node;
    free(n->html);
    n->html = strdup(s ? (const char *)(intptr_t)s : "");
    ```)
  ;;; md-node-free -- free a node and its entire subtree.  Safe on 0.
  (defn md-node-free [n : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    typedef struct { int64_t head; int64_t tail; } Cons;
    MdNode *root = (MdNode*)(intptr_t)n;
    if (!root) return;
    /* Iterative rather than recursive: a pathological document should not be
       able to blow the C stack from inside a destructor. */
    size_t cap = 64, top = 0;
    MdNode **stack = malloc(cap * sizeof(*stack));
    stack[top++] = root;
    while (top) {
      MdNode *node = stack[--top];
      for (int i = 0; i < node->child_count; i++) {
        MdNode *kid = (MdNode*)(intptr_t)node->children[i];
        if (!kid) continue;
        if (top == cap) { cap *= 2; stack = realloc(stack, cap * sizeof(*stack)); }
        stack[top++] = kid;
      }
      { Cons *c = (Cons *)(intptr_t)node->kids;
        while (c) { Cons *nx = (Cons *)(intptr_t)c->tail; free(c); c = nx; } }
      free(node->text);
      free(node->info);
      free(node->md);
      free(node->html);
      free(node->children);
      free(node);
    }
    free(stack);
    ```)
  ;;; md-node-free-shell -- free a node's own storage but NOT its children.
  ;;;
  ;;; For the case where the children have been detached and handed to another
  ;;; owner: notebook/format moves the document's blocks into its own nodes and
  ;;; then needs to drop the empty document.
  (defn md-node-free-shell [n : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    typedef struct { int64_t head; int64_t tail; } Cons;
    MdNode *node = (MdNode*)(intptr_t)n;
    if (!node) return;
    Cons *c = (Cons *)(intptr_t)node->kids;
    while (c) { Cons *nx = (Cons *)(intptr_t)c->tail; free(c); c = nx; }
    free(node->text);
    free(node->info);
    free(node->md);
    free(node->html);
    free(node->children);
    free(node);
    ```)
  ;;; md-children-free -- free a cons spine, leaving the nodes it names alone.
  (defn md-children-free [lst : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *node = (Cons *)(intptr_t)lst;
    while (node) {
      Cons *next = (Cons *)(intptr_t)node->tail;
      free(node);
      node = next;
    }
    ```)
  ;;; md-span-free -- free the two-cell list md-source-span returned.
  (defn md-span-free [span : int] #fx{Unsafe} : void (md-children-free span))
  ;;; md-node-tag -- the tag of a parsed markdown node.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle returned by md-parse or md-node-children
  ;;;
  ;;; Returns:
  ;;;   One of the md-tag-* constants, or -1 for 0.
  ;;;
  ;;; Example:
  ;;;   (md-node-tag (md-parse "# Hi"))  ; => (md-tag-document)
  ;;;
  ;;; Since: NB0
  (defn md-node-tag [n : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *node = (MdNode*)(intptr_t)n;
    return node ? node->kind : -1;
    ```)
  ;;; md-node-children -- the children of a node as a cons list.
  ;;;
  ;;; The spine belongs to the node, not to the caller: it is built on the
  ;;; first call and cached, so repeated calls hand back the same list and
  ;;; md-node-free releases it.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle
  ;;;
  ;;; Returns:
  ;;;   A cons list of child node handles in document order.
  ;;;
  ;;; Example:
  ;;;   (md-node-children doc)
  ;;;
  ;;; Since: NB0
  (defn md-node-children [n : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    typedef struct { int64_t head; int64_t tail; } Cons;
    MdNode *node = (MdNode*)(intptr_t)n;
    if (!node) return 0;
    if (node->kids) return node->kids;
    int64_t out = 0;
    for (int i = node->child_count - 1; i >= 0; i--) {
      Cons *cell = malloc(sizeof(*cell));
      cell->head = node->children[i];
      cell->tail = out;
      out = (int64_t)(intptr_t)cell;
    }
    node->kids = out;
    return out;
    ```)
  ;;; __md-drop-kids-cache -- release a node's cached children spine, if any.
  (defn __md-drop-kids-cache [n : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    typedef struct { int64_t head; int64_t tail; } Cons;
    MdNode *node = (MdNode*)(intptr_t)n;
    if (!node) return;
    Cons *c = (Cons *)(intptr_t)node->kids;
    while (c) { Cons *nx = (Cons *)(intptr_t)c->tail; free(c); c = nx; }
    node->kids = 0;
    ```)
  ;;; md-node-text -- a node's text.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle
  ;;;
  ;;; Returns:
  ;;;   A paragraph's, heading's or table cell's source text (inline syntax
  ;;;   kept), a code block's or formula's body without its final line feed,
  ;;;   an HTML block's or inline's HTML, a text or code span's text, or a
  ;;;   link's or image's title; "" otherwise.  Borrowed from the node.
  ;;;
  ;;; Example:
  ;;;   (md-node-text heading)  ; => "Hello" for "# Hello"
  ;;;
  ;;; Since: NB0
  (defn md-node-text [n : int]
    #fx{Unsafe}
    : cstr
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *node = (MdNode*)(intptr_t)n;
    return node && node->text ? node->text : "";
    ```)
  ;;; md-node-info -- a node's info.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle
  ;;;
  ;;; Returns:
  ;;;   A fenced code block's info string, a list's marker ("-", "+", "*", "."
  ;;;   or ")"), or a link's or image's destination; "" otherwise.  Borrowed.
  ;;;
  ;;; Example:
  ;;;   (md-node-info code-block)  ; => "turmeric {id=demo}"
  ;;;
  ;;; Since: NB0
  (defn md-node-info [n : int]
    #fx{Unsafe}
    : cstr
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *node = (MdNode*)(intptr_t)n;
    return node && node->info ? node->info : "";
    ```)
  ;;; md-node-meta -- a node's integer fact.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle
  ;;;
  ;;; Returns:
  ;;;   A heading's level; an ordered list's start (0 for a bullet list); a
  ;;;   list item's task box (0 none, 1 [ ], 2 [x]); 1 on a table's header row;
  ;;;   a table cell's alignment (0 none, 1 left, 2 center, 3 right); else 0.
  ;;;
  ;;; Example:
  ;;;   (md-node-meta heading)  ; => 2 for "## Two"
  ;;;
  ;;; Since: NB0
  (defn md-node-meta [n : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *node = (MdNode*)(intptr_t)n;
    return node ? node->meta : 0;
    ```)
  ;;; md-source-span -- the start/end line pair for a node.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle
  ;;;
  ;;; Returns:
  ;;;   A fresh cons pair (start-line . end-line), both 1-based and inclusive;
  ;;;   free it with md-span-free.  An inline node has its block's lines.
  ;;;
  ;;; Example:
  ;;;   (md-source-span node)
  ;;;
  ;;; Since: NB0
  (defn md-source-span [n : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    typedef struct { int64_t head; int64_t tail; } Cons;
    MdNode *node = (MdNode*)(intptr_t)n;
    Cons *b = malloc(sizeof(*b));
    Cons *a = malloc(sizeof(*a));
    b->head = node ? node->end_line : 0;
    b->tail = 0;
    a->head = node ? node->start_line : 0;
    a->tail = (int64_t)(intptr_t)b;
    return (int64_t)(intptr_t)a;
    ```)
  ;;; md-emit -- a node's Markdown source.
  ;;;
  ;;; A block's is the lines it spans, as written.  The document's is its
  ;;; top-level blocks', with one blank line between each two, as notebook
  ;;; files are written.  An inline node has none.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle
  ;;;
  ;;; Returns:
  ;;;   A fresh string, owned by the caller.
  ;;;
  ;;; Example:
  ;;;   (md-emit (md-parse "# Title"))  ; => "# Title"
  ;;;
  ;;; Since: NB0
  (defn md-emit [n : int]
    #fx{Unsafe}
    : cstr
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *node = (MdNode*)(intptr_t)n;
    return strdup(node && node->md ? node->md : "");
    ```)
  ;;; md-emit-html -- a node's HTML, as tur/markdown renders it.
  ;;;
  ;;; A block's is its HTML where it stands in the document, and the
  ;;; document's is all of it, either without the final line feed.  Math is a
  ;;; <span class="math inline"> or "math display" for KaTeX; raw HTML passes
  ;;; GitHub's tag filter.  An inline node has none.
  ;;;
  ;;; Parameters:
  ;;;   n -- node handle
  ;;;
  ;;; Returns:
  ;;;   A fresh string, owned by the caller.
  ;;;
  ;;; Example:
  ;;;   (md-emit-html (md-parse "# Title"))  ; => "<h1>Title</h1>"
  ;;;
  ;;; Since: NB0
  (defn md-emit-html [n : int]
    #fx{Unsafe}
    : cstr
    ```c
    typedef struct { int kind; char *text; char *info; int meta; int start_line; int end_line;
                     int64_t *children; int child_count; int child_cap; int64_t kids;
                     char *md; char *html; } MdNode;
    MdNode *node = (MdNode*)(intptr_t)n;
    return strdup(node && node->html ? node->html : "");
    ```)
  ;; ---------------------------------------------------------------------
  ;; Building the tree from tur/markdown
  ;; ---------------------------------------------------------------------
  ;;; __md-opts -- what a notebook's Markdown is: CommonMark, the GFM extensions and math.
  (defn __md-opts [] : MdOpts (MdOpts true true true true true))
  ;;; __md-html-opts -- how it renders: raw HTML through GitHub's tag filter, headings without ids.
  (defn __md-html-opts [] : MdHtmlOpts (MdHtmlOpts (MdRawTagFilter) (MdNoIds)))
  ;;; __md-text-of -- the String in o, or a fresh empty one for (none).
  (defn __md-text-of [o : (Option String)] : String
    (match o (Some s) s (None) (string/from-cstr "")))
  ;;; __md-chomp -- s without one final line feed, as a fresh String; s is released.
  (defn __md-chomp [s : String] : String
    (let [n (string/len s)
          e (if (and (> n 0) (= (string/byte-at s (- n 1)) 10)) (- n 1) n)
          t (string/substring s 0 e)]
      (do (string/release s) t)))
  ;;; __md-lines-text -- lines first..last (1-based, inclusive) of lines, joined by line feeds.
  (defn __md-lines-text [lines : (Vec String) first : int last : int] : String
    (let [b      (builder/new)
          ^mut i first]
      (do
        (while (and (<= i last) (<= i (vec-len lines)))
          (do
            (when (> i first) (builder/push-byte! b 10))
            (builder/push-string! b (vec-get lines (- i 1)))
            (set! i (+ i 1))))
        (builder/finish b))))
  ;;; __md-new -- a node record for kind with String text and info, both released.
  (defn __md-new [kind : int
                  text : String
                  info : String
                  meta : int
                  start : int
                  end : int]
    #fx{Unsafe}
    : int
    (let [n (__md-node-new kind
              (string/to-cstr text)
              (string/to-cstr info)
              meta
              start
              end)]
      (do (string/release text) (string/release info) n)))
  ;;; __md-set-md-string! -- set node's Markdown source from s, releasing s.
  (defn __md-set-md-string! [node : int s : String]
    #fx{Unsafe}
    : void
    (do (__md-set-md! node (string/to-cstr s)) (string/release s)))
  ;;; __md-set-html-string! -- set node's HTML from s without its final line feed, releasing s.
  (defn __md-set-html-string! [node : int s : String]
    #fx{Unsafe}
    : void
    (let [t (__md-chomp s)]
      (do (__md-set-html! node (string/to-cstr t)) (string/release t))))
  ;;; __md-inline-tag -- the md-tag-* of inline kind k.
  (defn __md-inline-tag [k : MdInline] : int
    (match k
      (MdText)
      (md-tag-text)
      (MdCode)
      (md-tag-code-span)
      (MdEmph)
      (md-tag-emph)
      (MdStrong)
      (md-tag-strong)
      (MdLink)
      (md-tag-link)
      (MdImage)
      (md-tag-image)
      (MdHtmlInline)
      (md-tag-html-inline)
      (MdSoftBreak)
      (md-tag-soft-break)
      (MdHardBreak)
      (md-tag-hard-break)
      (MdStrikethrough)
      (md-tag-strikethrough)
      (MdMath display)
      (if display (md-tag-math-block) (md-tag-math-inline))))
  ;;; __md-inline-node -- a node for inline id of d, and its children, on lines start..end.
  (defn __md-inline-node [d : MdDoc id : MdInlineId start : int end : int]
    #fx{Unsafe}
    : int
    (let [k      (markdown/inline d id)
          link?  (match k (MdLink) true (MdImage) true _ false)
          text   (if link?
                   (__md-text-of (markdown/link-title d id))
                   (__md-text-of (markdown/inline-text d id)))
          info   (__md-text-of (markdown/link-dest d id))
          node   (__md-new (__md-inline-tag k) text info 0 start end)
          kids   (markdown/inline-children d id)
          ^mut i 0]
      (do
        (while (< i (vec-len kids))
          (do
            (__md-add-child! node
              (__md-inline-node d (vec-get kids i) start end))
            (set! i (+ i 1))))
        (vec-free kids)
        node)))
  ;;; __md-align-meta -- a table cell's alignment as md-node-meta has it.
  (defn __md-align-meta [a : MdAlign] : int
    (match a (MdAlignNone) 0 (MdAlignLeft) 1 (MdAlignCenter) 2 (MdAlignRight) 3))
  ;;; __md-task-meta -- a list item's task box as md-node-meta has it.
  (defn __md-task-meta [t : MdTask] : int
    (match t (MdNotTask) 0 (MdUnchecked) 1 (MdChecked) 2))
  ;;; __md-block-tag -- the md-tag-* of block kind b.
  (defn __md-block-tag [b : MdBlock] : int
    (match b
      (MdDocument)
      (md-tag-document)
      (MdBlockQuote)
      (md-tag-blockquote)
      (MdList o s t)
      (md-tag-list)
      (MdItem k)
      (md-tag-list-item)
      (MdParagraph)
      (md-tag-paragraph)
      (MdHeading l)
      (md-tag-heading)
      (MdThematicBreak)
      (md-tag-thematic-break)
      (MdCodeBlock f)
      (md-tag-code-block)
      (MdHtmlBlock)
      (md-tag-html-block)
      (MdTable c)
      (md-tag-table)
      (MdTableRow h)
      (md-tag-table-row)
      (MdTableCell a)
      (md-tag-table-cell)
      (MdMathBlock)
      (md-tag-math-block)))
  ;;; __md-block-meta -- block kind b's md-node-meta.
  (defn __md-block-meta [b : MdBlock] : int
    (match b
      (MdHeading l)
      l
      (MdList o s t)
      (if o s 0)
      (MdItem k)
      (__md-task-meta k)
      (MdTableRow h)
      (if h 1 0)
      (MdTableCell a)
      (__md-align-meta a)
      _
      0))
  ;;; __md-block-text -- block id's md-node-text: a code block's or formula's body loses its final line feed.
  (defn __md-block-text [d : MdDoc id : MdBlockId b : MdBlock] : String
    (let [t (__md-text-of (markdown/block-text d id))]
      (match b (MdCodeBlock f) (__md-chomp t) (MdMathBlock) (__md-chomp t) _ t)))
  ;;; __md-block-info -- block id's md-node-info: a code block's info string or a list's marker.
  (defn __md-block-info [d : MdDoc id : MdBlockId] : String
    (match (markdown/list-marker d id)
      (Some c)
      (char->string c)
      (None)
      (__md-text-of (markdown/code-info d id))))
  ;;; __md-block-node -- a node for block id of d and everything in it, with its Markdown source from lines.
  (defn __md-block-node [d : MdDoc id : MdBlockId lines : (Vec String)]
    #fx{Unsafe}
    : int
    (let [b      (markdown/block d id)
          span   (markdown/block-lines d id)
          start  (pair-fst span)
          end    (pair-snd span)
          node   (__md-new (__md-block-tag b)
                   (__md-block-text d id b)
                   (__md-block-info d id)
                   (__md-block-meta b)
                   start
                   end)
          kids   (markdown/children d id)
          ins    (markdown/inlines d id)
          ^mut i 0
          ^mut j 0]
      (do
        (while (< i (vec-len kids))
          (do
            (__md-add-child! node (__md-block-node d (vec-get kids i) lines))
            (set! i (+ i 1))))
        (while (< j (vec-len ins))
          (do
            (__md-add-child! node
              (__md-inline-node d (vec-get ins j) start end))
            (set! j (+ j 1))))
        (vec-free kids)
        (vec-free ins)
        (__md-set-md-string! node (__md-lines-text lines start end))
        (__md-set-html-string! node
          (markdown/render-block-html d id (__md-html-opts)))
        node)))
  ;;; __md-blank-lines? -- are lines first..last (1-based, inclusive) all blank?
  (defn __md-blank-lines? [lines : (Vec String) first : int last : int] : bool
    (let [^mut i     first
          ^mut blank true]
      (do
        (while (and blank (<= i last) (<= i (vec-len lines)))
          (let [s      (vec-get lines (- i 1))
                ^mut k 0]
            (do
              (while (< k (string/len s))
                (do
                  (let [c (string/byte-at s k)]
                    (when (not (or (= c 32) (= c 9))) (set! blank false)))
                  (set! k (+ k 1))))
              (set! i (+ i 1)))))
        blank)))
  ;;; __md-trim-blank -- first..last narrowed past the blank lines at either end, as (pair first last); first > last when all are blank.
  (defn __md-trim-blank [lines : (Vec String) first0 : int last0 : int] : (Pair int
                                                                            int)
    (let [^mut a first0
          ^mut z last0]
      (do
        (while (and (<= a z) (__md-blank-lines? lines a a)) (set! a (+ a 1)))
        (while (and (<= a z) (__md-blank-lines? lines z z)) (set! z (- z 1)))
        (pair a z))))
  ;;; __md-gap-node! -- when lines first..last hold more than blank lines (link reference definitions), add a paragraph node holding them, with no HTML, to doc; first..last as given.
  (defn __md-gap-node! [doc : int lines : (Vec String) first : int last : int]
    #fx{Unsafe}
    : void
    (let [r (__md-trim-blank lines first last)
          a (pair-fst r)
          z (pair-snd r)]
      (when (<= a z)
        (let [t (__md-lines-text lines a z)
              n (__md-node-new (md-tag-paragraph) (string/to-cstr t) "" 0 a z)]
          (do
            (__md-set-md! n (string/to-cstr t))
            (string/release t)
            (__md-add-child! doc n))))))
  ;;; __md-head -- the head of a cons cell.
  (defn __md-head [lst : int]
    #fx{Unsafe}
    : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    return cell ? cell->head : 0;
    ```)
  ;;; __md-tail -- the tail of a cons cell.
  (defn __md-tail [lst : int]
    #fx{Unsafe}
    : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    return cell ? cell->tail : 0;
    ```)
  ;;; __md-free-cstr -- free a malloc'd string.
  (defn __md-free-cstr [s : cstr]
    #fx{Unsafe}
    : void
    ```c
    free((void *)(intptr_t)s);
    ```)
  ;;; __md-doc-md -- the document's Markdown: its top-level nodes' sources, a blank line between each two.
  (defn __md-doc-md [doc : int]
    #fx{Unsafe}
    : String
    (let [b          (builder/new)
          ^mut kids  (md-node-children doc)
          ^mut first true]
      (do
        (while (not (= kids 0))
          (let [s (md-emit (__md-head kids))]
            (do
              (when (not first) (builder/push-cstr! b "\n\n"))
              (builder/push-cstr! b s)
              (__md-free-cstr s)
              (set! first false)
              (set! kids (__md-tail kids)))))
        (builder/finish b))))
  ;;; md-parse -- parse a notebook's Markdown into a node tree.
  ;;;
  ;;; Parameters:
  ;;;   source -- the Markdown text (borrowed)
  ;;;
  ;;; Returns:
  ;;;   A document node owning its whole subtree; free it with md-node-free.
  ;;;
  ;;; Example:
  ;;;   (md-parse "# Title\n\nParagraph.")
  ;;;
  ;;; Since: NB0
  (defn md-parse [source : cstr]
    #fx{Unsafe}
    : int
    (let [src       (string/from-cstr source)
          lines     (string/lines src)
          d         (markdown/parse src (__md-opts))
          tops      (markdown/children d (markdown/root d))
          doc       (__md-node-new (md-tag-document) "" "" 0 1 (vec-len lines))
          ^mut i    0
          ^mut next 1]
      (do
        (while (< i (vec-len tops))
          (let [id   (vec-get tops i)
                span (markdown/block-lines d id)]
            (do
              (__md-gap-node! doc lines next (- (pair-fst span) 1))
              (__md-add-child! doc (__md-block-node d id lines))
              (set! next (+ (pair-snd span) 1))
              (set! i (+ i 1)))))
        (__md-gap-node! doc lines next (vec-len lines))
        (__md-set-md-string! doc (__md-doc-md doc))
        (__md-drop-kids-cache doc)
        (__md-set-html-string! doc (markdown/render-html d (__md-html-opts)))
        (vec-free tops)
        (markdown/doc-free d)
        (string/release-all lines)
        (string/release src)
        doc)))) ;; end defmodule notebook/cmark
