          out (__rhtml-wrap3 "<section class=\"notebook-cell\">" content "" "" "</section>")]
      (do
        (__rhtml-cstr-free content)
        out)))

  (defn __rhtml-should-toggle-pair? [cell_a : int cell_b : int opts : int] #fx{Unsafe} : bool
