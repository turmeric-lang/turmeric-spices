      acc
      (let [node (__rhtml-head nodes)]
        (__rhtml-cells-from-nodes-rev
          (__rhtml-tail nodes)
          (if (= (node-tag node) 1)
            (__rhtml-cons (node-cell node) acc)
            acc)))))

  ;;; __rhtml-reverse -- reverse a list, consuming its cons cells.
  (defn __rhtml-reverse [lst : int acc : int] #fx{Unsafe} : int
    (if (__rhtml-list-nil? lst)
      acc
      (let [next (__rhtml-tail lst)
            out  (__rhtml-cons (__rhtml-head lst) acc)]
        (do
          (__rhtml-cons-free lst)
          (__rhtml-reverse next out)))))

  (defn __rhtml-cells-from-nodes [nodes : int] #fx{Unsafe} : int
