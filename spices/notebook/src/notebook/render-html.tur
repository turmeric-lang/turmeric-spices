      "  border: 0;\n"
      "  cursor: pointer;\n"
      "}\n"
      ".seg-btn:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
      ".seg-btn.active { color: var(--gold-bright); background: var(--gold-subtle); }\n"
      ".code-version { display: block; }\n"
      ".code-version[hidden] { display: none; }\n"
