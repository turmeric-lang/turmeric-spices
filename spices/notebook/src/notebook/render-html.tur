;;; notebook/render-html -- render notebook documents to standalone HTML.
;; notebook/render-html -- evaluate .tur.md files and emit HTML output.

(defmodule notebook/render-html
  (import notebook/cmark :refer [md-emit-html])
  (import notebook/format :refer [parse-file node-tag node-prose node-cell nodes-free])
  (import notebook/cell :refer [attr-get attr-get-bool cell-id cell-lang cell-source cell-attrs cells-assign-ids])
  (import notebook/session :refer [session-open session-close
                                   output-status-ok output-status-error output-status-skipped
                                   cell-output-status cell-output-cell-id
                                   cell-output-stdout cell-output-value-repr
                                   cell-output-error-msg cell-output-elapsed-ms
                                   cell-output-image-paths
                                   cell-output-type-tag])
  (import notebook/eval :refer [eval-all outputs-free])
  (import notebook/cache :refer [cache-open cache-close])
  (export render-html-string render-html-string-at render-html)

  (defn __rhtml-build-hint [] : int
    ```c
    /* __tur_include__: #include <sys/stat.h> */
    return 0;
    ```)

  (defn __rhtml-nil-value [] #fx{Unsafe} : int
    ```c
    return 0;
    ```)

  (defn __rhtml-list-nil? [lst : int] #fx{Unsafe} : bool
    ```c
    return lst == 0;
    ```)

  (defn __rhtml-cons [value : int next : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = malloc(sizeof(*cell));
    cell->head = value;
    cell->tail = next;
    return (int64_t)(intptr_t)cell;
    ```)

  (defn __rhtml-head [lst : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    if (!cell) { fprintf(stderr, "head: empty list\n"); exit(1); }
    return cell->head;
    ```)

  (defn __rhtml-tail [lst : int] #fx{Unsafe} : int
    ```c
    struct { int64_t head; int64_t tail; } *cell = (void*)(intptr_t)lst;
    if (!cell) { fprintf(stderr, "tail: empty list\n"); exit(1); }
    return cell->tail;
    ```)

  (defn __rhtml-ok [value : int] #fx{Unsafe} : int
    ```c
    return tur_box_ok(value);
    ```)

  (defn __rhtml-err [value : cstr] #fx{Unsafe} : int
    ```c
    return tur_err_ptr(value ? strdup((const char *)(intptr_t)value) : strdup(""));
    ```)

  (defn __rhtml-result-ok? [result : int] #fx{Unsafe} : bool
    ```c
    return tur_is_ok(result);
    ```)

  (defn __rhtml-result-ok-val [result : int] #fx{Unsafe} : int
    ```c
    return result ? tur_ok_value(result) : 0;
    ```)

  (defn __rhtml-cstr-as-int [s : cstr] #fx{Unsafe} : int
    ```c
    return (int64_t)(intptr_t)s;
    ```)

  (defn __rhtml-int-as-cstr [value : int] #fx{Unsafe} : cstr
    ```c
    return (const char *)(intptr_t)value;
    ```)

  (defn __rhtml-cstr-empty? [s : cstr] #fx{Unsafe} : bool
    ```c
    const char *src = s ? (const char *)(intptr_t)s : "";
    return src[0] == '\0';
    ```)

  (defn __rhtml-cstr-eq? [a : cstr b : cstr] #fx{Unsafe} : bool
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    return strcmp(sa, sb) == 0;
    ```)

  (defn __rhtml-str-concat [a : cstr b : cstr] #fx{Unsafe} : cstr
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    size_t la = strlen(sa), lb = strlen(sb);
    char *out = malloc(la + lb + 1);
    memcpy(out, sa, la);
    memcpy(out + la, sb, lb);
    out[la + lb] = '\0';
    return out;
    ```)

;; ---------------------------------------------------------------------
;; String ownership
;;
;; Every helper below returns a string the CALLER OWNS.  The module used to
;; mix owned strings and borrowed literals under one type -- and
;; __rhtml-join-blocks sometimes returned one of its arguments -- so no call
;; site could know whether to free what it got, and none did.
;; ---------------------------------------------------------------------

;;; __rhtml-strdup -- an owned copy of a borrowed string.
  (defn __rhtml-strdup [s : cstr] #fx{Unsafe} : cstr
    ```c
    const char *p = s ? (const char *)(intptr_t)s : "";
    return strdup(p);
    ```)

;;; __rhtml-join-owned -- join two OWNED blocks with a newline, releasing both.
  (defn __rhtml-join-owned [a : cstr b : cstr] #fx{Unsafe} : cstr
    ```c
    const char *sa = a ? (const char *)(intptr_t)a : "";
    const char *sb = b ? (const char *)(intptr_t)b : "";
    size_t la = strlen(sa), lb = strlen(sb);
    char *out;
    if (la == 0)      out = strdup(sb);
    else if (lb == 0) out = strdup(sa);
    else {
      out = malloc(la + 1 + lb + 1);
      memcpy(out, sa, la);
      out[la] = '\n';
      memcpy(out + la + 1, sb, lb);
      out[la + 1 + lb] = '\0';
    }
    if (a) free((void *)(intptr_t)a);
    if (b) free((void *)(intptr_t)b);
    return out;
    ```)

;;; __rhtml-wrap3 -- pre + a + mid + b + post, in one allocation.
;;;
;;; The nested __rhtml-str-concat chains this and its siblings replace built
;;; one throwaway string per link -- 63 concat calls across ten functions, and
;;; every intermediate was dropped.  That was the single largest leak in the
;;; spice: 62 KB in one render_html run.
  (defn __rhtml-wrap3 [pre : cstr a : cstr mid : cstr b : cstr post : cstr] #fx{Unsafe} : cstr
    ```c
    const char *p0 = pre  ? (const char *)(intptr_t)pre  : "";
    const char *p1 = a    ? (const char *)(intptr_t)a    : "";
    const char *p2 = mid  ? (const char *)(intptr_t)mid  : "";
    const char *p3 = b    ? (const char *)(intptr_t)b    : "";
    const char *p4 = post ? (const char *)(intptr_t)post : "";
    size_t n = strlen(p0) + strlen(p1) + strlen(p2) + strlen(p3) + strlen(p4) + 1;
    char *out = malloc(n);
    snprintf(out, n, "%s%s%s%s%s", p0, p1, p2, p3, p4);
    return out;
    ```)

;;; __rhtml-wrap4 -- pre + a + m1 + b + m2 + c + post, in one allocation.
  (defn __rhtml-wrap4 [pre : cstr a : cstr m1 : cstr b : cstr m2 : cstr c : cstr post : cstr] #fx{Unsafe} : cstr
    ```c
    const char *p0 = pre  ? (const char *)(intptr_t)pre  : "";
    const char *p1 = a    ? (const char *)(intptr_t)a    : "";
    const char *p2 = m1   ? (const char *)(intptr_t)m1   : "";
    const char *p3 = b    ? (const char *)(intptr_t)b    : "";
    const char *p4 = m2   ? (const char *)(intptr_t)m2   : "";
    const char *p5 = c    ? (const char *)(intptr_t)c    : "";
    const char *p6 = post ? (const char *)(intptr_t)post : "";
    size_t n = strlen(p0)+strlen(p1)+strlen(p2)+strlen(p3)+strlen(p4)+strlen(p5)+strlen(p6)+1;
    char *out = malloc(n);
    snprintf(out, n, "%s%s%s%s%s%s%s", p0, p1, p2, p3, p4, p5, p6);
    return out;
    ```)

;;; __rhtml-cstr-free -- release an owned string.  Safe on 0.
  (defn __rhtml-cstr-free [s : cstr] #fx{Unsafe} : void
    ```c
    void *p = (void *)(intptr_t)s;
    if (p) free(p);
    ```)

;;; __rhtml-cons-free -- free one cons cell, leaving its head alone.
  (defn __rhtml-cons-free [node : int] #fx{Unsafe} : void
    ```c
    free((void *)(intptr_t)node);
    ```)

;;; __rhtml-spine-free -- free a cons spine, leaving the heads alone.
  (defn __rhtml-spine-free [lst : int] #fx{Unsafe} : void
    ```c
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *node = (Cons *)(intptr_t)lst;
    while (node) {
      Cons *next = (Cons *)(intptr_t)node->tail;
      free(node);
      node = next;
    }
    ```)

;;; __rhtml-result-box-free -- release a Result box after taking its payload.
;;; Returns 0 so it can sit in a `let` binding.
  (defn __rhtml-result-box-free [r : int] #fx{Unsafe} : int
    ```c
    if (r) free((void *)(intptr_t)r);
    return 0;
    ```)

;;; __rhtml-noop -- void no-op, so a cleanup-only `if` has void on both arms.
  (defn __rhtml-noop [] #fx{Unsafe} : void
    ```c
    return;
    ```)

  (defn __rhtml-join-blocks [a : cstr b : cstr] #fx{Unsafe} : cstr
    (if (__rhtml-cstr-empty? a)
      b
      (if (__rhtml-cstr-empty? b)
        a
        (__rhtml-str-concat a (__rhtml-str-concat "\n" b)))))

  (defn __rhtml-output-path [src_path : cstr output_dir : cstr] #fx{Unsafe} : cstr
    ```c
    const char *src = src_path ? (const char *)(intptr_t)src_path : "";
    const char *out_dir = output_dir ? (const char *)(intptr_t)output_dir : "";
    const char *base = strrchr(src, '/');
    base = base ? base + 1 : src;

    size_t base_len = strlen(base);
    size_t stem_len = base_len;
    if (base_len >= 7 && strcmp(base + base_len - 7, ".tur.md") == 0) {
      stem_len = base_len - 7;
    } else {
      const char *dot = strrchr(base, '.');
      if (dot) stem_len = (size_t)(dot - base);
    }

    char *stem = malloc(stem_len + 1);
    memcpy(stem, base, stem_len);
    stem[stem_len] = '\0';

    char *dir = NULL;
    if (out_dir[0] != '\0') {
      dir = strdup(out_dir);
    } else {
      const char *slash = strrchr(src, '/');
      if (!slash) {
        dir = strdup("");
      } else {
        size_t dir_len = (size_t)(slash - src);
        dir = malloc(dir_len + 1);
        memcpy(dir, src, dir_len);
        dir[dir_len] = '\0';
      }
    }

    size_t need = strlen(dir) + (dir[0] ? 1 : 0) + strlen(stem) + 5 + 1;
    char *out = malloc(need);
    if (dir[0]) snprintf(out, need, "%s/%s.html", dir, stem);
    else snprintf(out, need, "%s.html", stem);

    free(stem);
    free(dir);
    return out;
    ```)

  (defn __rhtml-style-path [html_path : cstr] #fx{Unsafe} : cstr
    ```c
    const char *src = html_path ? (const char *)(intptr_t)html_path : "";
    const char *slash = strrchr(src, '/');
    size_t dir_len = slash ? (size_t)(slash - src) : 0;
    size_t need = dir_len + (dir_len ? 1 : 0) + strlen("style.css") + 1;
    char *out = malloc(need);
    if (dir_len) snprintf(out, need, "%.*s/style.css", (int)dir_len, src);
    else snprintf(out, need, "style.css");
    return out;
    ```)

  (defn __rhtml-ensure-parent-dir [path : cstr] #fx{Unsafe} : int
    ```c
    #include <sys/stat.h>
    const char *src = path ? (const char *)(intptr_t)path : "";
    const char *slash = strrchr(src, '/');
    if (!slash) return 0;
    size_t len = (size_t)(slash - src);
    char *dir = malloc(len + 1);
    memcpy(dir, src, len);
    dir[len] = '\0';
    if (dir[0] == '\0') { free(dir); return 0; }

    int ret = 0;
    for (char *p = dir + 1; *p; p++) {
      if (*p == '/') {
        struct stat st;
        *p = '\0';
        if (stat(dir, &st) != 0) {
          if (mkdir(dir, 0755) != 0) { ret = -1; break; }
        } else if (!S_ISDIR(st.st_mode)) {
          ret = -1;
          break;
        }
        *p = '/';
      }
    }
    if (ret == 0) {
      struct stat st;
      if (stat(dir, &st) != 0) {
        if (mkdir(dir, 0755) != 0) ret = -1;
      } else if (!S_ISDIR(st.st_mode)) {
        ret = -1;
      }
    }
    free(dir);
    return ret;
    ```)

  (defn __rhtml-write-file [path : cstr s : cstr] #fx{Unsafe} : int
    ```c
    const char *p = path ? (const char *)(intptr_t)path : "";
    const char *text = s ? (const char *)(intptr_t)s : "";
    FILE *fp = fopen(p, "wb");
    if (!fp) return 0;
    size_t len = strlen(text);
    size_t wrote = fwrite(text, 1, len, fp);
    fclose(fp);
    return wrote == len ? 1 : 0;
    ```)

  (defn __rhtml-close-cache [cache : int] #fx{Unsafe} : int
    (if (not (= cache 0))
      (do
        (cache-close cache)
        0)
      0))

