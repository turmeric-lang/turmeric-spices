                  "<section class=\"code-card code-toggle\"><div class=\"code-card-bar\"><span class=\"cell-meta\">paired syntax view</span><div class=\"code-syntax-toggle\" role=\"tablist\">"
                  btn-a "" btn-b "</div></div>")
