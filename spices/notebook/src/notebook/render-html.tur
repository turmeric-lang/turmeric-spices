          out (__rhtml-wrap4 "<div class=\"code-version "
                             (__rhtml-lang-label (cell-lang cell))
                             "-version\" role=\"tabpanel\""
                             (if active? "" " hidden=\"hidden\"")
                             ">" content "</div>")]
      (do
        (__rhtml-cstr-free content)
        out)))

  (defn __rhtml-render-toggle-pair [cell_a : int output_a : int cell_b : int output_b : int opts : int html_path : cstr] #fx{Unsafe} : cstr
