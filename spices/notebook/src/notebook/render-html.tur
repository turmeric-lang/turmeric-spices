         (and (__rhtml-cell-shows-source? cell_a opts)
              (__rhtml-cell-shows-source? cell_b opts))))

  (defn __rhtml-toggle-button [lang : int active? : bool] #fx{Unsafe} : cstr
    (__rhtml-toggle-button-build (__rhtml-lang-label lang)
                                 (if active? " active" "")
                                 (if active? "true" "false")))

  ;; `activecls`, not `active-cls`: the mangler turns `-` into `_hy`, so the
  ;; C body would have to say `active_hycls`.  A separator-free name mangles
  ;; to itself.
  (defn __rhtml-toggle-button-build [label : cstr activecls : cstr selected : cstr] #fx{Unsafe} : cstr
    ```c
    const char *l = label     ? (const char *)(intptr_t)label     : "";
    const char *a = activecls ? (const char *)(intptr_t)activecls : "";
    const char *sel = selected ? (const char *)(intptr_t)selected : "";
    size_t n = strlen(l) * 2 + strlen(a) + strlen(sel) + 96;
    char *out = malloc(n);
    snprintf(out, n,
      "<button class=\"seg-btn%s\" data-syntax=\"%s\" role=\"tab\" aria-selected=\"%s\">%s</button>",
      a, l, sel, l);
    return out;
    ```)

  (defn __rhtml-toggle-panel [cell : int output : int opts : int html_path : cstr active? : bool] #fx{Unsafe} : cstr
