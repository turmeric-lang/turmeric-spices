  (defn __rhtml-render-state-make [text : cstr outputs : int] #fx{Unsafe} : int
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *state = malloc(sizeof(*state));
    state->text = text ? strdup((const char *)(intptr_t)text) : strdup("");
    state->outputs = outputs;
    return (int64_t)(intptr_t)state;
    ```)

  (defn __rhtml-render-state-text [state : int] #fx{Unsafe} : cstr
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    return s && s->text ? s->text : "";
    ```)

  (defn __rhtml-render-state-outputs [state : int] #fx{Unsafe} : int
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    return s ? s->outputs : 0;
    ```)

;;; __rhtml-render-state-adopt -- build a state that TAKES OWNERSHIP of `text`.
  (defn __rhtml-render-state-adopt [text : cstr outputs : int] #fx{Unsafe} : int
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *state = malloc(sizeof(*state));
    state->text = text ? (char *)(intptr_t)text : strdup("");
    state->outputs = outputs;
    return (int64_t)(intptr_t)state;
    ```)

;;; __rhtml-state-take-text -- hand the text out and clear the field.
  (defn __rhtml-state-take-text [state : int] #fx{Unsafe} : cstr
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    if (!s) return strdup("");
    char *t = s->text ? s->text : strdup("");
    s->text = NULL;
    return t;
    ```)

;;; __rhtml-render-state-free -- release a state and its text.  Safe on 0.
  (defn __rhtml-render-state-free [state : int] #fx{Unsafe} : void
    ```c
    typedef struct { char *text; int64_t outputs; } RenderState;
    RenderState *s = (RenderState *)(intptr_t)state;
    if (!s) return;
    free(s->text);
    free(s);
    ```)

  (defn __rhtml-render-body [nodes : int outputs : int opts : int html_path : cstr] #fx{Unsafe} : int
    (if (__rhtml-list-nil? nodes)
      (__rhtml-render-state-make "" outputs)
      (let [node (__rhtml-head nodes)]
        (if (= (node-tag node) 0)
          (let [rest      (__rhtml-render-body (__rhtml-tail nodes) outputs opts html_path)
                rest-outs (__rhtml-render-state-outputs rest)
                joined    (__rhtml-join-owned (md-emit-html (node-prose node))
                                              (__rhtml-state-take-text rest))]
            (do
              (__rhtml-render-state-free rest)
              (__rhtml-render-state-adopt joined rest-outs)))
          (let [cell (node-cell node)
                cur-output (if (__rhtml-list-nil? outputs) 0 (__rhtml-head outputs))
                rest-outputs (if (__rhtml-list-nil? outputs) (__rhtml-nil-value) (__rhtml-tail outputs))
                more-nodes (__rhtml-tail nodes)]
            (if (and (not (__rhtml-list-nil? more-nodes))
                     (= (node-tag (__rhtml-head more-nodes)) 1)
                     (__rhtml-should-toggle-pair? cell (node-cell (__rhtml-head more-nodes)) opts))
              (let [next-cell (node-cell (__rhtml-head more-nodes))
                    next-output (if (__rhtml-list-nil? rest-outputs) 0 (__rhtml-head rest-outputs))
                    tail-outputs (if (__rhtml-list-nil? rest-outputs) (__rhtml-nil-value) (__rhtml-tail rest-outputs))
                    rest (__rhtml-render-body (__rhtml-tail more-nodes) tail-outputs opts html_path)
                    rest-outs (__rhtml-render-state-outputs rest)
                    joined (__rhtml-join-owned
                             (__rhtml-render-toggle-pair cell cur-output next-cell next-output opts html_path)
                             (__rhtml-state-take-text rest))]
                (do
                  (__rhtml-render-state-free rest)
                  (__rhtml-render-state-adopt joined rest-outs)))
              (let [rest (__rhtml-render-body more-nodes rest-outputs opts html_path)
                    rest-outs (__rhtml-render-state-outputs rest)
                    joined (__rhtml-join-owned
                             (__rhtml-render-single-cell cell cur-output opts html_path)
                             (__rhtml-state-take-text rest))]
                (do
                  (__rhtml-render-state-free rest)
                  (__rhtml-render-state-adopt joined rest-outs)))))))))

  (defn __rhtml-cells-from-nodes-rev [nodes : int acc : int] #fx{Unsafe} : int
