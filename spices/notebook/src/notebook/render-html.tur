;;; __rhtml-frame-text-to-table -- parse pipe-delimited print-frame output
;;; into an HTML <table>.  Skips the type row and separator dashes.
;;; All cell values are HTML-escaped.  Returns an owned string.
  (defn __rhtml-frame-text-to-table [text : cstr] #fx{Unsafe} : cstr
    ```c
    const char *src = text ? (const char *)(intptr_t)text : "";
    /* Pre-scan: count lines that start with '|' to size the buffer. */
    size_t cap = strlen(src) * 6 + 256;
    char *out = malloc(cap);
    size_t len = 0;
    #define APPEND(str) do { \
      size_t n = strlen(str); \
      if (len + n + 1 > cap) { while (len + n + 1 > cap) cap *= 2; \
        out = realloc(out, cap); } \
      memcpy(out + len, str, n); len += n; } while(0)
    #define APPEND_ESC(ch) do { \
      const char *rep = NULL; \
      switch (ch) { \
        case '&': rep = "&amp;"; break; \
        case '<': rep = "&lt;"; break; \
        case '>': rep = "&gt;"; break; \
        case '"': rep = "&quot;"; break; \
        case '\'': rep = "&#39;"; break; \
      } \
      if (rep) APPEND(rep); else { if (len+2>cap){cap*=2;out=realloc(out,cap);} out[len++]=ch; } \
    } while(0)

    APPEND("<table class=\"frame-table\">");

    const char *line = src;
    int row_idx = 0;
    int is_header_done = 0;
    while (*line) {
      const char *nl = strchr(line, '\n');
      size_t line_len = nl ? (size_t)(nl - line) : strlen(line);
      /* Skip empty lines */
      if (line_len == 0) { if (!nl) break; line = nl + 1; continue; }
      /* Skip separator lines (only |, -, whitespace) */
      int is_sep = 1;
      for (size_t i = 0; i < line_len; i++) {
        char c = line[i];
        if (c != '|' && c != '-' && c != ' ' && c != '\t' && c != '\r') { is_sep = 0; break; }
      }
      if (is_sep) { if (!nl) break; line = nl + 1; continue; }
      /* Only process lines that start with '|' */
      if (line[0] != '|') { if (!nl) break; line = nl + 1; continue; }

      if (row_idx == 0) {
        /* Header row */
        APPEND("<thead><tr>");
        for (size_t i = 1; i < line_len; i++) {
          if (line[i] == '|') {
            /* End of cell -- but only if next char is space or | or end */
            /* We'll split on | and trim */
          }
        }
        /* Simple split: extract cells between | delimiters */
        size_t start = 1; /* skip leading | */
        for (size_t i = 1; i <= line_len; i++) {
          if (i == line_len || line[i] == '|') {
            /* Cell from start to i, trim whitespace */
            while (start < i && (line[start]==' '||line[start]=='\t')) start++;
            size_t end = i;
            while (end > start && (line[end-1]==' '||line[end-1]=='\t'||line[end-1]=='\r')) end--;
            if (end > start) {
              APPEND("<th>");
              for (size_t j = start; j < end; j++) APPEND_ESC(line[j]);
              APPEND("</th>");
            }
            start = i + 1;
          }
        }
        APPEND("</tr></thead><tbody>");
        is_header_done = 1;
        row_idx++;
      } else {
        /* Skip the type row (row_idx == 1) -- it follows the header */
        if (row_idx == 1) { row_idx++; if (!nl) break; line = nl + 1; continue; }
        /* Data row */
        APPEND("<tr>");
        size_t start = 1;
        for (size_t i = 1; i <= line_len; i++) {
          if (i == line_len || line[i] == '|') {
            while (start < i && (line[start]==' '||line[start]=='\t')) start++;
            size_t end = i;
            while (end > start && (line[end-1]==' '||line[end-1]=='\t'||line[end-1]=='\r')) end--;
            if (end > start) {
              APPEND("<td>");
              for (size_t j = start; j < end; j++) APPEND_ESC(line[j]);
              APPEND("</td>");
            }
            start = i + 1;
          }
        }
        APPEND("</tr>");
        row_idx++;
      }
      if (!nl) break;
      line = nl + 1;
    }
    if (is_header_done) APPEND("</tbody>");
    APPEND("</table>");
    out[len] = '\0';
    #undef APPEND
    #undef APPEND_ESC
    return out;
    ```)

