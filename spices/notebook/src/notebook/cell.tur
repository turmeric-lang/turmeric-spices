  ;; ---------------------------------------------------------------------
  ;; Ownership
  ;;
  ;; Every constructor here returns a value the caller owns, and every
  ;; container owns its elements: an attrs list owns its Attrs, and a Cell owns
  ;; its id, its source and its attrs list.  None of that used to be releasable
  ;; -- there was no `free` of any kind in this module -- so every notebook test
  ;; that parsed a cell ended with AddressSanitizer reporting the leak and
  ;; exiting non-zero.
  ;;
  ;; Each of these is safe on 0.
  ;; ---------------------------------------------------------------------
  ;;; attrs-free -- release an attrs list and every Attr in it.
  (defn attrs-free [attrs : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { char *name; char *value; } Attr;
    typedef struct { int64_t head; int64_t tail; } Cons;
    Cons *node = (Cons *)(intptr_t)attrs;
    while (node) {
      Cons *next = (Cons *)(intptr_t)node->tail;
      Attr *a = (Attr *)(intptr_t)node->head;
      if (a) { free(a->name); free(a->value); free(a); }
      free(node);
      node = next;
    }
    ```)
  ;;; attrs-copy -- deep-copy an attrs list.  cell-make stores the list it is
  ;;; handed rather than copying it, so anything that builds a second Cell from
  ;;; an existing one's attrs has to copy first: sharing the list would leave two
  ;;; Cells owning it and cell-free would run over it twice.
  (defn attrs-copy [attrs : int]
    #fx{Unsafe}
    : int
    ```c
    typedef struct { char *name; char *value; } Attr;
    typedef struct { int64_t head; int64_t tail; } Cons;
    int64_t out = 0;
    Cons *tailp = NULL;
    for (Cons *node = (Cons *)(intptr_t)attrs; node; node = (Cons *)(intptr_t)node->tail) {
      Attr *src = (Attr *)(intptr_t)node->head;
      Attr *dst = malloc(sizeof(*dst));
      dst->name  = strdup(src && src->name  ? src->name  : "");
      dst->value = strdup(src && src->value ? src->value : "");
      Cons *cell = malloc(sizeof(*cell));
      cell->head = (int64_t)(intptr_t)dst;
      cell->tail = 0;
      if (tailp) tailp->tail = (int64_t)(intptr_t)cell;
      else out = (int64_t)(intptr_t)cell;
      tailp = cell;
    }
    return out;
    ```)
  ;;; cell-free -- release a Cell, including the attrs list it owns.
  (defn cell-free [cell : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct { char *name; char *value; } Attr;
    typedef struct { int64_t head; int64_t tail; } Cons;
    typedef struct {
      char *id;
      int64_t lang;
      char *source;
      int64_t attrs;
      int64_t start_line;
      int64_t end_line;
    } Cell;
    Cell *c = (Cell *)(intptr_t)cell;
    if (!c) return;
    free(c->id);
    free(c->source);
    Cons *node = (Cons *)(intptr_t)c->attrs;
    while (node) {
      Cons *next = (Cons *)(intptr_t)node->tail;
      Attr *a = (Attr *)(intptr_t)node->head;
      if (a) { free(a->name); free(a->value); free(a); }
      free(node);
      node = next;
    }
    free(c);
    ```)
  ;;; cells-free -- release a cons list of Cells and the list's own cells.
  (defn cells-free [cells : int]
    #fx{Unsafe}
    : void
    (if (__cell-list-nil? cells)
      (__cell-noop)
      (let [next (__cell-tail cells)]
        (do
          (cell-free (__cell-head cells))
          (__cell-cons-free cells)
          (cells-free next)))))
  ;;; __cell-cons-free -- free one cons cell, leaving its head alone.
  (defn __cell-cons-free [node : int]
    #fx{Unsafe}
    : void
    ```c
    free((void *)(intptr_t)node);
    ```)
  ;;; __cell-noop -- void no-op, so a cleanup-only `if` has void on both arms.
  (defn __cell-noop []
    #fx{Unsafe}
    : void
    ```c
    return;
    ```)
  ;;; __assign-cell-id -- give `cell` the id "cell-<idx>" if it has none.
  ;;;
  ;;; Rewrites the id in place.  It used to build a WHOLE NEW Cell with
  ;;; cell-make and return that, which leaked three ways at once: the original
  ;;; Cell was orphaned, the two temporary strings behind the generated id were
  ;;; dropped after cell-make strdup'd them, and -- worse than any leak -- the
  ;;; new Cell aliased the old one's attrs list, so any correct `free` of both
  ;;; would be a double free.  Mutating removes all three.
  (defn __assign-cell-id [cell : int idx : int]
    #fx{Unsafe}
    : void
    ```c
    typedef struct {
      char *id;
      int64_t lang;
      char *source;
      int64_t attrs;
      int64_t start_line;
      int64_t end_line;
    } Cell;
    Cell *c = (Cell *)(intptr_t)cell;
    if (!c) return;
    if (c->id && c->id[0] != '\0') return;
    char buf[32];
    snprintf(buf, sizeof(buf), "cell-%lld", (long long)idx);
    free(c->id);
    c->id = strdup(buf);
    ```)
  ;;; cells-assign-ids -- fill in missing cell ids with sequential cell-N names.
  ;;;
  ;;; Returns the list it was given, with ids filled in.  It used to return a
  ;;; freshly consed list built by reversing an intermediate list -- so both
  ;;; the intermediate list's cons cells and every replaced Cell leaked, and
  ;;; the caller was handed a list that shared attrs with the one it still
  ;;; held.  Every caller uses the return value and drops the input, so
  ;;; returning the same list is a drop-in change.
  (defn cells-assign-ids [cells : int]
    #fx{Unsafe}
    : int
    (do (__cells-assign-ids-walk cells 1) cells))
  (defn __cells-assign-ids-walk [cells : int idx : int]
    #fx{Unsafe}
    : int
    (if (__cell-list-nil? cells)
      0
      (do
        (__assign-cell-id (__cell-head cells) idx)
        (__cells-assign-ids-walk (__cell-tail cells) (+ idx 1)))))) ;; end defmodule notebook/cell
