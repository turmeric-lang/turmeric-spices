;; test/runner.tur -- TAP output runner.
(defmodule test/runner
  (export run-all run-all-status)
  (import test/suite :refer [__ts])
  ;;; __runner-print -- emit the TAP plan and summary to stdout/stderr.
  (defn __runner-print [n : int p : int f : int] : void
    ```c
    #include <stdio.h>
  printf("1..%lld\n", (long long)n);
  if (f == 0)
    fprintf(stderr, "# All %lld tests passed.\n", (long long)p);
  else
    fprintf(stderr, "# %lld passed, %lld failed.\n",
            (long long)p, (long long)f);
  ```)
  ;;; run-all -- emit the TAP plan line and a summary to stderr.
  ;;;
  ;;; Call this after all describe/it blocks have been evaluated.
  ;;;
  ;;; Example:
  ;;;   (run-all)
  ;;;
  ;;; Since: P1
  (defn run-all [] : void (__runner-print (__ts 4) (__ts 0) (__ts 2)))
  ;;; run-all-status -- like run-all, but returns a process exit status.
  ;;;
  ;;; `tur test` judges a test file by the exit code of the program it builds
  ;;; ("it passes iff both succeed (exit 0)"). The conventional
  ;;; `(defn main [] : int (__all-tests) (run-all) 0)` hardcodes 0, so a
  ;;; failing `it` prints `not ok` and the suite still reports success -- which
  ;;; means a spice's tests only ever catch *compile* failures, never assertion
  ;;; failures. Returning this from main closes that hole.
  ;;;
  ;;; Returns:
  ;;;   0 when every test passed, 1 when any failed.
  ;;;
  ;;; Example:
  ;;;   (defn main [] : int
  ;;;     (__all-tests)
  ;;;     (run-all-status))
  ;;;
  ;;; Since: 0.1.1
  (defn run-all-status [] : int
    (do (__runner-print (__ts 4) (__ts 0) (__ts 2)) (if (> (__ts 2) 0) 1 0)))) ;; end defmodule test/runner
