;; test_causal -- Dot / DotContext, and the G-Set / 2P-Set joins.
;;
;; As with test_counter, the assertions are about CONVERGENCE rather than
;; arithmetic: divergent replicas must merge to the same state in either order,
;; and re-delivering a state must change nothing.
;;
;; main returns the failure count so `tur test` reports a non-zero exit.

(defmodule crdt/tests/test_causal
  (import crdt/replica :refer [ReplicaId replica replica-sym])
  (import crdt/causal :refer [mk-dot dot-replica dot-counter
                              dotctx-new dotctx-witness dotctx-seen?
                              dotctx-next dotctx-count])
  (import crdt/set :refer [gset-new gset-add gset-has? gset-count
                           twopset-new twopset-add twopset-remove
                           twopset-has? twopset-count])

(defn fail-if [cond : bool label : cstr] : int
  (if cond (do (println label) 1) 0))

(defn main [] : int
  (let [d1 (mk-dot (replica (quote alice)) 1)
        d2 (mk-dot (replica (quote alice)) 2)

        ;; A context that has seen alice's first two events and bob's first.
        c0 (dotctx-witness (dotctx-witness (dotctx-new) (mk-dot (replica (quote alice)) 1))
                           (mk-dot (replica (quote alice)) 2))
        c1 (dotctx-witness c0 (mk-dot (replica (quote bob)) 1))

        ;; Witnessing an OLDER dot is a no-op -- the context keeps the highest.
        c2 (dotctx-witness c1 (mk-dot (replica (quote alice)) 1))

        ;; Two divergent contexts, merged both ways.
        ca (dotctx-witness (dotctx-new) (mk-dot (replica (quote alice)) 3))
        cb (dotctx-witness (dotctx-new) (mk-dot (replica (quote bob)) 7))
        ca2 (dotctx-witness (dotctx-new) (mk-dot (replica (quote alice)) 3))
        cb2 (dotctx-witness (dotctx-new) (mk-dot (replica (quote bob)) 7))
        m1 (join ca cb)
        m2 (join cb2 ca2)

        ;; G-Set: two replicas with overlapping adds.
        sa (gset-add (gset-add (gset-new) (quote apple)) (quote pear))
        sb (gset-add (gset-add (gset-new) (quote pear)) (quote plum))
        sa2 (gset-add (gset-add (gset-new) (quote apple)) (quote pear))
        sb2 (gset-add (gset-add (gset-new) (quote pear)) (quote plum))
        sb3 (gset-add (gset-add (gset-new) (quote pear)) (quote plum))
        sb4 (gset-add (gset-add (gset-new) (quote pear)) (quote plum))
        su (join sa sb)
        su2 (join sb2 sa2)
        ;; Counter/set states hold a handle and are AFFINE: `join` consumes its
        ;; arguments, so an assertion that joins and one that reads need their
        ;; own states.  Rebuilding them is the honest shape -- a replica does
        ;; not hand its state away and keep using it.
        sa3 (gset-add (gset-add (gset-new) (quote apple)) (quote pear))
        su3 (join sa3 sb3)

        ;; 2P-Set: add three, remove one.  The removal is permanent.
        t0 (twopset-add (twopset-add (twopset-add (twopset-new) (quote a))
                                     (quote b))
                        (quote c))
        t0b (twopset-add (twopset-add (twopset-add (twopset-new) (quote a))
                                      (quote b))
                         (quote c))
        t0b2 (twopset-add (twopset-add (twopset-add (twopset-new) (quote a))
                                       (quote b))
                          (quote c))
        t1 (twopset-remove t0 (quote b))
        t1b (twopset-remove t0b2 (quote b))
        ;; Re-adding after removal does NOT bring it back -- the tombstone wins.
        t2 (twopset-add t1 (quote b))

        fails
        (+ (fail-if (not (sym=? (replica-sym (dot-replica d1)) (quote alice))) "dot-replica")
           (fail-if (not (= (dot-counter d2) 2)) "dot-counter")
           (fail-if (not (= (dotctx-count c2) 2)) "dotctx replica count")
           (fail-if (not (dotctx-seen? c2 (mk-dot (replica (quote alice)) 2))) "dotctx-seen? present")
           (fail-if (dotctx-seen? c2 (mk-dot (replica (quote alice)) 9)) "dotctx-seen? future dot")
           (fail-if (dotctx-seen? c2 (mk-dot (replica (quote carol)) 1)) "dotctx-seen? unknown replica")
           (fail-if (not (= (dot-counter (dotctx-next c2 (replica (quote alice)))) 3)) "dotctx-next")
           (fail-if (not (= (dot-counter (dotctx-next c2 (replica (quote carol)))) 1))
                    "dotctx-next for an unheard replica")
           ;; contexts converge in either order
           (fail-if (not (= (dotctx-count m1) 2)) "dotctx merge")
           (fail-if (not (= (dotctx-count m2) 2)) "dotctx merge not commutative")
           ;; G-Set union: apple, pear, plum -- pear only once
           (fail-if (not (= (gset-count su) 3)) "gset union count")
           (fail-if (not (= (gset-count su2) 3)) "gset join not commutative")
           (fail-if (not (= (gset-count (join su3 sb4)) 3)) "gset join not idempotent")
           (fail-if (not (gset-has? su (quote apple))) "gset membership")
           (fail-if (gset-has? su (quote quince)) "gset membership of absent element")
           ;; 2P-Set: b removed stays removed, even after a re-add
           (fail-if (not (twopset-has? t0b (quote b))) "2pset before removal")
           (fail-if (twopset-has? t1b (quote b)) "2pset after removal")
           (fail-if (twopset-has? t2 (quote b)) "2pset re-add must not resurrect")
           (fail-if (not (twopset-has? t2 (quote a))) "2pset unrelated element")
           (fail-if (not (= (twopset-count t2) 2)) "2pset count"))]
    (if (= fails 0) (println "test_causal: ok") (println "test_causal: FAILURES"))
    fails))

) ;; end defmodule
