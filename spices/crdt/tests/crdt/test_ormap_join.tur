;; test_ormap_join -- the constrained JoinSemilattice instance on ORMap.
;;
;; crdt-spice-plan 2.3's design: `(ORMap V)` is a JoinSemilattice exactly when
;; `V` is, so an ORMap of any CRDT merges with no code specific to that pairing.
;;
;; The assertion that matters is that the SAME map code gives DIFFERENT answers
;; for two value types whose joins differ.  A map that ignored its element's
;; instance -- which is what every earlier attempt did, silently -- gives one
;; answer for both and passes any test that only checks convergence.
;;
;; main returns the failure count so `tur test` reports a non-zero exit.

(defmodule crdt/tests/test_ormap_join
  (import crdt/replica :refer [ReplicaId replica replica-sym])
  (import crdt/ormap :refer [ORMap ormap-new ormap-put ormap-get ormap-count])

;; A second lattice whose join differs from MaxI's.  stdlib ships
;; `JoinSemilattice` instances for MaxI and Any only -- notably NOT for Sum,
;; whose Semigroup is addition -- so the contrast needs one defined here.
;; Minimum is a genuine semilattice: idempotent, commutative, associative.
(defopaque MinJ :int)
(definstance Eq [MinJ] (eq? [x y] (= (:: x int) (:: y int))))
(definstance JoinSemilattice [MinJ]
  (join [x y] (if (< (:: x int) (:: y int)) x y)))

(defn fail-if [cond : bool label : cstr] : int
  (if cond (do (println label) 1) 0))

;; MaxI's join is max; MinJ's is min.  Same keys, same values, same code.
(defn test-dispatches-per-value-type [] : int
  (let [am (:: (ormap-put (:: (ormap-new) (ORMap MaxI)) (replica (quote alice)) (quote k) (:: 3 MaxI)) (ORMap MaxI))
        bm (:: (ormap-put (:: (ormap-new) (ORMap MaxI)) (replica (quote bob))   (quote k) (:: 9 MaxI)) (ORMap MaxI))
        mx (:: (:: (ormap-get (:: (join am bm) (ORMap MaxI)) (quote k)) MaxI) int)
        as (:: (ormap-put (:: (ormap-new) (ORMap MinJ)) (replica (quote alice)) (quote k) (:: 3 MinJ)) (ORMap MinJ))
        bs (:: (ormap-put (:: (ormap-new) (ORMap MinJ)) (replica (quote bob))   (quote k) (:: 9 MinJ)) (ORMap MinJ))
        sm (:: (:: (ormap-get (:: (join as bs) (ORMap MinJ)) (quote k)) MinJ) int)]
    (+ (fail-if (not (= mx 9))  "FAIL ormap-join: MaxI value merge wrong")
       (+ (fail-if (not (= sm 3)) "FAIL ormap-join: MinJ value merge wrong")
          ;; The two MUST differ, or the map is ignoring its element's instance
          ;; -- the exact collapse three separate compiler defects produced.
          (fail-if (= mx sm)
                   "FAIL ormap-join: both value types gave one answer (instance ignored)")))))

;; Commutativity and idempotence through the instance, not the parameter form.
(defn test-laws [] : int
  (let [a  (:: (ormap-put (:: (ormap-new) (ORMap MinJ)) (replica (quote alice)) (quote k) (:: 3 MinJ)) (ORMap MinJ))
        b  (:: (ormap-put (:: (ormap-new) (ORMap MinJ)) (replica (quote bob))   (quote j) (:: 9 MinJ)) (ORMap MinJ))
        ab (:: (join a b) (ORMap MinJ))
        ba (:: (join b a) (ORMap MinJ))]
    (+ (fail-if (not (= (ormap-count ab) (ormap-count ba)))
                "FAIL ormap-join: not commutative on key set")
       (fail-if (not (= (ormap-count (:: (join ab ab) (ORMap MinJ))) (ormap-count ab)))
                "FAIL ormap-join: not idempotent"))))

(defn main [] : int
  (let [f (+ (test-dispatches-per-value-type) (test-laws))]
    (if (= f 0) (println "ormap-join: ok") (println "ormap-join: FAILURES"))
    f))

) ;; end defmodule
