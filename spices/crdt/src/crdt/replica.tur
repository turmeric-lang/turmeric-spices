;;; crdt/replica -- ReplicaId, the identity of one replica.
;;;
;;; Every CRDT here tags its contributions with the replica that made them:
;;; a counter's slot, a dot, a clock's tie-break, a sequence element's id.
;;; `ReplicaId` is a distinct type over an interned `Sym`, so an element or a
;;; key -- also a `Sym` in `orset-add` and `ormap-put` -- cannot be passed
;;; where a replica is due.
;;;
;;; Since: crdt-spice-plan C1
;; No inline C (crdt-spice-plan 2.5).
(defmodule crdt/replica
  (export ReplicaId replica replica-sym)
  ;;; ReplicaId -- the identity of one replica.
  ;;;
  ;;; A newtype over an interned symbol: `Sym` is the right carrier, since a
  ;;; replica id IS an interned name, but the newtype keeps it apart from the
  ;;; element and key symbols the same calls take.
  ;;;
  ;;; Since: crdt-spice-plan C1
  ;;
  ;; The C1 build could not spell this: a defopaque over `:Sym` stored the
  ;; symbol pointer into an int64 slot, which clang rejects.  That was fixed
  ;; 2026-09-16 (turmeric docs/archive/defopaque-over-sym-skips-the-ptr-bridge.md);
  ;; until 0.3.0 this was a transparent `defalias`.
  (defopaque ReplicaId :Sym)
  ;;; replica -- name a replica.
  ;;;
  ;;; Parameters:
  ;;;   s -- an interned symbol, e.g. (quote alice)
  ;;;
  ;;; Returns:
  ;;;   The ReplicaId for that name.
  ;;;
  ;;; Example:
  ;;;   (replica (quote alice))
  ;;;
  ;;; Since: crdt-spice-plan C1
  ;;
  ;; The ascription is spelled out: returning `s` bare emits C that drops the
  ;; symbol pointer's `const` without a cast, which gcc and clang warn about.
  (defn replica [s : Sym] : ReplicaId (:: s ReplicaId))
  ;;; replica-sym -- the symbol a replica was named with.
  ;;;
  ;;; Parameters:
  ;;;   r -- the replica
  ;;;
  ;;; Returns:
  ;;;   Its interned name, for printing or for keying a map.
  ;;;
  ;;; Example:
  ;;;   (sym->str (replica-sym (replica (quote alice))))   ; => "alice"
  ;;;
  ;;; Since: crdt 0.3.0
  (defn replica-sym [r : ReplicaId] : Sym (:: r Sym))) ;; end defmodule crdt/replica
