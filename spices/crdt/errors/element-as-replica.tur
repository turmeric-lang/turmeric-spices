;; errors/element-as-replica.tur -- a replica is a ReplicaId, not a Sym:
;; passing a bare symbol where orset-add wants the replica is a type error.
;; While ReplicaId was an alias for Sym, the element and the replica of
;; `(orset-add s e r)` could be swapped without a word from the checker.

(defmodule crdt/errors/element-as-replica
  (import crdt/orset :refer [orset-new orset-add orset-has?])

  (defn main [] : int
    (let [s (orset-add (orset-new) (quote apple) (quote alice))]
      (if (orset-has? s (quote apple)) 0 1))))
