;; errors/key-as-replica.tur -- ormap-put takes the replica, then the key:
;; with the two in the wrong order the key lands where a ReplicaId is due,
;; and that is a type error now that a replica is not just a Sym.
(defmodule crdt/errors/key-as-replica
  (import crdt/replica :refer [replica])
  (import crdt/ormap :refer [ormap-new ormap-put ormap-count])
  (defn main [] : int
    (let [m (ormap-put (ormap-new) (quote score) (replica (quote alice)) 5)]
      (ormap-count m))))
