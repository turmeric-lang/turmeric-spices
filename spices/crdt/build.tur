(defpackage tur-crdt
  :name        "tur-crdt"
  :version     "0.3.0"
  :description "Conflict-free replicated data types: counters, sets, registers, maps and a replicated sequence, over a join-semilattice, with delta-state mutators."
  :license     "MIT"
  :spices #map{
    "test" #map{:url    "https://github.com/turmeric-lang/turmeric-spices"
             :ref    "test-v0.1.0"
             :subdir "spices/test"
             :optional true}
  }
  :exports #map{
    ;; `DeltaCRDT` and its methods are NOT listed: a defclass is not an
    ;; exportable name in Turmeric, and neither are its methods.  They are
    ;; ambient once crdt/lattice is in the build, which is what importing it
    ;; for `join-all` achieves.
    "crdt/lattice" ["map-merge-with" "join-all"]
    "crdt/replica" ["ReplicaId" "replica" "replica-sym"]
    "crdt/causal"  ["Dot" "mk-dot" "dot-replica" "dot-counter"
                    "DotContext" "dotctx-new" "dotctx-witness" "dotctx-seen?"
                    "dotctx-next" "dotctx-count" "dotctx-witness-set"
                    "DotSet" "dotset-new" "dotset-add" "dotset-has?"
                    "dotset-count" "dotset-union"]
    "crdt/orset"   ["ORSet" "orset-new" "orset-add" "orset-remove"
                    "orset-has?" "orset-count" "orset-dots" "orset-ctx-size"
                    "OrsetDelta" "orset-delta-new" "orset-delta-add"
                    "orset-delta-remove" "orset-delta-dots"
                    "orset-delta-retracts" "orset-apply"]
    "crdt/set"     ["GSet" "gset-new" "gset-add" "gset-has?" "gset-count"
                    "gset-delta-add"
                    "TwoPSet" "twopset-new" "twopset-add" "twopset-remove"
                    "twopset-has?" "twopset-count" "twopset-size"
                    "twopset-delta-add" "twopset-delta-remove"]
    "crdt/hlc"      ["Hlc" "hlc-zero" "hlc-wall" "hlc-logical" "hlc-replica"
                     "hlc-tick" "hlc-recv" "hlc-after?" "hlc-max-drift" "hlc-later"]
    "crdt/register" ["LwwRegister" "lww-new" "lww-set" "lww-value" "lww-stamp"
                     "lww-delta-set"
                     "MvRegister" "mv-new" "mv-set" "mv-values" "mv-count"
                     "mv-delta-set"]
    "crdt/ormap"    ["ORMap" "ormap-new" "ormap-put" "ormap-get" "ormap-has?"
                     "ormap-remove" "ormap-count" "ormap-merge-with"
                     "ormap-join" "ormap-keys-agree?"
                     "OrmapDelta" "ormap-delta-new" "ormap-delta-put"
                     "ormap-delta-remove" "ormap-delta-count"
                     "ormap-delta-retracts" "ormap-apply"]
    "crdt/rga"      ["Rga" "rga-new" "rga-len" "rga-size" "rga-clock" "rga-get"
                     "rga-alive?" "rga-insert" "rga-append" "rga-delete"
                     "rga-merge" "rga-delta-insert" "rga-delta-delete"]
    "crdt/counter" ["GCounter" "gcounter-new" "gcounter-bump" "gcounter-value"
                    "gcounter-replicas" "gcounter-delta-bump"
                    "PNCounter" "pncounter-new" "pncounter-inc" "pncounter-dec"
                    "pncounter-value" "pncounter-replicas"
                    "pncounter-delta-inc" "pncounter-delta-dec"]
  })
