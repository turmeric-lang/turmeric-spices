;; Negative fixture: a with-write-txn callback BORROWS its Txn -- the scoped
;; form commits or aborts it. A callback whose parameter is not `^borrow`
;; would take ownership, and the form would then end a transaction the
;; callback had already ended.
;;   tur check errors/lmdb-scoped-callback-consumes.tur
;;   => error [TUR-E0001]: ... ^linear and ^borrow parameters must match exactly
;; Compile-fail fixture: asserted by errors/run.sh, not run by `tur test`.

(defmodule lmdb_scoped_callback_consumes_test
  (export)

(import lmdb/error :refer [LmdbError])
(import lmdb/env   :refer [Env])
(import lmdb/txn   :refer [Txn txn-commit with-write-txn])

(defn commits-inside [^borrow env : Env] : bool
  (ok? (with-write-txn env
         (fn [t : Txn] : (Result nil LmdbError)   ;; ERROR: t is not ^borrow
           (txn-commit t)))))

) ;; end defmodule lmdb_scoped_callback_consumes_test
