;; Linear-handle negative fixture: an Env must be closed exactly once.
;; Opening an environment and never closing it is a leak.
;;   tur check errors/lmdb-env-leak.tur
;;   => error [TUR-E0100]: linear value 'env' dropped without being consumed
;; Compile-fail fixture: asserted by errors/run.sh, not run by `tur test`.
(defmodule lmdb_env_leak_test
  (export)
  (import lmdb/env :refer [Env env-opts env-open env-max-key-size])
  (defn leak-env [] : int
    (let [env (ok-val (env-open "leak.mdb" (env-opts)))] (env-max-key-size env))) ;; ERROR TUR-E0100: env never closed
  ) ;; end defmodule lmdb_env_leak_test
