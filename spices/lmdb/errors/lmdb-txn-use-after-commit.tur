;; Linear-handle negative fixture: a committed Txn is gone. Reading through
;; it afterwards would touch freed memory.
;;   tur check errors/lmdb-txn-use-after-commit.tur
;;   => error [TUR-E0101]: linear value 'txn' used after being consumed
;; Compile-fail fixture: asserted by errors/run.sh, not run by `tur test`.
(defmodule lmdb_txn_use_after_commit_test
  (export)
  (import lmdb/env :refer [Env])
  (import lmdb/txn :refer [Txn txn-begin txn-commit])
  (import lmdb/dbi :refer [Dbi])
  (import lmdb/ops :refer [get])
  (defn use-after-commit [^borrow env : Env dbi : Dbi] : bool
    (let [txn (ok-val (txn-begin env false))
          c   (txn-commit txn)]
      (some? (get txn dbi "k")))) ;; ERROR TUR-E0101: txn already committed
  ) ;; end defmodule lmdb_txn_use_after_commit_test
