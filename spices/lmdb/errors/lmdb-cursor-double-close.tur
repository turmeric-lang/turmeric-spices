;; Linear-handle negative fixture: a Cursor is closed exactly once.
;; Closing it twice would free the MDB_cursor twice.
;;   tur check errors/lmdb-cursor-double-close.tur
;;   => error [TUR-E0101]: linear value 'c' used after being consumed
;; Compile-fail fixture: asserted by errors/run.sh, not run by `tur test`.

(defmodule lmdb_cursor_double_close_test
  (export)

(import lmdb/txn    :refer [Txn])
(import lmdb/dbi    :refer [Dbi])
(import lmdb/cursor :refer [Cursor cursor-open cursor-close cursor-first])

(defn double-close [^borrow txn : Txn dbi : Dbi] : bool
  (let [c (ok-val (cursor-open txn dbi))
        f (cursor-first c)]
    (do
      (cursor-close c)
      (cursor-close c)       ;; ERROR TUR-E0101: c already closed
      (some? f))))

) ;; end defmodule lmdb_cursor_double_close_test
