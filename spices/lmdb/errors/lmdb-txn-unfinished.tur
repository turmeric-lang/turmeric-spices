;; Linear-handle negative fixture: a Txn must end exactly once, in
;; txn-commit or txn-abort. Beginning one and only reading through it leaves
;; the transaction open (a write txn would hold the writer lock forever).
;;   tur check errors/lmdb-txn-unfinished.tur
;;   => error [TUR-E0100]: linear value 'txn' dropped without being consumed
;; Compile-fail fixture: asserted by errors/run.sh, not run by `tur test`.
(defmodule lmdb_txn_unfinished_test
  (export)
  (import lmdb/env :refer [Env])
  (import lmdb/txn :refer [Txn txn-begin txn-id])
  (defn unfinished [^borrow env : Env] : int
    (let [txn (ok-val (txn-begin env false))] (txn-id txn))) ;; ERROR TUR-E0100: txn neither committed nor aborted
  ) ;; end defmodule lmdb_txn_unfinished_test
