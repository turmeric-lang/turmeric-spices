;; spices/lmdb/bench -- lmdb vs sqlite on key-value work (lmdb-spice-plan L4).
;;
;; A project of its own, not part of the lmdb spice: it pulls in the sqlite
;; spice (whose `tur fetch` builds SQLite with CMake), which the lmdb spice
;; itself must not depend on. CI never sees it -- discovery reads
;; spices/*/build.tur only. Run it by hand:
;;
;;   cd spices/lmdb/bench && tur fetch && tur run src/bench/kv.tur
(defpackage lmdb-bench
  :name "lmdb-bench"
  :version "0.1.0"
  :license "MIT"
  :spices #map{"lmdb" #map{:path "../../lmdb"}
               "sqlite" #map{:path "../../sqlite"}})
