(defpackage tur-lmdb
  :name "tur-lmdb"
  :version "0.1.0"
  :description "LMDB bindings for Turmeric: an embedded, memory-mapped, transactional key-value store"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  ;; LMDB is two C files with a Makefile and no CMake build, so it is vendored
  ;; under c/lmdb/ (0.9.33 verbatim; c/lmdb/VENDORED.md) rather than fetched.
  ;; :c-sources travel through the :spices closure, so a spice that depends on
  ;; this one links LMDB with no declaration of its own. pthread: LMDB's
  ;; robust mutexes on Linux; harmless on macOS.
  :build-opts #map{:c-includes ["c/lmdb"]
                   :c-sources ["c/lmdb/mdb.c" "c/lmdb/midl.c"]
                   :link-libs ["pthread"]}
  :exports #map{"lmdb/error" ["LmdbError"
                              "MapFull"
                              "KeyTooLong"
                              "ReadersFull"
                              "DbsFull"
                              "TxnFull"
                              "NotADatabase"
                              "Incompatible"
                              "ReadOnly"
                              "Io"
                              "lmdb-error-of"
                              "lmdb-open-error-of"
                              "lmdb-error-message"
                              "lmdb-error-map-full?"]
                "lmdb/env" ["Env"
                            "Sync"
                            "SyncFull"
                            "SyncNoMetaSync"
                            "SyncNone"
                            "EnvOpts"
                            "env-opts"
                            "opts-map-size"
                            "opts-max-dbs"
                            "opts-max-readers"
                            "opts-read-only"
                            "opts-subdir"
                            "opts-sync"
                            "opts-no-create"
                            "EnvInfo"
                            "DbStat"
                            "env-open"
                            "env-close"
                            "env-set-map-size!"
                            "env-map-size"
                            "env-info"
                            "env-stat"
                            "env-sync"
                            "env-copy"
                            "env-reader-check"
                            "env-max-key-size"
                            "env-read-only?"]
                "lmdb/txn" ["Txn"
                            "txn-begin"
                            "txn-begin-nested"
                            "txn-commit"
                            "txn-abort"
                            "txn-read-only?"
                            "txn-id"
                            "with-read-txn"
                            "with-write-txn"
                            "with-write-txn-growing"
                            "with-nested-txn"]
                "lmdb/dbi" ["Dbi"
                            "DbiFlags"
                            "dbi-no-flags"
                            "dbi-create"
                            "dbi-dup-sort"
                            "dbi-dup-fixed"
                            "dbi-integer-key"
                            "dbi-reverse-key"
                            "dbi-flags+"
                            "dbi-open"
                            "dbi-main"
                            "dbi-stat"
                            "dbi-drop"
                            "dbi-delete"
                            "dbi-dup-sort?"]
                "lmdb/ops" ["get"
                            "has?"
                            "put!"
                            "put-new!"
                            "put-append!"
                            "del!"
                            "del-dup!"]
                "lmdb/cursor" ["Cursor"
                               "cursor-open"
                               "cursor-close"
                               "with-cursor"
                               "cursor-first"
                               "cursor-last"
                               "cursor-next"
                               "cursor-prev"
                               "cursor-seek"
                               "cursor-seek-exact"
                               "cursor-current"
                               "cursor-next-dup"
                               "cursor-prev-dup"
                               "cursor-next-nodup"
                               "cursor-prev-nodup"
                               "cursor-first-dup"
                               "cursor-last-dup"
                               "cursor-seek-dup"
                               "cursor-dup-count"
                               "cursor-fold"
                               "cursor-fold-from"
                               "cursor-put!"
                               "cursor-del!"
                               "cursor-del-all-dups!"]
                "lmdb/bytes" ["bytes-of-cstr"
                              "bytes->cstr"
                              "get-bytes"
                              "put-bytes!"
                              "put-new-bytes!"
                              "put-append-bytes!"
                              "del-bytes!"
                              "del-dup-bytes!"
                              "put-reserve!"
                              "cursor-key-bytes"
                              "cursor-val-bytes"
                              "cursor-seek-bytes"
                              "cursor-put-bytes!"]})
