(defpackage tur-lmdb
  :name        "tur-lmdb"
  :version     "0.1.0"
  :description "LMDB bindings for Turmeric: an embedded, memory-mapped, transactional key-value store"
  :license     "MIT"
  :spices #map{
    "test" #map{:path   "../test"
                :url    "https://github.com/turmeric-lang/turmeric-spices"
                :ref    "test-v0.1.0"
                :subdir "spices/test"
                :optional true}
  }
  :build-opts #map{
    :c-includes ["c/lmdb"]
    :c-sources  ["c/lmdb/mdb.c" "c/lmdb/midl.c"]
    :link-libs  ["pthread"]
  }
  :exports #map{})
