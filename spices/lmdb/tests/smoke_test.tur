;; tests/smoke_test.tur -- lmdb L0: open, put, get, close.
;;
;; The smallest program that proves the vendored LMDB compiles and links
;; through the spice build (:c-sources) and that a value round-trips.
(defmodule lmdb/tests/smoke
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  (import test/runner :refer [run-all-status])
  (import lmdb/error :refer [LmdbError])
  (import lmdb/env :refer [env-opts opts-map-size env-open env-close])
  (import lmdb/txn :refer [Txn with-read-txn with-write-txn])
  (import lmdb/dbi :refer [dbi-main])
  (import lmdb/ops :refer [get put!])
  ;;; tmp-path -- a fresh path inside a new temporary directory; the directory
  ;;; is written to *dir.
  (defn tmp-dir [] : cstr
    ```c
    #include <stdio.h>
  #include <stdlib.h>
  #include <string.h>
  #include <unistd.h>
  const char *base = getenv("TMPDIR");
  if (!base || !*base) base = "/tmp";
  size_t n = strlen(base) + 32;
  char *p = (char *)malloc(n);
  snprintf(p, n, "%s/tur-lmdb-XXXXXX", base);
  if (!mkdtemp(p)) { perror("mkdtemp"); exit(1); }
  return p;
  ```)
  ;;; db-path -- dir/smoke.mdb.
  (defn db-path [dir : cstr] : cstr
    ```c
    #include <stdio.h>
  #include <stdlib.h>
  #include <string.h>
  size_t n = strlen((const char *)dir) + 16;
  char *p = (char *)malloc(n);
  snprintf(p, n, "%s/smoke.mdb", (const char *)dir);
  return p;
  ```)
  ;;; cleanup -- remove dir/smoke.mdb, its lock file and dir.
  (defn cleanup [dir : cstr] : bool
    ```c
    #include <stdio.h>
  #include <unistd.h>
  char p[4096];
  snprintf(p, sizeof p, "%s/smoke.mdb", (const char *)dir);
  int ok = unlink(p) == 0;
  snprintf(p, sizeof p, "%s/smoke.mdb-lock", (const char *)dir);
  ok = (unlink(p) == 0) && ok;
  return (rmdir((const char *)dir) == 0) && ok;
  ```)
  ;;; same? -- strcmp equality.
  (defn same? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  ;;; t-round-trip -- open, put in a write txn, get in a read txn, close.
  (defn t-round-trip [] : bool
    (let [dir (tmp-dir)
          r   (env-open (db-path dir) (opts-map-size (env-opts) 1048576))]
      (if (err? r)
        false
        (let [env (ok-val r)
              w   (with-write-txn env
                    (fn [^borrow t : Txn] : (Result nil LmdbError)
                      (put! t (? (dbi-main t)) "hello" "world")))
              g   (with-read-txn env
                    (fn [^borrow t : Txn] : (Result (Option cstr) LmdbError)
                      (ok (get t (? (dbi-main t)) "hello"))))]
          (do
            (env-close env)
            (and (ok? w)
              (ok? g)
              (some? (ok-val g))
              (same? (unwrap (ok-val g)) "world")
              (cleanup dir)))))))
  (defn __all-tests [] : void
    (describe "smoke" (it "open, put, get, close" (t-round-trip))))
  (defn main [] : int (__all-tests) (run-all-status))) ;; end defmodule lmdb/tests/smoke
