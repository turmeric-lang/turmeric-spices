;;; lmdb/dbi -- Dbi: open, inspect, empty and delete databases in an env.
;;;
;;; An environment holds one unnamed main database and, when `EnvOpts`
;;; allows (`opts-max-dbs`), named ones. A `Dbi` is the handle `dbi-open`
;;; returns. It is a plain value: LMDB keeps it valid for the env's life,
;;; so it needs no release and can be reused by every later transaction.
;;; Open each database once, in one transaction that commits, and keep the
;;; Dbi.
;;;
;;; Flags are a typed `DbiFlags` set, built from named single flags:
;;;
;;;   (dbi-open txn (some "by-tag") (dbi-flags+ (dbi-create) (dbi-dup-sort)))
;;;
;;; `dbi-dup-sort` lets one key hold several values, kept sorted -- indexes
;;; and one-to-many maps without encoding a list into a value. A database's
;;; flags are fixed when it is created: LMDB 0.9.33 reopens it with the
;;; flags stored in the file whatever you pass (`dbi-dup-sort?` reports
;;; them). `Incompatible` is a name that is an ordinary key of the main
;;; database, not a database.
;;;
;;; Since: 0.1.0
;; lmdb/dbi
(defmodule lmdb/dbi
  (import lmdb/error :refer [LmdbError lmdb-error-of])
  (import lmdb/env :refer [DbStat])
  (import lmdb/txn :refer [Txn])
  (export Dbi
    DbiFlags
    dbi-no-flags
    dbi-create
    dbi-dup-sort
    dbi-dup-fixed
    dbi-integer-key
    dbi-reverse-key
    dbi-flags+
    dbi-open
    dbi-main
    dbi-stat
    dbi-drop
    dbi-delete
    dbi-dup-sort?)
  ;;; Dbi -- a database within an environment (an `MDB_dbi`).
  ;;;
  ;;; Since: 0.1.0
  (defopaque Dbi :int)
  ;;; DbiFlags -- how a database is created and sorted: a set of MDB_* flags.
  ;;;
  ;;; Build one from the single-flag sets below and `dbi-flags+`:
  ;;;
  ;;;   (dbi-flags+ (dbi-create) (dbi-dup-sort))
  ;;;
  ;;; It is a plain value (the bit mask, typed so nothing else passes for it),
  ;;; so building one allocates nothing.
  ;;;
  ;;; Since: 0.1.0
  (defopaque DbiFlags :int)
  ;;; mdb-flag -- MDB_CREATE, MDB_DUPSORT, MDB_DUPFIXED, MDB_INTEGERKEY,
  ;;; MDB_REVERSEKEY by index (0 for none), read from lmdb.h.
  (defn mdb-flag [i : int] : DbiFlags
    ```c
    #include <lmdb.h>
  switch (i) {
    case 0: return MDB_CREATE;
    case 1: return MDB_DUPSORT;
    case 2: return MDB_DUPFIXED;
    case 3: return MDB_INTEGERKEY;
    case 4: return MDB_REVERSEKEY;
    default: return 0;
  }
  ```)
  ;;; dbi-no-flags -- the empty set: open an existing database as it is.
  ;;;
  ;;; Returns:
  ;;;   A DbiFlags with nothing set.
  ;;;
  ;;; Example:
  ;;;   (dbi-open txn (some "users") (dbi-no-flags))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-no-flags [] : DbiFlags (mdb-flag -1))
  ;;; dbi-create -- MDB_CREATE: create a named database when absent.
  ;;;
  ;;; Returns:
  ;;;   A DbiFlags.
  ;;;
  ;;; Example:
  ;;;   (dbi-open txn (some "users") (dbi-create))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-create [] : DbiFlags (mdb-flag 0))
  ;;; dbi-dup-sort -- MDB_DUPSORT: a key may hold several values, kept sorted.
  ;;;
  ;;; Returns:
  ;;;   A DbiFlags.
  ;;;
  ;;; Example:
  ;;;   (dbi-flags+ (dbi-create) (dbi-dup-sort))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-dup-sort [] : DbiFlags (mdb-flag 1))
  ;;; dbi-dup-fixed -- MDB_DUPFIXED: with dbi-dup-sort, every value is one size.
  ;;;
  ;;; Returns:
  ;;;   A DbiFlags.
  ;;;
  ;;; Example:
  ;;;   (dbi-flags+ (dbi-dup-sort) (dbi-dup-fixed))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-dup-fixed [] : DbiFlags (mdb-flag 2))
  ;;; dbi-integer-key -- MDB_INTEGERKEY: keys are native-endian unsigned ints
  ;;; (4 or 8 bytes; use lmdb/bytes), compared numerically.
  ;;;
  ;;; Returns:
  ;;;   A DbiFlags.
  ;;;
  ;;; Example:
  ;;;   (dbi-flags+ (dbi-create) (dbi-integer-key))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-integer-key [] : DbiFlags (mdb-flag 3))
  ;;; dbi-reverse-key -- MDB_REVERSEKEY: compare keys from their last byte.
  ;;;
  ;;; Returns:
  ;;;   A DbiFlags.
  ;;;
  ;;; Example:
  ;;;   (dbi-flags+ (dbi-create) (dbi-reverse-key))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-reverse-key [] : DbiFlags (mdb-flag 4))
  ;;; dbi-flags+ -- the union of two flag sets.
  ;;;
  ;;; Parameters:
  ;;;   a -- a DbiFlags
  ;;;   b -- a DbiFlags
  ;;;
  ;;; Returns:
  ;;;   Every flag in either.
  ;;;
  ;;; Example:
  ;;;   (dbi-flags+ (dbi-create) (dbi-dup-sort))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-flags+ [a : DbiFlags b : DbiFlags] : DbiFlags
    ```c
    return a | b;
  ```)
  ;;; dbi-open-raw -- mdb_dbi_open; ok: the dbi, err: the code.
  (defn dbi-open-raw [^borrow txn : Txn
                      name : cstr
                      named : bool
                      flags : DbiFlags] : (Result int int)
    ```c
    #include <lmdb.h>
  MDB_dbi dbi = 0;
  int rc = mdb_dbi_open((MDB_txn *)(intptr_t)txn,
                        named ? (const char *)name : NULL,
                        (unsigned int)flags, &dbi);
  if (rc) return tur_err_int(rc);
  return tur_ok_int((int64_t)dbi);
  ```)
  ;;; dbi-of-int -- view an MDB_dbi as a Dbi.
  (defn dbi-of-int [n : int] : Dbi
    ```c
    return n;
  ```)
  ;;; dbi-stat-field -- one field of mdb_stat (DbStat's order), -1 on error.
  (defn dbi-stat-field [^borrow txn : Txn dbi : Dbi which : int] : int
    ```c
    #include <lmdb.h>
  MDB_stat s;
  if (mdb_stat((MDB_txn *)(intptr_t)txn, (MDB_dbi)dbi, &s)) return -1;
  switch (which) {
    case 0: return (int64_t)s.ms_psize;
    case 1: return (int64_t)s.ms_depth;
    case 2: return (int64_t)s.ms_branch_pages;
    case 3: return (int64_t)s.ms_leaf_pages;
    case 4: return (int64_t)s.ms_overflow_pages;
    default: return (int64_t)s.ms_entries;
  }
  ```)
  ;;; dbi-drop-raw -- mdb_drop; del 0 empties, 1 deletes. The code.
  (defn dbi-drop-raw [^borrow txn : Txn dbi : Dbi del : int] : int
    ```c
    #include <lmdb.h>
  return (int64_t)mdb_drop((MDB_txn *)(intptr_t)txn, (MDB_dbi)dbi, (int)del);
  ```)
  ;;; dbi-open -- open (or with dbi-create, create) a database.
  ;;;
  ;;; A Dbi opened in a transaction that aborts is invalid afterwards; open
  ;;; databases in a transaction that commits (a read transaction will do for
  ;;; one that already exists).
  ;;;
  ;;; Parameters:
  ;;;   txn   -- a Txn, borrowed (a write txn when dbi-create may create)
  ;;;   name  -- (some "name") for a named database, (none) for the main one
  ;;;   flags -- a DbiFlags, e.g. (dbi-create) or (dbi-no-flags)
  ;;;
  ;;; Returns:
  ;;;   (Result Dbi LmdbError) -- `Io` with MDB_NOTFOUND when the named
  ;;;   database is absent and dbi-create was not given; `DbsFull` past
  ;;;   `opts-max-dbs`; `Incompatible` when the sort flags differ from the
  ;;;   file's.
  ;;;
  ;;; Example:
  ;;;   (dbi-open txn (some "users") (dbi-create))
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-open [^borrow txn : Txn name : (Option cstr) flags : DbiFlags] : (Result Dbi
                                                                               LmdbError)
    (let [named (some? name)
          nm    (if named (unwrap name) "")
          r     (dbi-open-raw txn nm named flags)]
      (if (ok? r)
        (ok (dbi-of-int (ok-val r)))
        (err (lmdb-error-of (err-val r))))))
  ;;; dbi-main -- open the main (unnamed) database with no flags.
  ;;;
  ;;; Parameters:
  ;;;   txn -- a Txn, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result Dbi LmdbError)
  ;;;
  ;;; Example:
  ;;;   (dbi-main txn)
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-main [^borrow txn : Txn] : (Result Dbi LmdbError)
    (dbi-open txn (none) (dbi-no-flags)))
  ;;; dbi-stat -- statistics for one database.
  ;;;
  ;;; Parameters:
  ;;;   txn -- a Txn, borrowed
  ;;;   dbi -- the database
  ;;;
  ;;; Returns:
  ;;;   (Result DbStat LmdbError) -- `entries` is the key/value count.
  ;;;
  ;;; Example:
  ;;;   (.entries (ok-val (dbi-stat txn dbi)))  ; => 3
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-stat [^borrow txn : Txn dbi : Dbi] : (Result DbStat LmdbError)
    (let [ps (dbi-stat-field txn dbi 0)]
      (if (< ps 0)
        (err (lmdb-error-of 22))
        (ok (DbStat ps
              (dbi-stat-field txn dbi 1)
              (dbi-stat-field txn dbi 2)
              (dbi-stat-field txn dbi 3)
              (dbi-stat-field txn dbi 4)
              (dbi-stat-field txn dbi 5))))))
  ;;; dbi-drop -- delete every entry of a database, keeping the database.
  ;;;
  ;;; Parameters:
  ;;;   txn -- a write Txn, borrowed
  ;;;   dbi -- the database
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (dbi-drop txn dbi)
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-drop [^borrow txn : Txn dbi : Dbi] : (Result nil LmdbError)
    (let [rc (dbi-drop-raw txn dbi 0)]
      (if (= rc 0) (Ok nil) (err (lmdb-error-of rc)))))
  ;;; dbi-delete -- remove a named database from the environment.
  ;;;
  ;;; The Dbi is invalid once the transaction commits.
  ;;;
  ;;; Parameters:
  ;;;   txn -- a write Txn, borrowed
  ;;;   dbi -- the database
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (dbi-delete txn dbi)
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-delete [^borrow txn : Txn dbi : Dbi] : (Result nil LmdbError)
    (let [rc (dbi-drop-raw txn dbi 1)]
      (if (= rc 0) (Ok nil) (err (lmdb-error-of rc)))))
  ;;; dbi-dup-sort? -- was the database created with dbi-dup-sort?
  ;;;
  ;;; Parameters:
  ;;;   txn -- a Txn, borrowed
  ;;;   dbi -- the database
  ;;;
  ;;; Returns:
  ;;;   true for a duplicate-sorted database.
  ;;;
  ;;; Example:
  ;;;   (dbi-dup-sort? txn dbi)  ; => false
  ;;;
  ;;; Since: 0.1.0
  (defn dbi-dup-sort? [^borrow txn : Txn dbi : Dbi] : bool
    ```c
    #include <lmdb.h>
  unsigned int f = 0;
  if (mdb_dbi_flags((MDB_txn *)(intptr_t)txn, (MDB_dbi)dbi, &f)) return false;
  return (f & MDB_DUPSORT) != 0;
  ```)) ;; end defmodule lmdb/dbi
