;;; lmdb/bytes -- byte-valued twins of the cstr operations, over stdlib Bytes.
;;;
;;; lmdb/ops stores `cstr` keys and values, which cannot hold a NUL byte.
;;; These take and return stdlib `Bytes` (stdlib/serial.tur: a linear,
;;; length-prefixed buffer) instead, for binary keys and values -- encoded
;;; numbers, hashes, serialized records.
;;;
;;; A cstr is stored without its NUL, so the cstr key "abc" and a Bytes key
;;; holding those three bytes are the same key: the two APIs mix freely on
;;; one database.
;;;
;;; Inputs are borrowed (the caller still frees them); every Bytes handed
;;; back is a fresh copy the caller must `bytes-free`.
;;;
;;; `put-reserve!` (MDB_RESERVE) lets a writer fill a value in place in the
;;; map instead of building it first. The pointer it hands the filler is
;;; valid only inside that call: keep it and the next write may move or
;;; reuse the page under it.
;;;
;;; Since: 0.1.0
(load "stdlib/serial.tur")
;; lmdb/bytes

(defmodule lmdb/bytes
  (import lmdb/error :refer [LmdbError KeyTooLong lmdb-error-of])
  (import lmdb/txn :refer [Txn])
  (import lmdb/dbi :refer [Dbi])
  (import lmdb/cursor :refer [Cursor])
  (export bytes-of-cstr
    bytes->cstr
    get-bytes
    put-bytes!
    put-new-bytes!
    put-append-bytes!
    del-bytes!
    del-dup-bytes!
    put-reserve!
    cursor-key-bytes
    cursor-val-bytes
    cursor-seek-bytes
    cursor-put-bytes!)
  ;; -------------------------------------------------------------------------
  ;; Conversions
  ;; -------------------------------------------------------------------------
  ;;; bytes-of-cstr -- the bytes of s, without its NUL, as a fresh Bytes.
  ;;;
  ;;; Parameters:
  ;;;   s -- a cstr
  ;;;
  ;;; Returns:
  ;;;   A Bytes of strlen(s) bytes; free with bytes-free.
  ;;;
  ;;; Example:
  ;;;   (bytes-len (bytes-of-cstr "abc"))  ; => 3
  ;;;
  ;;; Since: 0.1.0
  (defn bytes-of-cstr [s : cstr] : Bytes
    ```c
    #include <stdlib.h>
  #include <string.h>
  size_t n = strlen((const char *)s);
  int64_t *b = (int64_t *)malloc(sizeof(int64_t) + n);
  b[0] = (int64_t)n;
  memcpy(b + 1, s, n);
  return (void *)b;
  ```)
  ;;; bytes->cstr -- a NUL-terminated copy of b (truncated at any NUL in it).
  ;;;
  ;;; Parameters:
  ;;;   b -- a Bytes, borrowed
  ;;;
  ;;; Returns:
  ;;;   A fresh cstr.
  ;;;
  ;;; Example:
  ;;;   (bytes->cstr k)  ; => "abc"
  ;;;
  ;;; Since: 0.1.0
  (defn bytes->cstr [^borrow b : Bytes] : cstr
    ```c
    #include <stdlib.h>
  #include <string.h>
  int64_t n = b ? ((int64_t *)b)[0] : 0;
  char *s = (char *)malloc((size_t)n + 1);
  if (n) memcpy(s, (int64_t *)b + 1, (size_t)n);
  s[n] = '\0';
  return s;
  ```)
  ;; -------------------------------------------------------------------------
  ;; Private
  ;; -------------------------------------------------------------------------
  ;;; over-key-limit -- the key's length when it exceeds the env's limit, else -1.
  (defn over-key-limit [^borrow txn : Txn ^borrow key : Bytes] : int
    ```c
    #include <lmdb.h>
  int64_t n = ((int64_t *)key)[0];
  int max = mdb_env_get_maxkeysize(mdb_txn_env((MDB_txn *)(intptr_t)txn));
  return n > max ? n : -1;
  ```)
  ;;; put-raw -- mdb_put of two Bytes with put flag index fi (as lmdb/ops).
  (defn put-raw [^borrow txn : Txn
                 dbi : Dbi
                 ^borrow key : Bytes
                 ^borrow val : Bytes
                 fi : int] : int
    ```c
    #include <lmdb.h>
  static const unsigned flags[] = { 0, MDB_NOOVERWRITE, MDB_APPEND };
  MDB_val k = { (size_t)((int64_t *)key)[0], (int64_t *)key + 1 };
  MDB_val v = { (size_t)((int64_t *)val)[0], (int64_t *)val + 1 };
  return (int64_t)mdb_put((MDB_txn *)(intptr_t)txn, (MDB_dbi)dbi, &k, &v, flags[fi]);
  ```)
  ;;; del-raw -- mdb_del of a Bytes key, and with-val its value.
  (defn del-raw [^borrow txn : Txn
                 dbi : Dbi
                 ^borrow key : Bytes
                 ^borrow val : Bytes
                 with-val : bool] : int
    ```c
    #include <lmdb.h>
  MDB_val k = { (size_t)((int64_t *)key)[0], (int64_t *)key + 1 };
  MDB_val v = { (size_t)((int64_t *)val)[0], (int64_t *)val + 1 };
  return (int64_t)mdb_del((MDB_txn *)(intptr_t)txn, (MDB_dbi)dbi, &k, with_val ? &v : NULL);
  ```)
  ;;; code-class -- 0 success, 1 MDB_KEYEXIST, 2 MDB_NOTFOUND, 3 other.
  (defn code-class [rc : int] : int
    ```c
    #include <lmdb.h>
  if (rc == 0) return 0;
  if (rc == MDB_KEYEXIST) return 1;
  if (rc == MDB_NOTFOUND) return 2;
  return 3;
  ```)
  ;;; put-with -- put with flag index fi; Ok true written, Ok false key existed.
  (defn put-with [^borrow txn : Txn
                  dbi : Dbi
                  ^borrow key : Bytes
                  ^borrow val : Bytes
                  fi : int] : (Result bool LmdbError)
    (let [over (over-key-limit txn key)]
      (if (>= over 0)
        (err (KeyTooLong over))
        (let [rc (put-raw txn dbi key val fi)
              cl (code-class rc)]
          (cond (= cl 0) (ok true)
                (= cl 1) (ok false)
                :else    (err (lmdb-error-of rc)))))))
  ;;; del-with -- delete; Ok false when absent.
  (defn del-with [^borrow txn : Txn
                  dbi : Dbi
                  ^borrow key : Bytes
                  ^borrow val : Bytes
                  with-val : bool] : (Result bool LmdbError)
    (let [rc (del-raw txn dbi key val with-val)
          cl (code-class rc)]
      (cond (= cl 0) (ok true)
            (= cl 2) (ok false)
            :else    (err (lmdb-error-of rc)))))
  ;;; reserve-raw -- mdb_put with MDB_RESERVE; ok: the pointer to fill, err: code.
  (defn reserve-raw [^borrow txn : Txn dbi : Dbi ^borrow key : Bytes n : int] : (Result ptr<void>
                                                                                  int)
    ```c
    #include <lmdb.h>
  MDB_val k = { (size_t)((int64_t *)key)[0], (int64_t *)key + 1 };
  MDB_val v = { (size_t)n, NULL };
  int rc = mdb_put((MDB_txn *)(intptr_t)txn, (MDB_dbi)dbi, &k, &v, MDB_RESERVE);
  if (rc) return tur_err_int(rc);
  return tur_ok_ptr(v.mv_data);
  ```)
  ;;; cursor-part -- the current entry's key (0) or value (1) as fresh Bytes.
  (defn cursor-part [^borrow c : Cursor which : int] : (Option Bytes)
    ```c
    #include <lmdb.h>
  #include <stdlib.h>
  #include <string.h>
  MDB_val k, v;
  if (mdb_cursor_get((MDB_cursor *)(intptr_t)c, &k, &v, MDB_GET_CURRENT)) return tur_none();
  MDB_val *src = which ? &v : &k;
  int64_t *b = (int64_t *)malloc(sizeof(int64_t) + src->mv_size);
  b[0] = (int64_t)src->mv_size;
  memcpy(b + 1, src->mv_data, src->mv_size);
  return tur_some_ptr(b);
  ```)
  ;;; cursor-seek-raw -- MDB_SET_RANGE to a Bytes key; true when positioned.
  (defn cursor-seek-raw [^borrow c : Cursor ^borrow key : Bytes] : bool
    ```c
    #include <lmdb.h>
  MDB_val k = { (size_t)((int64_t *)key)[0], (int64_t *)key + 1 }, v;
  if (k.mv_size == 0)
    return mdb_cursor_get((MDB_cursor *)(intptr_t)c, &k, &v, MDB_FIRST) == 0;
  return mdb_cursor_get((MDB_cursor *)(intptr_t)c, &k, &v, MDB_SET_RANGE) == 0;
  ```)
  ;;; cursor-over-key-limit -- as over-key-limit, for a cursor's transaction.
  (defn cursor-over-key-limit [^borrow c : Cursor ^borrow key : Bytes] : int
    ```c
    #include <lmdb.h>
  int64_t n = ((int64_t *)key)[0];
  MDB_txn *t = mdb_cursor_txn((MDB_cursor *)(intptr_t)c);
  int max = mdb_env_get_maxkeysize(mdb_txn_env(t));
  return n > max ? n : -1;
  ```)
  ;;; cursor-put-raw -- mdb_cursor_put of two Bytes; the code.
  (defn cursor-put-raw [^borrow c : Cursor
                        ^borrow key : Bytes
                        ^borrow val : Bytes] : int
    ```c
    #include <lmdb.h>
  MDB_val k = { (size_t)((int64_t *)key)[0], (int64_t *)key + 1 };
  MDB_val v = { (size_t)((int64_t *)val)[0], (int64_t *)val + 1 };
  return (int64_t)mdb_cursor_put((MDB_cursor *)(intptr_t)c, &k, &v, 0);
  ```)
  ;; -------------------------------------------------------------------------
  ;; Public
  ;; -------------------------------------------------------------------------
  ;;; get-bytes -- the value stored under key, as fresh Bytes.
  ;;;
  ;;; Parameters:
  ;;;   txn -- a Txn, borrowed
  ;;;   dbi -- the database
  ;;;   key -- the key, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Option Bytes) -- (some value) to bytes-free, or (none).
  ;;;
  ;;; Example:
  ;;;   (get-bytes txn dbi k)
  ;;;
  ;;; Since: 0.1.0
  (defn get-bytes [^borrow txn : Txn dbi : Dbi ^borrow key : Bytes] : (Option Bytes)
    ```c
    #include <lmdb.h>
  #include <stdlib.h>
  #include <string.h>
  MDB_txn *t = (MDB_txn *)(intptr_t)txn;
  MDB_val k = { (size_t)((int64_t *)key)[0], (int64_t *)key + 1 }, v;
  if (k.mv_size == 0 || k.mv_size > (size_t)mdb_env_get_maxkeysize(mdb_txn_env(t)))
    return tur_none();
  if (mdb_get(t, (MDB_dbi)dbi, &k, &v)) return tur_none();
  int64_t *b = (int64_t *)malloc(sizeof(int64_t) + v.mv_size);
  b[0] = (int64_t)v.mv_size;
  memcpy(b + 1, v.mv_data, v.mv_size);
  return tur_some_ptr(b);
  ```)
  ;;; put-bytes! -- store val under key (as put!).
  ;;;
  ;;; Parameters:
  ;;;   txn -- a write Txn, borrowed
  ;;;   dbi -- the database
  ;;;   key -- the key, borrowed
  ;;;   val -- the value, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (put-bytes! txn dbi k v)
  ;;;
  ;;; Since: 0.1.0
  (defn put-bytes! [^borrow txn : Txn
                    dbi : Dbi
                    ^borrow key : Bytes
                    ^borrow val : Bytes] : (Result nil LmdbError)
    (let [r (put-with txn dbi key val 0)]
      (if (ok? r) (Ok nil) (err (err-val r)))))
  ;;; put-new-bytes! -- store val only if key is absent (as put-new!).
  ;;;
  ;;; Parameters:
  ;;;   txn -- a write Txn, borrowed
  ;;;   dbi -- the database
  ;;;   key -- the key, borrowed
  ;;;   val -- the value, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result bool LmdbError) -- ok false when the key was already present.
  ;;;
  ;;; Example:
  ;;;   (put-new-bytes! txn dbi k v)
  ;;;
  ;;; Since: 0.1.0
  (defn put-new-bytes! [^borrow txn : Txn
                        dbi : Dbi
                        ^borrow key : Bytes
                        ^borrow val : Bytes] : (Result bool LmdbError)
    (put-with txn dbi key val 1))
  ;;; put-append-bytes! -- bulk-load put (MDB_APPEND), as put-append!.
  ;;;
  ;;; Parameters:
  ;;;   txn -- a write Txn, borrowed
  ;;;   dbi -- the database
  ;;;   key -- the key, greater than every key present, borrowed
  ;;;   val -- the value, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError) -- an out-of-order key is refused, not stored.
  ;;;
  ;;; Example:
  ;;;   (put-append-bytes! txn dbi k v)
  ;;;
  ;;; Since: 0.1.0
  (defn put-append-bytes! [^borrow txn : Txn
                           dbi : Dbi
                           ^borrow key : Bytes
                           ^borrow val : Bytes] : (Result nil LmdbError)
    (let [r (put-with txn dbi key val 2)]
      (if (ok? r)
        (if (ok-val r) (Ok nil) (err (lmdb-error-of -30799)))
        (err (err-val r)))))
  ;;; del-bytes! -- delete key (as del!).
  ;;;
  ;;; Parameters:
  ;;;   txn -- a write Txn, borrowed
  ;;;   dbi -- the database
  ;;;   key -- the key, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result bool LmdbError) -- ok false when absent.
  ;;;
  ;;; Example:
  ;;;   (del-bytes! txn dbi k)
  ;;;
  ;;; Since: 0.1.0
  (defn del-bytes! [^borrow txn : Txn dbi : Dbi ^borrow key : Bytes] : (Result bool
                                                                         LmdbError)
    (del-with txn dbi key key false))
  ;;; del-dup-bytes! -- delete one value of a dup-sort key (as del-dup!).
  ;;;
  ;;; Parameters:
  ;;;   txn -- a write Txn, borrowed
  ;;;   dbi -- a dup-sort database
  ;;;   key -- the key, borrowed
  ;;;   val -- the value to remove, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result bool LmdbError) -- ok false when the key does not hold val.
  ;;;
  ;;; Example:
  ;;;   (del-dup-bytes! txn dbi k v)
  ;;;
  ;;; Since: 0.1.0
  (defn del-dup-bytes! [^borrow txn : Txn
                        dbi : Dbi
                        ^borrow key : Bytes
                        ^borrow val : Bytes] : (Result bool LmdbError)
    (del-with txn dbi key val true))
  ;;; put-reserve! -- make room for an n-byte value under key and let fill
  ;;; write it in place (MDB_RESERVE).
  ;;;
  ;;; fill gets the pointer and n, and must write exactly n bytes there before
  ;;; returning; the pointer is dead afterwards. Not for dup-sort databases
  ;;; (LMDB refuses MDB_RESERVE there).
  ;;;
  ;;; Parameters:
  ;;;   txn  -- a write Txn, borrowed
  ;;;   dbi  -- the database
  ;;;   key  -- the key, borrowed
  ;;;   n    -- the value's length
  ;;;   fill -- (fn [ptr<void> int] nil)
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (put-reserve! txn dbi k 8 (fn [p : ptr<void> n : int] : nil (write-u64 p 42)))
  ;;;
  ;;; Since: 0.1.0
  (defn put-reserve! [^borrow txn : Txn
                      dbi : Dbi
                      ^borrow key : Bytes
                      n : int
                      fill : (fn [ptr<void> int] nil)] : (Result nil LmdbError)
    (let [over (over-key-limit txn key)]
      (if (>= over 0)
        (err (KeyTooLong over))
        (let [r (reserve-raw txn dbi key n)]
          (if (err? r)
            (err (lmdb-error-of (err-val r)))
            (do (fill (ok-val r) n) (Ok nil)))))))
  ;;; cursor-key-bytes -- the key of the cursor's current entry, as Bytes.
  ;;;
  ;;; Parameters:
  ;;;   c -- a positioned Cursor, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Option Bytes) -- (none) when unpositioned.
  ;;;
  ;;; Example:
  ;;;   (cursor-key-bytes c)
  ;;;
  ;;; Since: 0.1.0
  (defn cursor-key-bytes [^borrow c : Cursor] : (Option Bytes)
    (cursor-part c 0))
  ;;; cursor-val-bytes -- the value of the cursor's current entry, as Bytes.
  ;;;
  ;;; Parameters:
  ;;;   c -- a positioned Cursor, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Option Bytes) -- (none) when unpositioned.
  ;;;
  ;;; Example:
  ;;;   (cursor-val-bytes c)
  ;;;
  ;;; Since: 0.1.0
  (defn cursor-val-bytes [^borrow c : Cursor] : (Option Bytes)
    (cursor-part c 1))
  ;;; cursor-seek-bytes -- position at the first key >= key (MDB_SET_RANGE).
  ;;;
  ;;; Read the entry with cursor-key-bytes / cursor-val-bytes, or the cstr
  ;;; moves of lmdb/cursor.
  ;;;
  ;;; Parameters:
  ;;;   c   -- the Cursor, borrowed
  ;;;   key -- the lower bound, borrowed (empty: the first entry)
  ;;;
  ;;; Returns:
  ;;;   true when the cursor landed on an entry.
  ;;;
  ;;; Example:
  ;;;   (cursor-seek-bytes c prefix)
  ;;;
  ;;; Since: 0.1.0
  (defn cursor-seek-bytes [^borrow c : Cursor ^borrow key : Bytes] : bool
    (cursor-seek-raw c key))
  ;;; cursor-put-bytes! -- store val under key through the cursor (as cursor-put!).
  ;;;
  ;;; Parameters:
  ;;;   c   -- a Cursor in a write Txn, borrowed
  ;;;   key -- the key, borrowed
  ;;;   val -- the value, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (cursor-put-bytes! c k v)
  ;;;
  ;;; Since: 0.1.0
  (defn cursor-put-bytes! [^borrow c : Cursor
                           ^borrow key : Bytes
                           ^borrow val : Bytes] : (Result nil LmdbError)
    (let [over (cursor-over-key-limit c key)]
      (if (>= over 0)
        (err (KeyTooLong over))
        (let [rc (cursor-put-raw c key val)]
          (if (= rc 0) (Ok nil) (err (lmdb-error-of rc)))))))) ;; end defmodule lmdb/bytes
