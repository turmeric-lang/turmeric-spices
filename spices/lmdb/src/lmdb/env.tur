;;; lmdb/env -- Env: open, close, size, sync, stat and copy an LMDB environment.
;;;
;;; An environment is one LMDB database file (or directory) and everything in
;;; it: the memory map, the reader table, the named databases. `env-open`
;;; returns a linear `Env` that `env-close` consumes; every other operation
;;; borrows it.
;;;
;;; Decisions this module makes (lmdb-spice-plan section 5):
;;;
;;;   - One file by default (`MDB_NOSUBDIR`): `path` is the data file and
;;;     `path-lock` sits beside it. `opts-subdir` gives LMDB's directory layout.
;;;   - Every env is opened `MDB_NOTLS`, so a read transaction is not tied to
;;;     the OS thread that began it. `MDB_WRITEMAP` is never used.
;;;   - The map size is fixed up front and never grown behind the caller's
;;;     back. A write past it is `MapFull`; `env-set-map-size!` (or
;;;     `with-write-txn-growing` in lmdb/txn) grows it.
;;;
;;; Since: 0.1.0
;; lmdb/env
(defmodule lmdb/env
  (import lmdb/error :refer [LmdbError lmdb-error-of lmdb-open-error-of])
  (export Env
    Sync
    SyncFull
    SyncNoMetaSync
    SyncNone
    EnvOpts
    env-opts
    opts-map-size
    opts-max-dbs
    opts-max-readers
    opts-read-only
    opts-subdir
    opts-sync
    opts-no-create
    EnvInfo
    DbStat
    env-open
    env-close
    env-set-map-size!
    env-map-size
    env-info
    env-stat
    env-sync
    env-copy
    env-reader-check
    env-max-key-size
    env-read-only?)
  ;; -------------------------------------------------------------------------
  ;; Types
  ;; -------------------------------------------------------------------------
  ;;; Env -- an open LMDB environment (an `MDB_env *`).
  ;;;
  ;;; `:linear`: the env from `env-open` must be closed exactly once with
  ;;; `env-close`. Everything else takes it by `^borrow`. Close every
  ;;; transaction and cursor first.
  ;;;
  ;;; Since: 0.1.0
  (defopaque ^linear Env :int)
  ;;; Sync -- how hard a commit flushes.
  ;;;
  ;;; Constructors:
  ;;;   SyncFull       -- fsync data and meta page on every commit (LMDB's default)
  ;;;   SyncNoMetaSync -- MDB_NOMETASYNC: skip the meta-page flush; a crash can
  ;;;                     lose the last commit but not corrupt the file
  ;;;   SyncNone       -- MDB_NOSYNC: leave flushing to the OS (caches, tests);
  ;;;                     `env-sync` forces one
  ;;;
  ;;; Example:
  ;;;   (opts-sync (env-opts) (SyncNone))
  ;;;
  ;;; Since: 0.1.0
  (defdata ^copy Sync (SyncFull) (SyncNoMetaSync) (SyncNone))
  ;;; EnvOpts -- how to open an environment. Start from `(env-opts)`.
  ;;;
  ;;; Fields:
  ;;;   map-size    -- the map's size in bytes: the most the file can hold
  ;;;   max-dbs     -- how many named databases `dbi-open` may create
  ;;;   max-readers -- reader-table slots (0 keeps LMDB's 126)
  ;;;   read-only   -- MDB_RDONLY: refuse write transactions
  ;;;   subdir      -- true: `path` is a directory (LMDB's own layout)
  ;;;   sync        -- a Sync
  ;;;   create      -- create the file (or directory) when absent
  ;;;
  ;;; Example:
  ;;;   (opts-map-size (opts-max-dbs (env-opts) 4) (* 64 1048576))
  ;;;
  ;;; Since: 0.1.0
  (defstruct EnvOpts
    [map-size : int
     max-dbs : int
     max-readers : int
     read-only : bool
     subdir : bool
     sync : Sync
     create : bool])
  ;;; EnvInfo -- what `env-info` reports.
  ;;;
  ;;; Fields:
  ;;;   map-size    -- the current map size in bytes
  ;;;   last-page   -- the highest page number in use
  ;;;   last-txn    -- the id of the last committed transaction
  ;;;   max-readers -- reader-table size
  ;;;   num-readers -- reader slots in use
  ;;;
  ;;; Example:
  ;;;   (.map-size (env-info env))  ; => 1073741824
  ;;;
  ;;; Since: 0.1.0
  (defstruct EnvInfo
    [map-size : int
     last-page : int
     last-txn : int
     max-readers : int
     num-readers : int])
  ;;; DbStat -- what `env-stat` and `dbi-stat` report about one B+tree.
  ;;;
  ;;; Fields:
  ;;;   page-size      -- bytes per page
  ;;;   depth          -- height of the tree
  ;;;   branch-pages   -- internal pages
  ;;;   leaf-pages     -- leaf pages
  ;;;   overflow-pages -- pages holding large values
  ;;;   entries        -- number of key/value pairs
  ;;;
  ;;; Example:
  ;;;   (.entries (env-stat env))  ; => 3
  ;;;
  ;;; Since: 0.1.0
  (defstruct DbStat
    [page-size : int
     depth : int
     branch-pages : int
     leaf-pages : int
     overflow-pages : int
     entries : int])
  ;; -------------------------------------------------------------------------
  ;; Options
  ;; -------------------------------------------------------------------------
  ;;; default-map-size -- 1 GiB, or 64 MiB on Windows.
  ;;; On Linux and macOS an unused map costs no disk. On Windows LMDB 0.9.33
  ;;; extends the file to the whole map size when it opens it (mdb.c 4067), so
  ;;; the default there is small; see lmdb-spice-plan section 7.
  (defn default-map-size [] : int
    ```c
    #if defined(_WIN32)
    return (int64_t)64 << 20;
  #else
    return (int64_t)1 << 30;
  #endif
  ```)
  ;;; env-opts -- the default options.
  ;;;
  ;;; A 1 GiB map (64 MiB on Windows), 16 named databases, LMDB's reader
  ;;; count, read-write, one file, full sync, create when absent.
  ;;;
  ;;; Returns:
  ;;;   An EnvOpts.
  ;;;
  ;;; Example:
  ;;;   (env-open "app.mdb" (env-opts))
  ;;;
  ;;; Since: 0.1.0
  (defn env-opts [] : EnvOpts
    (EnvOpts (default-map-size) 16 0 false false (SyncFull) true))
  ;;; opts-map-size -- the options with the map size set to n bytes.
  ;;;
  ;;; Parameters:
  ;;;   o -- options
  ;;;   n -- the map size in bytes
  ;;;
  ;;; Returns:
  ;;;   The updated EnvOpts.
  ;;;
  ;;; Example:
  ;;;   (opts-map-size (env-opts) 1048576)
  ;;;
  ;;; Since: 0.1.0
  (defn opts-map-size [o : EnvOpts n : int] : EnvOpts
    (EnvOpts n
      (.max-dbs o)
      (.max-readers o)
      (.read-only o)
      (.subdir o)
      (.sync o)
      (.create o)))
  ;;; opts-max-dbs -- the options with room for n named databases.
  ;;;
  ;;; Parameters:
  ;;;   o -- options
  ;;;   n -- the named-database limit
  ;;;
  ;;; Returns:
  ;;;   The updated EnvOpts.
  ;;;
  ;;; Example:
  ;;;   (opts-max-dbs (env-opts) 64)
  ;;;
  ;;; Since: 0.1.0
  (defn opts-max-dbs [o : EnvOpts n : int] : EnvOpts
    (EnvOpts (.map-size o)
      n
      (.max-readers o)
      (.read-only o)
      (.subdir o)
      (.sync o)
      (.create o)))
  ;;; opts-max-readers -- the options with n reader-table slots.
  ;;;
  ;;; Parameters:
  ;;;   o -- options
  ;;;   n -- the reader limit
  ;;;
  ;;; Returns:
  ;;;   The updated EnvOpts.
  ;;;
  ;;; Example:
  ;;;   (opts-max-readers (env-opts) 512)
  ;;;
  ;;; Since: 0.1.0
  (defn opts-max-readers [o : EnvOpts n : int] : EnvOpts
    (EnvOpts (.map-size o)
      (.max-dbs o)
      n
      (.read-only o)
      (.subdir o)
      (.sync o)
      (.create o)))
  ;;; opts-read-only -- the options with read-only set to ro.
  ;;;
  ;;; Parameters:
  ;;;   o  -- options
  ;;;   ro -- true to open MDB_RDONLY
  ;;;
  ;;; Returns:
  ;;;   The updated EnvOpts.
  ;;;
  ;;; Example:
  ;;;   (opts-read-only (env-opts) true)
  ;;;
  ;;; Since: 0.1.0
  (defn opts-read-only [o : EnvOpts ro : bool] : EnvOpts
    (EnvOpts (.map-size o)
      (.max-dbs o)
      (.max-readers o)
      ro
      (.subdir o)
      (.sync o)
      (.create o)))
  ;;; opts-subdir -- the options with the directory layout set to d.
  ;;;
  ;;; Parameters:
  ;;;   o -- options
  ;;;   d -- true: `path` is a directory holding data.mdb and lock.mdb
  ;;;
  ;;; Returns:
  ;;;   The updated EnvOpts.
  ;;;
  ;;; Example:
  ;;;   (opts-subdir (env-opts) true)
  ;;;
  ;;; Since: 0.1.0
  (defn opts-subdir [o : EnvOpts d : bool] : EnvOpts
    (EnvOpts (.map-size o)
      (.max-dbs o)
      (.max-readers o)
      (.read-only o)
      d
      (.sync o)
      (.create o)))
  ;;; opts-sync -- the options with the commit flush policy set to s.
  ;;;
  ;;; Parameters:
  ;;;   o -- options
  ;;;   s -- a Sync
  ;;;
  ;;; Returns:
  ;;;   The updated EnvOpts.
  ;;;
  ;;; Example:
  ;;;   (opts-sync (env-opts) (SyncNone))
  ;;;
  ;;; Since: 0.1.0
  (defn opts-sync [o : EnvOpts s : Sync] : EnvOpts
    (EnvOpts (.map-size o)
      (.max-dbs o)
      (.max-readers o)
      (.read-only o)
      (.subdir o)
      s
      (.create o)))
  ;;; opts-no-create -- the options with create-when-absent turned off.
  ;;;
  ;;; Parameters:
  ;;;   o -- options
  ;;;
  ;;; Returns:
  ;;;   The updated EnvOpts: env-open of a missing path is then an Io error.
  ;;;
  ;;; Example:
  ;;;   (opts-no-create (env-opts))
  ;;;
  ;;; Since: 0.1.0
  (defn opts-no-create [o : EnvOpts] : EnvOpts
    (EnvOpts (.map-size o)
      (.max-dbs o)
      (.max-readers o)
      (.read-only o)
      (.subdir o)
      (.sync o)
      false))
  ;;; sync-code -- 0 full, 1 no-meta-sync, 2 none.
  (defn sync-code [s : Sync] : int
    (match s (SyncFull) 0 (SyncNoMetaSync) 1 (SyncNone) 2))
  ;; -------------------------------------------------------------------------
  ;; Private: raw C
  ;; -------------------------------------------------------------------------
  ;;; env-open-raw -- create, configure and open an MDB_env.
  ;;; ok: the env; err: the LMDB or errno code. A failed open closes the env.
  (defn env-open-raw [path : cstr
                      map-size : int
                      max-dbs : int
                      max-readers : int
                      read-only : bool
                      subdir : bool
                      sync : int
                      create : bool] : (Result Env int)
    ```c
    #include <errno.h>
  #include <lmdb.h>
  #include <sys/stat.h>
  #if defined(_WIN32)
  #include <direct.h>
  #endif
  struct stat st;
  int exists = stat((const char *)path, &st) == 0;
  if (!exists) {
    if (!create || read_only) return tur_err_int(ENOENT);
    if (subdir) {
  #if defined(_WIN32)
      if (_mkdir((const char *)path) != 0 && errno != EEXIST) return tur_err_int(errno);
  #else
      if (mkdir((const char *)path, 0775) != 0 && errno != EEXIST) return tur_err_int(errno);
  #endif
    }
  }
  MDB_env *env = NULL;
  int rc = mdb_env_create(&env);
  if (rc) return tur_err_int(rc);
  if (map_size > 0 && (rc = mdb_env_set_mapsize(env, (size_t)map_size))) goto fail;
  if ((rc = mdb_env_set_maxdbs(env, (MDB_dbi)max_dbs))) goto fail;
  if (max_readers > 0 && (rc = mdb_env_set_maxreaders(env, (unsigned)max_readers))) goto fail;
  unsigned flags = MDB_NOTLS;
  if (!subdir)    flags |= MDB_NOSUBDIR;
  if (read_only)  flags |= MDB_RDONLY;
  if (sync == 1)  flags |= MDB_NOMETASYNC;
  if (sync == 2)  flags |= MDB_NOSYNC;
  if ((rc = mdb_env_open(env, (const char *)path, flags, 0664))) goto fail;
  return tur_ok_ptr(env);
fail:
  mdb_env_close(env);
  return tur_err_int(rc);
  ```)
  ;;; env-info-field -- one field of mdb_env_info: 0 map size, 1 last page,
  ;;; 2 last txn, 3 max readers, 4 readers in use.
  (defn env-info-field [^borrow env : Env which : int] : int
    ```c
    #include <lmdb.h>
  MDB_envinfo info;
  if (mdb_env_info((MDB_env *)(intptr_t)env, &info)) return 0;
  switch (which) {
    case 0: return (int64_t)info.me_mapsize;
    case 1: return (int64_t)info.me_last_pgno;
    case 2: return (int64_t)info.me_last_txnid;
    case 3: return (int64_t)info.me_maxreaders;
    default: return (int64_t)info.me_numreaders;
  }
  ```)
  ;;; env-stat-field -- one field of mdb_env_stat (see DbStat's order).
  (defn env-stat-field [^borrow env : Env which : int] : int
    ```c
    #include <lmdb.h>
  MDB_stat s;
  if (mdb_env_stat((MDB_env *)(intptr_t)env, &s)) return 0;
  switch (which) {
    case 0: return (int64_t)s.ms_psize;
    case 1: return (int64_t)s.ms_depth;
    case 2: return (int64_t)s.ms_branch_pages;
    case 3: return (int64_t)s.ms_leaf_pages;
    case 4: return (int64_t)s.ms_overflow_pages;
    default: return (int64_t)s.ms_entries;
  }
  ```)
  ;;; env-set-map-size-raw -- mdb_env_set_mapsize; the LMDB code.
  (defn env-set-map-size-raw [^borrow env : Env n : int] : int
    ```c
    #include <lmdb.h>
  return (int64_t)mdb_env_set_mapsize((MDB_env *)(intptr_t)env, (size_t)n);
  ```)
  ;;; env-sync-raw -- mdb_env_sync(env, force); the LMDB code.
  (defn env-sync-raw [^borrow env : Env] : int
    ```c
    #include <lmdb.h>
  return (int64_t)mdb_env_sync((MDB_env *)(intptr_t)env, 1);
  ```)
  ;;; env-copy-raw -- mdb_env_copy2 to path; the LMDB code.
  (defn env-copy-raw [^borrow env : Env path : cstr compact : bool] : int
    ```c
    #include <lmdb.h>
  return (int64_t)mdb_env_copy2((MDB_env *)(intptr_t)env, (const char *)path,
                                compact ? MDB_CP_COMPACT : 0);
  ```)
  ;;; env-reader-check-raw -- mdb_reader_check; the dead-slot count, or
  ;;; -1 - code on failure.
  (defn env-reader-check-raw [^borrow env : Env] : int
    ```c
    #include <lmdb.h>
  int dead = 0;
  int rc = mdb_reader_check((MDB_env *)(intptr_t)env, &dead);
  if (rc) return -1 - (int64_t)(rc < 0 ? -rc : rc);
  return (int64_t)dead;
  ```)
  ;;; unit-result -- (Ok nil) for 0, else the error for rc.
  (defn unit-result [rc : int] : (Result nil LmdbError)
    (if (= rc 0) (Ok nil) (err (lmdb-error-of rc))))
  ;; -------------------------------------------------------------------------
  ;; Public
  ;; -------------------------------------------------------------------------
  ;;; env-open -- open (creating if allowed) the LMDB environment at path.
  ;;;
  ;;; Parameters:
  ;;;   path -- the data file, or the directory under `opts-subdir`
  ;;;   opts -- an EnvOpts; `(env-opts)` for the defaults
  ;;;
  ;;; Returns:
  ;;;   (Result Env LmdbError) -- ok carries a live Env the caller must
  ;;;   `env-close`; err is `NotADatabase` for a file that is not LMDB's, else
  ;;;   `Io` with the errno (ENOENT for a missing path that may not be created).
  ;;;
  ;;; Example:
  ;;;   (let [r (env-open "app.mdb" (env-opts))]
  ;;;     (if (ok? r) (let [env (ok-val r)] (do (use env) (env-close env))) ...))
  ;;;
  ;;; Since: 0.1.0
  (defn env-open [path : cstr opts : EnvOpts] : (Result Env LmdbError)
    (let [r (env-open-raw path
              (.map-size opts)
              (.max-dbs opts)
              (.max-readers opts)
              (.read-only opts)
              (.subdir opts)
              (sync-code (.sync opts))
              (.create opts))]
      (if (ok? r) (ok (ok-val r)) (err (lmdb-open-error-of (err-val r) path)))))
  ;;; env-close -- close an environment, releasing the map and the file.
  ;;;
  ;;; Every transaction and cursor on it must already be finished.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env; consumed
  ;;;
  ;;; Example:
  ;;;   (env-close env)
  ;;;
  ;;; Since: 0.1.0
  (defn env-close [env : Env] : nil
    ```c
    #include <lmdb.h>
  mdb_env_close((MDB_env *)(intptr_t)env);
  ```)
  ;;; env-set-map-size! -- change the map size to n bytes.
  ;;;
  ;;; Allowed only while this process has no transaction open on env. A size
  ;;; smaller than the data in use is raised to fit it; 0 adopts the file's
  ;;; current size.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;   n   -- the new size in bytes
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (env-set-map-size! env (* 2 (env-map-size env)))
  ;;;
  ;;; Since: 0.1.0
  (defn env-set-map-size! [^borrow env : Env n : int] : (Result nil LmdbError)
    (unit-result (env-set-map-size-raw env n)))
  ;;; env-map-size -- the current map size in bytes.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;
  ;;; Returns:
  ;;;   The map size.
  ;;;
  ;;; Example:
  ;;;   (env-map-size env)  ; => 1073741824
  ;;;
  ;;; Since: 0.1.0
  (defn env-map-size [^borrow env : Env] : int (env-info-field env 0))
  ;;; env-info -- the environment's map size, last page and readers.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;
  ;;; Returns:
  ;;;   An EnvInfo.
  ;;;
  ;;; Example:
  ;;;   (.num-readers (env-info env))  ; => 0
  ;;;
  ;;; Since: 0.1.0
  (defn env-info [^borrow env : Env] : EnvInfo
    (EnvInfo (env-info-field env 0)
      (env-info-field env 1)
      (env-info-field env 2)
      (env-info-field env 3)
      (env-info-field env 4)))
  ;;; env-stat -- statistics of the main (unnamed) database.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;
  ;;; Returns:
  ;;;   A DbStat. Named databases count as entries of the main one.
  ;;;
  ;;; Example:
  ;;;   (.entries (env-stat env))  ; => 2
  ;;;
  ;;; Since: 0.1.0
  (defn env-stat [^borrow env : Env] : DbStat
    (DbStat (env-stat-field env 0)
      (env-stat-field env 1)
      (env-stat-field env 2)
      (env-stat-field env 3)
      (env-stat-field env 4)
      (env-stat-field env 5)))
  ;;; env-sync -- flush committed data to disk now.
  ;;;
  ;;; Only needed under `(SyncNone)` or `(SyncNoMetaSync)`.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (env-sync env)
  ;;;
  ;;; Since: 0.1.0
  (defn env-sync [^borrow env : Env] : (Result nil LmdbError)
    (unit-result (env-sync-raw env)))
  ;;; env-copy -- write a consistent copy of the environment to path.
  ;;;
  ;;; A hot backup: it runs in a read transaction, so writers carry on. The
  ;;; copy is a single file (MDB_NOSUBDIR layout) when the source is one.
  ;;;
  ;;; Parameters:
  ;;;   env     -- the Env, borrowed
  ;;;   path    -- the destination (must not exist; a directory under subdir)
  ;;;   compact -- true: MDB_CP_COMPACT, omitting free pages and renumbering
  ;;;
  ;;; Returns:
  ;;;   (Result nil LmdbError)
  ;;;
  ;;; Example:
  ;;;   (env-copy env "backup.mdb" true)
  ;;;
  ;;; Since: 0.1.0
  (defn env-copy [^borrow env : Env path : cstr compact : bool] : (Result nil
                                                                    LmdbError)
    (unit-result (env-copy-raw env path compact)))
  ;;; env-reader-check -- clear reader slots left by processes that died.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;
  ;;; Returns:
  ;;;   (Result int LmdbError) -- ok carries how many stale slots were cleared.
  ;;;
  ;;; Example:
  ;;;   (env-reader-check env)  ; => (ok 0)
  ;;;
  ;;; Since: 0.1.0
  (defn env-reader-check [^borrow env : Env] : (Result int LmdbError)
    (let [n (env-reader-check-raw env)]
      (if (>= n 0) (ok n) (err (lmdb-error-of (- -1 n))))))
  ;;; env-max-key-size -- the longest key the environment accepts, in bytes.
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;
  ;;; Returns:
  ;;;   511 with LMDB's default build.
  ;;;
  ;;; Example:
  ;;;   (env-max-key-size env)  ; => 511
  ;;;
  ;;; Since: 0.1.0
  (defn env-max-key-size [^borrow env : Env] : int
    ```c
    #include <lmdb.h>
  return (int64_t)mdb_env_get_maxkeysize((MDB_env *)(intptr_t)env);
  ```)
  ;;; env-read-only? -- was the environment opened read-only?
  ;;;
  ;;; Parameters:
  ;;;   env -- the Env, borrowed
  ;;;
  ;;; Returns:
  ;;;   true under `opts-read-only`.
  ;;;
  ;;; Example:
  ;;;   (env-read-only? env)  ; => false
  ;;;
  ;;; Since: 0.1.0
  (defn env-read-only? [^borrow env : Env] : bool
    ```c
    #include <lmdb.h>
  unsigned int f = 0;
  mdb_env_get_flags((MDB_env *)(intptr_t)env, &f);
  return (f & MDB_RDONLY) != 0;
  ```)) ;; end defmodule lmdb/env
