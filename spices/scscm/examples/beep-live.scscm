; beep-live.scscm -- beep.scscm in the form that also works live.
; SynthDef .add is asynchronous: a Synth sent right behind it reaches the
; server first and fails with "SynthDef not found". Inside a routine,
; (. s sync) waits until the server has the SynthDef.

(defsynth beep (freq 440 amp 0.2)
  (Out.ar 0 (* (SinOsc.ar freq 0) (perc 0.01 0.99) amp)))

(defn play-beep (freq)
  (Synth "beep" (dict :freq freq)))

(routine
  (. s sync)
  (play-beep 440)
  (wait 0.5)
  (play-beep 660))
