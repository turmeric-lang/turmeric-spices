; beep.scscm -- two notes: 440 Hz now, 660 Hz half a second later.
; Each frees itself when its envelope ends (perc wraps EnvGen, doneAction 2).

(defsynth beep (freq 440 amp 0.2)
  (Out.ar 0 (* (SinOsc.ar freq 0) (perc 0.01 0.99) amp)))

(defn play-beep (freq)
  (Synth "beep" (dict :freq freq)))

(play-beep 440)
(in 0.5 (play-beep 660))
