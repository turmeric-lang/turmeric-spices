;; examples/scscmc.tur -- compile a .scscm file to sclang on stdout.
;;
;;   tur run examples/scscmc.tur -- prog.scscm > prog.scd
;;
;; Exits 1 with the compiler's message (line and column) on stderr when the
;; program does not compile.
(defmodule scscm/examples/scscmc
  (import scscm/compile :refer [compile-file])
  (import scscm/lexer   :refer [lex-ok? lex-ok-val lex-err-val scscm-int-as-cstr])

  (defn put [s : cstr] #fx{Unsafe IO} : int
    ```c fputs((const char*)s, stdout); return 0; ```)

  (defn complain [path : cstr msg : cstr] #fx{Unsafe IO} : int
    ```c fprintf(stderr, "%s: %s\n", (const char*)path, (const char*)msg); return 1; ```)

  (defn main [] #fx{Unsafe IO} : int
    (if (= *args* 0)
      (complain "usage" "tur run examples/scscmc.tur -- <file.scscm>")
      (let [path (scscm-int-as-cstr (head *args*))
            r    (compile-file path)]
        (if (lex-ok? r)
          (put (scscm-int-as-cstr (lex-ok-val r)))
          (complain path (scscm-int-as-cstr (lex-err-val r))))))))
