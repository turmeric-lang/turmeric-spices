;; scscm/compile -- public compile API: scscm source text -> sclang text.
;;
;; Pipeline: source -> tokenize -> parse -> expand-all -> generate-all -> sclang
;;
;; compile-text returns the lexer's ok/err box: lex-ok holds the sclang text,
;; lex-err an error message (both :cstr cast to :int; read with
;; scscm-int-as-cstr).
;; compile-file reads the file and delegates to compile-text.
(defmodule scscm/compile
  (export compile-text compile-file)
  (import scscm/lexer
    :refer
    [tokenize
     tokens-free
     lex-ok
     lex-err
     lex-ok?
     lex-err?
     lex-ok-val
     scscm-cstr-as-int])
  (import scscm/parser :refer [parse ast-free-all])
  (import scscm/expander :refer [expand-all scscm-macros-reset])
  (import scscm/codegen :refer [generate-all])
  ;; ---- file I/O helper ----
  (defn scscm-read-file [path : cstr]
    #fx{Unsafe}
    : int
    ```c
    const char *p = (const char*)(intptr_t)path;
  FILE *f = fopen(p, "rb");
  if (!f) return 0;
  fseek(f, 0, SEEK_END);
  long sz = ftell(f);
  rewind(f);
  char *buf = malloc(sz + 1);
  if (!buf) { fclose(f); return 0; }
  size_t got = fread(buf, 1, sz, f);
  buf[got] = '\0';
  fclose(f);
  return (int64_t)(intptr_t)buf;
  ```)
  ;; "cannot read <path>: <strerror>"
  (defn scscm-read-error [path : cstr]
    #fx{Unsafe}
    : cstr
    ```c
    const char *p = (const char*)(intptr_t)path;
  const char *e = strerror(errno);
  size_t n = strlen(p) + strlen(e) + 32;
  char *out = malloc(n);
  snprintf(out, n, "cannot read %s: %s", p, e);
  return out;
  ```)
  ;; Cast :int (cstr pointer) to :cstr.
  (defn scscm-int-as-cstr [n : int]
    #fx{Unsafe}
    : cstr
    ```c
    return (const char *)(intptr_t)n;
  ```)
  ;;; compile-text -- compile scscm source text to sclang text.
  ;;;
  ;;; Parameters:
  ;;;   source -- NUL-terminated scscm source string
  ;;;
  ;;; Returns:
  ;;;   lex-ok(sclang-text :cstr) on success.
  ;;;   lex-err(message :int) on a lexer or parser error; the message names
  ;;;   the line and column (cast :int to :cstr with scscm-int-as-cstr).
  ;;;
  ;;; Example:
  ;;;   (let [r (compile-text "(+ 1 2)")]
  ;;;     (if (lex-ok? r) (lex-ok-val r) "error"))
  ;;;
  ;;; Since: SC4
  (defn compile-text [source : cstr]
    #fx{Unsafe}
    : ptr<void>
    (let [lex-res (tokenize source)]
      (if (lex-err? lex-res)
        lex-res
        (let [tokens    (lex-ok-val lex-res)
              parse-res (parse tokens)]
          (tokens-free tokens)
          (if (lex-err? parse-res)
            parse-res
            (let [ast-list (lex-ok-val parse-res)
                  _        (scscm-macros-reset)
                  expanded (expand-all ast-list)
                  sclang   (generate-all expanded)]
              ;; The macro table points into ast-list, freed next.
              (scscm-macros-reset)
              (ast-free-all ast-list)
              (lex-ok (scscm-cstr-as-int sclang))))))))
  ;;; compile-file -- read a file and compile its scscm content to sclang.
  ;;;
  ;;; Parameters:
  ;;;   path -- NUL-terminated filesystem path to a .tur or .scscm file
  ;;;
  ;;; Returns:
  ;;;   lex-ok(sclang-text :cstr) on success.
  ;;;   lex-err(message :int) on a read or compile error.
  ;;;
  ;;; Example:
  ;;;   (let [r (compile-file "my-synth.scscm")]
  ;;;     (if (lex-ok? r) (lex-ok-val r) "error"))
  ;;;
  ;;; Since: SC4
  (defn compile-file [path : cstr]
    #fx{Unsafe}
    : ptr<void>
    (let [buf (scscm-read-file path)]
      (if (= buf 0)
        (lex-err (scscm-cstr-as-int (scscm-read-error path)))
        (let [src (scscm-int-as-cstr buf)] (compile-text src)))))) ;; end defmodule scscm/compile
