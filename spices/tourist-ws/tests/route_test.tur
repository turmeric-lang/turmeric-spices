;; tests/route_test.tur -- wiring tests for tourist-ws/route.
;;
;; ws-route! is a thin adapter: it hands `path` to tourist's get! together with
;; a handler that performs the WebSocket upgrade. The upgrade itself needs a
;; live Conn and belongs to fixtures/rest-plus-ws/, which stays manual -- but
;; building the route is pure (get! is `route-new` over `router-compile`, no
;; socket, and the handler closure is not invoked), so what CAN be asserted
;; here is that the adapter threads its arguments through correctly:
;;
;;   * it produces a route at all,
;;   * on the GET method specifically, and
;;   * carrying a pattern compiled from the path it was given -- captures and
;;     all, so ws-route! "/feed/:room" really is routable per-room.
;;
;; That is the whole of ws-route!'s own logic. Regressions in it (a dropped
;; path, a wrong method) are exactly what this catches.
(defmodule tourist-ws/tests/route
  (import tourist-ws/route :refer [ws-route!])
  (import tourist/dsl :refer [route-method route-pattern route-free])
  (import tourist/router :refer [router-match captures-get captures-free])
  (import tourist/types :refer [Captures Pattern])
  (import ws-core/conn :refer [WsConn])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  ;; run-all-status, not run-all: run-all returns void and the conventional
  ;; `(... (run-all) 0)` main hardcodes a 0 exit, so a failing `it` prints
  ;; `not ok` and `tur test` still calls the file a pass.
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
    return strcmp((const char *)a, (const char *)b) == 0;
    ```)
  ;;; noop-handler -- stands in for a session body. ws-route! only stores it;
  ;;; nothing here upgrades a connection, so it is never called.
  (defn noop-handler [ws : WsConn] : void (let [_ ws] 0))
  ;;; route-for -- the route Item ws-route! builds for `path`.  Each caller
  ;;; frees it with route-free when done.
  (defn route-for [path : cstr] : int (ws-route! path noop-handler))
  ;;; built? -- does ws-route! build a route at all?
  (defn built? [path : cstr] : bool
    (let [r  (route-for path)
          ok (not (= 0 r))]
      (route-free r)
      ok))
  ;;; method-is? -- is the route built for `path` declared on `want`?
  (defn method-is? [path : cstr want : cstr] : bool
    (let [r  (route-for path)
          ok (cstr-eq? want (route-method r))]
      (route-free r)
      ok))
  ;;; routes? -- does the route built for `path` match `req-path`?
  (defn routes? [path : cstr req-path : cstr] : bool
    (let [r    (route-for path)
          caps (router-match (:: (route-pattern r) :Pattern) req-path)
          hit  (not (= (:: caps :int) 0))]
      (when hit (captures-free caps))
      (route-free r)
      hit))
  ;;; captures-as? -- does routing `req-path` bind `want` under `key`?
  ;;;
  ;;; Compared before captures-free, deliberately: captures-get returns a
  ;;; pointer into the caps struct that captures-free then frees.
  (defn captures-as? [path : cstr req-path : cstr key : cstr want : cstr] : bool
    (let [r    (route-for path)
          caps (router-match (:: (route-pattern r) :Pattern) req-path)
          hit  (if (= (:: caps :int) 0)
                 false
                 (let [v  (captures-get caps key)
                       ok (if (ok? v) (cstr-eq? want (ok-val v)) false)]
                   (captures-free caps)
                   ok))]
      (route-free r)
      hit))
  (defn main [] : int
    (describe "tourist-ws/route -- ws-route! wiring"
      (it "builds a route" (assert-true (built? "/ws")))
      ;; A WebSocket handshake is a GET, so the route ws-route! declares must
      ;; be a GET route -- nothing else would ever be reached by an upgrade.
      (it "declares the route on GET" (assert-true (method-is? "/ws" "GET")))
      (it "compiles the path it was given" (assert-true (routes? "/ws" "/ws")))
      (it "does not route a different path"
        (assert-true (not (routes? "/ws" "/other"))))
      ;; The path is a full tourist pattern, not a literal: a per-room socket
      ;; endpoint is the motivating case in ws-route!'s own docstring.
      (it "keeps captures in the path"
        (assert-true (captures-as? "/feed/:room" "/feed/lobby" "room" "lobby")))
      (it "does not route a capture pattern against a missing segment"
        (assert-true (not (routes? "/feed/:room" "/feed")))))
    (run-all-status)))
