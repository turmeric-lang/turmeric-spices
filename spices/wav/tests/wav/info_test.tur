;; tests/wav/info_test.tur -- tests for wav/info.
(defmodule wav/tests/info
  (import test/suite :refer [describe it])
  ;; stdlib's parametric ok? / ok-val, not test/assert's carrier-typed
  ;; result-ok? / result-val: wav-open-write returns a typed (Result Wav int),
  ;; and the carrier-typed accessors hand back a bare int, which
  ;; wav-sample-rate rejects ("expected Wav, got int"). `result` is
  ;; auto-loaded, so ok? / ok-val need no import.
  (import test/assert :refer [assert-eq assert-true])
  (import test/runner :refer [run-all-status])
  (import wav/info
    :refer
    [wav-open-write wav-close wav-sample-rate wav-channels])
  (defn __all-tests [] : void
    (describe "wav/info"
      (it "creates a wav file with correct sample rate"
        (let [r (wav-open-write "/tmp/test_turmeric.wav" 44100 2 ":wav-pcm16")]
          (if (ok? r)
            (let [w (ok-val r)]
              (let [sr (wav-sample-rate w)] (wav-close w) (assert-eq sr 44100)))
            (assert-true false))))))
  (defn main [] : int (__all-tests) (run-all-status)))
