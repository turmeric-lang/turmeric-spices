;; test_pitch -- correctness tests for signal/pitch.
;;
;; Reference points of twelve-tone equal temperament at A4 = 440 Hz:
;;   note 69 = 440 Hz (A4), 81 = 880 Hz (A5), 57 = 220 Hz (A3)
;;   note 60 = 261.6256 Hz (middle C), 0 = 8.1758 Hz
;; plus the properties that do not depend on any table: a semitone is a
;; ratio of 2^(1/12), an octave doubles, and ftom inverts mtof.
;;
;; main returns the failure count for `tur test`.

(defmodule signal/tests/test_pitch
  (import signal/pitch :refer [mtof ftom])

(defn near? [a :float b :float] :bool
  (let [d (- a b)]
    (if (< d 0.0) (< (- 0.0 d) 0.0001) (< d 0.0001))))

(defn fail-unless [cond :bool label :cstr] :int
  (if cond 0 (do (println label) 1)))

;;; roundtrip-failures -- ftom (mtof m) = m over a spread of notes, fractional
;;; ones included.
(defn roundtrip-failures [] :int
  (let [^mut m    -24.25
        ^mut fail 0]
    (while (< m 140.0)
      (when (not (near? (ftom (mtof m)) m)) (set! fail (+ fail 1)))
      (set! m (+ m 7.1)))
    (fail-unless (= fail 0) "FAIL: ftom does not invert mtof")))

(defn main [] : int
  (let [f (+ (fail-unless (near? (mtof 69.0) 440.0) "FAIL: mtof 69 is not 440 Hz")
             (fail-unless (near? (mtof 81.0) 880.0) "FAIL: mtof 81 is not 880 Hz (octave up)")
             (fail-unless (near? (mtof 57.0) 220.0) "FAIL: mtof 57 is not 220 Hz (octave down)")
             (fail-unless (near? (mtof 60.0) 261.6255653) "FAIL: mtof 60 is not middle C")
             (fail-unless (near? (mtof 0.0) 8.1757989) "FAIL: mtof 0")
             ;; one semitone is a ratio of 2^(1/12)
             (fail-unless (near? (/ (mtof 61.3) (mtof 60.3)) 1.0594631) "FAIL: semitone ratio")
             ;; a quarter tone is half a semitone, in log frequency
             (fail-unless (near? (mtof 69.5) 452.8929841) "FAIL: fractional note")
             (fail-unless (near? (ftom 440.0) 69.0) "FAIL: ftom 440 is not 69")
             (fail-unless (near? (ftom 261.6255653) 60.0) "FAIL: ftom middle C is not 60")
             (fail-unless (near? (ftom 450.0) 69.3891) "FAIL: ftom between notes")
             (fail-unless (near? (ftom 110.0) 45.0) "FAIL: ftom 110 is not 45")
             (roundtrip-failures))]
    (if (= f 0)
      (println "PASS test_pitch")
      (println "test_pitch: failures above"))
    f))

) ;; end defmodule signal/tests/test_pitch
