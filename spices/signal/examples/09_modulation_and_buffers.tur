;; 09_modulation_and_buffers -- ring modulation, AM, PM, FM, and buffer scanning.
;;
;; Each modulation is checked against the identity that defines it:
;;   ring:  sin(a)sin(b) = (cos(a-b) - cos(a+b)) / 2      two sidebands
;;   PM:    sin(2 pi fc t + m(t))                          computed by hand
;;   FM:    FM by D cos(2 pi fm t) = PM by (D/fm) sin(2 pi fm t)
;; and buffer scanning against the signal the buffer was rendered from.
;; fm-sine integrates its frequency, so it is stateful: `walk-to` samples it in
;; order on the 48 kHz grid. Expected outputs are in comments.

(defmodule signal/examples/09_modulation_and_buffers
  (import signal/core   :refer [constant sample pair-signals map-signal])
  (import signal/osc    :refer [sine sawtooth triangle pm-sine fm-sine])
  (import signal/shaper :refer [gain offset multiply add])
  (import signal/buffer :refer [buffer-render buffer-len scan])
  (load "stdlib/math.tur")   ;; sin, for the hand-computed PM reference

;;; walk-to -- sample `y` at n = 0 .. k on a 48 kHz grid; return sample k.
(defn walk-to [^fat y : (fn [float] float) k : int] : float
  (let [^mut n 0
        ^mut v 0.0]
    (while (<= n k)
      (set! v (y (/ (as float n) 48000.0)))
      (set! n (+ n 1)))
    v))

(defn main [] : int
  (let [z       (constant 0.0)
        quarter 1.5707963267948966
        pi      3.141592653589793]
    ;; -----------------------------------------------------------------------
    ;; Ring modulation and AM
    ;; -----------------------------------------------------------------------
    (let [carrier   ((sine 440.0 0.0) z)
          modulator ((sine 100.0 0.0) z)
          ml        (multiply)
          ring      (ml (pair-signals carrier modulator))
          lower     ((gain 0.5) ((sine 340.0 quarter) z))
          upper     ((gain -0.5) ((sine 540.0 quarter) z))
          ad        (add)
          sides     (ad (pair-signals lower upper))
          depth     ((offset 0.5) ((gain 0.5) modulator))
          ml2       (multiply)
          am        (ml2 (pair-signals carrier depth))]
      (println (sample ring 0.0123))      ;; 0.521033
      (println (sample sides 0.0123))     ;; 0.521033 (340 Hz + 540 Hz)
      (println (sample am 0.0025))        ;; 0.587785 (all carrier)
      (println (sample am 0.0075)))       ;; 0 (silence)

    ;; -----------------------------------------------------------------------
    ;; Phase modulation: index 2 at a 4:1 ratio
    ;; -----------------------------------------------------------------------
    (let [pm    ((pm-sine 440.0) ((gain 2.0) ((sine 110.0 0.0) z)))
          t     0.0123
          phase (+ (* 2.0 pi 440.0 t) (* 2.0 (sin (* 2.0 pi 110.0 t))))]
      (println (sample pm t))             ;; -0.863752
      (println (sin phase)))              ;; -0.863752 (by hand)

    ;; -----------------------------------------------------------------------
    ;; Frequency modulation, and its PM twin
    ;; -----------------------------------------------------------------------
    (let [fm  ((fm-sine 48000.0 440.0) ((gain 220.0) ((sine 110.0 quarter) z)))
          pm  ((pm-sine 440.0) ((gain 2.0) ((sine 110.0 0.0) z)))
          vib ((fm-sine 48000.0 440.0) ((gain 6.0) ((sine 5.0 0.0) z)))
          dn  ((fm-sine 48000.0 100.0) (constant -200.0))]
      (println (walk-to fm 590))                   ;; -0.855503
      (println (sample pm (/ 590.0 48000.0)))      ;; -0.855517 (to 1e-5)
      (println (walk-to vib 24000))                ;; 0.675463 = sin(2.4)
      ;; 100 Hz pushed down 200 Hz runs backwards at 100 Hz: a mirrored sine.
      (println (walk-to dn 120))                   ;; -1
      (println (sample ((sine 100.0 0.0) z) 0.0025)))  ;; 1 (the forward sine)

    ;; -----------------------------------------------------------------------
    ;; Buffers: a wavetable oscillator and tape-style playback
    ;; -----------------------------------------------------------------------
    (let [ad    (add)
          shape (ad (pair-signals ((sine 1.0 0.0) z)
                                  ((gain 0.3) ((sine 3.0 0.0) z))))
          table (buffer-render 2048.0 2048 shape)
          osc   ((scan table) ((sawtooth 220.0) z))]
      (println (buffer-len table))                 ;; 2048
      (println (sample osc 0.001))                 ;; 0.72899
      (println (sample shape (* 220.0 0.001))))    ;; 0.728989
    (let [tape     (buffer-render 48000.0 24000 ((sine 440.0 0.0) z))
          normal   ((scan tape) ((sawtooth 2.0) z))
          fifth    ((scan tape) ((sawtooth 3.0) z))
          backward ((scan tape) ((gain -1.0) ((sawtooth 2.0) z)))
          rocking  (map-signal (fn [x : float] : float (* 0.25 (+ x 1.0)))
                               ((triangle 0.5) z))]
      (println (sample normal 0.01))               ;; 0.587785 (440 Hz, as recorded)
      (println (sample fifth 0.01))                ;; -0.587785
      (println (sample ((sine 660.0 0.0) z) 0.01)) ;; -0.587785 (a fifth up)
      (println (sample backward 0.01))             ;; -0.587785 (the tape at 0.49 s)
      (println (sample rocking 1.0))))             ;; 0.5 (scrub position)
  0)

) ;; end defmodule signal/examples/09_modulation_and_buffers
