;; 10_pitch_and_sequences -- note numbers, a melody in order, and a cycle.
;;
;; signal/pitch converts MIDI note numbers to Hz (mtof) and back (ftom), in
;; equal temperament with A4 = 440 Hz = note 69. The melody plays a list of
;; notes one per step, as a pure function of time, through fm-sine so the
;; phase runs on smoothly from note to note; `heard` reads each note back out
;; of the rendered audio to show what was played. `cycle` is the stateful
;; alternative: a closure that hands out the next value each time it is
;; called. Expected outputs are in comments.

(defmodule signal/examples/10_pitch_and_sequences
  (import signal/core     :refer [constant sample pair-signals map-signal])
  (import signal/osc      :refer [fm-sine])
  (import signal/pitch    :refer [mtof ftom])
  (import signal/shaper   :refer [multiply])
  (import signal/envelope :refer [ADSRParams adsr-fixed])
  (import signal/buffer   :refer [Buffer buffer-render buffer-get])

;;; note-at -- the note sounding at time t: one per `step` seconds, looping.
(defn note-at [notes : (Vec float) step : float t : float] : float
  (vec-get notes (mod (as int (/ t step)) (vec-len notes))))

;;; heard -- the nearest note to what `b` plays in [from, from + n) at 48 kHz.
(defn heard [b : Buffer from : int n : int] : int
  (let [^mut i  (+ from 1)
        ^mut up 0]
    (while (< i (+ from n))
      (when (and (< (buffer-get b (- i 1)) 0.0) (>= (buffer-get b i) 0.0))
        (set! up (+ up 1)))
      (set! i (+ i 1)))
    (as int (+ 0.5 (ftom (/ (as float up) (/ (as float n) 48000.0)))))))

;;; cycle -- hand out `values` in order, one per call, wrapping around.
(defn cycle [values : (Vec float)] : (fn [] float)
  (let [^mut i 0]
    (fn [] : float
      (let [v (vec-get values (mod i (vec-len values)))]
        (set! i (+ i 1))
        v))))

(defn main [] : int
  ;; ---------------------------------------------------------------------
  ;; Note numbers and Hz.
  ;; ---------------------------------------------------------------------
  (println (mtof 69.0))                 ;; 440 (A4)
  (println (mtof 60.0))                 ;; 261.626 (middle C)
  (println (mtof 72.0))                 ;; 523.251 (an octave up)
  (println (ftom 450.0))                ;; 69.3891 (A4, 39 cents sharp)
  (println (ftom (mtof 61.25)))         ;; 61.25 (they invert each other)
  (let [glide (fn [t : float] : float (+ 69.0 (* 2.0 t)))
        hz    (map-signal mtof glide)]
    (println (sample hz 0.5)))          ;; 466.164 (B-flat 4)

  ;; ---------------------------------------------------------------------
  ;; A melody, one note per quarter second, rendered and read back.
  ;; ---------------------------------------------------------------------
  (let [melody [60.0 64.0 67.0 72.0]
        step   0.25
        z      (constant 0.0)
        freq   (fn [t : float] : float (mtof (note-at melody step t)))
        tone   ((fm-sine 48000.0 0.0) freq)
        env    ((adsr-fixed (make-struct ADSRParams 0.005 0.05 0.7 0.04) 0.2) z)
        per    (fn [t : float] : float
                 (sample env (- t (* step (as float (as int (/ t step)))))))
        ml     (multiply)
        voice  (ml (pair-signals tone per))
        out    (buffer-render 48000.0 48000 voice)]
    (println (heard out 0 9600))        ;; 60
    (println (heard out 12000 9600))    ;; 64
    (println (heard out 24000 9600))    ;; 67
    (println (heard out 36000 9600)))   ;; 72

  ;; ---------------------------------------------------------------------
  ;; Cycles: three notes against four accents, and an independent copy.
  ;; ---------------------------------------------------------------------
  (let [next-note (cycle [60.0 64.0 67.0])
        next-amp  (cycle [1.0 0.5 0.75 0.5])
        other     (cycle [60.0 64.0 67.0])]
    (println (next-note)) (println (next-amp))   ;; 60, 1
    (println (next-note)) (println (next-amp))   ;; 64, 0.5
    (println (next-note)) (println (next-amp))   ;; 67, 0.75
    (println (next-note)) (println (next-amp))   ;; 60, 0.5
    (println (mtof (next-note)))                 ;; 329.628 (E4)
    (println (other)))                           ;; 60
  0)

) ;; end defmodule signal/examples/10_pitch_and_sequences
