;; 11_interpolation -- reading a buffer between its samples, four ways.
;;
;; A buffer stores samples; a read at a position between two of them has to
;; make up a value. signal/buffer offers four interpolators, each as a read
;; (buffer-read*) and as an SF (scan*):
;;
;;   nearest  the closest sample: a step function
;;   linear   a straight line between the two neighbours (buffer-read / scan)
;;   cubic    a smooth curve through four samples (Catmull-Rom)
;;   sinc     a 32-tap windowed sinc: the band-limited signal the samples
;;            came from
;;
;; The diamond 0, 1, 0, -1 is one cycle of a sine sampled four times, so
;; half way from sample 0 to sample 1 the sine itself is sin(pi/4) = 0.7071:
;; each step up gets closer. A recorded 16.8 kHz tone -- 0.35 cycles per
;; sample at 48 kHz -- only the sinc read reproduces. And a table of note
;; numbers, where an in-between value means nothing, wants nearest.
;; Expected outputs are in comments.

(defmodule signal/examples/11_interpolation
  (import signal/core   :refer [constant sample map-signal])
  (import signal/osc    :refer [sine sawtooth])
  (import signal/pitch  :refer [mtof])
  (import signal/buffer :refer [Buffer buffer-new buffer-set! buffer-render
                                buffer-read buffer-read-nearest
                                buffer-read-cubic buffer-read-sinc
                                scan scan-cubic scan-sinc scan-nearest])

;;; diamond -- a 4-sample buffer holding 0, 1, 0, -1.
(defn diamond [] : Buffer
  (let [b (buffer-new 4)]
    (buffer-set! b 1 1.0)
    (buffer-set! b 3 -1.0)
    b))

(defn main [] : int
  ;; ---------------------------------------------------------------------
  ;; Half way between two samples of a sampled sine.
  ;; ---------------------------------------------------------------------
  (let [d (diamond)]
    (println (buffer-read-nearest d 0.125))   ;; 1 (sample 1: 0.5 rounds up)
    (println (buffer-read d 0.125))           ;; 0.5
    (println (buffer-read-cubic d 0.125))     ;; 0.625
    (println (buffer-read-sinc d 0.125))      ;; 0.707112 (sin(pi/4) = 0.707107)
    ;; on a sample, all four agree
    (println (buffer-read-sinc d 0.75)))      ;; -1

  ;; ---------------------------------------------------------------------
  ;; A 16.8 kHz recording, read 0.037 samples further on each sample.
  ;; ---------------------------------------------------------------------
  (let [z    (constant 0.0)
        tone (buffer-render 48000.0 4800 ((sine 16800.0 0.0) z))
        ramp ((sawtooth 0.37) z)                ;; 0.37 * 4800 / 48000 = 0.037
        t    0.01]
    (println (sample ((sine 621.6 0.0) z) t))  ;; 0.977268 (the tone, slowed down)
    (println (sample ((scan tone) ramp) t))     ;; 0.648639 (linear)
    (println (sample ((scan-cubic tone) ramp) t))  ;; 0.836492 (cubic)
    (println (sample ((scan-sinc tone) ramp) t)))  ;; 0.977271 (sinc)

  ;; ---------------------------------------------------------------------
  ;; A table of notes. Linear would invent a note 60% of the way from E to
  ;; G; nearest plays one of them. Each sample owns the positions within half
  ;; a sample of it, so the ramp is moved back half a step to make step k
  ;; cover [k/4, (k+1)/4) of each cycle.
  ;; ---------------------------------------------------------------------
  (let [notes (buffer-new 4)
        z     (constant 0.0)
        pos   (map-signal (fn [p : float] : float (- p 0.125)) ((sawtooth 1.0) z))
        step  ((scan-nearest notes) pos)]
    (buffer-set! notes 0 60.0)
    (buffer-set! notes 1 64.0)
    (buffer-set! notes 2 67.0)
    (buffer-set! notes 3 72.0)
    (println (buffer-read notes 0.4))           ;; 65.8 (no such note)
    (println (buffer-read-nearest notes 0.4))   ;; 67
    (println (sample step 0.3))                 ;; 64 (step 1 covers 0.25 .. 0.5)
    (println (sample step 0.45))                ;; 64
    (println (sample step 0.5))                 ;; 67
    (println (mtof (sample step 0.9))))         ;; 523.251 (C5)
  0)

) ;; end defmodule signal/examples/11_interpolation
