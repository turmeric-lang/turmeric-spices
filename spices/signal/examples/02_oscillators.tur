;; 02_oscillators -- the four naive oscillator shapes, at audible pitches.
;;
;; Each oscillator returns an SF; apply it to a placeholder input signal
;; (oscillators ignore their input) and sample at characteristic points of
;; its own cycle: a pitch of f Hz has a period of 1/f seconds, so a quarter
;; cycle in is t = 0.25 / f. 440 Hz is A4, 220 Hz is A3, 110 Hz is A2.
;;
;; The square, sawtooth and triangle alias at audio pitches -- the values are
;; exact, the sound is not. For a voice use signal/hf-osc (example 06).

(defmodule signal/examples/02_oscillators
  (import signal/core :refer [constant sample])
  (import signal/osc  :refer [sine square sawtooth triangle])

(defn main [] : int
  (let [unused (constant 0.0)

        ;; sine A4, no phase offset: 0 at t=0, +1 a quarter cycle in.
        s1   ((sine 440.0 0.0) unused)
        ;; square A3, 50% duty: +1 for the first half of each cycle, -1 after.
        sq   ((square 220.0 0.5) unused)
        ;; sawtooth A2: ramps in [0, 1) once per cycle.
        saw  ((sawtooth 110.0) unused)
        ;; triangle A3: rises -1 -> 1 over the first half cycle, falls back.
        tri  ((triangle 220.0) unused)]

    (println (sample s1 0.0))                 ;; 0
    (println (sample s1 (/ 0.25 440.0)))      ;; 1
    (println (sample s1 (/ 0.75 440.0)))      ;; -1

    (println (sample sq (/ 0.25 220.0)))      ;; 1
    (println (sample sq (/ 0.75 220.0)))      ;; -1

    (println (sample saw 0.0))                ;; 0
    (println (sample saw (/ 0.5 110.0)))      ;; 0.5

    (println (sample tri 0.0))                ;; -1
    (println (sample tri (/ 0.25 220.0)))     ;; 0
    (println (sample tri (/ 0.5 220.0)))      ;; 1
    (println (sample tri (/ 0.75 220.0))))    ;; 0

  0)

) ;; end defmodule
