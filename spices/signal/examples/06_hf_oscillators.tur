;; 06_hf_oscillators -- band-limited oscillators for hearing-range pitches.
;;
;; signal/osc's sawtooth and square are naive: fine as LFOs, but at audio rate
;; their sharp edges alias. signal/hf-osc rounds each edge with PolyBLEP (a
;; PolyBLAMP for the triangle) so the same shapes can be used as audio sources.
;;
;; Each constructor also takes the sample rate the signal will be sampled at.
;; This program samples a 7919 Hz sawtooth on a 48 kHz grid across a cycle
;; boundary and prints the naive ramp beside the band-limited one: away from the
;; edge they agree, and across it the band-limited signal rounds the step.
(defmodule signal/examples/06_hf_oscillators
  (import signal/core :refer [constant sample])
  (import signal/osc :refer [sawtooth])
  (import signal/hf-osc :refer [hf-sawtooth])
  (defn to-float [n : int] : float
    ```c
    return (double)n;
  ```)
  (defn show [naive : (fn [float] float)
              bl : (fn [float] float)
              i : int
              n : int] : int
    (if (>= i n)
      0
      (let [t (/ (to-float i) 4.8e+04)]
        (println (- (* 2.0 (naive t)) 1.0)) ;; naive, rescaled to [-1, 1)
        (println (bl t))
        (show naive bl (+ i 1) n))))
  (defn main [] : int
    (let [unused (constant 0.0)
          naive  ((sawtooth 7919.0) unused)
          bl     ((hf-sawtooth 7919.0 4.8e+04) unused)]
      ;; Samples 0..5 straddle the first cycle boundary at t = 0, where the
      ;; band-limited wave is centered on the step.
      (show (fn [t : float] : float (sample naive t))
        (fn [t : float] : float (sample bl t))
        0
        6)
      0))) ;; end defmodule
