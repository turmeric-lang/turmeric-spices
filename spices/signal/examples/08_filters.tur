;; 08_filters -- biquads, the state-variable filter, and the ladder.
;;
;; Every filter is stateful, so each measurement below builds a fresh instance
;; and samples it in order on a 48 kHz grid. `level` runs a sine through a
;; filter, discards 0.1 s of transient, and returns the amplitude of the next
;; 0.1 s: the filter's gain at that frequency. Expected outputs are in comments
;; and follow from the designs, not from this code:
;;   lp / hp at the cutoff: gain q.   band-pass at its center: 1.
;;   notch at its center: 0.          peaking EQ at its center: 10^(dB/20).
;;   ladder at the cutoff, resonance r: 0.25 / (1 - r).

(defmodule signal/examples/08_filters
  (import signal/core   :refer [constant sample])
  (import signal/osc    :refer [sine])
  (import signal/filter :refer [biquad-lp biquad-hp biquad-bp biquad-notch
                                biquad-allpass biquad-peak biquad-low-shelf
                                svf-lp svf-bp ladder dc-block])
  (load "stdlib/math.tur")   ;; sqrt

;;; level -- amplitude of `y` over 0.1 .. 0.2 s at 48 kHz.
(defn level [^fat y : (fn [float] float)] : float
  (let [^mut k   0
        ^mut acc 0.0]
    (while (< k 9600)
      (let [v (sample y (/ (as float k) 48000.0))]
        (when (>= k 4800) (set! acc (+ acc (* v v)))))
      (set! k (+ k 1)))
    (sqrt (/ acc 2400.0))))

;;; quarters -- render 1 s at 48 kHz in order; print each quarter's level.
(defn quarters [^fat y : (fn [float] float)] : int
  (let [^mut k   0
        ^mut acc 0.0]
    (while (< k 48000)
      (let [v (sample y (/ (as float k) 48000.0))]
        (set! acc (+ acc (* v v))))
      (set! k (+ k 1))
      (when (= (mod k 12000) 0)
        (println (sqrt (/ acc 6000.0)))
        (set! acc 0.0)))
    0))

(defn main [] : int
  (let [tone  ((sine 1000.0 0.0) (constant 0.0))
        at1k  (constant 1000.0)]
    ;; ---------------------------------------------------------------------
    ;; Biquads (RBJ cookbook), all centered on the 1 kHz test tone.
    ;; ---------------------------------------------------------------------
    (println (level ((biquad-lp 48000.0 1000.0 0.7071) tone)))      ;; 0.7071 (-3 dB)
    (println (level ((biquad-lp 48000.0 1000.0 4.0) tone)))         ;; 4
    (println (level ((biquad-lp 48000.0 250.0 0.7071) tone)))       ;; 0.0622119 (-24 dB)
    (println (level ((biquad-hp 48000.0 1000.0 0.7071) tone)))      ;; 0.7071
    (println (level ((biquad-bp 48000.0 1000.0 4.0) tone)))         ;; 1
    (println (level ((biquad-notch 48000.0 1000.0 4.0) tone)))      ;; 6.64907e-14 (gone)
    (println (level ((biquad-allpass 48000.0 300.0 0.7071) tone)))  ;; 1
    (println (level ((biquad-peak 48000.0 1000.0 1.0 6.0) tone)))   ;; 1.99526 (+6 dB)
    (println (level ((biquad-low-shelf 48000.0 8000.0 0.7071 -6.0) tone)))  ;; 0.501249 (-6 dB: 0.501187, nearly)

    ;; ---------------------------------------------------------------------
    ;; State-variable filter and ladder: the cutoff is a signal.
    ;; ---------------------------------------------------------------------
    (println (level ((svf-lp 48000.0 at1k 4.0) tone)))              ;; 4 (as biquad-lp)
    (println (level ((ladder 48000.0 at1k 0.0) tone)))              ;; 0.25
    (println (level ((ladder 48000.0 at1k 0.5) tone)))              ;; 0.5

    ;; A band-pass swept from 500 Hz to 4.5 kHz over 1 s across a 2 kHz
    ;; tone: loudest in the quarter where the band crosses 2 kHz.
    (let [tone2  ((sine 2000.0 0.0) (constant 0.0))
          rising (fn [t : float] : float (+ 500.0 (* 4000.0 t)))]
      (quarters ((svf-bp 48000.0 rising 8.0) tone2)))
    ;; prints 0.10482, 0.571767, 0.162979, 0.0827114

    ;; Resonance 1: the ladder rings at its cutoff after a single kick.
    (let [kick (fn [t : float] : float (if (< t 0.00001) 1.0 0.0))]
      (quarters ((ladder 48000.0 at1k 1.0) kick)))
    ;; prints 0.0230724, 0.023074, 0.023074, 0.023074

    ;; dc-block strips a 0.5 offset from the tone and keeps the tone.
    (let [offset-tone (fn [t : float] : float (+ 0.5 (sample tone t)))]
      (println (level ((dc-block 48000.0 10.0) offset-tone)))))     ;; 1.00061
  0)

) ;; end defmodule signal/examples/08_filters
