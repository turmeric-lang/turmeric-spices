;; 05_simple_voice -- one note of a simple voice, at an audible pitch.
;;
;;   band-limited sawtooth, A3 (220 Hz)       (hf-osc)
;;     -> effects-chain [gain, low-pass]      (compose + shaper + filter)
;;     -> multiplied by an ADSR envelope      (core pair-signals + shaper)
;;
;; The low-pass is stateful, so the note is rendered once, in order, on the
;; 48 kHz grid (signal/buffer), and its level is read back at points in the
;; envelope's life. The sustain level is the filtered sawtooth's peak (about
;; 0.99) times the gain (0.8) times the sustain level (0.6).
(defmodule signal/examples/05_simple_voice
  (import signal/core :refer [constant pair-signals])
  (import signal/hf-osc :refer [hf-sawtooth])
  (import signal/filter :refer [biquad-lp])
  (import signal/shaper :refer [gain multiply])
  (import signal/envelope :refer [ADSRParams adsr-fixed])
  (import signal/compose :refer [effects-chain])
  (import signal/buffer :refer [Buffer buffer-render buffer-get])
  ;;; peak -- the largest |sample| of `b` in [from, to).
  (defn peak [b : Buffer from : int to : int] : float
    (let [^mut i from
          ^mut m 0.0]
      (while (< i to)
        (let [v (buffer-get b i)
              a (if (< v 0.0) (- 0.0 v) v)]
          (when (> a m) (set! m a)))
        (set! i (+ i 1)))
      m))
  (defn main [] : int
    (let [unused                                                                   (constant 0.0)
          ;; Source: a band-limited A3 sawtooth for 48 kHz.
          osc                                                                      ((hf-sawtooth 2.2e+02
                                                                                      4.8e+04) unused)
          ;; Timbre: attenuate to 0.8, then a 2 kHz low-pass. effects-chain
          ;; returns a ptr<void> carrier; re-bind it as a ^fat signal closure.
          ^fat chain                                                               : (fn [float]
                                                                                       float)
          (effects-chain (vec-of (gain 0.8) (biquad-lp 4.8e+04 2e+03 0.7071))
            osc)
          ;; Amplitude: a short ADSR, gate held 0.5 s, 0.2 s release.
                                                                                   env
          ((adsr-fixed (make-struct ADSRParams 0.01 0.1 0.6 0.2) 0.5) unused)
          ;; Voice = filtered source * envelope, via a product signal.
                                                                                   ml
          (multiply)                                                               voice
          (ml (pair-signals chain env))
          ;; 0.75 s: the gate plus its release.
                                                                                   note
          (buffer-render 4.8e+04 36000 voice)]
      (println (peak note 0 240)) ;; 0.385413   (first 5 ms: attack)
      (println (peak note 4800 7200)) ;; 0.504735   (0.1 .. 0.15 s: end of the decay)
      (println (peak note 12000 14400)) ;; 0.474386   (0.25 .. 0.3 s: sustain)
      (println (peak note 28800 31200)) ;; 0.236298   (0.6 .. 0.65 s: releasing)
      (println (peak note 33600 36000))) ;; 9.9799e-17 (0.7 .. 0.75 s: done)
    0)) ;; end defmodule
