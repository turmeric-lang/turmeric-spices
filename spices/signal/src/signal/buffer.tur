;; Signal Processing -- Sample buffers and buffer scanning
;;
;; A Buffer is a fixed-length array of samples. Fill it by rendering a signal
;; into it (`buffer-render`) or by writing samples (`buffer-set!`), then read it
;; back as a signal by SCANNING it: `scan` is an SF whose input signal is the
;; read position, so whatever drives the position -- a ramp, an LFO, an
;; envelope, another buffer -- decides how the buffer is played.
;;
;;   ((scan buf) ((sawtooth 220.0) z))        one cycle per 1/220 s: a
;;                                            wavetable oscillator at 220 Hz
;;   ((scan buf) ((sawtooth (/ sr n)) z))     the whole n-sample buffer once
;;                                            per n / sr seconds: looped
;;                                            playback at the original speed
;;   ((scan buf) slow-lfo)                    scrubbing back and forth
;;
;; Positions are in BUFFER LENGTHS: 0.0 is the first sample, 0.5 the middle,
;; and the position wraps, so 1.0 is the first sample again and -0.25 is
;; three quarters of the way in. That makes signal/osc `sawtooth`, a ramp in
;; [0, 1), the natural scan driver. Between two samples the read interpolates,
;; and the interpolation wraps too -- the last sample's right neighbour is the
;; first -- so a buffer holding exactly one cycle loops without a click.
;;
;; Four interpolators, from cheapest to most accurate, each as a read and as a
;; scan:
;;
;;   buffer-read-nearest  scan-nearest   the nearest sample; a step function
;;   buffer-read          scan           linear, between the two neighbours
;;   buffer-read-cubic    scan-cubic     4-point cubic Hermite (Catmull-Rom)
;;   buffer-read-sinc     scan-sinc      32-tap Kaiser-windowed sinc
;;
;; All four agree on the sample grid. Off it, they differ in how much of the
;; band they reconstruct: on a sine of f cycles per sample, linear is good to
;; about 1e-2 at f = 0.05 and cubic to about 5e-4, but both are off by 0.2 or
;; more by f = 0.3; the sinc read stays within 1e-5 up to f = 0.4 (19.2 kHz at
;; 48 kHz). None of them filters: a buffer scanned FASTER than one sample per
;; sample period (transposed up) still aliases whatever it holds above the new
;; Nyquist, so render tables band-limited for the pitches they will play.
;;
;; `scan` keeps no state of its own: if its position signal is a pure function
;; of t (an oscillator), so is the scanned signal, and it may be sampled in any
;; order. `buffer-render` samples its signal once per index, in order, so it is
;; also the way to freeze a stateful signal (noise, a filter) into a repeatable
;; one.
;;
;; Buffers hold up to 16777216 samples and live for the process, like the
;; filter and delay state cells. A Buffer is a handle: writing to it with
;; `buffer-set!` is seen by every scan of it.
(defmodule signal/buffer
  (export Buffer
    buffer-new
    buffer-render
    buffer-len
    buffer-get
    buffer-set!
    buffer-read
    buffer-read-nearest
    buffer-read-cubic
    buffer-read-sinc
    scan
    scan-nearest
    scan-cubic
    scan-sinc)
  ;;; Buffer -- a fixed-length array of samples, shared by handle.
  ;;;
  ;;; Layout: [int64 len][double samples[len]].
  (defopaque Buffer :ptr<void>)
  ;;; __buffer_alloc -- allocate a zeroed buffer of `n` samples (clamped).
  (defn __buffer_alloc [n :int] : ptr<void>
    ```c
    int64_t len = n;
  if (len < 1) len = 1;
  if (len > 16777216) len = 16777216;
  int64_t *p = (int64_t *)calloc(1, sizeof(int64_t) + (size_t)len * sizeof(double));
  if (!p) { fprintf(stderr, "buffer: alloc failed\n"); abort(); }
  p[0] = len;
  return p;
  ```)
  ;;; buffer-new -- a buffer of `n` silent samples.
  ;;;
  ;;; Parameters:
  ;;;   n -- length in samples, clamped to [1, 16777216]
  ;;;
  ;;; Returns:
  ;;;   A Buffer of n zeros.
  ;;;
  ;;; Example:
  ;;;   (buffer-len (buffer-new 64))  ; => 64
  (defn buffer-new [n :int] : Buffer (:: (__buffer_alloc n) Buffer))
  ;;; buffer-len -- number of samples in a buffer.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer
  ;;;
  ;;; Returns:
  ;;;   The length in samples.
  ;;;
  ;;; Example:
  ;;;   (buffer-len (buffer-new 64))  ; => 64
  (defn buffer-len [buf : Buffer] : int
    ```c
    return ((int64_t *)(intptr_t)buf)[0];
  ```)
  ;;; buffer-get -- the sample at index `i`, wrapping out-of-range indices.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer
  ;;;   i   -- index; taken modulo the length, so -1 is the last sample
  ;;;
  ;;; Returns:
  ;;;   The stored sample.
  ;;;
  ;;; Example:
  ;;;   (buffer-get buf 0)
  (defn buffer-get [buf : Buffer i :int] : float
    ```c
    int64_t *p = (int64_t *)(intptr_t)buf;
  int64_t len = p[0];
  int64_t k = i % len;
  if (k < 0) k += len;
  return ((double *)(p + 1))[k];
  ```)
  ;;; buffer-set! -- store sample `x` at index `i`, wrapping like `buffer-get`.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer
  ;;;   i   -- index; taken modulo the length
  ;;;   x   -- the sample to store
  ;;;
  ;;; Example:
  ;;;   (buffer-set! buf 0 1.0)
  (defn buffer-set! [buf : Buffer i :int x :float] : nil
    ```c
    int64_t *p = (int64_t *)(intptr_t)buf;
  int64_t len = p[0];
  int64_t k = i % len;
  if (k < 0) k += len;
  ((double *)(p + 1))[k] = x;
  ```)
  ;;; buffer-read -- linearly interpolated read at a position in buffer lengths.
  ;;;
  ;;; Position 0.0 is sample 0, 1.0 wraps back to sample 0, and in between the
  ;;; read is `pos * len` samples in, interpolated between its two neighbours
  ;;; (the last sample's right neighbour is the first). NaN or infinite
  ;;; positions read sample 0.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer
  ;;;   pos -- read position; wraps, so any float is valid
  ;;;
  ;;; Returns:
  ;;;   The interpolated sample.
  ;;;
  ;;; Example:
  ;;;   (buffer-read buf 0.5)   ;; the middle of the buffer
  (defn buffer-read [buf : Buffer pos :float] : float
    ```c
    /* __tur_autolink__: -lm */
  extern double floor(double);
  int64_t *p = (int64_t *)(intptr_t)buf;
  int64_t len = p[0];
  const double *d = (const double *)(p + 1);
  double x = pos - floor(pos);
  if (!(x >= 0.0 && x < 1.0)) x = 0.0;
  double idx = x * (double)len;
  int64_t i0 = (int64_t)idx;
  if (i0 >= len) i0 = len - 1;
  double frac = idx - (double)i0;
  int64_t i1 = (i0 + 1 == len) ? 0 : i0 + 1;
  return d[i0] + frac * (d[i1] - d[i0]);
  ```)
  ;;; buffer-read-nearest -- the sample nearest a position in buffer lengths.
  ;;;
  ;;; No interpolation: position `pos` reads sample `round(pos * len)`, wrapping,
  ;;; so the result steps from one stored value to the next half way between
  ;;; them. The cheapest read, and the right one for a buffer of discrete values
  ;;; -- a table of note numbers, a step sequence -- where a value between two
  ;;; entries means nothing. Each sample owns the positions within half a
  ;;; sample of it; to have entry k of an n-entry sequence cover [k/n, (k+1)/n)
  ;;; of a ramp, read at `pos - 0.5/n`. NaN or infinite positions read sample 0.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer
  ;;;   pos -- read position; wraps, so any float is valid
  ;;;
  ;;; Returns:
  ;;;   The nearest stored sample.
  ;;;
  ;;; Example:
  ;;;   ;; a 4-sample buffer: 0.3 * 4 = 1.2 rounds to sample 1
  ;;;   (buffer-read-nearest buf 0.3)
  ;;;
  ;;; Since: signal v0.1.0
  (defn buffer-read-nearest [buf : Buffer pos :float] : float
    ```c
    extern double floor(double);
  int64_t *p = (int64_t *)(intptr_t)buf;
  int64_t len = p[0];
  const double *d = (const double *)(p + 1);
  double x = pos - floor(pos);
  if (!(x >= 0.0 && x < 1.0)) x = 0.0;
  int64_t i = (int64_t)floor(x * (double)len + 0.5);
  if (i >= len) i -= len;
  return d[i];
  ```)
  ;;; buffer-read-cubic -- cubic-interpolated read at a position in buffer lengths.
  ;;;
  ;;; The 4-point, third-order Hermite (Catmull-Rom) interpolator: the curve
  ;;; through the two neighbours of the read point whose slope at each is set by
  ;;; the samples either side, so it is smooth (no corners at the samples, unlike
  ;;; linear). Wraps like `buffer-read`, at both ends of the four-sample window.
  ;;; Read off the grid, a 440 Hz recording at 48 kHz comes back within 3e-6
  ;;; (linear: 4e-4), for little more work than linear; but like linear it loses
  ;;; the top of the band -- see `buffer-read-sinc`. NaN or infinite positions
  ;;; read sample 0.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer
  ;;;   pos -- read position; wraps, so any float is valid
  ;;;
  ;;; Returns:
  ;;;   The interpolated sample.
  ;;;
  ;;; Example:
  ;;;   (buffer-read-cubic buf 0.5)   ;; the middle of the buffer
  ;;;
  ;;; Since: signal v0.1.0
  (defn buffer-read-cubic [buf : Buffer pos :float] : float
    ```c
    extern double floor(double);
  int64_t *p = (int64_t *)(intptr_t)buf;
  int64_t len = p[0];
  const double *d = (const double *)(p + 1);
  double x = pos - floor(pos);
  if (!(x >= 0.0 && x < 1.0)) x = 0.0;
  double idx = x * (double)len;
  int64_t i0 = (int64_t)idx;
  if (i0 >= len) i0 = len - 1;
  double f = idx - (double)i0;
  double ym1 = d[(i0 + len - 1) % len], y0 = d[i0];
  double y1 = d[(i0 + 1) % len], y2 = d[(i0 + 2) % len];
  double c1 = 0.5 * (y1 - ym1);
  double c2 = ym1 - 2.5 * y0 + 2.0 * y1 - 0.5 * y2;
  double c3 = 0.5 * (y2 - ym1) + 1.5 * (y0 - y1);
  return ((c3 * f + c2) * f + c1) * f + y0;
  ```)
  ;;; buffer-read-sinc -- band-limited read at a position in buffer lengths.
  ;;;
  ;;; Windowed-sinc interpolation: the sum of the 32 samples around the read
  ;;; point (16 each side, wrapping), each weighted by sinc(distance) times a
  ;;; Kaiser window (beta = 10), normalized so a constant buffer reads back
  ;;; exactly. It reconstructs the signal the samples came from across nearly
  ;;; the whole band: on a sine of up to 0.4 cycles per sample (19.2 kHz at
  ;;; 48 kHz) it is within 1e-5, where linear and cubic reads are off by more
  ;;; than a third of the amplitude. On a sample it returns that sample. Each
  ;;; read costs roughly 20 times a `buffer-read`.
  ;;;
  ;;; It interpolates; it does not filter. Scanned faster than one sample per
  ;;; sample period, a buffer still aliases whatever it holds above the new
  ;;; Nyquist frequency. NaN or infinite positions read sample 0.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer
  ;;;   pos -- read position; wraps, so any float is valid
  ;;;
  ;;; Returns:
  ;;;   The interpolated sample.
  ;;;
  ;;; Example:
  ;;;   (buffer-read-sinc buf 0.5)    ;; the middle of the buffer
  ;;;
  ;;; Since: signal v0.1.0
  (defn buffer-read-sinc [buf : Buffer pos :float] : float
    ```c
    extern double floor(double);
  extern double sin(double);
  extern double sqrt(double);
  int64_t *p = (int64_t *)(intptr_t)buf;
  int64_t len = p[0];
  const double *d = (const double *)(p + 1);
  double x = pos - floor(pos);
  if (!(x >= 0.0 && x < 1.0)) x = 0.0;
  double idx = x * (double)len;
  int64_t i0 = (int64_t)idx;
  if (i0 >= len) i0 = len - 1;
  double f = idx - (double)i0;
  if (f <= 0.0) return d[i0];
  const double pi = 3.14159265358979323846, beta = 10.0;
  /* I0(beta), the Kaiser window's normalizer: the power series of the
     modified Bessel function of the first kind, order 0. */
  double term = 1.0, i0beta = 1.0;
  for (int m = 1; m < 64; m++) {
    term *= (beta * beta / 4.0) / ((double)m * (double)m);
    i0beta += term;
    if (term < 1e-17 * i0beta) break;
  }
  /* sin(pi * (f - k)) is (-1)^k sin(pi * f): one sin for all 32 taps. */
  double sf = sin(pi * f), acc = 0.0, wsum = 0.0;
  for (int k = -15; k <= 16; k++) {
    double dx = f - (double)k;
    double u = dx / 16.0;
    double arg = beta * sqrt(1.0 - u * u);
    double t = 1.0, w = 1.0;
    for (int m = 1; m < 64; m++) {
      t *= (arg * arg / 4.0) / ((double)m * (double)m);
      w += t;
      if (t < 1e-17 * w) break;
    }
    double h = ((k & 1) ? -sf : sf) / (pi * dx) * (w / i0beta);
    int64_t j = (i0 + k) % len;
    if (j < 0) j += len;
    acc += h * d[j];
    wsum += h;
  }
  return acc / wsum;
  ```)
  ;;; __buffer_fill -- write sig(k / sample-rate) into every slot, in order.
  ;;;
  ;;; A `while` loop, not self recursion: a recursive fill is not turned into a
  ;;; loop and overflows the C stack well short of ten seconds of audio.
  (defn __buffer_fill [buf : Buffer
                       ^fat sig : (fn [float] float)
                       sample-rate :float] : Buffer
    (let [n      (buffer-len buf)
          ^mut k 0]
      (while (< k n)
        (buffer-set! buf k (sig (/ (as float k) sample-rate)))
        (set! k (+ k 1)))
      buf))
  ;;; buffer-render -- record `n` samples of a signal into a new buffer.
  ;;;
  ;;; Sample k holds `sig` at t = k / sample-rate, sampled in order from k = 0,
  ;;; so stateful signals (noise, filters, delays) render correctly. A
  ;;; non-positive sample rate is treated as 1.0 (t = k).
  ;;;
  ;;; Parameters:
  ;;;   sample-rate -- the rate to sample `sig` at, in Hz
  ;;;   n           -- length in samples, clamped to [1, 16777216]
  ;;;   sig         -- the signal to record
  ;;;
  ;;; Returns:
  ;;;   A new Buffer.
  ;;;
  ;;; Example:
  ;;;   ;; one cycle of a 1 Hz sine over 2048 samples: a wavetable
  ;;;   (buffer-render 2048.0 2048 ((sine 1.0 0.0) (constant 0.0)))
  (defn buffer-render [sample-rate :float n :int ^fat sig : (fn [float] float)] : Buffer
    (let [buf (buffer-new n)
          sr  (if (> sample-rate 0.0) sample-rate 1.0)]
      (__buffer_fill buf sig sr)))
  ;;; scan -- read a buffer at the position given by the input signal.
  ;;;
  ;;; An SF: apply it to a position signal (in buffer lengths, wrapping) to get
  ;;; the buffer's contents along that path, interpolated. Drive it with a
  ;;; `sawtooth` at f Hz and a one-cycle buffer becomes an f Hz oscillator; with
  ;;; a slow LFO it scrubs.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer to scan
  ;;;
  ;;; Returns:
  ;;;   SF Sample Sample: position -> sample. Stateless.
  ;;;
  ;;; Example:
  ;;;   ((scan table) ((sawtooth 220.0) (constant 0.0)))
  (defn scan [buf : Buffer]
    (let [bv buf]
      (fn [^fat pos : (fn [float] float)]
        (fn [t :float] :float (buffer-read bv (pos t))))))
  ;;; scan-nearest -- `scan` with no interpolation: each position reads the
  ;;; nearest sample (`buffer-read-nearest`).
  ;;;
  ;;; For buffers of discrete values -- steps, note numbers, gates -- and for the
  ;;; deliberately stepped sound of a coarse table.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer to scan
  ;;;
  ;;; Returns:
  ;;;   SF Sample Sample: position -> nearest sample. Stateless.
  ;;;
  ;;; Example:
  ;;;   ((scan-nearest steps) ((sawtooth 2.0) (constant 0.0)))
  ;;;
  ;;; Since: signal v0.1.0
  (defn scan-nearest [buf : Buffer]
    (let [bv buf]
      (fn [^fat pos : (fn [float] float)]
        (fn [t :float] :float (buffer-read-nearest bv (pos t))))))
  ;;; scan-cubic -- `scan` with 4-point cubic Hermite interpolation
  ;;; (`buffer-read-cubic`).
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer to scan
  ;;;
  ;;; Returns:
  ;;;   SF Sample Sample: position -> interpolated sample. Stateless.
  ;;;
  ;;; Example:
  ;;;   ((scan-cubic table) ((sawtooth 220.0) (constant 0.0)))
  ;;;
  ;;; Since: signal v0.1.0
  (defn scan-cubic [buf : Buffer]
    (let [bv buf]
      (fn [^fat pos : (fn [float] float)]
        (fn [t :float] :float (buffer-read-cubic bv (pos t))))))
  ;;; scan-sinc -- `scan` with 32-tap windowed-sinc interpolation
  ;;; (`buffer-read-sinc`).
  ;;;
  ;;; The scan to use when the buffer holds content near the top of the band
  ;;; and is played at or below its recorded speed.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the buffer to scan
  ;;;
  ;;; Returns:
  ;;;   SF Sample Sample: position -> interpolated sample. Stateless.
  ;;;
  ;;; Example:
  ;;;   ((scan-sinc recording) ((sawtooth 1.0) (constant 0.0)))
  ;;;
  ;;; Since: signal v0.1.0
  (defn scan-sinc [buf : Buffer]
    (let [bv buf]
      (fn [^fat pos : (fn [float] float)]
        (fn [t :float] :float (buffer-read-sinc bv (pos t))))))) ;; end defmodule signal/buffer
