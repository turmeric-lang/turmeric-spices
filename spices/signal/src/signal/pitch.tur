;; Signal Processing -- Pitch
;;
;; Conversions between MIDI note numbers and frequencies in Hz, in twelve-tone
;; equal temperament tuned to A4 = 440 Hz = note 69 (so middle C, C4, is note
;; 60 = 261.626 Hz). Note numbers are floats: 60.5 is a quarter tone above
;; middle C, and `ftom` of a frequency between two notes says how far between.
;;
;; Both are plain `:float -> :float` functions, not SFs. Lift one onto a
;; signal with `map-signal`, e.g. a pitch-bend signal in notes turned into a
;; frequency signal for `fm-sine`:
;;
;;   (map-signal mtof note-signal)
(defmodule signal/pitch
  (export mtof ftom)
  ;;; __pitch_exp2 -- 2 raised to `x`.
  ;;;
  ;;; The autolink directive links libm (-lm) for every program that pulls in
  ;;; this module, so exp2/log2 resolve at link time.
  (defn __pitch_exp2 [x :float] :float
    ```c
    /* __tur_autolink__: -lm */
  extern double exp2(double);
  return exp2(x);
  ```)
  ;;; __pitch_log2 -- base-2 logarithm of `x`.
  (defn __pitch_log2 [x :float] :float
    ```c
    extern double log2(double);
  return log2(x);
  ```)
  ;;; mtof -- MIDI note number to frequency in Hz.
  ;;;
  ;;; f = 440 * 2^((m - 69) / 12). Fractional notes are fine: each 1.0 is a
  ;;; semitone, each 12.0 an octave.
  ;;;
  ;;; Parameters:
  ;;;   m -- note number; 69 is A4, 60 is middle C
  ;;;
  ;;; Returns:
  ;;;   The frequency in Hz.
  ;;;
  ;;; Example:
  ;;;   (mtof 69.0)  ; => 440
  ;;;   (mtof 60.0)  ; => 261.626
  ;;;
  ;;; Since: signal v0.1.0
  (defn mtof [m :float] :float (* 4.4e+02 (__pitch_exp2 (/ (- m 69.0) 12.0))))
  ;;; ftom -- frequency in Hz to MIDI note number.
  ;;;
  ;;; m = 69 + 12 * log2(f / 440), the inverse of `mtof`. The result is
  ;;; fractional unless `f` is exactly a tempered pitch: round it for the
  ;;; nearest note, and the remainder is the offset in semitones (times 100 for
  ;;; cents). The frequency must be positive: 0 gives negative infinity and a
  ;;; negative frequency gives NaN.
  ;;;
  ;;; Parameters:
  ;;;   f -- frequency in Hz, > 0
  ;;;
  ;;; Returns:
  ;;;   The note number.
  ;;;
  ;;; Example:
  ;;;   (ftom 440.0)  ; => 69
  ;;;   (ftom 450.0)  ; => 69.3891 (39 cents sharp of A4)
  ;;;
  ;;; Since: signal v0.1.0
  (defn ftom [f :float] :float (+ 69.0 (* 12.0 (__pitch_log2 (/ f 4.4e+02)))))) ;; end defmodule signal/pitch
