(defpackage tur-signal
  :name "tur-signal"
  :version "0.1.0"
  :description "Typed Signal/SF library: oscillators (incl. FM/PM), one-pole/biquad/state-variable/ladder filters, delay/comb/allpass, colored noise, sample buffers and scanning with nearest/linear/cubic/sinc interpolation, MIDI note/Hz conversion, Scala .scl/.kbm tunings, shapers, ADSR envelope, effects-chain composition."
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :exports #map{"signal/core" ["constant"
                               "time-signal"
                               "sample"
                               "map-signal"
                               "pair-signals"]
                "signal/osc" ["sine"
                              "square"
                              "sawtooth"
                              "triangle"
                              "pm-sine"
                              "fm-sine"]
                "signal/hf-osc" ["hf-sawtooth" "hf-square" "hf-triangle"]
                "signal/filter" ["low-pass"
                                 "high-pass"
                                 "one-pole-lp"
                                 "one-pole-hp"
                                 "dc-block"
                                 "biquad"
                                 "biquad-lp"
                                 "biquad-hp"
                                 "biquad-bp"
                                 "biquad-notch"
                                 "biquad-allpass"
                                 "biquad-peak"
                                 "biquad-low-shelf"
                                 "biquad-high-shelf"
                                 "svf-lp"
                                 "svf-hp"
                                 "svf-bp"
                                 "svf-notch"
                                 "ladder"]
                "signal/buffer" ["Buffer"
                                 "buffer-new"
                                 "buffer-render"
                                 "buffer-len"
                                 "buffer-get"
                                 "buffer-set!"
                                 "buffer-read"
                                 "buffer-read-nearest"
                                 "buffer-read-cubic"
                                 "buffer-read-sinc"
                                 "scan"
                                 "scan-nearest"
                                 "scan-cubic"
                                 "scan-sinc"]
                "signal/pitch" ["mtof" "ftom"]
                "signal/tuning" ["Pitch"
                                 "Cents"
                                 "Ratio"
                                 "MapEntry"
                                 "Degree"
                                 "Unmapped"
                                 "Scale"
                                 "Keymap"
                                 "Tuning"
                                 "scale-new"
                                 "scale-edo"
                                 "scale-size"
                                 "scale-description"
                                 "scale-pitch"
                                 "scale-cents"
                                 "scale-period"
                                 "scl-parse"
                                 "scl-load"
                                 "scale->scl"
                                 "keymap-linear"
                                 "keymap-new"
                                 "keymap-size"
                                 "keymap-first"
                                 "keymap-last"
                                 "keymap-middle"
                                 "keymap-reference"
                                 "keymap-frequency"
                                 "keymap-octave-degree"
                                 "keymap-entries"
                                 "kbm-parse"
                                 "kbm-load"
                                 "keymap->kbm"
                                 "tuning-new"
                                 "tuning-scale"
                                 "tuning-keymap"
                                 "tuning-mapped?"
                                 "mtof-tuned"
                                 "ftom-tuned"]
                "signal/delay" ["delay-n"
                                "delay"
                                "comb-ff-n"
                                "comb-ff"
                                "comb-n"
                                "comb"
                                "allpass-n"
                                "allpass"]
                "signal/noise" ["rng"
                                "white"
                                "pink"
                                "brown"
                                "blue"
                                "violet"
                                "white-from"
                                "pink-from"
                                "brown-from"
                                "blue-from"
                                "violet-from"]
                "signal/shaper" ["gain"
                                 "offset"
                                 "invert"
                                 "abs-sf"
                                 "scale"
                                 "saturate-tanh"
                                 "hard-clip"
                                 "clip"
                                 "mix"
                                 "add"
                                 "multiply"]
                "signal/envelope" ["ADSRParams" "adsr-fixed" "adsr-gen"]
                "signal/compose" ["effects-chain"]})
