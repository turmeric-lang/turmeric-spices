;; tests/frame/string_test.tur -- frame->string owned-String renderer.
;;
;; frame->string renders the same table as frame->str but returns an owned
;; String the caller releases (rather than a malloc'd cstr the caller frees).
(defmodule frame/tests/string
  (import frame/type :refer [type-int32])
  (import frame/column :refer [column-int32])
  (import frame/schema :refer [field schema])
  (import frame/frame :refer [frame])
  (import frame/print :refer [frame->string])
  (import frame/ownstr :refer [String to-cstr release str-len])
  (import test/assert :refer [assert-true])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  (defn t-nil [] : int ```c return 0; ```)
  (defn t-cons [v : int n : int] : int
    ```c
    #include <stdlib.h>
    #include <stdint.h>
    struct __cons { int64_t value; int64_t next; };
    struct __cons *c = (struct __cons *)malloc(sizeof(*c));
    if (!c) return 0;
    c->value = v; c->next = n;
    return (int64_t)(intptr_t)c;
    ```)
  (defn contains? [hay : cstr needle : cstr] : bool
    ```c
    #include <string.h>
    return strstr((const char *)(intptr_t)hay, (const char *)(intptr_t)needle) != 0;
    ```)
  ;; build a 1-column (id : int32) frame with rows 7, 42.
  (defn mk-frame [] : int
    (frame (schema (t-cons (field "id" (type-int32) 0) (t-nil)))
      (t-cons (column-int32 (t-cons 7 (t-cons 42 (t-nil))) 0 0) (t-nil))))
  ;; render to owned String, check it mentions the column name, then release.
  (defn renders-header? [] : bool
    (let [f (mk-frame)
          s (frame->string f)
          r (contains? (to-cstr s) "id")]
      (do (release s) r)))
  ;; render to owned String, check it is non-empty, then release.
  (defn renders-nonempty? [] : bool
    (let [f (mk-frame)
          s (frame->string f)
          r (> (str-len s) 0)]
      (do (release s) r)))
  (defn main [] : int
    (do
      (describe "frame/print frame->string"
        (it "returns an owned String naming the column"
          (assert-true (renders-header?)))
        (it "returns a non-empty owned String"
          (assert-true (renders-nonempty?))))
      (run-all-status)))) ;; end module
