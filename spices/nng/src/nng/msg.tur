;;; nng/msg -- blocking send and receive over an nng socket.
;;;
;;; Two payload shapes, one ownership model. `send-str` / `recv-str` are the
;;; convenience path for text: the payload must not contain NUL bytes, because
;;; a cstr cannot represent one. `send-payload` / `recv-payload` are the real path --
;;; `Payload` is a length-prefixed byte string, so msgpack, protobuf, or any other
;;; binary encoding crosses intact.
;;;
;;; Ownership never involves nng's allocator. A receive asks nng for the
;;; message with NNG_FLAG_ALLOC, copies it into a malloc'd cstr or Payload, and
;;; calls `nng_free` before returning -- so every value handed back is an
;;; ordinary heap block the caller releases the ordinary way. A send copies
;;; into nng and leaves the caller owning what it passed in.
;;;
;;; The send-* / recv-* calls block. On a socket with no receive timeout set, a
;;; receive with nothing to receive parks forever; `set-recv-timeout-ms`
;;; (nng/socket) turns that into an `err` carrying NNG_ETIMEDOUT. Set one on
;;; anything that might not get an answer. The try-* calls never block: they
;;; are what an event loop uses, together with the poll fds in nng/socket.
;;;
;;; Since: Phase NG2
;; Blocking message send/receive for nng sockets.

(defmodule nng/msg
  (import nng/socket :refer [Socket])
  (import nng/payload    :refer [Payload])
  (export send-str recv-str
          send-payload recv-payload
          try-send-str try-recv-str
          try-send-payload try-recv-payload
          sub-subscribe sub-unsubscribe)

;; -------------------------------------------------------------------------
;; Text payloads
;; -------------------------------------------------------------------------

;;; send-str -- send a NUL-terminated string as one message.
;;;
;;; Blocks until nng accepts the message (or the send timeout fires). The
;;; terminator is not transmitted: the peer receives exactly strlen(msg) bytes.
;;;
;;; Parameters:
;;;   s   -- the socket (borrowed)
;;;   msg -- the payload (borrowed; the caller keeps ownership)
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (send-str s "job:42")
;;;
;;; Since: Phase NG2
(defn send-str [^borrow s : Socket msg : cstr] #fx{Net} : (Result nil int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  const char *p = (const char *)msg;
  if (p == NULL) p = "";
  /* nng copies the payload when NNG_FLAG_ALLOC is absent, so the cast away
   * from const is nng's ABI shape, not a mutation: `msg` is untouched. */
  int rv = nng_send(sk, (void *)(uintptr_t)p, strlen(p), 0);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

;;; recv-str -- receive one message as a malloc'd cstr; the caller frees it.
;;;
;;; Blocks until a message arrives, or until the receive timeout fires -- then
;;; the result is `err` carrying NNG_ETIMEDOUT, which `timed-out?` recognises.
;;;
;;; The payload must not contain NUL bytes: this adds a terminator, so a
;;; payload with an interior NUL reads back truncated. Use `recv-payload` for
;;; binary payloads.
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;
;;; Returns:
;;;   (Result cstr int) -- ok carries a fresh malloc'd string; err carries the
;;;   nng error code.
;;;
;;; Example:
;;;   (let [r (recv-str s)]
;;;     (if (ok? r) (println (ok-val r)) (println (err-str (err-val r)))))
;;;
;;; Since: Phase NG2
(defn recv-str [^borrow s : Socket] #fx{Net} : (Result cstr int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  void  *data = NULL;
  size_t len  = 0;
  int rv = nng_recv(sk, &data, &len, NNG_FLAG_ALLOC);
  if (rv != 0) return tur_err_int((int64_t)rv);
  char *out = (char *)malloc(len + 1);
  if (out == NULL) { nng_free(data, len); return tur_err_int((int64_t)NNG_ENOMEM); }
  if (len > 0) memcpy(out, data, len);
  out[len] = '\0';
  /* Release nng's allocation here, so no nng-owned memory ever reaches
   * Turmeric code and there is exactly one free discipline in the spice. */
  nng_free(data, len);
  return tur_ok_ptr(out);
  ```)

;; -------------------------------------------------------------------------
;; Binary payloads
;; -------------------------------------------------------------------------

;;; send-payload -- send a byte buffer as one message.
;;;
;;; Blocks until nng accepts the message (or the send timeout fires).
;;;
;;; BORROWS the payload: nng copies the bytes, so `b` is still the caller's to
;;; use and to `payload-free` afterwards. Sending does not consume it.
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;   b -- the payload (borrowed)
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [b (payload-of-cstr "job:42")]
;;;     (send-payload s b)
;;;     (payload-free b))
;;;
;;; Since: Phase NG2
(defn send-payload [^borrow s : Socket b : Payload] #fx{Net} : (Result nil int)
  ```c
  #include <nng/nng.h>
  extern int64_t turnng_payload_len(const void *);
  extern void   *turnng_payload_data(void *);
  nng_socket sk;
  sk.id = (uint32_t)s;
  void   *data = turnng_payload_data((void *)(intptr_t)b);
  size_t  len  = (size_t)turnng_payload_len((const void *)(intptr_t)b);
  /* A zero-length message is legal in nng and several protocols use one as a
   * heartbeat, so an empty Payload is sent rather than rejected. */
  if (data == NULL) { data = (void *)""; len = 0; }
  int rv = nng_send(sk, data, len, 0);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

;;; recv-payload -- receive one message as an owned Payload; the caller frees it.
;;;
;;; Blocks until a message arrives, or until the receive timeout fires -- then
;;; the result is `err` carrying NNG_ETIMEDOUT.
;;;
;;; The binary-safe receive: the payload's length comes from nng, so embedded
;;; NUL bytes survive.
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;
;;; Returns:
;;;   (Result Payload int) -- ok carries a fresh owned Payload; release it with
;;;   `payload-free`. err carries the nng error code.
;;;
;;; Example:
;;;   (let [r (recv-payload s)]
;;;     (when (ok? r)
;;;       (let [b (ok-val r)]
;;;         (println (payload->hex b))
;;;         (payload-free b))))
;;;
;;; Since: Phase NG2
(defn recv-payload [^borrow s : Socket] #fx{Net} : (Result Payload int)
  ```c
  #include <nng/nng.h>
  extern void *turnng_payload_of_bytes(const void *, int64_t);
  nng_socket sk;
  sk.id = (uint32_t)s;
  void  *data = NULL;
  size_t len  = 0;
  int rv = nng_recv(sk, &data, &len, NNG_FLAG_ALLOC);
  if (rv != 0) return tur_err_int((int64_t)rv);
  void *out = turnng_payload_of_bytes(data ? data : "", (int64_t)len);
  nng_free(data, len);
  if (out == NULL) return tur_err_int((int64_t)NNG_ENOMEM);
  return tur_ok_ptr(out);
  ```)

;; -------------------------------------------------------------------------
;; Non-blocking send / receive
;;
;; The event-loop companions of recv-poll-fd / send-poll-fd (nng/socket).
;; Each passes NNG_FLAG_NONBLOCK, so it never parks the calling thread -- the
;; property a reactor callback needs, since a blocking call there parks the
;; whole loop if another consumer won the race. "Nothing ready" (nng's
;; NNG_EAGAIN) is an ok result, not an err, so the caller never has to learn
;; that code; every other failure is still an err.
;; -------------------------------------------------------------------------

;;; try-recv-str -- receive one message if one is waiting; never blocks.
;;;
;;; The non-blocking recv-str. The payload must not contain NUL bytes (see
;;; recv-str); use try-recv-payload for binary payloads.
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;
;;; Returns:
;;;   (Result (Option cstr) int) -- (ok (some m)) a fresh malloc'd string the
;;;   caller frees; (ok (none)) nothing is waiting; (err code) any other
;;;   failure, e.g. NNG_ENOTSUP on a socket that cannot receive.
;;;
;;; Example:
;;;   (match (ok-val (try-recv-str s))
;;;     (Some m) (handle m)
;;;     (None)   (println "nothing yet"))
;;;
;;; Since: Phase NG-A
(defn try-recv-str [^borrow s : Socket] #fx{Net} : (Result (Option cstr) int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  void  *data = NULL;
  size_t len  = 0;
  int rv = nng_recv(sk, &data, &len, NNG_FLAG_ALLOC | NNG_FLAG_NONBLOCK);
  if (rv == NNG_EAGAIN) return tur_ok_int(tur_none());
  if (rv != 0) return tur_err_int((int64_t)rv);
  char *out = (char *)malloc(len + 1);
  if (out == NULL) { nng_free(data, len); return tur_err_int((int64_t)NNG_ENOMEM); }
  if (len > 0) memcpy(out, data, len);
  out[len] = '\0';
  nng_free(data, len);
  return tur_ok_int(tur_some_ptr(out));
  ```)

;;; try-recv-payload -- receive one binary message if one is waiting.
;;;
;;; The non-blocking recv-payload: the payload's length comes from nng, so
;;; embedded NUL bytes survive.
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;
;;; Returns:
;;;   (Result (Option Payload) int) -- (ok (some b)) a fresh owned Payload the
;;;   caller releases with payload-free; (ok (none)) nothing is waiting;
;;;   (err code) any other failure.
;;;
;;; Example:
;;;   (match (ok-val (try-recv-payload s))
;;;     (Some b) (do (handle b) (payload-free b))
;;;     (None)   nil)
;;;
;;; Since: Phase NG-A
(defn try-recv-payload [^borrow s : Socket] #fx{Net} : (Result (Option Payload) int)
  ```c
  #include <nng/nng.h>
  extern void *turnng_payload_of_bytes(const void *, int64_t);
  nng_socket sk;
  sk.id = (uint32_t)s;
  void  *data = NULL;
  size_t len  = 0;
  int rv = nng_recv(sk, &data, &len, NNG_FLAG_ALLOC | NNG_FLAG_NONBLOCK);
  if (rv == NNG_EAGAIN) return tur_ok_int(tur_none());
  if (rv != 0) return tur_err_int((int64_t)rv);
  void *out = turnng_payload_of_bytes(data ? data : "", (int64_t)len);
  nng_free(data, len);
  if (out == NULL) return tur_err_int((int64_t)NNG_ENOMEM);
  return tur_ok_int(tur_some_ptr(out));
  ```)

;;; try-send-str -- send a string if the socket can take it now; never blocks.
;;;
;;; The non-blocking send-str. BORROWS msg, as send-str does.
;;;
;;; Parameters:
;;;   s   -- the socket (borrowed)
;;;   msg -- the payload (borrowed)
;;;
;;; Returns:
;;;   (Result bool int) -- (ok true) sent; (ok false) the send would block (no
;;;   peer ready, or its queue is full) and nothing was sent; (err code) any
;;;   other failure, e.g. NNG_ENOTSUP on a socket that cannot send.
;;;
;;; Example:
;;;   (when (not (ok-val (try-send-str s "job:42")))
;;;     (retry-later))
;;;
;;; Since: Phase NG-A
(defn try-send-str [^borrow s : Socket msg : cstr] #fx{Net} : (Result bool int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  const char *p = (const char *)msg;
  if (p == NULL) p = "";
  int rv = nng_send(sk, (void *)(uintptr_t)p, strlen(p), NNG_FLAG_NONBLOCK);
  if (rv == NNG_EAGAIN) return tur_ok_int(0);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(1);
  ```)

;;; try-send-payload -- send a byte buffer if the socket can take it now.
;;;
;;; The non-blocking send-payload. BORROWS the payload, as send-payload does.
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;   b -- the payload (borrowed)
;;;
;;; Returns:
;;;   (Result bool int) -- (ok true) sent; (ok false) the send would block and
;;;   nothing was sent; (err code) any other failure.
;;;
;;; Example:
;;;   (let [b (payload-of-cstr "job:42")]
;;;     (try-send-payload s b)
;;;     (payload-free b))
;;;
;;; Since: Phase NG-A
(defn try-send-payload [^borrow s : Socket b : Payload] #fx{Net} : (Result bool int)
  ```c
  #include <nng/nng.h>
  extern int64_t turnng_payload_len(const void *);
  extern void   *turnng_payload_data(void *);
  nng_socket sk;
  sk.id = (uint32_t)s;
  void   *data = turnng_payload_data((void *)(intptr_t)b);
  size_t  len  = (size_t)turnng_payload_len((const void *)(intptr_t)b);
  if (data == NULL) { data = (void *)""; len = 0; }
  int rv = nng_send(sk, data, len, NNG_FLAG_NONBLOCK);
  if (rv == NNG_EAGAIN) return tur_ok_int(0);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(1);
  ```)

;; -------------------------------------------------------------------------
;; Subscription filters
;; -------------------------------------------------------------------------

;;; sub-subscribe -- add a topic prefix filter to a SUB socket.
;;;
;;; Filtering is by raw byte PREFIX, not by a topic namespace: subscribing to
;;; "temp" also matches "temperature". A SUB socket with no subscription
;;; receives nothing at all, so this is not optional -- subscribe to "" to take
;;; everything.
;;;
;;; Parameters:
;;;   s     -- the socket (borrowed); must be a SUB socket, or the result is
;;;            `err` carrying NNG_ENOTSUP. v0 ships one `Socket` type, so that
;;;            is a runtime error rather than a compile-time one.
;;;   topic -- the byte prefix to accept; "" accepts every message
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (sub-subscribe s "temp:")
;;;
;;; Since: Phase NG3
(defn sub-subscribe [^borrow s : Socket topic : cstr] : (Result nil int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/pubsub0/sub.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  const char *p = (const char *)topic;
  if (p == NULL) p = "";
  int rv = nng_sub0_socket_subscribe(sk, p, strlen(p));
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

;;; sub-unsubscribe -- drop a topic prefix filter from a SUB socket.
;;;
;;; The topic must match a subscription added earlier byte for byte; anything
;;; else is `err` carrying NNG_ENOENT.
;;;
;;; Parameters:
;;;   s     -- the socket (borrowed); must be a SUB socket
;;;   topic -- the exact prefix passed to `sub-subscribe`
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (sub-unsubscribe s "temp:")
;;;
;;; Since: Phase NG3
(defn sub-unsubscribe [^borrow s : Socket topic : cstr] : (Result nil int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/pubsub0/sub.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  const char *p = (const char *)topic;
  if (p == NULL) p = "";
  int rv = nng_sub0_socket_unsubscribe(sk, p, strlen(p));
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

) ;; end defmodule nng/msg
