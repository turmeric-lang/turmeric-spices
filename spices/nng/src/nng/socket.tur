;;; nng/socket -- socket lifecycle for nng (nanomsg-next-generation).
;;;
;;; One `Socket` handle covers all ten scalability protocols; the protocol is
;;; chosen by which constructor opens it. Every constructor returns a
;;; `(Result Socket int)` whose err side carries the raw nng error code --
;;; pass it to `err-str` for a readable message.
;;;
;;; `Socket` is `:linear`: a socket extracted with stdlib `ok-val` must be
;;; consumed exactly once, by `close`. Every other operation borrows it. Under
;;; -Xsubstructural that makes double-close, use-after-close, and a socket that
;;; is never closed compile-time errors (TUR-E0101 / TUR-E0100); the discipline
;;; is inert in ordinary builds. See errors/ for the three fixtures.
;;;
;;; nng runs its own internal worker threads and poller, so a blocking call
;;; here parks only the CALLING thread -- nng's internals keep running. That is
;;; what makes the blocking-only v0 surface workable: concurrent patterns (a
;;; rep server on one thread, a req client on another) use stdlib/thread.tur.
;;;
;;; Set a receive timeout on anything that might not get an answer.
;;; `set-recv-timeout-ms` turns an indefinite park into an `err` carrying
;;; NNG_ETIMEDOUT, which `timed-out?` recognises.
;;;
;;; Since: Phase NG1
;; Socket lifecycle for the nng scalability protocols.

(defmodule nng/socket
  (export Socket
          req-open rep-open pub-open sub-open
          push-open pull-open pair-open bus-open
          surveyor-open respondent-open
          dial listen close
          set-recv-timeout-ms set-send-timeout-ms
          err-str timed-out?
          PollFd poll-fd->int recv-poll-fd send-poll-fd)

;;; Socket -- a linear handle to an open nng socket.
;;;
;;; `nng_socket` is a by-value struct wrapping a `uint32_t` id, so the opaque
;;; carries that id in its int64 and each inline-C body reconstitutes
;;; `nng_socket sk; sk.id = (uint32_t)s;` at the call boundary. Nothing here
;;; holds a pointer into nng's allocator.
;;;
;;; Since: Phase NG1
(defopaque Socket :int :linear)

;; -------------------------------------------------------------------------
;; Protocol constructors
;;
;; Ten one-liners over nng's per-protocol open calls. All ten ship in v0
;; because each costs three lines and omitting one only makes a caller
;; reach past the spice.
;; -------------------------------------------------------------------------

;;; req-open -- open a REQ (request) socket.
;;;
;;; The client half of request/reply: send a request, then receive exactly one
;;; reply. nng resends the request automatically if the reply does not arrive.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (req-open))]
;;;     (dial s "inproc://demo")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn req-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/reqrep0/req.h>
  nng_socket s;
  int rv = nng_req0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; rep-open -- open a REP (reply) socket.
;;;
;;; The service half of request/reply: receive a request, then send exactly one
;;; reply back to whoever asked.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (rep-open))]
;;;     (listen s "inproc://demo")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn rep-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/reqrep0/rep.h>
  nng_socket s;
  int rv = nng_rep0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; pub-open -- open a PUB (publish) socket.
;;;
;;; Send-only. Every message goes to every subscriber whose topic filter
;;; matches; subscribers that are not connected yet simply miss it.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (pub-open))]
;;;     (listen s "inproc://feed")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn pub-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/pubsub0/pub.h>
  nng_socket s;
  int rv = nng_pub0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; sub-open -- open a SUB (subscribe) socket.
;;;
;;; Receive-only, and silent until it has at least one subscription: call
;;; `sub-subscribe` (from nng/msg) before the first receive, with "" to take
;;; everything.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (sub-open))]
;;;     (dial s "inproc://feed")
;;;     (sub-subscribe s "")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn sub-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/pubsub0/sub.h>
  nng_socket s;
  int rv = nng_sub0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; push-open -- open a PUSH (pipeline producer) socket.
;;;
;;; Send-only, load-balanced: each message goes to exactly one connected PULL
;;; peer, round-robin. The job-queue producer.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (push-open))]
;;;     (listen s "inproc://jobs")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn push-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/pipeline0/push.h>
  nng_socket s;
  int rv = nng_push0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; pull-open -- open a PULL (pipeline consumer) socket.
;;;
;;; Receive-only. The worker end of a PUSH/PULL job queue; several PULL peers
;;; on one PUSH share the work.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (pull-open))]
;;;     (dial s "inproc://jobs")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn pull-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/pipeline0/pull.h>
  nng_socket s;
  int rv = nng_pull0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; pair-open -- open a PAIR (one-to-one) socket, protocol version 1.
;;;
;;; Bidirectional, exactly two peers, no request/reply turn-taking. pair1
;;; rather than pair0 because pair1 is the maintained protocol; its
;;; polyamorous mode stays off.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (pair-open))]
;;;     (listen s "inproc://link")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn pair-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/pair1/pair.h>
  nng_socket s;
  int rv = nng_pair1_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; bus-open -- open a BUS (many-to-many broadcast) socket.
;;;
;;; Every message sent goes to every directly connected peer, and is NOT
;;; forwarded on by them -- a bus is one hop, not a mesh router.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (bus-open))]
;;;     (listen s "inproc://bus")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn bus-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/bus0/bus.h>
  nng_socket s;
  int rv = nng_bus0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; surveyor-open -- open a SURVEYOR socket.
;;;
;;; Broadcasts one question to every respondent and collects answers until the
;;; survey deadline expires; the receive that follows the deadline returns
;;; NNG_ETIMEDOUT (which `timed-out?` recognises) rather than an error.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (surveyor-open))]
;;;     (listen s "inproc://survey")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn surveyor-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/survey0/survey.h>
  nng_socket s;
  int rv = nng_surveyor0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;;; respondent-open -- open a RESPONDENT socket.
;;;
;;; The other half of survey: receive a question, send one answer back.
;;;
;;; Returns:
;;;   (Result Socket int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (let [s (ok-val (respondent-open))]
;;;     (dial s "inproc://survey")
;;;     (close s))
;;;
;;; Since: Phase NG1
(defn respondent-open [] : (Result Socket int)
  ```c
  #include <nng/nng.h>
  #include <nng/protocol/survey0/respond.h>
  nng_socket s;
  int rv = nng_respondent0_open(&s);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)s.id);
  ```)

;; -------------------------------------------------------------------------
;; Endpoints
;; -------------------------------------------------------------------------

;;; dial -- connect the socket to a remote address.
;;;
;;; The dialing side is the one that retries: if nothing is listening yet, nng
;;; reconnects in the background rather than failing, so the usual startup
;;; order (listener first) is a convention, not a requirement.
;;;
;;; No dialer handle is returned in v0 -- this is nng's convenience form, which
;;; ties the dialer's lifetime to the socket's.
;;;
;;; Parameters:
;;;   s   -- the socket (borrowed)
;;;   url -- e.g. "inproc://jobs", "ipc:///tmp/x.sock", "tcp://host:5555"
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (dial s "inproc://jobs")
;;;
;;; Since: Phase NG1
(defn dial [^borrow s : Socket url : cstr] #fx{Net} : (Result nil int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  int rv = nng_dial(sk, (const char *)url, NULL, 0);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

;;; listen -- bind the socket to a local address.
;;;
;;; Fails immediately if the address is already in use (NNG_EADDRINUSE), which
;;; is why two tests sharing one process must use distinct `inproc://` names.
;;;
;;; No listener handle is returned in v0 -- this is nng's convenience form,
;;; which ties the listener's lifetime to the socket's.
;;;
;;; Parameters:
;;;   s   -- the socket (borrowed)
;;;   url -- e.g. "inproc://jobs", "ipc:///tmp/x.sock", "tcp://0.0.0.0:5555"
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (listen s "inproc://jobs")
;;;
;;; Since: Phase NG1
(defn listen [^borrow s : Socket url : cstr] #fx{Net} : (Result nil int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  int rv = nng_listen(sk, (const char *)url, NULL, 0);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

;;; close -- close the socket. The single linear consumer.
;;;
;;; Closing terminates every dialer and listener the socket owns and wakes any
;;; blocked send or receive on it with NNG_ECLOSED.
;;;
;;; Parameters:
;;;   s -- the socket, consumed. This is its one legal consumption, so any
;;;        later use of the handle is rejected under -Xsubstructural.
;;;
;;; Example:
;;;   (close s)
;;;
;;; Since: Phase NG1
(defn close [s : Socket] : nil
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  nng_close(sk);
  ```)

;; -------------------------------------------------------------------------
;; Timeouts
;; -------------------------------------------------------------------------

;;; set-recv-timeout-ms -- bound how long a receive may block.
;;;
;;; Without this a receive on a quiet socket parks forever. With it, the
;;; receive returns `err` carrying NNG_ETIMEDOUT once `ms` elapses -- which is
;;; what keeps a test suite from hanging. A negative value restores the
;;; infinite default.
;;;
;;; Parameters:
;;;   s  -- the socket (borrowed)
;;;   ms -- milliseconds, or a negative value for "wait forever"
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (set-recv-timeout-ms s 100)
;;;
;;; Since: Phase NG1
(defn set-recv-timeout-ms [^borrow s : Socket ms : int] : (Result nil int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  int rv = nng_socket_set_ms(sk, NNG_OPT_RECVTIMEO, (nng_duration)ms);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

;;; set-send-timeout-ms -- bound how long a send may block.
;;;
;;; A send blocks when the peer's queue is full (or, for REQ, while a reply is
;;; outstanding). A negative value restores the infinite default.
;;;
;;; Parameters:
;;;   s  -- the socket (borrowed)
;;;   ms -- milliseconds, or a negative value for "wait forever"
;;;
;;; Returns:
;;;   (Result nil int) -- err carries the nng error code.
;;;
;;; Example:
;;;   (set-send-timeout-ms s 100)
;;;
;;; Since: Phase NG1
(defn set-send-timeout-ms [^borrow s : Socket ms : int] : (Result nil int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  int rv = nng_socket_set_ms(sk, NNG_OPT_SENDTIMEO, (nng_duration)ms);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int(0);
  ```)

;; -------------------------------------------------------------------------
;; Errors
;; -------------------------------------------------------------------------

;;; err-str -- human-readable message for an nng error code.
;;;
;;; The string is nng's own static storage: read it, print it, but do not free
;;; it and do not hold it past the message you build from it.
;;;
;;; Parameters:
;;;   code -- the int an err result carries
;;;
;;; Returns:
;;;   cstr -- e.g. "Timed out", "Connection refused".
;;;
;;; Example:
;;;   (println (err-str (err-val r)))
;;;
;;; Since: Phase NG1
(defn err-str [code : int] : cstr
  ```c
  #include <nng/nng.h>
  return (char *)nng_strerror((int)code);
  ```)

;;; timed-out? -- does this error code mean the deadline expired?
;;;
;;; The one error code a caller routinely branches on rather than reports: a
;;; polling receive treats it as "nothing yet", not as a failure.
;;;
;;; Parameters:
;;;   code -- the int an err result carries
;;;
;;; Returns:
;;;   bool -- true for NNG_ETIMEDOUT.
;;;
;;; Example:
;;;   (if (timed-out? (err-val r)) (retry) (report r))
;;;
;;; Since: Phase NG1
(defn timed-out? [code : int] : bool
  ```c
  #include <nng/nng.h>
  return ((int)code == NNG_ETIMEDOUT) ? true : false;
  ```)

;; -------------------------------------------------------------------------
;; Poll fds (event-loop integration)
;;
;; nng hands out the read end of a pipe it raises when the socket becomes
;; ready and clears when it drains. Register it with a reactor or a fiber
;; park for READ -- both the receive fd and the send fd signal by becoming
;; READABLE -- and then move messages with the non-blocking try-* calls in
;; nng/msg. See docs/upcoming/spices/nng-async-plan.md (turmeric repo), NG-A.
;; -------------------------------------------------------------------------

;;; PollFd -- a file descriptor that may only be polled.
;;;
;;; Owned by nng and alive as long as the socket that produced it. Reading,
;;; writing or closing it corrupts nng's readiness state, which is why it is
;;; its own type rather than an :int or a stdlib Fd: nothing here offers a
;;; read or a close. `poll-fd->int` is the one explicit step to the plain fd a
;;; reactor or fiber-park call takes.
;;;
;;; Since: Phase NG-A
(defopaque PollFd :int)

;;; poll-fd->int -- the raw descriptor, for reactor-add-fd / local-park-fd.
;;;
;;; Parameters:
;;;   fd -- the poll fd
;;;
;;; Returns:
;;;   int -- the descriptor number. Poll it; never read, write or close it.
;;;
;;; Example:
;;;   (reactor-add-fd r (poll-fd->int (ok-val (recv-poll-fd s))) READ cb ud)
;;;
;;; Since: Phase NG-A
(defn poll-fd->int [fd : PollFd] : int (:: fd :int))

;;; recv-poll-fd -- an fd that is readable while a message is waiting.
;;;
;;; Becomes readable when the socket has a message to receive and stops being
;;; readable once the queue drains. On macOS the reactor reports it edge-style
;;; (kqueue EV_CLEAR), so a callback must drain with try-recv-* until it
;;; returns (ok (none)) -- reading one message per wakeup stalls there.
;;;
;;; Not compatible with nng contexts on the same socket (nng_ctx.5).
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;
;;; Returns:
;;;   (Result PollFd int) -- err carries NNG_ENOTSUP on a protocol that cannot
;;;   receive (PUB, PUSH), or another nng error code.
;;;
;;; Example:
;;;   (let [fd (ok-val (recv-poll-fd sub))]
;;;     (reactor-add-fd r (poll-fd->int fd) READ drain-cb ud))
;;;
;;; Since: Phase NG-A
(defn recv-poll-fd [^borrow s : Socket] : (Result PollFd int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  int fd = -1;
  int rv = nng_socket_get_int(sk, NNG_OPT_RECVFD, &fd);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)fd);
  ```)

;;; send-poll-fd -- an fd that is READABLE while a send would not block.
;;;
;;; Readable, not writable: nng signals both directions through the read end
;;; of its pipe, so register it for READ. The same drain rule as recv-poll-fd
;;; applies on macOS -- send with try-send-* until it returns (ok false).
;;;
;;; Parameters:
;;;   s -- the socket (borrowed)
;;;
;;; Returns:
;;;   (Result PollFd int) -- err carries NNG_ENOTSUP on a protocol that cannot
;;;   send (SUB, PULL), or another nng error code.
;;;
;;; Example:
;;;   (let [fd (ok-val (send-poll-fd push))]
;;;     (reactor-add-fd r (poll-fd->int fd) READ flush-cb ud))
;;;
;;; Since: Phase NG-A
(defn send-poll-fd [^borrow s : Socket] : (Result PollFd int)
  ```c
  #include <nng/nng.h>
  nng_socket sk;
  sk.id = (uint32_t)s;
  int fd = -1;
  int rv = nng_socket_get_int(sk, NNG_OPT_SENDFD, &fd);
  if (rv != 0) return tur_err_int((int64_t)rv);
  return tur_ok_int((int64_t)fd);
  ```)

) ;; end defmodule nng/socket
