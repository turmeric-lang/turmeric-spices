;; Negative fixture: an Aio owns its nng_aio and possibly a completion pipe, so
;; allocating one and walking away must be rejected.
;;
;; Verify: tur check errors/nng-aio-leak-no-free.tur
;;   => error [TUR-E0100]: linear value 'a' dropped without being consumed
;;
;; Compile-FAIL fixture (see nng-double-close.tur for the placement note).

(defmodule nng_aio_leak_no_free_test
  (export)

(import nng/aio :refer [Aio aio-alloc aio-set-timeout])

(defn leak-no-free [] : int
  (let [a (ok-val (aio-alloc))]   ;; ERROR TUR-E0100: never consumed
    (do
      (aio-set-timeout a 10)
      0)))

) ;; end defmodule nng_aio_leak_no_free_test
