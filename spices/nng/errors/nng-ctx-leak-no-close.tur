;; Negative fixture: a context holds protocol state on its socket until it is
;; closed, so opening one and walking away must be rejected.
;;
;; Verify: tur check errors/nng-ctx-leak-no-close.tur
;;   => error [TUR-E0100]: linear value 'c' dropped without being consumed
;;
;; Compile-FAIL fixture (see nng-double-close.tur for the placement note).

(defmodule nng_ctx_leak_no_close_test
  (export)

(import nng/socket :refer [Socket rep-open close])
(import nng/ctx    :refer [NngCtx ctx-open ctx-set-recv-timeout-ms])

(defn leak-no-close [] : int
  (let [s (ok-val (rep-open))
        c (ok-val (ctx-open s))   ;; ERROR TUR-E0100: never consumed
        r (ctx-set-recv-timeout-ms c 10)]
    (close s)
    (if (ok? r) 1 0)))

) ;; end defmodule nng_ctx_leak_no_close_test
