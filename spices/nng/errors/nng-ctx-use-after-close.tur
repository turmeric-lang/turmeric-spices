;; Negative fixture: receiving on a closed context must be rejected -- its id
;; no longer names a context, so the call can only fail.
;;
;; Verify: tur check errors/nng-ctx-use-after-close.tur
;;   => error [TUR-E0101]: linear value 'c' used after being consumed
;;
;; Compile-FAIL fixture (see nng-double-close.tur for the placement note).

(defmodule nng_ctx_use_after_close_test
  (export)

(import nng/socket :refer [Socket rep-open close])
(import nng/ctx    :refer [NngCtx ctx-open ctx-close ctx-recv-str])

(defn use-after-close [] : int
  (let [s (ok-val (rep-open))
        c (ok-val (ctx-open s))]
    (do
      (ctx-close c)
      (let [r (ctx-recv-str c)]   ;; ERROR TUR-E0101: borrow after the consume
        (close s)
        (if (ok? r) 1 0)))))

) ;; end defmodule nng_ctx_use_after_close_test
