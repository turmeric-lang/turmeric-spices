;; Negative fixture: `close` consumes the :linear Socket, so closing the same
;; socket twice must be rejected.
;;
;; Verify: tur check errors/nng-double-close.tur
;;   => error [TUR-E0101]: linear value 's' used after being consumed
;;
;; Compile-FAIL fixture: it lives in errors/ rather than tests/ because
;; `tur test` recurses and would count a file that must not compile as a suite
;; failure. errors/run.sh asserts it fails for THIS reason and not another.
(defmodule nng_double_close_test
  (export)
  (import nng/socket :refer [Socket pair-open close])
  (defn double-close [] : int
    (let [s (ok-val (pair-open))]
      (do
        (close s) ;; the single legal consumption
        (close s) ;; ERROR TUR-E0101: consume after consume
        0)))) ;; end defmodule nng_double_close_test
