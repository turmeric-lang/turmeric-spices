;; Negative fixture: `aio-free` consumes the :linear Aio, so freeing the same
;; slot twice must be rejected.
;;
;; Verify: tur check errors/nng-aio-double-free.tur
;;   => error [TUR-E0101]: linear value 'a' used after being consumed
;;
;; Compile-FAIL fixture (see nng-double-close.tur for the placement note).

(defmodule nng_aio_double_free_test
  (export)

(import nng/aio :refer [Aio aio-alloc aio-free])

(defn double-free [] : int
  (let [a (ok-val (aio-alloc))]
    (do
      (aio-free a)   ;; the single legal consumption
      (aio-free a)   ;; ERROR TUR-E0101: consume after consume
      0)))

) ;; end defmodule nng_aio_double_free_test
