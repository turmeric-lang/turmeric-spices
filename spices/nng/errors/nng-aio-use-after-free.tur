;; Negative fixture: submitting on a freed Aio must be rejected -- nng_aio_free
;; has released the slot, so the submit would write into freed memory.
;;
;; Verify: tur check errors/nng-aio-use-after-free.tur
;;   => error [TUR-E0101]: linear value 'a' used after being consumed
;;
;; Compile-FAIL fixture (see nng-double-close.tur for the placement note).

(defmodule nng_aio_use_after_free_test
  (export)

(import nng/socket :refer [Socket pull-open close])
(import nng/aio    :refer [Aio aio-alloc aio-free recv-aio])

(defn use-after-free [] : int
  (let [p (ok-val (pull-open))
        a (ok-val (aio-alloc))]
    (do
      (aio-free a)
      (let [r (recv-aio p a)]   ;; ERROR TUR-E0101: borrow after the consume
        (close p)
        (if (ok? r) 1 0)))))

) ;; end defmodule nng_aio_use_after_free_test
