;; Negative fixture: `ctx-close` consumes the :linear NngCtx, so closing the
;; same context twice must be rejected.
;;
;; Verify: tur check errors/nng-ctx-double-close.tur
;;   => error [TUR-E0101]: linear value 'c' used after being consumed
;;
;; Compile-FAIL fixture (see nng-double-close.tur for the placement note).

(defmodule nng_ctx_double_close_test
  (export)

(import nng/socket :refer [Socket rep-open close])
(import nng/ctx    :refer [NngCtx ctx-open ctx-close])

(defn double-close [] : int
  (let [s (ok-val (rep-open))
        c (ok-val (ctx-open s))]
    (do
      (ctx-close c)   ;; the single legal consumption
      (ctx-close c)   ;; ERROR TUR-E0101: consume after consume
      (close s)
      0)))

) ;; end defmodule nng_ctx_double_close_test
