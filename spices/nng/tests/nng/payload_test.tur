;; NG2: the Payload carrier -- alloc / len / byte / equality / cstr round-trip.
;;
;; `it` takes exactly one bool, so each case is a single expression: a `let`
;; that allocates, computes the assertion, frees, and yields the assertion.
(defmodule nng/tests/buf
  (export)
  (import nng/payload
    :refer
    [Payload
     payload-alloc
     payload-len
     payload-data
     payload-free
     payload-byte
     payload-empty?
     payload=?
     payload-of-cstr
     payload->cstr
     payload->hex])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-false assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defn cstr-free [p : cstr] : nil
    ```c
    free((void *)(intptr_t)p);
  ```)
  (defn raw-null? [p : ptr<void>] : bool
    ```c
    return ((const void *)p == NULL) ? true : false;
  ```)
  ;; hex=? -- does `b` render to `expect`? CONSUMES b, so a golden-byte case is
  ;; one line.
  (defn hex=? [b : Payload expect : cstr] : bool
    (let [h (payload->hex b)
          r (cstr-eq? expect h)]
      (cstr-free h)
      (payload-free b)
      r))
  (defn __all-tests [] : void
    (describe "nng Payload -- the owned byte carrier"
      (it "reports the allocated length"
        (let [b (payload-alloc 4)
              r (assert-eq 4 (payload-len b))]
          (payload-free b)
          r))
      (it "allocates zeroed bytes"
        (let [b (payload-alloc 2)
              r (assert-true (and (= 0 (payload-byte b 0))
                               (= 0 (payload-byte b 1))))]
          (payload-free b)
          r))
      (it "excludes the NUL terminator from a cstr's length"
        (let [b (payload-of-cstr "job:42")
              r (assert-eq 6 (payload-len b))]
          (payload-free b)
          r))
      (it "reads bytes back out by index"
        (let [b (payload-of-cstr "A")
              r (assert-true (and (= 65 (payload-byte b 0))
                               (= -1 (payload-byte b 1))))]
          (payload-free b)
          r))
      (it "renders to lowercase hex"
        (assert-true (hex=? (payload-of-cstr "AB") "4142")))
      (it "round-trips cstr -> buf -> cstr"
        (let [b (payload-of-cstr "pong")
              s (payload->cstr b)
              r (assert-true (cstr-eq? "pong" s))]
          (cstr-free s)
          (payload-free b)
          r))
      (it "treats a zero-length buffer as empty"
        (let [b (payload-alloc 0)
              r (assert-true (payload-empty? b))]
          (payload-free b)
          r))
      (it "does not treat a non-empty buffer as empty"
        (let [b (payload-of-cstr "x")
              r (assert-false (payload-empty? b))]
          (payload-free b)
          r))
      (it "compares equal buffers byte-wise"
        (let [a (payload-of-cstr "same")
              b (payload-of-cstr "same")
              r (assert-true (payload=? a b))]
          (payload-free a)
          (payload-free b)
          r))
      (it "distinguishes buffers of different length"
        (let [a (payload-of-cstr "ab")
              b (payload-of-cstr "abc")
              r (assert-false (payload=? a b))]
          (payload-free a)
          (payload-free b)
          r))
      (it "hands back a non-null data pointer"
        (let [b (payload-alloc 1)
              r (assert-true (not (raw-null? (payload-data b))))]
          (payload-free b)
          r))))
  (defn main [] : int (__all-tests) (run-all-status)))
