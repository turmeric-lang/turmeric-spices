;; NG1: socket lifecycle -- the ten protocol constructors, dial/listen over
;; inproc, the timeout setters, and the error helpers.
;;
;; Everything here runs over `inproc://`, so the suite needs no network, no
;; open port, and no external daemon. Each case uses its own inproc name
;; ("inproc://<case>") because a second listen on a live name is
;; NNG_EADDRINUSE, and every socket in this file shares one process.
;;
;; The `:linear` discipline is only enforced under -Xsubstructural, so these
;; ordinary tests close their sockets because leaking an OS resource is bad,
;; not because the compiler is watching. errors/ holds the fixtures that
;; assert the compiler IS watching.
(defmodule nng/tests/socket
  (export)
  (import nng/socket
    :refer
    [Socket
     req-open
     rep-open
     pub-open
     sub-open
     push-open
     pull-open
     pair-open
     bus-open
     surveyor-open
     respondent-open
     dial
     listen
     close
     set-recv-timeout-ms
     set-send-timeout-ms
     err-str
     timed-out?])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-false])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  ;; opens-and-closes? -- the shape every constructor case wants: the result is
  ;; ok, and the socket it carries closes cleanly.
  (defn opens-and-closes? [r : (Result Socket int)] : bool
    (if (ok? r) (do (close (ok-val r)) true) false))
  (defn __all-tests [] : void
    (describe "nng/socket -- the ten protocol constructors"
      (it "opens a REQ socket" (assert-true (opens-and-closes? (req-open))))
      (it "opens a REP socket" (assert-true (opens-and-closes? (rep-open))))
      (it "opens a PUB socket" (assert-true (opens-and-closes? (pub-open))))
      (it "opens a SUB socket" (assert-true (opens-and-closes? (sub-open))))
      (it "opens a PUSH socket" (assert-true (opens-and-closes? (push-open))))
      (it "opens a PULL socket" (assert-true (opens-and-closes? (pull-open))))
      (it "opens a PAIR socket" (assert-true (opens-and-closes? (pair-open))))
      (it "opens a BUS socket" (assert-true (opens-and-closes? (bus-open))))
      (it "opens a SURVEYOR socket"
        (assert-true (opens-and-closes? (surveyor-open))))
      (it "opens a RESPONDENT socket"
        (assert-true (opens-and-closes? (respondent-open)))))
    (describe "nng/socket -- endpoints"
      (it "listens on an inproc address"
        (let [s (ok-val (pair-open))
              r (assert-true (ok? (listen s "inproc://ng1-listen")))]
          (close s)
          r))
      (it "dials an inproc address something is listening on"
        (let [srv (ok-val (pair-open))
              cli (ok-val (pair-open))
              _   (listen srv "inproc://ng1-dial")
              r   (assert-true (ok? (dial cli "inproc://ng1-dial")))]
          (close cli)
          (close srv)
          r))
      (it "refuses a second listen on a live address"
        (let [a (ok-val (pair-open))
              b (ok-val (pair-open))
              _ (listen a "inproc://ng1-dup")
              r (assert-false (ok? (listen b "inproc://ng1-dup")))]
          (close b)
          (close a)
          r))
      (it "rejects an address with no transport scheme"
        (let [s (ok-val (pair-open))
              r (assert-false (ok? (listen s "not-a-url")))]
          (close s)
          r))
      (it "reports an inproc dial with no listener as a failure"
        (let [s (ok-val (pair-open))
              r (assert-false (ok? (dial s "inproc://ng1-nobody-home")))]
          (close s)
          r)))
    (describe "nng/socket -- timeouts and errors"
      (it "accepts a receive timeout"
        (let [s (ok-val (pull-open))
              r (assert-true (ok? (set-recv-timeout-ms s 100)))]
          (close s)
          r))
      (it "accepts a send timeout"
        (let [s (ok-val (push-open))
              r (assert-true (ok? (set-send-timeout-ms s 100)))]
          (close s)
          r))
      (it "accepts a negative timeout as 'wait forever'"
        (let [s (ok-val (pull-open))
              r (assert-true (ok? (set-recv-timeout-ms s -1)))]
          (close s)
          r))
      (it "renders a known error code"
        (assert-true (cstr-eq? "Timed out" (err-str 5))))
      (it "recognises the timeout code" (assert-true (timed-out? 5)))
      (it "does not mistake another code for a timeout"
        (assert-false (timed-out? 7)))))
  (defn main [] : int (__all-tests) (run-all-status)))
