(defpackage tur-nng
  :name        "tur-nng"
  :version     "0.1.0"
  :description "nanomsg-next-generation (nng) scalability protocols for Turmeric"
  :license     "MIT"
  :spices #map{
    "test" #map{:path   "../test"
                :url    "https://github.com/turmeric-lang/turmeric-spices"
                :ref    "test-v0.1.0"
                :subdir "spices/test"
                :optional true}
    ;; Test-only, and :optional so a consumer of tur-nng never has to have it.
    ;; tests/nng/msgpack_test.tur is the typed-messaging showcase the two plans
    ;; were written for: derive a codec for a struct, push the encoded bytes
    ;; across inproc, decode them on the other side. It is also the standing
    ;; proof that the two spices' Payload layouts really do match.
    "msgpack" #map{:path   "../msgpack"
                   :url    "https://github.com/turmeric-lang/turmeric-spices"
                   :ref    "main"
                   :subdir "spices/msgpack"
                   :optional true}
  }
  :cmake-deps #map{
    ;; nng lays its public headers under `include/nng/`, so the fetched
    ;; SOURCE_DIR/include that `tur fetch` puts on the compile line is exactly
    ;; what `#include <nng/nng.h>` wants -- no system package is needed for the
    ;; headers (unlike valkey/hiredis, whose fetched tree has no hiredis/
    ;; subdirectory).
    ;;
    ;; :targets ["nng"] links by $<TARGET_FILE:nng> rather than a name-derived
    ;; -lnng: the static build emits libnng.a, and asking CMake for the exact
    ;; artifact also drags in the platform link requirements (-lpthread on
    ;; Linux) that nng's target carries as INTERFACE_LINK_LIBRARIES.
    ;;
    ;; NNG_TESTS/NNG_TOOLS default to ON for a *native* build (NNG_NATIVE_BUILD
    ;; in cmake/NNGOptions.cmake), which is what FetchContent gives us -- so
    ;; both must be turned off explicitly or the dep build also compiles nng's
    ;; own test corpus and nngcat. NNG_ENABLE_TLS defaults OFF; it is pinned
    ;; here so a future default flip does not silently pull in mbedTLS.
    "nng" #map{:url     "https://github.com/nanomsg/nng"
               :ref     "v1.12.4"
               :targets ["nng"]
               :options #map{:BUILD_SHARED_LIBS "OFF"
                             :NNG_TESTS         "OFF"
                             :NNG_TOOLS         "OFF"
                             :NNG_ENABLE_NNGCAT "OFF"
                             :NNG_ENABLE_TLS    "OFF"}}
  }
  :build-opts #map{
    :c-includes ["c"]
    :c-sources  ["c/nng/turnng_payload.c"]
  }
  :exports #map{
    ;; The byte carrier is `Payload`, not `Buf`, because an opaque name resolves
    ;; globally and tur-msgpack already owns `Buf` -- msgpack-over-nng is the
    ;; pairing both spices' plans were written for, and it has to be a program
    ;; someone can compile. Same reasoning that made tur-json 0.4.0 rename its
    ;; Encode/Decode classes.
    "nng/payload" ["Payload"
                   "payload-alloc" "payload-of-cstr"
                   "payload-len" "payload-data" "payload-byte"
                   "payload-empty?" "payload=?"
                   "payload->cstr" "payload->hex"
                   "payload-free"]
    "nng/socket"  ["Socket"
                   "req-open" "rep-open" "pub-open" "sub-open"
                   "push-open" "pull-open" "pair-open" "bus-open"
                   "surveyor-open" "respondent-open"
                   "dial" "listen" "close"
                   "set-recv-timeout-ms" "set-send-timeout-ms"
                   "err-str" "timed-out?"
                   "PollFd" "poll-fd->int" "recv-poll-fd" "send-poll-fd"]
    "nng/msg"     ["send-str" "recv-str"
                   "send-payload" "recv-payload"
                   "try-send-str" "try-recv-str"
                   "try-send-payload" "try-recv-payload"
                   "sub-subscribe" "sub-unsubscribe"]
  })
