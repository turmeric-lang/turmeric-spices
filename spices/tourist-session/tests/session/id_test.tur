;; tests/session/id_test.tur -- session ID generation properties.
(defmodule session/tests/id
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (import session/id :refer [session-id-new])
  (import session/ownstr :refer [String to-cstr release])
  (defn clen [s : cstr] : int
    ```c
    #include <string.h>
  return (int64_t)strlen((const char *)s);
  ```)
  (defn all-hex? [s : cstr] : bool
    ```c
    for (const char *p = (const char *)s; *p; p++) {
    char c = *p;
    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
  }
  return true;
  ```)
  (defn differ? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) != 0;
  ```)
  ;; session-id-new returns an owned String (v0.3.0); borrow + release per probe.
  (defn id-len [] : int
    (let [s (session-id-new)
          n (clen (to-cstr s))]
      (do (release s) n)))
  (defn id-hex? [] : bool
    (let [s (session-id-new)
          r (all-hex? (to-cstr s))]
      (do (release s) r)))
  (defn ids-differ? [] : bool
    (let [a (session-id-new)
          b (session-id-new)
          r (differ? (to-cstr a) (to-cstr b))]
      (do (release a) (release b) r)))
  (defn main [] : int
    (do
      (describe "session/id"
        (it "is 64 characters" (assert-eq (id-len) 64))
        (it "is lowercase hex" (assert-true (id-hex?)))
        (it "is unique across calls" (assert-true (ids-differ?))))
      (run-all-status)))) ;; end module
