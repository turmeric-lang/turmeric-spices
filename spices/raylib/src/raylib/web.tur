;;; raylib/web.tur -- driving a raylib frame loop from the browser.
;;;
;;; A browser runs one event-loop thread that also services layout, input and
;;; compositing, so a program that never returns to it never gets a frame:
;;; `(while (not (window-should-close)) ...)` renders nothing and hangs the
;;; tab. The browser calls the program, not the reverse.
;;;
;;; This module supplies the inverted form. `run-main-loop` hands a per-frame
;;; function to Emscripten and returns (or rather, does not return -- see
;;; below); the browser then calls it once per display refresh.
;;;
;;; The other way to get an existing loop running is to link with
;;; `-sASYNCIFY`, which lets the blocking `while` form yield. That needs no
;;; source change at all, and costs a fixed ~16ms ADDED to each frame's own
;;; time: measured 59.5fps with a trivial frame against 40.0fps with 8ms of
;;; frame work, where this module's callback form held 60.0 at both. Asyncify
;;; is a fine way to get a port running; it is not what a finished game ships.
;;;
;;; Since: W2
(defmodule raylib/web
  (import raylib/core
    :refer
    [init-window begin-drawing end-drawing clear-background get-frame-time])
  (import raylib/color :refer [raywhite])
  (export run-main-loop cancel-main-loop with-web-game-loop)
  ;;; run-main-loop -- register a per-frame function and hand control to the browser.
  ;;;
  ;;; Parameters:
  ;;;   frame -- called once per display refresh
  ;;;   fps   -- target rate; pass 0 for requestAnimationFrame, which is what a
  ;;;            browser wants (it matches the display and stops when the tab is
  ;;;            hidden). A non-zero rate asks Emscripten to throttle.
  ;;;
  ;;; Returns:
  ;;;   Nothing, and not in the ordinary sense: the underlying
  ;;;   `emscripten_set_main_loop` is called with simulate_infinite_loop=1, so it
  ;;;   unwinds out of `main` and every statement after this call is
  ;;;   unreachable. That is correct on the web rather than regrettable -- there
  ;;;   is no window-close event, and closing the tab reclaims the GL context,
  ;;;   the textures and the heap in one go, so `close-window` has nothing to do.
  ;;;
  ;;;   The consequence that bites: `main`'s stack frame is gone by the first
  ;;;   frame, so anything the frame function still refers to has to outlive it.
  ;;;   Keep per-frame state in the closure (or a global), never in a local of
  ;;;   the function that called this one.
  ;;;
  ;;; Example:
  ;;;   (init-window 800 600 "demo")
  ;;;   (run-main-loop (fn [] : unit
  ;;;                    (begin-drawing)
  ;;;                    (clear-background (raywhite))
  ;;;                    (end-drawing))
  ;;;                  0)
  ;;;
  ;;; Since: W2
  (defn run-main-loop [frame : (fn [] unit) fps : int] : void
    ```c
    extern void tur_rl_web_run(void *, int64_t (*)(void *), int);
  /* The browser reads both of these words out of C statics in rl_web_loop.c
     after main() has unwound, so they outlive the scope that built them.
     `frame` is a closure HANDLE (int64_t) under the unified representation,
     so this is the scalar note.
     Defensive, and labelled as such: tests/fixtures/region-escape-via-main-loop
     in the turmeric repo shows the callback surviving without it, so this is
     insurance against a store the hooked set does not cover rather than a fix
     for a demonstrated rewind. It costs one call, and nothing at all under
     TUR_REGIONS=0. */
  TUR_REGION_NOTE(frame);
  /* TUR_CLOSURE_FN is slot 0 of the closure box, and the box itself is what
     gets passed as the argument -- it IS the environment, so a zero-argument
     closure is called as fn(box). Read here, where the preamble is in scope,
     so the C shim never learns the layout. */
  tur_rl_web_run((void *)(intptr_t)frame,
                 (int64_t (*)(void *))(intptr_t)TUR_CLOSURE_FN(frame),
                 (int)fps);
  ```)
  ;;; cancel-main-loop -- stop the registered frame loop.
  ;;;
  ;;; The module stays resident afterwards; there is no teardown to run. Use it
  ;;; to draw a final frame and stop, not to exit.
  ;;;
  ;;; Example:
  ;;;   (cancel-main-loop)
  ;;;
  ;;; Since: W2
  (defn cancel-main-loop [] : void
    ```c
    extern void tur_rl_web_cancel(void);
  tur_rl_web_cancel();
  ```)
  ;;; with-web-game-loop -- the web twin of ecs-raylib's with-game-loop.
  ;;;
  ;;; Deliberately arity-compatible with `ecs-raylib/loop`'s `with-game-loop`,
  ;;; so porting a game is changing the import and nothing else. `dt` is bound
  ;;; to the frame's delta-time throughout the body, same as there.
  ;;;
  ;;; Two differences from the native macro, both forced by the platform:
  ;;;
  ;;;   - There is no `while` and no `close-window`. The browser drives the
  ;;;     frames, and the call never returns (see `run-main-loop`).
  ;;;   - `fps` is ACCEPTED AND IGNORED. raylib's `set-target-fps` sleeps to hit
  ;;;     a rate, and sleeping is exactly what must not happen on the thread
  ;;;     that also services the page; the loop is registered with 0 so the
  ;;;     browser schedules it through requestAnimationFrame instead. The
  ;;;     parameter is kept so the two macros stay swappable.
  ;;;
  ;;; Syntax:
  ;;;   (with-web-game-loop w title width height fps
  ;;;     body)
  ;;;
  ;;; Since: W2
  (defmacro with-web-game-loop [w title width height fps body]
    `(do
       (init-window ~width ~height ~title)
       (run-main-loop (fn [] : unit
                        (let [dt (get-frame-time)]
                          (begin-drawing)
                          (clear-background (raywhite))
                          ~body
                          (end-drawing)))
         0)))) ;; end defmodule raylib/web
