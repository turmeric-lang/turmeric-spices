(defpackage tur-raylib
  :name "tur-raylib"
  :version "0.3.0"
  :description "Raylib graphics and input bindings for Turmeric"
  :license "MIT"
  :spices #map{"math" #map{:path "../math"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "math-v0.1.0"
                           :subdir "spices/math"}
               "test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :cmake-deps #map{
                   ;; :targets is load-bearing: without it the generated manifest guesses
                   ;; the link dir as <dep>-build, but raylib builds its archive into
                   ;; <dep>-build/raylib, so the link failed with "cannot find -lraylib".
                   ;; With :targets the dir comes from CMake's own $<TARGET_FILE_DIR:raylib>.
                   ;; :wasm-options apply only under emcmake, and PLATFORM is why the key
                   ;; exists: raylib's own default is "Desktop" and it has NO Emscripten
                   ;; autodetect, so a plain :options entry would break the native build --
                   ;; while leaving it out fails the wasm configure with `Could NOT find X11`,
                   ;; an error that names neither Emscripten nor PLATFORM.
                   ;;
                   ;; GRAPHICS picks the GL level. ES3 gives a WebGL2 context and full NPOT
                   ;; textures; raylib's web default (ES2/WebGL1) reports "limited NPOT
                   ;; support (no-mipmaps, no-repeat)", which is a real constraint on a real
                   ;; game. It is spelled GRAPHICS rather than OPENGL_VERSION="ES 3.0"
                   ;; because manifest option values cannot contain a space.
                   ;;
                   ;; This has to agree with the app's `:web :gl`; tur rejects a mismatch,
                   ;; because the browser's own report of one is a TypeError about
                   ;; `attachShader` that names nothing useful.
                   "raylib" #map{:url "https://github.com/raysan5/raylib"
                                 :ref "5.5"
                                 :targets ["raylib"]
                                 :options #map{:BUILD_SHARED_LIBS "OFF"
                                               :BUILD_EXAMPLES "OFF"
                                               :BUILD_GAMES "OFF"}
                                 :wasm-options #map{:PLATFORM "Web"
                                                    :GRAPHICS "GRAPHICS_API_OPENGL_ES3"}}}
  ;; The frame-callback shim. A browser cannot be handed a Turmeric closure,
  ;; so one small C TU holds it between registration and the first frame and
  ;; presents Emscripten the bare function pointer it wants. It is compiled on
  ;; both arms and is inert off the web.
  :build-opts #map{:c-sources ["c/raylib/rl_web_loop.c"]}
  :exports #map{"raylib/types" ["Color"
                                "Vector2"
                                "Rectangle"
                                "Camera3D"
                                "Camera2D"
                                "Texture2D"
                                "Font"
                                "Model"
                                "Mesh"
                                "Material"
                                "Matrix"]
                "raylib/core" ["init-window"
                               "close-window"
                               "begin-drawing"
                               "end-drawing"
                               "begin-mode-3d"
                               "end-mode-3d"
                               "clear-background"
                               "set-target-fps"
                               "get-frame-time"
                               "window-should-close"]
                "raylib/camera" ["camera-3d" "camera-2d" "update-camera"]
                "raylib/shapes" ["draw-circle"
                                 "draw-circle-v"
                                 "draw-rectangle"
                                 "draw-rectangle-rec"
                                 "draw-line"
                                 "draw-line-v"
                                 "draw-triangle"]
                "raylib/textures" ["load-texture"
                                   "unload-texture"
                                   "draw-texture"
                                   "draw-texture-v"
                                   "draw-texture-ex"]
                "raylib/models" ["load-model"
                                 "unload-model"
                                 "draw-model"
                                 "draw-model-ex"
                                 "load-mesh"
                                 "draw-mesh"]
                "raylib/text" ["load-font"
                               "unload-font"
                               "draw-text"
                               "draw-text-ex"
                               "measure-text"]
                "raylib/audio" ["Sound"
                                "Music"
                                "init-audio-device"
                                "close-audio-device"
                                "load-sound"
                                "unload-sound"
                                "play-sound"
                                "load-music-stream"
                                "unload-music-stream"
                                "play-music-stream"
                                "update-music-stream"]
                "raylib/input" ["is-key-down"
                                "is-key-pressed"
                                "is-key-released"
                                "is-mouse-button-down"
                                "is-mouse-button-pressed"
                                "get-mouse-position"
                                "get-mouse-delta"
                                "get-mouse-wheel-move"]
                "raylib/color" ["color"
                                "red"
                                "green"
                                "blue"
                                "white"
                                "black"
                                "gray"
                                "yellow"
                                "orange"
                                "purple"
                                "pink"
                                "skyblue"
                                "raywhite"
                                "fade"
                                "color-lerp"]
                "raylib/web" ["run-main-loop"
                              "cancel-main-loop"
                              "with-web-game-loop"]
                "raylib/image" ["Image"
                                "rgba"
                                "rgba-r"
                                "rgba-g"
                                "rgba-b"
                                "rgba-a"
                                "image-blank"
                                "image-filled"
                                "image-free"
                                "image-width"
                                "image-height"
                                "image-get"
                                "image-set!"
                                "image-overlay"
                                "image-scale-rgb"]})
