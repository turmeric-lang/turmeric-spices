(defpackage tur-valkey
  :name "tur-valkey"
  :version "0.6.0"
  :description "Valkey/Redis client for Turmeric via hiredis"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :cmake-deps #map{
                   ;; The library is built from source here, but the HEADERS come from the
                   ;; system (libhiredis-dev / brew hiredis), which is why CI installs it:
                   ;; this spice's inline-C uses the conventional <hiredis/hiredis.h>, while
                   ;; the fetched source tree lays hiredis.h at its own root with no hiredis/
                   ;; directory -- so the fetched include dir alone leaves every
                   ;; REDIS_REPLY_* undeclared and the whole spice fails to compile.
                   "hiredis" #map{:url "https://github.com/redis/hiredis"
                                  :ref "v1.2.0"
                                  :options #map{:BUILD_SHARED_LIBS "OFF"
                                                :DISABLE_TESTS "ON"}}}
  :exports #map{"valkey/client" ["Client"
                                 "client-connect"
                                 "client-connect-unix"
                                 "client-close"
                                 "client-ping"]
                "valkey/cmd" ["ValkeyArg"
                              "vk-str"
                              "vk-int"
                              "vk-bytes"
                              "cmd"
                              "cmd-get"
                              "cmd-set"
                              "cmd-del"
                              "cmd-incr"
                              "cmd-expire"
                              "cmd-hset"
                              "cmd-hget"
                              "cmd-lpush"
                              "cmd-lrange"]
                "valkey/reply" ["Reply"
                                "reply-type"
                                "reply-string"
                                "reply-int"
                                "reply-array-len"
                                "reply-array-get"
                                "reply-free"]
                "valkey/pubsub" ["Message"
                                 "pubsub-subscribe"
                                 "pubsub-unsubscribe"
                                 "pubsub-publish"
                                 "pubsub-recv"
                                 "message-channel"
                                 "message-payload"]})
