;;; linalg/solve -- linear system solvers and matrix inverse/determinant
;;;
;;; v0.21.0 model: triangular substitutions, the LU permutation-determinant,
;;; and Q^T b run in inline C over the backing `(Vec float)` / `(Vec int)`
;;; buffers; the Turmeric layer allocates results and composes the factor-based
;;; solvers.
(defmodule linalg/solve
  (export fwd-sub
    back-sub
    chol-solve
    lu-solve
    qr-solve
    mat-solve
    mat-inv
    mat-det
    svd-solve
    svd-rank
    svd-condition
    svd-project)
  (import linalg/mat
    :refer
    [mat
     mat-new
     mat-new-zeroed
     mat-transpose
     mat-free
     mat-rows
     mat-cols
     mat-get
     mat-set!
     mat-square?])
  (import linalg/vec
    :refer
    [lavec la-vec-new la-vec-len la-vec-get la-vec-set! la-vec-free])
  (import linalg/decomp
    :refer
    [cholfac lufac qrfac svdfac chol chol-free lu lu-free qr qr-free])
  ;;; LA3 -- forward / backward substitution
  ;;; __fwd-sub-kernel -- solve L x = b, L lower triangular (n x n).
  (defn __fwd-sub-kernel [xd : (Vec float)
                          Ld : (Vec float)
                          bd : (Vec float)
                          n : int] : int
    ```c
    struct __V { int64_t *data; int64_t len; int64_t cap; };
  double *x = (double*)(void*)((struct __V*)(intptr_t)xd)->data;
  double *L = (double*)(void*)((struct __V*)(intptr_t)Ld)->data;
  double *b = (double*)(void*)((struct __V*)(intptr_t)bd)->data;
  for (int64_t i = 0; i < n; i++) {
    double s = b[i];
    for (int64_t j = 0; j < i; j++) s -= L[i*n+j] * x[j];
    x[i] = s / L[i*n+i];
  }
  return 0;
  ```)
  ;;; __back-sub-kernel -- solve U x = b, U upper triangular (n x n, row stride n).
  (defn __back-sub-kernel [xd : (Vec float)
                           Ud : (Vec float)
                           bd : (Vec float)
                           n : int] : int
    ```c
    struct __V { int64_t *data; int64_t len; int64_t cap; };
  double *x = (double*)(void*)((struct __V*)(intptr_t)xd)->data;
  double *U = (double*)(void*)((struct __V*)(intptr_t)Ud)->data;
  double *b = (double*)(void*)((struct __V*)(intptr_t)bd)->data;
  for (int64_t i = n - 1; i >= 0; i--) {
    double s = b[i];
    for (int64_t j = i + 1; j < n; j++) s -= U[i*n+j] * x[j];
    x[i] = s / U[i*n+i];
  }
  return 0;
  ```)
  ;;; fwd-sub -- solve L x = b where L is lower triangular.
  (defn fwd-sub [^borrow l : mat ^borrow b : lavec] : lavec
    (let [n (mat-rows l)
          x (la-vec-new n)]
      (__fwd-sub-kernel (.data x) (.data l) (.data b) n)
      x))
  ;;; back-sub -- solve U x = b where U is upper triangular.
  (defn back-sub [^borrow u : mat ^borrow b : lavec] : lavec
    (let [n (mat-rows u)
          x (la-vec-new n)]
      (__back-sub-kernel (.data x) (.data u) (.data b) n)
      x))
  ;;; chol-solve -- solve A x = b given a Cholesky factor (A = L L').
  (defn chol-solve [^borrow f : cholfac ^borrow b : lavec] : lavec
    (let [y  (fwd-sub (.L f) b)
          lt (mat-transpose (.L f))
          x  (back-sub lt y)]
      (la-vec-free y)
      (mat-free lt)
      x))
  ;;; lu-solve -- solve A x = b given an LU factor (P A = L U).
  (defn lu-solve [^borrow f : lufac ^borrow b : lavec] : lavec
    (let [n      (la-vec-len b)
          pb     (la-vec-new n)
          ^mut i 0]
      ;; Pb[i] = b[piv[i]]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do
                     (la-vec-set! pb i (la-vec-get b (vec-get (.piv f) i)))
                     (set! i (+ i 1))
                     (go))))]
        (go))
      (let [y (fwd-sub (.L f) pb)
            x (back-sub (.U f) y)]
        (la-vec-free pb)
        (la-vec-free y)
        x)))
  ;;; __qt-b-kernel -- c[i] = sum_j Q[j*m+i] * b[j] for i in 0..n (Q is m x m).
  (defn __qt-b-kernel [cd : (Vec float)
                       Qd : (Vec float)
                       bd : (Vec float)
                       m : int
                       n : int] : int
    ```c
    struct __V { int64_t *data; int64_t len; int64_t cap; };
  double *c = (double*)(void*)((struct __V*)(intptr_t)cd)->data;
  double *Q = (double*)(void*)((struct __V*)(intptr_t)Qd)->data;
  double *b = (double*)(void*)((struct __V*)(intptr_t)bd)->data;
  for (int64_t i = 0; i < n; i++) {
    double s = 0.0;
    for (int64_t j = 0; j < m; j++) s += Q[j*m+i] * b[j];
    c[i] = s;
  }
  return 0;
  ```)
  ;;; qr-solve -- least-squares solve of A x ~= b given a QR factor (A = Q R).
  ;;; Computes x = R1^-1 (Q^T b) over the leading n x n block of R.
  (defn qr-solve [^borrow f : qrfac ^borrow b : lavec] : lavec
    (let [m (mat-rows (.Q f))
          n (mat-cols (.R f))
          c (la-vec-new n)]
      (__qt-b-kernel (.data c) (.data (.Q f)) (.data b) m n)
      ;; R is m x n with row stride n, so its leading n x n block R1 is the
      ;; first n rows read at that stride. Call the kernel with n directly:
      ;; `back-sub` would take its size from (mat-rows R) = m and walk past R1
      ;; whenever m > n.
      (let [x (la-vec-new n)]
        (__back-sub-kernel (.data x) (.data (.R f)) (.data c) n)
        (la-vec-free c)
        x)))
  ;;; mat-solve -- factorize and solve A x = b. spd? = 1 selects Cholesky.
  (defn mat-solve [^borrow a : mat ^borrow b : lavec spd? : int] : lavec
    (when (not (= (mat-square? a) 1))
      (panic "mat-solve: matrix must be square"))
    (if (= spd? 1)
      (let [f (chol a)
            x (chol-solve f b)]
        (chol-free f)
        x)
      (let [f (lu a)
            x (lu-solve f b)]
        (lu-free f)
        x)))
  ;;; mat-inv -- inverse of a square matrix via LU column solves.
  (defn mat-inv [^borrow a : mat] : mat
    (when (not (= (mat-square? a) 1)) (panic "mat-inv: matrix must be square"))
    (let [n        (mat-rows a)
          f        (lu a)
          inv      (mat-new n n)
          ^mut col 0]
      (letrec [goc
               (fn [] : int
                 (if (>= col n)
                   0
                   (let [e (la-vec-new n)]
                     (la-vec-set! e col 1.0)
                     (let [x      (lu-solve f e)
                           ^mut r 0]
                       (letrec [gor
                                (fn [] : int
                                  (if (>= r n)
                                    0
                                    (do
                                      (mat-set! inv r col (la-vec-get x r))
                                      (set! r (+ r 1))
                                      (gor))))]
                         (gor))
                       (la-vec-free e)
                       (la-vec-free x))
                     (set! col (+ col 1))
                     (goc))))]
        (goc))
      (lu-free f)
      inv))
  ;;; __lu-det-kernel -- determinant from an LU factor: product of U diagonal
  ;;; times the sign of the row permutation piv.
  (defn __lu-det-kernel [Ud : (Vec float) pivd : (Vec int) n : int] : float
    ```c
    struct __V { int64_t *data; int64_t len; int64_t cap; };
  double *U = (double*)(void*)((struct __V*)(intptr_t)Ud)->data;
  int64_t *piv = (int64_t*)(void*)((struct __V*)(intptr_t)pivd)->data;
  double det = 1.0;
  for (int64_t i = 0; i < n; i++) det *= U[i*n+i];
  char *seen = (char*)calloc((size_t)n, 1);
  int64_t swaps = 0;
  for (int64_t i = 0; i < n; i++) {
    if (!seen[i]) {
      int64_t j = i, len = 0;
      while (!seen[j]) { seen[j] = 1; j = piv[j]; len++; }
      swaps += len - 1;
    }
  }
  free(seen);
  if (swaps & 1) det = -det;
  return det;
  ```)
  ;;; mat-det -- determinant of a square matrix via LU.
  (defn mat-det [^borrow a : mat] : float
    (when (not (= (mat-square? a) 1)) (panic "mat-det: matrix must be square"))
    (let [n (mat-rows a)
          f (lu a)
          d (__lu-det-kernel (.data (.U f)) (.piv f) n)]
      (lu-free f)
      d))
  ;;; LB1 -- SVD-based least squares, rank, conditioning and projection.
  ;;; __i2f -- int to float.
  (defn __i2f [n : int] : float ```c return (double)n; ```)
  ;;; __svd-default-tol -- the numpy/LAPACK rank cutoff max(m, n) * eps * s[0].
  (defn __svd-default-tol [^borrow f : svdfac] : float
    (let [m  (mat-rows (.U f))
          n  (mat-cols (.Vt f))
          mn (if (> m n) m n)]
      (if (= (la-vec-len (.s f)) 0)
        0.0
        (* (* (__i2f mn) 2.220446049250313e-16) (la-vec-get (.s f) 0)))))
  ;;; svd-rank -- numerical rank: the count of singular values above tol.
  ;;;
  ;;; Parameters:
  ;;;   f   -- an SVD factor (borrowed)
  ;;;   tol -- the cutoff; a value <= 0 selects max(m, n) * eps * s[0]
  ;;;
  ;;; Returns:
  ;;;   The number of singular values strictly greater than the cutoff.
  ;;;
  ;;; Example:
  ;;;   (svd-rank (svd (mat-of 2 2 1.0 2.0 2.0 4.0)) 0.0)  ; => 1
  ;;;
  ;;; Since: 0.2.0
  (defn svd-rank [^borrow f : svdfac tol : float] : int
    (let [cut (if (> tol 0.0) tol (__svd-default-tol f))
          k   (la-vec-len (.s f))]
      (letrec [go
               (fn [i : int] : int
                 (if (>= i k)
                   k
                   (if (> (la-vec-get (.s f) i) cut) (go (+ i 1)) i)))]
        (go 0))))
  ;;; svd-condition -- 2-norm condition number s[0] / s[k-1].
  ;;;
  ;;; Parameters:
  ;;;   f -- an SVD factor (borrowed)
  ;;;
  ;;; Returns:
  ;;;   The ratio of the largest to the smallest singular value; +inf when the
  ;;;   smallest is exactly zero.
  ;;;
  ;;; Example:
  ;;;   (svd-condition (svd (mat-of 2 2 4.0 0.0 0.0 2.0)))  ; => 2.0
  ;;;
  ;;; Since: 0.2.0
  (defn svd-condition [^borrow f : svdfac] : float
    (let [k (la-vec-len (.s f))]
      (if (= k 0)
        0.0
        (let [lo (la-vec-get (.s f) (- k 1))
              hi (la-vec-get (.s f) 0)]
          (if (= lo 0.0) (/ 1.0 0.0) (/ hi lo))))))
  ;;; __svd-apply-kernel -- with r leading singular triplets, write
  ;;;   mode 0: x = sum_j (u_j . b / s_j) v_j   (length n)
  ;;;   mode 1: x = sum_j (u_j . b) u_j         (length m)
  (defn __svd-apply-kernel [xd : (Vec float)
                            Ud : (Vec float)
                            sd : (Vec float)
                            Vtd : (Vec float)
                            bd : (Vec float)
                            m : int
                            n : int
                            r : int
                            mode : int] : int
    ```c
    struct __V { int64_t *data; int64_t len; int64_t cap; };
  double *x = (double*)(void*)((struct __V*)(intptr_t)xd)->data;
  double *U = (double*)(void*)((struct __V*)(intptr_t)Ud)->data;
  double *s = (double*)(void*)((struct __V*)(intptr_t)sd)->data;
  double *Vt = (double*)(void*)((struct __V*)(intptr_t)Vtd)->data;
  double *b = (double*)(void*)((struct __V*)(intptr_t)bd)->data;
  int64_t len = mode == 0 ? n : m;
  for (int64_t i = 0; i < len; i++) x[i] = 0.0;
  for (int64_t j = 0; j < r; j++) {
    double c = 0.0;
    for (int64_t i = 0; i < m; i++) c += U[i*m + j] * b[i];
    if (mode == 0) {
      c /= s[j];
      for (int64_t i = 0; i < n; i++) x[i] += c * Vt[j*n + i];
    } else {
      for (int64_t i = 0; i < m; i++) x[i] += c * U[i*m + j];
    }
  }
  return 0;
  ```)
  ;;; svd-solve -- rank-truncated least-squares / minimum-norm solve.
  ;;;
  ;;; Minimizes ||A x - b|| and, among the minimizers, ||x||, keeping only the
  ;;; singular values above the default cutoff (see `svd-rank`). Handles
  ;;; over-determined, under-determined and rank-deficient systems.
  ;;;
  ;;; Parameters:
  ;;;   f -- the SVD of A (m x n), borrowed
  ;;;   b -- the right-hand side, length m (borrowed)
  ;;;
  ;;; Returns:
  ;;;   The solution x, length n.
  ;;;
  ;;; Example:
  ;;;   (svd-solve (svd (mat-of 2 2 2.0 0.0 0.0 4.0)) (la-vec-of 2.0 2.0))
  ;;;   ; => [1.0 0.5]
  ;;;
  ;;; Since: 0.2.0
  (defn svd-solve [^borrow f : svdfac ^borrow b : lavec] : lavec
    (let [m (mat-rows (.U f))
          n (mat-cols (.Vt f))]
      (when (not= (la-vec-len b) m) (panic "svd-solve: length mismatch"))
      (let [x (la-vec-new n)
            r (svd-rank f 0.0)]
        (__svd-apply-kernel (.data x)
          (.data (.U f))
          (.data (.s f))
          (.data (.Vt f))
          (.data b)
          m
          n
          r
          0)
        x)))
  ;;; svd-project -- orthogonal projection of b onto the column space of A.
  ;;;
  ;;; Parameters:
  ;;;   f -- the SVD of A (m x n), borrowed
  ;;;   b -- a vector of length m (borrowed)
  ;;;
  ;;; Returns:
  ;;;   U_r U_r' b, where U_r holds the left singular vectors of the numerical
  ;;;   rank r.
  ;;;
  ;;; Example:
  ;;;   (svd-project (svd (mat-of 2 1 1.0 0.0)) (la-vec-of 3.0 4.0))
  ;;;   ; => [3.0 0.0]
  ;;;
  ;;; Since: 0.2.0
  (defn svd-project [^borrow f : svdfac ^borrow b : lavec] : lavec
    (let [m (mat-rows (.U f))
          n (mat-cols (.Vt f))]
      (when (not= (la-vec-len b) m) (panic "svd-project: length mismatch"))
      (let [x (la-vec-new m)
            r (svd-rank f 0.0)]
        (__svd-apply-kernel (.data x)
          (.data (.U f))
          (.data (.s f))
          (.data (.Vt f))
          (.data b)
          m
          n
          r
          1)
        x)))) ;; end defmodule linalg/solve
