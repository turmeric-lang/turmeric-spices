;;; linalg/mat -- dynamic :float matrix type and core operations
;;;
;;; A `mat` is a typed struct value owning a heap `(Vec float)` of rows*cols
;;; row-major float64 elements (turmeric v0.21.0 model -- no `:int`-pointer
;;; handles, no `sizeof`, no `float64*` indexing). The struct owns its buffer,
;;; so it is move-only: readers take the receiver `^borrow` and `mat-free`
;;; consumes it. Element reads go through `(:: (vec-get ...) :float)`.
(defmodule linalg/mat
  (export mat
    mat-new
    mat-new-zeroed
    mat-identity
    mat-diag
    mat-of
    mat-wrap
    mat-copy
    mat-free
    mat-rows
    mat-cols
    mat-shape
    mat-get
    mat-set!
    mat-row
    mat-col
    mat-submat
    mat-add
    mat-sub
    mat-scale
    mat-mul
    mat-mul-vec
    mat-transpose
    mat-trace
    mat-norm-fro
    mat-norm-max
    mat-square?
    mat-approx-eq?
    la-vec-outer
    linalg-blas?)
  (import linalg/vec
    :refer
    [lavec la-vec-new la-vec-len la-vec-get la-vec-set! sqrt fabs])
  ;;; mat -- a row-major rows x cols float64 matrix over a heap (Vec float).
  (defstruct mat [rows : int cols : int data : (Vec float)])
  ;;; Private: build a zero-filled (Vec float) of length n.
  (defn __mzeros [n : int] : (Vec float)
    (let [d      (:: (vec-new) (Vec float))
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n) 0 (do (vec-push! d 0.0) (set! i (+ i 1)) (go))))]
        (go))
      d))
  ;;; mat-new -- create a zero-initialized rows x cols matrix.
  (defn mat-new [rows : int cols : int] : mat
    (make-struct mat rows cols (__mzeros (* rows cols))))
  ;;; mat-new-zeroed -- create a zero-initialized rows x cols matrix.
  (defn mat-new-zeroed [rows : int cols : int] : mat
    (make-struct mat rows cols (__mzeros (* rows cols))))
  ;;; mat-wrap -- take ownership of a (Vec float) of rows*cols elements as a mat.
  (defn mat-wrap [rows : int cols : int d : (Vec float)] : mat
    (make-struct mat rows cols d))
  ;;; mat-of -- build a rows x cols matrix from row-major float literals.
  ;;;   (mat-of 2 2  1.0 2.0  3.0 4.0)
  ;;; Lowers through the stdlib `(vec-of ...)` float-literal builder (turmeric
  ;;; main #473), retiring the hand-rolled `__mpush` push-loop that existed only
  ;;; because a `(Vec float)` literal could not be spelled before.
  (defmacro mat-of [rows cols & xs]
    `(mat-wrap ~rows ~cols (:: (vec-of ~@xs) (Vec float))))
  ;;; mat-rows / mat-cols -- shape accessors.
  (defn mat-rows [^borrow m : mat] : int (.rows m))
  (defn mat-cols [^borrow m : mat] : int (.cols m))
  ;;; mat-shape -- (cons rows cols).
  (defn mat-shape [^borrow m : mat] : int (cons (.rows m) (.cols m)))
  ;;; mat-get -- element at (r, c), row-major. Bounds-checked by the backing Vec.
  (defn mat-get [^borrow m : mat r : int c : int] : float
    (:: (vec-get (.data m) (+ (* r (.cols m)) c)) :float))
  ;;; mat-set! -- set element at (r, c).
  (defn mat-set! [^borrow m : mat r : int c : int v : float] : void
    (vec-set! (.data m) (+ (* r (.cols m)) c) v))
  ;;; mat-free -- free the matrix and its backing buffer.
  (defn mat-free [m : mat] : void (vec-free (.data m)))
  ;;; mat-identity -- n x n identity matrix.
  (defn mat-identity [n : int] : mat
    (let [m      (mat-new n n)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n) 0 (do (mat-set! m i i 1.0) (set! i (+ i 1)) (go))))]
        (go))
      m))
  ;;; mat-diag -- n x n diagonal matrix from a vector's elements.
  (defn mat-diag [^borrow v : lavec] : mat
    (let [n      (la-vec-len v)
          m      (mat-new n n)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do (mat-set! m i i (la-vec-get v i)) (set! i (+ i 1)) (go))))]
        (go))
      m))
  ;;; mat-copy -- deep copy.
  (defn mat-copy [^borrow m : mat] : mat
    (let [rows   (.rows m)
          cols   (.cols m)
          c      (mat-new rows cols)
          n      (* rows cols)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do
                     (vec-set! (.data c) i (:: (vec-get (.data m) i) :float))
                     (set! i (+ i 1))
                     (go))))]
        (go))
      c))
  ;;; mat-row -- copy of row r as a vector.
  (defn mat-row [^borrow m : mat r : int] : lavec
    (let [cols   (.cols m)
          v      (la-vec-new cols)
          ^mut c 0]
      (letrec [go
               (fn [] : int
                 (if (>= c cols)
                   0
                   (do (la-vec-set! v c (mat-get m r c)) (set! c (+ c 1)) (go))))]
        (go))
      v))
  ;;; mat-col -- copy of column c as a vector.
  (defn mat-col [^borrow m : mat c : int] : lavec
    (let [rows   (.rows m)
          v      (la-vec-new rows)
          ^mut r 0]
      (letrec [go
               (fn [] : int
                 (if (>= r rows)
                   0
                   (do (la-vec-set! v r (mat-get m r c)) (set! r (+ r 1)) (go))))]
        (go))
      v))
  ;;; mat-submat -- copy of submatrix [r0,r1) x [c0,c1).
  (defn mat-submat [^borrow m : mat r0 : int c0 : int r1 : int c1 : int] : mat
    (let [sr     (- r1 r0)
          sc     (- c1 c0)
          sub    (mat-new sr sc)
          ^mut i 0]
      (letrec [gor
               (fn [] : int
                 (if (>= i sr)
                   0
                   (let [^mut j 0]
                     (letrec [goc
                              (fn [] : int
                                (if (>= j sc)
                                  0
                                  (do
                                    (mat-set! sub
                                      i
                                      j
                                      (mat-get m (+ r0 i) (+ c0 j)))
                                    (set! j (+ j 1))
                                    (goc))))]
                       (goc))
                     (set! i (+ i 1))
                     (gor))))]
        (gor))
      sub))
  ;;; LA1 -- arithmetic
  ;;; Private: element-wise binary op over equal-shaped matrices producing a new
  ;;; matrix. `op` is applied as a flat index walk over the shared length.
  (defn __mat-zipwith-add [^borrow a : mat ^borrow b : mat] : mat
    (let [rows   (.rows a)
          cols   (.cols a)
          c      (mat-new rows cols)
          n      (* rows cols)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do
                     (vec-set! (.data c)
                       i
                       (+ (:: (vec-get (.data a) i) :float)
                         (:: (vec-get (.data b) i) :float)))
                     (set! i (+ i 1))
                     (go))))]
        (go))
      c))
  ;;; mat-add -- element-wise addition (dimensions must match).
  (defn mat-add [^borrow a : mat ^borrow b : mat] : mat
    (when (or (not= (.rows a) (.rows b)) (not= (.cols a) (.cols b)))
      (panic "mat-add: dimension mismatch"))
    (__mat-zipwith-add a b))
  ;;; mat-sub -- element-wise subtraction.
  (defn mat-sub [^borrow a : mat ^borrow b : mat] : mat
    (when (or (not= (.rows a) (.rows b)) (not= (.cols a) (.cols b)))
      (panic "mat-sub: dimension mismatch"))
    (let [rows   (.rows a)
          cols   (.cols a)
          c      (mat-new rows cols)
          n      (* rows cols)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do
                     (vec-set! (.data c)
                       i
                       (- (:: (vec-get (.data a) i) :float)
                         (:: (vec-get (.data b) i) :float)))
                     (set! i (+ i 1))
                     (go))))]
        (go))
      c))
  ;;; mat-scale -- scalar multiplication.
  (defn mat-scale [^borrow m : mat s : float] : mat
    (let [rows   (.rows m)
          cols   (.cols m)
          c      (mat-new rows cols)
          n      (* rows cols)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do
                     (vec-set! (.data c)
                       i
                       (* (:: (vec-get (.data m) i) :float) s))
                     (set! i (+ i 1))
                     (go))))]
        (go))
      c))
  ;;; linalg-blas? -- whether the BLAS/LAPACK backend is in use.
  ;;;
  ;;; The backend is compiled in by building with `-DTUR_LINALG_BLAS` and
  ;;; linking a BLAS/LAPACK (see the linalg guide); setting the environment
  ;;; variable TUR_LINALG_NO_BLAS to a non-empty value turns it off at run
  ;;; time, which is how the tests compare the two paths in one process.
  ;;;
  ;;; Returns:
  ;;;   true when this build carries the backend and it is not switched off.
  ;;;
  ;;; Example:
  ;;;   (println (if (linalg-blas?) "BLAS" "pure"))
  ;;;
  ;;; Since: 0.2.0
  (defn linalg-blas? [] : bool
    ```c
    #include <stdlib.h>
    #if defined(TUR_LINALG_BLAS)
    const char *e = getenv("TUR_LINALG_NO_BLAS");
    return !(e && *e);
    #else
    return 0;
    #endif
    ```)
  ;;; LB5 -- cache-blocked multiply.
  ;;; __mat-mul-kernel -- C (m x p) = A (m x n) * B (n x p), all row-major.
  ;;; Under -DTUR_LINALG_BLAS this is cblas_dgemm (see `linalg-blas?`).
  ;;; Tiled over i/k/j in TUR_LINALG_BLOCK-sized blocks (default 64; override
  ;;; with `:build-opts #map{:c-flags ["-DTUR_LINALG_BLOCK=32"]}`) so each
  ;;; block of B is reused from cache across a block of A's rows. The inner
  ;;; loop runs along a row of B and of C, which is unit-stride for both.
  (defn __mat-mul-kernel [Cd : (Vec float)
                          Ad : (Vec float)
                          Bd : (Vec float)
                          m : int
                          n : int
                          p : int] : int
    ```c
    #include <stdlib.h>
    struct __V { int64_t *data; int64_t len; int64_t cap; };
  double *C = (double*)(void*)((struct __V*)(intptr_t)Cd)->data;
  const double *A = (const double*)(void*)((struct __V*)(intptr_t)Ad)->data;
  const double *B = (const double*)(void*)((struct __V*)(intptr_t)Bd)->data;
#if defined(TUR_LINALG_BLAS)
  if (m > 0 && n > 0 && p > 0 && !(getenv("TUR_LINALG_NO_BLAS") && *getenv("TUR_LINALG_NO_BLAS"))) {
    extern void cblas_dgemm(int, int, int, int, int, int, double, const double *, int,
                            const double *, int, double, double *, int);
    cblas_dgemm(101, 111, 111, (int)m, (int)p, (int)n, 1.0, A, (int)n, B, (int)p, 0.0, C, (int)p);
    return 0;
  }
#endif
#ifndef TUR_LINALG_BLOCK
#define TUR_LINALG_BLOCK 64
#endif
  const int64_t BS = TUR_LINALG_BLOCK;
  for (int64_t i = 0; i < m * p; i++) C[i] = 0.0;
  for (int64_t ii = 0; ii < m; ii += BS) {
    int64_t ie = ii + BS < m ? ii + BS : m;
    for (int64_t kk = 0; kk < n; kk += BS) {
      int64_t ke = kk + BS < n ? kk + BS : n;
      for (int64_t jj = 0; jj < p; jj += BS) {
        int64_t je = jj + BS < p ? jj + BS : p;
        for (int64_t i = ii; i < ie; i++) {
          double *Ci = C + i * p;
          const double *Ai = A + i * n;
          for (int64_t k = kk; k < ke; k++) {
            double aik = Ai[k];
            const double *Bk = B + k * p;
            for (int64_t j = jj; j < je; j++) Ci[j] += aik * Bk[j];
          }
        }
      }
    }
  }
  return 0;
  ```)
  ;;; mat-mul -- matrix multiplication: (m x n) * (n x p) -> (m x p).
  ;;; Cache-blocked; see `__mat-mul-kernel`.
  (defn mat-mul [^borrow a : mat ^borrow b : mat] : mat
    (when (not= (.cols a) (.rows b)) (panic "mat-mul: incompatible dimensions"))
    (let [c (mat-new-zeroed (.rows a) (.cols b))]
      (__mat-mul-kernel (.data c)
        (.data a)
        (.data b)
        (.rows a)
        (.cols a)
        (.cols b))
      c))
  ;;; __mat-mul-vec-kernel -- y (m) = A (m x n) x (n); cblas_dgemv under
  ;;; -DTUR_LINALG_BLAS.
  (defn __mat-mul-vec-kernel [yd : (Vec float)
                              Ad : (Vec float)
                              xd : (Vec float)
                              m : int
                              n : int] : int
    ```c
    #include <stdlib.h>
    struct __V { int64_t *data; int64_t len; int64_t cap; };
  double *y = (double*)(void*)((struct __V*)(intptr_t)yd)->data;
  const double *A = (const double*)(void*)((struct __V*)(intptr_t)Ad)->data;
  const double *x = (const double*)(void*)((struct __V*)(intptr_t)xd)->data;
#if defined(TUR_LINALG_BLAS)
  if (m > 0 && n > 0 && !(getenv("TUR_LINALG_NO_BLAS") && *getenv("TUR_LINALG_NO_BLAS"))) {
    extern void cblas_dgemv(int, int, int, int, double, const double *, int, const double *, int,
                            double, double *, int);
    cblas_dgemv(101, 111, (int)m, (int)n, 1.0, A, (int)n, x, 1, 0.0, y, 1);
    return 0;
  }
#endif
  for (int64_t i = 0; i < m; i++) {
    double s = 0.0;
    const double *Ai = A + i * n;
    for (int64_t k = 0; k < n; k++) s += Ai[k] * x[k];
    y[i] = s;
  }
  return 0;
  ```)
  ;;; mat-mul-vec -- matrix-vector multiplication: (m x n) * n-vec -> m-vec.
  (defn mat-mul-vec [^borrow m : mat ^borrow v : lavec] : lavec
    (when (not= (.cols m) (la-vec-len v))
      (panic "mat-mul-vec: incompatible dimensions"))
    (let [result (la-vec-new (.rows m))]
      (__mat-mul-vec-kernel (.data result)
        (.data m)
        (.data v)
        (.rows m)
        (.cols m))
      result))
  ;;; mat-transpose -- transpose: (m x n) -> (n x m).
  (defn mat-transpose [^borrow m : mat] : mat
    (let [rows   (.rows m)
          cols   (.cols m)
          t      (mat-new cols rows)
          ^mut r 0]
      (letrec [gor
               (fn [] : int
                 (if (>= r rows)
                   0
                   (let [^mut c 0]
                     (letrec [goc
                              (fn [] : int
                                (if (>= c cols)
                                  0
                                  (do
                                    (mat-set! t c r (mat-get m r c))
                                    (set! c (+ c 1))
                                    (goc))))]
                       (goc))
                     (set! r (+ r 1))
                     (gor))))]
        (gor))
      t))
  ;;; mat-trace -- sum of diagonal elements (square matrices).
  (defn mat-trace [^borrow m : mat] : float
    (when (not= (.rows m) (.cols m)) (panic "mat-trace: matrix must be square"))
    (let [n (.rows m)]
      (letrec [go
               (fn [i : int acc : float] : float
                 (if (>= i n) acc (go (+ i 1) (+ acc (mat-get m i i)))))]
        (go 0 0.0))))
  ;;; mat-norm-fro -- Frobenius norm.
  (defn mat-norm-fro [^borrow m : mat] : float
    (let [n (* (.rows m) (.cols m))]
      (letrec [go
               (fn [i : int acc : float] : float
                 (if (>= i n)
                   acc
                   (let [x (:: (vec-get (.data m) i) :float)]
                     (go (+ i 1) (+ acc (* x x))))))]
        (sqrt (go 0 0.0)))))
  ;;; mat-norm-max -- maximum absolute element.
  (defn mat-norm-max [^borrow m : mat] : float
    (let [n (* (.rows m) (.cols m))]
      (letrec [go
               (fn [i : int acc : float] : float
                 (if (>= i n)
                   acc
                   (let [a (fabs (:: (vec-get (.data m) i) :float))]
                     (go (+ i 1) (if (> a acc) a acc)))))]
        (go 0 0.0))))
  ;;; mat-square? -- 1 if rows == cols else 0.
  (defn mat-square? [^borrow m : mat] : int (if (= (.rows m) (.cols m)) 1 0))
  ;;; mat-approx-eq? -- 1 if all elements within tol and shapes match, else 0.
  (defn mat-approx-eq? [^borrow a : mat ^borrow b : mat tol : float] : int
    (if (or (not= (.rows a) (.rows b)) (not= (.cols a) (.cols b)))
      0
      (let [n (* (.rows a) (.cols a))]
        (letrec [go
                 (fn [i : int] : int
                   (if (>= i n)
                     1
                     (if (> (fabs (- (:: (vec-get (.data a) i) :float)
                                    (:: (vec-get (.data b) i) :float)))
                           tol)
                       0
                       (go (+ i 1)))))]
          (go 0)))))
  ;;; la-vec-outer -- outer product of two vectors: a (len m) (x) b (len n)
  ;;; -> (m x n) matrix. (Lives here, not in linalg/vec, because it produces a
  ;;; mat; keeping it here avoids a vec<->mat module import cycle.)
  (defn la-vec-outer [^borrow a : lavec ^borrow b : lavec] : mat
    (let [am     (la-vec-len a)
          bn     (la-vec-len b)
          c      (mat-new am bn)
          ^mut i 0]
      (letrec [goi
               (fn [] : int
                 (if (>= i am)
                   0
                   (let [^mut j 0]
                     (letrec [goj
                              (fn [] : int
                                (if (>= j bn)
                                  0
                                  (do
                                    (mat-set! c
                                      i
                                      j
                                      (* (la-vec-get a i) (la-vec-get b j)))
                                    (set! j (+ j 1))
                                    (goj))))]
                       (goj))
                     (set! i (+ i 1))
                     (goi))))]
        (goi))
      c))) ;; end defmodule linalg/mat
