;;; pca_test.tur -- SM1: principal component analysis on an iris-style
;;; 4-column dataset. Reference values are numpy's SVD of the centred data.
(defmodule multivariate/pca-test
  (import linalg/vec :refer [lavec la-vec-get la-vec-len la-vec-free])
  (import linalg/mat
    :refer
    [mat mat-of mat-get mat-rows mat-cols mat-mul mat-transpose mat-identity mat-approx-eq? mat-free])
  (import multivariate/pca
    :refer
    [PCAOpts PcaResult pca-opts pca pca-free pca-project pca-reconstruct pca-var-explained])
  ;; --- TAP harness (inline-C fail counter) ---
  (defn check [idx : int name : cstr ok : bool] : void
    ```c
    /* __tur_include__: static int g_pc_fails = 0; */
  if (!ok) g_pc_fails++;
  printf("%s %lld - %s\n", ok ? "ok" : "not ok", (long long)idx, (const char *)name);
  ```)
  (defn finish [count : int] : int
    ```c
    printf("1..%lld\n", (long long)count);
  if (g_pc_fails == 0) {
    fprintf(stderr, "# All %lld pca tests passed.\n", (long long)count);
    return 0;
  }
  fprintf(stderr, "# %d/%lld pca tests failed.\n", g_pc_fails, (long long)count);
  return 1;
  ```)
  (defn fa [x : float] : float ```c return x < 0.0 ? -x : x; ```)
  (defn approx [a : float b : float] : bool (< (fa (- a b)) 1e-12))
  ;;; iris15 -- five rows from each of the three iris species (4 columns).
  (defn iris15 [] : mat
    (mat-of 15 4
      5.1 3.5 1.4 0.2  4.9 3.0 1.4 0.2  4.7 3.2 1.3 0.2  4.6 3.1 1.5 0.2  5.0 3.6 1.4 0.2
      7.0 3.2 4.7 1.4  6.4 3.2 4.5 1.5  6.9 3.1 4.9 1.5  5.5 2.3 4.0 1.3  6.5 2.8 4.6 1.5
      6.3 3.3 6.0 2.5  5.8 2.7 5.1 1.9  7.1 3.0 5.9 2.1  6.3 2.9 5.6 1.8  6.5 3.0 5.8 2.2))
  (defn near [a : float b : float tol : float] : bool (< (fa (- a b)) tol))
  (defn t-sdev [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true false 0))]
      (let [ok (and (near (la-vec-get (.sdev r) 0) 2.20779101 1e-08)
                 (and (near (la-vec-get (.sdev r) 1) 0.42774073 1e-08)
                   (and (near (la-vec-get (.sdev r) 2) 0.26293939 1e-08)
                     (near (la-vec-get (.sdev r) 3) 0.07645455 1e-08))))]
        (pca-free r)
        (mat-free x)
        ok)))
  (defn t-prop [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true false 0))]
      (let [ok (and (near (la-vec-get (.var-prop r) 0) 0.9497408 1e-07)
                 (near (la-vec-get (.var-prop r) 1) 0.03564925 1e-08))]
        (pca-free r)
        (mat-free x)
        ok)))
  (defn t-cum-reaches-one [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true false 0))]
      (let [ok (and (near (pca-var-explained r 4) 1.0 1e-12)
                 (near (+ (+ (la-vec-get (.var-prop r) 0) (la-vec-get (.var-prop r) 1))
                         (+ (la-vec-get (.var-prop r) 2) (la-vec-get (.var-prop r) 3)))
                   1.0
                   1e-12))]
        (pca-free r)
        (mat-free x)
        ok)))
  (defn t-loadings-orthonormal [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true false 0))]
      (let [lt (mat-transpose (.loadings r))
            p  (mat-mul lt (.loadings r))
            i  (mat-identity 4)
            ok (= (mat-approx-eq? p i 1e-12) 1)]
        (mat-free i)
        (mat-free p)
        (mat-free lt)
        (pca-free r)
        (mat-free x)
        ok)))
  (defn t-reconstruct-all [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true false 0))
          y (pca-reconstruct r 4)]
      (let [ok (= (mat-approx-eq? x y 1e-12) 1)] (mat-free y) (pca-free r) (mat-free x) ok)))
  (defn t-reconstruct-scaled [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true true 0))
          y (pca-reconstruct r 4)]
      (let [ok (= (mat-approx-eq? x y 1e-12) 1)] (mat-free y) (pca-free r) (mat-free x) ok)))
  (defn t-scaled-prop [] : bool
    ;; numpy on the standardized data: [0.73537275 0.22292488 ...]
    (let [x (iris15)
          r (pca x (pca-opts true true 0))]
      (let [ok (and (near (la-vec-get (.var-prop r) 0) 0.73537275 1e-08)
                 (near (la-vec-get (.var-prop r) 1) 0.22292488 1e-08))]
        (pca-free r)
        (mat-free x)
        ok)))
  (defn t-ncomp [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true false 2))]
      (let [ok (and (= (mat-cols (.loadings r)) 2)
                 (and (= (mat-cols (.scores r)) 2)
                   (and (= (mat-rows (.scores r)) 15)
                     (near (pca-var-explained r 2) (+ 0.9497408 0.03564925) 1e-07))))]
        (pca-free r)
        (mat-free x)
        ok)))
  (defn t-project-matches-scores [] : bool
    (let [x (iris15)
          r (pca x (pca-opts true true 3))
          s (pca-project r x)]
      (let [ok (= (mat-approx-eq? s (.scores r) 1e-12) 1)] (mat-free s) (pca-free r) (mat-free x) ok)))
  (defn main [] : int
    (check 1 "pca: component sdevs match numpy" (t-sdev))
    (check 2 "pca: variance proportions match numpy" (t-prop))
    (check 3 "pca: cumulative variance reaches 1" (t-cum-reaches-one))
    (check 4 "pca: loadings' loadings = I" (t-loadings-orthonormal))
    (check 5 "pca-reconstruct: all components recover X" (t-reconstruct-all))
    (check 6 "pca-reconstruct: also when scaled" (t-reconstruct-scaled))
    (check 7 "pca: scaled (correlation) proportions" (t-scaled-prop))
    (check 8 "pca: ncomp truncates" (t-ncomp))
    (check 9 "pca-project reproduces the scores" (t-project-matches-scores))
    (finish 9))) ;; end defmodule multivariate/pca-test
