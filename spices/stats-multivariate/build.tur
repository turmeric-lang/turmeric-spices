(defpackage tur-stats-multivariate
  :name "tur-stats-multivariate"
  :version "0.1.0"
  :description "Multivariate statistics: covariance matrices, PCA, factor analysis, multivariate OLS, Hotelling T2 / MANOVA, LDA"
  :license "MIT"
  :spices #map{"linalg" #map{:path "../linalg"
                             :url "https://github.com/turmeric-lang/turmeric-spices"
                             :ref "linalg-v0.2.0"
                             :subdir "spices/linalg"
                             :optional false}
               "stats" #map{:path "../stats"
                            :url "https://github.com/turmeric-lang/turmeric-spices"
                            :ref "stats-v0.1.0"
                            :subdir "spices/stats"
                            :optional false}
               "frame" #map{:path "../frame"
                            :url "https://github.com/turmeric-lang/turmeric-spices"
                            :ref "frame-v0.1.0"
                            :subdir "spices/frame"
                            :optional false}}
  :exports #map{"multivariate/cov" ["cov-mat"
                                    "cov-mat-pop"
                                    "cor-mat"
                                    "col-means"
                                    "col-sds"
                                    "mahalanobis"
                                    "mahalanobis-auto"
                                    "mv-pinv"]
                "multivariate/pca" ["PCAOpts"
                                    "PcaResult"
                                    "pca-opts"
                                    "pca"
                                    "pca-free"
                                    "pca-project"
                                    "pca-reconstruct"
                                    "pca-var-explained"]
                "multivariate/factor" ["FAOpts"
                                       "FaResult"
                                       "fa-opts"
                                       "factor-analysis"
                                       "fa-free"
                                       "fa-scores"]
                "multivariate/regress" ["MvOlsResult"
                                        "mv-ols"
                                        "mv-ols-free"
                                        "mv-predict"
                                        "mv-r-squared"]
                "multivariate/test" ["HotellingResult"
                                     "ManovaResult"
                                     "hotelling-1samp"
                                     "hotelling-2samp"
                                     "manova-1way"]
                "multivariate/lda" ["LDAOpts"
                                    "LdaResult"
                                    "lda-opts"
                                    "lda-opts-default"
                                    "lda-opts-free"
                                    "lda-fit"
                                    "lda-free"
                                    "lda-predict"
                                    "lda-posterior"
                                    "lda-transform"]
                "multivariate/fmt" ["pca->str"
                                    "pca-print"
                                    "pca-print-loadings"
                                    "fa->str"
                                    "fa-print"
                                    "mv-regress->str"
                                    "mv-regress-print"
                                    "hotelling->str"
                                    "hotelling-print"
                                    "manova->str"
                                    "manova-print"
                                    "lda->str"
                                    "lda-print"
                                    "mv-str-free"]})
