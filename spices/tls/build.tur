(defpackage tur-tls
  :name "tur-tls"
  :version "0.3.0"
  :description "TLS termination for tur/httpd via mbedTLS"
  :license "MIT"
  :cmake-deps #map{"mbedtls" #map{:url "https://github.com/Mbed-TLS/mbedtls"
                                  :ref "v3.6.2"
                                  :targets ["mbedtls" "mbedx509" "mbedcrypto"]
                                  :options #map{:ENABLE_PROGRAMS "OFF"
                                                :ENABLE_TESTING "OFF"
                                                :USE_SHARED_MBEDTLS_LIBRARY "OFF"
                                                :USE_STATIC_MBEDTLS_LIBRARY "ON"
                                                ;; mbedtls's own CMakeLists turns MBEDTLS_FATAL_WARNINGS
                                                ;; on by default, appending -Werror to its build. Newer
                                                ;; Clang (AppleClang 21+) promoted -Wunterminated-string-
                                                ;; initialization to a default warning, which fires on
                                                ;; mbedtls's deliberately-non-null-terminated TLS 1.3
                                                ;; label array initializers (ssl_tls13_keys.c) and turns
                                                ;; the whole vendored build into a hard error. We do not
                                                ;; own this source; only turn off ITS fatal-warnings
                                                ;; policy, not any warning strictness of our own code.
                                                :MBEDTLS_FATAL_WARNINGS "OFF"}}}
  :exports #map{"tls/autolink" ["tls-autolink-hint"]
                "tls/ctx" ["TlsCtx"
                           "tls-ctx-null?"
                           "tls-ctx-new"
                           "tls-ctx-free"
                           "tls-ctx-load-cert-pem"
                           "tls-ctx-load-key-pem"]
                "tls/conn" ["TlsConn"
                            "tls-conn-null?"
                            "tls-wrap-fd"
                            "tls-handshake"
                            "tls-read"
                            "tls-write"
                            "tls-shutdown"
                            "tls-free"]
                "tls/httpd" ["tls-httpd-init"]})
