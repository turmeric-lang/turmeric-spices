;; transform.tur -- xml/transform: the identity gates and real transforms.
;;
;; The gates (xml-html-parsers-plan B4):
;;   namespaces off -- the identity transform's output is dom-serialize of the
;;                     same document, byte for byte;
;;   namespaces on  -- names arrive in Clark form and the writer picks the
;;                     prefixes, so the bytes differ; the event stream of the
;;                     output equals the event stream of the input.
;; fixtures/conformance.tur runs the first gate over xmltest valid/sa too.

(defmodule xml_transform_test (export)

(import dom/ownstr :refer [String from-cstr to-cstr release string=?])
(import dom/core   :refer [Document ParseError dom-node dom-free dom-serialize
                           parse-error-message parse-error-release])
(import dom/event  :refer [SaxEvent SaxControl Attr StartElement EndElement
                           Chars Comment Pi StartCdata EndCdata Doctype
                           Continue Stop sax-event-release])
(import dom/edit   :refer [EditError BadPlacement BadName BadContent])
(import dom/writer :refer [WriteError Rejected IoFailed TransformError
                           InputError OutputError transform-error-message
                           transform-error-release sax-keep])
(import xml/sax    :refer [ParseOpts default-parse-opts sax-parse-string-opts])
(import xml/dom    :refer [dom-parse-string-opts])
(import xml/transform :refer [sax-transform sax-transform-opts sax-transform-file])
(import test/suite  :refer [describe it])
(import test/assert :refer [assert-true assert-eq])
(import test/runner :refer [run-all-status])

;;; ns-off -- XML 1.0 without Namespaces.
(defn ns-off [] : ParseOpts
  (with (default-parse-opts) [namespaces false]))

;;; same? -- byte equality, printing both sides when they differ.
(defn same? [got : cstr want : cstr] : bool
  ```c
  #include <stdio.h>
  #include <string.h>
  if (strcmp((const char *)got, (const char *)want) == 0) return true;
  fprintf(stderr, "# got:  [%s]\n# want: [%s]\n", (const char *)got, (const char *)want);
  return false;
  ```)

;;; out-is? -- did a transform succeed with exactly `want`?
(defn out-is? [r : (Result String TransformError) want : cstr] : bool
  (match r
    (Ok s)  (let [ok (same? (to-cstr s) want)] (release s) ok)
    (Err e) (do (same? (transform-error-message e) want)
                (transform-error-release e)
                false)))

;;; gate-off? -- namespaces off: identity output == dom-serialize.
(defn gate-off? [src : cstr] : bool
  (match (dom-parse-string-opts src (ns-off))
    (Err _) (same? "dom-parse failed" src)
    (Ok d)  (let [want (dom-serialize (dom-node d))
                  ok   (out-is? (sax-transform-opts src (ns-off) sax-keep)
                                (to-cstr want))]
              (release want)
              (dom-free d)
              ok)))

;; ---- event traces, for the namespaces-on gate -----------------------------

;;; tr-reset -- clear trace `which` (0 or 1) and make it current.
(defn tr-reset [which : int] : nil
  ```c
  /* __tur_include__: #include <stddef.h> */
  /* __tur_include__: #include <stdint.h> */
  /* __tur_include__: static char *g_xtr[2] = {0, 0}; */
  /* __tur_include__: static size_t g_xtr_len[2] = {0, 0}, g_xtr_cap[2] = {0, 0}; */
  /* __tur_include__: static int g_xtr_cur = 0; */
  g_xtr_len[which] = 0;
  if (g_xtr[which]) g_xtr[which][0] = '\0';
  g_xtr_cur = (int)which;
  ```)

;;; tr-put -- append to the current trace.
(defn tr-put [s : cstr] : nil
  ```c
  int w = g_xtr_cur;
  size_t n = strlen((const char *)s);
  if (g_xtr_len[w] + n + 1 > g_xtr_cap[w]) {
    size_t cap = g_xtr_cap[w] ? g_xtr_cap[w] : 256;
    while (cap < g_xtr_len[w] + n + 1) cap *= 2;
    g_xtr[w] = (char *)realloc(g_xtr[w], cap);
    g_xtr_cap[w] = cap;
  }
  memcpy(g_xtr[w] + g_xtr_len[w], s, n);
  g_xtr_len[w] += n;
  g_xtr[w][g_xtr_len[w]] = '\0';
  ```)

;;; tr-same? -- are both traces identical and non-empty?
(defn tr-same? [] : bool
  ```c
  #include <stdio.h>
  const char *a = g_xtr[0] ? g_xtr[0] : "", *b = g_xtr[1] ? g_xtr[1] : "";
  if (a[0] && strcmp(a, b) == 0) return true;
  fprintf(stderr, "# trace 0: [%s]\n# trace 1: [%s]\n", a, b);
  return false;
  ```)

;;; tr-attrs -- " name=value" per attribute.
(defn tr-attrs [xs : (Cons Attr)] : nil
  (if (tnil? xs)
    nil
    (do (tr-put " ") (tr-put (to-cstr (.name (thead xs))))
        (tr-put "=") (tr-put (to-cstr (.value (thead xs))))
        (tr-attrs (ttail xs)))))

;;; trace -- record one event.
(defn trace [e : SaxEvent] : SaxControl
  (do
    (match e
      (StartElement n as) (do (tr-put "S ") (tr-put (to-cstr n)) (tr-attrs as) (tr-put "|"))
      (EndElement n)      (do (tr-put "E ") (tr-put (to-cstr n)) (tr-put "|"))
      (Chars t)           (do (tr-put "T ") (tr-put (to-cstr t)) (tr-put "|"))
      (Comment t)         (do (tr-put "C ") (tr-put (to-cstr t)) (tr-put "|"))
      (Pi t d)            (do (tr-put "P ") (tr-put (to-cstr t)) (tr-put " ")
                              (tr-put (to-cstr d)) (tr-put "|"))
      (StartCdata)        (tr-put "[|")
      (EndCdata)          (tr-put "]|")
      (Doctype n p s)     (do (tr-put "D ") (tr-put (to-cstr n)) (tr-put " ")
                              (tr-put (to-cstr p)) (tr-put " ")
                              (tr-put (to-cstr s)) (tr-put "|")))
    (Continue)))

;;; parsed? -- did a parse succeed?
(defn parsed? [r : (Result nil ParseError)] : bool
  (match r (Ok _) true (Err _) false))

;;; gate-on? -- namespaces on: the identity output's events are the input's.
(defn gate-on? [src : cstr] : bool
  (match (sax-transform src sax-keep)
    (Err e) (do (same? (transform-error-message e) src)
                (transform-error-release e)
                false)
    (Ok out) (do
               (tr-reset 0)
               (let [p0 (parsed? (sax-parse-string-opts src (default-parse-opts) trace))]
                 (tr-reset 1)
                 (let [p1 (parsed? (sax-parse-string-opts (to-cstr out) (default-parse-opts)
                                                          trace))
                       ok (and p0 p1 (tr-same?))]
                   (release out)
                   ok)))))

;; ---- transforms ----------------------------------------------------------

;;; renamed -- n renamed to `to` if it is `from`, else n; consumes n.
(defn renamed [n : String from : cstr to : cstr] : String
  (if (string=? n from)
    (do (release n) (from-cstr to))
    n))

;;; item->entry -- rename <item> to <entry>.
(defn item->entry [ev : SaxEvent] : (Cons SaxEvent)
  (match ev
    (StartElement n as) (tcons-of (StartElement (renamed n "item" "entry") as) (tnil))
    (EndElement n)      (tcons-of (EndElement (renamed n "item" "entry")) (tnil))
    _                   (sax-keep ev)))

;;; no-comments -- drop every comment.
(defn no-comments [ev : SaxEvent] : (Cons SaxEvent)
  (match ev
    (Comment _) (do (sax-event-release ev) (tnil))
    _           (sax-keep ev)))

;;; stamp -- give every <item> a checked="yes" attribute.
(defn stamp [ev : SaxEvent] : (Cons SaxEvent)
  (match ev
    (StartElement n as) (if (string=? n "item")
                          (tcons-of (StartElement n (tcons-of (Attr (from-cstr "checked")
                                                                    (from-cstr "yes"))
                                                              as))
                                    (tnil))
                          (sax-keep ev))
    _                   (sax-keep ev)))

;;; drop-secret -- drop every <secret> element with all it contains.
(defn drop-secret [src : cstr] : (Result String TransformError)
  (let [^mut depth 0]
    (sax-transform-opts src (ns-off)
      (fn [ev : SaxEvent] : (Cons SaxEvent)
        (match ev
          (StartElement n as) (if (or (> depth 0) (string=? n "secret"))
                                (do (set! depth (+ depth 1))
                                    (sax-event-release ev)
                                    (tnil))
                                (sax-keep ev))
          (EndElement n)      (if (> depth 0)
                                (do (set! depth (- depth 1))
                                    (sax-event-release ev)
                                    (tnil))
                                (sax-keep ev))
          _                   (if (> depth 0)
                                (do (sax-event-release ev) (tnil))
                                (sax-keep ev)))))))

;;; atom-prefix -- declare xmlns:atom on the root, so Clark names use it.
(defn atom-prefix [ev : SaxEvent] : (Cons SaxEvent)
  (match ev
    (StartElement n as) (if (string=? n "{http://www.w3.org/2005/Atom}feed")
                          (tcons-of (StartElement n (tcons-of (Attr (from-cstr "xmlns:atom")
                                                                    (from-cstr "http://www.w3.org/2005/Atom"))
                                                              as))
                                    (tnil))
                          (sax-keep ev))
    _                   (sax-keep ev)))

;;; second-root -- emit a stray element after the root ends.
(defn second-root [ev : SaxEvent] : (Cons SaxEvent)
  (match ev
    (EndElement n) (if (string=? n "r")
                     (tcons-of ev (tcons-of (StartElement (from-cstr "extra") (tnil))
                                            (tcons-of (EndElement (from-cstr "extra"))
                                                      (tnil))))
                     (sax-keep ev))
    _              (sax-keep ev)))

;;; bad-rename -- rename <r> to a name that is not a name.
(defn bad-rename [ev : SaxEvent] : (Cons SaxEvent)
  (match ev
    (StartElement n as) (tcons-of (StartElement (renamed n "r" "r onload=x") as) (tnil))
    _                   (sax-keep ev)))

;;; err-code -- 4/8/9 for a writer refusal, 10 IoFailed, 1 input, 0 ok.
(defn err-code [r : (Result String TransformError)] : int
  (match r
    (Ok s)                                 (do (release s) 0)
    (Err (OutputError (Rejected (BadPlacement)))) 4
    (Err (OutputError (Rejected (BadName))))      8
    (Err (OutputError (Rejected (BadContent))))   9
    (Err (OutputError (Rejected _)))              7
    (Err (OutputError (IoFailed)))                10
    (Err e)                                (do (transform-error-release e) 1)))

;; ---- files ----------------------------------------------------------------

;;; tmp-file -- write `body` to a per-process scratch file named by `tag`;
;;; returns the path (malloc'd).
(defn tmp-file [tag : cstr body : cstr] : cstr
  ```c
  #include <stdio.h>
  #include <stdlib.h>
  #include <unistd.h>
  char *p = (char *)malloc(96);
  snprintf(p, 96, "/tmp/tur-xml-transform-%ld-%s", (long)getpid(), (const char *)tag);
  FILE *f = fopen(p, "wb");
  if (f) { fputs((const char *)body, f); fclose(f); }
  return p;
  ```)

;;; file-is? -- does the file hold exactly want? Removes it.
(defn file-is? [path : cstr want : cstr] : bool
  ```c
  #include <stdio.h>
  #include <string.h>
  FILE *f = fopen((const char *)path, "rb");
  if (!f) return false;
  size_t n = strlen((const char *)want);
  char *buf = (char *)malloc(n + 2);
  size_t got = fread(buf, 1, n + 1, f);
  fclose(f);
  remove((const char *)path);
  bool ok = got == n && memcmp(buf, want, n) == 0;
  if (!ok) fprintf(stderr, "# file: [%.*s]\n# want: [%s]\n", (int)got, buf, (const char *)want);
  free(buf);
  return ok;
  ```)

;;; rm -- remove a file.
(defn rm [path : cstr] : nil
  ```c
  #include <stdio.h>
  remove((const char *)path);
  ```)

;;; utf8-doc -- non-ASCII names, attribute values and text (built in C:
;;; the source stays ASCII).
(defn utf8-doc [] : cstr
  ```c
  return "<caf\xc3\xa9 \xe6\x97\xa5='\xe2\x82\xac'>na\xc3\xafve \xf0\x9f\x98\x80</caf\xc3\xa9>";
  ```)

;;; big-doc -- `<r>` with n items, each with an attribute and text.
(defn big-doc [n : int] : cstr
  ```c
  #include <stdio.h>
  #include <stdlib.h>
  size_t cap = 64 + (size_t)n * 48, len = 0;
  char *p = (char *)malloc(cap);
  len += (size_t)snprintf(p + len, cap - len, "<r>");
  for (int64_t i = 0; i < n; i++)
    len += (size_t)snprintf(p + len, cap - len, "<item k=\"%lld\">t&amp;%lld</item>",
                            (long long)i, (long long)i);
  snprintf(p + len, cap - len, "</r>");
  return p;
  ```)

(defn __all-tests [] : void
  (describe "identity, namespaces off -- byte for byte dom-serialize"
    (it "elements, attributes, text and escaping"
      (gate-off? "<r a='1' b=\"x&amp;&lt;&gt;&quot;'\"><e/><e></e>t&amp;&lt;x&gt;</r>"))
    (it "attribute whitespace and character references"
      (gate-off? "<r a=\"&#9;tab&#10;nl&#13;cr\" b=\"  sp  \">&#x41;&#66;&#13;</r>"))
    (it "the prolog and epilog: declaration, doctype, comments, PIs"
      (gate-off? "<?xml version='1.0'?>\n<!DOCTYPE r [<!ENTITY e 'ent'>]>\n<!--c--><?pi data?>\n<r>&e;</r>\n<!--after--><?end?>"))
    (it "a doctype with public and system ids"
      (gate-off? "<!DOCTYPE r PUBLIC \"-//P//EN\" 'r\"x.dtd'><r/>"))
    (it "CDATA sections, empty and holding brackets"
      (gate-off? "<r><![CDATA[a<b&c]]]><![CDATA[]]>x<![CDATA[]] >]]></r>"))
    (it "names with colons are just names"
      (gate-off? "<a:b:c x:y='1' xmlns:q='urn:q'><q:d/></a:b:c>"))
    (it "UTF-8 text and names"
      (gate-off? (utf8-doc)))
    (it "mixed content and line ends"
      (gate-off? "<r>\r\n  <a>one</a>\r\n  two <b>three</b>\n</r>"))
    (it "a 2000-item document"
      (gate-off? (big-doc 2000))))

  (describe "identity, namespaces on -- the same events back"
    (it "a default namespace and a prefixed one"
      (gate-on? "<feed xmlns='urn:atom' xmlns:x='urn:x'><x:a x:k='1' plain='2'>t</x:a><b/></feed>"))
    (it "redeclarations, undeclaring the default, xml:lang"
      (gate-on? "<a xmlns='urn:1'><b xmlns='urn:2'><c xmlns='' xml:lang='en'/></b><p:d xmlns:p='urn:1'/></a>"))
    (it "a prefix rebound below"
      (gate-on? "<p:a xmlns:p='urn:1'><p:b xmlns:p='urn:2' p:k='v'><p:c/></p:b><p:c/></p:a>"))
    (it "attributes in two namespaces on one element"
      (gate-on? "<r xmlns:a='urn:a' xmlns:b='urn:b' a:k='1' b:k='2'/>"))
    (it "no namespaces at all"
      (gate-on? "<r><a k='v'>t</a><!--c--><?p d?><![CDATA[x]]></r>"))
    (it "the writer's prefixes are its own choice"
      (out-is? (sax-transform "<p:a xmlns:p='urn:u' p:k='1'><b/></p:a>" sax-keep)
               "<a xmlns=\"urn:u\" xmlns:ns1=\"urn:u\" ns1:k=\"1\"><b xmlns=\"\"/></a>")))

  (describe "transforms"
    (it "renames"
      (out-is? (sax-transform-opts "<list><item>a</item><item>b</item></list>" (ns-off) item->entry)
               "<list><entry>a</entry><entry>b</entry></list>"))
    (it "drops comments"
      (out-is? (sax-transform-opts "<r><!--x-->a<!--y--><e/></r>" (ns-off) no-comments)
               "<r>a<e/></r>"))
    (it "adds an attribute"
      (out-is? (sax-transform-opts "<r><item k='1'/><other/></r>" (ns-off) stamp)
               "<r><item checked=\"yes\" k=\"1\"/><other/></r>"))
    (it "drops a subtree, with state in a closure"
      (out-is? (drop-secret "<r><a/><secret k='v'>x<b>y</b><!--z--></secret><c/></r>")
               "<r><a/><c/></r>"))
    (it "chooses a prefix by declaring it"
      (out-is? (sax-transform "<feed xmlns='http://www.w3.org/2005/Atom'><entry/></feed>" atom-prefix)
               "<atom:feed xmlns:atom=\"http://www.w3.org/2005/Atom\"><atom:entry/></atom:feed>")))

  (describe "errors"
    (it "input that does not parse is an InputError"
      (assert-eq 1 (err-code (sax-transform "<r><a></r>" sax-keep))))
    (it "a second root from the transform is refused"
      (assert-eq 4 (err-code (sax-transform-opts "<r/>" (ns-off) second-root))))
    (it "a name that is not one is refused"
      (assert-eq 8 (err-code (sax-transform-opts "<r/>" (ns-off) bad-rename)))))

  (describe "sax-transform-file"
    (it "streams one file into another"
      (let [in  (tmp-file "in.xml" "<list><item>a</item><!--c--><item>b</item></list>")
            out (tmp-file "out.xml" "")
            r   (sax-transform-file in out (ns-off) item->entry)
            ok  (match r (Ok _) true (Err e) (do (transform-error-release e) false))]
        (rm in)
        (and (assert-true ok)
             (assert-true (file-is? out "<list><entry>a</entry><!--c--><entry>b</entry></list>")))))
    (it "a 2000-item file, identity"
      (let [src (big-doc 2000)
            in  (tmp-file "big.xml" src)
            out (tmp-file "big-out.xml" "")
            r   (sax-transform-file in out (ns-off) sax-keep)
            ok  (match r (Ok _) true (Err e) (do (transform-error-release e) false))]
        (rm in)
        (and (assert-true ok) (assert-true (file-is? out src)))))
    (it "a missing input is an InputError"
      (let [out (tmp-file "none-out.xml" "")
            c   (match (sax-transform-file "/nonexistent-tur/in.xml" out (ns-off) sax-keep)
                  (Ok _)  0
                  (Err (InputError e)) (do (parse-error-release e) 1)
                  (Err _) 2)]
        (rm out)
        (assert-eq 1 c)))
    (it "an output that cannot be created is IoFailed"
      (let [in (tmp-file "io-in.xml" "<r/>")
            c  (match (sax-transform-file in "/nonexistent-tur/out.xml" (ns-off) sax-keep)
                 (Ok _)                         0
                 (Err (OutputError (IoFailed))) 10
                 (Err e)                        (do (transform-error-release e) 1))]
        (rm in)
        (assert-eq 10 c)))))

(defn main [] : int
  (__all-tests)
  (run-all-status))

) ;; end defmodule xml_transform_test
