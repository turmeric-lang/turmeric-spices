;; sax_errors.tur -- every class of failure, its kind, message and position,
;; and the safe defaults (no external entities, bounded expansion, capped
;; depth and size).

(defmodule sax_errors_test (export)

(import dom/ownstr :refer [String to-cstr])
(import dom/core   :refer [ParseError ParseErrorKind Syntax Limit Refused Io
                           parse-error-message parse-error-pos SourcePos])
(import dom/event  :refer [SaxEvent SaxControl StartElement Chars Continue])
(import xml/sax    :refer [ParseOpts default-parse-opts sax-parse-string
                           sax-parse-string-opts sax-parse-file
                           sax-parse-file-opts])
(import test/suite  :refer [describe it])
(import test/assert :refer [assert-true assert-eq])
(import test/runner :refer [run-all-status])

;;; __contains? -- does `hay` contain `needle`? Prints both when not.
(defn __contains? [hay : cstr needle : cstr] : bool
  ```c
  #include <stdio.h>
  if (strstr((const char *)hay, (const char *)needle)) return true;
  fprintf(stderr, "# '%s' does not contain '%s'\n", hay, needle);
  return false;
  ```)

;;; ignore -- accept every event.
(defn ignore [e : SaxEvent] : SaxControl (Continue))

;;; kind-name -- a ParseErrorKind as text, for comparison.
(defn kind-name [k : ParseErrorKind] : cstr
  (match k
    (Syntax)  "syntax"
    (Limit)   "limit"
    (Refused) "refused"
    (Io)      "io"))

;;; fails-with? -- does `r` fail with this kind and a message containing msg?
(defn fails-with? [r : (Result nil ParseError) kind : cstr msg : cstr] : bool
  (match r
    (Ok _)  (do (println "# parse unexpectedly succeeded") false)
    (Err e) (and (__contains? (kind-name (.kind e)) kind)
                 (__contains? (parse-error-message e) msg))))

;;; at? -- does `r` fail at this line and column?
(defn at? [r : (Result nil ParseError) line : int col : int] : bool
  (match r
    (Ok _)  false
    (Err e) (let [p (parse-error-pos e)]
              (and (= (.line p) line) (= (.col p) col)))))

;;; syntax? -- a string that must fail as a syntax error with msg.
(defn syntax? [src : cstr msg : cstr] : bool
  (fails-with? (sax-parse-string src ignore) "syntax" msg))

;;; __write-tmp -- write `content` to a fresh temp file; its malloc'd path.
(defn __write-tmp [content : cstr] : cstr
  ```c
  #include <stdio.h>
  #include <stdlib.h>
  #include <unistd.h>
  char tmpl[] = "/tmp/tur-xml-test-XXXXXX";
  int fd = mkstemp(tmpl);
  if (fd < 0) return "";
  size_t n = strlen((const char *)content);
  if (write(fd, content, n) != (ssize_t)n) { close(fd); return ""; }
  close(fd);
  return strdup(tmpl);
  ```)

;;; __billion-laughs -- the classic exponential entity bomb.
(defn __billion-laughs [] : cstr
  ```c
  return "<?xml version=\"1.0\"?>\n"
         "<!DOCTYPE lolz [\n"
         " <!ENTITY lol \"lol\">\n"
         " <!ENTITY lol1 \"&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;\">\n"
         " <!ENTITY lol2 \"&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;\">\n"
         " <!ENTITY lol3 \"&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;\">\n"
         " <!ENTITY lol4 \"&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;\">\n"
         " <!ENTITY lol5 \"&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;\">\n"
         " <!ENTITY lol6 \"&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;\">\n"
         " <!ENTITY lol7 \"&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;\">\n"
         " <!ENTITY lol8 \"&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;\">\n"
         " <!ENTITY lol9 \"&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;\">\n"
         "]>\n"
         "<lolz>&lol9;</lolz>\n";
  ```)

;;; __bad-utf8 -- a document with a truncated two-byte UTF-8 sequence.
(defn __bad-utf8 [] : cstr
  ```c
  return "<a>\xC3\x28</a>";
  ```)

;;; __nested -- `depth` nested <d> elements.
(defn __nested [depth : int] : cstr
  ```c
  char *s = (char *)malloc((size_t)depth * 7 + 1);
  size_t o = 0;
  for (int64_t i = 0; i < depth; i++) { memcpy(s + o, "<d>", 3); o += 3; }
  for (int64_t i = 0; i < depth; i++) { memcpy(s + o, "</d>", 4); o += 4; }
  s[o] = '\0';
  return s;
  ```)

;;; count-starts -- how many StartElement events arrive before the result.
(defn count-starts [src : cstr] : int
  (let [^mut n 0]
    (sax-parse-string src
      (fn [e : SaxEvent] : SaxControl
        (match e
          (StartElement _ _) (do (set! n (+ n 1)) (Continue))
          _ (Continue))))
    n))

(defn __all-tests [] : void
  (describe "xml/sax -- well-formedness errors are Syntax"
    (it "mismatched tag" (syntax? "<a><b></a>" "mismatched tag"))
    (it "unclosed root (input ends inside it)" (syntax? "<a><b/>" "no element found"))
    (it "empty input" (syntax? "" "no element found"))
    (it "unclosed token" (syntax? "<a" "unclosed token"))
    (it "invalid token" (syntax? "<a>&</a>" "not well-formed"))
    (it "undefined entity" (syntax? "<a>&nope;</a>" "undefined entity"))
    (it "duplicate attribute" (syntax? "<a x=\"1\" x=\"2\"/>" "duplicate attribute"))
    (it "junk after the document element" (syntax? "<a/><b/>" "junk after document element"))
    (it "unbound namespace prefix" (syntax? "<p:a/>" "unbound prefix"))
    (it "invalid UTF-8" (syntax? (__bad-utf8) "not well-formed"))
    (it "reports the 1-based line and column of the error"
      (at? (sax-parse-string "<a>\n  <b></c>\n</a>" ignore) 2 8))
    (it "delivers every event before the error"
      (assert-eq 4 (count-starts "<a><b/><c><d></a>"))))

  (describe "xml/sax -- limits are Limit"
    (it "billion laughs is stopped by the amplification limit"
      (fails-with? (sax-parse-string (__billion-laughs) ignore) "limit" "amplification"))
    (it "nesting deeper than max-depth fails"
      (fails-with? (sax-parse-string-opts (__nested 5) (with (default-parse-opts) [max-depth 4]) ignore)
                   "limit" "maximum element depth 4"))
    (it "nesting at max-depth is fine"
      (match (sax-parse-string-opts (__nested 4) (with (default-parse-opts) [max-depth 4]) ignore)
        (Ok _) true (Err _) false))
    (it "the default depth cap is 256"
      (and (match (sax-parse-string (__nested 256) ignore) (Ok _) true (Err _) false)
           (fails-with? (sax-parse-string (__nested 257) ignore) "limit" "depth 256")))
    (it "input longer than max-bytes fails"
      (fails-with? (sax-parse-string-opts "<a>0123456789</a>" (with (default-parse-opts) [max-bytes 10]) ignore)
                   "limit" "max-bytes"))
    (it "max-bytes 0 means no cap"
      (match (sax-parse-string-opts "<a>0123456789</a>" (with (default-parse-opts) [max-bytes 0]) ignore)
        (Ok _) true (Err _) false)))

  (describe "xml/sax -- external entities are Refused by default"
    (it "a SYSTEM entity reference is refused, not loaded"
      (fails-with? (sax-parse-string "<!DOCTYPE a [<!ENTITY x SYSTEM \"/etc/passwd\">]><a>&x;</a>" ignore)
                   "refused" "external entity '/etc/passwd' refused"))
    (it "an external DTD subset is not fetched (and is no error)"
      (match (sax-parse-string "<!DOCTYPE a SYSTEM \"http://example.invalid/a.dtd\"><a/>" ignore)
        (Ok _) true (Err _) false))
    (it "with allow-external-entities, a local file is loaded"
      (let [path (__write-tmp "from a file")]
        (__keep-text "")
        (match (sax-parse-string-opts
                 (__subst "<!DOCTYPE a [<!ENTITY x SYSTEM \"PATH\">]><a>[&x;]</a>" path)
                 (with (default-parse-opts) [allow-external-entities true])
                 (fn [e : SaxEvent] : SaxControl
                   (match e
                     (Chars t) (do (__keep-text (to-cstr t)) (Continue))
                     _ (Continue))))
          (Ok _)  (__contains? (__kept-text) "[from a file]")
          (Err e) (do (println (parse-error-message e)) false))))
    (it "with allow-external-entities, a URL is still refused"
      (fails-with? (sax-parse-string-opts "<!DOCTYPE a [<!ENTITY x SYSTEM \"http://example.invalid/x\">]><a>&x;</a>"
                                          (with (default-parse-opts) [allow-external-entities true]) ignore)
                   "refused" "only local files")))

  (describe "xml/sax -- I/O errors are Io"
    (it "a missing file"
      (fails-with? (sax-parse-file "/nonexistent/tur-xml/missing.xml" ignore) "io" "cannot open"))
    (it "an Io error has no position"
      (at? (sax-parse-file "/nonexistent/tur-xml/missing.xml" ignore) 0 0))
    (it "a file parses like the same string"
      (match (sax-parse-file (__write-tmp "<a><b/></a>") ignore)
        (Ok _) true (Err _) false))))

;;; __keep-text -- copy a text into a C global.
(defn __keep-text [t : cstr] : nil
  ```c
  /* __tur_include__: static char *g_kept = 0; */
  free(g_kept);
  g_kept = strdup((const char *)t);
  ```)

;;; __kept-text -- the copied text.
(defn __kept-text [] : cstr
  ```c
  return g_kept ? g_kept : "";
  ```)

;;; __subst -- replace the first "PATH" in s with p (malloc'd).
(defn __subst [s : cstr p : cstr] : cstr
  ```c
  const char *at = strstr((const char *)s, "PATH");
  size_t a = (size_t)(at - (const char *)s), pl = strlen((const char *)p);
  size_t rest = strlen(at + 4);
  char *out = (char *)malloc(a + pl + rest + 1);
  memcpy(out, s, a); memcpy(out + a, p, pl); memcpy(out + a + pl, at + 4, rest + 1);
  return out;
  ```)

(defn main [] : int
  (__all-tests)
  (run-all-status))

) ;; end defmodule sax_errors_test
