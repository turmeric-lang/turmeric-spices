;; minimal_imports.tur -- `xml*` works in a file that imports nothing but
;; xml/markup (see tur-html's tests/minimal_imports.tur for why that needs
;; testing). Compiling this file is most of the test.
(defmodule xml_minimal_imports_test
  (export)
  (import xml/markup :refer [xml*])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  (defn __all-tests [] : void
    (describe "with only xml/markup imported"
      (it "a literal with content, attribute and URL holes renders"
        (let [f (xml* "<a href=${\"vbscript:x\"} n=\"${3}\">${\"&\"}</a>")]
          true))))
  (defn main [] : int (__all-tests) (run-all-status))) ;; end defmodule xml_minimal_imports_test
