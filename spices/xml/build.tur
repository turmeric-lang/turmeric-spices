(defpackage tur-xml
  :name        "tur-xml"
  :version     "0.2.0"
  :description "XML SAX and DOM parsing for Turmeric via expat"
  :license     "MIT"
  :spices #map{
    ;; The shared Document/Node tree and SaxEvent vocabulary. Its vendored
    ;; turdom.c reaches this spice's link through the :spices closure.
    "dom-core" #map{:path   "../dom-core"
                    :url    "https://github.com/turmeric-lang/turmeric-spices"
                    :ref    "main"
                    :subdir "spices/dom-core"}
    "test"     #map{:path   "../test"
                    :url    "https://github.com/turmeric-lang/turmeric-spices"
                    :ref    "test-v0.1.0"
                    :subdir "spices/test"
                    :optional true}
  }
  ;; libexpat keeps its CMakeLists.txt under expat/, which a plain :url dep
  ;; cannot reach; cmake-deps/expat/CMakeLists.txt fetches it with
  ;; SOURCE_SUBDIR and exposes the real `expat` target.  :path is spliced in
  ;; as add_subdirectory("./<path>") inside cmake/, hence the leading ../.
  :cmake-deps #map{
    "expat" #map{:path    "../cmake-deps/expat"
                 :targets ["expat"]}
  }
  ;; The expat callbacks have to be top-level C functions, which an inline-C
  ;; body cannot define, so the glue is a vendored source.
  :build-opts #map{
    :c-sources ["c/xml/turxml.c"]
  }
  :exports #map{
    "xml/sax" ["ParseOpts" "default-parse-opts" "SaxParser"
               "sax-parse-string" "sax-parse-string-opts"
               "sax-parse-file" "sax-parse-file-opts"
               "sax-parser-new" "sax-parser-new-opts" "sax-feed!" "sax-finish!"
               "sax-parser-free" "xml-backend-version"]
    "xml/dom" ["dom-parse-string" "dom-parse-string-opts" "dom-parse-file"
               "dom-parse-file-opts"]
    "xml/transform" ["sax-transform" "sax-transform-opts" "sax-transform-file"]
  })
