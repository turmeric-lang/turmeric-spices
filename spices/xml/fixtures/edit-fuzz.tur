;; edit-fuzz.tur -- random edit sequences through dom/edit on XML documents,
;; run by fixtures/run.sh (xml-html-parsers-plan follow-up B2).
;;
;; Each iteration builds a document from nothing with a few dozen edits drawn
;; from pools that mix valid names and content with invalid and hostile ones
;; (`x onload=y`, `a--b` comments, `?>` in PI data, C0 controls, broken
;; UTF-8). Properties:
;;
;;   1. a refused edit changes nothing: the serialization before and after
;;      it is identical;
;;   2. what the edits built is what a parser reads back: after
;;      node-normalize!, serialize -> dom-parse-string succeeds and is
;;      dom-equal? to the edited tree.
;;
;; Names stay out of namespaces and attributes stay off `xmlns`, so the
;; serializer adds no declarations and the comparison can be exact (the
;; parser puts namespace declarations first, which would reorder attributes).
;; The pools do hold `]]>` and `\r` for CDATA, comments and PI data: the
;; editor refuses both there, since neither can come back as written.
;;
;; Seeded: TUR_FUZZ_ITERS and TUR_FUZZ_SEED override the defaults.

(defmodule xml_edit_fuzz_fixture (export)

(import dom/ownstr :refer [String to-cstr release])
(import dom/core   :refer [Document Node ParseError dom-node dom-root dom-free
                           dom-serialize dom-equal? parse-error-release])
(import dom/edit   :refer [EditError XmlFlavor dom-new create-element
                           create-text create-comment create-cdata create-pi
                           node-clone node-append! node-prepend!
                           node-insert-before! node-insert-after!
                           node-replace! node-remove! node-unwrap! set-attr!
                           remove-attr! set-text! set-value! rename!
                           node-normalize!])
(import xml/dom    :refer [dom-parse-string])

;; ---- generator --------------------------------------------------------------

;;; __seed-rng -- seed the generator.
(defn __seed-rng [seed : int] : nil
  ```c
  /* __tur_include__: #include <stdint.h> */
  /* __tur_include__: #include <stdio.h> */
  /* __tur_include__: #include <stdlib.h> */
  /* __tur_include__: #include <string.h> */
  /* __tur_include__: static uint64_t g_ef = 1; */
  g_ef = (uint64_t)seed * 0x9E3779B97F4A7C15ULL + 0x632BE59BD9B4E019ULL;
  if (!g_ef) g_ef = 1;
  ```)

;;; __rnd -- a value in [0, n).
(defn __rnd [n : int] : int
  ```c
  g_ef ^= g_ef << 13; g_ef ^= g_ef >> 7; g_ef ^= g_ef << 17;
  return n > 0 ? (int64_t)(g_ef % (uint64_t)n) : 0;
  ```)

;;; __env-int -- an integer environment variable, or `dflt`.
(defn __env-int [name : cstr dflt : int] : int
  ```c
  const char *v = getenv((const char *)name);
  return (v && *v) ? (int64_t)strtoll(v, NULL, 10) : dflt;
  ```)

;;; __pool -- a random entry of pool `which`.
;;;   0 element names  1 text  2 attribute names  3 attribute values
;;;   4 comment bodies 5 CDATA 6 PI targets       7 PI data
(defn __pool [which : int] : cstr
  ```c
  static const char *P0[] = {"r", "item", "a", "b", "entry", "\xC3\xA9t\xC3\xA9",
                             "x-y", "_z", "x onload=y", "1a", "a:b", "", "a>b",
                             "xmlns:p", NULL};
  static const char *P1[] = {"", "t", "a < b & c > d", "\"quoted\" 'single'",
                             "line\nbreak\ttab\rcr", "]]>", "--", "<b>not a tag</b>",
                             "bell\x07", "bad\xC3", "\xF0\x9F\x8D\x9B", "  ", NULL};
  static const char *P2[] = {"id", "class", "data-x", "a b", "a=b", "1x",
                             "xml:lang", "p:k", NULL};
  static const char *P3[] = {"", "1", "a&b<c>\"d'", "tab\there\nnl\rcr", "\x01",
                             "ok \xE2\x9C\x93", "urn:x", NULL};
  static const char *P4[] = {" c ", "", "a--b", "trailing-", "x > y < z", "-lead",
                             "\x02", NULL};
  static const char *P5[] = {"c", "a < b & c", "x]]", "]]>tail", "\x03", NULL};
  static const char *P6[] = {"go", "xml-stylesheet", "xml", "XmL", "a:b", "1t", NULL};
  static const char *P7[] = {"", "now", "href=\"a.xsl\"", "a?>b", " lead", "q?", NULL};
  static const char **P[] = {P0, P1, P2, P3, P4, P5, P6, P7};
  const char **pool = P[which < 0 || which > 7 ? 0 : which];
  int64_t n = 0;
  while (pool[n]) n++;
  g_ef ^= g_ef << 13; g_ef ^= g_ef >> 7; g_ef ^= g_ef << 17;
  return pool[g_ef % (uint64_t)n];
  ```)

;; ---- the bag of nodes an iteration has made ------------------------------

;;; __bag-reset -- empty the bag.
(defn __bag-reset [] : nil
  ```c
  /* __tur_include__: static void *g_bag[4096]; */
  /* __tur_include__: static int64_t g_bag_n = 0; */
  g_bag_n = 0;
  ```)

;;; __bag-add -- remember a node.
(defn __bag-add [n : Node] : nil
  ```c
  if (g_bag_n < 4096) g_bag[g_bag_n++] = (void *)(intptr_t)n;
  ```)

;;; __bag-pick-raw -- a random remembered node.
(defn __bag-pick-raw [] : ptr<void>
  ```c
  g_ef ^= g_ef << 13; g_ef ^= g_ef >> 7; g_ef ^= g_ef << 17;
  return g_bag_n ? g_bag[g_ef % (uint64_t)g_bag_n] : NULL;
  ```)

;;; pick -- a random node of this iteration.
(defn pick [] : Node
  (:: (__bag-pick-raw) Node))

;;; keep -- remember a created node, if it was created.
(defn keep [r : (Result Node EditError)] : bool
  (match r
    (Ok n)  (do (__bag-add n) true)
    (Err _) false))

;;; done? -- did an edit succeed?
(defn done? [r : (Result nil EditError)] : bool
  (match r (Ok _) true (Err _) false))

;;; __eq? -- byte equality.
(defn __eq? [a : cstr b : cstr] : bool
  ```c
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)

;;; __report -- print a failure with its iteration and document.
(defn __report [iter : int what : cstr doc : cstr] : nil
  ```c
  printf("not ok - iteration %lld: %s\n#   %s\n", (long long)iter,
         (const char *)what, (const char *)doc);
  ```)

;;; one-edit -- one random edit; true when it succeeded.
(defn one-edit [d : Document] : bool
  (let [op (__rnd 15)]
    (cond
      (= op 0)  (keep (create-element d (__pool 0)))
      (= op 1)  (keep (create-text d (__pool 1)))
      (= op 2)  (keep (create-comment d (__pool 4)))
      (= op 3)  (keep (create-cdata d (__pool 5)))
      (= op 4)  (keep (create-pi d (__pool 6) (__pool 7)))
      (= op 5)  (done? (node-append! (pick) (pick)))
      (= op 6)  (done? (node-prepend! (pick) (pick)))
      (= op 7)  (done? (node-insert-before! (pick) (pick)))
      (= op 8)  (done? (node-insert-after! (pick) (pick)))
      (= op 9)  (done? (node-replace! (pick) (pick)))
      (= op 10) (done? (node-unwrap! (pick)))
      (= op 11) (done? (set-attr! (pick) (__pool 2) (__pool 3)))
      (= op 12) (done? (set-text! (pick) (__pool 1)))
      (= op 13) (done? (rename! (pick) (__pool 0)))
      :else     (keep (node-clone (pick))))))

;;; edits -- `k` random edits, each refused one checked to change nothing.
(defn edits [d : Document k : int iter : int] : bool
  (if (= k 0)
    true
    (let [before (dom-serialize (dom-node d))
          ok?    (one-edit d)
          after  (dom-serialize (dom-node d))
          same   (__eq? (to-cstr before) (to-cstr after))]
      (if (and (not ok?) (not same))
        (do (__report iter "a refused edit changed the document" (to-cstr after))
            (release before)
            (release after)
            false)
        (do (release before)
            (release after)
            (edits d (- k 1) iter))))))

;;; round-trip -- normalize, serialize, reparse, compare.
(defn round-trip [d : Document iter : int] : bool
  (node-normalize! (dom-node d))
  (match (dom-root d)
    (None) true                  ;; edits removed the root: nothing to parse
    (Some _)
      (let [s (dom-serialize (dom-node d))]
        (match (dom-parse-string (to-cstr s))
          (Ok p)
            (let [same (dom-equal? (dom-node p) (dom-node d))]
              (if same nil (__report iter "reparsed tree differs" (to-cstr s)))
              (dom-free p)
              (release s)
              same)
          (Err e)
            (do (__report iter "serialized document does not parse" (to-cstr s))
                (parse-error-release e)
                (release s)
                false)))))

;;; one -- one iteration.
(defn one [iter : int] : bool
  (let [d (dom-new (XmlFlavor))]
    (__bag-reset)
    (__bag-add (dom-node d))
    (match (create-element d "r")
      (Ok r) (do (node-append! (dom-node d) r) (__bag-add r))
      (Err _) nil)
    (let [ok (and (edits d (+ 20 (__rnd 40)) iter) (round-trip d iter))]
      (dom-free d)
      ok)))

(defn main [] : int
  (let [iters    (__env-int "TUR_FUZZ_ITERS" 400)
        ^mut i     0
        ^mut fails 0]
    (__seed-rng (__env-int "TUR_FUZZ_SEED" 20261016))
    (while (< i iters)
      (if (one i) nil (set! fails (+ fails 1)))
      (set! i (+ i 1)))
    (if (= fails 0)
      (do (println "ok - xml edit fuzz: every property held") 0)
      (do (println "not ok - xml edit fuzz: property failures") 1))))

) ;; end defmodule xml_edit_fuzz_fixture
