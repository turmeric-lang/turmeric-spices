;;; xml/transform -- rewrite an XML document as it streams past.
;;;
;;; `sax-transform` parses with xml/sax, runs every event through a function
;;; that returns the events to write in its place, and serializes those with
;;; a dom/writer `SaxWriter`. Rename, drop, wrap and inject at memory
;;; proportional to the nesting depth: `sax-transform-file` never holds the
;;; document, in or out. See dom/writer's `sax-transform-handler` for who
;;; owns which event.
;;;
;;; With namespace processing on (the default) names arrive in Clark form
;;; and the writer chooses the prefixes -- reusing those declared by an
;;; `xmlns` attribute the transform writes. With it off, names are passed
;;; through as written, and the identity transform `sax-keep` reproduces
;;; `dom-serialize` of the same document byte for byte.
;;;
;;; Since: 0.2.0
;; sax-transform: xml/sax driving dom/writer.
(defmodule xml/transform
  (export sax-transform sax-transform-opts sax-transform-file)
  (import dom/ownstr :refer [String release])
  (import dom/core :refer [ParseError])
  (import dom/event :refer [SaxEvent])
  (import dom/edit :refer [XmlFlavor OutOfMemory])
  (import dom/writer
    :refer
    [SaxWriter
     WriteError
     Rejected
     TransformError
     InputError
     OutputError
     sax-writer-new
     sax-writer-to-file
     sax-writer-finish!
     sax-writer-free
     sax-transform-handler])
  (import xml/sax
    :refer
    [ParseOpts default-parse-opts sax-parse-string-opts sax-parse-file-opts])
  ;;; __xt-finish -- internal: the parse's outcome, then the writer's.
  (defn __xt-finish [w : SaxWriter r : (Result nil ParseError)] : (Result String
                                                                    TransformError)
    (match r
      (Err e)
      (Err (InputError e))
      (Ok _)
      (match (sax-writer-finish! w) (Ok s) (Ok s) (Err e) (Err (OutputError e)))))
  ;;; sax-transform-opts -- transform an in-memory document.
  ;;;
  ;;; Parameters:
  ;;;   src  -- the document
  ;;;   opts -- parse options (`namespaces`, limits, entities)
  ;;;   f    -- one event in (owned), the events to write out
  ;;;
  ;;; Returns:
  ;;;   (Result String TransformError) -- the rewritten document, owned by the
  ;;;   caller; InputError when src does not parse, OutputError when the writer
  ;;;   refuses what f returned (the parse stops there).
  ;;;
  ;;; Example:
  ;;;   (sax-transform-opts src (with (default-parse-opts) [namespaces false])
  ;;;                       sax-keep)
  ;;;
  ;;; Since: 0.2.0
  (defn sax-transform-opts [src : cstr
                            opts : ParseOpts
                            f : (fn [SaxEvent] (Cons SaxEvent))] : (Result String
                                                                     TransformError)
    (match (sax-writer-new (XmlFlavor))
      (None)
      (Err (OutputError (Rejected (OutOfMemory))))
      (Some w)
      (let [h (sax-transform-handler w f)
            r (__xt-finish w (sax-parse-string-opts src opts h))]
        (sax-writer-free w)
        r)))
  ;;; sax-transform -- transform an in-memory document with the safe default
  ;;; parse options (namespaces on).
  ;;;
  ;;; Parameters:
  ;;;   src -- the document
  ;;;   f   -- one event in (owned), the events to write out
  ;;;
  ;;; Returns:
  ;;;   (Result String TransformError)
  ;;;
  ;;; Example:
  ;;;   ;; Rename every <item> to <entry>.
  ;;;   (sax-transform src
  ;;;     (fn [ev : SaxEvent] : (Cons SaxEvent)
  ;;;       (match ev
  ;;;         (StartElement n as) (if (string=? n "item")
  ;;;                               (do (release n)
  ;;;                                   (tcons-of (StartElement (from-cstr "entry") as) (tnil)))
  ;;;                               (sax-keep ev))
  ;;;         (EndElement n)      (if (string=? n "item")
  ;;;                               (do (release n)
  ;;;                                   (tcons-of (EndElement (from-cstr "entry")) (tnil)))
  ;;;                               (sax-keep ev))
  ;;;         _                   (sax-keep ev))))
  ;;;
  ;;; Since: 0.2.0
  (defn sax-transform [src : cstr f : (fn [SaxEvent] (Cons SaxEvent))] : (Result String
                                                                           TransformError)
    (sax-transform-opts src (default-parse-opts) f))
  ;;; sax-transform-file -- transform a file into another, streaming both.
  ;;;
  ;;; Neither document is held in memory. On an error the output file is left
  ;;; incomplete.
  ;;;
  ;;; Parameters:
  ;;;   in-path  -- the document to read
  ;;;   out-path -- the file to write (created or truncated)
  ;;;   opts     -- parse options
  ;;;   f        -- one event in (owned), the events to write out
  ;;;
  ;;; Returns:
  ;;;   (Result nil TransformError) -- OutputError (IoFailed) when out-path
  ;;;   cannot be created or written.
  ;;;
  ;;; Example:
  ;;;   (sax-transform-file "in.xml" "out.xml" (default-parse-opts) sax-keep)
  ;;;
  ;;; Since: 0.2.0
  (defn sax-transform-file [in-path : cstr
                            out-path : cstr
                            opts : ParseOpts
                            f : (fn [SaxEvent] (Cons SaxEvent))] : (Result nil
                                                                     TransformError)
    (match (sax-writer-to-file (XmlFlavor) out-path)
      (Err e)
      (Err (OutputError e))
      (Ok w)
      (let [h (sax-transform-handler w f)
            r (match (__xt-finish w (sax-parse-file-opts in-path opts h))
                (Ok s)
                (do (release s) (Ok nil))
                (Err e)
                (Err e))]
        (sax-writer-free w)
        r)))) ;; end defmodule xml/transform
