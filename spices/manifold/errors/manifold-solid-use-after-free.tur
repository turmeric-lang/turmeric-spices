;; Querying a Solid after solid-free is a use-after-consume.
;;   tur check errors/manifold-solid-use-after-free.tur
;;   => error [TUR-E0101]: linear value 'c' used after being consumed
(defmodule manifold_solid_use_after_free
  (export)
  (import manifold/solid :refer [cube volume solid-free])
  (defn use-after-free [] : float
    (let [c (cube 1.5 1.5 1.5 true)]
      (solid-free c) ;; the single legal consumption
      (volume c))) ;; ERROR TUR-E0101: borrow after consume
  ) ;; end
