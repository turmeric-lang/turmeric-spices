;; A Solid that is bound and never consumed is a leak, and is rejected.
;;   tur check errors/manifold-solid-leak.tur
;;   => error [TUR-E0100]: linear value 'c' dropped without being consumed
;; `volume` only borrows `c`; nothing frees it.  The violation sits in an
;; uncalled defn with no main, so the file is a compile-fail fixture and
;; nothing else.
(defmodule manifold_solid_leak
  (export)
  (import manifold/solid :refer [cube volume])
  (defn leak [] : float (let [c (cube 1.5 1.5 1.5 true)] (volume c))) ;; ERROR TUR-E0100
  ) ;; end
