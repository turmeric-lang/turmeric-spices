;; An operation consumes its operand, so the operand cannot be used again.
;; This is the mistake `solid-copy` exists for: `(translate (solid-copy a) ...)`
;; leaves `a` with the caller.
;;   tur check errors/manifold-solid-reused-after-op.tur
;;   => error [TUR-E0101]: linear value 'a' used after being consumed
(defmodule manifold_solid_reused_after_op
  (export)
  (import manifold/solid :refer [cube translate union solid-free])
  (defn reuse [] : void
    (let [a     (cube 1.5 1.5 1.5 false)
          moved (translate a 2.5 0.0 0.0) ;; consumes a
          pair  (union a moved)] ;; ERROR TUR-E0101: a is gone
      (solid-free pair)))) ;; end
