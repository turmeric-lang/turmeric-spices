;; A SolidVec is linear too: pushing into it borrows it, so a vector that is
;; filled and never handed to a batch operation or solid-vec-free is a leak.
;;   tur check errors/manifold-solid-vec-leak.tur
;;   => error [TUR-E0100]: linear value 'parts' dropped without being consumed
(defmodule manifold_solid_vec_leak
  (export)
  (import manifold/solid :refer [cube])
  (import manifold/batch :refer [solid-vec-new solid-vec-push! solid-vec-len])
  (defn leak [] : int
    (let [parts (solid-vec-new)]
      (solid-vec-push! parts (cube 1.5 1.5 1.5 true))
      (solid-vec-len parts))) ;; ERROR TUR-E0100
  ) ;; end
