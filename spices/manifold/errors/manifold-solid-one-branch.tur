;; A Solid consumed on one side of an `if` and not the other is rejected:
;; after the `if`, nobody could say whether it still has to be freed.
;;   tur check errors/manifold-solid-one-branch.tur
;;   => error [TUR-E0104]: linear value 'a' consumed in one branch but not the other
(defmodule manifold_solid_one_branch
  (export)
  (import manifold/solid :refer [cube solid-free])
  (defn maybe-free [keep : bool] : void
    (let [a (cube 1.5 1.5 1.5 true)] (if keep nil (solid-free a)))) ;; ERROR TUR-E0104
  ) ;; end
