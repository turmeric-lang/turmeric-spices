;; A function that borrows a Solid may not consume it: the caller still owns
;; it and will consume it again.
;;   tur check errors/manifold-borrowed-solid-consumed.tur
;;   => error [TUR-E0109]: borrowed value 's' cannot be consumed here
(defmodule manifold_borrowed_solid_consumed
  (export)
  (import manifold/types :refer [Solid])
  (import manifold/solid :refer [volume solid-free])
  (defn measure-and-free [^borrow s : Solid] : float
    (let [v (volume s)]
      (solid-free s) ;; ERROR TUR-E0109
      v))) ;; end
