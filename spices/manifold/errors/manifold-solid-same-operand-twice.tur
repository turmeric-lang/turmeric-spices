;; One handle cannot be both operands of a boolean: each operand is consumed,
;; and that would free the same solid twice.
;;   tur check errors/manifold-solid-same-operand-twice.tur
;;   => error [TUR-E0101]: linear value 'a' used after being consumed
(defmodule manifold_solid_same_operand_twice
  (export)
  (import manifold/solid :refer [cube union solid-free])
  (defn twice [] : void
    (let [a (cube 1.5 1.5 1.5 true)] (solid-free (union a a)))) ;; ERROR TUR-E0101
  ) ;; end
