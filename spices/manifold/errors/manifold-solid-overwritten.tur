;; `set!` on a Solid replaces what the binding holds.  If the old solid has
;; not been consumed, the assignment would orphan it -- so it is rejected.
;; Consuming the old value in the new value's own expression is the accepted
;; form: `(set! acc (union acc part))`.
;;   tur check errors/manifold-solid-overwritten.tur
;;   => error [TUR-E0100]: set!: linear value 'acc' is overwritten without being consumed
(defmodule manifold_solid_overwritten
  (export)
  (import manifold/solid :refer [cube volume solid-free])
  (defn swap-in [] : float
    (let [^mut acc (cube 1.5 1.5 1.5 true)]
      (set! acc (cube 2.5 2.5 2.5 true)) ;; ERROR TUR-E0100: the first cube is orphaned
      (let [v (volume acc)] (solid-free acc) v)))) ;; end
