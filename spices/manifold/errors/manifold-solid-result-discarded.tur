;; An operation's result is a fresh Solid.  Written as a statement, with
;; nothing binding it, it could never be freed -- so it is rejected.
;;   tur check errors/manifold-solid-result-discarded.tur
;;   => error [TUR-E0100]: linear value of type Solid is discarded here without being consumed
;; `translate` did consume `s`; it is the moved copy that is dropped.
(defmodule manifold_solid_result_discarded
  (export)
  (import manifold/types :refer [Solid])
  (import manifold/solid :refer [translate])
  (defn nudge [s : Solid] : int
    (translate s 2.5 0.0 0.0) ;; ERROR TUR-E0100: the result has no owner
    0)) ;; end
