;; manifold/types.tur -- the owned handles of tur-manifold.
;;
;; Both are `^linear`: a value is produced once and must be consumed exactly
;; once.  That is checked for every NAMED binding -- a `let` that never
;; consumes its Solid is TUR-E0100, a second use after a consuming call is
;; TUR-E0101, consuming in one `if` branch only is TUR-E0104 -- and for a
;; call result written as a statement, which is TUR-E0100 too.
;;
;; Two shapes of a Solid that never gets a name still compile and leak.  They
;; are listed in the README ("What the checker does not catch") and were
;; measured, not guessed:
;;
;;   (volume (cube 1.5 1.5 1.5 true))    ; a temporary handed to a ^borrow slot
;;   (Part (cube 1.5 1.5 1.5 true) 7)    ; a Solid stored in a struct or a vec
;;
;; turmeric keeps them open as
;; docs/reported/linear-values-without-a-binding-are-not-checked.md.
;;
;; Why linear and not `^affine` with a `Drop` instance, the shape stdlib's
;; numvec uses and the one that would free a Solid at scope exit with no
;; `solid-free`.  The prototype chose linear because affine handles were then
;; freed twice when one `if` branch consumed them; turmeric has since fixed
;; that (docs/archive/affine-drop-handle-consumed-in-one-branch-double-frees.md).
;; What still decides it, measured 2026-11-27: a function that takes an
;; affine handle by value and never uses it compiles and leaks it, where the
;; linear one is TUR-E0100.  Every operation here takes its operands by value,
;; so that is the check this spice leans on most.
(defmodule manifold/types
  (export Solid SolidVec)
  ;;; Solid -- an owned handle to one manifold solid (a `ManifoldManifold*`).
  ;;;
  ;;; Manifold solids are immutable: every operation makes a new one.  A Solid
  ;;; is `^linear`, so each is consumed exactly once -- by an operation that
  ;;; takes it (`union`, `translate`, ...), by `solid-vec-push!`, or by
  ;;; `solid-free`.  Queries (`volume`, `genus`, ...) take it `^borrow` and
  ;;; leave it with the caller.  `solid-copy` makes a second handle when one
  ;;; solid feeds two operations; the copy shares the geometry, so it is cheap.
  ;;;
  ;;; Since: M0
  (defopaque ^linear Solid :int)
  ;;; SolidVec -- an owned, growable list of solids (a `ManifoldManifoldVec*`).
  ;;;
  ;;; The way to hold a number of solids only known at run time: a loop
  ;;; pushes into a SolidVec it borrows, and one batch operation consumes it.
  ;;; Consumed by `union-all`, `intersection-all`, `hull-all` or
  ;;; `solid-vec-free`.
  ;;;
  ;;; Since: M0
  (defopaque ^linear SolidVec :int))
