(defpackage tur-manifold
  :name "tur-manifold"
  :version "0.1.0"
  :description "Solid modeling (CSG booleans on guaranteed-manifold meshes) for Turmeric via Manifold"
  ;; The license of THIS spice's own Turmeric source, as for every other
  ;; binding here.  What it links is licensed separately and more than once:
  ;; Manifold is Apache-2.0, Clipper2 is BSL-1.0, and Manifold carries MIT,
  ;; zlib and Sun-notice files of its own.  README "Licensing" has the list
  ;; and what shipping a binary obliges.
  :license "MIT"
  :repository "https://github.com/turmeric-lang/turmeric-spices"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  ;; Manifold is C++17 with a C API (the `manifoldc` target).  tur fetch reads
  ;; that target's link interface, and adds the C++ runtime and oneTBB itself.
  ;;
  ;; MANIFOLD_PAR turns on the parallel backend.  MANIFOLD_USE_BUILTIN_TBB has
  ;; Manifold build the oneTBB release it pins, as a static archive, instead of
  ;; requiring a system one: without it a machine with no TBB installed stops
  ;; at configure time ("tbb was not found").  README "Threading".
  ;;
  ;; BUILD_SHARED_LIBS OFF: Manifold's own default is shared.  MANIFOLD_TEST
  ;; OFF: otherwise it fetches googletest and builds its tests and samples.
  :cmake-deps #map{"manifold" #map{:url "https://github.com/elalish/manifold"
                                   :ref "v3.5.5"
                                   :targets ["manifoldc"]
                                   :options #map{:BUILD_SHARED_LIBS "OFF"
                                                 :MANIFOLD_TEST "OFF"
                                                 :MANIFOLD_PAR "ON"
                                                 :MANIFOLD_USE_BUILTIN_TBB "ON"}}}
  :exports #map{"manifold/types" ["Solid" "SolidVec"]
                "manifold/solid" ["cube"
                                  "cylinder"
                                  "sphere"
                                  "tetrahedron"
                                  "empty-solid"
                                  "union"
                                  "difference"
                                  "intersection"
                                  "translate"
                                  "rotate"
                                  "scale"
                                  "mirror"
                                  "hull"
                                  "solid-copy"
                                  "solid-free"
                                  "with-solid"
                                  "volume"
                                  "surface-area"
                                  "genus"
                                  "num-vert"
                                  "num-edge"
                                  "num-tri"
                                  "empty?"
                                  "solid-status"
                                  "solid-ok?"
                                  "status-name"]
                "manifold/batch" ["solid-vec-new"
                                  "solid-vec-push!"
                                  "solid-vec-len"
                                  "solid-vec-get"
                                  "solid-vec-free"
                                  "union-all"
                                  "intersection-all"
                                  "hull-all"
                                  "decompose"]})
