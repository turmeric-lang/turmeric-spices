(defpackage tur-manifold
  :name "tur-manifold"
  :version "0.1.0"
  :description "Solid modeling (CSG booleans on guaranteed-manifold meshes) for Turmeric via Manifold"
  ;; The license of THIS spice's own Turmeric source, as for every other
  ;; binding here.  What it links is licensed separately and more than once:
  ;; Manifold is Apache-2.0, Clipper2 is BSL-1.0, and Manifold carries MIT,
  ;; zlib and Sun-notice files of its own.  README "Licensing" has the list
  ;; and what shipping a binary obliges.
  :license "MIT"
  :repository "https://github.com/turmeric-lang/turmeric-spices"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  ;; Manifold is fetched through a small CMake project rather than directly,
  ;; because it is C++: something has to put the C++ runtime on tur's link
  ;; line, and only CMake knows which one this toolchain uses.  See
  ;; cmake-deps/manifold/CMakeLists.txt.  :path is spliced in as
  ;; add_subdirectory("./<path>") relative to cmake/, hence the leading ../
  :cmake-deps #map{"manifold-deps" #map{:path "../cmake-deps/manifold"
                                        :targets ["manifoldc"]}}
  :exports #map{"manifold/types" ["Solid" "SolidVec"]
                "manifold/solid" ["cube"
                                  "cylinder"
                                  "sphere"
                                  "tetrahedron"
                                  "empty-solid"
                                  "union"
                                  "difference"
                                  "intersection"
                                  "translate"
                                  "rotate"
                                  "scale"
                                  "mirror"
                                  "hull"
                                  "solid-copy"
                                  "solid-free"
                                  "with-solid"
                                  "volume"
                                  "surface-area"
                                  "genus"
                                  "num-vert"
                                  "num-edge"
                                  "num-tri"
                                  "empty?"
                                  "solid-status"
                                  "solid-ok?"
                                  "status-name"]
                "manifold/batch" ["solid-vec-new"
                                  "solid-vec-push!"
                                  "solid-vec-len"
                                  "solid-vec-get"
                                  "solid-vec-free"
                                  "union-all"
                                  "intersection-all"
                                  "hull-all"
                                  "decompose"]})
