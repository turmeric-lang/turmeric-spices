(defpackage tur-html
  :name "tur-html"
  :version "0.3.0"
  :description "WHATWG HTML parsing (DOM and tokenizer events) for Turmeric via lexbor"
  :license "MIT"
  :spices #map{
               ;; The shared Document/Node tree and SaxEvent vocabulary. Its vendored
               ;; turdom.c reaches this spice's link through the :spices closure.
               "dom-core" #map{:path "../dom-core"
                               :url "https://github.com/turmeric-lang/turmeric-spices"
                               :ref "main"
                               :subdir "spices/dom-core"}
               "test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}
               ;; Tests only: tests/hiccup_dom.tur checks hiccup's XML flavour
               ;; against expat.
               "xml" #map{:path "../xml"
                          :url "https://github.com/turmeric-lang/turmeric-spices"
                          :ref "main"
                          :subdir "spices/xml"
                          :optional true}}
  ;; cmake-deps/lexbor/CMakeLists.txt compiles only the five lexbor modules
  ;; HTML parsing needs (core, dom, ns, tag, html) into one `lexbor_html`
  ;; archive -- about a tenth of upstream's all-modules build.  :path is
  ;; spliced in as add_subdirectory("./<path>") inside cmake/, hence the ../.
  :cmake-deps #map{"lexbor" #map{:path "../cmake-deps/lexbor"
                                 :targets ["lexbor_html"]}}
  ;; The tokenizer callback and the tree copy are top-level C, so the glue is
  ;; a vendored source rather than inline C.
  :build-opts #map{:c-sources ["c/html/turhtml.c" "c/html/turlive.c"]}
  :exports #map{"html/dom" ["HtmlOpts"
                            "default-html-opts"
                            "html-parse"
                            "html-parse-opts"
                            "html-parse-fragment"
                            "html-parse-fragment-opts"
                            "html-parse-file"
                            "html-parse-file-opts"
                            "html-backend-version"]
                "html/sax" ["HtmlSaxParser"
                            "html-sax-parse-string"
                            "html-sax-parse-string-opts"
                            "html-sax-parser-new"
                            "html-sax-parser-new-opts"
                            "html-sax-feed!"
                            "html-sax-finish!"
                            "html-sax-parser-free"]
                "html/edit" ["set-inner-html!"
                             "node-inner-html"
                             "node-outer-html"]
                "html/hiccup" ["Html"
                               "HElem"
                               "HRawText"
                               "HText"
                               "HRaw"
                               "HList"
                               "HFragment"
                               "HComment"
                               "HCdata"
                               "HPi"
                               "Tag"
                               "AttrName"
                               "Attr"
                               "RawBody"
                               "CommentBody"
                               "CdataBody"
                               "PiBody"
                               "hiccup"
                               "tag"
                               "tag-name"
                               "attr-name"
                               "attr-name-of"
                               "attr-value"
                               "attr"
                               "attr-on"
                               "comment"
                               "comment-text"
                               "cdata"
                               "cdata-text"
                               "pi"
                               "pi-target"
                               "pi-data"
                               "unchecked-tag"
                               "unchecked-attr"
                               "unchecked-attr-literal"
                               "unchecked-raw-body"
                               "attrs-append"
                               "class-join"
                               "child->html"
                               "mk-empty"
                               "mk-nil"
                               "mk-cons"
                               "mk-rev-list"
                               "mk-attr-trusted"
                               "mk-srcset-check"
                               "hiccup->string"
                               "hiccup->xml-string"
                               "hiccup->dom"
                               "hiccup->xml-dom"
                               "node->hiccup"]
                "html/hiccupc" ["hiccup-expand"]
                "html/markup" ["html*"
                               "html-render"
                               "html-raw-fix"
                               "html->dom"
                               "html->nodes"
                               "LiveHtml"
                               "TemplateInstance"
                               "html-live*"
                               "html-live-render"
                               "live->string"
                               "live-free"
                               "live-mount"
                               "tpl-update!"
                               "live-document"
                               "live-instance-free"]
                "html/transform" ["html-sax-transform"
                                  "html-sax-transform-opts"]})
