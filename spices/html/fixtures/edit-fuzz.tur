;; edit-fuzz.tur -- random edit sequences through dom/edit on HTML documents,
;; run by fixtures/run.sh (xml-html-parsers-plan follow-up B2).
;;
;; Each iteration edits the children of one container element with a few
;; dozen random edits from pools that mix valid content with hostile names
;; (`x onload=y`, `plaintext`), comment bodies that would close early, the
;; `</script>` breakout and the script-data `<!--` escape, CDATA (HTML has
;; none), and \r everywhere. Properties:
;;
;;   1. a refused edit changes nothing: the serialization before and after
;;      it is identical;
;;   2. when the edited tree is one the HTML parser reproduces, what the edits
;;      built is what the parser reads back: after node-normalize!, the
;;      container's serialized children, parsed with html-parse-fragment in
;;      the container's own context, are dom-equal? to its children.
;;
;; Property 2 needs the qualifier because HTML's tree builder re-nests some
;; valid trees on purpose (a <div> in a <p>, an HTML element inside <svg>):
;; such a tree is a legal edit whose serialization means something else to a
;; parser. `__stable?` admits a fixed set of HTML elements under HTML parents,
;; SVG elements entered through <svg>, and nothing crossing between the two;
;; other trees are counted as skipped, and the run prints how many.
;;
;; Seeded: TUR_FUZZ_ITERS and TUR_FUZZ_SEED override the defaults.
(defmodule html_edit_fuzz_fixture
  (export)
  (import dom/ownstr :refer [String to-cstr release])
  (import dom/core
    :refer
    [Document Node dom-node dom-free dom-serialize node-local-name])
  (import dom/edit
    :refer
    [EditError
     HtmlFlavor
     dom-new
     create-element
     create-element-ns
     create-text
     create-comment
     create-cdata
     create-pi
     node-clone
     node-append!
     node-prepend!
     node-insert-before!
     node-insert-after!
     node-replace!
     node-remove!
     node-unwrap!
     set-attr!
     remove-attr!
     set-text!
     rename!
     node-normalize!])
  (import html/dom :refer [html-parse-fragment])
  ;; ---- generator --------------------------------------------------------------
  ;;; __seed-rng -- seed the generator.
  (defn __seed-rng [seed : int] : nil
    ```c
    /* __tur_include__: #include <stdint.h> */
  /* __tur_include__: #include <stdio.h> */
  /* __tur_include__: #include <stdlib.h> */
  /* __tur_include__: #include <string.h> */
  /* __tur_include__: static uint64_t g_hf = 1; */
  g_hf = (uint64_t)seed * 0x9E3779B97F4A7C15ULL + 0x632BE59BD9B4E019ULL;
  if (!g_hf) g_hf = 1;
  ```)
  ;;; __rnd -- a value in [0, n).
  (defn __rnd [n : int] : int
    ```c
    g_hf ^= g_hf << 13; g_hf ^= g_hf >> 7; g_hf ^= g_hf << 17;
  return n > 0 ? (int64_t)(g_hf % (uint64_t)n) : 0;
  ```)
  ;;; __env-int -- an integer environment variable, or `dflt`.
  (defn __env-int [name : cstr dflt : int] : int
    ```c
    const char *v = getenv((const char *)name);
  return (v && *v) ? (int64_t)strtoll(v, NULL, 10) : dflt;
  ```)
  ;;; __pool -- a random entry of pool `which`.
  ;;;   0 HTML element names  1 SVG element names  2 text  3 attribute names
  ;;;   4 attribute values    5 comment bodies     6 CDATA
  (defn __pool [which : int] : cstr
    ```c
    static const char *P0[] = {"div", "span", "b", "i", "em", "code", "section",
                             "br", "img", "hr", "script", "style", "DIV",
                             "x onload=y", "1a", "a/b", "plaintext", "", NULL};
  static const char *P1[] = {"svg", "g", "circle", "path", NULL};
  static const char *P2[] = {"", "t", "a < b & c > d", "</script>", "</StYlE x",
                             "<!--", "-->", "x\ry", "\xC2\xA0nbsp", "<b>x</b>",
                             "  ", "\"q\" 'q'", NULL};
  static const char *P3[] = {"id", "class", "data-x", "title", "href", "onclick",
                             "a b", "a=b", "a/b", "", NULL};
  static const char *P4[] = {"", "1", "a&b<c>\"d'", "x\ry\nz", "\xC2\xA0",
                             "javascript:go()", NULL};
  static const char *P5[] = {" c ", "", "a--b", "a-->b", ">x", "->x", "a<!-",
                             "a<!--b", "a--!>b", "x\ry", NULL};
  static const char *P6[] = {"c", "a<b&c", "]]>", "x\ry", NULL};
  static const char **P[] = {P0, P1, P2, P3, P4, P5, P6};
  const char **pool = P[which < 0 || which > 6 ? 0 : which];
  int64_t n = 0;
  while (pool[n]) n++;
  g_hf ^= g_hf << 13; g_hf ^= g_hf >> 7; g_hf ^= g_hf << 17;
  return pool[g_hf % (uint64_t)n];
  ```)
  ;; ---- the bag of nodes an iteration has made ------------------------------
  ;;; __bag-reset -- empty the bag.
  (defn __bag-reset [] : nil
    ```c
    /* __tur_include__: static void *g_hbag[4096]; */
  /* __tur_include__: static int64_t g_hbag_n = 0; */
  g_hbag_n = 0;
  ```)
  ;;; __bag-add -- remember a node.
  (defn __bag-add [n : Node] : nil
    ```c
    if (g_hbag_n < 4096) g_hbag[g_hbag_n++] = (void *)(intptr_t)n;
  ```)
  ;;; __bag-pick-raw -- a random remembered node.
  (defn __bag-pick-raw [] : ptr<void>
    ```c
    g_hf ^= g_hf << 13; g_hf ^= g_hf >> 7; g_hf ^= g_hf << 17;
  return g_hbag_n ? g_hbag[g_hf % (uint64_t)g_hbag_n] : NULL;
  ```)
  ;;; pick -- a random node of this iteration.
  (defn pick [] : Node (:: (__bag-pick-raw) Node))
  ;;; keep -- remember a created node, if it was created.
  (defn keep [r : (Result Node EditError)] : bool
    (match r (Ok n) (do (__bag-add n) true) (Err _) false))
  ;;; done? -- did an edit succeed?
  (defn done? [r : (Result nil EditError)] : bool
    (match r (Ok _) true (Err _) false))
  ;; ---- C-side helpers over the tree ----------------------------------------
  ;;; __eq? -- byte equality.
  (defn __eq? [a : cstr b : cstr] : bool
    ```c
    return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  ;;; __report -- print a failure with its iteration and markup.
  (defn __report [iter : int what : cstr doc : cstr] : nil
    ```c
    printf("not ok - iteration %lld: %s\n#   %s\n", (long long)iter,
         (const char *)what, (const char *)doc);
  ```)
  ;;; __inner-raw -- the concatenated serialization of a node's children.
  (defn __inner-raw [n : Node] : cstr
    ```c
    extern void *turdom_first_child(void *);
  extern void *turdom_next_sibling(void *);
  extern char *turdom_serialize(void *, size_t *);
  size_t cap = 256, len = 0;
  char *out = (char *)malloc(cap);
  out[0] = '\0';
  for (void *c = turdom_first_child((void *)(intptr_t)n); c; c = turdom_next_sibling(c)) {
    size_t k = 0;
    char *s = turdom_serialize(c, &k);
    if (!s) continue;
    while (len + k + 1 > cap) { cap *= 2; out = (char *)realloc(out, cap); }
    memcpy(out + len, s, k);
    len += k;
    out[len] = '\0';
    free(s);
  }
  return out;
  ```)
  ;;; __free-cstr -- release a malloc'd cstr.
  (defn __free-cstr [s : cstr] : nil
    ```c
    free((void *)(intptr_t)s);
  ```)
  ;;; __children-equal? -- are two nodes' child lists pairwise dom-equal?
  (defn __children-equal? [a : Node b : Node] : bool
    ```c
    extern void *turdom_first_child(void *);
  extern void *turdom_next_sibling(void *);
  extern int turdom_equal(void *, void *);
  void *x = turdom_first_child((void *)(intptr_t)a);
  void *y = turdom_first_child((void *)(intptr_t)b);
  while (x && y) {
    if (!turdom_equal(x, y)) return false;
    x = turdom_next_sibling(x);
    y = turdom_next_sibling(y);
  }
  return x == NULL && y == NULL;
  ```)
  ;;; __stable? -- would the HTML parser rebuild this subtree as it is?
  (defn __stable? [top : Node] : bool
    ```c
    extern void *turdom_next_in(void *, void *);
  extern void *turdom_parent(void *);
  extern int turdom_kind(void *);
  extern const char *turdom_local_name(void *);
  extern const char *turdom_ns_uri(void *);
  static const char *HTML_OK[] = {"div", "span", "b", "i", "em", "code", "section",
                                  "br", "img", "hr", "script", "style", NULL};
  static const char *SVG_OK[] = {"svg", "g", "circle", "path", NULL};
  const char *SVG = "http://www.w3.org/2000/svg";
  void *t = (void *)(intptr_t)top;
  for (void *n = t; n; n = turdom_next_in(t, n)) {
    if (turdom_kind(n) != 1) continue;
    const char *ns = turdom_ns_uri(n), *l = turdom_local_name(n);
    int svg = ns && strcmp(ns, SVG) == 0;
    int html = !ns || strcmp(ns, "http://www.w3.org/1999/xhtml") == 0;
    const char **set = svg ? SVG_OK : html ? HTML_OK : NULL;
    if (!set) return false;
    int found = 0;
    for (; *set; set++) if (strcmp(l, *set) == 0) { found = 1; break; }
    if (!found) return false;
    if (n == t) continue;
    void *p = turdom_parent(n);
    const char *pns = turdom_ns_uri(p);
    int psvg = pns && strcmp(pns, SVG) == 0;
    if (html && psvg) return false;                     /* HTML inside SVG */
    if (svg && !psvg && strcmp(l, "svg") != 0) return false;  /* SVG not via <svg> */
  }
  return true;
  ```)
  ;; ---- the fuzz -------------------------------------------------------------
  ;;; one-edit -- one random edit; true when it succeeded.
  (defn one-edit [d : Document] : bool
    (let [op (__rnd 18)]
      (cond (= op 0)  (keep (create-element d (__pool 0)))
            (= op 1)  (keep (create-element-ns d
                              "http://www.w3.org/2000/svg"
                              (__pool 1)))
            (= op 2)  (keep (create-text d (__pool 2)))
            (= op 3)  (keep (create-comment d (__pool 5)))
            (= op 4)  (keep (create-cdata d (__pool 6)))
            (= op 5)  (keep (create-pi d "go" "now")) ;; always refused in HTML
            (= op 6)  (done? (node-append! (pick) (pick)))
            (= op 7)  (done? (node-prepend! (pick) (pick)))
            (= op 8)  (done? (node-insert-before! (pick) (pick)))
            (= op 9)  (done? (node-insert-after! (pick) (pick)))
            (= op 10) (done? (node-replace! (pick) (pick)))
            (= op 11) (done? (node-unwrap! (pick)))
            (= op 12) (done? (set-attr! (pick) (__pool 3) (__pool 4)))
            (= op 13) (remove-attr! (pick) (__pool 3))
            (= op 14) (done? (set-text! (pick) (__pool 2)))
            (= op 15) (done? (rename! (pick) (__pool 0)))
            (= op 16) (do (node-remove! (pick)) true)
            :else     (keep (node-clone (pick))))))
  ;;; edits -- `k` random edits, each refused one checked to change nothing.
  (defn edits [d : Document k : int iter : int] : bool
    (if (= k 0)
      true
      (let [before (dom-serialize (dom-node d))
            ok?    (one-edit d)
            after  (dom-serialize (dom-node d))
            same   (__eq? (to-cstr before) (to-cstr after))]
        (if (and (not ok?) (not same))
          (do
            (__report iter
              "a refused edit changed the document"
              (to-cstr after))
            (release before)
            (release after)
            false)
          (do (release before) (release after) (edits d (- k 1) iter))))))
  ;;; __skipped -- count of iterations whose tree the parser would re-nest.
  (defn __skip [] : nil
    ```c
    /* __tur_include__: static int64_t g_hskip = 0; */
  g_hskip++;
  ```)
  ;;; __print-skips -- report how many iterations were skipped.
  (defn __print-skips [iters : int] : nil
    ```c
    printf("# parser-unstable trees skipped: %lld of %lld\n", (long long)g_hskip,
         (long long)iters);
  ```)
  ;;; round-trip -- normalize, serialize the container's children, reparse in
  ;;; the container's context, compare.
  (defn round-trip [box : Node iter : int] : bool
    (node-normalize! box)
    (if (not (__stable? box))
      (do (__skip) true)
      (let [s   (__inner-raw box)
            ctx (match (node-local-name box) (Some l) l (None) "div")
            f   (html-parse-fragment ctx s)
            ok  (__children-equal? box (dom-node f))]
        (if ok nil (__report iter "reparsed fragment differs" s))
        (dom-free f)
        (__free-cstr s)
        ok)))
  ;;; one -- one iteration.
  (defn one [iter : int] : bool
    (let [d (dom-new (HtmlFlavor))]
      (__bag-reset)
      (match (create-element d "div")
        (Ok box)
        (do
          (node-append! (dom-node d) box)
          (__bag-add box)
          (let [ok (and (edits d (+ 20 (__rnd 40)) iter) (round-trip box iter))]
            (dom-free d)
            ok))
        (Err _)
        (do (dom-free d) false))))
  (defn main [] : int
    (let [iters      (__env-int "TUR_FUZZ_ITERS" 400)
          ^mut i     0
          ^mut fails 0]
      (__seed-rng (__env-int "TUR_FUZZ_SEED" 20261016))
      (while (< i iters)
        (if (one i) nil (set! fails (+ fails 1)))
        (set! i (+ i 1)))
      (__print-skips iters)
      (if (= fails 0)
        (do (println "ok - html edit fuzz: every property held") 0)
        (do (println "not ok - html edit fuzz: property failures") 1))))) ;; end defmodule html_edit_fuzz_fixture
