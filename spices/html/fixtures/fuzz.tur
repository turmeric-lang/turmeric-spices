;; fuzz.tur -- a deterministic mutation fuzz pass over every tur-html entry
;; point, run by fixtures/run.sh.
;;
;; Each iteration mutates a seed document (byte flips, deletions,
;; duplications, insertions from a dictionary of markup fragments and broken
;; UTF-8) and checks properties:
;;
;;   1. no crash, hang or sanitizer trap in any entry point;
;;   2. the one-shot tokenizer and a push tokenizer fed random chunk sizes
;;      deliver the same events;
;;   3. html-parse always yields a tree with <html>, <head> and <body>, and
;;      its serialization parses again (also always to a full tree);
;;   4. html-parse-fragment survives the same input in a range of contexts;
;;   5. the identity transform (html/transform) gives back markup that
;;      tokenizes to the same events, or the writer refuses it as BadName or
;;      BadContent (xml-html-parsers-plan B4's HTML gate; tests/html5lib.tur
;;      checks each refusal's cause).
;;
;; TUR_FUZZ_ITERS and TUR_FUZZ_SEED override the defaults; a failure names
;; the iteration and prints the input.
(defmodule html_fuzz_fixture
  (export)
  (import dom/ownstr :refer [String to-cstr release])
  (import dom/core
    :refer
    [Document
     ParseError
     dom-node
     dom-free
     dom-serialize
     find-first
     parse-error-release])
  (import dom/event
    :refer
    [SaxEvent
     SaxControl
     Attr
     StartElement
     EndElement
     Chars
     Comment
     Pi
     StartCdata
     EndCdata
     Doctype
     Continue])
  (import html/dom :refer [html-parse html-parse-fragment])
  (import html/sax
    :refer
    [HtmlSaxParser
     html-sax-parse-string
     html-sax-parser-new
     html-sax-feed!
     html-sax-finish!
     html-sax-parser-free])
  (import html/transform :refer [html-sax-transform])
  (import dom/edit :refer [BadName BadContent])
  (import dom/writer
    :refer
    [Rejected
     OutputError
     transform-error-message
     transform-error-release
     sax-keep])
  ;; ---- traces (0 = one-shot, 1 = push) --------------------------------------
  ;;; __t-reset -- clear trace `which` and make it current.
  (defn __t-reset [which : int] : nil
    ```c
    /* __tur_include__: #include <stddef.h> */
  /* __tur_include__: #include <stdint.h> */
  /* __tur_include__: static char *g_tr[2] = {0, 0}; */
  /* __tur_include__: static size_t g_tr_len[2] = {0, 0}, g_tr_cap[2] = {0, 0}; */
  /* __tur_include__: static int g_tr_cur = 0; */
  g_tr_len[which] = 0;
  if (g_tr[which]) g_tr[which][0] = '\0';
  g_tr_cur = (int)which;
  ```)
  ;;; __t-put -- append to the current trace.
  (defn __t-put [s : cstr] : nil
    ```c
    int w = g_tr_cur;
  size_t n = strlen((const char *)s);
  if (g_tr_len[w] + n + 1 > g_tr_cap[w]) {
    size_t cap = g_tr_cap[w] ? g_tr_cap[w] : 256;
    while (cap < g_tr_len[w] + n + 1) cap *= 2;
    g_tr[w] = (char *)realloc(g_tr[w], cap);
    g_tr_cap[w] = cap;
  }
  memcpy(g_tr[w] + g_tr_len[w], s, n);
  g_tr_len[w] += n;
  g_tr[w][g_tr_len[w]] = '\0';
  ```)
  ;;; __t-same? -- are both traces identical?
  (defn __t-same? [] : bool
    ```c
    const char *a = g_tr[0] ? g_tr[0] : "", *b = g_tr[1] ? g_tr[1] : "";
  return strcmp(a, b) == 0;
  ```)
  ;;; __trace-attrs -- record attributes.
  (defn __trace-attrs [xs : (Cons Attr)] : nil
    (if (tnil? xs)
      nil
      (do
        (__t-put " ")
        (__t-put (to-cstr (.name (thead xs))))
        (__t-put "=")
        (__t-put (to-cstr (.value (thead xs))))
        (__trace-attrs (ttail xs)))))
  ;;; trace -- record one event.
  (defn trace [e : SaxEvent] : SaxControl
    (do
      (match e
        (StartElement n as)
        (do
          (__t-put "S ")
          (__t-put (to-cstr n))
          (__trace-attrs as)
          (__t-put "|"))
        (EndElement n)
        (do (__t-put "E ") (__t-put (to-cstr n)) (__t-put "|"))
        (Chars t)
        (do (__t-put "T ") (__t-put (to-cstr t)) (__t-put "|"))
        (Comment t)
        (do (__t-put "C ") (__t-put (to-cstr t)) (__t-put "|"))
        (Pi t d)
        (__t-put "P|")
        (StartCdata)
        (__t-put "[|")
        (EndCdata)
        (__t-put "]|")
        (Doctype n p s)
        (do
          (__t-put "D ")
          (__t-put (to-cstr n))
          (__t-put " ")
          (__t-put (to-cstr p))
          (__t-put " ")
          (__t-put (to-cstr s))
          (__t-put "|")))
      (Continue)))
  ;; ---- generator ------------------------------------------------------------
  ;;; __seed-rng -- seed the generator.
  (defn __seed-rng [seed : int] : nil
    ```c
    /* __tur_include__: static uint64_t g_fz = 1; */
  g_fz = (uint64_t)seed * 0x9E3779B97F4A7C15ULL + 0x632BE59BD9B4E019ULL;
  if (!g_fz) g_fz = 1;
  ```)
  ;;; __rnd -- a value in [0, n).
  (defn __rnd [n : int] : int
    ```c
    g_fz ^= g_fz << 13; g_fz ^= g_fz >> 7; g_fz ^= g_fz << 17;
  return n > 0 ? (int64_t)(g_fz % (uint64_t)n) : 0;
  ```)
  ;;; __env-int -- an integer environment variable, or `dflt`.
  (defn __env-int [name : cstr dflt : int] : int
    ```c
    const char *v = getenv((const char *)name);
  return (v && *v) ? (int64_t)strtoll(v, NULL, 10) : dflt;
  ```)
  ;;; __context -- a fragment context element name.
  (defn __context [i : int] : cstr
    ```c
    static const char *ctx[] = { "body", "div", "tr", "table", "select",
                               "textarea", "title", "script", "template",
                               "html", "head", "frameset", "colgroup" };
  return ctx[(size_t)i % (sizeof ctx / sizeof *ctx)];
  ```)
  ;;; __mutant -- a malloc'd mutation of seed document `which`.
  (defn __mutant [which : int] : cstr
    ```c
    static const char *seeds[] = {
    "<!DOCTYPE html><html lang=en><head><title>T &amp; x</title>"
    "<style>p>a{}</style><script>if(a<b){}</script></head><body class=\"a b\">"
    "<p>one<p>two <b><i>bi</b>i</i><br><img src=x alt='\xC3\xA9'></body></html>",
    "<table><tr><td>a<td>b</tr>x<caption>c</table><select><option>o<optgroup></select>",
    "<svg viewBox=\"0 0 1 1\"><foreignObject><div>f</div></foreignObject><path xlink:href=#a/>"
    "</svg><math><mi>x</mi><annotation-xml encoding=\"text/html\"><p>y</p></annotation-xml></math>",
    "<template><td>c</td><template><tr></template></template><textarea>&lt;t</textarea>"
    "<plaintext><a>",
    "<ul><li>a<li>b</ul><dl><dt>t<dd>d</dl><form><input type=text><button>b</form><!--c-->",
  };
  static const char *dict[] = {
    "<", ">", "&", ";", "\"", "'", "/", "=", "!", "?", "<!--", "-->", "--!>",
    "<![CDATA[", "]]>", "&amp;", "&#", "&#x", "&#0;", "&#x110000;", "&notin",
    "&nbsp", "<table>", "</table>", "<tr>", "<td>", "<p>", "</p>", "<b>", "</b>",
    "<i>", "<a href=x>", "</a>", "<svg>", "</svg>", "<math>", "<mi>", "<foreignObject>",
    "<template>", "</template>", "<script>", "</script>", "<style>", "<title>",
    "<textarea>", "<plaintext>", "<frameset>", "<select>", "<option>", "<body>",
    "<html>", "<head>", "<!DOCTYPE html>", "<!DOCTYPE x PUBLIC \"p\" \"s\">",
    "<noscript>", "<iframe>", "<xmp>", "<marquee>", "<nobr>", "<object>",
    "\xC3", "\xF0\x9F\x8C", "\xEF\xBF\xBF", "\xED\xA0\x80", " ", "\t", "\n", "\r",
  };
  const size_t nseeds = sizeof seeds / sizeof *seeds;
  const size_t ndict = sizeof dict / sizeof *dict;
  const char *src = seeds[(size_t)which % nseeds];
  size_t len = strlen(src), cap = len * 4 + 256;
  char *s = (char *)malloc(cap);
  memcpy(s, src, len + 1);
  int nmut = 1 + (int)(g_fz % 5);
  for (int m = 0; m < nmut; m++) {
    g_fz ^= g_fz << 13; g_fz ^= g_fz >> 7; g_fz ^= g_fz << 17;
    size_t pos = len ? (size_t)(g_fz >> 8) % (len + 1) : 0;
    switch (g_fz % 4) {
    case 0:
      if (len) { size_t p = pos < len ? pos : len - 1;
                 s[p] = (char)(1 + (g_fz >> 20) % 255); }
      break;
    case 1: {
      size_t n = 1 + (size_t)((g_fz >> 24) % 8);
      if (pos < len) { if (pos + n > len) n = len - pos;
                       memmove(s + pos, s + pos + n, len - pos - n + 1); len -= n; }
      break; }
    case 2: {
      const char *f = dict[(size_t)(g_fz >> 16) % ndict];
      size_t n = strlen(f);
      if (len + n + 1 <= cap) { memmove(s + pos + n, s + pos, len - pos + 1);
                                memcpy(s + pos, f, n); len += n; }
      break; }
    default: {
      size_t n = 1 + (size_t)((g_fz >> 24) % 16);
      if (pos < len) { if (pos + n > len) n = len - pos;
        if (len + n + 1 <= cap) { memmove(s + pos + n, s + pos, len - pos + 1);
                                  memcpy(s + pos, s + pos + n, n); len += n; } }
      break; }
    }
  }
  s[len] = '\0';
  return s;
  ```)
  ;;; __len -- byte length.
  (defn __len [s : cstr] : int
    ```c
    return (int64_t)strlen((const char *)s);
  ```)
  ;;; __slice -- malloc'd copy of s[off, off+n).
  (defn __slice [s : cstr off : int n : int] : cstr
    ```c
    char *p = (char *)malloc((size_t)n + 1);
  memcpy(p, (const char *)s + off, (size_t)n);
  p[n] = '\0';
  return p;
  ```)
  ;;; __free-cstr -- free a malloc'd cstr.
  (defn __free-cstr [s : cstr] : nil
    ```c
    free((void *)s);
  ```)
  ;;; __report -- print a failing case to stderr.
  (defn __report [what : cstr iter : int doc : cstr] : nil
    ```c
    #include <stdio.h>
  fprintf(stderr, "FUZZ FAILURE (%s) at iteration %lld; input:\n%s\n---\n",
          what, (long long)iter, doc);
  ```)
  ;; ---- one iteration --------------------------------------------------------
  ;;; ok-release? -- did it succeed? Releases the error when it did not.
  (defn ok-release? [r : (Result nil ParseError)] : bool
    (match r (Ok _) true (Err e) (do (parse-error-release e) false)))
  ;;; feed-random -- push src in random chunks; true when every feed was ok.
  (defn feed-random [p : HtmlSaxParser src : cstr len : int] : bool
    (let [^mut off 0
          ^mut ok  true]
      (while (< off len)
        (let [want  (+ 1 (__rnd 13))
              n     (if (> (+ off want) len) (- len off) want)
              chunk (__slice src off n)
              r     (html-sax-feed! p chunk)]
          (__free-cstr chunk)
          (match r
            (Ok _)
            nil
            (Err e)
            (do (parse-error-release e) (set! ok false)))
          (set! off (+ off n))))
      ok))
  ;;; push-ok? -- push-tokenize src into trace 1.
  (defn push-ok? [src : cstr] : bool
    (do
      (__t-reset 1)
      (match (html-sax-parser-new trace)
        (Err e)
        (do (parse-error-release e) false)
        (Ok p)
        (let [fed (feed-random p src (__len src))
              fin (html-sax-finish! p)]
          (html-sax-parser-free p)
          (and fed (ok-release? fin))))))
  ;;; full-tree? -- does d have html, head, and body or frameset?
  (defn full-tree? [d : Document] : bool
    (and (match (find-first (dom-node d) "html") (Some _) true (None) false)
      (and (match (find-first (dom-node d) "head") (Some _) true (None) false)
        (or (match (find-first (dom-node d) "body") (Some _) true (None) false)
          (match (find-first (dom-node d) "frameset")
            (Some _)
            true
            (None)
            false)))))
  ;;; reparse-ok? -- serialize d and parse that again into a full tree.
  (defn reparse-ok? [d : Document] : bool
    (let [s  (dom-serialize (dom-node d))
          d2 (html-parse (to-cstr s))
          ok (full-tree? d2)]
      (dom-free d2)
      (release s)
      ok))
  ;;; __id-count -- tally an identity check; refused or not.
  (defn __id-count [refused : bool] : nil
    ```c
    /* __tur_include__: static long g_id_checked = 0, g_id_refused = 0; */
  g_id_checked++;
  if (refused) g_id_refused++;
  ```)
  ;;; __id-summary -- print the identity tallies.
  (defn __id-summary [] : nil
    ```c
    printf("# identity: %ld inputs, %ld refused by the writer\n", g_id_checked, g_id_refused);
  ```)
  ;;; __note -- print a line to stderr.
  (defn __note [s : cstr] : nil
    ```c
    #include <stdio.h>
  fprintf(stderr, "#   %s\n", (const char *)s);
  ```)
  ;;; identity-ok? -- property 5; trace 0 holds doc's one-shot events.
  (defn identity-ok? [doc : cstr] : bool
    (match (html-sax-transform doc sax-keep)
      (Ok out)
      (do
        (__id-count false)
        (__t-reset 1)
        (let [p    (ok-release? (html-sax-parse-string (to-cstr out) trace))
              same (__t-same?)]
          (if (and p same) nil (__note (to-cstr out)))
          (release out)
          (and p same)))
      (Err (OutputError (Rejected (BadName))))
      (do (__id-count true) true)
      (Err (OutputError (Rejected (BadContent))))
      (do (__id-count true) true)
      (Err e)
      (do
        (__note (transform-error-message e))
        (transform-error-release e)
        false)))
  ;;; one -- run every check on one mutant; true when all hold.
  (defn one [iter : int] : bool
    (let [doc      (__mutant (__rnd 5))
          sax-ok   (do
                     (__t-reset 0)
                     (ok-release? (html-sax-parse-string doc trace)))
          push-ok  (push-ok? doc)
          same     (__t-same?)
          d        (html-parse doc)
          full     (full-tree? d)
          reparsed (reparse-ok? d)
          frag     (html-parse-fragment (__context (__rnd 13)) doc)
          good     (if (not (and sax-ok push-ok))
                     (do
                       (__report "tokenizer reported an error" iter doc)
                       false)
                     (if (not same)
                       (do
                         (__report "one-shot and push events differ" iter doc)
                         false)
                       (if (not full)
                         (do
                           (__report "html-parse lost html/head/body" iter doc)
                           false)
                         (if (not reparsed)
                           (do
                             (__report "serialization does not reparse to a full tree"
                               iter
                               doc)
                             false)
                           true))))
          ident    (if (identity-ok? doc)
                     true
                     (do
                       (__report "identity transform changed the tokens"
                         iter
                         doc)
                       false))]
      (dom-free d)
      (dom-free frag)
      (__free-cstr doc)
      (and good ident)))
  (defn main [] : int
    ;; The loop is in main so each iteration's continuation frames are handed
    ;; back as `one` returns (see tur-xml's fixtures/fuzz.tur).
    (let [iters      (__env-int "TUR_FUZZ_ITERS" 3000)
          ^mut i     0
          ^mut fails 0]
      (__seed-rng (__env-int "TUR_FUZZ_SEED" 20261010))
      (while (< i iters)
        (if (one i) nil (set! fails (+ fails 1)))
        (set! i (+ i 1)))
      (__id-summary)
      (if (= fails 0)
        (do (println "ok - html fuzz: every property held") 0)
        (do (println "not ok - html fuzz: property failures") 1))))) ;; end defmodule html_fuzz_fixture
