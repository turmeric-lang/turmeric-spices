;;; html/dom -- WHATWG HTML parsing into a dom-core Document, via lexbor.
;;;
;;; HTML parsing never fails: the HTML standard defines a tree for every
;;; input, so tag soup -- unclosed <p>s, misnested <b><i>, stray table
;;; content, a missing <head> -- comes back as the tree a browser would
;;; build. That is why `html-parse` returns a Document, not a Result. Only the
;;; explicit-options and file entry points can fail, on a byte cap or I/O.
;;;
;;; The tree is the shared dom-core one, read with the same node API as an
;;; XML document. Element and attribute names in the HTML namespace are
;;; lower-case; SVG and MathML elements keep their adjusted case
;;; (`foreignObject`) and their namespace URIs. `<template>` contents appear
;;; as the template element's children. Nodes carry no source positions.
;;;
;;; Depth is capped the way Blink caps it: an element nested deeper than
;;; `max-depth` (512 by default) is attached beside its parent rather than
;;; under it. Nothing is dropped and no walker ever sees a deeper tree.
;;;
;;; PARSING IS NOT SANITIZING. A parsed and re-serialized document keeps
;;; every <script>, inline event handler and javascript: URL it came with.
;;;
;;; Since: 0.1.0
;; DOM front door over turhtml_parse in c/html/turhtml.c.

(defmodule html/dom
  (export HtmlOpts default-html-opts html-parse html-parse-opts
          html-parse-fragment html-parse-fragment-opts html-parse-file
          html-parse-file-opts html-backend-version)

(import dom/ownstr :refer [from-cstr])
(import dom/core   :refer [Document ParseError ParseErrorKind
                           limit-kind io-kind])

;;; HtmlOpts -- caps for one HTML parse.
;;;
;;;   max-depth -- deepest element nesting kept; deeper elements are attached
;;;                beside their parent (0 = no cap)
;;;   max-bytes -- most input bytes accepted (0 = no cap)
;;;
;;; A `:copy` struct, so adjust a field with `with`:
;;;   (with (default-html-opts) [max-depth 64])
(defstruct ^copy HtmlOpts [max-depth : int max-bytes : int])

;;; default-html-opts -- depth 512 (Blink's limit), 64 MiB of input.
;;;
;;; Returns:
;;;   HtmlOpts
;;;
;;; Example:
;;;   (html-parse-opts src (default-html-opts))
;;;
;;; Since: 0.1.0
(defn default-html-opts [] : HtmlOpts
  (HtmlOpts 512 67108864))

;;; html-backend-version -- the linked lexbor's version string.
;;;
;;; Returns:
;;;   cstr -- static, e.g. "3.0.1".
;;;
;;; Example:
;;;   (println (html-backend-version))
;;;
;;; Since: 0.1.0
(defn html-backend-version [] : cstr
  ```c
  #include <lexbor/core/base.h>
  return LEXBOR_VERSION_STRING;
  ```)

;; ---------------------------------------------------------------------------
;; C bridge
;; ---------------------------------------------------------------------------

;;; __null? -- internal.
(defn __null? [p : ptr<void>] : bool
  ```c
  return p == NULL;
  ```)

;;; __parse-raw -- internal: a turdom_doc, or NULL with the error recorded.
(defn __parse-raw [src : cstr depth : int nbytes : int] : ptr<void>
  ```c
  extern void *turhtml_parse(const char *, int64_t, int64_t, int64_t);
  return turhtml_parse((const char *)src, -1, depth, nbytes);
  ```)

;;; __fragment-raw -- internal: a turdom_doc for a fragment, or NULL.
(defn __fragment-raw [ctx : cstr src : cstr depth : int nbytes : int] : ptr<void>
  ```c
  extern void *turhtml_parse_fragment(const char *, const char *, int64_t,
                                      int64_t, int64_t);
  return turhtml_parse_fragment((const char *)ctx, (const char *)src, -1,
                                depth, nbytes);
  ```)

;;; __file-raw -- internal: a turdom_doc for a file, or NULL.
(defn __file-raw [path : cstr depth : int nbytes : int] : ptr<void>
  ```c
  extern void *turhtml_parse_file(const char *, int64_t, int64_t);
  return turhtml_parse_file((const char *)path, depth, nbytes);
  ```)

;;; __must -- internal: a never-fails parse result; only OOM yields NULL.
;;; Returns the bare pointer; the opaque is applied by the caller (see
;;; msgpack/buf.tur on why inline C does not return an opaque itself).
(defn __must [p : ptr<void>] : ptr<void>
  ```c
  #include <stdio.h>
  #include <stdlib.h>
  if (!p) {
    fprintf(stderr, "tur-html: out of memory while parsing\n");
    abort();
  }
  return p;
  ```)

;;; __err-kind -- internal.
(defn __err-kind [] : int
  ```c
  extern int turhtml_err_kind(void);
  return (int64_t)turhtml_err_kind();
  ```)

;;; __err-msg -- internal.
(defn __err-msg [] : cstr
  ```c
  extern const char *turhtml_err_msg(void);
  return turhtml_err_msg();
  ```)

;;; __error -- internal: the recorded error (msg copied).
(defn __error [] : ParseError
  (ParseError (if (= (__err-kind) 3) (io-kind) (limit-kind))
              (from-cstr (__err-msg))
              0 0))

;;; __wrap -- internal: a nullable tree as a Result.
(defn __wrap [p : ptr<void>] : (Result Document ParseError)
  (if (__null? p)
    (Err (__error))
    (Ok (:: p Document))))

;; ---------------------------------------------------------------------------
;; Entry points
;; ---------------------------------------------------------------------------

;;; html-parse -- parse a whole HTML document. Never fails.
;;;
;;; Applies the default depth cap (512, by flattening) and no byte cap: the
;;; input is already in memory, and the tree is proportional to it.
;;;
;;; Parameters:
;;;   src -- the document (UTF-8)
;;;
;;; Returns:
;;;   Document -- always; release it with `dom-free`.
;;;
;;; Example:
;;;   (let [d (html-parse "<p>one<p>two")]
;;;     (tlength (find-all (dom-node d) "p"))   ; => 2
;;;     (dom-free d))
;;;
;;; Since: 0.1.0
(defn html-parse [src : cstr] : Document
  (:: (__must (__parse-raw src 512 0)) Document))

;;; html-parse-opts -- parse a whole HTML document with explicit caps.
;;;
;;; Parameters:
;;;   src  -- the document
;;;   opts -- depth and byte caps
;;;
;;; Returns:
;;;   (Result Document ParseError) -- err (kind Limit) only when the input is
;;;   longer than max-bytes.
;;;
;;; Example:
;;;   (html-parse-opts src (with (default-html-opts) [max-depth 32]))
;;;
;;; Since: 0.1.0
(defn html-parse-opts [src : cstr opts : HtmlOpts] : (Result Document ParseError)
  (__wrap (__parse-raw src (.max-depth opts) (.max-bytes opts))))

;;; html-parse-fragment -- parse markup as the contents of an element.
;;;
;;; The HTML fragment parsing algorithm (innerHTML): `context` names the
;;; element the markup is parsed inside, which decides how it tokenizes and
;;; nests -- "<td>x" means something different inside "tr" than inside
;;; "body", and everything is text inside "textarea". The fragment's
;;; top-level nodes are the children of the returned document's node; there
;;; is no <html>, <head> or <body> wrapper.
;;;
;;; Parameters:
;;;   context -- the context element's tag name ("body", "tr", "select", ...)
;;;   src     -- the markup
;;;
;;; Returns:
;;;   Document -- always; release it with `dom-free`.
;;;
;;; Example:
;;;   (node-child-count (dom-node (html-parse-fragment "tr" "<td>a<td>b")))  ; => 2
;;;
;;; Since: 0.1.0
(defn html-parse-fragment [context : cstr src : cstr] : Document
  (:: (__must (__fragment-raw context src 512 0)) Document))

;;; html-parse-fragment-opts -- `html-parse-fragment` with explicit caps.
;;;
;;; Parameters:
;;;   context -- the context element's tag name
;;;   src     -- the markup
;;;   opts    -- depth and byte caps
;;;
;;; Returns:
;;;   (Result Document ParseError)
;;;
;;; Example:
;;;   (html-parse-fragment-opts "div" src (default-html-opts))
;;;
;;; Since: 0.1.0
(defn html-parse-fragment-opts [context : cstr src : cstr opts : HtmlOpts]
  : (Result Document ParseError)
  (__wrap (__fragment-raw context src (.max-depth opts) (.max-bytes opts))))

;;; html-parse-file-opts -- parse an HTML file with explicit caps.
;;;
;;; Parameters:
;;;   path -- the file (UTF-8)
;;;   opts -- depth and byte caps
;;;
;;; Returns:
;;;   (Result Document ParseError) -- Io when the file cannot be read, Limit
;;;   when it is longer than max-bytes.
;;;
;;; Example:
;;;   (html-parse-file-opts "page.html" (with (default-html-opts) [max-bytes 0]))
;;;
;;; Since: 0.1.0
(defn html-parse-file-opts [path : cstr opts : HtmlOpts]
  : (Result Document ParseError)
  (__wrap (__file-raw path (.max-depth opts) (.max-bytes opts))))

;;; html-parse-file -- parse an HTML file with the default caps.
;;;
;;; Parameters:
;;;   path -- the file
;;;
;;; Returns:
;;;   (Result Document ParseError)
;;;
;;; Example:
;;;   (html-parse-file "index.html")
;;;
;;; Since: 0.1.0
(defn html-parse-file [path : cstr] : (Result Document ParseError)
  (html-parse-file-opts path (default-html-opts)))

) ;; end defmodule html/dom
