;; dom_html.tur -- html/dom: the tag-soup corpus, raw text, entities,
;; foreign content, fragments, the depth cap, options and files.
;;
;; Most cases compare `dom-serialize` of the parsed document with the markup
;; a browser produces for the same input, which pins the whole tree (implied
;; tags, reparenting, text) in one string.
(defmodule dom_html_test
  (export)
  (import dom/ownstr :refer [String to-cstr release string=?])
  (import dom/core
    :refer
    [Document
     Node
     dom-root
     dom-node
     dom-free
     dom-serialize
     dom-node-count
     dom-live-bytes
     node-name
     node-ns-uri
     node-local-name
     node-attr
     node-text
     node-depth
     node-children
     find-all
     find-first
     node-pos
     ParseError
     Limit
     Io
     parse-error-message])
  (import html/dom
    :refer
    [HtmlOpts
     default-html-opts
     html-parse
     html-parse-opts
     html-parse-fragment
     html-parse-fragment-opts
     html-parse-file
     html-parse-file-opts])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  ;;; __eq? -- byte equality, printing both on a mismatch.
  (defn __eq? [got : cstr want : cstr] : bool
    ```c
    #include <stdio.h>
  if (strcmp((const char *)got, (const char *)want) == 0) return true;
  fprintf(stderr, "# want: [%s]\n# got:  [%s]\n", want, got);
  return false;
  ```)
  ;;; parses-to? -- does html-parse src serialize to exactly `want`?
  (defn parses-to? [src : cstr want : cstr] : bool
    (let [d  (html-parse src)
          s  (dom-serialize (dom-node d))
          ok (__eq? (to-cstr s) want)]
      (release s)
      (dom-free d)
      ok))
  ;;; body-is? -- the serialization of <body>'s contents only.
  (defn body-is? [src : cstr want : cstr] : bool
    (parses-to? src (__wrap-body want)))
  ;;; __wrap-body -- "<html><head></head><body>" want "</body></html>".
  (defn __wrap-body [inner : cstr] : cstr
    ```c
    const char *a = "<html><head></head><body>", *b = "</body></html>";
  size_t n = strlen(a) + strlen((const char *)inner) + strlen(b) + 1;
  char *s = (char *)malloc(n);
  snprintf(s, n, "%s%s%s", a, (const char *)inner, b);
  return s;
  ```)
  ;;; fragment-is? -- does html-parse-fragment serialize to exactly `want`?
  (defn fragment-is? [ctx : cstr src : cstr want : cstr] : bool
    (let [d  (html-parse-fragment ctx src)
          s  (dom-serialize (dom-node d))
          ok (__eq? (to-cstr s) want)]
      (release s)
      (dom-free d)
      ok))
  ;;; __nested -- `depth` nested <div>s around "x".
  (defn __nested [depth : int] : cstr
    ```c
    char *s = (char *)malloc((size_t)depth * 5 + 2);
  size_t o = 0;
  for (int64_t i = 0; i < depth; i++) { memcpy(s + o, "<div>", 5); o += 5; }
  s[o++] = 'x';
  s[o] = '\0';
  return s;
  ```)
  ;;; max-depth-of -- the deepest node under n (iteratively, via find-all).
  (defn max-depth-of [xs : (Cons Node) best : int] : int
    (if (tnil? xs)
      best
      (let [d (node-depth (thead xs))]
        (max-depth-of (ttail xs) (if (> d best) d best)))))
  ;;; __write-tmp -- write content to a temp file; its path.
  (defn __write-tmp [content : cstr] : cstr
    ```c
    #include <stdio.h>
  #include <unistd.h>
  char tmpl[] = "/tmp/tur-html-test-XXXXXX";
  int fd = mkstemp(tmpl);
  if (fd < 0) return "";
  size_t n = strlen((const char *)content);
  if (write(fd, content, n) != (ssize_t)n) { close(fd); return ""; }
  close(fd);
  return strdup(tmpl);
  ```)
  ;;; churn -- parse and free n documents.
  (defn churn [n : int] : nil
    (if (= n 0) nil (do (dom-free (html-parse "<p>a<b>b</p>")) (churn (- n 1)))))
  (defn __all-tests [] : void
    (describe "html/dom -- tag soup becomes the browser's tree"
      (it "an empty input still has html, head and body"
        (parses-to? "" "<html><head></head><body></body></html>"))
      (it "the doctype is kept, everything else is implied"
        (parses-to? "<!DOCTYPE html>hi"
          "<!DOCTYPE html><html><head></head><body>hi</body></html>"))
      (it "unclosed <p>s are closed by the next <p>"
        (body-is? "<p>one<p>two" "<p>one</p><p>two</p>"))
      (it "misnested <b><i> is repaired by the adoption agency"
        (body-is? "<b>1<i>2</b>3</i>" "<b>1<i>2</i></b><i>3</i>"))
      (it "a stray end tag is ignored" (body-is? "a</span>b" "ab"))
      (it "table rows get an implied <tbody>"
        (body-is? "<table><tr><td>c</table>"
          "<table><tbody><tr><td>c</td></tr></tbody></table>"))
      (it "text inside a table is foster-parented before it"
        (body-is? "<table>x<tr><td>c</td></tr></table>"
          "x<table><tbody><tr><td>c</td></tr></tbody></table>"))
      (it "head content goes into an implied <head>"
        (parses-to? "<title>T</title><p>b"
          "<html><head><title>T</title></head><body><p>b</p></body></html>"))
      (it "<li>s close each other"
        (body-is? "<ul><li>a<li>b</ul>" "<ul><li>a</li><li>b</li></ul>"))
      (it "uppercase tags and attributes are lower-cased"
        (body-is? "<DIV CLASS=x>y</DIV>" "<div class=\"x\">y</div>"))
      (it "the first of duplicate attributes wins"
        (body-is? "<a x=1 x=2></a>" "<a x=\"1\"></a>"))
      (it "a comment before <html> stays at the top level"
        (parses-to? "<!--c--><p>"
          "<!--c--><html><head></head><body><p></p></body></html>")))
    (describe "html/dom -- raw text and character references"
      (it "<script> content is raw text"
        (parses-to? "<script>if (a < b && c) {}</script>"
          "<html><head><script>if (a < b && c) {}</script></head><body></body></html>"))
      (it "<style> content is raw text"
        (parses-to? "<style>a > b { }</style>"
          "<html><head><style>a > b { }</style></head><body></body></html>"))
      (it "<textarea> content is text, with references decoded"
        (body-is? "<textarea><b>&amp;</b></textarea>"
          "<textarea>&lt;b&gt;&amp;&lt;/b&gt;</textarea>"))
      (it "named, decimal and hex references are decoded"
        (let [d (html-parse "<p>&lt;&#65;&#x42;&amp</p>")]
          (match (find-first (dom-node d) "p")
            (Some p)
            (let [t  (node-text p)
                  ok (string=? t "<AB&")]
              (release t)
              (dom-free d)
              ok)
            (None)
            (do (dom-free d) false))))
      (it "&nbsp; serializes back as &nbsp;" (body-is? "a&nbsp;b" "a&nbsp;b")))
    (describe "html/dom -- foreign content and templates"
      (it "SVG keeps its namespace and adjusted case"
        (let [d (html-parse "<svg viewBox=\"0 0 1 1\"><foreignObject/></svg>")]
          (let [ok (match (find-first (dom-node d) "foreignObject")
                     (Some f)
                     (match (node-ns-uri f)
                       (Some u)
                       (__eq? u "http://www.w3.org/2000/svg")
                       (None)
                       false)
                     (None)
                     false)
                vb (match (find-first (dom-node d) "svg")
                     (Some s)
                     (match (node-attr s "viewBox")
                       (Some v)
                       (__eq? v "0 0 1 1")
                       (None)
                       false)
                     (None)
                     false)]
            (dom-free d)
            (and ok vb))))
      (it "an xlink: attribute is namespaced"
        (let [d (html-parse "<svg><a xlink:href=\"#t\"/></svg>")]
          (let [ok (match (find-first (dom-node d)
                            "{http://www.w3.org/2000/svg}a")
                     (Some a)
                     (match (node-attr a "{http://www.w3.org/1999/xlink}href")
                       (Some v)
                       (__eq? v "#t")
                       (None)
                       false)
                     (None)
                     false)]
            (dom-free d)
            ok)))
      (it "MathML elements are in the MathML namespace"
        (let [d (html-parse "<math><mi>x</mi></math>")]
          (let [ok (match (find-first (dom-node d)
                            "{http://www.w3.org/1998/Math/MathML}mi")
                     (Some _)
                     true
                     (None)
                     false)]
            (dom-free d)
            ok)))
      (it "<template> contents are the template's children (and a leading one is in <head>)"
        (parses-to? "<template><td>c</td></template>"
          "<html><head><template><td>c</td></template></head><body></body></html>")))
    (describe "html/dom -- fragments"
      (it "in a <tr>, cells are cells"
        (fragment-is? "tr" "<td>a<td>b" "<td>a</td><td>b</td>"))
      (it "in a <body>, the same cells are dropped and only text remains"
        (fragment-is? "body" "<td>a<td>b" "ab"))
      (it "in a <textarea>, markup is text"
        (fragment-is? "textarea" "<b>x</b>" "&lt;b&gt;x&lt;/b&gt;"))
      (it "a fragment has no html/head/body wrapper"
        (let [d (html-parse-fragment "div" "<p>a</p>b")]
          (let [ok (and (assert-eq 2 (tlength (node-children (dom-node d))))
                     (match (dom-root d)
                       (Some p)
                       (match (node-name p) (Some n) (__eq? n "p") (None) false)
                       (None)
                       false))]
            (dom-free d)
            ok)))
      (it "an empty fragment has no root"
        (let [d (html-parse-fragment "div" "")]
          (let [ok (match (dom-root d) (Some _) false (None) true)]
            (dom-free d)
            ok))))
    (describe "html/dom -- depth cap (Blink-style flattening)"
      (it "1000 nested divs are all kept"
        (let [d (html-parse (__nested 1000))]
          (let [n (tlength (find-all (dom-node d) "div"))]
            (dom-free d)
            (assert-eq 1000 n))))
      (it "but no node is deeper than the cap (512 + html/body)"
        (let [d (html-parse (__nested 1000))]
          (let [m (max-depth-of (find-all (dom-node d) "*") 0)]
            (dom-free d)
            (assert-true (<= m 512)))))
      (it "max-depth 10 flattens at 10"
        (match (html-parse-opts (__nested 50)
                 (with (default-html-opts) [max-depth 10]))
          (Ok d)
          (let [m (max-depth-of (find-all (dom-node d) "*") 0)
                n (tlength (find-all (dom-node d) "div"))]
            (dom-free d)
            (and (assert-eq 10 m) (assert-eq 50 n)))
          (Err _)
          false))
      (it "a 100000-deep input parses without exhausting the stack"
        (let [d (html-parse (__nested 100000))]
          (let [n (tlength (find-all (dom-node d) "div"))]
            (dom-free d)
            (assert-eq 100000 n)))))
    (describe "html/dom -- options, files, accounting"
      (it "input past max-bytes is a Limit error"
        (match (html-parse-opts "<p>0123456789</p>"
                 (with (default-html-opts) [max-bytes 8]))
          (Ok d)
          (do (dom-free d) false)
          (Err e)
          (match (.kind e) (Limit) true _ false)))
      (it "a fragment past max-bytes is a Limit error"
        (match (html-parse-fragment-opts "div"
                 "0123456789"
                 (with (default-html-opts) [max-bytes 4]))
          (Ok d)
          (do (dom-free d) false)
          (Err e)
          (match (.kind e) (Limit) true _ false)))
      (it "a file parses like the same string"
        (match (html-parse-file (__write-tmp "<p>from a file"))
          (Ok d)
          (let [ok (match (find-first (dom-node d) "p")
                     (Some p)
                     (let [t (node-text p)
                           r (string=? t "from a file")]
                       (release t)
                       r)
                     (None)
                     false)]
            (dom-free d)
            ok)
          (Err e)
          (do (println (parse-error-message e)) false)))
      (it "a missing file is an Io error"
        (match (html-parse-file "/nonexistent/tur-html/x.html")
          (Ok d)
          (do (dom-free d) false)
          (Err e)
          (match (.kind e) (Io) true _ false)))
      (it "a file past max-bytes is a Limit error"
        (match (html-parse-file-opts (__write-tmp "<p>0123456789")
                 (with (default-html-opts) [max-bytes 4]))
          (Ok d)
          (do (dom-free d) false)
          (Err e)
          (match (.kind e) (Limit) true _ false)))
      (it "HTML nodes carry no source position"
        (let [d (html-parse "<p>x")]
          (let [ok (match (find-first (dom-node d) "p")
                     (Some p)
                     (match (node-pos p) (Some _) false (None) true)
                     (None)
                     false)]
            (dom-free d)
            ok)))
      (it "find-all and node-attr ignore ASCII case in HTML"
        (let [d (html-parse "<A HREF=x>l</A>")]
          (let [ok (match (find-first (dom-node d) "A")
                     (Some a)
                     (match (node-attr a "Href")
                       (Some v)
                       (__eq? v "x")
                       (None)
                       false)
                     (None)
                     false)]
            (dom-free d)
            ok)))
      (it "parsing and freeing 200 documents returns the arena to its baseline"
        (let [before (dom-live-bytes)]
          (churn 200)
          (assert-eq before (dom-live-bytes))))))
  (defn main [] : int (__all-tests) (run-all-status))) ;; end defmodule dom_html_test
