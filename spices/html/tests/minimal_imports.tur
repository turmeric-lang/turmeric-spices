;; minimal_imports.tur -- the literal macros work in a file that imports
;; nothing but the macro's own module.
;;
;; An expansion's names resolve in the file that uses the macro, and a
;; module-qualified name resolves only for a module that file imports itself.
;; So the expansions name helpers in html/markup and html/hiccup, never in
;; dom/holes: this file imports neither dom/holes nor dom/core, and every
;; other test here does, which once hid exactly that.
(defmodule html_minimal_imports_test
  (export)
  (import html/markup :refer [html-live* live->string live-free])
  (import html/hiccup :refer [hiccup hiccup->string])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  ;;; __is? -- byte equality, printing both on a mismatch.
  (defn __is? [got : cstr want : cstr] : bool
    ```c
    #include <stdio.h>
  if (strcmp((const char *)got, (const char *)want) == 0) return true;
  fprintf(stderr, "# want: [%s]\n# got:  [%s]\n", want, got);
  return false;
  ```)
  (defn __all-tests [] : void
    (describe "with only the macro's module imported"
      (it "a literal with content, attribute, URL and srcset holes"
        (let [l  (html-live* "<a href=${\"javascript:x\"} title=\"t ${\"<\"}\" data-n=${3}><img srcset=\"${\"a.png 1x\"}\">${\"&\"}</a>")
              ok (__is? (live->string l)
                   "<a href=\"about:invalid#tur-unsafe\" title=\"t &lt;\" data-n=\"3\"><img srcset=\"a.png 1x\">&amp;</a>")]
          (live-free l)
          ok))
      (it "a hiccup literal with shorthand classes, a joined :class and srcset"
        (let [c "x"
              s "b.png 2x"]
          (__is? (hiccup->string (hiccup [:p.a
                                          #map{:class c}
                                          [:img #map{:srcset s}]]))
            "<p class=\"a x\"><img srcset=\"b.png 2x\"></p>")))))
  (defn main [] : int (__all-tests) (run-all-status))) ;; end defmodule html_minimal_imports_test
