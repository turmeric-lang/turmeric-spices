(defpackage tur-simd
  :name "tur-simd"
  :version "0.2.0"
  :description "Explicit SIMD on GCC/Clang vector extensions over the typed numeric arrays: the op set the compiler's vector types will have (phase S0 of turmeric's simd-and-vectorization-plan), and three kernels written in it -- dot product, byte-image blend, four-channel biquad."
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :build-opts #map{:c-includes ["c/simd"]}
  :experiments ["simd"]
  :exports #map{"simd/kernels" ["Biquad"
                                "simd-lowering"
                                "simd-dot-f64"
                                "simd-dot-f64x4"
                                "simd-dot-f32"
                                "simd-blend-u8!"
                                "simd-biquad4-f32!"]
                "simd/s1" ["s1-dot-f64" "s1-blend-u8!" "s1-biquad4-f32!"]})
