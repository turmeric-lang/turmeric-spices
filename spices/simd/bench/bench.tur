;;; bench.tur -- time tur-simd's kernels against what a program has without it.
;;;
;;; Each row: the SIMD kernel, its S1 twin on the compiler's vector types
;;; (`simd/s1`),
;;; then the alternatives -- N1's kernel where one
;;; exists (`f64vec-dot`), and the scalar loop written in Turmeric.  Run it
;;; under different flags to see the lowering and the call boundary:
;;;
;;;   tur run bench/bench.tur                                   # gcc/clang, -O2
;;;   TUR_CC_FLAGS="-O2 -std=c99 -fno-strict-aliasing -w -DTUR_SIMD_OUTOFLINE" \
;;;     tur run bench/bench.tur        # every vector op a real call
;;;   TUR_CC_FLAGS="-O2 -std=c99 -fno-strict-aliasing -w -D__MIRC__" \
;;;     tur run bench/bench.tur        # the struct-of-lanes lowering
;;;
;;; Times are the best of five, in nanoseconds per element.
(load "stdlib/numvec.tur")

(defmodule simd/bench
  (import simd/kernels
    :refer
    [Biquad
     simd-lowering
     simd-dot-f64
     simd-dot-f64x4
     simd-blend-u8!
     simd-biquad4-f32!])
  (import simd/s1 :refer [s1-dot-f64 s1-blend-u8! s1-biquad4-f32!])
  (defn now-ns [] : int
    ```c
    #include <time.h>
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
  ```)
  (defn row [name : cstr ns : float] : void
    ```c
    printf("  %-34s %8.3f ns/elem\n", (const char *)name, ns);
  ```)
  (defn note [s : cstr] : void
    ```c
    printf("%s\n", (const char *)s);
  ```)
  ;; a sink the optimizer cannot see through
  (defn sink [x : float] : void
    ```c
    static volatile double g_sink;
  g_sink = x;
  ```)
  ;; --- dot: 4096 doubles, 20000 passes ---
  (defn dot-scalar [^borrow a : F64Vec ^borrow b : F64Vec] : float
    (let [n      (f64vec-len a)
          ^mut i 0
          ^mut s 0.0]
      (while (< i n)
        (set! s
          (+ s
            (* (unsafe (f64vec-ref-unchecked a i))
              (unsafe (f64vec-ref-unchecked b i)))))
        (set! i (+ i 1)))
      s))
  (defn time-dot [which : int] : float
    (let [n         4096
          reps      20000
          a         (f64vec-build n [i] (* (as float (mod i 97)) 0.0371))
          b         (f64vec-build n [i] (* (as float (mod i 89)) 0.0119))
          ^mut best 1e+18
          ^mut t    0]
      (while (< t 5)
        (let [t0     (now-ns)
              ^mut r 0
              ^mut s 0.0]
          (while (< r reps)
            (set! s
              (+ s
                (if (= which 0)
                  (simd-dot-f64 a b)
                  (if (= which 1)
                    (f64vec-dot a b)
                    (if (= which 2)
                      (dot-scalar a b)
                      (if (= which 3) (simd-dot-f64x4 a b) (s1-dot-f64 a b)))))))
            (set! r (+ r 1)))
          (sink s)
          (let [dt (as float (- (now-ns) t0))]
            (when (< dt best) (set! best dt))))
        (set! t (+ t 1)))
      (/ best (as float (* n reps)))))
  ;; --- blend: 65536 bytes, 2000 passes ---
  (defn blend-scalar! [^borrow out : U8Vec
                       ^borrow a : U8Vec
                       ^borrow b : U8Vec
                       alpha : int] : nil
    (u8vec-for-index [i x a]
      (let [y (as int (unsafe (u8vec-ref-unchecked b i)))
            t (+ (+ (* (as int x) alpha) (* y (- 255 alpha))) 128)]
        (unsafe (u8vec-set-unchecked! out
                  i
                  (as uint8 (bit-shr (+ t (bit-shr t 8)) 8)))))))
  ;; the same blend as plain scalar C, for gcc/clang's own auto-vectorizer
  (defn blend-c! [^borrow out : U8Vec
                  ^borrow a : U8Vec
                  ^borrow b : U8Vec
                  alpha : int] : nil
    ```c
    struct { int64_t len; uint8_t *data; void *raw; } *o = (void*)(intptr_t)out;
  struct { int64_t len; uint8_t *data; void *raw; } *p = (void*)(intptr_t)a;
  struct { int64_t len; uint8_t *data; void *raw; } *q = (void*)(intptr_t)b;
  uint8_t *restrict od = o->data;
  const uint8_t *restrict pd = p->data, *restrict qd = q->data;
  uint32_t wa = (uint32_t)alpha, wb = 255u - wa;
  for (int64_t i = 0; i < o->len; i++) {
    uint32_t t = pd[i] * wa + qd[i] * wb + 128;
    od[i] = (uint8_t)((t + (t >> 8)) >> 8);
  }
  ```)
  (defn time-blend [which : int] : float
    (let [n         65536
          reps      2000
          a         (u8vec-build n [i] (as uint8 (mod (* i 89) 256)))
          b         (u8vec-build n [i] (as uint8 (mod (* i 53) 256)))
          out       (u8vec-new n (as uint8 0))
          ^mut best 1e+18
          ^mut t    0]
      (while (< t 5)
        (let [t0     (now-ns)
              ^mut r 0]
          (while (< r reps)
            (if (= which 0)
              (simd-blend-u8! out a b (as uint8 (+ (mod r 200) 20)))
              (if (= which 1)
                (blend-scalar! out a b (+ (mod r 200) 20))
                (if (= which 2)
                  (blend-c! out a b (+ (mod r 200) 20))
                  (s1-blend-u8! out a b (as uint8 (+ (mod r 200) 20))))))
            (set! r (+ r 1)))
          (sink (as float (u8vec-ref out 7)))
          (let [dt (as float (- (now-ns) t0))]
            (when (< dt best) (set! best dt))))
        (set! t (+ t 1)))
      (/ best (as float (* n reps)))))
  ;; --- biquad: 4 channels x 16384 frames, 400 passes ---
  (defn biquad-scalar! [^borrow buf : F32Vec
                        ^borrow z : F32Vec
                        ch : int
                        c : Biquad] : nil
    (let [n      (f32vec-len buf)
          ^mut i ch]
      (while (< i n)
        (let [x  (f32vec-ref buf i)
              z1 (f32vec-ref z (* 2 ch))
              z2 (f32vec-ref z (+ (* 2 ch) 1))
              y  (+ (* (.b0 c) x) z1)]
          (f32vec-set! z (* 2 ch) (+ (- (* (.b1 c) x) (* (.a1 c) y)) z2))
          (f32vec-set! z (+ (* 2 ch) 1) (- (* (.b2 c) x) (* (.a2 c) y)))
          (f32vec-set! buf i y))
        (set! i (+ i 4)))))
  ;; the four channels written out side by side in scalar C, for the
  ;; auto-vectorizer (SLP) to find the lanes itself
  (defn biquad-c! [^borrow buf : F32Vec ^borrow state : F32Vec c : Biquad] : nil
    ```c
    struct { int64_t len; float *data; void *raw; } *v = (void*)(intptr_t)buf;
  struct { int64_t len; float *data; void *raw; } *s = (void*)(intptr_t)state;
  float *restrict d = v->data, *restrict z = s->data;
  float z1[4], z2[4];
  for (int k = 0; k < 4; k++) { z1[k] = z[k]; z2[k] = z[4 + k]; }
  for (int64_t i = 0; i < v->len; i += 4) {
    for (int k = 0; k < 4; k++) {
      float x = d[i + k];
      float m = c.b0 * x;
      float y = m + z1[k];
      float p = c.b1 * x, q = c.a1 * y;
      z1[k] = (p - q) + z2[k];
      float u = c.b2 * x, w = c.a2 * y;
      z2[k] = u - w;
      d[i + k] = y;
    }
  }
  for (int k = 0; k < 4; k++) { z[k] = z1[k]; z[4 + k] = z2[k]; }
  ```)
  (defn time-biquad [which : int] : float
    (let [frames    16384
          n         (* frames 4)
          reps      400
          c         (Biquad (as float32 0.0675)
                      (as float32 0.135)
                      (as float32 0.0675)
                      (as float32 -1.1429)
                      (as float32 0.4128))
          v         (f32vec-build n
                      [i]
                      (as float32
                        (- (* (as float (mod (* i 37) 101)) 0.0371) 1.25)))
          st        (f32vec-new 8 (as float32 0.0))
          ^mut best 1e+18
          ^mut t    0]
      (while (< t 5)
        (let [t0     (now-ns)
              ^mut r 0]
          (while (< r reps)
            (if (= which 0)
              (simd-biquad4-f32! v st c)
              (if (= which 2)
                (biquad-c! v st c)
                (if (= which 3)
                  (s1-biquad4-f32! v st c)
                  (let [^mut ch 0]
                    (while (< ch 4)
                      (biquad-scalar! v st ch c)
                      (set! ch (+ ch 1)))))))
            (set! r (+ r 1)))
          (sink (as float (f32vec-ref v 5)))
          (let [dt (as float (- (now-ns) t0))]
            (when (< dt best) (set! best dt))))
        (set! t (+ t 1)))
      (/ best (as float (* n reps)))))
  (defn main [] : int
    (note (simd-lowering))
    (row "dot f64: simd-dot-f64 (f64x2)" (time-dot 0))
    (row "dot f64: s1-dot-f64 (F64x2, Turmeric)" (time-dot 4))
    (row "dot f64: simd-dot-f64x4" (time-dot 3))
    (row "dot f64: f64vec-dot (N1)" (time-dot 1))
    (row "dot f64: scalar Turmeric loop" (time-dot 2))
    (row "blend u8: simd-blend-u8!" (time-blend 0))
    (row "blend u8: s1-blend-u8! (U8x16, Turmeric)" (time-blend 3))
    (row "blend u8: scalar Turmeric loop" (time-blend 1))
    (row "blend u8: scalar C, auto-vectorized" (time-blend 2))
    (row "biquad x4 f32: simd-biquad4-f32!" (time-biquad 0))
    (row "biquad x4 f32: s1-biquad4-f32! (F32x4, Turmeric)" (time-biquad 3))
    (row "biquad x4 f32: 4 scalar Turmeric" (time-biquad 1))
    (row "biquad x4 f32: scalar C, 4 lanes" (time-biquad 2))
    0))
