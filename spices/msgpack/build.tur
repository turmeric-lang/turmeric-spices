(defpackage tur-msgpack
  :name "tur-msgpack"
  :version "0.1.0"
  :description "MessagePack binary serialization for Turmeric -- the binary twin of tur-json"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}
               ;; Test-only, and :optional so a consumer of tur-msgpack never has to have
               ;; it. tests/json-cross-check.tur derives BOTH codecs for one struct --
               ;; the program that could not exist while tur-json owned the bare `Encode`
               ;; and `Decode`, and so the standing proof that the 0.4.0 rename holds.
               "json" #map{:path "../json"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "main"
                           :subdir "spices/json"
                           :optional true}}
  ;; No :cmake-deps. The MessagePack wire format is small enough that both
  ;; halves of the codec are vendored C in this spice -- see the MP0 note in
  ;; README.md for why this is not ludocode/mpack.
  :build-opts #map{:c-includes ["c"] :c-sources ["c/msgpack/mp_core.c"]}
  :exports #map{"msgpack/buf" ["Buf"
                               "buf-alloc"
                               "buf-len"
                               "buf-data"
                               "buf-free"
                               "buf-concat"
                               "buf-byte"
                               "buf-empty?"
                               "buf=?"
                               "buf->hex"
                               "hex->buf"]
                "msgpack/decode" ["MpTree"
                                  "MpNode"
                                  "mp-parse"
                                  "mp-tree-root"
                                  "mp-tree-free"
                                  "mp-map-get"
                                  "mp-map-size"
                                  "mp-arr-size"
                                  "mp-arr-get"
                                  "mp-type-name"
                                  "mp-absent?"
                                  "mp-nil?"
                                  "mp-bool?"
                                  "mp-int?"
                                  "mp-float?"
                                  "mp-num?"
                                  "mp-str?"
                                  "mp-arr?"
                                  "mp-map?"
                                  "mp-get-int"
                                  "mp-get-bool"
                                  "mp-get-float"
                                  "mp-get-str"]
                "msgpack/encode" ["derive-msgpack"
                                  "derive-msgpack-encode"
                                  "derive-msgpack-decode"
                                  "derive-msgpack-opaque"
                                  "derive-msgpack-opaque-encode"
                                  "derive-msgpack-opaque-decode"
                                  "derive-msgpack-sum"
                                  "derive-msgpack-sum-encode"
                                  "derive-msgpack-sum-decode"
                                  "decode-mp-list"
                                  "derive-mp-decoder"
                                  "MpDecodeErrors"
                                  "mp-decode-errors-count"
                                  "mp-decode-error-path"
                                  "mp-decode-error-expected"
                                  "mp-decode-error-got"
                                  "mp-decode-errors-free"]})
