;; MP1 smoke: the Buf carrier -- alloc / len / byte / concat / hex round-trip.
;;
;; `it` takes exactly one bool, so each case is a single expression: a `let`
;; that allocates, computes the assertion, frees, and yields the assertion.
(defmodule buf_smoke_test
  (export)
  (import msgpack/buf
    :refer
    [Buf
     buf-alloc
     buf-len
     buf-byte
     buf-free
     buf-concat
     buf-empty?
     buf=?
     buf->hex
     hex->buf])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defn cstr-free [p : cstr] : nil
    ```c
    free((void *)(intptr_t)p);
  ```)
  ;; hex=? -- does `b` render to `expect`? CONSUMES b, so a golden-byte case is
  ;; one line.
  (defn hex=? [b : Buf expect : cstr] : bool
    (let [h (buf->hex b)
          r (cstr-eq? expect h)]
      (cstr-free h)
      (buf-free b)
      r))
  (defn __all-tests [] : void
    (describe "msgpack Buf -- the owned byte carrier"
      (it "reports the allocated length"
        (let [b (buf-alloc 4)
              r (assert-eq 4 (buf-len b))]
          (buf-free b)
          r))
      (it "reads bytes back out of a hex literal"
        (let [b (hex->buf "c0c3")
              r (assert-true (and (= 2 (buf-len b))
                               (and (= 192 (buf-byte b 0))
                                 (and (= 195 (buf-byte b 1))
                                   (= -1 (buf-byte b 2))))))]
          (buf-free b)
          r))
      (it "round-trips hex -> buf -> hex"
        (assert-true (hex=? (hex->buf "cb401c666666666666")
                       "cb401c666666666666")))
      (it "concatenates, consuming both operands"
        (assert-true (hex=? (buf-concat (hex->buf "01") (hex->buf "02")) "0102")))
      (it "treats a zero-length buffer as empty"
        (let [b (buf-alloc 0)
              r (assert-true (buf-empty? b))]
          (buf-free b)
          r))
      (it "rejects a malformed hex literal as an empty buf"
        (let [b (hex->buf "0q")
              r (assert-true (buf-empty? b))]
          (buf-free b)
          r))
      (it "compares byte for byte"
        (let [a (hex->buf "cc80")
              b (hex->buf "cc80")
              c (hex->buf "cc81")
              r (assert-true (and (buf=? a b) (not (buf=? a c))))]
          (buf-free a)
          (buf-free b)
          (buf-free c)
          r))))
  (defn main [] : int (__all-tests) (run-all-status)))
