;; MP2: mp-parse is the trust boundary. It validates the WHOLE buffer before
;; handing out a single node, so every accessor downstream can be total -- a
;; wrong-typed or absent node yields err / none / "missing" rather than a read
;; past the end.
;;
;; These are the shapes a network peer produces: truncation mid-header,
;; truncation mid-payload, a container promising more elements than it carries,
;; the reserved 0xc1 byte, and a second value appended after the first. Each
;; must be rejected AT THE PARSE, not discovered later as a bad field.
(defmodule decode_malformed_test
  (export)
  (import msgpack/buf :refer [Buf buf-free hex->buf])
  (import msgpack/decode :refer [MpTree mp-parse mp-tree-free])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  (import test/runner :refer [run-all-status])
  ;; rejects? -- does `h` fail to parse? Frees the tree on the unexpected-success
  ;; path so a regression here does not also leak.
  (defn rejects? [h : cstr] : bool
    (let [b (hex->buf h)
          r (mp-parse b)]
      (buf-free b)
      (if (ok? r) (do (mp-tree-free (ok-val r)) false) true)))
  (defn accepts? [h : cstr] : bool
    (let [b (hex->buf h)
          r (mp-parse b)]
      (buf-free b)
      (if (ok? r) (do (mp-tree-free (ok-val r)) true) false)))
  (defn __reject-tests [] : void
    (describe "msgpack mp-parse -- malformed input is rejected at the boundary"
      (it "an empty buffer is not a value" (assert-true (rejects? "")))
      (it "0xc1 is reserved and never legal" (assert-true (rejects? "c1")))
      (it "a uint8 header with no payload byte" (assert-true (rejects? "cc")))
      (it "a float64 header carrying two of its eight bytes"
        (assert-true (rejects? "cb0000")))
      (it "a fixstr promising five bytes and carrying two"
        (assert-true (rejects? "a56162")))
      (it "a str8 header truncated before its length byte"
        (assert-true (rejects? "d9")))
      (it "an array of two carrying one element"
        (assert-true (rejects? "9201")))
      (it "a map of one carrying only its key"
        (assert-true (rejects? "81a16b")))
      (it "an array16 whose length field is cut short"
        (assert-true (rejects? "dc0001")))
      (it "a nested array truncated in its innermost element"
        (assert-true (rejects? "92019202")))
      (it "a second complete value appended after the first"
        (assert-true (rejects? "2a2a")))
      (it "trailing garbage after a well-formed map"
        (assert-true (rejects? "82a17801a1790207")))))
  (defn __accept-tests [] : void
    (describe "msgpack mp-parse -- well-formed input is accepted"
      (it "a bare int" (assert-true (accepts? "2a")))
      (it "a flat map" (assert-true (accepts? "82a17801a17902")))
      (it "an array nested three deep"
        ;; [1,[2,[3]]]
        (assert-true (accepts? "920192029103")))
      (it "a map holding an array and a nested map"
        ;; {"a":[1,2],"b":{"c":3}}
        (assert-true (accepts? "82a161920102a16281a16303")))))
  (defn main [] : int (__reject-tests) (__accept-tests) (run-all-status)))
