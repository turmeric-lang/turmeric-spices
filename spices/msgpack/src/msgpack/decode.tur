;;; msgpack/decode -- the low-level MessagePack node tree.
;;;
;;; `mp-parse` validates a whole buffer up front and copies it into an owned
;;; `MpTree`; a `MpNode` is a handle to one value inside that tree, valid for
;;; as long as the tree lives. Because the buffer is validated before any node
;;; is handed out, every accessor below is total -- a wrong-typed or absent
;;; node yields `err` / `none` / `"missing"`, never a read past the end.
;;;
;;; Unlike json/decode.tur's bare `:int` doc and value handles, `MpTree` and
;;; `MpNode` are real opaques: nothing else in the program can be passed where
;;; one is expected, and a tree cannot be used as a node. (json predates the
;;; rule; there is no reason to repeat it here.)
;;;
;;; Usage:
;;;   (let [r (mp-parse bytes)]
;;;     (when (ok? r)
;;;       (let [t (ok-val r)]
;;;         ... (mp-tree-free t))))
;;;
;;; Since: Phase MP2
;; MessagePack node tree over the vendored reader in c/msgpack/mp_core.c.
(defmodule msgpack/decode
  (export MpTree
    MpNode
    mp-parse
    mp-tree-root
    mp-tree-free
    mp-map-get
    mp-map-size
    mp-arr-size
    mp-arr-get
    mp-type-name
    mp-absent?
    mp-nil?
    mp-bool?
    mp-int?
    mp-float?
    mp-num?
    mp-str?
    mp-arr?
    mp-map?
    mp-get-int
    mp-get-bool
    mp-get-float
    mp-get-str)
  (import msgpack/buf :refer [Buf])
  ;;; MpTree -- an owned, already-validated MessagePack document. Owns the bytes
  ;;; every node points into; release with `mp-tree-free`.
  (defopaque MpTree :ptr<void>)
  ;;; MpNode -- a handle to one value inside a tree. Borrowed: it dangles once
  ;;; its tree is freed.
  (defopaque MpNode :int)
  ;;; __mp-null-ptr? -- internal: is this a null pointer?
  (defn __mp-null-ptr? [p : ptr<void>] : bool
    ```c
    return p == NULL;
  ```)
  ;;; __mp-null-cstr? -- internal: is this a null string pointer?
  (defn __mp-null-cstr? [p : cstr] : bool
    ```c
    return p == NULL;
  ```)
  ;;; __mp-parse-raw -- internal: parse, as a bare pointer (NULL if malformed).
  ;;; See buf.tur's note on why the inline C does not return the opaque itself.
  (defn __mp-parse-raw [buf : Buf] : ptr<void>
    ```c
    extern int64_t mp_buf_len(const void *);
  extern void *mp_buf_data(void *);
  extern void *mp_tree_parse(const void *, int64_t);
  void *b = (void *)(intptr_t)buf;
  return mp_tree_parse(mp_buf_data(b), mp_buf_len(b));
  ```)
  ;;; mp-parse -- parse a buffer of MessagePack bytes into a node tree.
  ;;;
  ;;; The bytes must be exactly one complete value: a truncated encoding, an
  ;;; illegal type byte, and trailing bytes after the value are all rejected.
  ;;; `buf` is only read -- the tree takes its own copy, so the caller still owns
  ;;; `buf` and is free to release it immediately.
  ;;;
  ;;; Parameters:
  ;;;   buf -- the MessagePack bytes (borrowed)
  ;;;
  ;;; Returns:
  ;;;   (Result MpTree cstr) -- err with a static message on malformed input.
  ;;;
  ;;; Example:
  ;;;   (let [r (mp-parse (hex->buf "81a16101"))]   ; {"a":1}
  ;;;     (when (ok? r) (mp-tree-free (ok-val r))))
  ;;;
  ;;; Since: Phase MP2
  (defn mp-parse [buf : Buf] : (Result MpTree cstr)
    (let [p (__mp-parse-raw buf)]
      (if (__mp-null-ptr? p)
        (:: (err "mp-parse: malformed MessagePack input") (Result MpTree cstr))
        (:: (ok (:: p MpTree)) (Result MpTree cstr)))))
  ;;; mp-tree-root -- the tree's single top-level value.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the parsed tree
  ;;;
  ;;; Returns:
  ;;;   MpNode -- the root node.
  ;;;
  ;;; Example:
  ;;;   (mp-type-name t (mp-tree-root t))   ; => "object"
  ;;;
  ;;; Since: Phase MP2
  (defn mp-tree-root [tree : MpTree] : MpNode
    (:: (__mp-tree-root-raw tree) MpNode))
  ;;; __mp-tree-root-raw -- internal: the root offset as a bare int.
  (defn __mp-tree-root-raw [tree : MpTree] : int
    ```c
    extern int64_t mp_tree_root(const void *);
  return mp_tree_root((const void *)(intptr_t)tree);
  ```)
  ;;; mp-tree-free -- release the tree and the bytes every node points into.
  ;;;
  ;;; Every MpNode taken from this tree dangles afterwards. Strings pulled out
  ;;; with `mp-get-str` are malloc'd copies and DO survive.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the tree to release
  ;;;
  ;;; Example:
  ;;;   (mp-tree-free t)
  ;;;
  ;;; Since: Phase MP2
  (defn mp-tree-free [tree : MpTree] : nil
    ```c
    extern void mp_tree_free(void *);
  mp_tree_free((void *)(intptr_t)tree);
  ```)
  ;; ---------------------------------------------------------------------------
  ;; Shape predicates. All are false for an absent node, so a missing map key
  ;; needs no separate guard.
  ;; ---------------------------------------------------------------------------
  ;;; mp-absent? -- true when the node does not refer to a value at all (what a
  ;;; missing map key decodes to).
  ;;; Since: Phase MP2
  (defn mp-absent? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_absent(const void *, int64_t);
  return mp_is_absent((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-nil? -- true when the node is MessagePack `nil` (0xc0).
  ;;; Since: Phase MP2
  (defn mp-nil? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_nil(const void *, int64_t);
  return mp_is_nil((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-bool? -- true when the node is `true` or `false`.
  ;;; Since: Phase MP2
  (defn mp-bool? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_bool(const void *, int64_t);
  return mp_is_bool((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-int? -- true for every integer format (fixint, uint8..64, int8..64).
  ;;; Since: Phase MP2
  (defn mp-int? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_int(const void *, int64_t);
  return mp_is_int((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-float? -- true for float32 / float64 only. MessagePack keeps integers
  ;;; and floats in distinct wire formats, so this is NOT true of an int.
  ;;; Since: Phase MP2
  (defn mp-float? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_float(const void *, int64_t);
  return mp_is_float((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-num? -- true for an int OR a float, matching what `mp-get-float`
  ;;; accepts (an integer widens to a double).
  ;;; Since: Phase MP2
  (defn mp-num? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_num(const void *, int64_t);
  return mp_is_num((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-str? -- true for the `str` formats. A `bin` is NOT a string: v0 maps
  ;;; Turmeric `cstr` onto msgpack `str` only.
  ;;; Since: Phase MP2
  (defn mp-str? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_str(const void *, int64_t);
  return mp_is_str((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-arr? -- true for fixarray / array16 / array32.
  ;;; Since: Phase MP2
  (defn mp-arr? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_arr(const void *, int64_t);
  return mp_is_arr((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-map? -- true for fixmap / map16 / map32.
  ;;; Since: Phase MP2
  (defn mp-map? [tree : MpTree node : MpNode] : bool
    ```c
    extern int mp_is_map(const void *, int64_t);
  return mp_is_map((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-type-name -- name the format family actually present at the node.
  ;;;
  ;;; The vocabulary mirrors `stdlib/schema.tur` (string / int / float / bool /
  ;;; null / array / object), with msgpack `map` reported as "object" so a
  ;;; violation on a given struct reads identically to the json spice's. An
  ;;; absent node is "missing".
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the node to describe
  ;;;
  ;;; Returns:
  ;;;   cstr -- a borrowed static name; do not free it.
  ;;;
  ;;; Example:
  ;;;   (mp-type-name t (mp-tree-root t))   ; => "int"
  ;;;
  ;;; Since: Phase MP2
  (defn mp-type-name [tree : MpTree node : MpNode] : cstr
    ```c
    extern const char *mp_type_name(const void *, int64_t);
  return (const char *)mp_type_name((const void *)(intptr_t)tree, (int64_t)node);
  ```)
  ;; ---------------------------------------------------------------------------
  ;; Navigation.
  ;; ---------------------------------------------------------------------------
  ;;; __mp-map-get-raw -- internal: value offset for `key`, or -1 when absent.
  (defn __mp-map-get-raw [tree : MpTree node : MpNode key : cstr] : int
    ```c
    extern int64_t mp_map_get(const void *, int64_t, const char *);
  return mp_map_get((const void *)(intptr_t)tree, (int64_t)node, (const char *)key);
  ```)
  ;;; mp-map-get -- look up a string key inside a map node.
  ;;;
  ;;; Honest about absence, unlike json's `json-obj-get`: `none` covers both
  ;;; "the key is not there" and "this node is not a map".
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the map node to search
  ;;;   key  -- the string key to match (exact bytes)
  ;;;
  ;;; Returns:
  ;;;   (Option MpNode) -- the value node, or none.
  ;;;
  ;;; Example:
  ;;;   (mp-map-get t (mp-tree-root t) "id")   ; => (some <node>)
  ;;;
  ;;; Since: Phase MP2
  (defn mp-map-get [tree : MpTree node : MpNode key : cstr] : (Option MpNode)
    (let [off (__mp-map-get-raw tree node key)]
      (if (< off 0)
        (:: (none) (Option MpNode))
        (:: (some (:: off MpNode)) (Option MpNode)))))
  ;;; __mp-map-size-raw -- internal: entry count, or -1 when not a map.
  (defn __mp-map-size-raw [tree : MpTree node : MpNode] : int
    ```c
    extern int64_t mp_map_size(const void *, int64_t);
  return mp_map_size((const void *)(intptr_t)tree, (int64_t)node);
  ```)
  ;;; mp-map-size -- the number of key/value pairs in a map node.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the node to measure
  ;;;
  ;;; Returns:
  ;;;   (Option int) -- none when the node is not a map. `(some 0)` is an empty
  ;;;   map, which is a different answer from "not a map" -- hence the Option
  ;;;   rather than a negative count.
  ;;;
  ;;; Example:
  ;;;   (unwrap (mp-map-size t root))   ; => 2
  ;;;
  ;;; Since: Phase MP2
  (defn mp-map-size [tree : MpTree node : MpNode] : (Option int)
    (let [n (__mp-map-size-raw tree node)]
      (if (< n 0) (:: (none) (Option int)) (:: (some n) (Option int)))))
  ;;; __mp-arr-size-raw -- internal: element count, or -1 when not an array.
  (defn __mp-arr-size-raw [tree : MpTree node : MpNode] : int
    ```c
    extern int64_t mp_arr_size(const void *, int64_t);
  return mp_arr_size((const void *)(intptr_t)tree, (int64_t)node);
  ```)
  ;;; mp-arr-size -- the number of elements in an array node.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the node to measure
  ;;;
  ;;; Returns:
  ;;;   (Option int) -- none when the node is not an array.
  ;;;
  ;;; Example:
  ;;;   (unwrap (mp-arr-size t root))   ; => 3
  ;;;
  ;;; Since: Phase MP2
  (defn mp-arr-size [tree : MpTree node : MpNode] : (Option int)
    (let [n (__mp-arr-size-raw tree node)]
      (if (< n 0) (:: (none) (Option int)) (:: (some n) (Option int)))))
  ;;; __mp-arr-get-raw -- internal: i-th element offset, or -1.
  (defn __mp-arr-get-raw [tree : MpTree node : MpNode i : int] : int
    ```c
    extern int64_t mp_arr_get(const void *, int64_t, int64_t);
  return mp_arr_get((const void *)(intptr_t)tree, (int64_t)node, (int64_t)i);
  ```)
  ;;; mp-arr-get -- the i-th element of an array node.
  ;;;
  ;;; Elements are found by walking, so iterating an array is O(n^2) in the
  ;;; element count. Fine for the record-shaped payloads the derive macros
  ;;; produce; reach for a different shape before putting a large array in a
  ;;; hot loop.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the array node
  ;;;   i    -- zero-based index
  ;;;
  ;;; Returns:
  ;;;   (Option MpNode) -- none when the node is not an array or i is out of
  ;;;   range.
  ;;;
  ;;; Example:
  ;;;   (mp-arr-get t root 0)   ; => (some <node>)
  ;;;
  ;;; Since: Phase MP2
  (defn mp-arr-get [tree : MpTree node : MpNode i : int] : (Option MpNode)
    (let [off (__mp-arr-get-raw tree node i)]
      (if (< off 0)
        (:: (none) (Option MpNode))
        (:: (some (:: off MpNode)) (Option MpNode)))))
  ;; ---------------------------------------------------------------------------
  ;; Typed reads. Each returns a Result so a wrong-typed node is an answer, not
  ;; a silently-substituted zero.
  ;; ---------------------------------------------------------------------------
  ;;; __mp-int-status -- internal: 0 ok, -1 not an integer, -2 out of int64 range.
  (defn __mp-int-status [tree : MpTree node : MpNode] : int
    ```c
    extern int64_t mp_int_status(const void *, int64_t);
  return mp_int_status((const void *)(intptr_t)tree, (int64_t)node);
  ```)
  ;;; __mp-int-value -- internal: the integer value (0 unless the status is 0).
  (defn __mp-int-value [tree : MpTree node : MpNode] : int
    ```c
    extern int64_t mp_int_value(const void *, int64_t);
  return mp_int_value((const void *)(intptr_t)tree, (int64_t)node);
  ```)
  ;;; mp-get-int -- read the node as a 64-bit signed integer.
  ;;;
  ;;; Accepts every MessagePack integer format. A uint64 above `INT64_MAX` has
  ;;; no Turmeric `int` to land in, so it is an error rather than a wrapped
  ;;; negative.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the node to read
  ;;;
  ;;; Returns:
  ;;;   (Result int cstr) -- err with a static message on a non-integer or an
  ;;;   out-of-range value.
  ;;;
  ;;; Example:
  ;;;   (ok-val (mp-get-int t (mp-tree-root t)))   ; => 42
  ;;;
  ;;; Since: Phase MP2
  (defn mp-get-int [tree : MpTree node : MpNode] : (Result int cstr)
    (let [st (__mp-int-status tree node)]
      (if (= st 0)
        (:: (ok (__mp-int-value tree node)) (Result int cstr))
        (if (= st -2)
          (:: (err "mp-get-int: value is outside the int64 range")
            (Result int cstr))
          (:: (err "mp-get-int: not an integer") (Result int cstr))))))
  ;;; __mp-bool-value -- internal: the boolean value (false unless it is a bool).
  (defn __mp-bool-value [tree : MpTree node : MpNode] : bool
    ```c
    extern int64_t mp_bool_value(const void *, int64_t);
  return mp_bool_value((const void *)(intptr_t)tree, (int64_t)node) != 0;
  ```)
  ;;; mp-get-bool -- read the node as a boolean.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the node to read
  ;;;
  ;;; Returns:
  ;;;   (Result bool cstr) -- err on anything that is not `true` / `false`.
  ;;;
  ;;; Example:
  ;;;   (ok-val (mp-get-bool t n))   ; => true
  ;;;
  ;;; Since: Phase MP2
  (defn mp-get-bool [tree : MpTree node : MpNode] : (Result bool cstr)
    (if (mp-bool? tree node)
      (:: (ok (__mp-bool-value tree node)) (Result bool cstr))
      (:: (err "mp-get-bool: not a boolean") (Result bool cstr))))
  ;;; __mp-float-value -- internal: the double value (0.0 unless numeric).
  (defn __mp-float-value [tree : MpTree node : MpNode] : float
    ```c
    extern double mp_double_value(const void *, int64_t);
  return mp_double_value((const void *)(intptr_t)tree, (int64_t)node);
  ```)
  ;;; mp-get-float -- read the node as an IEEE-754 double.
  ;;;
  ;;; Accepts float32 (widened) and float64, and also the integer formats -- an
  ;;; encoder is free to emit `1` rather than `1.0` for a whole number.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the node to read
  ;;;
  ;;; Returns:
  ;;;   (Result float cstr) -- err on a non-numeric node.
  ;;;
  ;;; Example:
  ;;;   (ok-val (mp-get-float t n))   ; => 7.1
  ;;;
  ;;; Since: Phase MP2
  (defn mp-get-float [tree : MpTree node : MpNode] : (Result float cstr)
    (if (mp-num? tree node)
      (:: (ok (__mp-float-value tree node)) (Result float cstr))
      (:: (err "mp-get-float: not a number") (Result float cstr))))
  ;;; __mp-str-copy -- internal: malloc'd copy of a str node, or NULL.
  (defn __mp-str-copy [tree : MpTree node : MpNode] : cstr
    ```c
    extern char *mp_get_str_copy(const void *, int64_t);
  return mp_get_str_copy((const void *)(intptr_t)tree, (int64_t)node);
  ```)
  ;;; mp-get-str -- read the node as a string, copied out of the tree.
  ;;;
  ;;; The copy is freshly malloc'd and NUL-terminated, so it outlives
  ;;; `mp-tree-free` and the caller owns it. A msgpack `str` may legally contain
  ;;; an embedded NUL; `cstr` cannot represent one, so such a value truncates at
  ;;; the first NUL. Reach for the raw bytes if that matters.
  ;;;
  ;;; Parameters:
  ;;;   tree -- the owning tree
  ;;;   node -- the node to read
  ;;;
  ;;; Returns:
  ;;;   (Result cstr cstr) -- err on a non-string node (a `bin` included).
  ;;;
  ;;; Example:
  ;;;   (ok-val (mp-get-str t n))   ; => "alice"  (caller frees)
  ;;;
  ;;; Since: Phase MP2
  (defn mp-get-str [tree : MpTree node : MpNode] : (Result cstr cstr)
    (let [p (__mp-str-copy tree node)]
      (if (__mp-null-cstr? p)
        (:: (err "mp-get-str: not a string") (Result cstr cstr))
        (:: (ok p) (Result cstr cstr)))))) ;; end defmodule msgpack/decode
