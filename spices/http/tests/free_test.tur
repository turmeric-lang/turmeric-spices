;; tests/http/free_test.tur -- releasing what the client hands out.
;;
;; http-get & co. return a heap result box; http-result-free releases it with
;; the response or the error message inside.  request-free releases a request
;; record and the Content-Type cells json-request adds.  No network: the error
;; results come from a refused connect to a closed loopback port and from an
;; unsupported scheme, and the ok path is exercised by the httpd spice's
;; suites, which run a server.  Under a sanitized build (TUR_CC_FLAGS=
;; -fsanitize=address) LeakSanitizer fails this file if any of it leaks.
(defmodule http/tests/free
  (import http/client :refer [http-get http-result-free])
  (import http/request :refer [request json-request request-free])
  (import json/encode)
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  (import test/runner :refer [run-all-status])
  (defn __cr-ok? [r : ptr<void>] : bool
    ```c return tur_is_ok((int64_t)(intptr_t)r); ```)
  (defn __cr-err [r : ptr<void>] : cstr
    ```c return (const char *)(intptr_t)tur_err_value((int64_t)(intptr_t)r); ```)
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
    return strcmp((const char *)a, (const char *)b) == 0;
    ```)
  ;; Fails the connect: port 1 on loopback has no listener.
  (defn refused-err [] : bool
    (let [r   (http-get "http://127.0.0.1:1/")
          msg (if (__cr-ok? r) "" (__cr-err r))
          hit (cstr-eq? "connect failed" msg)]
      (http-result-free r)
      hit))
  (defn scheme-err [] : bool
    (let [r   (http-get "gopher://example.com/")
          hit (not (__cr-ok? r))]
      (http-result-free r)
      hit))
  ;; An int payload: the built-in EncodeJson [int] instance, so nothing but
  ;; http itself allocates here.
  (defn json-request-freed [] : bool
    (let [req (json-request "POST" "http://127.0.0.1:1/items" 3 0)]
      (request-free req)
      true))
  (defn plain-request-freed [] : bool
    (let [req (request "GET" "http://127.0.0.1:1/" "" 0)]
      (request-free req)
      true))
  (defn __all-tests [] : void
    (describe "http -- freeing results and requests"
      (it "an error result carries its message and frees cleanly"
        (assert-true (refused-err)))
      (it "an unsupported-scheme error frees cleanly"
        (assert-true (scheme-err)))
      (it "request-free releases a json-request and its Content-Type cells"
        (assert-true (json-request-freed)))
      (it "request-free releases a plain request"
        (assert-true (plain-request-freed)))
      (it "http-result-free and request-free accept null handles"
        (do
          (http-result-free (:: 0 :ptr<void>))
          (request-free 0)
          (assert-true true)))))
  (defn main [] : int (__all-tests) (run-all-status)))
