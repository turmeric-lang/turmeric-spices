(defpackage tur-http
  :name "tur-http"
  :version "0.2.0"
  :description "HTTP/HTTPS client for Turmeric via mbedTLS"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}
               "json" #map{:path "../json"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "v0.1.0"
                           :subdir "spices/json"}}
  :cmake-deps #map{
                   ;; :targets is load-bearing, not decoration. Without it the generated
                   ;; manifest guesses the link dir as <dep>-build and the link lib as the
                   ;; dep name -- but mbedTLS puts its archives in <dep>-build/library and
                   ;; names them mbedtls/mbedx509/mbedcrypto, so the link failed with
                   ;; "cannot find -lmbedtls". With :targets the dirs come from CMake's own
                   ;; $<TARGET_FILE_DIR:...>. Matches the tls spice's declaration.
                   "mbedtls" #map{:url "https://github.com/Mbed-TLS/mbedtls"
                                  :ref "v3.6.2"
                                  :targets ["mbedtls" "mbedx509" "mbedcrypto"]
                                  :options #map{:BUILD_SHARED_LIBS "OFF"
                                                :ENABLE_TESTING "OFF"
                                                :ENABLE_PROGRAMS "OFF"
                                                :USE_SHARED_MBEDTLS_LIBRARY "OFF"
                                                :USE_STATIC_MBEDTLS_LIBRARY "ON"
                                                ;; See the matching comment in ../tls/build.tur: newer
                                                ;; Clang's -Wunterminated-string-initialization fires on
                                                ;; mbedtls's own TLS 1.3 label arrays and mbedtls's
                                                ;; CMakeLists turns that into a hard error by default.
                                                :MBEDTLS_FATAL_WARNINGS "OFF"}}
                   ;; yyjson (json's native lib) is no longer re-declared here: json's
                   ;; EncodeJson/DecodeJson inline-C still #includes <yyjson.h> for the typed client
                   ;; codecs (response-decode / json-request), but the compiler now collects
                   ;; :cmake-deps transitively across declared :spices, so yyjson comes in via
                   ;; the json dep above. mbedtls stays -- it is http's own TLS backend, not a
                   ;; transitive dep.
                   }
  :exports #map{"http/client" ["http-get"
                               "http-post"
                               "http-put"
                               "http-delete"
                               "http-request"
                               "http-result-free"]
                "http/request" ["request" "json-request" "request-free"]
                "http/response" ["response-status"
                                 "response-header"
                                 "response-body"
                                 "response-json"
                                 "response-decode"]
                "http/error" ["http-error-message"]})
