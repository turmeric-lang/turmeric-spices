;; examples/01_tour.tur -- a tour of tur-stats-formula, run with
;;   tur run examples/01_tour.tur
;; from spices/stats-formula. docs/guides/formula-guide.md walks through it.
(defmodule stats_formula_tour
  (export main)
  (import frame/csv :refer [read-csv-string])
  (import frame/typed :refer [frame-typed])
  (import frame/print :refer [print-frame])
  (import stats/regress :refer [ols-frame])
  (import stats/fmt :refer [print-fit])
  (import formula/ast :refer [formula-error->string])
  (import formula/terms
    :refer
    [formula-parse-terms
     formula-terms-response
     formula-terms-predictors
     formula-terms-intercept?
     formula-terms-data
     formula-terms-dropped
     formula-terms-free
     formula-term-labels])
  (import formula/model-frame :refer [model-frame-handle])
  ;; Ten cars: fuel economy, weight (1000 lb), horsepower, and the fuel type.
  ;; The last row has no weight.
  (defn cars [] : int
    (read-csv-string "mpg,wt,hp,fuel\n21.0,2.620,110,petrol\n22.8,2.320,93,petrol\n21.4,3.215,110,diesel\n18.7,3.440,175,petrol\n18.1,3.460,105,diesel\n14.3,3.570,245,petrol\n24.4,3.190,62,diesel\n22.8,3.150,95,hybrid\n19.2,3.440,123,hybrid\n17.8,,123,petrol\n"
      44
      34
      1
      100
      ""))
  ;;; labels -- a formula's term labels, space-separated.
  (defn labels [src : cstr] : void
    (match (formula-term-labels src)
      (Ok ls)
      (println (str-concat src (str-concat "   =>   " (join ls))))
      (Err e)
      (println (formula-error->string e))))
  ;;; join -- internal.
  (defn join [xs : (Cons cstr)] : cstr
    (cond (tnil? xs)         ""
          (tnil? (ttail xs)) (thead xs)
          :else              (str-concat (thead xs)
                               (str-concat " " (join (ttail xs))))))
  ;;; fit -- fit src to the cars with ols-frame and print the summary.
  (defn fit [src : cstr] : void
    (println src)
    (match (formula-parse-terms (frame-typed (cars)) src)
      (Ok t)
      (do
        (println (str-concat "rows dropped: "
                   (int->str (formula-terms-dropped t))))
        (print-fit (fit-of (ols-frame (model-frame-handle (formula-terms-data t))
                             (formula-terms-response t)
                             (formula-terms-predictors t)
                             (if (formula-terms-intercept? t) 1 0))))
        (formula-terms-free t))
      (Err e)
      (println (formula-error->string e))))
  ;;; fit-of -- the fit inside ols-frame's (untyped) result.
  (defn fit-of [r : int] : int
    ```c
    struct __cons { int64_t value; int64_t next; };
  return ((struct __cons *)(intptr_t)((struct __cons *)(intptr_t)r)->next)->value;
  ```)
  (defn main [] : int
    ;; 1. Expansion needs no data.
    (labels "mpg ~ wt * hp")
    (labels "mpg ~ (wt + hp + fuel)^2")
    (labels "mpg ~ fuel / wt")
    (labels "mpg ~ wt + I(wt^2) - 1")
    ;; 2. The model frame: response first, factors expanded, the
    ;; incomplete row left out.
    (match (formula-parse-terms (frame-typed (cars)) "log(mpg) ~ fuel + wt:hp")
      (Ok t)
      (do
        (print-frame (model-frame-handle (formula-terms-data t)))
        (formula-terms-free t))
      (Err e)
      (println (formula-error->string e)))
    ;; 3. Into tur-stats.
    (fit "mpg ~ wt + fuel")
    ;; 4. Errors carry a kind and, for syntax, a position.
    (labels "mpg ~ wt +* hp")
    (match (formula-parse-terms (frame-typed (cars)) "mpg ~ wt + colour")
      (Ok t)
      (formula-terms-free t)
      (Err e)
      (println (formula-error->string e)))
    0))
