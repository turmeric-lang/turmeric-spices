(defpackage tur-stats-formula
  :name "tur-stats-formula"
  :version "0.1.0"
  :description "Wilkinson-style model formulas (y ~ x1 * x2 + I(x3^2)) for tur-frame / tur-stats"
  :license "MIT"
  :spices #map{"frame" #map{:path "../frame"
                            :url "https://github.com/turmeric-lang/turmeric-spices"
                            :ref "frame-v0.1.0"
                            :subdir "spices/frame"
                            :optional false}
               "stats" #map{:path "../stats"
                            :url "https://github.com/turmeric-lang/turmeric-spices"
                            :ref "stats-v0.1.0"
                            :subdir "spices/stats"
                            :optional true}
               "test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :exports #map{"formula/ast" ["Op"
                               "OpAdd"
                               "OpSub"
                               "OpMul"
                               "OpDiv"
                               "OpPow"
                               "Expr"
                               "ENum"
                               "ECol"
                               "ENeg"
                               "EBin"
                               "ECall"
                               "Formula"
                               "FVar"
                               "FIntercept"
                               "FSum"
                               "FDiff"
                               "FNeg"
                               "FCross"
                               "FInteract"
                               "FNest"
                               "FPower"
                               "Lhs"
                               "OneSided"
                               "Response"
                               "ParsedFormula"
                               "parsed-formula-response"
                               "parsed-formula-rhs"
                               "FormulaErrorKind"
                               "SyntaxError"
                               "UnknownColumn"
                               "NotNumeric"
                               "DomainError"
                               "NameCollision"
                               "NoResponse"
                               "NotCategorical"
                               "UnknownLevel"
                               "TooFewLevels"
                               "FormulaError"
                               "formula-error"
                               "formula-error-at"
                               "formula-error-message"
                               "formula-error-kind"
                               "formula-error-pos"
                               "formula-error->string"
                               "expr->string"
                               "formula->string"
                               "parsed-formula->string"
                               "float->label"]
                "formula/lexer" ["TokKind"
                                 "Token"
                                 "token-kind"
                                 "token-text"
                                 "token-pos"
                                 "tok-kind-name"
                                 "formula-lex"]
                "formula/parser" ["formula-parse"
                                  "formula-parse-tokens"
                                  "formula-parse-expr"
                                  "formula-function?"]
                "formula/expand" ["Term"
                                  "term-label"
                                  "term-variables"
                                  "term-order"
                                  "Expansion"
                                  "formula-expand"
                                  "expansion-response"
                                  "expansion-variables"
                                  "expansion-variable"
                                  "expansion-terms"
                                  "expansion-labels"
                                  "expansion-intercept?"]
                "formula/model-frame" ["ModelFrame"
                                       "model-frame-handle"
                                       "model-frame-free"
                                       "model-frame-nrows"
                                       "model-frame-ncols"
                                       "model-frame-names"
                                       "model-frame-value"
                                       "model-frame-valid?"]
                "formula/identity" ["formula-eval-identity"]
                "formula/factors" ["formula-is-factor"
                                   "formula-factor-levels"
                                   "formula-dummy-code"
                                   "formula-dummy-code-interaction"]
                "formula/terms" ["FormulaTerms"
                                 "formula-parse-terms"
                                 "formula-terms-response"
                                 "formula-terms-predictors"
                                 "formula-terms-intercept?"
                                 "formula-terms-terms"
                                 "formula-terms-data"
                                 "formula-terms-dropped"
                                 "formula-terms-free"
                                 "formula-predictors"
                                 "formula-response"
                                 "formula-intercept?"
                                 "formula-term-labels"]
                "formula/text" ["text-len" "text-byte" "text-sub" "text-eq?"]
                "formula/seq" ["seq-reverse"
                               "seq-map"
                               "seq-foldl"
                               "seq-length"
                               "seq-append"
                               "seq->carrier"]})
