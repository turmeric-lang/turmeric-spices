;;; formula/seq -- the few generic (Cons A) helpers the formula modules share.
;;;
;;; The typed cons list `(Cons A)` (tcons-of / tnil / thead / ttail, all
;;; auto-loaded) rather than stdlib/list-typed's `(List A)`: loading
;;; list-typed pulls in stdlib's `String`, which collides with the `String`
;;; frame/ownstr defines, so a program could not use this spice and
;;; frame/print together.
;;;
;;; Since: 0.1.0
;; Cons-list helpers.
(defmodule formula/seq
  (export seq-reverse seq-map seq-foldl seq-length seq-append seq->carrier)
  ;;; seq-reverse-onto -- internal.
  (defn seq-reverse-onto [A] [xs : (Cons A) acc : (Cons A)] : (Cons A)
    (if (tnil? xs) acc (seq-reverse-onto (ttail xs) (tcons-of (thead xs) acc))))
  ;;; seq-reverse -- a list in reverse order.
  ;;;
  ;;; Parameters:
  ;;;   xs -- the list
  ;;;
  ;;; Returns:
  ;;;   (Cons A) -- a new list
  ;;;
  ;;; Example:
  ;;;   (seq-reverse (tcons-of 1 (tcons-of 2 (tnil))))   ; => (2 1)
  ;;;
  ;;; Since: 0.1.0
  (defn seq-reverse [A] [xs : (Cons A)] : (Cons A) (seq-reverse-onto xs (tnil)))
  ;;; seq-map -- f applied to every element, in order.
  ;;;
  ;;; Parameters:
  ;;;   xs -- the list
  ;;;   f  -- the function
  ;;;
  ;;; Returns:
  ;;;   (Cons B) -- a new list
  ;;;
  ;;; Example:
  ;;;   (seq-map xs (fn [x : int] : int (* x 2)))
  ;;;
  ;;; Since: 0.1.0
  (defn seq-map [A B] [xs : (Cons A) f : (fn [A] B)] : (Cons B)
    (if (tnil? xs)
      (:: (tnil) (Cons B))
      (tcons-of (f (thead xs)) (seq-map (ttail xs) f))))
  ;;; seq-foldl -- fold f over the list from the left.
  ;;;
  ;;; Parameters:
  ;;;   xs   -- the list
  ;;;   init -- the starting accumulator
  ;;;   f    -- (fn [acc x] acc')
  ;;;
  ;;; Returns:
  ;;;   B -- the final accumulator
  ;;;
  ;;; Example:
  ;;;   (seq-foldl xs 0 (fn [a : int x : int] : int (+ a x)))
  ;;;
  ;;; Since: 0.1.0
  (defn seq-foldl [A B] [xs : (Cons A) init : B f : (fn [B A] B)] : B
    (if (tnil? xs) init (seq-foldl (ttail xs) (f init (thead xs)) f)))
  ;;; seq-length -- the number of elements.
  ;;;
  ;;; Parameters:
  ;;;   xs -- the list
  ;;;
  ;;; Returns:
  ;;;   int
  ;;;
  ;;; Example:
  ;;;   (seq-length (tnil))   ; => 0
  ;;;
  ;;; Since: 0.1.0
  (defn seq-length [A] [xs : (Cons A)] : int (tlength xs))
  ;;; seq-append -- xs followed by ys.
  ;;;
  ;;; Parameters:
  ;;;   xs -- the first list
  ;;;   ys -- the second list
  ;;;
  ;;; Returns:
  ;;;   (Cons A) -- a new list sharing ys
  ;;;
  ;;; Example:
  ;;;   (seq-append xs ys)
  ;;;
  ;;; Since: 0.1.0
  (defn seq-append [A] [xs : (Cons A) ys : (Cons A)] : (Cons A)
    (if (tnil? xs) ys (tcons-of (thead xs) (seq-append (ttail xs) ys))))
  ;;; seq->carrier -- the untyped cons-list word, for the int-typed frame/*
  ;;; and stats/* APIs.
  ;;;
  ;;; Parameters:
  ;;;   xs -- the list
  ;;;
  ;;; Returns:
  ;;;   int -- the head cell's address, 0 for the empty list
  ;;;
  ;;; Example:
  ;;;   (schema (seq->carrier fields))
  ;;;
  ;;; Since: 0.1.0
  (defn seq->carrier [A] [xs : (Cons A)] : int (:: xs :int)))
