;;; formula/text -- the byte-level cstr helpers the lexer and parser use.
;;;
;;; Local rather than stdlib's `cstr` module: importing `cstr` from a spice
;;; makes `tur build <spice-dir>` emit `#include "cstr.h"`, a header nothing
;;; writes, so the spice's library would not build (see the spice README).
;;;
;;; Since: 0.1.0
;; Byte helpers.
(defmodule formula/text
  (export text-len text-byte text-sub text-eq?)
  ;;; text-len -- a string's length in bytes.
  ;;;
  ;;; Parameters:
  ;;;   s -- the string
  ;;;
  ;;; Returns:
  ;;;   int
  ;;;
  ;;; Example:
  ;;;   (text-len "y ~ x")   ; => 5
  ;;;
  ;;; Since: 0.1.0
  (defn text-len [s : cstr] : int
    ```c
    return (int64_t)strlen((const char *)s);
  ```)
  ;;; text-byte -- the byte at index i (0 <= i < length), as 0..255.
  ;;;
  ;;; Parameters:
  ;;;   s -- the string
  ;;;   i -- the index
  ;;;
  ;;; Returns:
  ;;;   int
  ;;;
  ;;; Example:
  ;;;   (text-byte "~" 0)   ; => 126
  ;;;
  ;;; Since: 0.1.0
  (defn text-byte [s : cstr i : int] : int
    ```c
    return (int64_t)((const unsigned char *)s)[i];
  ```)
  ;;; text-sub -- the bytes [from, to) as a new string.
  ;;;
  ;;; Parameters:
  ;;;   s    -- the string
  ;;;   from -- the first index
  ;;;   to   -- one past the last index
  ;;;
  ;;; Returns:
  ;;;   cstr -- freshly allocated
  ;;;
  ;;; Example:
  ;;;   (text-sub "y ~ x" 4 5)   ; => "x"
  ;;;
  ;;; Since: 0.1.0
  (defn text-sub [s : cstr from : int to : int] : cstr
    ```c
    size_t n = to > from ? (size_t)(to - from) : 0;
  char *out = (char *)malloc(n + 1);
  if (!out) abort();
  memcpy(out, (const char *)s + from, n);
  out[n] = '\0';
  return (const char *)out;
  ```)
  ;;; text-eq? -- byte equality.
  ;;;
  ;;; Parameters:
  ;;;   a -- a string
  ;;;   b -- a string
  ;;;
  ;;; Returns:
  ;;;   bool
  ;;;
  ;;; Example:
  ;;;   (text-eq? "log" "log")   ; => true
  ;;;
  ;;; Since: 0.1.0
  (defn text-eq? [a : cstr b : cstr] : bool
    ```c
    return strcmp((const char *)a, (const char *)b) == 0;
  ```))
