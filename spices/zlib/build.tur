(defpackage tur-zlib
  :name "tur-zlib"
  :version "0.1.0"
  :description "zlib + gzip encode/decode for Turmeric"
  :license "Zlib"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :cmake-deps #map{"zlib" #map{
                               ;; zlib's own CMakeLists.txt hardcodes BOTH the `zlib` (shared,
                               ;; libz.1.dylib) and `zlibstatic` (static, libz.a) targets --
                               ;; :BUILD_SHARED_LIBS OFF below does not gate either one. With no
                               ;; :targets declared, the link line fell back to a name-derived
                               ;; -lz, which macOS's linker resolves to the dylib (found ahead of
                               ;; the .a in the same _deps build dir); the resulting binary then
                               ;; failed at load with "Library not loaded: @rpath/libz.1.dylib --
                               ;; no LC_RPATH's found", since nothing arranged an rpath for it.
                               ;; :targets ["zlibstatic"] links by exact artifact path
                               ;; ($<TARGET_FILE:zlibstatic> -> libz.a) instead, so the shared
                               ;; library is never in the running.
                               :targets ["zlibstatic"]
                               :url "https://github.com/madler/zlib"
                               :ref "v1.3.1"
                               :options #map{:ZLIB_BUILD_EXAMPLES "OFF"
                                             :BUILD_SHARED_LIBS "OFF"}}}
  :exports #map{"tur/zlib" ["gzip-encode"
                            "gzip-decode"
                            "deflate-raw"
                            "inflate-raw"
                            "gzip-buf-data"
                            "gzip-buf-len"
                            "gzip-buf-free"]})
