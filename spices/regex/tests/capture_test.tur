;; tests/capture_test.tur -- capture accessors: cstr ownership + String siblings.
;;
;; NOTE: this test exercises the PCRE2-backed match/capture path, so it must be
;; built with the pcre2 include dir on the search path (the whole-library
;; `tur build .`, or a compile that adds -I<pcre2-build>). The spice's prior
;; only test (tree_test) is pcre2-free, so single-file `tur run`/`tur test` of a
;; pcre2-using test does not currently wire the include dir. Verified passing +
;; AddressSanitizer-clean by compiling the emitted C against a locally built
;; libpcre2-8 (all 5 assertions green, no use-after-free/double-free).
;;
;; Covers the 0.3.0 changes: capture-at/capture-named return a uniformly-owned
;; cstr (empty groups are a malloc'd "", not a static literal, so freeing the
;; result is always safe), and capture-at-string/capture-named-string return an
;; owned String.
(defmodule regex/tests/capture
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (import regex/regex :refer [Regex Match regex-compile regex-match])
  (import regex/capture
    :refer
    [capture-at capture-named capture-at-string capture-named-string])
  (import regex/ownstr :refer [String to-cstr release str-len])
  (defn seq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defn slen [s : cstr] : int
    ```c
    #include <string.h>
  return (int64_t)strlen((const char *)s);
  ```)
  (defn __free [s : cstr] : void
    ```c
    #include <stdlib.h>
  free((void *)(intptr_t)s);
  ```)
  ;; -- cstr accessor: freed after use (uniformly owned, empty case included) ----
  ;; capture-at then free; true iff it equals `want`.
  (defn cstr-at-is? [m : Match idx : int want : cstr] : bool
    (let [c (capture-at m idx)
          r (seq? c want)]
      (do (__free c) r)))
  ;; capture-at an empty/non-participating group, free it; true iff length 0.
  ;; The point of the test: freeing the empty result must not crash (it is a
  ;; malloc'd "", not a static literal).
  (defn cstr-at-empty-ok? [m : Match idx : int] : bool
    (let [c (capture-at m idx)
          r (= (slen c) 0)]
      (do (__free c) r)))
  ;; -- String accessor: released after use --------------------------------------
  ;; capture-at-string then release; true iff its bytes equal `want`.
  (defn str-at-is? [m : Match idx : int want : cstr] : bool
    (let [s (capture-at-string m idx)
          r (seq? (to-cstr s) want)]
      (do (release s) r)))
  ;; capture-named-string then release; true iff its bytes equal `want`.
  (defn str-named-is? [m : Match name : cstr want : cstr] : bool
    (let [s (capture-named-string m name)
          r (seq? (to-cstr s) want)]
      (do (release s) r)))
  ;; capture-at-string of an empty group; release; true iff length 0.
  (defn str-at-empty-ok? [m : Match idx : int] : bool
    (let [s (capture-at-string m idx)
          r (= (str-len s) 0)]
      (do (release s) r)))
  (defn run-with [m : Match] : int
    (do
      (describe "regex/capture"
        (it "capture-at returns a freed-safe cstr copy"
          (assert-true (cstr-at-is? m 1 "aaa")))
        (it "capture-at of a non-participating group is a freed-safe empty cstr"
          (assert-true (cstr-at-empty-ok? m 2)))
        (it "capture-at-string returns an owned String"
          (assert-true (str-at-is? m 1 "aaa")))
        (it "capture-named-string returns an owned String"
          (assert-true (str-named-is? m "num" "aaa")))
        (it "capture-at-string of a non-participating group is an empty String"
          (assert-true (str-at-empty-ok? m 2))))
      (run-all-status)))
  ;; Pattern: (?<num>a+)(b+)?  against "aaa" -> group 1/num = "aaa", group 2 unset.
  (defn main [] : int
    (let [rc (regex-compile "(?<num>a+)(b+)?" 0)]
      (if (ok? rc)
        (let [mr (regex-match (ok-val rc) "aaa")]
          (if (ok? mr) (run-with (ok-val mr)) (do (assert-true false) 1)))
        (do (assert-true false) 2))))) ;; end module
