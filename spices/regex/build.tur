(defpackage tur-regex
  :name "tur-regex"
  :version "0.3.0"
  :description "PCRE2 regex bindings for Turmeric"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :cmake-deps #map{
                   ;; :cmake-name pins the -l name. Without it the link lib is guessed from
                   ;; the dep name (pcre2), but the 8-bit build produces libpcre2-8.a, so the
                   ;; link failed with "cannot find -lpcre2". The link DIR (<dep>-build) the
                   ;; default guess gives is already right, so :cmake-name is the whole fix.
                   "pcre2" #map{:url "https://github.com/PCRE2Project/pcre2"
                                :ref "pcre2-10.44"
                                :cmake-name "pcre2-8"
                                :options #map{:BUILD_SHARED_LIBS "OFF"
                                              :PCRE2_BUILD_PCRE2_8 "ON"
                                              :PCRE2_BUILD_PCRE2_16 "OFF"
                                              :PCRE2_BUILD_PCRE2_32 "OFF"
                                              :PCRE2_BUILD_TESTS "OFF"
                                              :PCRE2_BUILD_PCREGREP "OFF"}}}
  :exports #map{"regex/ownstr" ["String"
                                "adopt-cstr"
                                "to-cstr"
                                "release"
                                "str-len"
                                "ownstr-autolink"]
                "regex/regex" ["Regex"
                               "Match"
                               "regex-compile"
                               "regex-free"
                               "regex-match"
                               "regex-match-all"
                               "regex-replace"
                               "regex-of"
                               "match-of"]
                "regex/capture" ["capture-count"
                                 "capture-at"
                                 "capture-named"
                                 "capture-at-string"
                                 "capture-named-string"]
                "regex/error" ["regex-error-message"]
                "regex/tree" ["ReF"
                              "Re"
                              "r-empty"
                              "r-lit"
                              "r-alt"
                              "r-cat"
                              "r-star"
                              "r-plus"
                              "r-opt"
                              "re-cata"
                              "re-size"
                              "re-nullable?"
                              "re->str"
                              "re-matches?"]})
