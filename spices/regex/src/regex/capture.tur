;; regex/capture.tur -- capture group accessors for regex-match results.
;;
;; A Match handle is the nominal opaque defined by regex/regex; it wraps a
;; heap-allocated struct { pcre2_match_data*, char* subject, size_t len,
;; int match_count, pcre2_code* re }. Produced by regex-match /
;; regex-match-all and freed by the caller (or left for GC).
(defmodule regex/capture
  (import regex/regex :refer [Match])
  (import regex/ownstr :refer [String adopt-cstr])
  (export capture-count
    capture-at
    capture-named
    capture-at-string
    capture-named-string)
  ;;; capture-count -- number of captured substrings in a Match.
  ;;;
  ;;; Parameters:
  ;;;   match -- Match handle from regex-match
  ;;;
  ;;; Returns:
  ;;;   :int -- number of captured groups (0 = only full match in group 0)
  ;;;
  ;;; Example:
  ;;;   (capture-count m)  ; => 2
  ;;;
  ;;; Since: P6 (typed in 0.2.0)
  (defn capture-count [match : Match] : int
    ```c
    #define PCRE2_CODE_UNIT_WIDTH 8
  #include <pcre2.h>
  struct __match {
    pcre2_match_data *md;
    const char       *subject;
    size_t            subject_len;
    int               match_count;
    pcre2_code       *re;
  };
  struct __match *m = (struct __match *)(intptr_t)match;
  return (int64_t)(m->match_count - 1); /* exclude group 0 (full match) */
  ```)
  ;;; capture-at -- substring captured by a numbered group.
  ;;;
  ;;; Parameters:
  ;;;   match -- Match handle from regex-match
  ;;;   idx   -- group index (0 = full match, 1 = first capture group, ...)
  ;;;
  ;;; Returns:
  ;;;   :cstr -- captured substring as a freshly malloc'd copy the caller frees;
  ;;;            a malloc'd empty string "" when the group did not participate or
  ;;;            the index is out of range. (Prior to 0.3.0 the empty case
  ;;;            returned a static "" literal, so a caller that freed the result
  ;;;            per this contract crashed on empty groups -- that footgun is
  ;;;            fixed: the return is now uniformly owned. Prefer capture-at-string
  ;;;            for an owned String that cannot be forgotten.)
  ;;;
  ;;; Example:
  ;;;   (capture-at m 0)  ; full match
  ;;;   (capture-at m 1)  ; first capture group
  ;;;
  ;;; Since: P6 (typed in 0.2.0; uniformly-owned empty case in 0.3.0)
  (defn capture-at [match : Match idx : int] : cstr
    ```c
    #define PCRE2_CODE_UNIT_WIDTH 8
  #include <pcre2.h>
  #include <stdlib.h>
  #include <string.h>
  struct __match {
    pcre2_match_data *md;
    const char       *subject;
    size_t            subject_len;
    int               match_count;
    pcre2_code       *re;
  };
  struct __match *m = (struct __match *)(intptr_t)match;
  PCRE2_SIZE *ov = pcre2_get_ovector_pointer(m->md);
  int i = (int)idx;
  if (i < 0 || i >= m->match_count) { char *e = malloc(1); e[0] = 0; return (const char *)e; }
  PCRE2_SIZE start = ov[2 * i];
  PCRE2_SIZE end   = ov[2 * i + 1];
  if (start == PCRE2_UNSET) { char *e = malloc(1); e[0] = 0; return (const char *)e; }
  size_t len = end - start;
  char *out = malloc(len + 1);
  memcpy(out, m->subject + start, len);
  out[len] = '\0';
  return out;
  ```)
  ;;; capture-named -- substring captured by a named group.
  ;;;
  ;;; Parameters:
  ;;;   match -- Match handle from regex-match
  ;;;   name  -- group name as it appears in the pattern (e.g. "year")
  ;;;
  ;;; Returns:
  ;;;   :cstr -- captured substring as a freshly malloc'd copy the caller frees;
  ;;;            a malloc'd empty string "" when the group is not found / did not
  ;;;            participate. (Uniformly owned since 0.3.0 -- see capture-at.)
  ;;;            Prefer capture-named-string for an owned String.
  ;;;
  ;;; Example:
  ;;;   (capture-named m "year")
  ;;;
  ;;; Since: P6 (typed in 0.2.0; uniformly-owned empty case in 0.3.0)
  (defn capture-named [match : Match name : cstr] : cstr
    ```c
    #define PCRE2_CODE_UNIT_WIDTH 8
  #include <pcre2.h>
  #include <stdlib.h>
  #include <string.h>
  struct __match {
    pcre2_match_data *md;
    const char       *subject;
    size_t            subject_len;
    int               match_count;
    pcre2_code       *re;
  };
  struct __match *m = (struct __match *)(intptr_t)match;
  int idx = pcre2_substring_number_from_name(m->re, (PCRE2_SPTR8)name);
  if (idx < 0) { char *e = malloc(1); e[0] = 0; return (const char *)e; }
  PCRE2_SIZE *ov = pcre2_get_ovector_pointer(m->md);
  PCRE2_SIZE start = ov[2 * idx];
  PCRE2_SIZE end   = ov[2 * idx + 1];
  if (start == PCRE2_UNSET) { char *e = malloc(1); e[0] = 0; return (const char *)e; }
  size_t len = end - start;
  char *out = malloc(len + 1);
  memcpy(out, m->subject + start, len);
  out[len] = '\0';
  return out;
  ```)
  ;;; capture-at-string -- owned-String sibling of capture-at.
  ;;;
  ;;; Same substring as capture-at, returned as an owned String (release it, or
  ;;; hand it to a container that takes ownership). Captures are routinely stored
  ;;; past the match, so the owning return removes the free obligation from the
  ;;; type. An empty String is returned when the group did not participate.
  ;;;
  ;;; Parameters:
  ;;;   match -- Match handle from regex-match
  ;;;   idx   -- group index (0 = full match, 1 = first capture group, ...)
  ;;;
  ;;; Returns:
  ;;;   String -- owned captured substring.
  ;;;
  ;;; Example:
  ;;;   (capture-at-string m 1)  ; owned first capture group
  ;;;
  ;;; Since: 0.3.0
  (defn capture-at-string [match : Match idx : int] : String
    (adopt-cstr (capture-at match idx)))
  ;;; capture-named-string -- owned-String sibling of capture-named.
  ;;;
  ;;; Same substring as capture-named, returned as an owned String. An empty
  ;;; String is returned when the group is not found / did not participate.
  ;;;
  ;;; Parameters:
  ;;;   match -- Match handle from regex-match
  ;;;   name  -- group name as it appears in the pattern (e.g. "year")
  ;;;
  ;;; Returns:
  ;;;   String -- owned captured substring.
  ;;;
  ;;; Example:
  ;;;   (capture-named-string m "year")  ; owned named capture
  ;;;
  ;;; Since: 0.3.0
  (defn capture-named-string [match : Match name : cstr] : String
    (adopt-cstr (capture-named match name)))) ;; end defmodule regex/capture
