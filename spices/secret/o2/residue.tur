;; tests/o2/residue.tur -- does the wipe survive dead-store elimination?
;;
;; The functional suite proves `secure-wipe-ptr!` writes zeros. It cannot
;; prove the *interesting* property, because it reads the buffer back
;; afterwards -- and a store that is later read is never a dead store. The
;; case that matters is the opposite one: a buffer wiped immediately before
;; it goes out of scope, where a plain `memset` is a textbook elimination
;; target and the key material is left on the stack.
;;
;; This probe measures that directly:
;;
;;   1. `write-and-wipe` fills a stack buffer with a magic pattern, consumes
;;      it (so the fill itself cannot be removed), wipes it, and returns.
;;   2. `scan-frame` then claims a same-sized frame at the same depth and
;;      counts how many copies of the magic are still sitting there.
;;
;; `write-and-memset` is the control: identical shape, plain `memset`. It
;; tells us whether the probe has any discriminating power on this
;; toolchain -- if even the control leaves no residue, the compiler did not
;; attempt the elimination here and a clean result for our wipe proves
;; nothing. Reporting that honestly beats banking a vacuous pass.
;;
;; Exit codes: 0 = wipe clean, 2 = RESIDUE FOUND (real failure).
;; Reading an uninitialized frame is undefined behavior; that is inherent to
;; the measurement and the reason this lives in its own opt-in fixture
;; rather than in the main suite.
;;
;; It did NOT live outside the main suite until now: this file sat in
;; tests/o2/, and `tur test tests` recurses, so it ran on every CI build --
;; with the driver's default cc flags rather than the -O2 that run.sh sets and
;; that every claim here depends on. It has moved to o2/, alongside its
;; runner, so it is opt-in in fact and not only in this comment.
;;
;; A caution on reading the result, learned the hard way. This measurement is
;; extremely sensitive to stack layout. Run as-is on x86-64 gcc it reports
;; 64 / 64 / 1 and calls the trailing 1 a failure. Add a single printf inside
;; scan-frame -- changing nothing but the scanner's own frame -- and the same
;; build reports 60 / 60 / 0 and passes. The controls move too (64 -> 60), so
;; that lone hit is a window straddling the edge of the wiped region, not
;; eight bytes of key material that survived: secure-wipe-ptr! removed 63 of
;; the 64 copies the control leaves intact. Treat a small non-zero count as a
;; prompt to re-measure, not as a breach. The threshold is left as the author
;; set it.
(defmodule secret/tests/o2/residue
  (import secret/hygiene :refer [secure-wipe-ptr!])
  ;; 512 bytes = 64 copies of the 8-byte magic.
  ;;; write-and-wipe -- fill a stack frame with magic, use it, then wipe it.
  ;;; Returns the checksum so the fill cannot itself be optimized away.
  (defn write-and-wipe [] : int
    ```c
    #include <string.h>
  unsigned char buf[512];
  /* Access through a volatile pointer so the bytes genuinely reach the
     stack. Without it the optimizer keeps the whole array in SSA values,
     never materializes the frame, and every residue count below is zero for
     an uninteresting reason. */
  volatile unsigned char *vb = buf;
  static const unsigned char magic[8] =
    { 0xA5, 0x5A, 0xC3, 0x3C, 0x96, 0x69, 0xF0, 0x0F };
  for (int i = 0; i < 512; i++) vb[i] = magic[i & 7];
  int64_t sum = 0;
  for (int i = 0; i < 512; i++) sum += vb[i];
  __TUR_CNAME_secure-wipe-ptr!__((void *)buf, 512);
  return sum;
  ```)
  ;;; write-and-memset -- the control: same shape, but a plain memset that the
  ;;; optimizer is entitled to delete outright.
  (defn write-and-memset [] : int
    ```c
    #include <string.h>
  unsigned char buf[512];
  /* Access through a volatile pointer so the bytes genuinely reach the
     stack. Without it the optimizer keeps the whole array in SSA values,
     never materializes the frame, and every residue count below is zero for
     an uninteresting reason. */
  volatile unsigned char *vb = buf;
  static const unsigned char magic[8] =
    { 0xA5, 0x5A, 0xC3, 0x3C, 0x96, 0x69, 0xF0, 0x0F };
  for (int i = 0; i < 512; i++) vb[i] = magic[i & 7];
  int64_t sum = 0;
  for (int i = 0; i < 512; i++) sum += vb[i];
  memset(buf, 0, 512);
  return sum;
  ```)
  ;;; scan-frame -- claim a same-sized frame and count surviving magic copies.
  (defn scan-frame [] : int
    ```c
    unsigned char probe[512];
  /* Reading an uninitialized object yields `undef`, which the optimizer is
     free to fold the comparison against -- at -O2 clang deletes the entire
     scan and reports zero hits no matter what is really in the frame. A
     volatile read has to be performed. */
  volatile unsigned char *vp = probe;
  static const unsigned char magic[8] =
    { 0xA5, 0x5A, 0xC3, 0x3C, 0x96, 0x69, 0xF0, 0x0F };
  int64_t hits = 0;
  for (int i = 0; i + 8 <= 512; i++) {
    int match = 1;
    for (int j = 0; j < 8; j++)
      if (vp[i + j] != magic[j]) { match = 0; break; }
    if (match) hits++;
  }
  return hits;
  ```)
  ;; -------------------------------------------------------------------------
  ;; Calling the writer and the scanner through `volatile` function pointers is
  ;; what makes the probe work. Called directly, all three bodies inline into
  ;; main, their arrays are given *disjoint* slots in one big frame, and the
  ;; scanner never looks at the memory the writer used -- so even the plain
  ;; memset control reports zero residue and the whole measurement is vacuous.
  ;; A volatile pointer is a value the compiler must reload and cannot resolve,
  ;; so each call is a real call at the same stack depth, and the scanner's
  ;; frame lands on top of the writer's.
  ;; -------------------------------------------------------------------------
  ;;; write-only -- the positive control: fill the frame and never wipe it.
  ;;; If even this leaves no residue, the scanner is not landing on the
  ;;; writer's frame and every other number below is meaningless.
  (defn write-only [] : int
    ```c
    unsigned char buf[512];
  /* Access through a volatile pointer so the bytes genuinely reach the
     stack. Without it the optimizer keeps the whole array in SSA values,
     never materializes the frame, and every residue count below is zero for
     an uninteresting reason. */
  volatile unsigned char *vb = buf;
  static const unsigned char magic[8] =
    { 0xA5, 0x5A, 0xC3, 0x3C, 0x96, 0x69, 0xF0, 0x0F };
  for (int i = 0; i < 512; i++) vb[i] = magic[i & 7];
  int64_t sum = 0;
  for (int i = 0; i < 512; i++) sum += vb[i];
  return sum;
  ```)
  ;;; probe-none -- write without wiping, then scan the reclaimed frame.
  (defn probe-none [] : int
    ```c
    static int64_t (*volatile w)(void) =
    (int64_t (*)(void))__TUR_CNAME_write-only__;
  static int64_t (*volatile s)(void) =
    (int64_t (*)(void))__TUR_CNAME_scan-frame__;
  (void)w();
  return s();
  ```)
  ;;; probe-wipe -- write+wipe, then scan the reclaimed frame.
  (defn probe-wipe [] : int
    ```c
    static int64_t (*volatile w)(void) =
    (int64_t (*)(void))__TUR_CNAME_write-and-wipe__;
  static int64_t (*volatile s)(void) =
    (int64_t (*)(void))__TUR_CNAME_scan-frame__;
  (void)w();
  return s();
  ```)
  ;;; probe-control -- write+plain-memset, then scan the reclaimed frame.
  (defn probe-control [] : int
    ```c
    static int64_t (*volatile w)(void) =
    (int64_t (*)(void))__TUR_CNAME_write-and-memset__;
  static int64_t (*volatile s)(void) =
    (int64_t (*)(void))__TUR_CNAME_scan-frame__;
  (void)w();
  return s();
  ```)
  ;;; report -- print one labelled residue count.
  (defn report [label : cstr hits : int] : void
    ```c
    #include <stdio.h>
  printf("  %-24s residue=%lld\n", (const char *)label, (long long)hits);
  ```)
  (defn main [] : int
    (do
      (println "stack-residue probe (built with -O2):")
      (let [unwiped (probe-none)
            control (probe-control)
            ours    (probe-wipe)]
        (do
          (report "no wipe (positive ctl)" unwiped)
          (report "plain memset (control)" control)
          (report "secure-wipe-ptr!" ours)
          (if (> ours 0)
            (do
              (println "FAIL: key material survived secure-wipe-ptr! on the stack")
              2)
            (if (= unwiped 0)
              (do
                (println "PASS (probe blind): even the never-wiped frame shows no")
                (println "  residue, so the scanner is not observing the writer's")
                (println "  frame on this toolchain. This run proves nothing about")
                (println "  dead-store elimination -- only that nothing regressed.")
                0)
              (if (> control 0)
                (do
                  (println "PASS: wipe left no residue; plain memset did -- the")
                  (println "  probe is discriminating and secure-wipe-ptr! held.")
                  0)
                (do
                  (println "PASS (weak): the frame is observable, but plain memset")
                  (println "  was not elided here either, so the wipe was not under")
                  (println "  real pressure in this run.")
                  0))))))))) ;; end defmodule secret/tests/o2/residue
