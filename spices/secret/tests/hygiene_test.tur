;; tests/hygiene_test.tur -- functional coverage for the S1 hygiene floor.
;;
;; Behavior only. The claim that `secure-wipe-ptr!` survives dead-store
;; elimination is a *codegen* claim and cannot be settled from inside the
;; program being optimized; tests/o2/run.sh probes that separately.
;;
;; Style notes:
;;   - `it` wants its body to evaluate to a bool, so each case ends in
;;     `free1`/`free2`, which release the buffers and pass the verdict
;;     through. Freeing after the assertion would drop it.
;;   - void-returning calls are sequenced with `do`, never bound in a `let`.
;;     That used to be a trap -- binding one emitted `void x = ...` and the C
;;     compile failed with no .tur attribution. As of turmeric 490172c6 it is
;;     a proper diagnostic (TUR-E0023) naming `do` as the fix, so the rule is
;;     now enforced rather than merely documented here.
(defmodule secret/tests/hygiene
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (import secret/hygiene
    :refer
    [secure-wipe-ptr! crypto-random-bytes! crypto-random-source ct-eq-ptr?])
  ;; -------------------------------------------------------------------------
  ;; Raw-buffer helpers (the module under test is pointer-shaped by design)
  ;; -------------------------------------------------------------------------
  ;;; alloc-buf -- malloc `n` bytes, zero-filled.
  (defn alloc-buf [n : int] : ptr<void>
    ```c
    #include <stdlib.h>
  return calloc((size_t)(n > 0 ? n : 1), 1);
  ```)
  ;;; free1 -- free `p`, then return `verdict`.
  (defn free1 [p : ptr<void> verdict : bool] : bool
    ```c
    #include <stdlib.h>
  if (p) free(p);
  return verdict;
  ```)
  ;;; free2 -- free `p` and `q`, then return `verdict`.
  (defn free2 [p : ptr<void> q : ptr<void> verdict : bool] : bool
    ```c
    #include <stdlib.h>
  if (p) free(p);
  if (q) free(q);
  return verdict;
  ```)
  ;;; fill-buf! -- set every one of `n` bytes at `p` to `v`; returns `n`.
  (defn fill-buf! [p : ptr<void> n : int v : int] : int
    ```c
    #include <string.h>
  memset(p, (int)(v & 0xff), (size_t)n);
  return n;
  ```)
  ;;; count-nonzero -- how many of the first `n` bytes at `p` are non-zero.
  (defn count-nonzero [p : ptr<void> n : int] : int
    ```c
    const unsigned char *q = (const unsigned char *)p;
  int64_t c = 0;
  for (int64_t i = 0; i < n; i++) if (q[i] != 0) c++;
  return c;
  ```)
  ;;; byte-at -- read the byte at index `i`.
  (defn byte-at [p : ptr<void> i : int] : int
    ```c
    return (int64_t)((const unsigned char *)p)[i];
  ```)
  ;;; offset-buf -- a pointer `i` bytes into `p`.
  (defn offset-buf [p : ptr<void> i : int] : ptr<void>
    ```c
    return (void *)((unsigned char *)p + i);
  ```)
  ;;; poke! -- write `v` to byte index `i`; returns `v`.
  (defn poke! [p : ptr<void> i : int v : int] : int
    ```c
    ((unsigned char *)p)[i] = (unsigned char)(v & 0xff);
  return v;
  ```)
  ;;; cstr-eq? -- compare two NUL-terminated strings.
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  ;; -------------------------------------------------------------------------
  ;; Compiled modules do not execute top-level forms, so the suite lives in a
  ;; defn that main calls (the layout every other spice's tests use).
  ;; -------------------------------------------------------------------------
  (defn __all-tests [] : void
    (describe "secure-wipe-ptr!"
      (it "zeroes every byte of the region"
        (let [n   64
              buf (alloc-buf n)]
          (do
            (fill-buf! buf n 255)
            (let [dirty (count-nonzero buf n)]
              (do
                (secure-wipe-ptr! buf n)
                (free1 buf
                  (and (assert-eq n dirty) (assert-eq 0 (count-nonzero buf n)))))))))
      (it "wipes exactly n bytes and not one more"
        ;; Over-wiping is as much a bug as under-wiping: it would corrupt an
        ;; adjacent field in a packed allocation.
        (let [buf (alloc-buf 32)]
          (do
            (fill-buf! buf 32 170)
            (secure-wipe-ptr! buf 16)
            (free1 buf
              (and (assert-eq 0 (count-nonzero buf 16))
                (and (assert-eq 170 (byte-at buf 16))
                  (assert-eq 170 (byte-at buf 31))))))))
      (it "treats a zero or negative length as a no-op"
        (let [buf (alloc-buf 8)]
          (do
            (fill-buf! buf 8 1)
            (secure-wipe-ptr! buf 0)
            (secure-wipe-ptr! buf -1)
            (free1 buf (assert-eq 8 (count-nonzero buf 8)))))))
    (describe "crypto-random-bytes!"
      (it "reports a known OS backend, never a fallback to rand()"
        (let [src (crypto-random-source)]
          (assert-true (or (cstr-eq? src "arc4random_buf")
                         (or (cstr-eq? src "getrandom")
                           (or (cstr-eq? src "BCryptGenRandom")
                             (cstr-eq? src "/dev/urandom")))))))
      (it "succeeds and fills the buffer with non-constant bytes"
        (let [n   64
              buf (alloc-buf n)
              r   (crypto-random-bytes! buf n)]
          ;; 64 random bytes are all-zero with probability 2^-512. A failure
          ;; here means the buffer was never written, not bad luck.
          (free1 buf
            (and (assert-true (ok? r))
              (and (assert-eq n (ok-val r))
                (assert-true (> (count-nonzero buf n) 0)))))))
      (it "produces a different stream on each call"
        (let [n 32
              a (alloc-buf n)
              b (alloc-buf n)]
          (do
            (crypto-random-bytes! a n)
            (crypto-random-bytes! b n)
            ;; Catches a backend stuck at a fixed seed -- the exact failure mode
            ;; srand(time(NULL)) has within a single second.
            (free2 a b (assert-true (not (ct-eq-ptr? a b n)))))))
      (it "writes nothing outside the requested length"
        (let [buf (alloc-buf 48)]
          (do
            (crypto-random-bytes! buf 16)
            (free1 buf (assert-eq 0 (count-nonzero (offset-buf buf 16) 32))))))
      (it "accepts a zero length and rejects a negative one"
        (let [buf (alloc-buf 8)
              z   (crypto-random-bytes! buf 0)
              neg (crypto-random-bytes! buf -1)]
          (free1 buf
            (and (assert-true (ok? z))
              (and (assert-eq 0 (ok-val z)) (assert-true (err? neg))))))))
    (describe "ct-eq-ptr?"
      (it "reports equal buffers as equal"
        (let [a (alloc-buf 32)
              b (alloc-buf 32)]
          (do
            (fill-buf! a 32 7)
            (fill-buf! b 32 7)
            (free2 a b (assert-true (ct-eq-ptr? a b 32))))))
      (it "detects a difference in the very last byte"
        ;; The byte memcmp reaches last -- the one an early-exit implementation
        ;; is most likely to get right by accident.
        (let [a (alloc-buf 32)
              b (alloc-buf 32)]
          (do
            (fill-buf! a 32 7)
            (fill-buf! b 32 7)
            (poke! b 31 8)
            (free2 a b (assert-true (not (ct-eq-ptr? a b 32)))))))
      (it "detects a difference in the very first byte"
        (let [a (alloc-buf 32)
              b (alloc-buf 32)]
          (do
            (fill-buf! a 32 7)
            (fill-buf! b 32 7)
            (poke! a 0 8)
            (free2 a b (assert-true (not (ct-eq-ptr? a b 32)))))))
      (it "compares a random buffer equal to itself"
        (let [a (alloc-buf 32)]
          (do
            (crypto-random-bytes! a 32)
            (free1 a (assert-true (ct-eq-ptr? a a 32))))))
      (it "treats a zero length as equal"
        (let [a (alloc-buf 8)] (free1 a (assert-true (ct-eq-ptr? a a 0))))))) ;; end __all-tests
  (defn main [] : int
    (__all-tests)
    ;; run-all-status, not run-all: `tur test` judges a file by its exit code,
    ;; and returning a hardcoded 0 means a failing assertion prints `not ok`
    ;; and the suite still reports success.
    (run-all-status)))
