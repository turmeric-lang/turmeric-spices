;; tests/kdf_test.tur -- SHA-256 / HMAC-SHA256 / HKDF-SHA256 against the
;; published test vectors.
;;
;; This is the load-bearing test file in the spice. Everything else checks
;; behavior we chose; this checks arithmetic we did not, against values
;; fixed by FIPS 180-4, RFC 4231, and RFC 5869. A self-contained crypto
;; implementation that is not pinned to published vectors is a liability, so
;; if these are ever weakened or skipped, the case for implementing SHA-256
;; here rather than linking mbedTLS collapses with them.
;;
;; Vectors covered:
;;   SHA-256  -- "", "abc", and a 56-byte input (two-block, padding-boundary)
;;   RFC 4231 -- HMAC cases 1, 2, 3, 6 (case 6 has a 131-byte key, exercising
;;               the "hash the key first" branch of RFC 2104)
;;   RFC 5869 -- HKDF cases 1 and 3 (case 3 has empty salt and empty info,
;;               exercising the zero-salt default)
(defmodule secret/tests/kdf
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  (import test/runner :refer [run-all-status])
  (import secret/kdf
    :refer
    [sha256-raw!
     hmac-sha256-raw!
     hkdf-sha256-raw!
     secret-hmac-sha256
     secret-hkdf-sha256])
  (import secret/core
    :refer
    [Secret secret-of-bytes secret-wipe! with-secret secret-len])
  ;; -------------------------------------------------------------------------
  ;; Helpers: hex <-> bytes, so vectors can be written the way the RFCs print
  ;; them. These are test scaffolding, not the constant-time codecs in
  ;; secret/hex -- readability wins here.
  ;; -------------------------------------------------------------------------
  ;;; hex->buf -- decode a hex string into a fresh buffer; caller frees.
  (defn hex->buf [h : cstr] : ptr<void>
    ```c
    #include <stdlib.h>
  #include <string.h>
  const char *s = (const char *)h;
  size_t n = strlen(s) / 2;
  unsigned char *b = (unsigned char *)malloc(n ? n : 1);
  for (size_t i = 0; i < n; i++) {
    int hi = s[i*2], lo = s[i*2+1];
    hi = (hi <= '9') ? hi - '0' : (hi | 0x20) - 'a' + 10;
    lo = (lo <= '9') ? lo - '0' : (lo | 0x20) - 'a' + 10;
    b[i] = (unsigned char)((hi << 4) | lo);
  }
  return b;
  ```)
  ;;; hex-len -- byte length a hex string decodes to.
  (defn hex-len [h : cstr] : int
    ```c
    #include <string.h>
  return (int64_t)(strlen((const char *)h) / 2);
  ```)
  ;;; str->buf -- a heap copy of a cstr's bytes (no NUL); caller frees.
  (defn str->buf [s : cstr] : ptr<void>
    ```c
    #include <stdlib.h>
  #include <string.h>
  const char *p = (const char *)s;
  size_t n = strlen(p);
  unsigned char *b = (unsigned char *)malloc(n ? n : 1);
  memcpy(b, p, n);
  return b;
  ```)
  ;;; str-len -- byte length of a cstr.
  (defn str-len [s : cstr] : int
    ```c
    #include <string.h>
  return (int64_t)strlen((const char *)s);
  ```)
  ;;; alloc-buf -- malloc `n` zeroed bytes.
  (defn alloc-buf [n : int] : ptr<void>
    ```c
    #include <stdlib.h>
  return calloc((size_t)(n > 0 ? n : 1), 1);
  ```)
  ;;; free3 -- free up to three buffers, passing `verdict` through.
  (defn free3 [a : ptr<void> b : ptr<void> c : ptr<void> verdict : bool] : bool
    ```c
    #include <stdlib.h>
  if (a) free(a);
  if (b) free(b);
  if (c) free(c);
  return verdict;
  ```)
  ;;; buf-eq-hex? -- does `n` bytes at `p` equal the given hex string?
  (defn buf-eq-hex? [p : ptr<void> n : int expect : cstr] : bool
    ```c
    #include <string.h>
  const unsigned char *b = (const unsigned char *)p;
  const char *s = (const char *)expect;
  if (strlen(s) != (size_t)n * 2) return false;
  for (int64_t i = 0; i < n; i++) {
    int hi = s[i*2], lo = s[i*2+1];
    hi = (hi <= '9') ? hi - '0' : (hi | 0x20) - 'a' + 10;
    lo = (lo <= '9') ? lo - '0' : (lo | 0x20) - 'a' + 10;
    if (b[i] != (unsigned char)((hi << 4) | lo)) return false;
  }
  return true;
  ```)
  ;;; secret-eq-hex? -- with-secret callback needs a fixed shape, so the
  ;;; expected value is passed through a module-level slot instead.
  (defn expect-slot [set : bool v : cstr] : cstr
    ```c
    static const char *slot = "";
  if (set) slot = (const char *)v;
  return slot;
  ```)
  ;;; check-against-slot -- with-secret callback: compare payload to the slot.
  (defn check-against-slot [p : ptr<void> n : int] : int
    (if (buf-eq-hex? p n (expect-slot false "")) 1 0))
  ;;; secret-matches-hex? -- compare a Secret's payload to `expect`, then wipe
  ;;; it (this consumes the Secret).
  ;;;
  ;;; Takes the Secret rather than the enclosing Result on purpose: a
  ;;; Turmeric-built Result passed as a *parameter* has the box->struct unbox
  ;;; applied a second time by the callee, and the C compile fails with
  ;;; "operand of type 'struct tur_adt_Result__Secret__cstr' where arithmetic
  ;;; or pointer type is required". Callers unwrap at the call site instead.
  (defn secret-matches-hex? [k : Secret expect : cstr] : bool
    (let [_   (expect-slot true expect)
          hit (with-secret k check-against-slot)]
      (do (secret-wipe! k) (= hit 1))))
  ;;; str-concat3 -- join three literals (vectors are wrapped for readability).
  (defn str-concat3 [a : cstr b : cstr c : cstr] : cstr
    ```c
    #include <stdlib.h>
  #include <string.h>
  const char *x = (const char *)a, *y = (const char *)b, *z = (const char *)c;
  size_t n = strlen(x) + strlen(y) + strlen(z);
  char *r = (char *)malloc(n + 1);
  strcpy(r, x); strcat(r, y); strcat(r, z);
  return r;
  ```)
  ;; -------------------------------------------------------------------------
  ;; SHA-256 -- FIPS 180-4 / NIST examples
  ;; -------------------------------------------------------------------------
  ;;; t-sha256-empty -- SHA-256 of the empty string.
  (defn t-sha256-empty [] : bool
    (let [out (alloc-buf 32)]
      (do
        (sha256-raw! out 0 out)
        (free3 out
          0
          0
          (assert-true (buf-eq-hex? out
                         32
                         "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))))))
  ;;; t-sha256-abc -- SHA-256("abc").
  (defn t-sha256-abc [] : bool
    (let [msg (str->buf "abc")
          out (alloc-buf 32)]
      (do
        (sha256-raw! msg 3 out)
        (free3 msg
          out
          0
          (assert-true (buf-eq-hex? out
                         32
                         "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))))))
  ;;; t-sha256-two-block -- a 56-byte input, which pushes the length field into
  ;;; a second block. This is the padding branch most hand-rolled SHA-256
  ;;; implementations get wrong.
  (defn t-sha256-two-block [] : bool
    (let [m   "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
          msg (str->buf m)
          n   (str-len m)
          out (alloc-buf 32)]
      (do
        (sha256-raw! msg n out)
        (free3 msg
          out
          0
          (assert-true (buf-eq-hex? out
                         32
                         "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"))))))
  ;; -------------------------------------------------------------------------
  ;; HMAC-SHA256 -- RFC 4231
  ;; -------------------------------------------------------------------------
  ;;; hmac-vector-ok? -- run one RFC 4231 case given hex key + raw message.
  (defn hmac-vector-ok? [key-hex : cstr msg : cstr expect : cstr] : bool
    (let [k   (hex->buf key-hex)
          kl  (hex-len key-hex)
          m   (str->buf msg)
          ml  (str-len msg)
          out (alloc-buf 32)]
      (do
        (hmac-sha256-raw! k kl m ml out)
        (free3 k m out (buf-eq-hex? out 32 expect)))))
  ;;; t-hmac-case1 -- RFC 4231 test case 1: 20-byte key, "Hi There".
  (defn t-hmac-case1 [] : bool
    (assert-true (hmac-vector-ok? "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
                   "Hi There"
                   "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")))
  ;;; t-hmac-case2 -- RFC 4231 test case 2: short key ("Jefe").
  (defn t-hmac-case2 [] : bool
    (assert-true (hmac-vector-ok? "4a656665"
                   "what do ya want for nothing?"
                   "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")))
  ;;; t-hmac-case3 -- RFC 4231 test case 3: 20-byte key, 50 bytes of 0xdd.
  (defn t-hmac-case3 [] : bool
    (let [k   (hex->buf "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
          m   (hex->buf "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")
          out (alloc-buf 32)]
      (do
        (hmac-sha256-raw! k 20 m 50 out)
        (free3 k
          m
          out
          (assert-true (buf-eq-hex? out
                         32
                         "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe"))))))
  ;;; t-hmac-long-key -- RFC 4231 test case 6: a 131-byte key, longer than the
  ;;; 64-byte block, so RFC 2104 says hash it first. A separate branch.
  (defn t-hmac-long-key [] : bool
    (assert-true (hmac-vector-ok? "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                   "Test Using Larger Than Block-Size Key - Hash Key First"
                   "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")))
  ;; -------------------------------------------------------------------------
  ;; HKDF-SHA256 -- RFC 5869
  ;; -------------------------------------------------------------------------
  ;;; t-hkdf-case1 -- RFC 5869 test case 1: L=42, with salt and info.
  ;;; Driven through hkdf-sha256-raw! because the salt is 00 01 .. 0c -- a
  ;;; leading NUL, which the cstr-flavored secret-hkdf-sha256 cannot express.
  (defn t-hkdf-case1 [] : bool
    (let [ikm  (hex->buf "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
          salt (hex->buf "000102030405060708090a0b0c")
          info (hex->buf "f0f1f2f3f4f5f6f7f8f9")
          out  (alloc-buf 42)
          ok   (hkdf-sha256-raw! ikm 22 salt 13 info 10 out 42)]
      (do
        (free3 salt info 0 true)
        (free3 ikm
          out
          0
          (assert-true (and ok
                         (buf-eq-hex? out
                           42
                           (str-concat3 "3cb25f25faacd57a90434f64d0362f2a"
                             "2d2d0a90cf1a5a4c5db02d56ecc4c5bf"
                             "34007208d5b887185865"))))))))
  ;;; t-hkdf-case3 -- RFC 5869 test case 3: empty salt and empty info, which
  ;;; selects the HashLen-zeros default salt.
  (defn t-hkdf-case3 [] : bool
    (let [ikm (hex->buf "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
          r   (secret-of-bytes ikm 22)]
      (if (ok? r)
        (let [k  (ok-val r)
              dr (secret-hkdf-sha256 k "" "" 42)]
          (do
            (secret-wipe! k)
            (free3 ikm
              0
              0
              (assert-true (if (ok? dr)
                             (secret-matches-hex? (ok-val dr)
                               (str-concat3 "8da4e775a563c18f715f802a063c5a31"
                                 "b8a11f5c5ee1879ec3454e5f3c738d2d"
                                 "9d201395faa4b61a96c8"))
                             false)))))
        (free3 ikm 0 0 (assert-true false)))))
  ;; -------------------------------------------------------------------------
  ;; Secret-level API
  ;; -------------------------------------------------------------------------
  ;;; t-secret-hmac-shape -- the Secret wrapper produces a 32-byte Secret and
  ;;; agrees with the raw function on the same inputs.
  (defn t-secret-hmac-shape [] : bool
    (let [kb (hex->buf "4a656665")
          r  (secret-of-bytes kb 4)]
      (if (ok? r)
        (let [k  (ok-val r)
              m  (str->buf "what do ya want for nothing?")
              ml (str-len "what do ya want for nothing?")
              mr (secret-hmac-sha256 k m ml)]
          (do
            (secret-wipe! k)
            (free3 kb
              m
              0
              (assert-true (if (ok? mr)
                             (secret-matches-hex? (ok-val mr)
                               "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
                             false)))))
        (free3 kb 0 0 (assert-true false)))))
  ;;; t-hkdf-rejects-oversize -- HKDF-SHA256 tops out at 255*32 bytes.
  (defn t-hkdf-rejects-oversize [] : bool
    (let [ikm (hex->buf "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
          r   (secret-of-bytes ikm 22)]
      (if (ok? r)
        (let [k  (ok-val r)
              dr (secret-hkdf-sha256 k "" "" 8161)]
          (do (secret-wipe! k) (free3 ikm 0 0 (assert-true (err? dr)))))
        (free3 ikm 0 0 (assert-true false)))))
  ;; -------------------------------------------------------------------------
  (defn __all-tests [] : void
    (describe "SHA-256 (FIPS 180-4)"
      (it "hashes the empty string" (t-sha256-empty))
      (it "hashes \"abc\"" (t-sha256-abc))
      (it "hashes a 56-byte input across two blocks" (t-sha256-two-block)))
    (describe "HMAC-SHA256 (RFC 4231)"
      (it "case 1 -- 20-byte key" (t-hmac-case1))
      (it "case 2 -- short key" (t-hmac-case2))
      (it "case 3 -- 50-byte message" (t-hmac-case3))
      (it "case 6 -- key longer than the block" (t-hmac-long-key)))
    (describe "HKDF-SHA256 (RFC 5869)"
      (it "case 1 -- salt and info, L=42" (t-hkdf-case1))
      (it "case 3 -- zero salt, empty info, L=42" (t-hkdf-case3))
      (it "rejects a length above 255*32" (t-hkdf-rejects-oversize)))
    (describe "Secret-level wrappers"
      (it "secret-hmac-sha256 agrees with the raw MAC" (t-secret-hmac-shape))))
  (defn main [] : int
    (__all-tests)
    ;; run-all-status, not run-all: `tur test` judges a file by its exit code,
    ;; and returning a hardcoded 0 means a failing assertion prints `not ok`
    ;; and the suite still reports success.
    (run-all-status)))
