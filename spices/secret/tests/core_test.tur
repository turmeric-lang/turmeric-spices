;; tests/core_test.tur -- the linear Secret handle (S2).
;;
;; Every case consumes each Secret it mints with exactly one secret-wipe!,
;; which is both the correct discipline and what -Xsubstructural demands. The
;; compile-time half of the story -- that *failing* to do so is an error
;; rather than a leak -- cannot be asserted from a passing program;
;; tests/substructural/run.sh covers it.
;;
;; Each case is its own top-level defn rather than an inline `it` body -- the
;; layout the linalg and sdf-raylib suites use.
;;
;; It was originally load-bearing: collapsing these into one big `__all-tests`
;; body put the whole suite through the CPS/trampoline path, which miscompiled
;; the shape two ways. Both are fixed upstream now (turmeric 65024bca and
;; 744c79fd -- docs/archive/cps-result-unbox-dropped.md and
;; cps-join-point-emits-invalid-assignment.md), so the layout is a style
;; choice again rather than a workaround. It is kept because it reads better
;; and matches the other spices.
(defmodule secret/tests/core
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (import secret/core
    :refer
    [Secret
     secret-random!
     secret-of-bytes
     secret-wipe!
     with-secret
     secret-len
     secret-locked?
     secret-eq?])
  ;; -------------------------------------------------------------------------
  ;; Helpers
  ;; -------------------------------------------------------------------------
  ;;; alloc-buf -- malloc `n` bytes, zero-filled.
  (defn alloc-buf [n : int] : ptr<void>
    ```c
    #include <stdlib.h>
  return calloc((size_t)(n > 0 ? n : 1), 1);
  ```)
  ;;; free-buf -- release a buffer, passing `verdict` through.
  (defn free-buf [p : ptr<void> verdict : bool] : bool
    ```c
    #include <stdlib.h>
  if (p) free(p);
  return verdict;
  ```)
  ;;; fill-buf! -- set every one of `n` bytes at `p` to `v`; returns `n`.
  (defn fill-buf! [p : ptr<void> n : int v : int] : int
    ```c
    #include <string.h>
  memset(p, (int)(v & 0xff), (size_t)n);
  return n;
  ```)
  ;;; count-nonzero -- how many of the first `n` bytes at `p` are non-zero.
  (defn count-nonzero [p : ptr<void> n : int] : int
    ```c
    const unsigned char *q = (const unsigned char *)p;
  int64_t c = 0;
  for (int64_t i = 0; i < n; i++) if (q[i] != 0) c++;
  return c;
  ```)
  ;;; count-byte -- how many of the first `n` bytes at `p` equal `v`.
  (defn count-byte [p : ptr<void> n : int v : int] : int
    ```c
    const unsigned char *q = (const unsigned char *)p;
  int64_t c = 0;
  for (int64_t i = 0; i < n; i++) if (q[i] == (unsigned char)(v & 0xff)) c++;
  return c;
  ```)
  ;; with-secret callbacks -- (fn [ptr<void> int] int)
  ;;; nonzero-in -- count non-zero bytes of the borrowed payload.
  (defn nonzero-in [p : ptr<void> n : int] : int (count-nonzero p n))
  ;;; len-seen -- report the length with-secret handed over.
  (defn len-seen [p : ptr<void> n : int] : int n)
  ;;; count-66 -- count payload bytes equal to 66 ('B').
  (defn count-66 [p : ptr<void> n : int] : int (count-byte p n 66))
  ;; -------------------------------------------------------------------------
  ;; secret-random!
  ;; -------------------------------------------------------------------------
  ;;; t-random-length -- a minted secret reports the requested length.
  (defn t-random-length [] : bool
    (let [r (secret-random! 32)]
      (if (ok? r)
        (let [k (ok-val r)
              n (secret-len k)]
          (do (secret-wipe! k) (assert-eq 32 n)))
        (assert-true false))))
  ;;; t-random-entropy -- the payload is filled, and reachable via with-secret.
  (defn t-random-entropy [] : bool
    (let [r (secret-random! 64)]
      (if (ok? r)
        (let [k  (ok-val r)
              nz (with-secret k nonzero-in)]
          (do
            (secret-wipe! k)
            ;; All-zero across 64 CSPRNG bytes has probability 2^-512.
            (assert-true (> nz 0))))
        (assert-true false))))
  ;;; t-with-secret-length -- with-secret passes the same length secret-len does.
  (defn t-with-secret-length [] : bool
    (let [r (secret-random! 48)]
      (if (ok? r)
        (let [k (ok-val r)
              n (with-secret k len-seen)]
          (do (secret-wipe! k) (assert-eq 48 n)))
        (assert-true false))))
  ;;; t-random-independent -- successive mints differ.
  (defn t-random-independent [] : bool
    (let [ra (secret-random! 32)]
      (if (ok? ra)
        (let [rb (secret-random! 32)]
          (if (ok? rb)
            (let [a    (ok-val ra)
                  b    (ok-val rb)
                  same (secret-eq? a b)]
              (do (secret-wipe! a) (secret-wipe! b) (assert-true (not same))))
            (do (secret-wipe! (ok-val ra)) (assert-true false))))
        (assert-true false))))
  ;;; t-random-rejects-zero -- a non-positive length is an error, not a handle.
  (defn t-random-rejects-zero [] : bool
    (let [z (secret-random! 0)] (assert-true (err? z))))
  ;;; t-random-rejects-negative -- likewise for a negative length.
  (defn t-random-rejects-negative [] : bool
    (let [n (secret-random! -8)] (assert-true (err? n))))
  ;; -------------------------------------------------------------------------
  ;; secret-of-bytes
  ;; -------------------------------------------------------------------------
  ;;; t-of-bytes-copies -- the source bytes land in the secret.
  (defn t-of-bytes-copies [] : bool
    (let [src (alloc-buf 16)]
      (do
        (fill-buf! src 16 66)
        (let [r (secret-of-bytes src 16)]
          (if (ok? r)
            (let [k    (ok-val r)
                  hits (with-secret k count-66)]
              (do (secret-wipe! k) (free-buf src (assert-eq 16 hits))))
            (free-buf src (assert-true false)))))))
  ;;; t-of-bytes-wipes-source -- the caller's plain copy is destroyed.
  ;;; The whole reason this constructor exists rather than a plain copy: the
  ;;; caller who just handed ownership over is the one least likely to
  ;;; remember their own copy is still sitting in memory.
  (defn t-of-bytes-wipes-source [] : bool
    (let [src (alloc-buf 16)]
      (do
        (fill-buf! src 16 66)
        (let [r (secret-of-bytes src 16)]
          (if (ok? r)
            (let [k (ok-val r)]
              (do
                (secret-wipe! k)
                (free-buf src (assert-eq 0 (count-nonzero src 16)))))
            (free-buf src (assert-true false)))))))
  ;;; t-of-bytes-rejects-zero -- a zero length is an error.
  (defn t-of-bytes-rejects-zero [] : bool
    (let [src (alloc-buf 8)
          r   (secret-of-bytes src 0)]
      (free-buf src (assert-true (err? r)))))
  ;; -------------------------------------------------------------------------
  ;; secret-eq?
  ;; -------------------------------------------------------------------------
  ;;; t-eq-identical -- two secrets over identical bytes compare equal.
  (defn t-eq-identical [] : bool
    (let [p (alloc-buf 16)
          q (alloc-buf 16)]
      (do
        (fill-buf! p 16 9)
        (fill-buf! q 16 9)
        (let [ra (secret-of-bytes p 16)]
          (if (ok? ra)
            (let [rb (secret-of-bytes q 16)]
              (if (ok? rb)
                (let [a  (ok-val ra)
                      b  (ok-val rb)
                      eq (secret-eq? a b)]
                  (do
                    (secret-wipe! a)
                    (secret-wipe! b)
                    (free-buf p (free-buf q (assert-true eq)))))
                (do
                  (secret-wipe! (ok-val ra))
                  (free-buf p (free-buf q (assert-true false))))))
            (free-buf p (free-buf q (assert-true false))))))))
  ;;; t-eq-different-lengths -- differing lengths compare unequal.
  (defn t-eq-different-lengths [] : bool
    (let [ra (secret-random! 16)]
      (if (ok? ra)
        (let [rb (secret-random! 32)]
          (if (ok? rb)
            (let [a  (ok-val ra)
                  b  (ok-val rb)
                  eq (secret-eq? a b)]
              (do (secret-wipe! a) (secret-wipe! b) (assert-true (not eq))))
            (do (secret-wipe! (ok-val ra)) (assert-true false))))
        (assert-true false))))
  ;;; t-eq-self -- a secret equals itself.
  (defn t-eq-self [] : bool
    (let [r (secret-random! 32)]
      (if (ok? r)
        (let [k  (ok-val r)
              eq (secret-eq? k k)]
          (do (secret-wipe! k) (assert-true eq)))
        (assert-true false))))
  ;; -------------------------------------------------------------------------
  ;; secret-locked?
  ;; -------------------------------------------------------------------------
  ;;; t-locked-answerable -- the lock question is answerable either way.
  ;;; Locking is fail-soft by design, so both answers are legitimate: on a box
  ;;; with a 64 KiB RLIMIT_MEMLOCK a false here is correct behavior, not a
  ;;; regression. What must hold is that the question can be asked.
  (defn t-locked-answerable [] : bool
    (let [r (secret-random! 32)]
      (if (ok? r)
        (let [k      (ok-val r)
              locked (secret-locked? k)]
          (do (secret-wipe! k) (assert-true (or locked (not locked)))))
        (assert-true false))))
  ;; -------------------------------------------------------------------------
  (defn __all-tests [] : void
    (describe "secret-random!"
      (it "mints a secret of the requested length" (t-random-length))
      (it "fills the payload with entropy" (t-random-entropy))
      (it "hands with-secret the length secret-len reports"
        (t-with-secret-length))
      (it "produces independent secrets on successive calls"
        (t-random-independent))
      (it "rejects a zero length" (t-random-rejects-zero))
      (it "rejects a negative length" (t-random-rejects-negative)))
    (describe "secret-of-bytes"
      (it "copies the source bytes into the secret" (t-of-bytes-copies))
      (it "wipes the caller's source buffer" (t-of-bytes-wipes-source))
      (it "rejects a zero length" (t-of-bytes-rejects-zero)))
    (describe "secret-eq?"
      (it "reports two secrets over identical bytes as equal" (t-eq-identical))
      (it "reports differing lengths as unequal" (t-eq-different-lengths))
      (it "reports a secret equal to itself" (t-eq-self)))
    (describe "secret-locked?"
      (it "answers whatever the ambient RLIMIT_MEMLOCK" (t-locked-answerable))))
  (defn main [] : int
    (__all-tests)
    ;; run-all-status, not run-all: `tur test` judges a file by its exit code,
    ;; and returning a hardcoded 0 means a failing assertion prints `not ok`
    ;; and the suite still reports success.
    (run-all-status)))
