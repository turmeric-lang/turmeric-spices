;; tests/hex_test.tur -- constant-time hex codecs (S3).
;;
;; The branchless arithmetic in secret/hex is easy to get subtly wrong at the
;; class boundaries -- '9'/'a', 'f'/'g', 'F'/'G', '/'/'0' -- because the range
;; masks are off-by-one-prone and a wrong mask silently decodes garbage rather
;; than failing. So the round-trip cases are backed by explicit boundary and
;; rejection cases.
(defmodule secret/tests/hex
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (import secret/hex
    :refer
    [secret->hex secret-of-hex hex-encode-raw! hex-decode-raw!])
  (import secret/core
    :refer
    [Secret secret-of-bytes secret-wipe! with-secret secret-len secret-eq?])
  ;; -------------------------------------------------------------------------
  ;; Helpers
  ;; -------------------------------------------------------------------------
  ;;; alloc-buf -- malloc `n` zeroed bytes.
  (defn alloc-buf [n : int] : ptr<void>
    ```c
    #include <stdlib.h>
  return calloc((size_t)(n > 0 ? n : 1), 1);
  ```)
  ;;; free2 -- free two buffers, passing `verdict` through.
  (defn free2 [a : ptr<void> b : ptr<void> verdict : bool] : bool
    ```c
    #include <stdlib.h>
  if (a) free(a);
  if (b) free(b);
  return verdict;
  ```)
  ;;; str->buf -- heap copy of a cstr's bytes (no NUL).
  (defn str->buf [s : cstr] : ptr<void>
    ```c
    #include <stdlib.h>
  #include <string.h>
  const char *p = (const char *)s;
  size_t n = strlen(p);
  unsigned char *b = (unsigned char *)malloc(n ? n : 1);
  memcpy(b, p, n);
  return b;
  ```)
  ;;; buf-eq-str? -- do `n` bytes at `p` match the cstr `s`?
  (defn buf-eq-str? [p : ptr<void> n : int s : cstr] : bool
    ```c
    #include <string.h>
  const char *q = (const char *)s;
  if (strlen(q) != (size_t)n) return false;
  return memcmp(p, q, (size_t)n) == 0;
  ```)
  ;;; bytes->buf4 -- a 4-byte buffer with the given byte values.
  (defn bytes->buf4 [a : int b : int c : int d : int] : ptr<void>
    ```c
    #include <stdlib.h>
  unsigned char *p = (unsigned char *)malloc(4);
  p[0] = (unsigned char)a; p[1] = (unsigned char)b;
  p[2] = (unsigned char)c; p[3] = (unsigned char)d;
  return p;
  ```)
  ;;; byte-at -- read byte `i`.
  (defn byte-at [p : ptr<void> i : int] : int
    ```c
    return (int64_t)((const unsigned char *)p)[i];
  ```)
  ;;; expect-slot -- carry the expected string past with-secret's fixed
  ;;; callback shape.
  (defn expect-slot [set : bool v : cstr] : cstr
    ```c
    static const char *slot = "";
  if (set) slot = (const char *)v;
  return slot;
  ```)
  ;;; matches-slot -- with-secret callback: compare payload to the slot.
  (defn matches-slot [p : ptr<void> n : int] : int
    (if (buf-eq-str? p n (expect-slot false "")) 1 0))
  ;;; secret-is-str? -- compare a Secret's payload to a string, then wipe it.
  ;;; Takes the Secret, not the enclosing Result: a Turmeric-built Result
  ;;; passed as a parameter gets its unbox applied twice and fails to compile.
  (defn secret-is-str? [k : Secret expect : cstr] : bool
    (let [_   (expect-slot true expect)
          hit (with-secret k matches-slot)]
      (do (secret-wipe! k) (= hit 1))))
  ;; -------------------------------------------------------------------------
  ;; Raw codecs
  ;; -------------------------------------------------------------------------
  ;;; t-encode-known -- encode a known 4-byte value.
  (defn t-encode-known [] : bool
    (let [src (bytes->buf4 222 173 190 239) ;; de ad be ef
          out (alloc-buf 8)]
      (do
        (hex-encode-raw! src 4 out)
        (free2 src out (assert-true (buf-eq-str? out 8 "deadbeef"))))))
  ;;; t-encode-boundaries -- 0x00, 0x09, 0x0a, 0x0f exercise both sides of the
  ;;; digit/letter split in each nibble position.
  (defn t-encode-boundaries [] : bool
    (let [src (bytes->buf4 0 9 10 15)
          out (alloc-buf 8)]
      (do
        (hex-encode-raw! src 4 out)
        (free2 src out (assert-true (buf-eq-str? out 8 "00090a0f"))))))
  ;;; t-encode-all-bytes -- every value 0..255 encodes to the expected pair.
  ;;; The exhaustive check the boundary cases are a readable summary of.
  (defn t-encode-all-bytes [] : bool (assert-true (encode-all-256-ok?)))
  ;;; encode-all-256-ok? -- encode 0..255 and verify against a reference table.
  (defn encode-all-256-ok? [] : bool
    ```c
    #include <stdio.h>
  /* want is 513, not 512: sprintf writes two digits AND a NUL terminator, so
     the last iteration (i = 255) puts its NUL at want[512]. At 512 bytes that
     is a one-past-the-end write, which glibc's FORTIFY catches -- the whole
     test file aborted with "*** buffer overflow detected ***" before any
     assertion could run, masking everything else in it. */
  unsigned char src[256], out[512], want[513];
  for (int i = 0; i < 256; i++) src[i] = (unsigned char)i;
  for (int i = 0; i < 256; i++) sprintf((char *)want + i*2, "%02x", i);
  __TUR_CNAME_hex-encode-raw!__((void *)src, 256, (void *)out);
  for (int i = 0; i < 512; i++) if (out[i] != want[i]) return false;
  return true;
  ```)
  ;;; t-decode-known -- decode a known string.
  (defn t-decode-known [] : bool
    (let [src (str->buf "deadbeef")
          out (alloc-buf 4)
          ok  (hex-decode-raw! src 4 out)]
      (free2 src
        out
        (assert-true (and ok
                       (and (= (byte-at out 0) 222) (= (byte-at out 3) 239)))))))
  ;;; t-decode-uppercase -- upper-case input decodes identically.
  (defn t-decode-uppercase [] : bool
    (let [src (str->buf "DEADBEEF")
          out (alloc-buf 4)
          ok  (hex-decode-raw! src 4 out)]
      (free2 src
        out
        (assert-true (and ok
                       (and (= (byte-at out 0) 222) (= (byte-at out 3) 239)))))))
  ;;; t-decode-rejects-boundaries -- the characters immediately outside each
  ;;; accepted class must be rejected: '/' ('0'-1), ':' ('9'+1), '@' ('A'-1),
  ;;; 'G' ('F'+1), '`' ('a'-1), 'g' ('f'+1).
  (defn t-decode-rejects-boundaries [] : bool
    (and (rejects? "/0")
      (and (rejects? ":0")
        (and (rejects? "@0")
          (and (rejects? "G0") (and (rejects? "`0") (rejects? "g0")))))))
  ;;; rejects? -- does decoding this 2-char string fail?
  (defn rejects? [s : cstr] : bool
    (let [src (str->buf s)
          out (alloc-buf 1)
          ok  (hex-decode-raw! src 1 out)]
      (free2 src out (not ok))))
  ;;; t-decode-wipes-on-failure -- a rejected decode leaves no partial plaintext.
  (defn t-decode-wipes-on-failure [] : bool
    ;; "ffzz": the first byte decodes fine, the second does not. The 0xff must
    ;; not survive in the output.
    (let [src (str->buf "ffzz")
          out (alloc-buf 2)
          ok  (hex-decode-raw! src 2 out)]
      (free2 src
        out
        (assert-true (and (not ok)
                       (and (= (byte-at out 0) 0) (= (byte-at out 1) 0)))))))
  ;; -------------------------------------------------------------------------
  ;; Secret-level API
  ;; -------------------------------------------------------------------------
  ;;; t-secret-to-hex -- secret->hex yields the expected characters.
  (defn t-secret-to-hex [] : bool
    (let [src (bytes->buf4 222 173 190 239)
          r   (secret-of-bytes src 4)]
      (if (ok? r)
        (let [k  (ok-val r)
              hr (secret->hex k)]
          (do
            (secret-wipe! k)
            (free2 src
              0
              (assert-true (if (ok? hr)
                             (secret-is-str? (ok-val hr) "deadbeef")
                             false)))))
        (free2 src 0 (assert-true false)))))
  ;;; t-hex-round-trip -- of-hex then ->hex returns the original text.
  (defn t-hex-round-trip [] : bool
    (let [r (secret-of-hex "00ff10ab")]
      (if (ok? r)
        (let [k  (ok-val r)
              n  (secret-len k)
              hr (secret->hex k)]
          (do
            (secret-wipe! k)
            (assert-true (and (= n 4)
                           (if (ok? hr)
                             (secret-is-str? (ok-val hr) "00ff10ab")
                             false)))))
        (assert-true false))))
  ;;; t-of-hex-uppercase -- upper-case input round-trips to lower-case output.
  (defn t-of-hex-uppercase [] : bool
    (let [r (secret-of-hex "00FF10AB")]
      (if (ok? r)
        (let [k  (ok-val r)
              hr (secret->hex k)]
          (do
            (secret-wipe! k)
            (assert-true (if (ok? hr)
                           (secret-is-str? (ok-val hr) "00ff10ab")
                           false))))
        (assert-true false))))
  ;;; t-of-hex-rejects-odd -- odd-length input is an error.
  (defn t-of-hex-rejects-odd [] : bool
    (assert-true (err? (secret-of-hex "abc"))))
  ;;; t-of-hex-rejects-empty -- empty input is an error.
  (defn t-of-hex-rejects-empty [] : bool
    (assert-true (err? (secret-of-hex ""))))
  ;;; t-of-hex-rejects-nonhex -- a non-hex character is an error.
  (defn t-of-hex-rejects-nonhex [] : bool
    (assert-true (err? (secret-of-hex "00zz"))))
  ;; -------------------------------------------------------------------------
  (defn __all-tests [] : void
    (describe "hex-encode-raw!"
      (it "encodes a known value" (t-encode-known))
      (it "encodes the digit/letter boundaries" (t-encode-boundaries))
      (it "matches printf %02x for all 256 bytes" (t-encode-all-bytes)))
    (describe "hex-decode-raw!"
      (it "decodes a known value" (t-decode-known))
      (it "accepts upper case" (t-decode-uppercase))
      (it "rejects the characters just outside each class"
        (t-decode-rejects-boundaries))
      (it "wipes the output on a failed decode" (t-decode-wipes-on-failure)))
    (describe "secret->hex / secret-of-hex"
      (it "encodes a Secret to the expected hex" (t-secret-to-hex))
      (it "round-trips hex -> Secret -> hex" (t-hex-round-trip))
      (it "normalizes upper case on round-trip" (t-of-hex-uppercase))
      (it "rejects an odd-length input" (t-of-hex-rejects-odd))
      (it "rejects an empty input" (t-of-hex-rejects-empty))
      (it "rejects a non-hex character" (t-of-hex-rejects-nonhex))))
  (defn main [] : int
    (__all-tests)
    ;; run-all-status, not run-all: `tur test` judges a file by its exit code,
    ;; and returning a hardcoded 0 means a failing assertion prints `not ok`
    ;; and the suite still reports success.
    (run-all-status)))
