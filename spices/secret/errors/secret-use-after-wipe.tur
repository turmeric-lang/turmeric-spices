;; Negative fixture: a Secret is dead after secret-wipe!. Reading it again --
;; here, asking its length -- is a use-after-free of key material, and the
;; linear discipline rejects it at compile time.
;;
;; Verify (from the secret spice root):
;;   tur check errors/secret-use-after-wipe.tur
;;   => error [TUR-E0101]: linear value 'k' used after being consumed
(defmodule secret_use_after_wipe
  (export)
  (import secret/core :refer [Secret secret-random! secret-wipe! secret-len])
  (defn main [] : int
    (let [r (secret-random! 32)]
      (if (ok? r)
        (let [k (ok-val r)] (do (secret-wipe! k) (secret-len k))) ;; ERROR: k was consumed above
        0)))) ;; end defmodule secret_use_after_wipe
