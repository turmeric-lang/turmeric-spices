;; Negative fixture: exactly one secret-wipe! per Secret. Wiping twice is a
;; double free, and the linear discipline rejects it at compile time.
;;
;; Verify (from the secret spice root):
;;   tur check errors/secret-double-wipe.tur
;;   => error [TUR-E0101]: linear value 'k' used after being consumed
(defmodule secret_double_wipe
  (export)
  (import secret/core :refer [Secret secret-random! secret-wipe!])
  (defn main [] : int
    (let [r (secret-random! 32)]
      (if (ok? r)
        (let [k (ok-val r)]
          (do
            (secret-wipe! k)
            (secret-wipe! k) ;; ERROR: k was consumed above
            0))
        0)))) ;; end defmodule secret_double_wipe
