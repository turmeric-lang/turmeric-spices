;; Negative fixture: a :linear Secret must be consumed exactly once.
;; Minting one, borrowing it, and never calling secret-wipe! is a leak of
;; live key material -- rejected under -Xsubstructural.
;;
;; Verify (from the secret spice root):
;;   tur check -Xsubstructural errors/secret-leak-no-wipe.tur
;;   => error [TUR-E0100]: linear value 'k' dropped without being consumed
(defmodule secret_leak_no_wipe
  (export)
  (import secret/core :refer [Secret secret-random! secret-len])
  (defn main [] : int
    (let [r (secret-random! 32)]
      (if (ok? r)
        (let [k (ok-val r)] (secret-len k)) ;; borrow only; k is never consumed
        0)))) ;; end defmodule secret_leak_no_wipe
