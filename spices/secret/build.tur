(defpackage tur-secret
  :name "tur-secret"
  :version "0.1.0"
  :description "Linear key material and crypto hygiene primitives for Turmeric"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :exports #map{"secret/hygiene" ["secure-wipe-ptr!"
                                  "crypto-random-bytes!"
                                  "crypto-random-source"
                                  "ct-eq-ptr?"]
                "secret/core" ["Secret"
                               "secret-random!"
                               "secret-of-bytes"
                               "secret-wipe!"
                               "with-secret"
                               "secret-len"
                               "secret-locked?"
                               "secret-eq?"]
                "secret/kdf" ["secret-hmac-sha256"
                              "secret-hkdf-sha256"
                              "sha256-raw!"
                              "hmac-sha256-raw!"
                              "hkdf-sha256-raw!"]
                "secret/hex" ["secret->hex"
                              "secret-of-hex"
                              "hex-encode-raw!"
                              "hex-decode-raw!"]
                ;; secret/internal is intra-spice plumbing, deliberately not exported.
                })
