;;; secret/hex -- constant-time hex codecs whose output is itself a Secret.
;;;
;;; Hex is how key material actually travels: config files, environment
;;; variables, API responses, log lines. Two things usually go wrong at that
;;; boundary, and both are addressed here.
;;;
;;; **The codec leaks.** The obvious implementation indexes a 16-byte lookup
;;; table with a nibble of the secret. That is a secret-dependent memory
;;; access, and cache-timing attacks against exactly this pattern are well
;;; established. Both directions here are branchless arithmetic instead --
;;; no table, no `if` on a secret nibble, no early exit on a bad character.
;;;
;;; **The decoded value is not treated as a secret.** `secret-of-hex` returns
;;; a `Secret`, so the decoded bytes inherit the wipe-or-fail-to-compile
;;; discipline instead of sitting in a plain buffer someone forgets. Encoding
;;; likewise returns a `Secret`: the hex form of a key is still the key.
;;;
;;; What is not hidden: the *length* of the input, and whether decoding
;;; succeeded. Neither is secret -- both are observable from the surrounding
;;; protocol anyway.
;;;
;;; Since: 0.1.0
(defmodule secret/hex
  (import secret/core :refer [Secret secret-of-bytes secret-len])
  (import secret/internal
    :refer
    [secret-payload-ptr scratch-alloc scratch-ptr scratch-free])
  (export secret->hex secret-of-hex hex-encode-raw! hex-decode-raw!)
  ;; -------------------------------------------------------------------------
  ;; Branchless nibble <-> ASCII
  ;;
  ;; Encode, per nibble x in 0..15:
  ;;   '0' + x + (39 if x > 9 else 0)      ('a' - '0' - 10 == 39)
  ;; The conditional 39 is computed as (((9 - x) >> 31) & 39) on a signed int:
  ;; 9 - x is negative exactly when x > 9, so the arithmetic shift yields all
  ;; ones, and the mask contributes 39. No branch, no table.
  ;;
  ;; Decode uses a constant-time range test:
  ;;   in_range(x, lo, hi) == (((lo - 1 - x) & (x - hi - 1)) >> 31)
  ;; which is -1 when lo <= x <= hi and 0 otherwise, because both operands have
  ;; their sign bit set only in that case. The three character classes are
  ;; masked together, and validity is accumulated across the whole string
  ;; rather than short-circuited, so a malformed digit does not change how long
  ;; the decode takes.
  ;; -------------------------------------------------------------------------
  ;;; hex-encode-raw! -- write 2*n lowercase hex chars for n bytes at `p`.
  ;;;
  ;;; Parameters:
  ;;;   p   -- source bytes
  ;;;   n   -- source length
  ;;;   out -- destination, at least 2*n bytes (no NUL is written)
  ;;;
  ;;; Returns:
  ;;;   The number of characters written (2*n). It returns a count rather than
  ;;;   `:void` so it can be sequenced in a `let` binding list -- binding a
  ;;;   :void call emits `void x = ...` and fails the C compile.
  ;;;
  ;;; Example:
  ;;;   (hex-encode-raw! key 32 buf)   ; => 64
  ;;;
  ;;; Since: 0.1.0
  (defn hex-encode-raw! [p : ptr<void> n : int out : ptr<void>] : int
    ```c
    #include <stdint.h>
  const unsigned char *in = (const unsigned char *)p;
  unsigned char *o = (unsigned char *)out;
  for (int64_t i = 0; i < n; i++) {
    int hi = (in[i] >> 4) & 0xf;
    int lo = in[i] & 0xf;
    o[i*2]     = (unsigned char)('0' + hi + (((9 - hi) >> 31) & 39));
    o[i*2 + 1] = (unsigned char)('0' + lo + (((9 - lo) >> 31) & 39));
  }
  return n > 0 ? n * 2 : 0;
  ```)
  ;;; hex-decode-raw! -- decode 2*n hex chars at `p` into n bytes at `out`.
  ;;;
  ;;; Accepts upper- and lower-case. Runs the full string regardless of
  ;;; validity, so timing does not reveal where a bad character sits.
  ;;;
  ;;; Parameters:
  ;;;   p   -- source hex characters
  ;;;   n   -- number of BYTES to produce (source must hold 2*n characters)
  ;;;   out -- destination, at least n bytes
  ;;;
  ;;; Returns:
  ;;;   true when every character was a valid hex digit. On false the
  ;;;   destination is wiped rather than left holding a partial decode.
  ;;;
  ;;; Example:
  ;;;   (hex-decode-raw! "ff00" 2 buf)   ; => true, buf = {0xff, 0x00}
  ;;;
  ;;; Since: 0.1.0
  (defn hex-decode-raw! [p : ptr<void> n : int out : ptr<void>] : bool
    ```c
    #include <stdint.h>
  const unsigned char *in = (const unsigned char *)p;
  unsigned char *o = (unsigned char *)out;
  int valid = -1;                      /* stays -1 while every digit is ok */
  for (int64_t i = 0; i < n; i++) {
    int acc = 0;
    for (int half = 0; half < 2; half++) {
      int x = in[i*2 + half];
      int m_dig = (((('0') - 1 - x) & (x - ('9') - 1)) >> 31);
      int m_up  = (((('A') - 1 - x) & (x - ('F') - 1)) >> 31);
      int m_low = (((('a') - 1 - x) & (x - ('f') - 1)) >> 31);
      int v = (m_dig & (x - '0'))
            | (m_up  & (x - 'A' + 10))
            | (m_low & (x - 'a' + 10));
      valid &= (m_dig | m_up | m_low);
      acc = (acc << 4) | (v & 0xf);
    }
    o[i] = (unsigned char)acc;
  }
  if (!valid) {
    /* Do not hand back a partial decode of attacker-controlled input. */
    __TUR_CNAME_hex-wipe-raw!__((void *)o, n);
    return false;
  }
  return true;
  ```)
  ;;; hex-wipe-raw! -- local wipe shim so hex-decode-raw! can clear a failed
  ;;; decode without secret/hex depending on secret/hygiene for one call.
  (defn hex-wipe-raw! [p : ptr<void> n : int] : void
    ```c
    #include <string.h>
  if (p == NULL || n <= 0) return;
  {
    static void *(*volatile vmemset)(void *, int, size_t) = memset;
    vmemset(p, 0, (size_t)n);
  }
  #if defined(__GNUC__) || defined(__clang__)
    __asm__ __volatile__("" : : "r"(p) : "memory");
  #endif
  ```)
  ;;; cstr-len -- byte length of a NUL-terminated string.
  (defn cstr-len [s : cstr] : int
    ```c
    #include <string.h>
  return s ? (int64_t)strlen((const char *)s) : 0;
  ```)
  ;;; cstr-ptr -- view a cstr as a raw byte pointer.
  (defn cstr-ptr [s : cstr] : ptr<void>
    ```c
    return (void *)(intptr_t)s;
  ```)
  ;; -------------------------------------------------------------------------
  ;; Secret-level API
  ;;
  ;; Each wrapper keeps every `if` branch a single call: a `let`/`do` block that
  ;; evaluates to a Result and is returned through an `if` branch gets the
  ;; box->struct unbox applied to a value that is already a struct, and the C
  ;; compile fails. Same shape as the wrappers in secret/kdf.
  ;; -------------------------------------------------------------------------
  ;;; encode-then-wrap -- encode into scratch, copy into a Secret, free scratch.
  (defn encode-then-wrap [^borrow s : Secret h : int n : int] : (Result Secret
                                                                  cstr)
    (let [_  (hex-encode-raw! (secret-payload-ptr s) n (scratch-ptr h))
          r  (secret-of-bytes (scratch-ptr h) (* n 2))
          _2 (scratch-free h)]
      r))
  ;;; secret->hex -- lowercase hex of a borrowed secret, as a new Secret.
  ;;;
  ;;; The result is a `Secret` because the hex form of a key is still the key:
  ;;; returning a plain `cstr` would hand back an unwiped copy and quietly undo
  ;;; the discipline the caller opted into.
  ;;;
  ;;; Parameters:
  ;;;   s -- the secret, borrowed (not consumed)
  ;;;
  ;;; Returns:
  ;;;   (Result Secret cstr) -- ok carries a 2n-byte Secret of hex characters
  ;;;   (not NUL-terminated).
  ;;;
  ;;; Example:
  ;;;   (let [r (secret->hex k)]
  ;;;     (if (ok? r) (ok-val r) ...))
  ;;;
  ;;; Since: 0.1.0
  (defn secret->hex [^borrow s : Secret] : (Result Secret cstr)
    (let [n (secret-len s)]
      (if (< n 1)
        (err "secret->hex: empty secret")
        (let [h (scratch-alloc (* n 2))]
          (if (= h 0)
            (err "secret->hex: allocation failed")
            (encode-then-wrap s h n))))))
  ;;; decode-then-wrap -- decode into scratch, copy into a Secret, free scratch.
  (defn decode-then-wrap [c : cstr h : int n : int] : (Result Secret cstr)
    (if (hex-decode-raw! (cstr-ptr c) n (scratch-ptr h))
      (wrap-decoded h n)
      (fail-decoded h)))
  ;;; wrap-decoded -- copy n decoded bytes into a Secret, then free the scratch.
  (defn wrap-decoded [h : int n : int] : (Result Secret cstr)
    (let [r  (secret-of-bytes (scratch-ptr h) n)
          _2 (scratch-free h)]
      r))
  ;;; fail-decoded -- release the scratch and report a malformed input.
  (defn fail-decoded [h : int] : (Result Secret cstr)
    (let [_ (scratch-free h)]
      (err "secret-of-hex: input is not valid hexadecimal")))
  ;;; secret-of-hex -- decode a hex string into a new Secret.
  ;;;
  ;;; The decoded bytes land in a `Secret` rather than a plain buffer, which is
  ;;; the point: material arriving as hex from a config file or an API response
  ;;; is exactly the material most likely to be left lying around.
  ;;;
  ;;; Note this does not wipe the source `cstr` -- it is the caller's string
  ;;; literal or buffer, and its lifetime is theirs. If it holds real key
  ;;; material, wipe it with `secure-wipe-ptr!` afterwards.
  ;;;
  ;;; Parameters:
  ;;;   c -- hex characters, upper or lower case, even length
  ;;;
  ;;; Returns:
  ;;;   (Result Secret cstr) -- ok carries the decoded bytes; err on an odd
  ;;;   length, an empty string, or any non-hex character.
  ;;;
  ;;; Example:
  ;;;   (secret-of-hex "deadbeef")   ; => ok, a 4-byte Secret
  ;;;
  ;;; Since: 0.1.0
  (defn secret-of-hex [c : cstr] : (Result Secret cstr)
    (let [len (cstr-len c)]
      (if (< len 2)
        (err "secret-of-hex: empty input")
        (if (= (mod len 2) 1)
          (err "secret-of-hex: odd-length input")
          (let [h (scratch-alloc (/ len 2))]
            (if (= h 0)
              (err "secret-of-hex: allocation failed")
              (decode-then-wrap c h (/ len 2))))))))) ;; end defmodule secret/hex
