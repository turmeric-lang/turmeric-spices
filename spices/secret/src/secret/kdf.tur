;;; secret/kdf -- HMAC-SHA256 and HKDF-SHA256 over linear Secrets.
;;;
;;; `stdlib/digest.tur` gives you a raw SHA-256 and nothing else. A raw hash
;;; is the wrong primitive for authentication -- `SHA256(key || msg)` is
;;; length-extendable, and comparing the result with `memcmp` leaks the
;;; shared-prefix length -- so having only a hash in the toolbox actively
;;; invites the two classic mistakes. This module closes that: a real MAC
;;; (RFC 2104) and a real KDF (RFC 5869), with outputs that are themselves
;;; `Secret`s and therefore inherit the wipe-or-fail-to-compile discipline.
;;;
;;; ## Self-contained, and why that is the right call here
;;;
;;; SHA-256 (FIPS 180-4), HMAC (RFC 2104), and HKDF (RFC 5869) are
;;; implemented here rather than pulled from mbedTLS. "Don't roll your own
;;; crypto" is about protocols, primitives with real side-channel subtlety
;;; (AES, RSA, elliptic curves), and novel constructions. This trio is the
;;; textbook exception: fixed-size, no secret-dependent branching or
;;; indexing, no bignum arithmetic, and exhaustively pinned by published test
;;; vectors -- all three are checked against RFC 4231 and RFC 5869 in
;;; tests/kdf_test.tur.
;;;
;;; What that buys: the whole spice stays dependency-free. The S1 hygiene
;;; floor and the S2 `Secret` need no external library at all, and making a
;;; `secure-wipe-ptr!` caller clone and build mbedTLS to get it would be a
;;; poor trade -- a larger supply-chain surface for a *security* spice, in
;;; exchange for code the repo already ships (stdlib/digest.tur carries its
;;; own SHA-256 and says so). See the guide for the full rationale.
;;;
;;; ## Binary salts need the raw entry point
;;;
;;; `secret-hkdf-sha256` takes `salt` and `info` as `cstr` and measures them
;;; with `strlen`, which is the ergonomic choice -- in practice both are
;;; ASCII labels like "v1" or "encryption key". It cannot carry an embedded
;;; NUL, so a binary salt (RFC 5869's own test case 1 uses `00 01 .. 0c`)
;;; must go through `hkdf-sha256-raw!`, which takes pointer/length pairs.
;;; Both are exported for exactly that reason.
;;;
;;; ## Intermediates are wiped
;;;
;;; HMAC's padded key blocks and inner digest are key-derived and are wiped
;;; with `secure-wipe-ptr!` before the buffers holding them go out of scope,
;;; as is HKDF's PRK and its T(i) chaining block. Getting the MAC right and
;;; leaving the ipad block on the stack would defeat the point of the spice.
;;;
;;; Since: 0.1.0
(defmodule secret/kdf
  (import secret/hygiene :refer [secure-wipe-ptr!])
  (import secret/core :refer [Secret secret-of-bytes with-secret secret-len])
  (import secret/internal
    :refer
    [secret-payload-ptr scratch-alloc scratch-ptr scratch-free])
  (export secret-hmac-sha256
    secret-hkdf-sha256
    sha256-raw!
    hmac-sha256-raw!
    hkdf-sha256-raw!)
  ;; -------------------------------------------------------------------------
  ;; SHA-256 (FIPS 180-4)
  ;;
  ;; The per-block compression function is its own defn rather than a nested
  ;; static function: a `static` function nested inside another function body is
  ;; a GNU extension that standard C rejects, and stdlib/digest.tur was already
  ;; bitten by exactly that (see its header comment).
  ;; -------------------------------------------------------------------------
  ;;; sha256-block! -- one SHA-256 compression round over a 64-byte block.
  ;;; Internal. `st` is a uint32_t[8] state, mutated in place.
  (defn sha256-block! [st : ptr<void> blk : ptr<void>] : void
    ```c
    #include <stdint.h>
  uint32_t *S = (uint32_t *)st;
  const uint8_t *b = (const uint8_t *)blk;
  static const uint32_t K[64] = {
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
  };
  uint32_t w[64];
  for (int i = 0; i < 16; i++)
    w[i] = ((uint32_t)b[i*4] << 24) | ((uint32_t)b[i*4+1] << 16)
         | ((uint32_t)b[i*4+2] << 8) | (uint32_t)b[i*4+3];
  for (int i = 16; i < 64; i++) {
    uint32_t s0 = ((w[i-15] >> 7) | (w[i-15] << 25))
                ^ ((w[i-15] >> 18) | (w[i-15] << 14)) ^ (w[i-15] >> 3);
    uint32_t s1 = ((w[i-2] >> 17) | (w[i-2] << 15))
                ^ ((w[i-2] >> 19) | (w[i-2] << 13)) ^ (w[i-2] >> 10);
    w[i] = w[i-16] + s0 + w[i-7] + s1;
  }
  uint32_t a = S[0], bb = S[1], c = S[2], d = S[3];
  uint32_t e = S[4], f = S[5], g = S[6], h = S[7];
  for (int i = 0; i < 64; i++) {
    uint32_t S1 = ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21))
                ^ ((e >> 25) | (e << 7));
    uint32_t ch = (e & f) ^ ((~e) & g);
    uint32_t t1 = h + S1 + ch + K[i] + w[i];
    uint32_t S0 = ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19))
                ^ ((a >> 22) | (a << 10));
    uint32_t mj = (a & bb) ^ (a & c) ^ (bb & c);
    uint32_t t2 = S0 + mj;
    h = g; g = f; f = e; e = d + t1;
    d = c; c = bb; bb = a; a = t1 + t2;
  }
  S[0] += a; S[1] += bb; S[2] += c; S[3] += d;
  S[4] += e; S[5] += f; S[6] += g; S[7] += h;
  /* w holds message schedule derived from (possibly secret) input. */
  __TUR_CNAME_secure-wipe-ptr!__((void *)w, (int64_t)sizeof(w));
  ```)
  ;;; sha256-raw! -- SHA-256 of `n` bytes at `data` into 32 bytes at `out`.
  ;;;
  ;;; Parameters:
  ;;;   data -- input bytes (may be NULL when n is 0)
  ;;;   n    -- input length in bytes
  ;;;   out  -- destination, at least 32 bytes
  ;;;
  ;;; Returns:
  ;;;   Nothing; `out` holds the digest.
  ;;;
  ;;; Example:
  ;;;   (sha256-raw! msg 3 digest)   ; "abc" => ba7816bf...
  ;;;
  ;;; Since: 0.1.0
  (defn sha256-raw! [data : ptr<void> n : int out : ptr<void>] : void
    ```c
    #include <stdint.h>
  #include <string.h>
  const uint8_t *in = (const uint8_t *)data;
  size_t len = (size_t)(n > 0 ? n : 0);
  uint32_t st[8] = { 0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
                     0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19 };
  uint8_t blk[64];
  size_t i = 0;
  for (; i + 64 <= len; i += 64)
    __TUR_CNAME_sha256-block!__((void *)st, (void *)(in + i));
  size_t rem = len - i;
  memcpy(blk, in + i, rem);
  blk[rem++] = 0x80;
  if (rem > 56) {
    memset(blk + rem, 0, 64 - rem);
    __TUR_CNAME_sha256-block!__((void *)st, (void *)blk);
    memset(blk, 0, 56);
  } else {
    memset(blk + rem, 0, 56 - rem);
  }
  uint64_t bits = (uint64_t)len * 8;
  for (int j = 0; j < 8; j++) blk[56 + j] = (uint8_t)(bits >> (56 - j * 8));
  __TUR_CNAME_sha256-block!__((void *)st, (void *)blk);
  uint8_t *o = (uint8_t *)out;
  for (int j = 0; j < 8; j++) {
    o[j*4]   = (uint8_t)(st[j] >> 24);
    o[j*4+1] = (uint8_t)(st[j] >> 16);
    o[j*4+2] = (uint8_t)(st[j] >> 8);
    o[j*4+3] = (uint8_t)(st[j]);
  }
  /* The final block and state are message-derived; do not leave them. */
  __TUR_CNAME_secure-wipe-ptr!__((void *)blk, 64);
  __TUR_CNAME_secure-wipe-ptr!__((void *)st, (int64_t)sizeof(st));
  ```)
  ;; -------------------------------------------------------------------------
  ;; HMAC-SHA256 (RFC 2104)
  ;; -------------------------------------------------------------------------
  ;;; hmac-sha256-raw! -- HMAC-SHA256(key, msg) into 32 bytes at `out`.
  ;;;
  ;;; Keys longer than the 64-byte block are hashed first, per RFC 2104; keys
  ;;; shorter are zero-padded. The padded key blocks and the inner digest are
  ;;; wiped before returning.
  ;;;
  ;;; Parameters:
  ;;;   key  -- key bytes
  ;;;   klen -- key length
  ;;;   msg  -- message bytes
  ;;;   mlen -- message length
  ;;;   out  -- destination, at least 32 bytes
  ;;;
  ;;; Returns:
  ;;;   Nothing; `out` holds the MAC.
  ;;;
  ;;; Example:
  ;;;   (hmac-sha256-raw! k 4 m 28 mac)
  ;;;
  ;;; Since: 0.1.0
  (defn hmac-sha256-raw! [key : ptr<void>
                          klen : int
                          msg : ptr<void>
                          mlen : int
                          out : ptr<void>] : void
    ```c
    #include <stdint.h>
  #include <stdlib.h>
  #include <string.h>
  uint8_t kpad[64], ipad[64], opad[64], inner[32];
  size_t kl = (size_t)(klen > 0 ? klen : 0);

  memset(kpad, 0, 64);
  if (kl > 64) {
    __TUR_CNAME_sha256-raw!__(key, (int64_t)kl, (void *)kpad);
  } else if (kl > 0) {
    memcpy(kpad, key, kl);
  }
  for (int i = 0; i < 64; i++) {
    ipad[i] = (uint8_t)(kpad[i] ^ 0x36);
    opad[i] = (uint8_t)(kpad[i] ^ 0x5c);
  }

  /* inner = SHA256(ipad || msg) */
  {
    size_t ml = (size_t)(mlen > 0 ? mlen : 0);
    uint8_t *buf = (uint8_t *)malloc(64 + ml);
    if (buf == NULL) {
      /* Cannot signal from here; leave `out` zeroed so a caller that ignores
         the failure gets an obviously-wrong MAC rather than a plausible one.
         The Secret-level wrappers check the allocation themselves. */
      memset(out, 0, 32);
      __TUR_CNAME_secure-wipe-ptr!__((void *)kpad, 64);
      __TUR_CNAME_secure-wipe-ptr!__((void *)ipad, 64);
      __TUR_CNAME_secure-wipe-ptr!__((void *)opad, 64);
      return;
    }
    memcpy(buf, ipad, 64);
    if (ml > 0) memcpy(buf + 64, msg, ml);
    __TUR_CNAME_sha256-raw!__((void *)buf, (int64_t)(64 + ml), (void *)inner);
    __TUR_CNAME_secure-wipe-ptr!__((void *)buf, (int64_t)(64 + ml));
    free(buf);
  }

  /* out = SHA256(opad || inner) */
  {
    uint8_t buf[96];
    memcpy(buf, opad, 64);
    memcpy(buf + 64, inner, 32);
    __TUR_CNAME_sha256-raw!__((void *)buf, 96, out);
    __TUR_CNAME_secure-wipe-ptr!__((void *)buf, 96);
  }

  __TUR_CNAME_secure-wipe-ptr!__((void *)kpad, 64);
  __TUR_CNAME_secure-wipe-ptr!__((void *)ipad, 64);
  __TUR_CNAME_secure-wipe-ptr!__((void *)opad, 64);
  __TUR_CNAME_secure-wipe-ptr!__((void *)inner, 32);
  ```)
  ;; -------------------------------------------------------------------------
  ;; HKDF-SHA256 (RFC 5869)
  ;; -------------------------------------------------------------------------
  ;;; hkdf-sha256-raw! -- RFC 5869 extract-then-expand into `olen` bytes.
  ;;;
  ;;; Parameters:
  ;;;   ikm    -- input keying material
  ;;;   ilen   -- its length
  ;;;   salt   -- optional salt (NULL/0 means a 32-byte zero salt, per RFC 5869)
  ;;;   slen   -- salt length
  ;;;   info   -- optional context/application info
  ;;;   inflen -- info length
  ;;;   out    -- destination
  ;;;   olen   -- bytes to derive; at most 255*32 = 8160
  ;;;
  ;;; Returns:
  ;;;   true on success; false if olen is out of range or an allocation failed.
  ;;;
  ;;; Example:
  ;;;   (hkdf-sha256-raw! ikm 22 salt 13 info 10 okm 42)
  ;;;
  ;;; Since: 0.1.0
  (defn hkdf-sha256-raw! [ikm : ptr<void>
                          ilen : int
                          salt : ptr<void>
                          slen : int
                          info : ptr<void>
                          inflen : int
                          out : ptr<void>
                          olen : int] : bool
    ```c
    #include <stdint.h>
  #include <stdlib.h>
  #include <string.h>
  if (olen <= 0 || olen > 255 * 32) return false;
  size_t need = (size_t)olen;
  size_t il = (size_t)(inflen > 0 ? inflen : 0);

  /* -- Extract: PRK = HMAC(salt, IKM). A NULL/empty salt is a block of
        HashLen zeros, per RFC 5869 section 2.2. */
  uint8_t prk[32];
  {
    uint8_t zero_salt[32];
    const void *sp = salt;
    int64_t sl = slen > 0 ? slen : 0;
    if (salt == NULL || sl == 0) {
      memset(zero_salt, 0, 32);
      sp = (const void *)zero_salt;
      sl = 32;
    }
    __TUR_CNAME_hmac-sha256-raw!__((void *)sp, sl,
                                   ikm, ilen > 0 ? ilen : 0,
                                   (void *)prk);
  }

  /* -- Expand: T(i) = HMAC(PRK, T(i-1) || info || i) */
  uint8_t tprev[32];
  size_t tlen = 0;               /* 0 for T(1): T(0) is the empty string */
  uint8_t *msg = (uint8_t *)malloc(32 + il + 1);
  if (msg == NULL) {
    __TUR_CNAME_secure-wipe-ptr!__((void *)prk, 32);
    return false;
  }

  uint8_t *o = (uint8_t *)out;
  size_t done = 0;
  for (unsigned counter = 1; done < need; counter++) {
    size_t mlen = 0;
    if (tlen) { memcpy(msg, tprev, tlen); mlen += tlen; }
    if (il)   { memcpy(msg + mlen, info, il); mlen += il; }
    msg[mlen++] = (uint8_t)counter;
    __TUR_CNAME_hmac-sha256-raw!__((void *)prk, 32,
                                   (void *)msg, (int64_t)mlen,
                                   (void *)tprev);
    tlen = 32;
    size_t take = (need - done) < 32 ? (need - done) : 32;
    memcpy(o + done, tprev, take);
    done += take;
  }

  __TUR_CNAME_secure-wipe-ptr!__((void *)msg, (int64_t)(32 + il + 1));
  free(msg);
  __TUR_CNAME_secure-wipe-ptr!__((void *)tprev, 32);
  __TUR_CNAME_secure-wipe-ptr!__((void *)prk, 32);
  return true;
  ```)
  ;; -------------------------------------------------------------------------
  ;; Secret-level wrappers
  ;;
  ;; These allocate a scratch buffer, compute into it, then hand it to
  ;; secret-of-bytes -- which copies it in and wipes the scratch, so the
  ;; plaintext MAC/OKM never outlives the call. The result is a Secret, so it
  ;; inherits the linear discipline: a derived key you forget to wipe is the
  ;; same compile error as a minted one.
  ;; -------------------------------------------------------------------------
  ;;; hmac-into-scratch -- with-secret callback: MAC the message under the
  ;;; borrowed key, writing into the captured scratch buffer.
  (defn hmac-into-scratch [kp : ptr<void>
                           klen : int
                           msg : ptr<void>
                           mlen : int
                           out : ptr<void>] : int
    ```c
    __TUR_CNAME_hmac-sha256-raw!__(kp, klen, msg, mlen, out);
  return 1;
  ```)
  ;;; hkdf-with-cstrs -- HKDF with cstr salt/info, measured with strlen.
  (defn hkdf-with-cstrs [ikm : ptr<void>
                         ilen : int
                         salt : cstr
                         info : cstr
                         out : ptr<void>
                         olen : int] : bool
    ```c
    #include <string.h>
  const char *s = (const char *)salt;
  const char *i = (const char *)info;
  return __TUR_CNAME_hkdf-sha256-raw!__(ikm, ilen,
                                        (void *)s, s ? (int64_t)strlen(s) : 0,
                                        (void *)i, i ? (int64_t)strlen(i) : 0,
                                        out, olen);
  ```)
  ;;; hmac-then-wrap -- MAC into the scratch buffer, copy it into a Secret,
  ;;; then release the scratch.
  ;;;
  ;;; Split out of secret-hmac-sha256 rather than nested inside its `if`: a
  ;;; `let`/`do` block that *evaluates to* a Result, returned through an `if`
  ;;; branch, gets the box->struct unbox applied to a value that is already a
  ;;; struct, and the C compile fails with "operand of type
  ;;; 'struct tur_adt_Result__Secret__cstr' where arithmetic or pointer type is
  ;;; required". Keeping each `if` branch a single call sidesteps it.
  (defn hmac-then-wrap [^borrow key : Secret p : ptr<void> n : int h : int] : (Result Secret
                                                                                cstr)
    (let [_  (hmac-into-scratch (secret-payload-ptr key)
               (secret-len key)
               p
               n
               (scratch-ptr h))
          r  (secret-of-bytes (scratch-ptr h) 32)
          _2 (scratch-free h)]
      r))
  ;;; secret-hmac-sha256 -- MAC a message under a borrowed key.
  ;;;
  ;;; Parameters:
  ;;;   key -- the MAC key, borrowed (not consumed)
  ;;;   p   -- message bytes
  ;;;   n   -- message length
  ;;;
  ;;; Returns:
  ;;;   (Result Secret cstr) -- ok carries a 32-byte Secret holding the MAC.
  ;;;   It is a Secret rather than a plain buffer because a MAC compared with
  ;;;   the wrong primitive is exactly as dangerous as a leaked key; keeping it
  ;;;   in a Secret makes `secret-eq?` (constant-time) the path of least
  ;;;   resistance.
  ;;;
  ;;; Example:
  ;;;   (let [r (secret-hmac-sha256 k body len)]
  ;;;     (if (ok? r) (ok-val r) ...))
  ;;;
  ;;; Since: 0.1.0
  (defn secret-hmac-sha256 [^borrow key : Secret p : ptr<void> n : int] : (Result Secret
                                                                            cstr)
    (let [h (scratch-alloc 32)]
      (if (= h 0)
        (err "secret-hmac-sha256: allocation failed")
        (hmac-then-wrap key p n h))))
  ;;; hkdf-then-wrap -- derive into the scratch buffer, copy it into a Secret,
  ;;; then release the scratch. Split out for the same reason as
  ;;; hmac-then-wrap.
  (defn hkdf-then-wrap [^borrow ikm : Secret
                        salt : cstr
                        info : cstr
                        n : int
                        h : int] : (Result Secret cstr)
    (if (hkdf-with-cstrs (secret-payload-ptr ikm)
          (secret-len ikm)
          salt
          info
          (scratch-ptr h)
          n)
      (wrap-scratch h n)
      (fail-scratch h "secret-hkdf-sha256: derivation failed")))
  ;;; wrap-scratch -- copy n scratch bytes into a Secret, then free the scratch.
  (defn wrap-scratch [h : int n : int] : (Result Secret cstr)
    (let [r  (secret-of-bytes (scratch-ptr h) n)
          _2 (scratch-free h)]
      r))
  ;;; fail-scratch -- release the scratch and report `msg`.
  (defn fail-scratch [h : int msg : cstr] : (Result Secret cstr)
    (let [_ (scratch-free h)] (err msg)))
  ;;; secret-hkdf-sha256 -- derive `n` bytes from borrowed input keying material.
  ;;;
  ;;; `salt` and `info` are `cstr` and measured with strlen, which suits the
  ;;; usual case (ASCII labels). A salt containing a NUL byte must go through
  ;;; `hkdf-sha256-raw!` instead.
  ;;;
  ;;; Parameters:
  ;;;   ikm  -- input keying material, borrowed (not consumed)
  ;;;   salt -- optional salt string ("" selects the RFC 5869 zero salt)
  ;;;   info -- optional context/application info string
  ;;;   n    -- bytes to derive; 1..8160
  ;;;
  ;;; Returns:
  ;;;   (Result Secret cstr) -- ok carries an n-byte Secret.
  ;;;
  ;;; Example:
  ;;;   (secret-hkdf-sha256 master "v1-salt" "encryption key" 32)
  ;;;
  ;;; Since: 0.1.0
  (defn secret-hkdf-sha256 [^borrow ikm : Secret
                            salt : cstr
                            info : cstr
                            n : int] : (Result Secret cstr)
    (if (< n 1)
      (err "secret-hkdf-sha256: length must be positive")
      (if (> n 8160)
        (err "secret-hkdf-sha256: HKDF-SHA256 yields at most 8160 bytes")
        (let [h (scratch-alloc n)]
          (if (= h 0)
            (err "secret-hkdf-sha256: allocation failed")
            (hkdf-then-wrap ikm salt info n h))))))) ;; end defmodule secret/kdf
