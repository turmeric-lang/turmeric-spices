;;; secret/core -- an owned, page-locked, linearly-typed secret buffer.
;;;
;;; This is the piece Go's `runtime/secret` cannot express. Go guarantees
;;; erasure dynamically, at the runtime level; Turmeric emits C and cannot
;;; make that promise. What Turmeric has instead is substructural types, and
;;; they give a *stronger* story in the one place it matters most: forgetting
;;; to wipe key material stops being a code-review item and becomes a
;;; compile-time error.
;;;
;;;   (let [r (secret-random! 32)]
;;;     (if (ok? r)
;;;       (let [k (ok-val r)]
;;;         (with-secret k use-key))    ;; <- borrows; obligation still open
;;;       0))
;;;                                     ;; <- TUR-E0100 under -Xsubstructural:
;;;                                     ;;    `k` was never consumed
;;;
;;; `Secret` is `:linear`: every control path through a live `Secret` must
;;; end in exactly one `secret-wipe!`. Observing it (`with-secret`,
;;; `secret-eq?`, `secret-len`, `secret-locked?`) takes it by `^borrow` and
;;; does not discharge the obligation. Using one after wiping is likewise
;;; rejected. As with the sqlite spice's `Db`, the discipline is inert in an
;;; ordinary build and enforced under `-Xsubstructural`.
;;;
;;; Runtime hygiene layered underneath the static guarantee:
;;;
;;;   - the backing pages are `mlock`ed, so the bytes stay out of swap;
;;;   - on Linux they are marked `MADV_DONTDUMP`, so they stay out of core
;;;     dumps;
;;;   - `secret-wipe!` zeroes through `secure-wipe-ptr!` before freeing.
;;;
;;; Locking is **fail-soft**: `RLIMIT_MEMLOCK` defaults to 64 KiB on many
;;; Linux distributions, and refusing to mint a key because of an ambient
;;; ulimit would push callers toward raw buffers, which is strictly worse.
;;; Callers who genuinely require locking must ask via `secret-locked?`.
;;;
;;; Guarantees hold on the **compiled** path only -- see the spice README.
;;;
;;; Implementation note: the inline-C helpers here deal only in raw pointers
;;; and never build a `Result` themselves. Every `Result` is constructed in
;;; Turmeric with `ok`/`err`.
;;;
;;; That split began as a workaround -- an inline-C body returns the *boxed*
;;; Result carrier, and the box-to-struct conversion used to be dropped in any
;;; function the CPS transform touched, which is every caller of a
;;; higher-order function like `with-secret`. That is fixed as of turmeric
;;; 65024bca (docs/archive/cps-result-unbox-dropped.md), so the split is no
;;; longer forced. It is kept because it is the better factoring on its own
;;; terms: inline C does pointer work, Turmeric does control flow and error
;;; typing.
;;;
;;; Since: 0.1.0
(defmodule secret/core
  (import secret/hygiene
    :refer
    [secure-wipe-ptr! crypto-random-bytes! ct-eq-ptr?])
  (export Secret
    secret-random!
    secret-of-bytes
    secret-wipe!
    with-secret
    secret-len
    secret-locked?
    secret-eq?)
  ;; -------------------------------------------------------------------------
  ;; The handle
  ;;
  ;; One allocation holds metadata and bytes together, so one free releases
  ;; everything and the data pointer is always a fixed offset from the handle:
  ;;
  ;;   struct __tur_secret { int64_t len; int64_t locked; unsigned char data[]; };
  ;;
  ;; (the zlib spice's __gzbuf shape). `Secret` rides the int carrier as a
  ;; pointer to that struct.
  ;; -------------------------------------------------------------------------
  ;;; Secret -- an owned, locked, linear buffer of key material.
  ;;;
  ;;; Construct with `secret-random!` or `secret-of-bytes`; consume with
  ;;; `secret-wipe!`. There is deliberately no accessor returning the raw
  ;;; bytes: reach them through `with-secret`, which scopes the exposure.
  ;;;
  ;;; Since: 0.1.0
  (defopaque ^linear Secret :int)
  ;; -------------------------------------------------------------------------
  ;; Private raw helpers -- pointers in, pointers out, no Result construction
  ;; -------------------------------------------------------------------------
  ;;; secret-alloc-raw -- allocate and lock an n-byte secret; 0 on failure.
  ;;; The payload is left uninitialized; every caller fills it immediately.
  (defn secret-alloc-raw [n : int] : int
    ```c
    #include <stdlib.h>
  #include <string.h>
  #include <sys/mman.h>
  struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  if (n <= 0) return 0;
  size_t hdr = 2 * sizeof(int64_t);
  struct __tur_secret *s = (struct __tur_secret *)malloc(hdr + (size_t)n);
  if (!s) return 0;
  s->len = n;
  s->locked = 0;
  #if defined(_WIN32)
    if (VirtualLock((LPVOID)s, hdr + (size_t)n)) s->locked = 1;
  #else
    /* Lock the whole allocation, header included -- the kernel rounds to
       page granularity anyway, so a partial lock buys nothing. Failure is
       expected under a low RLIMIT_MEMLOCK and is deliberately not fatal. */
    if (mlock((void *)s, hdr + (size_t)n) == 0) s->locked = 1;
    #if defined(MADV_DONTDUMP)
      /* Keep the pages out of core dumps. Best-effort; no macOS analog. */
      (void)madvise((void *)s, hdr + (size_t)n, MADV_DONTDUMP);
    #endif
  #endif
  return (int64_t)(intptr_t)s;
  ```)
  ;;; secret-free-raw! -- wipe, unlock, and free a raw handle from
  ;;; secret-alloc-raw. Shared by secret-wipe! and the constructors' error
  ;;; paths, so a failed mint releases its pages exactly the way a successful
  ;;; one eventually will.
  (defn secret-free-raw! [h : int] : void
    ```c
    #include <stdlib.h>
  #include <sys/mman.h>
  struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  if (h == 0) return;
  struct __tur_secret *sec = (struct __tur_secret *)(intptr_t)h;
  size_t total = 2 * sizeof(int64_t) + (size_t)sec->len;
  /* Wipe before unlocking: munlock makes the pages swappable again, so the
     zeroing has to happen while they are still pinned. */
  __TUR_CNAME_secure-wipe-ptr!__((void *)sec->data, sec->len);
  sec->len = 0;
  if (sec->locked) {
    #if defined(_WIN32)
      VirtualUnlock((LPVOID)sec, total);
    #else
      munlock((void *)sec, total);
    #endif
  }
  sec->locked = 0;
  free(sec);
  ```)
  ;;; secret-fill-random-raw! -- fill a raw handle's payload from the CSPRNG.
  (defn secret-fill-random-raw! [h : int n : int]
    #fx{Rand}
    : bool
    ```c
    struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  if (h == 0) return false;
  struct __tur_secret *sec = (struct __tur_secret *)(intptr_t)h;
  int64_t r = __TUR_CNAME_crypto-random-bytes!__((void *)sec->data, n);
  return tur_is_ok(r);
  ```)
  ;;; secret-copy-in-raw! -- copy n bytes into a raw handle, wiping the source.
  (defn secret-copy-in-raw! [h : int p : ptr<void> n : int] : bool
    ```c
    #include <string.h>
  struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  if (h == 0 || p == NULL) return false;
  struct __tur_secret *sec = (struct __tur_secret *)(intptr_t)h;
  memcpy(sec->data, p, (size_t)n);
  __TUR_CNAME_secure-wipe-ptr!__(p, n);
  return true;
  ```)
  ;;; secret-of-raw -- reinterpret a raw handle as the opaque Secret.
  ;;; The only place a Secret is minted; private on purpose.
  (defn secret-of-raw [h : int] : Secret
    ```c
    return h;
  ```)
  ;;; secret-data-raw -- raw pointer to the payload bytes.
  ;;; PRIVATE and deliberately not exported: handing this out unscoped would
  ;;; undo the whole point of the type. `with-secret` is the public door.
  (defn secret-data-raw [^borrow s : Secret] : ptr<void>
    ```c
    struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  return (void *)((struct __tur_secret *)(intptr_t)s)->data;
  ```)
  ;; -------------------------------------------------------------------------
  ;; Construction
  ;; -------------------------------------------------------------------------
  ;;; secret-random! -- mint an n-byte secret from the OS CSPRNG.
  ;;;
  ;;; Parameters:
  ;;;   n -- byte length; must be positive
  ;;;
  ;;; Returns:
  ;;;   (Result Secret cstr) -- ok carries a live, locked Secret the caller
  ;;;   must eventually consume with secret-wipe!; err carries a static
  ;;;   description. A secret that could not be filled is released here rather
  ;;;   than handed back, so the error path leaks neither memory nor a locked
  ;;;   page and never yields a zero-filled "key".
  ;;;
  ;;; Example:
  ;;;   (let [r (secret-random! 32)]
  ;;;     (if (ok? r)
  ;;;       (let [k (ok-val r)] (do (use k) (secret-wipe! k)))
  ;;;       0))
  ;;;
  ;;; Since: 0.1.0
  (defn secret-random! [n : int]
    #fx{Rand}
    : (Result Secret cstr)
    (if (< n 1)
      (err "secret-random!: length must be positive")
      (let [h (secret-alloc-raw n)]
        (if (= h 0)
          (err "secret-random!: allocation failed")
          (if (secret-fill-random-raw! h n)
            (ok (secret-of-raw h))
            (do (secret-free-raw! h) (err "secret-random!: OS CSPRNG failed")))))))
  ;;; secret-of-bytes -- copy `n` bytes into a fresh secret, wiping the source.
  ;;;
  ;;; The source wipe is the point: material that arrived in an ordinary buffer
  ;;; (a decoded config value, a read from a pipe) exists in two places until
  ;;; the plain copy is destroyed, and the caller who has just handed ownership
  ;;; over is exactly the caller least likely to remember.
  ;;;
  ;;; Parameters:
  ;;;   p -- source bytes; wiped in place before this returns
  ;;;   n -- byte count; must be positive
  ;;;
  ;;; Returns:
  ;;;   (Result Secret cstr) -- ok carries a live, locked Secret.
  ;;;
  ;;; Example:
  ;;;   (let [r (secret-of-bytes raw 32)]   ; raw is zeroed on return
  ;;;     (if (ok? r) (ok-val r) ...))
  ;;;
  ;;; Since: 0.1.0
  (defn secret-of-bytes [p : ptr<void> n : int] : (Result Secret cstr)
    (if (< n 1)
      (err "secret-of-bytes: length must be positive")
      (let [h (secret-alloc-raw n)]
        (if (= h 0)
          (err "secret-of-bytes: allocation failed")
          (if (secret-copy-in-raw! h p n)
            (ok (secret-of-raw h))
            (do (secret-free-raw! h) (err "secret-of-bytes: NULL source")))))))
  ;; -------------------------------------------------------------------------
  ;; Consumption -- the single legal end for a Secret
  ;; -------------------------------------------------------------------------
  ;;; secret-wipe! -- zero, unlock, and free a secret. THE destructor.
  ;;;
  ;;; Consumes the linear `Secret`: this is its one legal consumption, and
  ;;; touching the handle afterwards is a compile-time error under
  ;;; `-Xsubstructural`. The payload is zeroed with `secure-wipe-ptr!` before
  ;;; the free, so the bytes are gone rather than merely returned to the
  ;;; allocator's free list.
  ;;;
  ;;; Parameters:
  ;;;   s -- the secret to destroy
  ;;;
  ;;; Returns:
  ;;;   Nothing.
  ;;;
  ;;; Example:
  ;;;   (secret-wipe! k)
  ;;;
  ;;; Since: 0.1.0
  (defn secret-wipe! [s : Secret] : void
    ```c
    __TUR_CNAME_secret-free-raw!__(s);
  ```)
  ;; -------------------------------------------------------------------------
  ;; Borrowing access -- none of these discharge the linear obligation
  ;; -------------------------------------------------------------------------
  ;;; with-secret -- run `f` over the secret's bytes for the duration of the call.
  ;;;
  ;;; The only sanctioned route to the payload. `f` receives the raw pointer and
  ;;; the length, and its result is returned unchanged.
  ;;;
  ;;; The borrow checker keeps the `Secret` itself from escaping, but it cannot
  ;;; follow the raw `ptr<void>` handed to `f` -- a callback that stashes that
  ;;; pointer somewhere outliving the call has a dangling reference to freed
  ;;; key material, and nothing here will catch it. Do not do that.
  ;;;
  ;;; Parameters:
  ;;;   s -- the secret, borrowed for the duration of the call
  ;;;   f -- receives (bytes, length) and returns an int
  ;;;
  ;;; Returns:
  ;;;   Whatever `f` returned.
  ;;;
  ;;; Example:
  ;;;   (with-secret k hash-into)
  ;;;
  ;;; Since: 0.1.0
  (defn with-secret [^borrow s : Secret f : (fn [ptr<void> int] int)] : int
    (f (secret-data-raw s) (secret-len s)))
  ;;; secret-len -- the secret's payload length in bytes.
  ;;;
  ;;; Length is not secret -- it is observable from the allocation regardless --
  ;;; so this is an ordinary accessor.
  ;;;
  ;;; Parameters:
  ;;;   s -- the secret, borrowed
  ;;;
  ;;; Returns:
  ;;;   The byte length passed at construction.
  ;;;
  ;;; Example:
  ;;;   (secret-len k)  ; => 32
  ;;;
  ;;; Since: 0.1.0
  (defn secret-len [^borrow s : Secret] : int
    ```c
    struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  if (s == 0) return 0;
  return ((struct __tur_secret *)(intptr_t)s)->len;
  ```)
  ;;; secret-locked? -- did the backing pages actually get locked into RAM?
  ;;;
  ;;; Locking is fail-soft, so this is how a caller who *requires* it finds out.
  ;;; A false here means the bytes may reach swap; on Linux the usual cause is
  ;;; `RLIMIT_MEMLOCK` (frequently 64 KiB by default).
  ;;;
  ;;; Parameters:
  ;;;   s -- the secret, borrowed
  ;;;
  ;;; Returns:
  ;;;   true when mlock/VirtualLock succeeded at construction.
  ;;;
  ;;; Example:
  ;;;   (if (secret-locked? k) 0 (warn "key may reach swap"))
  ;;;
  ;;; Since: 0.1.0
  (defn secret-locked? [^borrow s : Secret] : bool
    ```c
    struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  if (s == 0) return false;
  return ((struct __tur_secret *)(intptr_t)s)->locked != 0;
  ```)
  ;;; secret-eq? -- constant-time equality of two secrets' contents.
  ;;;
  ;;; Differing lengths compare false immediately; length is not secret. Equal
  ;;; lengths are compared with `ct-eq-ptr?`, so the timing does not reveal how
  ;;; far the two agreed.
  ;;;
  ;;; Parameters:
  ;;;   a -- first secret, borrowed
  ;;;   b -- second secret, borrowed
  ;;;
  ;;; Returns:
  ;;;   true when both hold the same bytes.
  ;;;
  ;;; Example:
  ;;;   (if (secret-eq? computed supplied) (accept) (reject))
  ;;;
  ;;; Since: 0.1.0
  (defn secret-eq? [^borrow a : Secret ^borrow b : Secret] : bool
    (if (= (secret-len a) (secret-len b))
      (ct-eq-ptr? (secret-data-raw a) (secret-data-raw b) (secret-len a))
      false))) ;; end defmodule secret/core
