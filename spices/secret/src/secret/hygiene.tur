;;; secret/hygiene -- free-standing crypto hygiene primitives.
;;;
;;; These three operations are the floor the rest of the spice is built on,
;;; and they are useful on their own against any raw buffer -- no `Secret`
;;; handle required:
;;;
;;;   secure-wipe-ptr!     -- a zeroing memset the optimizer may not elide
;;;   crypto-random-bytes! -- entropy from the OS CSPRNG, not libc rand()
;;;   ct-eq-ptr?           -- comparison whose timing does not leak content
;;;
;;; Why these are not in stdlib: `stdlib/random.tur` is `rand()` seeded with
;;; `time(NULL)` (fine for simulation, useless for a token), and
;;; `raw-memset` lowers to a plain `memset` the C compiler is free to delete
;;; entirely when the buffer is dead afterwards -- which is exactly the case
;;; every wipe of key material is in. Neither is a bug in stdlib; they are
;;; the wrong tools for this job. Reach for this module instead.
;;;
;;; Guarantees hold on the **compiled** path only -- see the interpreter
;;; caveat in the spice README.
;;;
;;; Since: 0.1.0
(defmodule secret/hygiene
  (export secure-wipe-ptr! crypto-random-bytes! crypto-random-source ct-eq-ptr?)
  ;; -------------------------------------------------------------------------
  ;; Wiping
  ;; -------------------------------------------------------------------------
  ;;; secure-wipe-ptr! -- zero `n` bytes at `p` in a way the optimizer may not
  ;;; elide.
  ;;;
  ;;; A plain `memset(p, 0, n)` on a buffer that is dead afterwards is a
  ;;; textbook dead-store elimination target: the C standard lets the compiler
  ;;; observe that nobody reads the zeros and delete the call, leaving the key
  ;;; material in memory. Every serious implementation therefore reaches for a
  ;;; platform primitive the compiler is required to respect. The ladder here,
  ;;; highest preference first:
  ;;;
  ;;;   1. `SecureZeroMemory`  -- Win32
  ;;;   2. `explicit_bzero`    -- glibc >= 2.25, OpenBSD, FreeBSD, NetBSD,
  ;;;                             DragonFly
  ;;;   3. a `volatile` function pointer to `memset` -- portable fallback
  ;;;      (macOS lands here: Apple's libc ships neither `explicit_bzero` nor
  ;;;      an unguarded `memset_s`). The indirection through a volatile object
  ;;;      means the compiler cannot prove which function is called, so the
  ;;;      call must be emitted.
  ;;;
  ;;; A compiler memory barrier follows on GCC/clang so the wipe is not sunk
  ;;; past a later use of the buffer.
  ;;;
  ;;; Parameters:
  ;;;   p -- start of the region to zero; NULL is a no-op
  ;;;   n -- byte count; values <= 0 are a no-op
  ;;;
  ;;; Returns:
  ;;;   Nothing.
  ;;;
  ;;; Example:
  ;;;   (secure-wipe-ptr! key 32)
  ;;;
  ;;; Since: 0.1.0
  (defn secure-wipe-ptr! [p : ptr<void> n : int] : void
    ```c
    #include <stddef.h>
  #include <string.h>
  #if defined(_WIN32)
  #include <windows.h>
  #endif
  if (p == NULL || n <= 0) return;
  size_t len = (size_t)n;
  #if defined(_WIN32)
    SecureZeroMemory(p, len);
  #elif (defined(__GLIBC__) && (__GLIBC__ > 2 || (__GLIBC__ == 2 && __GLIBC_MINOR__ >= 25))) \
        || defined(__OpenBSD__) || defined(__FreeBSD__) || defined(__NetBSD__) \
        || defined(__DragonFly__)
    explicit_bzero(p, len);
  #else
    {
      /* The volatile qualifier is on the POINTER, not the pointee: the
         compiler must reload it and cannot constant-fold the callee, so the
         call survives dead-store elimination. This is the libsodium
         sodium_memzero fallback. */
      static void *(*volatile vmemset)(void *, int, size_t) = memset;
      vmemset(p, 0, len);
    }
  #endif
  #if defined(__GNUC__) || defined(__clang__)
    __asm__ __volatile__("" : : "r"(p) : "memory");
  #endif
  ```)
  ;; -------------------------------------------------------------------------
  ;; Randomness
  ;; -------------------------------------------------------------------------
  ;;; crypto-random-bytes! -- fill `n` bytes at `p` from the OS CSPRNG.
  ;;;
  ;;; Backend ladder, highest preference first: `BCryptGenRandom` (Win32),
  ;;; `arc4random_buf` (macOS/BSD -- cannot fail, never blocks post-boot),
  ;;; `getrandom(2)` (Linux), then `/dev/urandom` as the universal POSIX
  ;;; floor. `crypto-random-source` reports which one this build selected.
  ;;;
  ;;; This is the single highest-value function in the spice. Anyone reaching
  ;;; for `stdlib/random.tur` to mint a session token, a salt, or a nonce is
  ;;; getting `rand()` seeded from `time(NULL)` -- a few thousand possible
  ;;; streams, trivially enumerable. Use this instead.
  ;;;
  ;;; Parameters:
  ;;;   p -- destination buffer, at least `n` bytes
  ;;;   n -- byte count; 0 succeeds trivially, negative is an error
  ;;;
  ;;; Returns:
  ;;;   (Result int cstr) -- ok carries the byte count written; err carries a
  ;;;   static description. On error the destination is left wiped, never
  ;;;   partially filled with low-entropy bytes.
  ;;;
  ;;; Example:
  ;;;   (let [r (crypto-random-bytes! buf 32)]
  ;;;     (if (ok? r) (use-key buf) (die (err-val r))))
  ;;;
  ;;; Since: 0.1.0
  (defn crypto-random-bytes! [p : ptr<void> n : int]
    #fx{Rand}
    : (Result int cstr)
    ```c
    #include <stddef.h>
  #include <stdlib.h>
  #include <string.h>
  #if defined(_WIN32)
  #include <windows.h>
  #include <bcrypt.h>
  #elif defined(__linux__)
  #include <sys/syscall.h>
  #include <unistd.h>
  #include <errno.h>
  #include <stdio.h>
  #else
  #include <stdlib.h>
  #include <stdio.h>
  #endif

  if (n < 0)   return tur_err_ptr((void *)"crypto-random-bytes!: negative length");
  if (n == 0)  return tur_ok_int(0);
  if (p == NULL) return tur_err_ptr((void *)"crypto-random-bytes!: NULL destination");

  unsigned char *out = (unsigned char *)p;
  size_t want = (size_t)n;

  #if defined(_WIN32)
    if (BCryptGenRandom(NULL, (PUCHAR)out, (ULONG)want,
                        BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0) {
      __TUR_CNAME_secure-wipe-ptr!__((void *)out, (int64_t)want);
      return tur_err_ptr((void *)"crypto-random-bytes!: BCryptGenRandom failed");
    }
    return tur_ok_int((int64_t)want);
  #elif defined(__APPLE__) || defined(__OpenBSD__) || defined(__FreeBSD__) \
        || defined(__NetBSD__) || defined(__DragonFly__)
    /* arc4random_buf is documented never to fail and never to block. */
    arc4random_buf(out, want);
    return tur_ok_int((int64_t)want);
  #else
    size_t got = 0;
    #if defined(__linux__) && defined(SYS_getrandom)
      while (got < want) {
        long r = syscall(SYS_getrandom, out + got, want - got, 0);
        if (r < 0) {
          if (errno == EINTR) continue;
          break;              /* ENOSYS on pre-3.17 kernels: fall through */
        }
        got += (size_t)r;
      }
    #endif
    if (got < want) {
      FILE *f = fopen("/dev/urandom", "rb");
      if (f == NULL) {
        __TUR_CNAME_secure-wipe-ptr!__((void *)out, (int64_t)want);
        return tur_err_ptr((void *)"crypto-random-bytes!: cannot open /dev/urandom");
      }
      size_t rd = fread(out + got, 1, want - got, f);
      fclose(f);
      got += rd;
    }
    if (got < want) {
      __TUR_CNAME_secure-wipe-ptr!__((void *)out, (int64_t)want);
      return tur_err_ptr((void *)"crypto-random-bytes!: short read from OS CSPRNG");
    }
    return tur_ok_int((int64_t)want);
  #endif
  ```)
  ;;; crypto-random-source -- name the CSPRNG backend this build selected.
  ;;;
  ;;; Intended for diagnostics, test assertions, and startup banners -- it lets
  ;;; a deployment confirm it is not silently on a weaker path than expected.
  ;;;
  ;;; Returns:
  ;;;   A static cstr: "BCryptGenRandom", "arc4random_buf", "getrandom", or
  ;;;   "/dev/urandom".
  ;;;
  ;;; Example:
  ;;;   (println (crypto-random-source))  ; => "arc4random_buf" on macOS
  ;;;
  ;;; Since: 0.1.0
  (defn crypto-random-source [] : cstr
    ```c
    #if defined(_WIN32)
    return (const char *)"BCryptGenRandom";
  #elif defined(__APPLE__) || defined(__OpenBSD__) || defined(__FreeBSD__) \
        || defined(__NetBSD__) || defined(__DragonFly__)
    return (const char *)"arc4random_buf";
  #elif defined(__linux__) && defined(SYS_getrandom)
    return (const char *)"getrandom";
  #else
    return (const char *)"/dev/urandom";
  #endif
  ```)
  ;; -------------------------------------------------------------------------
  ;; Constant-time comparison
  ;; -------------------------------------------------------------------------
  ;;; ct-eq-ptr? -- compare two `n`-byte buffers in time independent of content.
  ;;;
  ;;; `memcmp` returns at the first differing byte, so an attacker who can time
  ;;; the call learns how long a shared prefix their guess has -- enough to
  ;;; recover a MAC or token one byte at a time. This accumulates the XOR of
  ;;; every byte pair through a `volatile` accumulator (so the compiler may not
  ;;; introduce an early exit) and only then collapses to a bool.
  ;;;
  ;;; Note this hides the *content* of the buffers, not their *length*: callers
  ;;; comparing variable-length secrets should compare fixed-size digests of
  ;;; them rather than the raw bytes.
  ;;;
  ;;; Parameters:
  ;;;   a -- first buffer
  ;;;   b -- second buffer
  ;;;   n -- byte count to compare; <= 0 compares equal
  ;;;
  ;;; Returns:
  ;;;   true when all `n` bytes match.
  ;;;
  ;;; Example:
  ;;;   (if (ct-eq-ptr? computed-mac supplied-mac 32) (accept) (reject))
  ;;;
  ;;; Since: 0.1.0
  (defn ct-eq-ptr? [a : ptr<void> b : ptr<void> n : int] : bool
    ```c
    #include <stddef.h>
  if (n <= 0) return true;
  if (a == NULL || b == NULL) return false;
  const volatile unsigned char *x = (const volatile unsigned char *)a;
  const volatile unsigned char *y = (const volatile unsigned char *)b;
  volatile unsigned char acc = 0;
  for (size_t i = 0; i < (size_t)n; i++) acc |= (unsigned char)(x[i] ^ y[i]);
  return acc == 0;
  ```)) ;; end defmodule secret/hygiene
