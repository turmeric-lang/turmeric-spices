;;; secret/internal -- intra-spice plumbing shared by secret/kdf and secret/hex.
;;;
;;; NOT PART OF THE PUBLIC API. Nothing here is covered by the spice's
;;; compatibility story, and `secret-payload-ptr` in particular hands out the
;;; raw pointer that `secret/core` deliberately withholds -- `with-secret` is
;;; the door application code should use.
;;;
;;; It exists because Turmeric has no module-private export: `secret/kdf` and
;;; `secret/hex` both need the payload pointer (their operations take extra
;;; message/output arguments that the `(fn [ptr<void> int] int)` callback
;;; shape of `with-secret` cannot thread) and both need a scratch buffer to
;;; compute into. The alternative was a third and fourth copy of the
;;; `struct __tur_secret` layout pasted into each module, which is worse: a
;;; layout change in `secret/core` would then silently miscompile instead of
;;; failing in one place.
;;;
;;; Since: 0.1.0
(defmodule secret/internal
  (import secret/core :refer [Secret])
  (export secret-payload-ptr scratch-alloc scratch-ptr scratch-free)
  ;;; secret-payload-ptr -- payload pointer of a borrowed Secret.
  ;;; Mirrors secret/core's private `secret-data-raw`. Intra-spice only.
  ;;; Must match the layout in secret/core's secret-alloc-raw.
  (defn secret-payload-ptr [^borrow s : Secret] : ptr<void>
    ```c
    struct __tur_secret { int64_t len; int64_t locked; unsigned char data[1]; };
  if (s == 0) return NULL;
  return (void *)((struct __tur_secret *)(intptr_t)s)->data;
  ```)
  ;;; scratch-alloc -- malloc `n` zeroed bytes as a raw handle; 0 on failure.
  ;;; Callers hand the buffer to secret-of-bytes, which wipes it on the way in,
  ;;; so a scratch buffer never outlives the call holding plaintext.
  (defn scratch-alloc [n : int] : int
    ```c
    #include <stdlib.h>
  return (int64_t)(intptr_t)calloc((size_t)(n > 0 ? n : 1), 1);
  ```)
  ;;; scratch-ptr -- view a scratch handle as a pointer.
  (defn scratch-ptr [h : int] : ptr<void>
    ```c
    return (void *)(intptr_t)h;
  ```)
  ;;; scratch-free -- release a scratch buffer (already wiped by its consumer).
  ;;; Returns 0 rather than :void so it can be sequenced in a `let` binding
  ;;; list; binding a :void call emits `void x = ...` and fails the C compile.
  (defn scratch-free [h : int] : int
    ```c
    #include <stdlib.h>
  if (h) free((void *)(intptr_t)h);
  return 0;
  ```)) ;; end defmodule secret/internal
