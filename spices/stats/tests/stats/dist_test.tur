;; tests/stats/dist_test.tur -- smoke tests for stats/dist.
(defmodule stats/tests/dist
  (import stats/dist
    :refer
    [dist-normal
     dist-t
     dist-chi2
     pdf
     cdf
     quantile
     dnorm
     pnorm
     qnorm
     dt
     pt
     pchi2])
  (import stats/rng :refer [rng-make rng-free])
  (import test/assert :refer [assert-true])
  (import test/suite :refer [describe it])
  (import test/runner :refer [run-all-status])
  (defn approx= [x : float y : float tol : float] : bool
    ```c
    #include <math.h>
    return fabs(x - y) <= tol;
    ```)
  (defn __all-tests [] : void
    (describe "stats/dist normal"
      (it "pnorm(0) = 0.5"
        (assert-true (approx= (pnorm 0.0 0.0 1.0) 0.5 1e-09)))
      (it "pnorm(1.96) ~ 0.975"
        (assert-true (approx= (pnorm 1.96 0.0 1.0) 0.975 0.002)))
      (it "dnorm(0) = 1/sqrt(2pi)"
        (assert-true (approx= (dnorm 0.0 0.0 1.0) 0.3989422804 1e-07)))
      (it "qnorm(0.5) = 0"
        (assert-true (approx= (qnorm 0.5 0.0 1.0) 0.0 1e-06)))
      ;; 1e-9, not the 1e-3 this used to allow: AS241 is accurate to ~1e-16, and
      ;; a loose tolerance is what let a corrupted coefficient set look plausible.
      (it "qnorm(0.975) ~ 1.959963985"
        (assert-true (approx= (qnorm 0.975 0.0 1.0) 1.9599639845400545 1e-09)))
      (it "pnorm(qnorm(0.9)) ~ 0.9  (round-trip)"
        (assert-true (approx= (pnorm (qnorm 0.9 0.0 1.0) 0.0 1.0) 0.9 1e-06)))
      ;; qnorm has three branches -- |p-0.5| <= 0.425, then sqrt(-log) with a
      ;; split at r = 5. 0.9 exercises the first, 0.975 the second, and 1e-12 the
      ;; third; without a case past r = 5 that last branch is never evaluated.
      (it "qnorm(0.999) ~ 3.090232306"
        (assert-true (approx= (qnorm 0.999 0.0 1.0) 3.090232306167813 1e-09)))
      (it "qnorm reaches the far tail (r > 5 branch)"
        (assert-true (approx= (qnorm 1e-12 0.0 1.0) -7.034483825301132 1e-09)))
      (it "qnorm is symmetric about the mean"
        (assert-true (approx= (qnorm 0.025 0.0 1.0)
                       (- 0.0 (qnorm 0.975 0.0 1.0))
                       1e-12)))
      ;; Location/scale must shift and stretch the standard quantile.
      (it "qnorm honours mu and sigma"
        (assert-true (approx= (qnorm 0.975 1e+01 2.0)
                       (+ 1e+01 (* 2.0 1.9599639845400545))
                       1e-09))))
    (describe "stats/dist t"
      (it "pt(0, df=10) = 0.5" (assert-true (approx= (pt 0.0 1e+01) 0.5 1e-09)))
      (it "pt(1.812, df=10) ~ 0.95  (one-tailed)"
        (assert-true (approx= (pt 1.812 1e+01) 0.95 0.002))))
    (describe "stats/dist chi2"
      (it "pchi2(0, df=5) = 0"
        (assert-true (approx= (pchi2 0.0 5.0) 0.0 1e-09)))
      (it "pchi2(11.07, df=5) ~ 0.95"
        (assert-true (approx= (pchi2 11.07 5.0) 0.95 0.02)))
      (it "pdf of normal at 0 via generic pdf"
        (let [d (dist-normal 0.0 1.0)
              v (pdf d 0.0)]
          (assert-true (approx= v 0.3989422804 1e-07))))))
  (defn main [] : int (__all-tests) (run-all-status)))
