;; tests/rtmidi/out_test.tur -- tests for rtmidi/out.
(defmodule rtmidi/tests/out
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-eq])
  (import test/runner :refer [run-all-status])
  (defn __all-tests [] : void
    (describe "rtmidi/out" (it "module loads without error" (assert-eq 1 1))))
  (defn main [] : int (__all-tests) (run-all-status)))
