(defpackage tur-postgres
  :name        "tur-postgres"
  :version     "0.4.0"
  :description "PostgreSQL client for Turmeric via libpq"
  :license     "MIT"
  :spices #map{
    "test" #map{:path   "../test"
                :url    "https://github.com/turmeric-lang/turmeric-spices"
                :ref    "test-v0.1.0"
                :subdir "spices/test"
                :optional true}
  }
  ;; libpq comes from the system (libpq-dev / brew libpq), never built from
  ;; source: there is no standalone libpq repo to fetch, so there is no :url
  ;; and a missing libpq stops `tur fetch` with a message naming it.
  ;;
  ;; tur links $<TARGET_FILE:PostgreSQL::PostgreSQL>, the real libpq, so the
  ;; target name no longer has to match the library's (it used to become
  ;; -lPostgreSQL, which is why a shim once re-exported it as `pq`).
  ;;
  ;; Homebrew keeps libpq keg-only, out of every default search path, and
  ;; :options reach find_package as hints.  This is the Apple Silicon prefix;
  ;; on an Intel Mac or a custom Homebrew prefix, export
  ;; PostgreSQL_ROOT="$(brew --prefix libpq)" instead.  A path that does not
  ;; exist is simply not searched, so the hint is inert on Linux.
  :cmake-deps #map{
    "libpq" #map{:prefer-system true
                 :cmake-name    "PostgreSQL"
                 :targets       ["PostgreSQL::PostgreSQL"]
                 :options       #map{:PostgreSQL_ROOT "/opt/homebrew/opt/libpq"}}
  }
  :exports #map{
    "postgres/db"     ["Conn"
                       "db-connect" "db-close" "db-exec" "db-query"
                       "db-query-params" "db-begin" "db-commit" "db-rollback"]
    "postgres/stmt"   ["stmt-prepare" "stmt-exec-prepared" "stmt-deallocate"]
    "postgres/row"    ["Rows"
                       "rows-count" "rows-free" "row-get" "row-get-int"
                       "col-count" "col-name"]
    "postgres/notify" ["Notification"
                       "notify-listen" "notify-unlisten" "notify-poll"
                       "notification-channel" "notification-payload"]
    "postgres/typed"  ["TRows" "trows-of" "trows-handle"
                       "trows-count" "trows-free"
                       "trow-get" "trow-get-int"
                       "tcol-count" "tcol-name"]
  })
