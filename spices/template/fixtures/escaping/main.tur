;; fixtures/escaping/main.tur -- <%% escape and comment handling.

(defmodule template/fixtures/escaping
  (import template/env    :refer [env-new env-set env-free])
  (import template/render :refer [render-file]))

(load "stdlib/fs.tur")

(defn cstr-eq? [a : cstr b : cstr] : bool
  ```c
  #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)

(defn cstr-free [p : cstr] : void
  ```c
  #include <stdlib.h>
  if (p) free((void *)(intptr_t)p);
  ```)

;; read-file -- the expected output, "" when it cannot be read (stdlib fs/read-text).
(defn read-file [path : cstr] : cstr
  (match (fs/read-text path)
    (Ok text) text
    (Err _) ""))

(defn tap [n : int name : cstr ok : bool] : void
  ```c
  #include <stdio.h>
  printf("%s %lld - %s\n", ok ? "ok" : "not ok",
         (long long)n, (const char *)name);
  ```)

(defn main [] : int
  (let [e (env-new)
        path "fixtures/escaping/template.html.tur"
        expected-path "fixtures/escaping/expected.txt"]
    (do
      (env-set e "val" "hello")
      (let [r (render-file path e)]
        (if (ok? r)
          (let [got (ok-val r)
                expected (read-file expected-path)
                eq? (cstr-eq? got expected)]
            (do (tap 1 "escaping" eq?) (if eq? 0 1)))
          (do (tap 1 "escaping" false) 1))))))
