(defpackage tur-ecs
  :name "tur-ecs"
  :version "0.4.0-E1"
  :description "Entity-Component-System for Turmeric. E1 surface: dense + sparse + tag storages, variadic-looking for-each (up to 8 components) over the row-typed Query value, with/without tag filters, defquery + run-query! functional surface."
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :exports #map{"ecs/entity" ["Entity"
                              "entity-new"
                              "entity-index"
                              "entity-generation"
                              "entity=?"
                              "ENTITY_NIL"]
                "ecs/storage" ["dense-new"
                               "dense-len"
                               "dense-set!"
                               "dense-get"
                               "dense-has?"
                               "dense-free"]
                "ecs/sized-storage" ["SizedDense"
                                     "sized-dense-new"
                                     "sized-dense-len"
                                     "sized-dense-cap"
                                     "sized-dense-set!"
                                     "sized-dense-get"
                                     "sized-dense-has?"
                                     "sized-dense-free"
                                     "sized-dense-zip-len"]
                "ecs/sized-sparse" ["SizedSparse"
                                    "sized-sparse-new"
                                    "sized-sparse-len"
                                    "sized-sparse-set!"
                                    "sized-sparse-get"
                                    "sized-sparse-has?"
                                    "sized-sparse-del!"
                                    "sized-sparse-free"
                                    "sized-sparse-zip-domain"]
                "ecs/sized-tag" ["SizedTag"
                                 "sized-tag-new"
                                 "sized-tag-cap"
                                 "sized-tag-count"
                                 "sized-tag-set!"
                                 "sized-tag-clear!"
                                 "sized-tag-has?"
                                 "sized-tag-free"
                                 "sized-tag-zip-cap"]
                "ecs/sized-zip" ["sized-zip-dense-sparse"
                                 "sized-zip-dense-tag"
                                 "sized-zip-all-three"]
                "ecs/sized-world" ["sized-defworld"
                                   "sized-defworld-mono"
                                   "sized-defworld-copy-into"
                                   "sized-defworld-world-resize"
                                   "sized-defcomponent-accessors"
                                   "sized-defcomponent-accessors-mono"
                                   "sized-defsystem"
                                   "sized-defsystem-scheduled"
                                   "sized-state-new"
                                   "sized-state-free"
                                   "sized-state-copy-into"
                                   "sized-live"
                                   "sized-cap"
                                   "WorldFull"
                                   "sized-spawn!"
                                   "sized-spawn"
                                   "sized-despawn"
                                   "sized-alive?"
                                   "sized-slot-generation"]
                "ecs/sized-query" ["sized-for-each"
                                   "sized-world-tagged?"
                                   "sized-world-untagged?"
                                   "sized-world-sparse-has?"
                                   "sized-world-sparse-get"]
                "ecs/sparse" ["sparse-new"
                              "sparse-len"
                              "sparse-set!"
                              "sparse-get"
                              "sparse-has?"
                              "sparse-del!"
                              "sparse-free"]
                ;; E2d-P6: StorageOps + its Dense/Sparse instances are typeclass
                ;; registrations, not value-level names, so they carry no export
                ;; entries (they reach consumers transitively, like Component). The
                ;; module is listed so the manifest records the source file.
                "ecs/storage-ops" []
                "ecs/tag" ["tag-new"
                           "tag-cap"
                           "tag-count"
                           "tag-set!"
                           "tag-clear!"
                           "tag-has?"
                           "tag-free"]
                "ecs/world" ["defcomponent"
                             "defworld"
                             "defcomponent-cids"
                             "world-alloc-entity!"
                             "world-despawn!"]
                "ecs/query" ["for-each"
                             "for-each1"
                             "for-each2"
                             "for-each3"
                             "for-each4"
                             "for-each5"
                             "for-each6"
                             "for-each7"
                             "for-each8"
                             "world-tagged?"
                             "world-untagged?"
                             "Query"
                             "make-query"
                             "query-world"
                             "defquery"
                             "run-query!"]
                "ecs/system" ["System"
                              "make-system"
                              "system-reads-mask"
                              "system-writes-mask"
                              "system-run-fn"
                              "system-run!"
                              "system-conflicts?"
                              "cid-bit"
                              "defsystem"
                              "defsystem--mask"
                              "defsystem--with-read-caps"
                              "defsystem--with-write-caps"
                              "defsystem--consume-write-caps"]
                "ecs/cap" ["WriteCap"
                           "ReadCap"
                           "make-write-cap"
                           "make-read-cap"
                           "use-cap!"]
                ;; B-track (RM-S2 / gap C2): the sound `frozen` region form. Holds an
                ;; immutable borrow of the owned world across its body, so a despawn
                ;; declared [^unique ^mut w] is statically uncallable inside (TUR-E0200).
                ;; No capability, no minting/aliasing hole. See
                ;; docs/ecs-rms0-stateful-refinement-dogfood.md.
                "ecs/freeze" ["frozen"]
                "ecs/refined-world" ["RGWorld"
                                     "rgworld-new"
                                     "rgworld-spawn!"
                                     "rgworld-despawn!"
                                     "rgworld-alive?"
                                     "rgworld-get-x!"
                                     "rgworld-set-x!"
                                     "rgworld-ent-at"
                                     "for-each-alive!"]
                "ecs/sized-refined" ["ent-at"
                                     "sized-defworld-refined"
                                     "sized-defcomponent-accessor-refined"
                                     "for-each-alive"]
                "ecs/stage" ["stage-run-seq"
                             "stage-run-pair-parallel"
                             "Stage"
                             "stage-new"
                             "stage-add!"
                             "stage-len"
                             "stage-n-waves"
                             "stage-run!"
                             "stage-free!"]
                "ecs/hstage" ["WorldSystem"
                              "make-world-system"
                              "bind-system"
                              "world-system-conflicts?"
                              "HStage"
                              "hstage-new"
                              "hstage-add!"
                              "hstage-len"
                              "hstage-n-waves"
                              "hstage-run!"
                              "hstage-free!"]
                ;; Cross-world systems (X1-X4): per-(World, Component) caps, the
                ;; two-world defsystem surface, the two-worlds-per-system scheduler,
                ;; and the mirror sugar. See docs/guides/ecs-cross-world-guide.md.
                "ecs/xcap" ["XWriteCap"
                            "XReadCap"
                            "make-write-cap"
                            "make-read-cap"
                            "use-cap!"]
                "ecs/xworld" ["sized-defcomponent-accessors-xmono"
                              "box-world"
                              "load-world"
                              "free-world-box"
                              "defworld-box-helpers"]
                "ecs/xsystem" ["XSystem"
                               "make-xsystem"
                               "xsystem-w0-reads"
                               "xsystem-w0-writes"
                               "xsystem-w1-reads"
                               "xsystem-w1-writes"
                               "xsystem-run-fn"
                               "defxsystem"
                               "XSystemN"
                               "make-xsystem-n"
                               "xsystemn-n"
                               "xsystemn-reads"
                               "xsystemn-writes"
                               "xsystemn-run-fn"
                               "xsm-alloc"
                               "xsm-set!"
                               "xsm-get"
                               "xsm-free"
                               "xsystem--with-read-caps"
                               "xsystem--with-write-caps"
                               "xsystem--consume-write-caps"]
                "ecs/xstage" ["BoundXSystem"
                              "make-bound-xsystem"
                              "bind-xsystem"
                              "xsystem-conflicts?"
                              "BoundXSystemN"
                              "make-bound-xsystem-n"
                              "bind-xsystem-n"
                              "XStage"
                              "xstage-new"
                              "xstage-add!"
                              "xstage-add-n!"
                              "xstage-len"
                              "xstage-n-waves"
                              "xstage-run!"
                              "xstage-has-cycle?"
                              "xstage-free!"]
                "ecs/xmirror" ["defmirror"]})
