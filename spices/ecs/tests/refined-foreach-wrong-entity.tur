;; tur-test-flags: --strict-refine
;; tur-test-expect-error: TUR-W0372
;; RE1 negative: `for-each-alive!` proves aliveness of ITS BINDER only. A body
;; that reads a DIFFERENT entity (here `e1`, captured from the enclosing scope
;; -- and in fact despawned) is not covered by the generated guard, so the
;; refined read must stay TUR-W0372 (a hard error under --strict-refine).
(defmodule refined_foreach_wrong_entity
  (export)
  (import ecs/refined-world
    :refer
    [RGWorld
     rgworld-new
     rgworld-spawn!
     rgworld-despawn!
     rgworld-alive?
     rgworld-get-x!
     rgworld-ent-at
     for-each-alive!])
  (defn main [] : int
    (let [^mut w (rgworld-new)
          e0     (rgworld-spawn! w 10)
          e1     (rgworld-spawn! w 20)]
      (let [_ (rgworld-despawn! w e1)]
        (for-each-alive! w 2 e (println (rgworld-get-x! w e1))) ;; NOT the proven binder -> W0372
        0))))
