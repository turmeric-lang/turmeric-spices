;; tur-test-flags: --strict-refine
;; tur-test-expect-error: TUR-W0372
;; RE1 negative: the aliveness-refined accessor `get-x!` will NOT compile against
;; an entity read OUTSIDE a `frozen` region. Without the region, `alive?` (impure)
;; gets a fresh symbol per occurrence, so the guard cannot discharge the crossing.
;; Under --strict-refine the unproven crossing is a hard error.
;;
;; Expected: TUR-W0372 -- no runtime fallback for an impure #reads measure.
(defmodule re1_alive_no_region
  (export)
  (import ecs/entity
    :refer
    [Entity
     entity-new
     entity-index
     entity-generation
     slot-new
     slot->int
     generation-new
     generation->int])
  (defn gens-new []
    #fx{}
    : int
    ```c return (int64_t)(intptr_t)calloc(64, sizeof(int64_t)); ```)
  (defn gen-of [gens : int idx : int]
    #fx{}
    : int
    ```c
    int64_t* g = (int64_t*)(intptr_t)gens; return g[idx];
  ```)
  (defstruct GameWorld [gens : int posx : int])
  (defn alive? [^borrow w : GameWorld e : Entity]
    #reads w
    : bool
    (= (gen-of (.gens w) (slot->int (entity-index e)))
      (generation->int (entity-generation e))))
  (defn get-x! [^borrow w : GameWorld e : #refine{ x : Entity | (alive? w x) }] : int
    (.posx w))
  (defn main [] : int
    (let [^mut w (GameWorld (gens-new) 42)
          e      (entity-new (slot-new 0) (generation-new 0))]
      (let [pos (if (alive? w e) ;; NO (frozen w ...) -> not congruent
                  (get-x! w e) ;; MUST NOT prove
                  -1)]
        (println pos)
        0))))
