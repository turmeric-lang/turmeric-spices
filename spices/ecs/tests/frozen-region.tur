;; B-track (RM-S2): the sound `frozen` region form. Inside (frozen w ...) an
;; immutable borrow of the owned world w is held, so a despawn declared
;; [^unique ^mut w] is statically uncallable there (TUR-E0200). Read-only
;; accessors (^borrow w) still work. After the region, despawn is allowed.
;;
;; Expected output:
;;   30
;;   despawned
;;   ok
(defmodule frozen_region_test
  (export)
  (import ecs/entity :refer [Entity entity-new slot-new generation-new])
  (import ecs/freeze :refer [frozen])
  (defstruct World [a : int b : int])
  ;; despawn requires EXCLUSIVE mutable access to the world.
  (defn despawn! [^unique ^mut w : World e : Entity] : nil
    ```c
    (void)w; (void)e;
  ```)
  ;; read-only accessors borrow the world.
  (defn get-a [^borrow w : World] #fx{} : int (.a w))
  (defn get-b [^borrow w : World] #fx{} : int (.b w))
  (defn main [] : int
    (let [^mut w (World 10 20)
          e      (entity-new (slot-new 0) (generation-new 0))]
      ;; A multi-read frozen region returning a computed value. No despawn is
      ;; callable in here -- w is borrowed for the region body.
      (let [sum (frozen w
                  (let [x (get-a w)
                        y (get-b w)]
                    (+ x y)))]
        (do
          (println sum) ;; 30
          ;; After the region the borrow is released: despawn is allowed.
          (despawn! w e)
          (println "despawned")
          (println "ok")
          0))))) ;; end defmodule frozen_region_test
