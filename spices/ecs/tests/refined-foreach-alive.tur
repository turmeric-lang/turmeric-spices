;; tur-test-flags: --strict-refine
;; RE1 (c) COMPLETE: the ergonomic `for-each-alive!` macro. One macro generates
;; the recursive loop, the frozen re-borrow, and the aliveness guard; the user's
;; refined `rgworld-get-x!` read is spliced as the body and its crossing
;; discharges PER-ENTITY (this file compiles under --strict-refine only because
;; it does). Requires the compiler-side macro-expansion path walk
;; (refine_note_macro_expansion; see turmeric docs/archive/
;; macro-generated-refined-crossings-do-not-discharge.md).
;; Spawns 3 (x = 10/20/30), despawns the middle one, prints x for each alive
;; entity. Expected output: 10, 30 (slot 1 skipped).
(defmodule refined_foreach_alive
  (export)
  (import ecs/refined-world
    :refer
    [RGWorld
     rgworld-new
     rgworld-spawn!
     rgworld-despawn!
     rgworld-alive?
     rgworld-get-x!
     rgworld-ent-at
     for-each-alive!])
  ;; Sum what the loop visits so the exit status depends on it. The
  ;; `Expected output:` header said "10, 30 (slot 1 skipped)" and nothing
  ;; checked it -- if the guard stopped skipping the despawned slot, or stopped
  ;; visiting the live ones, the file still passed. The counter lives at C file
  ;; scope via a __tur_include__ marker -- `long long`, not int64_t, since the
  ;; hoist lands the declaration above <stdint.h> (one declaration only; the hoist emits
  ;; one per marker).
  (defn __acc-add [n : int]
    #fx{Unsafe}
    : void
    ```c
    /* __tur_include__: static long long __re_acc = 0; */
  __re_acc += n;
  ```)
  (defn __acc-get []
    #fx{Unsafe}
    : int
    ```c
    return __re_acc;
  ```)
  (defn main [] : int
    (let [^mut w (rgworld-new)
          e0     (rgworld-spawn! w 10)
          e1     (rgworld-spawn! w 20)
          e2     (rgworld-spawn! w 30)]
      (let [_ (rgworld-despawn! w e1)]
        (for-each-alive! w
          3
          e
          (let [x (rgworld-get-x! w e)] (println x) (unsafe (__acc-add x))))
        ;; 10 + 30; e1 was despawned, so 20 must not be counted.
        (if (= (unsafe (__acc-get)) 40) 0 1)))))
