;; GEN-V1 regression: `defsystem-world` gives an UNSIZED system body its
;; world at the world's real type, so the cap-gated typed accessors are
;; reachable from a scheduler-runnable System.
;;
;; `defsystem` binds `w : int` (it is never told which world it runs
;; against), so a body wanting `set-Pos!` had to bridge with
;; `(:: w GameWorld)`. Since worlds became by-value aggregates that
;; bridge is TUR-E0295, which left a plain `defsystem` body with no route
;; to its own world -- see the resolved report
;; `docs/ecs-unsized-defsystem-cannot-reach-its-world.md`. This macro is
;; the unsized counterpart of `sized-defsystem-scheduled`: typed impl +
;; int-carrier wrapper + System value.
;;
;; Verifies three things at once: the body reaches the world through the
;; typed accessor (no `::` bridge anywhere), the cap-binding /
;; auto-consume lowering carries over from `defsystem` unchanged, and the
;; write lands in the shared dense storage so it is observable from the
;; caller's own copy of the world after `system-run!`.
;;
;; Expected output:
;;   42   -- Pos.x written by physics through set-Pos!
;;   7    -- Pos.y written by physics through set-Pos!
;;   ok
(defmodule defsystem_world_test
  (export)
  (import ecs/entity :refer [Slot slot-new])
  (import ecs/storage :refer [dense-new])
  (import ecs/world
    :refer
    [defcomponent defworld defcomponent-accessors defcomponent-cids])
  (import ecs/system :refer [System make-system system-run! defsystem-world])
  ;; `ecs/xworld` re-exports `ecs/xcap`'s `use-cap!` / `make-*-cap`, which
  ;; shadow `ecs/cap`'s same-named component-only versions. Import it
  ;; BEFORE `ecs/cap` so the component-only caps the accessors want win.
  (import ecs/xworld :refer [defworld-box-helpers])
  (import ecs/cap
    :refer
    [WriteCap ReadCap make-write-cap make-read-cap use-cap!])
  (defstruct Pos [x : int y : int])
  (defstruct Vel [x : int y : int])
  (defcomponent Pos)
  (defcomponent Vel)
  (defworld GameWorld [Pos Vel])
  (defcomponent-accessors GameWorld Pos)
  (defcomponent-accessors GameWorld Vel)
  (defcomponent-cids [Pos Vel])
  ;; box-GameWorld / load-GameWorld / free-GameWorld-box. `defsystem-world`
  ;; names `load-GameWorld` in its expansion; the other two are the
  ;; caller's side of handing a world to `system-run!`.
  (defworld-box-helpers GameWorld)
  ;; The body writes Pos through the typed accessor. `w` is bound at
  ;; GameWorld, and Pos-write-cap is in scope from the :writes vector and
  ;; auto-consumed at body end -- both exactly as `defsystem` does it.
  (defsystem-world physics
    GameWorld
    [Pos] ;; :reads
    [Pos] ;; :writes
    (set-Pos! Pos-write-cap w (slot-new 0) (make-struct Pos 42 7)))
  (defn main [] : int
    (let [w  (make-struct GameWorld
               (vec-new)
               (:: (dense-new) (Storage Pos))
               (:: (dense-new) (Storage Vel)))
          wp (box-GameWorld w)]
      (system-run! physics wp)
      ;; Re-load the boxed world to read the write back. `box-GameWorld`
      ;; consumed the unique `w`, and the box's storage fields are the same
      ;; int64 handles, so the loaded copy observes the system's write.
      (let [w2                                         : GameWorld
            (load-GameWorld wp)                        rc
            (:: (make-read-cap Pos-cid) (ReadCap Pos)) p
            (get-Pos rc w2 (slot-new 0))]
        (println (.x p)) ;; 42
        (println (.y p)) ;; 7
        (free-GameWorld-box wp)
        (if (and (= (.x p) 42) (= (.y p) 7))
          (do (println "ok") 0)
          (do (println "FAIL") 1)))))) ;; end defmodule defsystem_world_test
