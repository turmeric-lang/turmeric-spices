;; tur-test-flags: --strict-refine
;; tur-test-expect-error: TUR-E0200
;; RE1 promotion, negative: GameWorld-despawn! takes the world ^unique ^mut,
;; so calling it INSIDE a region that holds an immutable borrow of w is a
;; compile error (active borrow exists) -- the lockout that makes trusting
;; the aliveness guard sound, now on the real stack.
(defmodule refined_stack_despawn_in_region
  (export)
  (import ecs/sized-storage :refer [SizedDense])
  (import ecs/sized-world :refer [sized-defworld-mono sized-spawn!])
  (import ecs/sized-refined :refer [sized-defworld-refined])
  (import ecs/entity :refer [Entity])
  (defopaque Pos :int)
  (sized-defworld-mono GameWorld (Static 8) [Pos])
  (sized-defworld-refined GameWorld)
  (defn main [] : int
    (let [^mut w (make-GameWorld 8)
          e0     (sized-spawn! (.state w))]
      (let [__f (& w)] (GameWorld-despawn! w e0)) ;; borrow live -> TUR-E0200
      0))) ;; end module
