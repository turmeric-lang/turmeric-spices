;; tur-test-flags: --strict-refine
;; tur-test-expect-error: TUR-W0372
;; RE1 (c) negative: without the `alive?` guard the loop body's refined accessor
;; does not discharge -- the loop guard is load-bearing, exactly as for a single
;; read. Under --strict-refine the unproven crossing is a hard error.
(defmodule refined_loop_no_guard
  (export)
  (import ecs/refined-world :refer [RGWorld rgworld-new rgworld-get-x!])
  (import ecs/entity :refer [Entity entity-new slot-new generation-new])
  (defn ent-at [i : int] : Entity (entity-new (slot-new i) (generation-new 0)))
  (defn sum-bad [^borrow w : RGWorld i : int cap : int acc : int] : int
    (let [__f (& w)]
      (if (< i cap)
        (sum-bad w (+ i 1) cap (+ acc (rgworld-get-x! w (ent-at i)))) ;; NO guard
        acc)))
  (defn main [] : int
    (let [^mut w (rgworld-new)]
      (println (sum-bad w 0 3 0))
      0)))
