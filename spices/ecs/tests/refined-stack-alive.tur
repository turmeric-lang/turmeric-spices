;; tur-test-flags: --strict-refine
;; RE1 promotion, positive: the strict-aliveness accessor family on the REAL
;; sized-world stack (sized-defworld-mono + sized-defcomponent-accessors-mono).
;; sized-defworld-refined emits GameWorld-alive? (#reads w) + GameWorld-despawn!
;; (^unique ^mut); sized-defcomponent-accessor-refined emits get-Pos! whose
;; entity param is refined on (GameWorld-alive? w x). A guarded read inside a
;; frozen region PROVES (this file compiles under --strict-refine only because
;; it does) and runs. Spawns 2 (Pos 10/20), despawns e1: e0 reads 10, e1's
;; guard takes the else arm -> -1.
;; Expected output: 10, -1
(defmodule refined_stack_alive
  (export)
  (import ecs/sized-storage :refer [SizedDense])
  (import ecs/sized-world
    :refer
    [sized-defworld-mono sized-defcomponent-accessors-mono sized-spawn!])
  (import ecs/sized-refined
    :refer
    [sized-defworld-refined sized-defcomponent-accessor-refined])
  (import ecs/cap
    :refer
    [WriteCap ReadCap make-write-cap make-read-cap use-cap!])
  (import ecs/entity :refer [Entity entity-index])
  (defopaque Pos :int)
  (sized-defworld-mono GameWorld (Static 8) [Pos])
  (sized-defcomponent-accessors-mono GameWorld Pos)
  (sized-defworld-refined GameWorld)
  (sized-defcomponent-accessor-refined GameWorld Pos)
  (def Pos-cid 0)
  (defn main [] : int
    (let [^mut w (make-GameWorld 8)
          e0     (sized-spawn! (.state w))
          e1     (sized-spawn! (.state w))]
      ;; seed Pos via the forgiving cap-gated setter (write path unchanged)
      (let [c0 (:: (make-write-cap Pos-cid) (WriteCap Pos))]
        (set-Pos! c0 w (entity-index e0) (:: 10 :Pos))
        (use-cap! c0))
      (let [c1 (:: (make-write-cap Pos-cid) (WriteCap Pos))]
        (set-Pos! c1 w (entity-index e1) (:: 20 :Pos))
        (use-cap! c1))
      (let [_  (GameWorld-despawn! w e1)
            r0 (:: (make-read-cap Pos-cid) (ReadCap Pos))
            r1 (:: (make-read-cap Pos-cid) (ReadCap Pos))]
        (let [__f (& w)]
          (println (:: (if (GameWorld-alive? w e0)
                         (get-Pos! r0 w e0)
                         (:: -1 :Pos))
                     :int))
          (println (:: (if (GameWorld-alive? w e1)
                         (get-Pos! r1 w e1)
                         (:: -1 :Pos))
                     :int)))
        0)))) ;; end module
