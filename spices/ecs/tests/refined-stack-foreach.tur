;; tur-test-flags: --strict-refine
;; RE1 promotion: for-each-alive on the REAL stack. One macro generates the
;; recursive loop, the frozen re-borrow, and the GameWorld-alive? guard; the
;; body's refined get-Pos! discharges PER-ENTITY (compiles under
;; --strict-refine only because it does). Spawns 3 (Pos 10/20/30), despawns
;; the middle one, prints Pos for each alive entity.
;; Expected output: 10, 30 (slot 1 skipped).
(defmodule refined_stack_foreach
  (export)
  (import ecs/sized-storage :refer [SizedDense])
  (import ecs/sized-world
    :refer
    [sized-defworld-mono sized-defcomponent-accessors-mono sized-spawn!])
  (import ecs/sized-refined
    :refer
    [sized-defworld-refined
     sized-defcomponent-accessor-refined
     for-each-alive
     ent-at])
  (import ecs/cap
    :refer
    [WriteCap ReadCap make-write-cap make-read-cap use-cap!])
  (import ecs/entity :refer [Entity entity-index])
  (defopaque Pos :int)
  (sized-defworld-mono GameWorld (Static 8) [Pos])
  (sized-defcomponent-accessors-mono GameWorld Pos)
  (sized-defworld-refined GameWorld)
  (sized-defcomponent-accessor-refined GameWorld Pos)
  (def Pos-cid 0)
  (defn main [] : int
    (let [^mut w (make-GameWorld 8)
          e0     (sized-spawn! (.state w))
          e1     (sized-spawn! (.state w))
          e2     (sized-spawn! (.state w))]
      (let [c0 (:: (make-write-cap Pos-cid) (WriteCap Pos))]
        (set-Pos! c0 w (entity-index e0) (:: 10 :Pos))
        (use-cap! c0))
      (let [c1 (:: (make-write-cap Pos-cid) (WriteCap Pos))]
        (set-Pos! c1 w (entity-index e1) (:: 20 :Pos))
        (use-cap! c1))
      (let [c2 (:: (make-write-cap Pos-cid) (WriteCap Pos))]
        (set-Pos! c2 w (entity-index e2) (:: 30 :Pos))
        (use-cap! c2))
      (let [_  (GameWorld-despawn! w e1)
            rc (:: (make-read-cap Pos-cid) (ReadCap Pos))]
        (for-each-alive GameWorld w 3 e (println (:: (get-Pos! rc w e) :int)))
        0)))) ;; end module
