;; tur-test-flags: --strict-refine
;; tur-test-expect-error: TUR-W0372
;; RE1 negative: the module's refined accessor read WITHOUT a frozen region does
;; not discharge (impure alive? -> fresh symbol). --strict-refine -> hard error.
;; Expected: TUR-W0372 -- no runtime fallback for an impure #reads measure.
(defmodule refined_module_no_region
  (export)
  (import ecs/refined-world
    :refer
    [RGWorld rgworld-new rgworld-spawn! rgworld-alive? rgworld-get-x!])
  (defn main [] : int
    (let [^mut w (rgworld-new)
          e      (rgworld-spawn! w 42)]
      (let [x (if (rgworld-alive? w e) ;; NO frozen region
                (rgworld-get-x! w e) ;; MUST NOT prove
                -1)]
        (println x)
        0))))
