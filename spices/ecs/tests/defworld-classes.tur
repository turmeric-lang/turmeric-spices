;; ECB step 3: `defworld-classes` collapses the `1 + 2N` declaration burden
;; (one `defworld`, one `defcomponent-class` per component, one
;; `defcomponent-class-instance` per (world, component) pair) into a single
;; form, by deriving the class + instance set from the component vector the
;; world already carries.
;;
;; This is deliberately NOT folded into `defworld`: the instance expansion
;; emits cap-mint helpers naming `ecs/cap` symbols at the call site, so
;; folding it in would break every `defworld` user that does not touch the
;; typeclass surface. See the macro's docstring in ecs/world.
;;
;; Expected output: 7 9 ok
(defmodule defworld_classes_test
  (export)
  (import ecs/entity :refer [entity-index])
  (import ecs/storage :refer [dense-new dense-set! dense-get])
  (import ecs/world :refer [defcomponent defworld-classes world-alloc-entity!])
  (import ecs/cap
    :refer
    [WriteCap ReadCap make-write-cap make-read-cap use-cap!])
  (defstruct Pos [x : int])
  (defstruct Vel [dx : int])
  (defcomponent Pos)
  (defcomponent Vel)
  ;; One declaration instead of five: the world struct, HasPos + HasVel, and
  ;; the GameWorld instance of each.
  (defworld-classes GameWorld [Pos Vel])
  (defn main [] : int
    (let [w (make-struct GameWorld
              (vec-new)
              (:: (dense-new) (Storage Pos))
              (:: (dense-new) (Storage Vel)))
          e (world-alloc-entity! (.gens w))]
      (dense-set! (.Pos w) (entity-index e) (make-struct Pos 7))
      (dense-set! (.Vel w) (entity-index e) (make-struct Vel 9))
      ;; The Has<Comp> method dispatches on the receiver and hands back the
      ;; world's storage field -- for BOTH components, from one declaration.
      (let [ps                                    : (Storage Pos)
            (:: (Pos-storage-of w) (Storage Pos)) vs
            : (Storage Vel)                       (:: (Vel-storage-of w)
                                                    (Storage Vel))
            p                                     : Pos
            (dense-get ps (entity-index e))       v
            : Vel                                 (dense-get vs
                                                    (entity-index e))]
        (println (.x p))
        (println (.dx v)))
      ;; The per-(World, Comp) cap minters come from the same expansion.
      ;; WriteCap is :linear, so it must be consumed exactly once; ReadCap is
      ;; an ordinary opaque and just has to be correctly typed.
      (use-cap! (mint-GameWorld-Pos-write-cap 0))
      (let [rc                              : (ReadCap Vel)
            (mint-GameWorld-Vel-read-cap 1)]
        (println "ok"))
      0))) ;; end defmodule defworld_classes_test
