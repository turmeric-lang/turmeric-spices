;;; ecs/entity -- generationally-versioned opaque Entity handle.
;;;
;;; An Entity packs a 32-bit index and a 32-bit generation counter into a
;;; single 64-bit int (low 32 = index, high 32 = generation). Generation
;;; tracking is what lets dense storage reuse despawned slots while still
;;; rejecting stale handles at runtime.
;;;
;;; RE0: the public surface uses real handle types rather than the bare
;;; `:int` stand-ins the module shipped with. `Entity` is the packed
;;; handle; `Slot` is a raw storage slot index (what `entity-index`
;;; unpacks and what `for-each` / dense storage index by); `Generation`
;;; is a per-slot version counter. These are distinct `defopaque` newtypes
;;; over `:int`, so the type checker rejects mixing them -- passing a
;;; `Slot` where an `Entity` is expected is a compile error rather than a
;;; silently-accepted int. `slot->int` / `generation->int` are the escape
;;; hatches for the terminal cases (printing, indexing an int-keyed
;;; storage) that genuinely want the raw machine integer back.
;;;
;;; Since: E0
;;; RE0: real handle types on the public surface (Entity / Slot / Generation).
(defmodule ecs/entity
  (export Entity
    Slot
    Generation
    entity-new
    entity-index
    entity-generation
    entity=?
    ENTITY_NIL
    slot->int
    generation->int
    slot-new
    generation-new)
  ;;; Entity -- opaque generational handle (packed index + generation).
  ;;; Since: E0
  (defopaque Entity :int)
  ;;; Slot -- a raw storage slot index, distinct from a packed `Entity`.
  ;;; `entity-index` unpacks an `Entity` to its `Slot`; dense/sparse storage
  ;;; and `for-each` bind slot indices, not entities.
  ;;; Since: RE0
  (defopaque Slot :int)
  ;;; Generation -- a per-slot version counter, distinct from a slot index.
  ;;; `entity-generation` unpacks an `Entity` to its `Generation`; the world
  ;;; bumps a slot's generation on despawn so stale handles fail the
  ;;; aliveness check.
  ;;; Since: RE0
  (defopaque Generation :int)
  ;;; ENTITY_NIL -- sentinel for "no such entity". Index 0xFFFFFFFF, gen 0.
  (def ENTITY_NIL (:: 4294967295 :Entity))
  ;;; slot->int -- recover the raw machine integer behind a `Slot`.
  ;;;
  ;;; Parameters:
  ;;;   s -- the slot index
  ;;;
  ;;; Returns:
  ;;;   The underlying `:int` slot index -- for printing or indexing an
  ;;;   int-keyed storage that has not been lifted to `Slot`.
  ;;;
  ;;; Example:
  ;;;   (slot->int (entity-index e))  ; => 0
  ;;;
  ;;; Since: RE0
  (defn slot->int [s : Slot] : int (:: s :int))
  ;;; generation->int -- recover the raw machine integer behind a `Generation`.
  ;;;
  ;;; Parameters:
  ;;;   g -- the generation counter
  ;;;
  ;;; Returns:
  ;;;   The underlying `:int` generation value -- for printing or comparison
  ;;;   against a raw counter.
  ;;;
  ;;; Example:
  ;;;   (generation->int (entity-generation e))  ; => 1
  ;;;
  ;;; Since: RE0
  (defn generation->int [g : Generation] : int (:: g :int))
  ;;; slot-new -- tag a raw machine integer as a `Slot`.
  ;;;
  ;;; Parameters:
  ;;;   i -- the raw slot index
  ;;;
  ;;; Returns:
  ;;;   The `Slot` newtype wrapping i.
  ;;;
  ;;; Example:
  ;;;   (slot-new 3)  ; => Slot 3
  ;;;
  ;;; Since: RE0
  (defn slot-new [i : int] : Slot (:: i Slot))
  ;;; generation-new -- tag a raw machine integer as a `Generation`.
  ;;;
  ;;; Parameters:
  ;;;   g -- the raw generation counter
  ;;;
  ;;; Returns:
  ;;;   The `Generation` newtype wrapping g.
  ;;;
  ;;; Example:
  ;;;   (generation-new 0)  ; => Generation 0
  ;;;
  ;;; Since: RE0
  (defn generation-new [g : int] : Generation (:: g Generation))
  ;;; entity-new -- pack (index, generation) into an Entity.
  ;;;
  ;;; Parameters:
  ;;;   idx -- entity slot index
  ;;;   gen -- generation counter
  ;;;
  ;;; Returns:
  ;;;   Packed Entity handle.
  ;;;
  ;;; Example:
  ;;;   (entity-new (slot-new 3) (generation-new 0))
  ;;;
  ;;; Since: E0
  ;;; RE0: takes `Slot` / `Generation`, returns `Entity`.
  (defn entity-new [idx : Slot gen : Generation] : Entity
    (:: (bit-or (bit-shl (:: gen :int) 32) (bit-and (:: idx :int) 4294967295))
      Entity))
  ;;; entity-index -- unpack the slot index.
  ;;;
  ;;; Parameters:
  ;;;   e -- the packed entity handle
  ;;;
  ;;; Returns:
  ;;;   The `Slot` this entity names.
  ;;;
  ;;; Example:
  ;;;   (entity-index e)  ; => Slot
  ;;;
  ;;; Since: E0
  ;;; RE0: takes `Entity`, returns `Slot`.
  (defn entity-index [e : Entity] : Slot
    (:: (bit-and (:: e :int) 4294967295) Slot))
  ;;; entity-generation -- unpack the generation counter.
  ;;;
  ;;; Parameters:
  ;;;   e -- the packed entity handle
  ;;;
  ;;; Returns:
  ;;;   The `Generation` this entity carries.
  ;;;
  ;;; Since: E0
  ;;; RE0: takes `Entity`, returns `Generation`.
  (defn entity-generation [e : Entity] : Generation
    (:: (bit-and (bit-shr (:: e :int) 32) 4294967295) Generation))
  ;;; entity=? -- structural equality on Entity handles.
  ;;;
  ;;; Parameters:
  ;;;   a -- first entity handle
  ;;;   b -- second entity handle
  ;;;
  ;;; Returns:
  ;;;   true when a and b are the same packed handle.
  ;;;
  ;;; Since: E0
  ;;; RE0: takes `Entity` on both sides.
  (defn entity=? [a : Entity b : Entity] : bool (= (:: a :int) (:: b :int)))) ;; end defmodule ecs/entity
