;; Raw-Turmeric integrate -- no ECS, flat arrays, Turmeric-level loop.
;;
;; This is the variant that makes the ECS number interpretable. Comparing
;; the ECS surface straight against C conflates two different costs:
;;
;;   ecs - manual  =  what the ECS abstraction costs
;;   manual - C    =  what Turmeric's codegen costs on the same loop
;;
;; Without this row, a slow `for-each` and a slow backend look identical.
;; Same workload, same arithmetic, same checksum as every other variant.
(defmodule integrate_manual_bench
  (export)
  (def N 100000)
  (def FRAMES 100)
  (def DT 0.25)
  (defn i->f [i : int] : float
    ```c
    return (double)i;
  ```)
  (defn checksum [sum : float] : int
    ```c
    return (int64_t)(sum * 100.0);
  ```)
  (defn now-us [] : int
    ```c
    #include <time.h>
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
  ```)
  ;; Flat float buffers. `:ptr<void>` rather than :int -- these are opaque
  ;; handles to a specific kind of thing, and CLAUDE.md's no-lazy-:int rule
  ;; applies to benchmark code too.
  (defn buf-new [n : int] : ptr<void>
    ```c
    #include <stdlib.h>
  return calloc((size_t)n, sizeof(double));
  ```)
  (defn buf-free [p : ptr<void>] : nil
    ```c
    #include <stdlib.h>
  free(p);
  ```)
  (defn buf-get [p : ptr<void> i : int] : float
    ```c
    return ((double *)p)[i];
  ```)
  (defn buf-set! [p : ptr<void> i : int v : float] : nil
    ```c
    ((double *)p)[i] = v;
  ```)
  (defn main [] : int
    (let [px (buf-new N)
          py (buf-new N)
          vx (buf-new N)
          vy (buf-new N)]
      (do
        (let [^mut i 0]
          (while (< i N)
            (let [f (i->f i)]
              (buf-set! px i (/ f 8.0))
              (buf-set! py i (/ f 4.0))
              (buf-set! vx i 1.5)
              (buf-set! vy i -0.5))
            (set! i (+ i 1))))
        (let [t0 (now-us)]
          (do
            (let [^mut frame 0]
              (while (< frame FRAMES)
                (do
                  (let [^mut i 0]
                    (while (< i N)
                      (do
                        (buf-set! px i (+ (buf-get px i) (* (buf-get vx i) DT)))
                        (buf-set! py i (+ (buf-get py i) (* (buf-get vy i) DT))))
                      (set! i (+ i 1))))
                  (set! frame (+ frame 1)))))
            (let [t1       (now-us)
                  ^mut sum 0.0
                  ^mut j   0]
              (do
                (while (< j N)
                  (set! sum (+ sum (+ (buf-get px j) (buf-get py j))))
                  (set! j (+ j 1)))
                (println (- t1 t0))
                (println (checksum sum))
                (buf-free px)
                (buf-free py)
                (buf-free vx)
                (buf-free vy)
                0)))))))) ;; end defmodule integrate_manual_bench
