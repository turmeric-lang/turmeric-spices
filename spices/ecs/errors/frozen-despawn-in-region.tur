;; B-track (RM-S2) negative: a despawn INSIDE a frozen region must fail to
;; elaborate. (frozen w ...) holds an immutable borrow of w for the region
;; body; passing w as ^unique ^mut to despawn! while that borrow is live is
;; rejected.
;;
;; Expected: TUR-E0200 -- cannot pass 'w' as ^unique ^mut -- active borrow exists.
(defmodule frozen_despawn_in_region_test
  (export)
  (import ecs/entity :refer [Entity entity-new slot-new generation-new])
  (import ecs/freeze :refer [frozen])
  (defstruct World [n : int])
  (defn despawn! [^unique ^mut w : World e : Entity] : nil
    ```c
    (void)w; (void)e;
  ```)
  (defn get-n [^borrow w : World] #fx{} : int (.n w))
  (defn main [] : int
    (let [^mut w (World 3)
          e      (entity-new (slot-new 0) (generation-new 0))]
      (let [r (frozen w
                ;; ERROR: despawn inside the frozen region -- w is borrowed.
                (do (despawn! w e) (get-n w)))]
        (do (println r) 0))))) ;; end defmodule frozen_despawn_in_region_test
