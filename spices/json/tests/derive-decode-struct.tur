;; derive-json emits both EncodeJson and DecodeJson for a defstruct. Roundtrip a
;; JSON object into a User struct via the macro-emitted DecodeJson instance,
;; then re-encode through the EncodeJson side.
;;
;; The `Expected:` output this used to print and never check is asserted
;; below; main returns run-all-status instead of a hardcoded 0.
(defmodule derive_decode_struct_test
  (export)
  (import json/encode :refer [derive-json])
  (import json/decode :refer [json-parse-doc json-doc-free json-doc-root])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defn __int->cstr [n : int]
    #fx{Unsafe}
    : cstr
    ```c char *b = (char*)malloc(24); snprintf(b, 24, "%lld", (long long)n); return b; ```)
  (defn __cat4 [a : cstr b : cstr c : cstr d : cstr]
    #fx{Unsafe}
    : cstr
    ```c
    size_t la = a?strlen(a):0, lb = b?strlen(b):0, lc = c?strlen(c):0, ld = d?strlen(d):0;
  char *o = (char*)malloc(la+lb+lc+ld+1);
  if (a) memcpy(o, a, la);
  if (b) memcpy(o+la, b, lb);
  if (c) memcpy(o+la+lb, c, lc);
  if (d) memcpy(o+la+lb+lc, d, ld);
  o[la+lb+lc+ld] = '\0';
  return o;
  ```)
  (defstruct User [id : int name : cstr])
  (derive-json User (id int) (name cstr))
  (defn main [] : int
    (let [doc  (unsafe (json-parse-doc "{\"id\":42,\"name\":\"alice\"}"))
          root (unsafe (json-doc-root doc))
          user (ok-val (:: (decode-json doc root) (Result User cstr)))]
      (describe "json derive-json -- DecodeJson into a defstruct"
        (it "decodes the int field into the struct" (assert-eq 42 (.id user)))
        (it "decodes the string field into the struct"
          (assert-true (cstr-eq? "alice" (.name user))))
        ;; Re-encoding must reproduce the input byte for byte, which is the
        ;; property that makes derive-json's two instances each other's inverse.
        (it "re-encodes to the JSON it was decoded from"
          (assert-true (cstr-eq? "{\"id\":42,\"name\":\"alice\"}"
                         (encode-json user)))))
      (unsafe (json-doc-free doc))
      (run-all-status))))
