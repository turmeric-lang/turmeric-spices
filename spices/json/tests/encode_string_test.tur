;; tests/encode_string_test.tur -- encode-json-string owned-String serializer.
;;
;; encode-json-string is the owned-return counterpart of the EncodeJson `encode-json` method:
;; it serializes any Encodable value to a String the caller releases, rather
;; than a malloc'd cstr the caller frees.
(defmodule json/tests/encode-string
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  (import test/runner :refer [run-all-status])
  (import json/encode :refer [encode-json-string derive-json])
  (import json/ownstr :refer [String to-cstr release str-len])
  (defstruct Point [x : int y : int])
  (derive-json Point (x int) (y int))
  (defn seq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  ;; encode an int to an owned String, compare, release.
  (defn int-enc-is? [x : int want : cstr] : bool
    (let [s (encode-json-string x)
          r (seq? (to-cstr s) want)]
      (do (release s) r)))
  ;; encode a derived struct to an owned String, compare, release.
  (defn point-enc-is? [p : Point want : cstr] : bool
    (let [s (encode-json-string p)
          r (seq? (to-cstr s) want)]
      (do (release s) r)))
  (defn main [] : int
    (do
      (describe "json/encode-string"
        (it "encodes an int to an owned String"
          (assert-true (int-enc-is? 42 "42")))
        (it "encodes a derived struct to an owned String"
          (assert-true (point-enc-is? (make-struct Point 1 2)
                         "{\"x\":1,\"y\":2}"))))
      (run-all-status)))) ;; end module
