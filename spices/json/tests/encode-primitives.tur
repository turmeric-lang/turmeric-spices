;; The `Expected:` output this used to print and never check is asserted
;; below; main returns run-all-status instead of a hardcoded 0.
;; P2a smoke: EncodeJson primitive instances produce well-formed JSON fragments.
(defmodule encode_primitives_test
  (export)
  (import json/encode)
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defn main [] : int
    (describe "json EncodeJson -- primitive instances"
      (it "encodes an int bare" (assert-true (cstr-eq? "42" (encode-json 42))))
      (it "encodes a bool as a JSON literal, not 1/0"
        (assert-true (cstr-eq? "true" (encode-json true))))
      ;; The newline must come back as the two-character escape \n, quoted --
      ;; a raw newline inside a JSON string is invalid.
      (it "quotes a string and escapes control characters"
        (assert-true (cstr-eq? "\"hello\\nworld\"" (encode-json "hello\nworld")))))
    (run-all-status)))
