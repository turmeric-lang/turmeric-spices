;; The `Expected:` output this used to print and never check is asserted
;; below; main returns run-all-status instead of a hardcoded 0.
;; P2a DecodeJson -- pull typed primitives out of a JSON object.
(defmodule decode_primitives_test
  (export)
  (import json/decode
    :refer
    [json-parse-doc json-doc-free json-doc-root json-obj-get])
  (import json/encode)
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defn main [] : int
    (let [doc      (unsafe (json-parse-doc "{\"id\":42,\"name\":\"alice\",\"active\":true}"))
          root     (unsafe (json-doc-root doc))
          id-off   (unsafe (json-obj-get doc root "id"))
          name-off (unsafe (json-obj-get doc root "name"))
          act-off  (unsafe (json-obj-get doc root "active"))]
      (describe "json DecodeJson -- primitives out of an object"
        (it "decodes an int field"
          (assert-eq 42
            (ok-val (:: (decode-json doc id-off) (Result int cstr)))))
        (it "decodes a string field"
          (assert-true (cstr-eq? "alice"
                         (ok-val (:: (decode-json doc name-off)
                                   (Result cstr cstr))))))
        (it "decodes a bool field"
          (assert-true (ok-val (:: (decode-json doc act-off) (Result bool cstr))))))
      (unsafe (json-doc-free doc))
      (run-all-status))))
