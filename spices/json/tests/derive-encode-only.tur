;; derive-json-encode emits only the EncodeJson instance. Verifies the
;; encode-only direction of the U2 :only [:encode] surface from the
;; spices-type-features uplift plan.
;;
;; The `Expected:` output this used to print and never check is now
;; asserted below; main returns run-all-status rather than a hardcoded 0.
(defmodule derive_encode_only_test
  (export)
  (import json/encode :refer [derive-json-encode])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defstruct LogEntry [level : cstr msg : cstr])
  (derive-json-encode LogEntry (level cstr) (msg cstr))
  (defn main [] : int
    (describe "json derive-json-encode -- EncodeJson only"
      (it "emits an object with both fields"
        (assert-true (cstr-eq? "{\"level\":\"info\",\"msg\":\"hi\"}"
                       (encode-json (make-struct LogEntry "info" "hi"))))))
    (run-all-status)))
