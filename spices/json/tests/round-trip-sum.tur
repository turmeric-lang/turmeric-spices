;; The `Expected:` output this used to print and never check is asserted
;; below; main returns run-all-status instead of a hardcoded 0.
;; Round-trip for derive-json-sum: decode an externally-tagged object into a
;; defdata sum, then re-encode it.
(defmodule round_trip_sum_test
  (export)
  (import json/encode :refer [derive-json-sum])
  (import json/decode :refer [json-parse-doc json-doc-free json-doc-root])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defdata ^copy Cmd [] (Move :cstr :int) (Quit))
  (derive-json-sum Cmd (Move (dir cstr) (steps int)) (Quit))
  (defn round-trip [s : cstr] : cstr
    (let [doc  (unsafe (json-parse-doc s))
          root (unsafe (json-doc-root doc))
          cmd  (ok-val (:: (decode-json doc root) (Result Cmd cstr)))
          out  (encode-json cmd)]
      (unsafe (json-doc-free doc))
      out))
  (defn main [] : int
    (describe "json derive-json-sum -- round-trip"
      (it "round-trips a multi-field variant unchanged"
        (assert-true (cstr-eq? "{\"Move\":{\"dir\":\"north\",\"steps\":2}}"
                       (round-trip "{\"Move\":{\"dir\":\"north\",\"steps\":2}}"))))
      ;; A nullary constructor still carries its (empty) field object, so the
      ;; tag stays discoverable on the wire.
      (it "round-trips a nullary variant as an empty object"
        (assert-true (cstr-eq? "{\"Quit\":{}}" (round-trip "{\"Quit\":{}}")))))
    (run-all-status)))
