;; DecodeJson against the yyjson-backed reader: nested object lookup, a float
;; field, and a \uXXXX escape that must arrive as real UTF-8.
;;
;; The `Expected:` output this used to print and never check is asserted
;; below; main returns run-all-status instead of a hardcoded 0. The three
;; print helpers became predicates -- printing "unicode-fail" and returning 0
;; is exactly the shape that let a wrong answer pass.
(defmodule decode_yyjson_features_test
  (export)
  (import json/decode
    :refer
    [json-parse-doc json-doc-free json-doc-root json-obj-get])
  (import json/encode)
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  ;;; __float-near? -- |a - b| <= eps. Decoded floats are compared with a
  ;;; tolerance rather than for equality; 3.14 is not exact in binary.
  (defn __float-near? [a : float b : float eps : float]
    #fx{Unsafe}
    : bool
    ```c
    double d = a - b;
  if (d < 0) d = -d;
  return d <= eps;
  ```)
  ;;; __is-snow? -- is `s` the UTF-8 encoding of "snöw"?
  ;;;
  ;;; The source JSON writes it as "sn\\u00f6w", so this asserts the decoder
  ;;; turned the escape into the two-byte sequence c3 b6 rather than passing
  ;;; the six literal characters through.
  (defn __is-snow? [s : cstr]
    #fx{Unsafe}
    : bool
    ```c
    #include <string.h>
  /* UTF-8 of "snöw" = 73 6e c3 b6 77, length 5. */
  return s && strlen((const char*)s) == 5 && (unsigned char)s[2] == 0xc3 &&
         (unsigned char)s[3] == 0xb6;
  ```)
  (defn main [] : int
    (let [src   "{\"outer\":{\"inner\":99},\"pi\":3.14,\"u\":\"sn\\u00f6w\"}"
          doc   (unsafe (json-parse-doc src))
          root  (unsafe (json-doc-root doc))
          outer (unsafe (json-obj-get doc root "outer"))
          inner (unsafe (json-obj-get doc outer "inner"))
          pi-v  (unsafe (json-obj-get doc root "pi"))
          u-v   (unsafe (json-obj-get doc root "u"))]
      (describe "json DecodeJson -- yyjson reader features"
        ;; json-obj-get applied to a nested handle, not just the root.
        (it "reads an int out of a nested object"
          (assert-eq 99 (ok-val (:: (decode-json doc inner) (Result int cstr)))))
        (it "decodes a float field"
          (assert-true (unsafe (__float-near? (ok-val (:: (decode-json doc pi-v)
                                                        (Result float cstr)))
                                 3.14
                                 1e-12))))
        (it "decodes a \\uXXXX escape into UTF-8"
          (assert-true (unsafe (__is-snow? (ok-val (:: (decode-json doc u-v)
                                                     (Result cstr cstr))))))))
      (unsafe (json-doc-free doc))
      (run-all-status))))
