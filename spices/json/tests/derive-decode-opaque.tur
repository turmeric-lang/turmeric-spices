;; The `Expected:` output this used to print and never check is asserted
;; below; main returns run-all-status instead of a hardcoded 0.
;; derive-json-opaque-decode emits a DecodeJson instance for a defopaque newtype
;; by delegating to the carrier's DecodeJson.
(defmodule derive_decode_opaque_test
  (export)
  (import json/encode :refer [derive-json-opaque-decode])
  (import json/decode :refer [json-parse-doc json-doc-free json-doc-root])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defopaque UserId :int)
  (derive-json-opaque-decode UserId :as int)
  (defn main [] : int
    (let [doc  (unsafe (json-parse-doc "42"))
          root (unsafe (json-doc-root doc))
          uid  (ok-val (:: (decode-json doc root) (Result UserId cstr)))]
      (describe "json derive-json-opaque-decode -- carrier delegation"
        (it "decodes a bare JSON int into the newtype"
          (assert-eq 42 (:: uid int))))
      (unsafe (json-doc-free doc))
      (run-all-status))))
