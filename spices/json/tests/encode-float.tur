;; EncodeJson [float] -- mirror of DecodeJson [float], closing the float
;; round-trip.  Finite doubles render as the shortest %g form that
;; re-parses to the same value; non-finite doubles (Infinity / NaN,
;; which JSON cannot represent) render as "null".
;;
;; The `Expected:` output this used to print and never check is asserted
;; below; main returns run-all-status instead of a hardcoded 0.
(defmodule encode_float_test
  (export)
  (import json/encode)
  (import json/decode
    :refer
    [json-parse-doc json-doc-free json-doc-root json-obj-get])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true assert-eq])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defn __inf [] #fx{Unsafe} : float ```c double z = 0.0; return 1.0 / z; ```)
  (defn __nan [] #fx{Unsafe} : float ```c double z = 0.0; return z / z; ```)
  (defn __show-rt [s : cstr]
    #fx{Unsafe}
    : nil
    ```c printf("rt=%s\n", (const char *)s); ```)
  (defn main [] : int
    (let [doc  (unsafe (json-parse-doc "{\"pi\":3.14}"))
          root (unsafe (json-doc-root doc))
          pi   (ok-val (:: (decode-json doc
                             (unsafe (json-obj-get doc root "pi")))
                         (Result float cstr)))]
      (describe "json EncodeJson [float]"
        (it "encodes a fractional value"
          (assert-true (cstr-eq? "3.14" (encode-json 3.14))))
        ;; A whole-valued double renders without a trailing ".0" -- shortest %g.
        (it "encodes a whole value without a decimal point"
          (assert-true (cstr-eq? "2" (encode-json 2.0))))
        (it "encodes a negative value"
          (assert-true (cstr-eq? "-0.5" (encode-json -0.5))))
        (it "encodes a large value in full, not exponent form"
          (assert-true (cstr-eq? "100000000" (encode-json 1e+08))))
        ;; JSON has no Infinity or NaN, so both must degrade to null rather than
        ;; emitting something a parser would reject.
        (it "encodes Infinity as null"
          (assert-true (cstr-eq? "null" (encode-json (unsafe (__inf))))))
        (it "encodes NaN as null"
          (assert-true (cstr-eq? "null" (encode-json (unsafe (__nan))))))
        (it "round-trips a parsed float back to its source text"
          (assert-true (cstr-eq? "3.14" (encode-json pi)))))
      (unsafe (json-doc-free doc))
      (run-all-status))))
