;; Verify 3-field defstruct compiles + runs with derive-json after closure
;; codegen fix.
;; The `Expected:` output this used to print and never check is now
;; asserted below; main returns run-all-status rather than a hardcoded 0.
(defmodule derive_encode_struct_test
  (export)
  (import json/encode :refer [derive-json])
  (import test/suite :refer [describe it])
  (import test/assert :refer [assert-true])
  (import test/runner :refer [run-all-status])
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    #include <string.h>
  return strcmp((const char *)a, (const char *)b) == 0;
  ```)
  (defstruct User [id : int name : cstr active : bool])
  (derive-json User (id int) (name cstr) (active bool))
  (defn main [] : int
    (describe "json derive-json -- EncodeJson for a 3-field defstruct"
      (it "encodes all three fields in declaration order"
        (assert-true (cstr-eq? "{\"id\":7,\"name\":\"alice\",\"active\":true}"
                       (encode-json (make-struct User 7 "alice" true))))))
    (run-all-status)))
