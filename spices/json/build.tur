(defpackage tur-json
  :name "tur-json"
  :version "0.4.0"
  :description "JSON parsing and serialization for Turmeric via yyjson"
  :license "MIT"
  :spices #map{"test" #map{:path "../test"
                           :url "https://github.com/turmeric-lang/turmeric-spices"
                           :ref "test-v0.1.0"
                           :subdir "spices/test"
                           :optional true}}
  :cmake-deps #map{"yyjson" #map{:url "https://github.com/ibireme/yyjson"
                                 :ref "0.10.0"
                                 :targets ["yyjson"]
                                 :options #map{:BUILD_SHARED_LIBS "OFF"
                                               :YYJSON_BUILD_TESTS "OFF"
                                               :YYJSON_BUILD_FUZZER "OFF"}}}
  :exports #map{"json/parse" ["json-parse" "json-free"]
                "json/emit" ["json-emit" "json-emit-pretty"]
                "json/patch" ["json-get-in" "json-set-in" "json-merge"]
                "json/ownstr" ["String"
                               "adopt-cstr"
                               "to-cstr"
                               "release"
                               "str-len"
                               "ownstr-autolink"]
                "json/encode" ["encode-json-string"
                               "derive-json"
                               "derive-json-encode"
                               "derive-json-decode"
                               "derive-json-opaque"
                               "derive-json-opaque-encode"
                               "derive-json-opaque-decode"
                               "derive-json-sum"
                               "derive-json-sum-encode"
                               "derive-json-sum-decode"
                               "derive-json-decoder"
                               "JsonDecodeErrors"
                               "json-decode-errors-count"
                               "json-decode-error-path"
                               "json-decode-error-expected"
                               "json-decode-error-got"
                               "json-decode-errors-free"]
                "json/decode" ["json-parse-doc"
                               "json-doc-free"
                               "json-doc-root"
                               "json-obj-get"]})
