(defpackage tur-prob
  :name        "tur-prob"
  :version     "0.1.0"
  :description "Probabilistic data structures: Bloom filter, Cuckoo filter, HyperLogLog, Count-Min Sketch, Top-K, with join-semilattice merge."
  :license     "MIT"
  :spices #map{
    "test" #map{:url    "https://github.com/turmeric-lang/turmeric-spices"
             :ref    "test-v0.1.0"
             :subdir "spices/test"
             :optional true}
  }
  :exports #map{
    "prob/hash"  ["HashPair" "prob-hash-pair" "prob-double-hash-index"
                  "prob-unsigned-shr" "prob-hash-int"]
    "prob/bloom" ["Bloom" "bloom-new" "bloom-free" "bloom-insert!"
                  "bloom-maybe?" "bloom-count" "bloom-merge"
                  "bloom-m" "bloom-k"]
    "prob/hll"   ["Hll" "hll-new" "hll-free" "hll-add!"
                  "hll-cardinality" "hll-merge" "hll-p" "hll-m"]
    "prob/cms"   ["CountMin" "cms-new" "cms-free" "cms-add!"
                  "cms-estimate" "cms-merge" "cms-inner-product"
                  "cms-d" "cms-w"]
    "prob/cuckoo" ["Cuckoo" "cuckoo-new" "cuckoo-free" "cuckoo-insert!"
                   "cuckoo-maybe?" "cuckoo-delete!" "cuckoo-merge"
                   "cuckoo-num-buckets" "cuckoo-bucket-size" "cuckoo-count"]
    "prob/topk"  ["TopK" "topk-new" "topk-free" "topk-add!" "topk-list"
                  "topk-merge" "topk-len" "topk-count"]
    "prob/tdigest" ["TDigest" "tdigest-new" "tdigest-free" "tdigest-add!"
                    "tdigest-quantile" "tdigest-merge" "tdigest-count"
                    "tdigest-num-centroids" "tdigest-compression"]
  })
