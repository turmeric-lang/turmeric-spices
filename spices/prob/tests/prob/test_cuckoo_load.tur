;; test_cuckoo_load -- Cuckoo filter at realistic load.
;;
;; test_cuckoo.tur exercises a 4096-bucket filter with 100 keys, a load of 0.6%.
;; That is too light to see a fingerprint that is correlated with the bucket
;; index: with the fingerprint taken from the low hash bits (the same bits that
;; pick the bucket) every key in a bucket carries the same fingerprint, so a
;; lookup matches whenever ANY key shares the bucket, and an insert whose
;; fingerprint is already in its bucket is dropped as "already present".
;;
;; Measured with the bug at 12000 keys in 4096 buckets: 94.6% false positives
;; and 3864 keys stored (1 - e^(-12000/4096) = 94.6%: the filter had degraded to
;; "is this bucket occupied"). With the fingerprint taken from independent bits
;; the filter stores nearly every key and the false-positive rate is a few
;; percent. Measured with the fix at 8000 keys in 4096 buckets: 7871 fingerprints
;; stored (the rest absorbed by 8-bit fingerprint collisions) and 588 of 20000
;; absent keys reported present (2.9%).
;;
;; main returns the failure count, so `tur test` reports a non-zero exit as a
;; failing test.
;;
;; NOTE: let-binding names in main are prefixed (cl-) to avoid the compiler
;; let-binding name collision with function parameters in cuckoo.tur.
(defmodule prob/tests/test_cuckoo_load
  (import prob/cuckoo
    :refer
    [Cuckoo cuckoo-new cuckoo-free cuckoo-insert! cuckoo-maybe? cuckoo-count])
  (defn fail-if [cond : bool label : cstr] : int
    (if cond (do (println label) 1) 0))
  ;;; __cl-insert-range -- insert keys [key, end); returns how many reported true.
  (defn __cl-insert-range [^borrow cf : Cuckoo key : int end : int ok : int] : int
    (if (>= key end)
      ok
      (__cl-insert-range cf
        (+ key 1)
        end
        (if (cuckoo-insert! cf key) (+ ok 1) ok))))
  ;;; __cl-count-present -- how many keys in [key, end) the filter reports present.
  (defn __cl-count-present [^borrow cf : Cuckoo key : int end : int n : int] : int
    (if (>= key end)
      n
      (__cl-count-present cf
        (+ key 1)
        end
        (if (cuckoo-maybe? cf key) (+ n 1) n))))
  (defn main [] : int
    (let [cl-members 8000
          cl-cf      (cuckoo-new 4096)
          cl-ok      (__cl-insert-range cl-cf 0 cl-members 0)
          cl-stored  (cuckoo-count cl-cf)
          cl-found   (__cl-count-present cl-cf 0 cl-members 0)
          ;; 20000 keys that were never inserted.
          cl-fp      (__cl-count-present cl-cf 1000000 1020000 0)
          cl-fails   (+ (fail-if (< cl-ok cl-members)
                          "cuckoo: some inserts reported full at 49% load")
                       ;; Every distinct key must occupy its own slot. Equal fingerprints
                       ;; legitimately dedup a few (a key whose fingerprint already sits in
                       ;; one of its two buckets), so allow a small shortfall, not a third.
                       (fail-if (< cl-stored 7800)
                         "cuckoo: inserted keys were dropped as duplicates")
                       (fail-if (< cl-found cl-members)
                         "cuckoo: false negative")
                       ;; Expected ~1.5%; fail well above it, far below the broken 86%.
                       (fail-if (> cl-fp 1000)
                         "cuckoo: false-positive rate above 5% at 49% load"))]
      (cuckoo-free cl-cf)
      (if (= cl-fails 0)
        (println "PASS test_cuckoo_load")
        (println "test_cuckoo_load: failures above"))
      cl-fails))) ;; end defmodule prob/tests/test_cuckoo_load
