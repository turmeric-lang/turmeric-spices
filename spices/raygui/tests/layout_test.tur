;; raygui/layout smoke tests.
;;
;; Verifies that layout module exports resolve correctly.
;; Rendering tests require a live window and are exercised by the examples.
(defmodule layout_test
  (export)
  (import raygui/layout
    :refer
    [gui-window-box
     gui-group-box
     gui-line
     gui-panel
     gui-dummy-rec
     gui-status-bar
     gui-scroll-panel])
  ;;; T1: layout exports resolve without error.
  ;;;
  ;;; Each binding needs its own name.  Seven bindings all called `_` mangle to
  ;;; the same C identifier, and since they hold function pointers of different
  ;;; shapes cc rejected the file with "conflicting types for '_'" followed by
  ;;; four "redefinition of '_'".  `_` is not a discard in Turmeric -- it is an
  ;;; ordinary name.
  ;;;
  ;;; What this proves is a link-time property: naming each function forces the
  ;;; linker to resolve it, so a missing or renamed raygui entry point fails the
  ;;; build rather than the run.  (Calling them would need a live window.)
  (defn test-exports-resolve [] : int
    (let [_window-box   gui-window-box
          _group-box    gui-group-box
          _line         gui-line
          _panel        gui-panel
          _dummy-rec    gui-dummy-rec
          _status-bar   gui-status-bar
          _scroll-panel gui-scroll-panel]
      (println "T1 PASS: layout exports resolve")
      0))
  (defn main [] : int (test-exports-resolve))) ;; end defmodule layout_test
