;;; examples/color-picker -- color picker + alpha bar + progress bar demo.
;;;
;;; Run with: tur run color-picker.tur
;;;
;;; Since: Phase 3
(defmodule color_picker
  (export)
  (import raylib/core
    :refer
    [init-window
     close-window
     window-should-close
     begin-drawing
     end-drawing
     clear-background
     set-target-fps])
  (import raylib/color :refer [raywhite])
  (import raygui/core :refer [gui-load-style-default])
  (import raygui/controls
    :refer
    [gui-color-picker gui-color-bar-alpha gui-label gui-progress-bar])
  (import raygui/layout :refer [gui-status-bar])
  (import raygui/rect :refer [rect])
  (defn main [] : int
    (init-window 800 600 "Color Picker")
    (set-target-fps 60)
    (gui-load-style-default)
    (let [color 0xFF0000FF
          alpha 1.0]
      (while (not (window-should-close))
        (begin-drawing)
        (clear-background (raywhite))
        (gui-label (rect 1e+01 1e+01 2e+02 2e+01) "Pick a color:")
        (set! color (gui-color-picker (rect 1e+01 35.0 2e+02 2e+02) "" color))
        (gui-label (rect 2.2e+02 1e+01 1.5e+02 2e+01) "Alpha:")
        (set! alpha
          (gui-color-bar-alpha (rect 2.2e+02 35.0 1.5e+02 2e+01) "" alpha))
        (gui-label (rect 2.2e+02 7e+01 1.5e+02 2e+01) "Alpha level:")
        (gui-progress-bar (rect 2.2e+02 95.0 1.5e+02 2e+01)
          "0"
          "1"
          alpha
          0.0
          1.0)
        (gui-status-bar (rect 0.0 5.8e+02 8e+02 2e+01)
          "Drag the color picker or alpha bar")
        (end-drawing)))
    (close-window)
    0)) ;; end defmodule color_picker
