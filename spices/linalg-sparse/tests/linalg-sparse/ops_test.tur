;;; ops_test.tur -- LS2: scaling, addition, transposition and dense
;;; round trips.
(defmodule linalg-sparse/ops-test
  (import linalg/mat :refer [mat mat-of mat-get mat-approx-eq? mat-free])
  (import linalg-sparse/csr
    :refer
    [csrmat
     coo-new
     coo-push!
     coo-free
     csr-from-coo
     csr-free
     csr-nnz
     csr-get
     csr-rows
     csr-cols])
  (import linalg-sparse/csc
    :refer
    [cscmat csc-free csc-get csc-rows csc-cols csc-nnz])
  (import linalg-sparse/ops
    :refer
    [csr-scale
     csr-add
     csr-transpose
     csr-from-dense
     csc-from-dense
     csr->dense
     csc->dense])
  ;; --- TAP harness (inline-C fail counter) ---
  (defn check [idx : int name : cstr ok : bool] : void
    ```c
    /* __tur_include__: static int g_ops_fails = 0; */
  if (!ok) g_ops_fails++;
  printf("%s %lld - %s\n", ok ? "ok" : "not ok", (long long)idx, (const char *)name);
  ```)
  (defn finish [count : int] : int
    ```c
    printf("1..%lld\n", (long long)count);
  if (g_ops_fails == 0) {
    fprintf(stderr, "# All %lld ops tests passed.\n", (long long)count);
    return 0;
  }
  fprintf(stderr, "# %d/%lld ops tests failed.\n", g_ops_fails, (long long)count);
  return 1;
  ```)
  (defn fa [x : float] : float ```c return x < 0.0 ? -x : x; ```)
  (defn approx [a : float b : float] : bool (< (fa (- a b)) 1e-12))
  (defn dense [] : mat
    (mat-of 3 4 1.5 0.0 0.0 -2.0 0.0 0.0 3.25 0.0 4.0 0.0 0.0 7.1))
  (defn t-dense-csr-roundtrip [] : bool
    (let [d  (dense)
          s  (csr-from-dense d)
          d2 (csr->dense s)]
      (let [ok (and (= (csr-nnz s) 5) (= (mat-approx-eq? d d2 0.0) 1))]
        (mat-free d2)
        (csr-free s)
        (mat-free d)
        ok)))
  (defn t-dense-csc-roundtrip [] : bool
    (let [d  (dense)
          s  (csc-from-dense d)
          d2 (csc->dense s)]
      (let [ok (and (= (csc-nnz s) 5) (= (mat-approx-eq? d d2 0.0) 1))]
        (mat-free d2)
        (csc-free s)
        (mat-free d)
        ok)))
  (defn t-scale [] : bool
    (let [d (dense)
          s (csr-from-dense d)
          t (csr-scale s 2.0)]
      (let [ok (and (approx (csr-get t 2 3) 14.2)
                 (and (= (csr-nnz t) 5) (approx (csr-get s 2 3) 7.1)))]
        (csr-free t)
        (csr-free s)
        (mat-free d)
        ok)))
  (defn t-add-same-pattern [] : bool
    (let [d (dense)
          a (csr-from-dense d)
          b (csr-scale a -0.5)
          c (csr-add a b)]
      (let [ok (and (= (csr-nnz c) 5)
                 (and (approx (csr-get c 0 0) 0.75)
                   (approx (csr-get c 1 2) 1.625)))]
        (csr-free c)
        (csr-free b)
        (csr-free a)
        (mat-free d)
        ok)))
  (defn t-add-union [] : bool
    ;; different patterns: the sum stores the union
    (let [ca (coo-new 2 3)
          cb (coo-new 2 3)]
      (coo-push! ca 0 0 1.0)
      (coo-push! ca 1 2 2.0)
      (coo-push! cb 0 1 3.0)
      (coo-push! cb 1 2 4.0)
      (let [a  (csr-from-coo ca)
            b  (csr-from-coo cb)
            c  (csr-add a b)
            ok (and (= (csr-nnz c) 3)
                 (and (approx (csr-get c 0 0) 1.0)
                   (and (approx (csr-get c 0 1) 3.0)
                     (approx (csr-get c 1 2) 6.0))))]
        (csr-free c)
        (csr-free b)
        (csr-free a)
        (coo-free cb)
        (coo-free ca)
        ok)))
  (defn t-transpose [] : bool
    (let [d (dense)
          s (csr-from-dense d)
          t (csr-transpose s)]
      (let [ok (and (= (csc-rows t) 4)
                 (and (= (csc-cols t) 3)
                   (and (approx (csc-get t 3 2) 7.1)
                     (approx (csc-get t 3 0) -2.0))))]
        (csc-free t)
        (csr-free s)
        (mat-free d)
        ok)))
  (defn main [] : int
    (check 1 "dense -> csr -> dense round trip" (t-dense-csr-roundtrip))
    (check 2 "dense -> csc -> dense round trip" (t-dense-csc-roundtrip))
    (check 3 "csr-scale" (t-scale))
    (check 4 "csr-add: same pattern" (t-add-same-pattern))
    (check 5 "csr-add: union of patterns" (t-add-union))
    (check 6 "csr-transpose" (t-transpose))
    (finish 6))) ;; end defmodule linalg-sparse/ops-test
