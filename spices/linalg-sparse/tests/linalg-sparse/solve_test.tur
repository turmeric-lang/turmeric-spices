;;; solve_test.tur -- LS3: ILU(0) and the sparse iterative solvers.
;;;
;;; The main subject is the 100x100 1D Laplacian tridiag(-1, 2, -1): sparse
;;; CG must reach a residual under 1e-10 in fewer than 200 iterations. A
;;; non-symmetric convection-diffusion stencil exercises sparse BiCGSTAB, and
;;; ILU(0) -- exact on a tridiagonal matrix -- must solve the Laplacian outright.
(defmodule linalg-sparse/solve-test
  (import linalg/vec
    :refer
    [lavec
     la-vec-new
     la-vec-of
     la-vec-get
     la-vec-set!
     la-vec-approx-eq?
     la-vec-free])
  (import linalg/iter :refer [IterOpts IterResult iter-opts iter-result-free])
  (import linalg-sparse/csr
    :refer
    [coomat csrmat coo-new coo-push! coo-free csr-from-coo csr-free csr-spmv])
  (import linalg-sparse/solve
    :refer
    [ilufac ilu0 ilu-free ilu-apply sparse-cg sparse-bicgstab])
  ;; --- TAP harness (inline-C fail counter) ---
  (defn check [idx : int name : cstr ok : bool] : void
    ```c
    /* __tur_include__: static int g_sv_fails = 0; */
  if (!ok) g_sv_fails++;
  printf("%s %lld - %s\n", ok ? "ok" : "not ok", (long long)idx, (const char *)name);
  ```)
  (defn finish [count : int] : int
    ```c
    printf("1..%lld\n", (long long)count);
  if (g_sv_fails == 0) {
    fprintf(stderr, "# All %lld sparse solve tests passed.\n", (long long)count);
    return 0;
  }
  fprintf(stderr, "# %d/%lld sparse solve tests failed.\n", g_sv_fails, (long long)count);
  return 1;
  ```)
  (defn fa [x : float] : float ```c return x < 0.0 ? -x : x; ```)
  (defn approx [a : float b : float] : bool (< (fa (- a b)) 1e-12))
  (defn i2f [n : int] : float ```c return (double)n; ```)
  ;;; stencil -- n x n tridiag(lo, d, hi).
  (defn stencil [n : int lo : float d : float hi : float] : csrmat
    (let [c      (coo-new n n)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do
                     (when (> i 0) (coo-push! c i (- i 1) lo))
                     (coo-push! c i i d)
                     (when (< i (- n 1)) (coo-push! c i (+ i 1) hi))
                     (set! i (+ i 1))
                     (go))))]
        (go))
      (let [m (csr-from-coo c)] (coo-free c) m)))
  ;;; truth -- x[i] = 1 + (i mod 7) / 4, a bounded non-constant solution.
  (defn truth [n : int] : lavec
    (let [v      (la-vec-new n)
          ^mut i 0]
      (letrec [go
               (fn [] : int
                 (if (>= i n)
                   0
                   (do
                     (la-vec-set! v i (+ 1.0 (/ (i2f (mod i 7)) 4.0)))
                     (set! i (+ i 1))
                     (go))))]
        (go))
      v))
  (defn t-cg-laplacian [] : bool
    (let [a  (stencil 100 -1.0 2.0 -1.0)
          xt (truth 100)
          b  (csr-spmv a xt)
          r  (sparse-cg a b (iter-opts 200 1e-10 false))]
      (let [ok (and (.converged r)
                 (and (< (.iters r) 200)
                   (and (< (.residual r) 1e-10)
                     (= (la-vec-approx-eq? (.x r) xt 1e-07) 1))))]
        (iter-result-free r)
        (la-vec-free b)
        (la-vec-free xt)
        (csr-free a)
        ok)))
  (defn t-bicgstab-convdiff [] : bool
    (let [a  (stencil 100 -1.3 2.5 -0.7)
          xt (truth 100)
          b  (csr-spmv a xt)
          r  (sparse-bicgstab a b (iter-opts 400 1e-10 false))]
      (let [ok (and (.converged r)
                 (and (< (.residual r) 1e-10)
                   (= (la-vec-approx-eq? (.x r) xt 1e-08) 1)))]
        (iter-result-free r)
        (la-vec-free b)
        (la-vec-free xt)
        (csr-free a)
        ok)))
  (defn t-ilu-exact-on-tridiagonal [] : bool
    (let [a  (stencil 100 -1.0 2.0 -1.0)
          xt (truth 100)
          b  (csr-spmv a xt)]
      (let [ok (match (ilu0 a)
                 (Ok f)
                 (let [z  (ilu-apply f b)
                       ok (= (la-vec-approx-eq? z xt 1e-09) 1)]
                   (la-vec-free z)
                   (ilu-free f)
                   ok)
                 (Err e)
                 false)]
        (la-vec-free b)
        (la-vec-free xt)
        (csr-free a)
        ok)))
  (defn t-ilu-missing-diagonal [] : bool
    (let [c (coo-new 2 2)]
      (coo-push! c 0 0 1.0)
      (coo-push! c 0 1 2.0)
      (coo-push! c 1 0 3.0)
      (let [a  (csr-from-coo c)
            ok (match (ilu0 a) (Ok f) (do (ilu-free f) false) (Err e) true)]
        (csr-free a)
        (coo-free c)
        ok)))
  (defn t-ilu-nonsquare [] : bool
    (let [c (coo-new 2 3)]
      (coo-push! c 0 0 1.0)
      (coo-push! c 1 1 1.0)
      (let [a  (csr-from-coo c)
            ok (match (ilu0 a) (Ok f) (do (ilu-free f) false) (Err e) true)]
        (csr-free a)
        (coo-free c)
        ok)))
  (defn t-ilu-drops-fill [] : bool
    ;; arrow matrix: ILU(0) drops the fill exact LU would add, so it is only
    ;; an approximation -- but the factors keep A's pattern exactly.
    (let [c (coo-new 3 3)]
      (coo-push! c 0 0 4.0)
      (coo-push! c 0 2 1.0)
      (coo-push! c 1 0 1.0)
      (coo-push! c 1 1 4.0)
      (coo-push! c 2 1 1.0)
      (coo-push! c 2 2 4.0)
      (let [a  (csr-from-coo c)
            ok (match (ilu0 a)
                 (Ok f)
                 (let [ok (and (= (.nnz (.L f)) 5) (= (.nnz (.U f)) 4))]
                   (ilu-free f)
                   ok)
                 (Err e)
                 false)]
        (csr-free a)
        (coo-free c)
        ok)))
  (defn main [] : int
    (check 1
      "sparse-cg: 100x100 Laplacian, < 200 iters, residual < 1e-10"
      (t-cg-laplacian))
    (check 2 "sparse-bicgstab: non-symmetric stencil" (t-bicgstab-convdiff))
    (check 3
      "ilu0: exact LU on a tridiagonal matrix"
      (t-ilu-exact-on-tridiagonal))
    (check 4 "ilu0: Err on a missing diagonal" (t-ilu-missing-diagonal))
    (check 5 "ilu0: Err on a non-square matrix" (t-ilu-nonsquare))
    (check 6 "ilu0: factors keep A's pattern" (t-ilu-drops-fill))
    (finish 6))) ;; end defmodule linalg-sparse/solve-test
