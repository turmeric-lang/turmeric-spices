(defpackage tur-linalg-sparse
  :name "tur-linalg-sparse"
  :version "0.1.0"
  :description "Sparse float matrices (CSR/CSC), SpMV, ILU(0) and sparse iterative solvers"
  :license "MIT"
  :spices #map{"linalg" #map{:path "../linalg"
                             :url "https://github.com/turmeric-lang/turmeric-spices"
                             :ref "linalg-v0.2.0"
                             :subdir "spices/linalg"
                             :optional false}}
  :exports #map{"linalg-sparse/csr" ["coomat"
                                     "csrmat"
                                     "coo-new"
                                     "coo-push!"
                                     "coo-nnz"
                                     "coo-free"
                                     "csr-from-coo"
                                     "csr-free"
                                     "csr-rows"
                                     "csr-cols"
                                     "csr-nnz"
                                     "csr-get"
                                     "csr-spmv"
                                     "sparse-izeros"
                                     "sparse-fzeros"]
                "linalg-sparse/csc" ["cscmat"
                                     "csc-from-coo"
                                     "csc-from-csr"
                                     "csr-from-csc"
                                     "csc-free"
                                     "csc-rows"
                                     "csc-cols"
                                     "csc-nnz"
                                     "csc-get"
                                     "csc-spmv"
                                     "csc-transpose"
                                     "sparse-ivec-copy"
                                     "sparse-fvec-copy"]
                "linalg-sparse/ops" ["csr-scale"
                                     "csr-add"
                                     "csr-transpose"
                                     "csr-from-dense"
                                     "csc-from-dense"
                                     "csr->dense"
                                     "csc->dense"]
                "linalg-sparse/solve" ["ilufac"
                                       "ilu0"
                                       "ilu-free"
                                       "ilu-apply"
                                       "sparse-cg"
                                       "sparse-bicgstab"]
                "linalg-sparse/fmt" ["csr->str"
                                     "csr->str-prec"
                                     "csr-print"
                                     "csr-print-prec"
                                     "csc->str"
                                     "csc-print"
                                     "sparse-str-free"]})
